(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011100111 #b1110)
                arg1
                (fp #b0 #b0111100111 #b1100)))
(assert (fp.leq (fp #b0 #b0111100111 #b1100)
                arg1
                (fp #b0 #b1011111100 #b0100)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111111 #b0000)
                arg2
                (fp #b1 #b1111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111)
                arg2
                (fp #b1 #b1101100101 #b0100)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111001111 #b0011)
                arg3
                (fp #b1 #b0000000000 #b1011)))
(assert (fp.leq (fp #b1 #b0000000000 #b1011)
                arg3
                (fp #b0 #b0010011000 #b1001)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111110011 #b1000)
                expect
                (fp #b1 #b1111100111 #b1011)))
(assert (fp.leq (fp #b1 #b1111100111 #b1011)
                expect
                (fp #b0 #b0110010011 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
