(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10000100101101 #b110)
                arg1
                (fp #b0 #b00000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010)
                arg1
                (fp #b0 #b10110101010101 #b010)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11000001010000 #b111)
                arg2
                (fp #b1 #b00000000000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b101)
                arg2
                (fp #b0 #b00110101000010 #b001)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00110000100000 #b000)
                expect
                (fp #b1 #b00000000000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b101)
                expect
                (fp #b0 #b01010011110000 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
