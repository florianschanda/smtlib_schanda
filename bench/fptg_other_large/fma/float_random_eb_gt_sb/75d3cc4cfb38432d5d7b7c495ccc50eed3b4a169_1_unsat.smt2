(assert (fp.leq (fp #b1 #b000000000 #b00000)
                arg2
                (fp #b0 #b101110111 #b01000)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b010111100 #b00011)
                arg3
                (fp #b0 #b000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000)
                arg3
                (fp #b0 #b110101100 #b11100)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110110101 #b01000)
                expect
                (fp #b0 #b000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000)
                expect
                (fp #b0 #b011101011 #b01110)))

(assert (not (= expect result)))

(check-sat)
(exit)
