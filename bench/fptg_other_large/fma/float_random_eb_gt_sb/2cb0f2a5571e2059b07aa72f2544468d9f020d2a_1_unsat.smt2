(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b01000101101011000 #b101000011100110)
                arg1
                (fp #b1 #b00010000000101000 #b010110111111011)))
(assert (fp.leq (fp #b1 #b00010000000101000 #b010110111111011)
                arg1
                (fp #b0 #b10010101011110001 #b101110101111110)))

