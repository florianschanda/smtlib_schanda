(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011001110 #b100)
                arg1
                (fp #b1 #b000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000 #b010)
                arg1
                (fp #b0 #b110111111 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                arg2
                (fp #b1 #b111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111110 #b111)
                arg2
                (fp #b1 #b100110110 #b101)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101101011 #b001)
                arg3
                (fp #b1 #b011101000 #b110)))
(assert (fp.leq (fp #b1 #b011101000 #b110)
                arg3
                (fp #b0 #b111000111 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011001100 #b101)
                expect
                (fp #b0 #b011111110 #b110)))
(assert (fp.leq (fp #b0 #b011111110 #b110)
                expect
                (fp #b0 #b110011001 #b010)))

(assert (= expect result))

(check-sat)
(exit)
