; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0011111001101010 #b0001011)
                arg1
                (fp #b0 #b1000000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000000000111 #b0000000)
                arg1
                (fp #b0 #b1001000100000000 #b0100001)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0010011)
                arg2
                (fp #b1 #b1111111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0000000)
                arg2
                (fp #b1 #b1000111000111010 #b1011110)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1001110101101001 #b0111011)
                arg3
                (fp #b0 #b0100001010100101 #b1011000)))
(assert (fp.leq (fp #b0 #b0100001010100101 #b1011000)
                arg3
                (fp #b0 #b0101000001101000 #b1100111)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
