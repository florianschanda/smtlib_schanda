(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01101010011 #b11001001)
                arg1
                (fp #b1 #b01011111111 #b00010000)))
(assert (fp.leq (fp #b1 #b01011111111 #b00010000)
                arg1
                (fp #b0 #b10100011111 #b00011101)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11111111111 #b00000000)
                arg2
                (fp #b1 #b11111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b11111111)
                arg2
                (fp #b1 #b10000110011 #b10101011)))

(declare-const arg3 (_ FloatingPoint 11 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00111110011 #b01110011)
                arg3
                (fp #b1 #b00000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000000)
                arg3
                (fp #b0 #b00000011000 #b11010111)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00101001000 #b11011110)
                expect
                (fp #b0 #b11011111111 #b00010000)))
(assert (fp.leq (fp #b0 #b11011111111 #b00010000)
                expect
                (fp #b0 #b11111110101 #b10100001)))

(assert (= expect result))

(check-sat)
(exit)
