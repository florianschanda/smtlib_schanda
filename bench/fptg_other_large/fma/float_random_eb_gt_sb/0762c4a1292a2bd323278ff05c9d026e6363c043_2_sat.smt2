                arg3
                (fp #b1 #b0101011001100 #b011)))
(assert (fp.leq (fp #b1 #b0101011001100 #b011)
                arg3
                (fp #b1 #b0001010100000 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110001110000 #b101)
                expect
                (fp #b1 #b0101011001100 #b100)))
(assert (fp.leq (fp #b1 #b0101011001100 #b100)
                expect
                (fp #b0 #b0001010100101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
