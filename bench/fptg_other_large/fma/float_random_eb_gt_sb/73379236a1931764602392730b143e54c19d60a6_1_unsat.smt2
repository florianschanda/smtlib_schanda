(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10010000000 #b01000011)
                arg2
                (fp #b0 #b11111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b00000000)
                arg2
                (fp #b0 #b11111111110 #b01001111)))

(declare-const arg3 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10111101011 #b00001111)
                arg3
                (fp #b0 #b00001010100 #b00111011)))
(assert (fp.leq (fp #b0 #b00001010100 #b00111011)
                arg3
                (fp #b0 #b01100010110 #b10100111)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
