; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b10011001000001001 #b101011011110011)
                arg1
                (fp #b1 #b10000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000001111 #b000000000000000)
                arg1
                (fp #b1 #b01011001000001010 #b110000011110111)))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b01010111011010001 #b110101011011000)
                arg2
                (fp #b0 #b00000000000000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b11100011001011010 #b001010111011101)))

(declare-const arg3 (_ FloatingPoint 17 16))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11011000100000101 #b010010011010100)
                expect
                (fp #b1 #b00000000000010000 #b001001001001100)))
(assert (fp.leq (fp #b1 #b00000000000010000 #b001001001001100)
                expect
                (fp #b0 #b10011010110111000 #b011010101001010)))

(assert (= expect result))

(check-sat)
(exit)
