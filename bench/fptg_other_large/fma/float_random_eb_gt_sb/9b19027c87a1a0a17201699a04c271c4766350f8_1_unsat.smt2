; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INFINITY
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0110110011 #b10)
                arg1
                (fp #b0 #b0001111111 #b00)))
(assert (fp.leq (fp #b0 #b0001111111 #b00)
                arg1
                (fp #b0 #b0011101011 #b00)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111111 #b00)
                arg3
                (fp #b1 #b1111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                arg3
                (fp #b0 #b1001011101 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
