(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000)
                arg1
                (fp #b1 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111)
                arg1
                (fp #b1 #b11000111100011 #b0001110)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01110101111010 #b1011100)
                arg2
                (fp #b1 #b00000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1101110)
                arg2
                (fp #b0 #b10101000001101 #b1001010)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10010100010001 #b1011000)
                expect
                (fp #b0 #b10000000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b10000000000000 #b1011100)
                expect
                (fp #b0 #b11100001111010 #b0001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
