(assert (fp.leq (fp #b1 #b1111111111110 #b11111)
                arg2
                (fp #b0 #b0110000001010 #b00010)))

(declare-const arg3 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0100110010101 #b11001)
                arg3
                (fp #b1 #b0000000000000 #b10000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b10000)
                arg3
                (fp #b0 #b0001010011111 #b10001)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 6))
