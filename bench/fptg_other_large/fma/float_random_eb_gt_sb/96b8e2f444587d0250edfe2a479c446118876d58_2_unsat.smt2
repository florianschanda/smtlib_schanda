(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001000010 #b101101)
                arg1
                (fp #b0 #b1000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000110 #b000000)
                arg1
                (fp #b0 #b1000001111 #b010001)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111111 #b000000)
                arg2
                (fp #b1 #b1111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111)
                arg2
                (fp #b1 #b1001001010 #b100100)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101000010 #b100000)
                arg3
                (fp #b0 #b0000000000 #b010001)))
(assert (fp.leq (fp #b0 #b0000000000 #b010001)
                arg3
                (fp #b0 #b0101101010 #b001010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
