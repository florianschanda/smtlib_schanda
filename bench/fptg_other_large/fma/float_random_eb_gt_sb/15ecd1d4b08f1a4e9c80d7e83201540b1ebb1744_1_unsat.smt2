; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1110000001100110 #b0000001)
                arg1
                (fp #b0 #b0000000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b1100101)
                arg1
                (fp #b0 #b0110110111010000 #b1110011)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1111010001010100 #b0100100)
                arg2
                (fp #b1 #b0000000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0100000)
                arg2
                (fp #b0 #b1000001101001100 #b0101101)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
