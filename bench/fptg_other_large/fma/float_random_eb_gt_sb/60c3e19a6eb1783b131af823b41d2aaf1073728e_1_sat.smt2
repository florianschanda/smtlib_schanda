(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b0 #b110000011001000 #b000100000)
                arg1
                (fp #b0 #b111111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b000000000)
                arg1
                (fp #b0 #b111111111111110 #b111100100)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b100011111101011 #b001011101)
                arg2
                (fp #b1 #b100010101110110 #b001101101)))
(assert (fp.leq (fp #b1 #b100010101110110 #b001101101)
                arg2
                (fp #b1 #b001100110010100 #b111011010)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b110110111000101 #b100101001)
                arg3
                (fp #b0 #b000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000000000)
                arg3
                (fp #b0 #b001011010000100 #b111101011)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111111111111111 #b000000000)
                expect
                (fp #b1 #b111111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111111111)
                expect
                (fp #b0 #b110100111101100 #b010011000)))

(assert (= expect result))

(check-sat)
(exit)
