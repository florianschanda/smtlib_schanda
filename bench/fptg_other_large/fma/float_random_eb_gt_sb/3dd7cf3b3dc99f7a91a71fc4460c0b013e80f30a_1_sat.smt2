(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101101111001 #b10010101)
                arg1
                (fp #b0 #b100101101000 #b10010110)))
(assert (fp.leq (fp #b0 #b100101101000 #b10010110)
                arg1
                (fp #b0 #b100101101001 #b01011011)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111000001011 #b00111001)
                arg3
                (fp #b0 #b100000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100000001000 #b00000000)
                arg3
                (fp #b0 #b111001011110 #b11000011)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001000100001 #b00000001)
                expect
                (fp #b0 #b101011010010 #b01000001)))
(assert (fp.leq (fp #b0 #b101011010010 #b01000001)
                expect
                (fp #b0 #b101011110000 #b00011010)))

(assert (= expect result))

(check-sat)
(exit)
