(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00110010101 #b101111000)
                arg1
                (fp #b0 #b10000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b10000001001 #b000000000)
                arg1
                (fp #b0 #b11111000010 #b111011001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00110000101 #b001000101)
                arg2
                (fp #b0 #b00000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b00000000000 #b100101010)
                arg2
                (fp #b0 #b11000101011 #b011100010)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00111100101 #b100111011)
                expect
                (fp #b0 #b00000001010 #b001010100)))
(assert (fp.leq (fp #b0 #b00000001010 #b001010100)
                expect
                (fp #b0 #b01001111010 #b110100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
