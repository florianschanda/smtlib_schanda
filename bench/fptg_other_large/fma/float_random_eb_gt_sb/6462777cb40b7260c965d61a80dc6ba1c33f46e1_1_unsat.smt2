(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b0 #b01110000000100 #b0)
                arg2
                (fp #b0 #b10000000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000000001 #b0)
                arg2
                (fp #b0 #b10010110010100 #b1)))

(declare-const arg3 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b0 #b10011001100111 #b0)
                arg3
                (fp #b0 #b11111111111110 #b1)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1)
                arg3
                (fp #b0 #b11111111111111 #b0)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
