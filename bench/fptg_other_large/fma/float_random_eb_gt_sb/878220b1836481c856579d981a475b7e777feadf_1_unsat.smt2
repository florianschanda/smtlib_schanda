; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00101100100011 #b110101101)
                arg2
                (fp #b1 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000000)
                arg2
                (fp #b0 #b00111011101011 #b010100110)))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10110111100110 #b110111100)
                arg3
                (fp #b1 #b00111010100000 #b001111000)))
(assert (fp.leq (fp #b1 #b00111010100000 #b001111000)
                arg3
                (fp #b0 #b10001110110001 #b011001000)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
