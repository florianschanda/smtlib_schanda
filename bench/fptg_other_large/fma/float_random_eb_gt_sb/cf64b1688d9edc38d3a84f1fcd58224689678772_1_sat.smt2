(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b001101101110111 #b00110000000)
                arg2
                (fp #b0 #b000111100001111 #b01111110011)))
(assert (fp.leq (fp #b0 #b000111100001111 #b01111110011)
                arg2
                (fp #b0 #b110000111010100 #b10001010110)))

(declare-const arg3 (_ FloatingPoint 15 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101100100111111 #b00010011110)
                arg3
                (fp #b0 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000)
                arg3
                (fp #b0 #b111111110001011 #b10100100011)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
