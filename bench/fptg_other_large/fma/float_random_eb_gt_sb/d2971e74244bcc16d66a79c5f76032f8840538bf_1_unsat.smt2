; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -NAN
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1000100110110100 #b1111000)
                arg1
                (fp #b0 #b1010000111101000 #b1011000)))
(assert (fp.leq (fp #b0 #b1010000111101000 #b1011000)
                arg1
                (fp #b0 #b1111111100110010 #b1101111)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1010001100000111 #b0110001)
                arg3
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                arg3
                (fp #b0 #b1110011101100010 #b0100000)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
