(assert (fp.leq (fp #b1 #b100000000000000110 #b000000)
                arg2
                (fp #b0 #b000001000110001101 #b110010)))

(declare-const arg3 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b111111111111111110 #b001101)
                arg3
                (fp #b1 #b111111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b000000)
                arg3
                (fp #b1 #b001010010010010110 #b011010)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b111111111111111101 #b111000)
                expect
                (fp #b1 #b111111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b000000)
                expect
                (fp #b1 #b001110010001001111 #b010100)))

(assert (= expect result))

(check-sat)
(exit)
