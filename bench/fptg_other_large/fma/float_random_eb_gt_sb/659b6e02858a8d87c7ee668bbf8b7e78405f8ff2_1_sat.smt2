                (fp #b1 #b0000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b01000000000)
                arg2
                (fp #b0 #b1111000011101 #b01110100101)))

(declare-const arg3 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1100010011111 #b10000011010)
                arg3
                (fp #b1 #b1010111000110 #b01000000111)))
(assert (fp.leq (fp #b1 #b1010111000110 #b01000000111)
                arg3
                (fp #b0 #b1100101011000 #b00000011100)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
