(assert (fp.leq (fp #b1 #b1010110010110 #b11001000)
                arg3
                (fp #b1 #b0000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000000)
                arg3
                (fp #b0 #b1000010100001 #b00100001)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0001110000010 #b10110100)
                expect
                (fp #b0 #b1001110000101 #b11100101)))
(assert (fp.leq (fp #b0 #b1001110000101 #b11100101)
                expect
                (fp #b0 #b1111100011010 #b01010101)))

(assert (= expect result))

(check-sat)
(exit)
