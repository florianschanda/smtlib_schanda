; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01000011100 #b01110)
                arg1
                (fp #b0 #b01110001001 #b10111)))
(assert (fp.leq (fp #b0 #b01110001001 #b10111)
                arg1
                (fp #b0 #b10001110001 #b00001)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10000111100 #b11010)
                arg2
                (fp #b1 #b10000000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000000101 #b00000)
                arg2
                (fp #b0 #b00001110111 #b01100)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01010110111 #b11001)
                arg3
                (fp #b0 #b11111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111101 #b00000)
                arg3
                (fp #b0 #b11111111110 #b11110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01011111011 #b10100)
                expect
                (fp #b0 #b11111111100 #b11111)))
(assert (fp.leq (fp #b0 #b11111111100 #b11111)
                expect
                (fp #b0 #b11111111110 #b01000)))

(assert (= expect result))

(check-sat)
(exit)
