(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0111110101010 #b001011)
                arg1
                (fp #b1 #b0001101011011 #b000011)))
(assert (fp.leq (fp #b1 #b0001101011011 #b000011)
                arg1
                (fp #b0 #b1100101011001 #b110101)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
