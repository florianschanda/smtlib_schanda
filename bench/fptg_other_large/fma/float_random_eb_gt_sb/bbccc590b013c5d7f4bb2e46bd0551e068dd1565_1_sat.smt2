                arg2
                (fp #b0 #b1000000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000000000101 #b00000)
                arg2
                (fp #b0 #b1000000000110011 #b01000)))

(declare-const arg3 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000)
                arg3
                (fp #b1 #b1111111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111)
                arg3
                (fp #b1 #b0010111101100101 #b11100)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000)
                expect
                (fp #b1 #b1111111111111110 #b11110)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11110)
                expect
                (fp #b1 #b0111001100001101 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
