(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0001001010011101 #b00110011000)
                arg1
                (fp #b1 #b0000000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11011000100)
                arg1
                (fp #b0 #b0010111011010010 #b11001001100)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1110111000101011 #b10001001110)
                arg2
                (fp #b1 #b1100000101001000 #b01111011101)))
(assert (fp.leq (fp #b1 #b1100000101001000 #b01111011101)
                arg2
                (fp #b0 #b0100011111011101 #b11011101010)))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0010010101111110 #b11110011001)
                arg3
                (fp #b1 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000)
                arg3
                (fp #b0 #b1010010011100101 #b01010010101)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0000001100001001 #b01001001010)
                expect
                (fp #b0 #b0100000101001010 #b01000001000)))
(assert (fp.leq (fp #b0 #b0100000101001010 #b01000001000)
                expect
                (fp #b0 #b0101011010110100 #b01110011100)))

(assert (= expect result))

(check-sat)
(exit)
