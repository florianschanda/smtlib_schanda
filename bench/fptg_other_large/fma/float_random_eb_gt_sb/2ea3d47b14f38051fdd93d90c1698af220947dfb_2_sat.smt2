(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b010000000101111 #b1111100)
                arg1
                (fp #b1 #b000000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1111010)
                arg1
                (fp #b0 #b110001011000010 #b0100111)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101000000000000 #b1010101)
                arg3
                (fp #b0 #b101000101101110 #b0000111)))
(assert (fp.leq (fp #b0 #b101000101101110 #b0000111)
                arg3
                (fp #b0 #b110111101000011 #b0011101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b010011000111001 #b1001110)
                expect
                (fp #b0 #b101000101101110 #b0001000)))
(assert (fp.leq (fp #b0 #b101000101101110 #b0001000)
                expect
                (fp #b0 #b101011111101100 #b1011111)))

(assert (= expect result))

(check-sat)
(exit)
