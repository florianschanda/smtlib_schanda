;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b0 #b11110101011001100 #b1)
                arg1
                (fp #b0 #b11111111111111110 #b1)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1)
                arg1
                (fp #b0 #b11111111111111111 #b0)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11000000100011101 #b0)
                arg2
                (fp #b1 #b00000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1)
                arg2
                (fp #b0 #b11110100110110000 #b0)))

(declare-const arg3 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b01000011001001000 #b1)
                arg3
                (fp #b0 #b10010000010001100 #b1)))
(assert (fp.leq (fp #b0 #b10010000010001100 #b1)
                arg3
                (fp #b0 #b11011111011011000 #b1)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b00110100000110110 #b1)
                expect
                (fp #b0 #b10010000010001100 #b0)))
(assert (fp.leq (fp #b0 #b10010000010001100 #b0)
                expect
                (fp #b0 #b10111110011011000 #b1)))

(assert (= expect result))

(check-sat)
(exit)
