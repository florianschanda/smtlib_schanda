                arg2
                (fp #b0 #b10100011000 #b1111)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00000010011 #b1110)
                arg3
                (fp #b0 #b00000000000 #b0010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0010)
                arg3
                (fp #b0 #b00110110101 #b0100)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000111100 #b0100)
                expect
                (fp #b0 #b00000000000 #b0010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0010)
                expect
                (fp #b0 #b00011111001 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
