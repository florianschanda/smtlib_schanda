; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +ZERO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1101010000111011 #b010011100)
                arg2
                (fp #b0 #b0000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000)
                arg2
                (fp #b0 #b1110011001111100 #b101100101)))

(declare-const arg3 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110111011011110 #b010111011)
                arg3
                (fp #b0 #b1111001101011110 #b010111000)))
(assert (fp.leq (fp #b0 #b1111001101011110 #b010111000)
                arg3
                (fp #b0 #b1111010110001111 #b110001101)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
