                arg3
                (fp #b0 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b000000)
                arg3
                (fp #b0 #b111111111111101 #b001101)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
