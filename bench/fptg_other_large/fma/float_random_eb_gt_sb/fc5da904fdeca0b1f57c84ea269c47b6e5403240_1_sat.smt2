(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b111010111101 #b01101101)
                arg3
                (fp #b0 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111)
                arg3
                (fp #b0 #b111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
