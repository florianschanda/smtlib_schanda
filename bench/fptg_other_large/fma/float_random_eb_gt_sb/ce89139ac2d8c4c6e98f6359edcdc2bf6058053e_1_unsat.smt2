(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0111011000 #b10001)
                arg1
                (fp #b0 #b0000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000)
                arg1
                (fp #b0 #b1110000010 #b00010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111001001 #b00111)
                arg2
                (fp #b1 #b0000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000 #b10001)
                arg2
                (fp #b0 #b1000000110 #b01011)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111110 #b00101)
                arg3
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                arg3
                (fp #b1 #b1010001101 #b11011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b11000)
                expect
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                expect
                (fp #b0 #b1000110010 #b11100)))

(assert (not (= expect result)))

(check-sat)
(exit)
