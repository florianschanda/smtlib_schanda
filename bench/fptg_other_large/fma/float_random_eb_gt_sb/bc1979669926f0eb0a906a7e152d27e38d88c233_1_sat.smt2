(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111111 #b0000000)
                arg1
                (fp #b1 #b111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111110 #b1111111)
                arg1
                (fp #b1 #b010111111 #b1101000)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010011101 #b1000110)
                arg2
                (fp #b0 #b011111101 #b1111001)))
(assert (fp.leq (fp #b0 #b011111101 #b1111001)
                arg2
                (fp #b0 #b111100111 #b0001001)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111110 #b1110101)
                expect
                (fp #b1 #b111111101 #b1111000)))
(assert (fp.leq (fp #b1 #b111111101 #b1111000)
                expect
                (fp #b1 #b110111000 #b0001001)))

(assert (= expect result))

(check-sat)
(exit)
