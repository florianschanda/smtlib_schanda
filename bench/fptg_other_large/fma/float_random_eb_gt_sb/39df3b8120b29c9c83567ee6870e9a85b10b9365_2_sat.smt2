(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111011100 #b10001000)
                arg1
                (fp #b1 #b0110011001 #b01001011)))
(assert (fp.leq (fp #b1 #b0110011001 #b01001011)
                arg1
                (fp #b0 #b0110011010 #b01111100)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0101100010 #b00110100)
                arg3
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                arg3
                (fp #b0 #b1111010111 #b11010001)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0101010010 #b11110011)
                expect
                (fp #b1 #b0100110011 #b10101100)))
(assert (fp.leq (fp #b1 #b0100110011 #b10101100)
                expect
                (fp #b1 #b0010110101 #b10001101)))

(assert (= expect result))

(check-sat)
(exit)
