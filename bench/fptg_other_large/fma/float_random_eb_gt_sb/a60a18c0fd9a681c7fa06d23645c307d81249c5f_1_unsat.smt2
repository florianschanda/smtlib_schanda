; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b0 #b00111110100011001 #b10110)
                arg2
                (fp #b0 #b01010111000000001 #b11100)))
(assert (fp.leq (fp #b0 #b01010111000000001 #b11100)
                arg2
                (fp #b0 #b11010101010010011 #b01000)))

(declare-const arg3 (_ FloatingPoint 17 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11110011010100101 #b01000)
                arg3
                (fp #b0 #b00000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00000)
                arg3
                (fp #b0 #b00011000110010001 #b11101)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
