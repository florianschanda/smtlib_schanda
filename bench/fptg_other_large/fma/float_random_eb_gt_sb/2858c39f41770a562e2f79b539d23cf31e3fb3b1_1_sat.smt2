(assert (fp.leq (fp #b0 #b010001110101010001 #b1111000111)
                arg2
                (fp #b0 #b101000010000101101 #b0001100010)))

(declare-const arg3 (_ FloatingPoint 18 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 18 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
