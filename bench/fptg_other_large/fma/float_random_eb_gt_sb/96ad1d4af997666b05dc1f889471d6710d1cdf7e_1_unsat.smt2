(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111111110 #b011)
                arg1
                (fp #b1 #b1111111101 #b000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000)
                arg1
                (fp #b1 #b1011110010 #b100)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000111110 #b011)
                arg2
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg2
                (fp #b0 #b0100110110 #b000)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0001100100 #b111)
                arg3
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                arg3
                (fp #b0 #b0000110101 #b111)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000101110 #b111)
                expect
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                expect
                (fp #b0 #b1111111111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
