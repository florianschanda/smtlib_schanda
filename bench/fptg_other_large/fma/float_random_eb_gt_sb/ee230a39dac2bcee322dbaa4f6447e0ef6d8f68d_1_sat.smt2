; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b110110000001010101 #b001001101111000)
                arg2
                (fp #b1 #b000000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b010000000000000)
                arg2
                (fp #b0 #b111100000110100111 #b001100001101010)))

(declare-const arg3 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b0 #b010011100101100001 #b000000001110111)
                arg3
                (fp #b0 #b100000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b100000000000001111 #b000000000000000)
                arg3
                (fp #b0 #b111011110000101001 #b110111110110100)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
