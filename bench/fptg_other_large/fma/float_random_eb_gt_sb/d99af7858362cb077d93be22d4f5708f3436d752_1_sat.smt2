(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000000)
                arg2
                (fp #b1 #b1111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111111)
                arg2
                (fp #b1 #b1001110101110111 #b10011011110000)))

(declare-const arg3 (_ FloatingPoint 16 15))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1010001100010011 #b01011110011001)
                arg3
                (fp #b1 #b0000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000000)
                arg3
                (fp #b0 #b1000110110111100 #b10010011100001)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
