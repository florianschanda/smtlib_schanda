;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111111111111111 #b0000000)
                arg1
                (fp #b1 #b111111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b1111111)
                arg1
                (fp #b0 #b001100010111000 #b0010001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b001100010011010 #b0010111)
                arg2
                (fp #b0 #b100000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000000000111 #b0000000)
                arg2
                (fp #b0 #b111111100001010 #b1111101)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101010100000101 #b0111010)
                arg3
                (fp #b1 #b100100110100010 #b0111011)))
(assert (fp.leq (fp #b1 #b100100110100010 #b0111011)
                arg3
                (fp #b1 #b001111101010000 #b0010101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
