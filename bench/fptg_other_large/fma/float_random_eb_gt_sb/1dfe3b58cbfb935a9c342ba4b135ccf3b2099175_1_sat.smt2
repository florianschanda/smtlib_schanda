(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b011111000000 #b10001010)
                arg1
                (fp #b0 #b100101101000 #b10010110)))
(assert (fp.leq (fp #b0 #b100101101000 #b10010110)
                arg1
                (fp #b0 #b111001010100 #b10000001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100111010100 #b01101001)
                arg2
                (fp #b0 #b100000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100000001000 #b00000000)
                arg2
                (fp #b0 #b100001001000 #b11111011)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
