; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11101100101 #b10010100)
                arg1
                (fp #b1 #b01011111111 #b00010000)))
(assert (fp.leq (fp #b1 #b01011111111 #b00010000)
                arg1
                (fp #b1 #b00101000000 #b11011100)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11011011001 #b01001011)
                arg3
                (fp #b1 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b00000000)
                arg3
                (fp #b1 #b01110101111 #b11101001)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
