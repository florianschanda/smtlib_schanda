; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10010000100011 #b0011101)
                arg1
                (fp #b0 #b00000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000)
                arg1
                (fp #b0 #b10000111100000 #b0110111)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101000111010 #b0111010)
                arg2
                (fp #b1 #b10000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000000111 #b0000000)
                arg2
                (fp #b1 #b00111001011100 #b1000101)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
