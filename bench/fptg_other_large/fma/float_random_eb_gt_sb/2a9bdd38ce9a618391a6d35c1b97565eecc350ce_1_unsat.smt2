(assert (fp.leq (fp #b0 #b0001001111 #b0)
                arg2
                (fp #b0 #b0011110110 #b0)))

(declare-const arg3 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0001100000 #b0)
                arg3
                (fp #b0 #b0101101111 #b1)))
(assert (fp.leq (fp #b0 #b0101101111 #b1)
                arg3
                (fp #b0 #b1001011110 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0111111011 #b1)
                expect
                (fp #b0 #b0101111000 #b1)))
(assert (fp.leq (fp #b0 #b0101111000 #b1)
                expect
                (fp #b0 #b0110011011 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
