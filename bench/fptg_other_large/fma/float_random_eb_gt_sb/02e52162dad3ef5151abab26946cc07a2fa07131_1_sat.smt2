(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100000011 #b00010)
                arg1
                (fp #b1 #b0010110001 #b10000)))
(assert (fp.leq (fp #b1 #b0010110001 #b10000)
                arg1
                (fp #b0 #b0101100101 #b11000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0010100011 #b10000)
                arg2
                (fp #b0 #b1111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                arg2
                (fp #b0 #b1111111110 #b10000)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001001101 #b10100)
                arg3
                (fp #b1 #b0111110010 #b00000)))
(assert (fp.leq (fp #b1 #b0111110010 #b00000)
                arg3
                (fp #b0 #b1000000110 #b01100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110110111 #b01000)
                expect
                (fp #b1 #b1010101111 #b10000)))
(assert (fp.leq (fp #b1 #b1010101111 #b10000)
                expect
                (fp #b0 #b0110100001 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
