(assert (fp.leq (fp #b1 #b11100101001001011 #b1)
                arg3
                (fp #b0 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0)
                arg3
                (fp #b0 #b11000001111111000 #b0)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
