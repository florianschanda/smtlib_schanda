(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110001100 #b00011010)
                arg1
                (fp #b1 #b0000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b0000000000 #b00010010)
                arg1
                (fp #b0 #b0110110011 #b10001101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0011011111 #b01100100)
                arg2
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                arg2
                (fp #b0 #b1100111000 #b10010011)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0010010101 #b00100111)
                arg3
                (fp #b0 #b0000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01110011)
                arg3
                (fp #b0 #b0101001100 #b11001111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101011010 #b11011111)
                expect
                (fp #b1 #b0000000110 #b00011100)))
(assert (fp.leq (fp #b1 #b0000000110 #b00011100)
                expect
                (fp #b0 #b0010000100 #b10011111)))

(assert (= expect result))

(check-sat)
(exit)
