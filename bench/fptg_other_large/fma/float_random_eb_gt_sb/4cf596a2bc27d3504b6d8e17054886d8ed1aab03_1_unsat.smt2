                arg2
                (fp #b1 #b1111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b11111111)
                arg2
                (fp #b0 #b1100001001001 #b10001001)))

(declare-const arg3 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0101101110010 #b11001010)
                arg3
                (fp #b0 #b0000000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b0000000000000 #b01110011)
                arg3
                (fp #b0 #b1101011111101 #b11110011)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
