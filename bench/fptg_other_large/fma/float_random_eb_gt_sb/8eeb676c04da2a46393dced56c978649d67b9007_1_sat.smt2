(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b1010000101100001 #b10001011)
                arg1
                (fp #b0 #b1101000011110010 #b00111000)))
(assert (fp.leq (fp #b0 #b1101000011110010 #b00111000)
                arg1
                (fp #b0 #b1110101001110011 #b00111110)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b1111001101000110 #b00000111)
                arg3
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                arg3
                (fp #b0 #b1111111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1010110111110100 #b00111011)
                expect
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                expect
                (fp #b0 #b1111111111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
