(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000)))

(declare-const arg3 (_ FloatingPoint 16 13))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
