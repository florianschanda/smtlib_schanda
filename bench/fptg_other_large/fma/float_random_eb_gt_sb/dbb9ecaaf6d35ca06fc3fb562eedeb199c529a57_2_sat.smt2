                arg3
                (fp #b1 #b000000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0111011)
                arg3
                (fp #b0 #b101010010001001 #b0001110)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b010110111010001 #b1010011)
                expect
                (fp #b0 #b100000000000000 #b1001010)))
(assert (fp.leq (fp #b0 #b100000000000000 #b1001010)
                expect
                (fp #b0 #b111101111101101 #b0011111)))

(assert (= expect result))

(check-sat)
(exit)
