(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b01010010110 #b1111111)
                arg1
                (fp #b0 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000000111 #b0000000)
                arg1
                (fp #b0 #b11111111100 #b1011011)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b11010110100 #b0001001)
                arg2
                (fp #b0 #b11111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111)
                arg2
                (fp #b0 #b11111111111 #b0000000)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11000011110 #b1010000)
                arg3
                (fp #b1 #b10010000011 #b1100000)))
(assert (fp.leq (fp #b1 #b10010000011 #b1100000)
                arg3
                (fp #b0 #b11000110101 #b1010011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
