; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1001111010011 #b110)
                arg1
                (fp #b1 #b1000000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000000011 #b000)
                arg1
                (fp #b0 #b1101101100101 #b011)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111111111111 #b000)
                arg2
                (fp #b1 #b1111111111110 #b111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111)
                arg2
                (fp #b0 #b0011111011101 #b000)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0111100101111 #b010)
                arg3
                (fp #b0 #b1111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000)
                arg3
                (fp #b0 #b1111111111110 #b000)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b1000001110010 #b110)
                expect
                (fp #b0 #b1111111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111)
                expect
                (fp #b0 #b1111111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
