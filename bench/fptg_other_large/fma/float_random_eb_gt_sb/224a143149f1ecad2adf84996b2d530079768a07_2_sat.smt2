(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01000111000 #b110)
                arg1
                (fp #b0 #b00000101001 #b010)))
(assert (fp.leq (fp #b0 #b00000101001 #b010)
                arg1
                (fp #b0 #b01100100101 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10100111010 #b010)
                arg2
                (fp #b1 #b00000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000 #b010)
                arg2
                (fp #b0 #b10001110000 #b011)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10000111100 #b111)
                arg3
                (fp #b1 #b10000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000011 #b000)
                arg3
                (fp #b0 #b11000010010 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10110010100 #b100)
                expect
                (fp #b1 #b10000000011 #b001)))
(assert (fp.leq (fp #b1 #b10000000011 #b001)
                expect
                (fp #b0 #b10111010010 #b100)))

(assert (= expect result))

(check-sat)
(exit)
