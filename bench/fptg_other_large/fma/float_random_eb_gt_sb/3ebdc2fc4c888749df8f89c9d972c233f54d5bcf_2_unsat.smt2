; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111111110 #b01100)
                arg1
                (fp #b1 #b111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000)
                arg1
                (fp #b1 #b001001111001 #b00001)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110111001011 #b00001)
                arg2
                (fp #b0 #b100000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000101 #b00000)
                arg2
                (fp #b0 #b110011000001 #b11010)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110010101110 #b01000)
                arg3
                (fp #b1 #b000011100101 #b00010)))
(assert (fp.leq (fp #b1 #b000011100101 #b00010)
                arg3
                (fp #b0 #b000110011010 #b00110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
