; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101000110 #b00110)
                arg1
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg1
                (fp #b0 #b1100001010 #b10011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011000011 #b00101)
                arg2
                (fp #b1 #b0010011100 #b00011)))
(assert (fp.leq (fp #b1 #b0010011100 #b00011)
                arg2
                (fp #b0 #b1100111001 #b01001)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011110010 #b10000)
                arg3
                (fp #b1 #b0000000000 #b10000)))
(assert (fp.leq (fp #b1 #b0000000000 #b10000)
                arg3
                (fp #b0 #b1010100101 #b11010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0001001000 #b11011)
                expect
                (fp #b1 #b0000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000 #b10001)
                expect
                (fp #b0 #b1110110101 #b00111)))

(assert (= expect result))

(check-sat)
(exit)
