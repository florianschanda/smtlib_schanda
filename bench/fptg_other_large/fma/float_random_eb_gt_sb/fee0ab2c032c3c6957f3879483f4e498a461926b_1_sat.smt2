(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001111100 #b0101111)
                arg1
                (fp #b1 #b0111000100 #b0011101)))
(assert (fp.leq (fp #b1 #b0111000100 #b0011101)
                arg1
                (fp #b0 #b0101001010 #b1101111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011000010 #b1010001)
                arg2
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                arg2
                (fp #b1 #b0101000100 #b1011010)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0100000001 #b1000100)
                arg3
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                arg3
                (fp #b0 #b1010101011 #b0010011)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001010100 #b1000000)
                expect
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                expect
                (fp #b0 #b1011011011 #b0101101)))

(assert (= expect result))

(check-sat)
(exit)
