(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11111111111111110 #b000)
                arg1
                (fp #b1 #b11111111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b000)
                arg1
                (fp #b0 #b01011111101010000 #b000)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00101110101001101 #b111)
                arg2
                (fp #b0 #b00000000000000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b110)
                arg2
                (fp #b0 #b01100010101001110 #b011)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01010010100101100 #b110)
                arg3
                (fp #b0 #b00000000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b010)
                arg3
                (fp #b0 #b10001001111110010 #b101)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11010101100101101 #b101)
                expect
                (fp #b1 #b01111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b01111111111111110 #b011)
                expect
                (fp #b0 #b01001010100110101 #b001)))

(assert (= expect result))

(check-sat)
(exit)
