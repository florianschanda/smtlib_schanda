(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0101101010101111 #b10010)
                arg1
                (fp #b0 #b1111111111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b00000)
                arg1
                (fp #b0 #b1111111111111110 #b01100)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111010010101001 #b00101)
                arg2
                (fp #b1 #b0000000000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b10001)
                arg2
                (fp #b0 #b0101110010010111 #b00100)))

(declare-const arg3 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b1111101110111101 #b10110)
                arg3
                (fp #b0 #b1111111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111)
                arg3
                (fp #b0 #b1111111111111111 #b00000)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0111111110011101 #b00101)
                expect
                (fp #b0 #b1111111111111110 #b11110)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11110)
                expect
                (fp #b0 #b1111111111111111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
