(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -ZERO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111101 #b1000)
                arg1
                (fp #b1 #b111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000)
                arg1
                (fp #b1 #b101011011 #b1101)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b111001110 #b1010)
                arg2
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg2
                (fp #b0 #b101000110 #b1010)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010001111 #b1000)
                arg3
                (fp #b0 #b100000100 #b0000)))
(assert (fp.leq (fp #b0 #b100000100 #b0000)
                arg3
                (fp #b0 #b100100101 #b0010)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100110010 #b1101)
                expect
                (fp #b0 #b100000100 #b0000)))
(assert (fp.leq (fp #b0 #b100000100 #b0000)
                expect
                (fp #b0 #b100110101 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
