(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110101111111 #b01)
                arg1
                (fp #b1 #b011110100111 #b11)))
(assert (fp.leq (fp #b1 #b011110100111 #b11)
                arg1
                (fp #b0 #b100110000011 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000001111110 #b11)
                arg2
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg2
                (fp #b0 #b110010001010 #b01)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000111010000 #b01)
                arg3
                (fp #b0 #b110101100100 #b01)))
(assert (fp.leq (fp #b0 #b110101100100 #b01)
                arg3
                (fp #b0 #b111101001000 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b001100110010 #b11)
                expect
                (fp #b0 #b110101100100 #b01)))
(assert (fp.leq (fp #b0 #b110101100100 #b01)
                expect
                (fp #b0 #b111000000011 #b01)))

(assert (= expect result))

(check-sat)
(exit)
