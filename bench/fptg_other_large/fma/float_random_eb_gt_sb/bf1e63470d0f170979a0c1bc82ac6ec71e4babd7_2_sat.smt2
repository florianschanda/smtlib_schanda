(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111011110 #b0010001)
                arg1
                (fp #b1 #b0000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b0000000000 #b1111010)
                arg1
                (fp #b0 #b0010011010 #b1001011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000000010 #b0011110)
                arg2
                (fp #b1 #b0111010011 #b0011001)))
(assert (fp.leq (fp #b1 #b0111010011 #b0011001)
                arg2
                (fp #b0 #b0011011001 #b1100001)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100101110 #b0000011)
                arg3
                (fp #b0 #b1111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111111)
                arg3
                (fp #b0 #b1111111111 #b0000000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
