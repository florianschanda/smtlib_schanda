; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -ZERO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b011000011111001 #b111011)
                arg2
                (fp #b1 #b000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b000000)
                arg2
                (fp #b0 #b011000111101101 #b010001)))

(declare-const arg3 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b0 #b000101111100110 #b110000)
                arg3
                (fp #b0 #b110001011111011 #b001110)))
(assert (fp.leq (fp #b0 #b110001011111011 #b001110)
                arg3
                (fp #b0 #b110110110101111 #b111100)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
