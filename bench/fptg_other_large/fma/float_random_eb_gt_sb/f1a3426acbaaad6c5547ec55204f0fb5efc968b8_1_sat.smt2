; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11000011000001 #b01001)
                arg1
                (fp #b0 #b00000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000)
                arg1
                (fp #b0 #b11111101101000 #b01011)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111000100100 #b00100)
                arg2
                (fp #b1 #b01100010100000 #b01001)))
(assert (fp.leq (fp #b1 #b01100010100000 #b01001)
                arg2
                (fp #b0 #b10011010000001 #b00110)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01001100100100 #b11011)
                arg3
                (fp #b1 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000)
                arg3
                (fp #b0 #b10001011011000 #b01000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01110100100100 #b10100)
                expect
                (fp #b1 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000)
                expect
                (fp #b0 #b10011011100110 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
