                arg3
                (fp #b1 #b000101100100000010 #b01111011)))
(assert (fp.leq (fp #b1 #b000101100100000010 #b01111011)
                arg3
                (fp #b0 #b111110100001000111 #b11011110)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
