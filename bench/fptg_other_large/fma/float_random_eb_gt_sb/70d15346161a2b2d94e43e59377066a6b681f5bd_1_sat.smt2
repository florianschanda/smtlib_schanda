(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111010101 #b110110110)
                arg1
                (fp #b1 #b11000000011 #b111011111)))
(assert (fp.leq (fp #b1 #b11000000011 #b111011111)
                arg1
                (fp #b1 #b01010100011 #b110110000)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10110100101 #b110110110)
                arg2
                (fp #b0 #b01110011100 #b001001110)))
(assert (fp.leq (fp #b0 #b01110011100 #b001001110)
                arg2
                (fp #b0 #b11011000100 #b010111010)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11000111011 #b110010010)
                expect
                (fp #b1 #b10110100001 #b000111010)))
(assert (fp.leq (fp #b1 #b10110100001 #b000111010)
                expect
                (fp #b0 #b00011111101 #b001111011)))

(assert (= expect result))

(check-sat)
(exit)
