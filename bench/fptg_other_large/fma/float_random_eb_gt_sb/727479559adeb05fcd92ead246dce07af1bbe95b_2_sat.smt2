(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0100110101 #b00)
                arg1
                (fp #b0 #b1100100010 #b01)))
(assert (fp.leq (fp #b0 #b1100100010 #b01)
                arg1
                (fp #b0 #b1111110101 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111111 #b00)
                arg2
                (fp #b1 #b1111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                arg2
                (fp #b1 #b1010110010 #b00)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0000010111 #b00)
                arg3
                (fp #b0 #b1000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000010 #b00)
                arg3
                (fp #b0 #b1100010011 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
