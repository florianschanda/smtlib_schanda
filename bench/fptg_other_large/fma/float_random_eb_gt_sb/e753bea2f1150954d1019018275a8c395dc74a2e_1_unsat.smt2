(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1110011101110011 #b1001010)
                arg2
                (fp #b1 #b0000000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b1101110)
                arg2
                (fp #b0 #b1111010010101111 #b1111101)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
