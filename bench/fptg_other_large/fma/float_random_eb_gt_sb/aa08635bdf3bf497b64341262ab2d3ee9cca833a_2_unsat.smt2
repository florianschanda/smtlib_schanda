; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11010101000001 #b1101)
                arg1
                (fp #b0 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000000000100 #b0000)
                arg1
                (fp #b0 #b11110111000111 #b0111)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000)
                arg2
                (fp #b1 #b11111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111)
                arg2
                (fp #b0 #b10000100001001 #b0111)))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10110111010000 #b1000)
                arg3
                (fp #b1 #b10010100100000 #b1010)))
(assert (fp.leq (fp #b1 #b10010100100000 #b1010)
                arg3
                (fp #b0 #b01101010011110 #b1101)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
