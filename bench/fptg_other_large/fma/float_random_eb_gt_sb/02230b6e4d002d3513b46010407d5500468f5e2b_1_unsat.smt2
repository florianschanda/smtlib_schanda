(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111010011011 #b10100)
                arg1
                (fp #b1 #b001001100000 #b10001)))
(assert (fp.leq (fp #b1 #b001001100000 #b10001)
                arg1
                (fp #b0 #b110001111011 #b00011)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b111100100001 #b01010)
                arg3
                (fp #b0 #b000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000)
                arg3
                (fp #b0 #b011010110011 #b11010)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011111101101 #b11100)
                expect
                (fp #b0 #b000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000)
                expect
                (fp #b0 #b001001101101 #b01010)))

(assert (not (= expect result)))

(check-sat)
(exit)
