(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110000110011 #b10011000)
                arg1
                (fp #b1 #b100000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100000001000 #b00000000)
                arg1
                (fp #b0 #b110001011010 #b10011010)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010100110101 #b11011000)
                arg2
                (fp #b0 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000)
                arg2
                (fp #b0 #b111111111101 #b01001010)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b101011111011 #b01101001)
                arg3
                (fp #b0 #b110000001010 #b11100000)))
(assert (fp.leq (fp #b0 #b110000001010 #b11100000)
                arg3
                (fp #b0 #b110100010100 #b11001111)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
