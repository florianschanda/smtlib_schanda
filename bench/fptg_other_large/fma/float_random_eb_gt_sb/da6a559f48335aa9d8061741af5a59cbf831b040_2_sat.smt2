(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010111101000 #b10011000)
                arg1
                (fp #b0 #b010100001000 #b01111101)))
(assert (fp.leq (fp #b0 #b010100001000 #b01111101)
                arg1
                (fp #b0 #b110011101000 #b11011110)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b100010111111 #b11011011)
                arg2
                (fp #b0 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000)
                arg2
                (fp #b0 #b111111111101 #b10100000)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000011111101 #b00110001)
                arg3
                (fp #b0 #b000000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b000000000000 #b01110011)
                arg3
                (fp #b0 #b111000001111 #b11111000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110000000110 #b10111001)
                expect
                (fp #b0 #b110100000110 #b01111110)))
(assert (fp.leq (fp #b0 #b110100000110 #b01111110)
                expect
                (fp #b0 #b111101001100 #b01001101)))

(assert (= expect result))

(check-sat)
(exit)
