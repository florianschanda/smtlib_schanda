                (fp #b1 #b1100000001 #b0011)))
(assert (fp.leq (fp #b1 #b1100000001 #b0011)
                arg2
                (fp #b0 #b0011011100 #b1000)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0011010001 #b0001)
                arg3
                (fp #b0 #b1111111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000)
                arg3
                (fp #b0 #b1111111101 #b1011)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0010110100 #b1011)
                expect
                (fp #b0 #b1111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111)
                expect
                (fp #b0 #b1111111111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
