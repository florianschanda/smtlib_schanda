                arg2
                (fp #b0 #b00000000000 #b011111)))
(assert (fp.leq (fp #b0 #b00000000000 #b011111)
                arg2
                (fp #b0 #b11111101111 #b010100)))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
