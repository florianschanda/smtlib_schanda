(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110010010111 #b00001000)
                arg1
                (fp #b1 #b000000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000)
                arg1
                (fp #b0 #b110101011000 #b11101100)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011110001010 #b11010110)
                arg2
                (fp #b1 #b010101001111 #b10100110)))
(assert (fp.leq (fp #b1 #b010101001111 #b10100110)
                arg2
                (fp #b1 #b010011011111 #b00100110)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011110001111 #b01010101)
                arg3
                (fp #b1 #b001011011101 #b01100100)))
(assert (fp.leq (fp #b1 #b001011011101 #b01100100)
                arg3
                (fp #b0 #b000011010010 #b00011100)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110111000000 #b11111011)
                expect
                (fp #b1 #b001011011101 #b01100100)))
(assert (fp.leq (fp #b1 #b001011011101 #b01100100)
                expect
                (fp #b0 #b010100000111 #b11001001)))

(assert (= expect result))

(check-sat)
(exit)
