                (fp #b0 #b0000000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100000)
                arg3
                (fp #b0 #b1110011001101101 #b1000010)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

