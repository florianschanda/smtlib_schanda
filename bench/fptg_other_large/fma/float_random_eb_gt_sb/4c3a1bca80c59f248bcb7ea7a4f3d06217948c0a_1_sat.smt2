(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0001010111010101 #b011)
                arg1
                (fp #b0 #b0000000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010)
                arg1
                (fp #b0 #b1101001001100100 #b111)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1100111001110000 #b100)
                arg2
                (fp #b1 #b1100101110001011 #b011)))
(assert (fp.leq (fp #b1 #b1100101110001011 #b011)
                arg2
                (fp #b0 #b0000011011111100 #b101)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0011110110111110 #b100)
                arg3
                (fp #b0 #b0000000000000000 #b101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b101)
                arg3
                (fp #b0 #b1110011001001010 #b111)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111000110010110 #b100)
                expect
                (fp #b1 #b0100101110001011 #b010)))
(assert (fp.leq (fp #b1 #b0100101110001011 #b010)
                expect
                (fp #b1 #b0100010110100100 #b101)))

(assert (= expect result))

(check-sat)
(exit)
