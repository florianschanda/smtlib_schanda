(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0011110000 #b00001)
                arg1
                (fp #b0 #b1101111110 #b00011)))
(assert (fp.leq (fp #b0 #b1101111110 #b00011)
                arg1
                (fp #b0 #b1110110111 #b01110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101100100 #b11101)
                arg2
                (fp #b0 #b0010011000 #b00111)))
(assert (fp.leq (fp #b0 #b0010011000 #b00111)
                arg2
                (fp #b0 #b1110110011 #b11111)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111110 #b00011)
                arg3
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                arg3
                (fp #b1 #b0100000001 #b11000)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111110 #b01011)
                expect
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                expect
                (fp #b1 #b0111001000 #b10000)))

(assert (= expect result))

(check-sat)
(exit)
