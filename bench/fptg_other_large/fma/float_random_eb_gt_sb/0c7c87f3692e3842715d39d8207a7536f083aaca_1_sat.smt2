                (fp #b1 #b000000000000000 #b010001001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010001001)
                arg3
                (fp #b0 #b100111010011111 #b000110101)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111011010011110 #b110010000)
                expect
                (fp #b1 #b011111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b011111111111101 #b000000000)
                expect
                (fp #b1 #b001111010100100 #b011100010)))

(assert (= expect result))

(check-sat)
(exit)
