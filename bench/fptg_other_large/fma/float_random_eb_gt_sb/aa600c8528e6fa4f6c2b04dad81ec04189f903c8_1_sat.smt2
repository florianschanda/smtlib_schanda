                (fp #b1 #b10000000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000000100 #b0000)
                arg2
                (fp #b1 #b01001010100110011 #b1100)))

(declare-const arg3 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11010111011111100 #b0001)
                arg3
                (fp #b1 #b10000000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000000100 #b0000)
                arg3
                (fp #b0 #b10111101000010001 #b0100)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11100100010111100 #b1101)
                expect
                (fp #b1 #b10000000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000000100 #b0000)
                expect
                (fp #b0 #b10110000100101110 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
