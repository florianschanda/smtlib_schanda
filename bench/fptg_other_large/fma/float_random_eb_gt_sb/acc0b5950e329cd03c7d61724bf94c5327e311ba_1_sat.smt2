(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b110110110 #b1111100)
                arg1
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                arg1
                (fp #b0 #b000000111 #b1010111)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b010100010 #b1100100)
                arg2
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg2
                (fp #b0 #b100001010 #b0111001)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011111011 #b1010011)
                arg3
                (fp #b0 #b101000000 #b0000001)))
(assert (fp.leq (fp #b0 #b101000000 #b0000001)
                arg3
                (fp #b0 #b101011101 #b0110000)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b001000010 #b0011011)
                expect
                (fp #b0 #b101000000 #b0000001)))
(assert (fp.leq (fp #b0 #b101000000 #b0000001)
                expect
                (fp #b0 #b101100010 #b0001011)))

(assert (= expect result))

(check-sat)
(exit)
