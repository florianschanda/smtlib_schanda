(assert (fp.leq (fp #b1 #b11111111101 #b000)
                arg2
                (fp #b1 #b00110110111 #b011)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01101001111 #b101)
                arg3
                (fp #b1 #b00000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000)
                arg3
                (fp #b0 #b00101111000 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10010010100 #b000)
                expect
                (fp #b0 #b00000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000)
                expect
                (fp #b0 #b10100011110 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
