(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011001011 #b001110)
                arg1
                (fp #b0 #b100000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000110 #b000000)
                arg1
                (fp #b0 #b110110100 #b011001)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111101000 #b101111)
                arg2
                (fp #b0 #b000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000 #b010000)
                arg2
                (fp #b0 #b011111011 #b010111)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b111110001 #b011100)
                arg3
                (fp #b0 #b111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111101 #b000000)
                arg3
                (fp #b0 #b111111101 #b000101)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b011010000 #b100100)
                expect
                (fp #b0 #b111111101 #b000001)))
(assert (fp.leq (fp #b0 #b111111101 #b000001)
                expect
                (fp #b0 #b111111101 #b000011)))

(assert (= expect result))

(check-sat)
(exit)
