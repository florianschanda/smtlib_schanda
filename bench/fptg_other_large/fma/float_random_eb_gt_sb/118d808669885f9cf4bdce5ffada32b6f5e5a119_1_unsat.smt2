                (fp #b0 #b111111110 #b11)))
(assert (fp.leq (fp #b0 #b111111110 #b11)
                arg2
                (fp #b0 #b111111111 #b00)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b000001111 #b01)
                arg3
                (fp #b0 #b000001101 #b10)))
(assert (fp.leq (fp #b0 #b000001101 #b10)
                arg3
                (fp #b0 #b100001001 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111111 #b00)
                expect
                (fp #b1 #b111111110 #b11)))
(assert (fp.leq (fp #b1 #b111111110 #b11)
                expect
                (fp #b0 #b111101111 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
