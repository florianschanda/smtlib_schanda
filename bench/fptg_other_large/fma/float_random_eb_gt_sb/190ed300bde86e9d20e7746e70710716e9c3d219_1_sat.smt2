; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b010000001100000100 #b110)
                arg2
                (fp #b0 #b100000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000000000011 #b000)
                arg2
                (fp #b0 #b111010100011011011 #b001)))

(declare-const arg3 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b101110110100000001 #b011)
                arg3
                (fp #b0 #b100000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000000000011 #b000)
                arg3
                (fp #b0 #b101001001000101101 #b001)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
