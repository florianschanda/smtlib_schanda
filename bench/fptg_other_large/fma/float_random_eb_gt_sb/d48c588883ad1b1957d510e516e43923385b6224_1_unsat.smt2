(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                arg1
                (fp #b1 #b111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111110 #b111)
                arg1
                (fp #b0 #b110001101 #b011)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b100100110 #b100)
                arg2
                (fp #b0 #b111101100 #b011)))
(assert (fp.leq (fp #b0 #b111101100 #b011)
                arg2
                (fp #b0 #b111110011 #b011)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b000001100 #b011)
                arg3
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                arg3
                (fp #b0 #b011001011 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                expect
                (fp #b1 #b111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111110 #b111)
                expect
                (fp #b0 #b000011110 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
