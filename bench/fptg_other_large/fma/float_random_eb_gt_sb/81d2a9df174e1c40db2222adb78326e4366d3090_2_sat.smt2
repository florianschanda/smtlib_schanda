(declare-const arg3 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b00011011111011110 #b010110000000110)
                arg3
                (fp #b0 #b00000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b010000000000000)
                arg3
                (fp #b0 #b01111101100111001 #b100011101001111)))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11010001010100001 #b011101000111111)
                expect
                (fp #b0 #b00000000000000000 #b010000000000001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b010000000000001)
                expect
                (fp #b0 #b11011010011011100 #b001010000011110)))

(assert (= expect result))

(check-sat)
(exit)
