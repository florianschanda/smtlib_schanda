(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b110000010010 #b11)
                arg1
                (fp #b0 #b111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111101 #b00)
                arg1
                (fp #b0 #b111111111110 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111101011100 #b11)
                arg2
                (fp #b1 #b000000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000000 #b10)
                arg2
                (fp #b0 #b001110100000 #b01)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100001000111 #b11)
                arg3
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg3
                (fp #b0 #b110010100001 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110101001011 #b10)
                expect
                (fp #b1 #b011111111110 #b00)))
(assert (fp.leq (fp #b1 #b011111111110 #b00)
                expect
                (fp #b0 #b101110010010 #b10)))

(assert (= expect result))

(check-sat)
(exit)
