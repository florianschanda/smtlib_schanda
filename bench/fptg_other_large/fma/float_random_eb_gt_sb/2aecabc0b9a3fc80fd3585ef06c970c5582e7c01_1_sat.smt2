(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b00000101000010 #b101001)
                arg1
                (fp #b0 #b11111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000000)
                arg1
                (fp #b0 #b11111111111110 #b101110)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11100110011001 #b011111)
                arg3
                (fp #b0 #b00000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000)
                arg3
                (fp #b0 #b00010010111010 #b110111)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
