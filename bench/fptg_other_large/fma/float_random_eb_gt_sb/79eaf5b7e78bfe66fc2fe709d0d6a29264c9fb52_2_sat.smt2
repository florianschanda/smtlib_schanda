(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10001101001111 #b01011011)
                arg1
                (fp #b1 #b01101110110011 #b01111010)))
(assert (fp.leq (fp #b1 #b01101110110011 #b01111010)
                arg1
                (fp #b1 #b00100000000010 #b01010011)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11000100101101 #b10100101)
                arg2
                (fp #b0 #b00000000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000011)
                arg2
                (fp #b0 #b01111000111000 #b10011100)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b01110100101100 #b11001101)
                expect
                (fp #b0 #b00000000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000011)
                expect
                (fp #b0 #b10011101101010 #b01110110)))

(assert (= expect result))

(check-sat)
(exit)
