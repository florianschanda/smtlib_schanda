(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg3
                (fp #b0 #b1010011100 #b10110)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001000000 #b11101)
                expect
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                expect
                (fp #b0 #b1111010011 #b10000)))

(assert (not (= expect result)))

