(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111001110 #b1010)
                arg1
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                arg1
                (fp #b1 #b011111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111110 #b0011)
                arg2
                (fp #b1 #b000000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000000 #b1110)
                arg2
                (fp #b0 #b100001001 #b0011)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010000010 #b0100)
                expect
                (fp #b0 #b000000101 #b1100)))
(assert (fp.leq (fp #b0 #b000000101 #b1100)
                expect
                (fp #b0 #b100011010 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
