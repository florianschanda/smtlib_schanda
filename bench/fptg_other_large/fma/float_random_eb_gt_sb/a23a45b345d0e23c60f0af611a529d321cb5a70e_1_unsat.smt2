(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111000000001011 #b010101100)
                arg1
                (fp #b1 #b0000101001111000 #b010001010)))
(assert (fp.leq (fp #b1 #b0000101001111000 #b010001010)
