                arg2
                (fp #b0 #b0000000000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100101010)
                arg2
                (fp #b0 #b1010111010001110 #b010101101)))

(declare-const arg3 (_ FloatingPoint 16 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0111000001001010 #b111111100)
                expect
                (fp #b1 #b0000000000000000 #b100101010)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100101010)
                expect
                (fp #b0 #b1111110010100111 #b111011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
