; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00001111111111000 #b0010)
                arg1
                (fp #b1 #b00000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000)
                arg1
                (fp #b0 #b01010011110111011 #b0000)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b01100001101001111 #b1000)
                arg2
                (fp #b0 #b11111101110110010 #b0001)))
(assert (fp.leq (fp #b0 #b11111101110110010 #b0001)
                arg2
                (fp #b0 #b11111111001001000 #b0010)))

(declare-const arg3 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11011110101001111 #b1100)
                arg3
                (fp #b0 #b11111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1111)
                arg3
                (fp #b0 #b11111111111111111 #b0000)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b01000111110111101 #b1000)
                expect
                (fp #b0 #b11111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1111)
                expect
                (fp #b0 #b11111111111111111 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
