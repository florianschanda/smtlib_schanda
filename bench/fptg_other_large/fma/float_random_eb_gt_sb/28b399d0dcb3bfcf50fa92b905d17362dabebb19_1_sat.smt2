(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1101010000 #b110)
                arg1
                (fp #b1 #b0000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000 #b010)
                arg1
                (fp #b0 #b0001010011 #b001)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001010101 #b000)
                arg2
                (fp #b1 #b0100111010 #b001)))
(assert (fp.leq (fp #b1 #b0100111010 #b001)
                arg2
                (fp #b1 #b0001001100 #b100)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0111111011 #b010)
                arg3
                (fp #b1 #b0000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000 #b010)
                arg3
                (fp #b0 #b1000110110 #b001)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010111001 #b110)
                expect
                (fp #b1 #b0000000000 #b001)))
(assert (fp.leq (fp #b1 #b0000000000 #b001)
                expect
                (fp #b0 #b0010001010 #b000)))

(assert (= expect result))

(check-sat)
(exit)
