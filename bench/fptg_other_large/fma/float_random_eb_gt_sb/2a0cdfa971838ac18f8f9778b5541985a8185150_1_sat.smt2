; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00011111101 #b0000)
                arg1
                (fp #b0 #b10100110101 #b0011)))
(assert (fp.leq (fp #b0 #b10100110101 #b0011)
                arg1
                (fp #b0 #b10110101011 #b0001)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b01110101010 #b0010)
                arg2
                (fp #b0 #b10000000011 #b0011)))
(assert (fp.leq (fp #b0 #b10000000011 #b0011)
                arg2
                (fp #b0 #b10010010001 #b0010)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111111 #b0000)
                arg3
                (fp #b1 #b11111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111)
                arg3
                (fp #b0 #b11011101010 #b1000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111111 #b0000)
                expect
                (fp #b1 #b11111111110 #b1110)))
(assert (fp.leq (fp #b1 #b11111111110 #b1110)
                expect
                (fp #b0 #b11000111111 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
