; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b010110001001101 #b0111110000)
                arg2
                (fp #b0 #b001111000011110 #b0000101101)))
(assert (fp.leq (fp #b0 #b001111000011110 #b0000101101)
                arg2
                (fp #b0 #b010011011101110 #b1111000000)))

(declare-const arg3 (_ FloatingPoint 15 11))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b011111110110010 #b1010010001)
                arg3
                (fp #b0 #b000000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000)
                arg3
                (fp #b0 #b001011000100001 #b1110100010)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
