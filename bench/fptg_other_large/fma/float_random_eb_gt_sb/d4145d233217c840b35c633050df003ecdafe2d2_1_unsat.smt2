(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +NAN
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0100001000010000 #b1000101)
                arg3
                (fp #b0 #b0100001010100101 #b1011000)))
(assert (fp.leq (fp #b0 #b0100001010100101 #b1011000)
                arg3
                (fp #b0 #b1110111001100010 #b0101010)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
