(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INFINITY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11110110110011 #b00000)
                arg1
                (fp #b0 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000)
                arg1
                (fp #b0 #b01110001111100 #b00101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011001111000 #b01110)
                arg3
                (fp #b0 #b10000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000000101 #b00000)
                arg3
                (fp #b0 #b11100011100001 #b11100)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
