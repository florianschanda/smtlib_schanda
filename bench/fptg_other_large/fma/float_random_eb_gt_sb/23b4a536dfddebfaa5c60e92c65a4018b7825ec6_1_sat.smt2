(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0110011001011001 #b011000)
                arg1
                (fp #b0 #b1100001111011110 #b010111)))
