                arg1
                (fp #b0 #b1101011000100010 #b110011)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b0000000101111001 #b110100)
                arg2
                (fp #b0 #b1000000000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000000000110 #b000000)
                arg2
                (fp #b0 #b1100010111100101 #b100111)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
