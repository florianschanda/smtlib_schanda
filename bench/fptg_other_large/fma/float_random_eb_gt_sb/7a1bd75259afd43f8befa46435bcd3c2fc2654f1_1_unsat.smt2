; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00100000010110 #b100010)
                arg1
                (fp #b1 #b00000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000000)
                arg1
                (fp #b0 #b10010100011100 #b111101)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000)
                arg2
                (fp #b1 #b11111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111)
                arg2
                (fp #b1 #b11110110010010 #b100100)))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
