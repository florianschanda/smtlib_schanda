(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101110000111 #b1001)
                arg1
                (fp #b0 #b000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100)
                arg1
                (fp #b0 #b101001100101 #b1101)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001111110011 #b0100)
                arg2
                (fp #b0 #b000000000000 #b0111)))
(assert (fp.leq (fp #b0 #b000000000000 #b0111)
                arg2
                (fp #b0 #b111100001001 #b1010)))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111010100111 #b0000)
                arg3
                (fp #b1 #b110100010110 #b1110)))
(assert (fp.leq (fp #b1 #b110100010110 #b1110)
                arg3
                (fp #b1 #b100101010011 #b0011)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110101111010 #b0101)
                expect
                (fp #b1 #b110100010110 #b1101)))
(assert (fp.leq (fp #b1 #b110100010110 #b1101)
                expect
                (fp #b0 #b000110110010 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
