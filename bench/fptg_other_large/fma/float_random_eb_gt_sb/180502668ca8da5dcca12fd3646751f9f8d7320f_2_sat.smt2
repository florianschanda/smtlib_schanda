(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11110010111110000 #b1100)
                arg1
                (fp #b1 #b00000000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0011)
                arg1
                (fp #b0 #b01011011001110010 #b1111)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11101000011110011 #b1100)
                arg3
                (fp #b1 #b01001010011101000 #b1100)))
(assert (fp.leq (fp #b1 #b01001010011101000 #b1100)
                arg3
                (fp #b0 #b10011011010000000 #b1110)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11001110101110110 #b0011)
                expect
                (fp #b1 #b01001010011101000 #b1100)))
(assert (fp.leq (fp #b1 #b01001010011101000 #b1100)
                expect
                (fp #b1 #b00000101101011101 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
