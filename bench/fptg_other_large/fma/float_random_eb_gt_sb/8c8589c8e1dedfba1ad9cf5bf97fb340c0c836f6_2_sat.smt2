                (fp #b1 #b100000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000000000111 #b0000000)
                arg2
                (fp #b0 #b100101011100101 #b1110000)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b011011100011010 #b1111011)
                arg3
                (fp #b0 #b000000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0100000)
                arg3
                (fp #b0 #b001101011100000 #b1110100)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111110111111001 #b0100000)
                expect
                (fp #b1 #b110010100110110 #b0010111)))
(assert (fp.leq (fp #b1 #b110010100110110 #b0010111)
                expect
                (fp #b0 #b111101011010111 #b1010001)))

(assert (= expect result))

(check-sat)
(exit)
