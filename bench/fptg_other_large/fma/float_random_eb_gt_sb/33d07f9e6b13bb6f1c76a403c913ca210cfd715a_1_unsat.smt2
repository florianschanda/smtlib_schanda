(assert (fp.leq (fp #b1 #b110011101100 #b0010)
                arg3
                (fp #b0 #b111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111)
                arg3
                (fp #b0 #b111111111111 #b0000)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
