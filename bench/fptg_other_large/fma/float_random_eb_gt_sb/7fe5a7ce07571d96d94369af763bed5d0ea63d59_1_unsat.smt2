; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b1111111010 #b01000)
                arg1
                (fp #b0 #b1111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111)
                arg1
                (fp #b0 #b1111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000000001 #b11000)
                arg2
                (fp #b0 #b0010011000 #b00111)))
(assert (fp.leq (fp #b0 #b0010011000 #b00111)
                arg2
                (fp #b0 #b1010110100 #b01110)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0000111101 #b01101)
                arg3
                (fp #b1 #b0000000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000)
                arg3
                (fp #b0 #b0010010001 #b00011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101010000 #b10001)
                expect
                (fp #b0 #b1010011000 #b00110)))
(assert (fp.leq (fp #b0 #b1010011000 #b00110)
                expect
                (fp #b0 #b1110110110 #b00101)))

(assert (not (= expect result)))

(check-sat)
(exit)
