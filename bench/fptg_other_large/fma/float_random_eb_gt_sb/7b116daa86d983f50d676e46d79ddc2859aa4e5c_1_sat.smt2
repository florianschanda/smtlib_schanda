; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111011000111 #b10011)
                arg1
                (fp #b1 #b110011000100 #b01110)))
(assert (fp.leq (fp #b1 #b110011000100 #b01110)
                arg1
                (fp #b0 #b001000010100 #b10100)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100100101111 #b11011)
                arg2
                (fp #b0 #b000000000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000000000 #b10101)
                arg2
                (fp #b0 #b111001100110 #b11110)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
