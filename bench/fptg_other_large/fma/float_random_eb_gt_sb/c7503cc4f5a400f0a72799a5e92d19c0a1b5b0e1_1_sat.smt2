(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010001 #b10)
                arg1
                (fp #b1 #b100010001 #b11)))
(assert (fp.leq (fp #b1 #b100010001 #b11)
                arg1
                (fp #b1 #b010001110 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010000010 #b10)
                arg3
                (fp #b1 #b000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000 #b00)
                arg3
                (fp #b0 #b100000000 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101000101 #b01)
                expect
                (fp #b0 #b100100100 #b10)))
(assert (fp.leq (fp #b0 #b100100100 #b10)
                expect
                (fp #b0 #b101111100 #b01)))

(assert (= expect result))

(check-sat)
(exit)
