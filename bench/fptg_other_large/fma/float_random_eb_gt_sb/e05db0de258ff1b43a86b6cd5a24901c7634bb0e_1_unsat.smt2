(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INFINITY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b10001)
                arg1
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                arg1
                (fp #b0 #b0010000100 #b01110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100101011 #b11000)
                arg3
                (fp #b1 #b0000000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000)
                arg3
                (fp #b0 #b1110000101 #b10011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
