; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111111111101 #b1)
                arg1
                (fp #b1 #b1111111111101 #b0)))
(assert (fp.leq (fp #b1 #b1111111111101 #b0)
                arg1
                (fp #b0 #b0011101010001 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1011001010101 #b1)
                arg2
                (fp #b1 #b0000000000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0)
                arg2
                (fp #b0 #b1001010111100 #b1)))

(declare-const arg3 (_ FloatingPoint 13 2))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
