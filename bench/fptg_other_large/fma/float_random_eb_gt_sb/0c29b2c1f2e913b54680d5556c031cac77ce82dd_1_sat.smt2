(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0001011100111001 #b0000011)
                arg1
                (fp #b0 #b0000100111011000 #b0110110)))
(assert (fp.leq (fp #b0 #b0000100111011000 #b0110110)
                arg1
                (fp #b0 #b0001100000010100 #b0001011)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
