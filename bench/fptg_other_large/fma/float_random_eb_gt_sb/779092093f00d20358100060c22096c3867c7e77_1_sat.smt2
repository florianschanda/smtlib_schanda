; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b00000101010011 #b000001101)
                arg1
                (fp #b0 #b11111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000000000)
                arg1
                (fp #b0 #b11111111111101 #b110111111)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111111101 #b100100110)
                arg2
                (fp #b1 #b11111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000000000)
                arg2
                (fp #b0 #b01000010111011 #b101100110)))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11010111001001 #b111101001)
                arg3
                (fp #b0 #b00000000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b00000000000000 #b001100101)
                arg3
                (fp #b0 #b00010010000011 #b101010000)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000000)
                expect
                (fp #b1 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111111)
                expect
                (fp #b0 #b11100000101110 #b111011000)))

(assert (= expect result))

(check-sat)
(exit)
