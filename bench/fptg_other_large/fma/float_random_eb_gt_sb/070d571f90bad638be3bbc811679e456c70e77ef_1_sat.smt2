(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100010 #b10011)
                arg2
                (fp #b0 #b111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000)
                arg2
                (fp #b0 #b111111101 #b11110)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100011011 #b10101)
                arg3
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                arg3
                (fp #b0 #b010001101 #b01011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
