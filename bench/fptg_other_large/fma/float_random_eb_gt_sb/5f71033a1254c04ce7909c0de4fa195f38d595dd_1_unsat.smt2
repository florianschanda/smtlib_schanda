(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111000111010 #b010110)
                arg1
                (fp #b1 #b110100110010 #b101101)))
(assert (fp.leq (fp #b1 #b110100110010 #b101101)
                arg1
                (fp #b1 #b110001110100 #b010100)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011000001000 #b110011)
                arg3
                (fp #b0 #b111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000000)
                arg3
                (fp #b0 #b111111111101 #b110110)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111111111111 #b000000)
                expect
                (fp #b1 #b111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111111)
                expect
                (fp #b0 #b110101001010 #b101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
