(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00011100110100 #b010)
                arg1
                (fp #b0 #b00000000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000)
                arg1
                (fp #b0 #b01001111000100 #b100)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11110111101101 #b111)
                arg2
                (fp #b1 #b01010110101010 #b001)))
(assert (fp.leq (fp #b1 #b01010110101010 #b001)
                arg2
                (fp #b1 #b00001010101100 #b101)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10000011100111 #b111)
                expect
                (fp #b1 #b01010110101010 #b001)))
(assert (fp.leq (fp #b1 #b01010110101010 #b001)
                expect
                (fp #b0 #b11101101011110 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
