; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011100011 #b0001)
                arg1
                (fp #b0 #b1000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000100 #b0000)
                arg1
                (fp #b0 #b1010110100 #b0101)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001100000 #b1001)
                arg2
                (fp #b0 #b1111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111)
                arg2
                (fp #b0 #b1111111111 #b0000)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010001111 #b1010)
                arg3
                (fp #b0 #b1000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000100 #b0000)
                arg3
                (fp #b0 #b1000010000 #b1101)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
