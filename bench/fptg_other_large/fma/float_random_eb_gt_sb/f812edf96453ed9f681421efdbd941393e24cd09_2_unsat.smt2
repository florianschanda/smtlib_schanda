(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110100111010 #b01)
                arg1
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg1
                (fp #b0 #b111100111111 #b00)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100100001011 #b01)
                arg2
                (fp #b1 #b011011010110 #b10)))
(assert (fp.leq (fp #b1 #b011011010110 #b10)
                arg2
                (fp #b0 #b010101011010 #b11)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101111000100 #b01)
                expect
                (fp #b1 #b011011010110 #b11)))
(assert (fp.leq (fp #b1 #b011011010110 #b11)
                expect
                (fp #b1 #b001001011110 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
