(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101011111 #b1110101)
                arg1
                (fp #b1 #b001111001 #b1100110)))
(assert (fp.leq (fp #b1 #b001111001 #b1100110)
                arg1
                (fp #b0 #b000100110 #b1100101)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010111101 #b1010100)
                arg2
                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                arg2
                (fp #b0 #b101000000 #b0101110)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
