;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b00101011000100 #b000110)
                arg1
                (fp #b1 #b00000000000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000)
                arg1
                (fp #b0 #b11010001010000 #b100000)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01100001101110 #b010010)
                arg2
                (fp #b1 #b00000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000000)
                arg2
                (fp #b0 #b11100101000000 #b100011)))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
