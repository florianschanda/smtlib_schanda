(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b010110010 #b01)
                arg1
                (fp #b0 #b011010011 #b10)))
(assert (fp.leq (fp #b0 #b011010011 #b10)
                arg1
                (fp #b0 #b101000111 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110111110 #b01)
                arg3
                (fp #b0 #b000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000 #b10)
                arg3
                (fp #b0 #b001100011 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100110100 #b10)
                expect
                (fp #b1 #b010101000 #b01)))
(assert (fp.leq (fp #b1 #b010101000 #b01)
                expect
                (fp #b0 #b001001010 #b00)))

(assert (= expect result))

(check-sat)
(exit)
