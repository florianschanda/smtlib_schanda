;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001111110 #b100110)
                arg1
                (fp #b0 #b000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000 #b010000)
                arg1
                (fp #b0 #b000011001 #b111111)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111101 #b111111)
                arg2
                (fp #b1 #b111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111101 #b000000)
                arg2
                (fp #b0 #b111101110 #b011010)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001010000 #b101010)
                arg3
                (fp #b1 #b000000000 #b100111)))
(assert (fp.leq (fp #b1 #b000000000 #b100111)
                arg3
                (fp #b0 #b110101111 #b101101)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101110011 #b000111)
                expect
                (fp #b1 #b011111101 #b000001)))
(assert (fp.leq (fp #b1 #b011111101 #b000001)
                expect
                (fp #b0 #b100110011 #b111101)))

(assert (= expect result))

(check-sat)
(exit)
