(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INFINITY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110110101101000 #b100101100)
                arg1
                (fp #b1 #b1000000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000000000001001 #b000000000)
                arg1
                (fp #b1 #b0010111111001010 #b110001011)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 10))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
