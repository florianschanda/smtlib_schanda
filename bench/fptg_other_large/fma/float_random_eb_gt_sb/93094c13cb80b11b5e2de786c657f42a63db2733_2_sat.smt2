(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01010101000 #b01010)
                arg1
                (fp #b1 #b00000000000 #b01000)))
(assert (fp.leq (fp #b1 #b00000000000 #b01000)
                arg1
                (fp #b0 #b11100111011 #b01101)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10100000000 #b01000)
                arg2
                (fp #b1 #b00000011011 #b01110)))
(assert (fp.leq (fp #b1 #b00000011011 #b01110)
                arg2
                (fp #b0 #b10010010010 #b11010)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00110101110 #b01101)
                arg3
                (fp #b1 #b00000000000 #b10000)))
(assert (fp.leq (fp #b1 #b00000000000 #b10000)
                arg3
                (fp #b0 #b00010101100 #b11010)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01111000010 #b01110)
                expect
                (fp #b1 #b00000000000 #b10000)))
(assert (fp.leq (fp #b1 #b00000000000 #b10000)
                expect
                (fp #b0 #b01000111000 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
