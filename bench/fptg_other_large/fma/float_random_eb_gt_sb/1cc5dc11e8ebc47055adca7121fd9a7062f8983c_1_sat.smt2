(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1110000101000 #b010101111)
                arg1
                (fp #b1 #b1101111000101 #b110101000)))
(assert (fp.leq (fp #b1 #b1101111000101 #b110101000)
                arg1
                (fp #b0 #b1111000001011 #b110010101)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1010110001011 #b101110010)
                arg2
                (fp #b0 #b0000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000)
                arg2
                (fp #b0 #b1101011000001 #b011011010)))

(declare-const arg3 (_ FloatingPoint 13 10))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
