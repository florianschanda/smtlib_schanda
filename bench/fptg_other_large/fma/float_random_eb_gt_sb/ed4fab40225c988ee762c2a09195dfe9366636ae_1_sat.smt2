(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b001100111000 #b110)
                arg1
                (fp #b0 #b111111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111)
                arg1
                (fp #b0 #b111111111111 #b000)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b000010110010 #b100)
                arg2
                (fp #b0 #b111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000)
                arg2
                (fp #b0 #b111111111101 #b111)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
