(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010001000 #b10010010)
                arg1
                (fp #b1 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b1000001000 #b00000000)
                arg1
                (fp #b1 #b0010101010 #b00000001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110010110 #b01111000)
                arg2
                (fp #b1 #b0110000010 #b10011001)))
(assert (fp.leq (fp #b1 #b0110000010 #b10011001)
                arg2
                (fp #b1 #b0001111110 #b11110000)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b10011010)
                arg3
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg3
                (fp #b1 #b0010111101 #b00001011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b11000011)
                expect
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                expect
                (fp #b1 #b1101110101 #b11011101)))

(assert (= expect result))

(check-sat)
(exit)
