(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0000010111 #b01)
                arg1
                (fp #b1 #b0000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000 #b10)
                arg1
                (fp #b0 #b0100001101 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110100000 #b01)
                arg2
                (fp #b0 #b1111111101 #b00)))
(assert (fp.leq (fp #b0 #b1111111101 #b00)
                arg2
                (fp #b0 #b1111111110 #b00)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011010111 #b11)
                arg3
                (fp #b0 #b1000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000010 #b00)
                arg3
                (fp #b0 #b1111111000 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0000001110 #b10)
                expect
                (fp #b0 #b1000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000010 #b00)
                expect
                (fp #b0 #b1001010100 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
