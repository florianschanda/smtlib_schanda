(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1001011010 #b00)
                arg1
                (fp #b1 #b1001000000 #b11)))
(assert (fp.leq (fp #b1 #b1001000000 #b11)
                arg1
                (fp #b0 #b1100101110 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0110100111 #b01)
                arg2
                (fp #b1 #b0000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000 #b10)
                arg2
                (fp #b0 #b0111000100 #b10)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011011000 #b11)
                arg3
                (fp #b1 #b1000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000010 #b00)
                arg3
                (fp #b0 #b0010000001 #b01)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1000100101 #b11)
                expect
                (fp #b1 #b1000000001 #b11)))
(assert (fp.leq (fp #b1 #b1000000001 #b11)
                expect
                (fp #b1 #b0101011101 #b00)))

(assert (= expect result))

(check-sat)
(exit)
