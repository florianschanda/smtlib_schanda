                arg2
                (fp #b0 #b000000000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0100000)
                arg2
                (fp #b0 #b110100100011101001 #b1011000)))

(declare-const arg3 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b0 #b100010001000101011 #b0111110)
                arg3
                (fp #b0 #b111111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b1111111)
                arg3
                (fp #b0 #b111111111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b0 #b100001010111011100 #b1100111)
                expect
                (fp #b0 #b111111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b1111111)
                expect
                (fp #b0 #b111111111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
