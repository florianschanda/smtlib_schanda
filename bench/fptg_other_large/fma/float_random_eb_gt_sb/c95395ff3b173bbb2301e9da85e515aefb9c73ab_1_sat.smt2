;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b100111101011011010 #b1101000)
                arg1
                (fp #b1 #b000000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000000)
                arg1
