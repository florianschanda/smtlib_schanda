(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1011110001010 #b010011101)
                arg1
                (fp #b0 #b0000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000)
                arg1
                (fp #b0 #b0110000110011 #b011011110)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1000110100000 #b010110000)
                arg2
                (fp #b0 #b0000000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b100101010)
                arg2
                (fp #b0 #b1110100001000 #b010000011)))

(declare-const arg3 (_ FloatingPoint 13 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101110100101 #b011110001)
                expect
                (fp #b1 #b0000000000000 #b100101010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b100101010)
                expect
                (fp #b0 #b1100000100101 #b000111111)))

(assert (= expect result))

(check-sat)
(exit)
