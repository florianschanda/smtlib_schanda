(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001010001110110 #b101010011)
                arg1
                (fp #b0 #b000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000000000)
                arg1
                (fp #b0 #b110110110001110 #b000100111)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b000111000000111 #b100110000)
                arg2
                (fp #b0 #b110100001100010 #b101101010)))
(assert (fp.leq (fp #b0 #b110100001100010 #b101101010)
                arg2
                (fp #b0 #b110110110011001 #b101010110)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111010110001010 #b101101001)
                expect
                (fp #b1 #b110100001100010 #b101101010)))
(assert (fp.leq (fp #b1 #b110100001100010 #b101101010)
                expect
                (fp #b1 #b010110100100011 #b111000110)))

(assert (= expect result))

(check-sat)
(exit)
