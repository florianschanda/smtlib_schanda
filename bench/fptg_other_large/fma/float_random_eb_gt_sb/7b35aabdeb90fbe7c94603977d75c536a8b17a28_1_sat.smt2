(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1101001101010101 #b1010)
                arg1
                (fp #b1 #b0000000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0011)
                arg1
                (fp #b0 #b0011111011001010 #b0101)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0100)
                arg2
                (fp #b1 #b1111111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0000)
                arg2
                (fp #b0 #b0100100101011011 #b0011)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
