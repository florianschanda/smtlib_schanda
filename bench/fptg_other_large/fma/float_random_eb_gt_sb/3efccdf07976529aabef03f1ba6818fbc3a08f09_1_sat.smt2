(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001101101 #b000000)
                arg1
                (fp #b0 #b0000000000 #b010111)))
(assert (fp.leq (fp #b0 #b0000000000 #b010111)
                arg1
                (fp #b0 #b1111011011 #b111111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111101 #b011011)
                arg2
                (fp #b1 #b1110000110 #b101111)))
(assert (fp.leq (fp #b1 #b1110000110 #b101111)
                arg2
                (fp #b1 #b0110000000 #b110111)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
