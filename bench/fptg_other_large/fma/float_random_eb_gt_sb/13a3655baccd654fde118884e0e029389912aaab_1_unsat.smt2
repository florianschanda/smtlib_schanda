(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1000100001 #b111110)
                arg2
                (fp #b1 #b0011011111 #b011011)))
(assert (fp.leq (fp #b1 #b0011011111 #b011011)
                arg2
                (fp #b0 #b1100111000 #b000101)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0011010101 #b011010)
                arg3
                (fp #b0 #b0000000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000)
                arg3
                (fp #b0 #b1010011101 #b111000)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
