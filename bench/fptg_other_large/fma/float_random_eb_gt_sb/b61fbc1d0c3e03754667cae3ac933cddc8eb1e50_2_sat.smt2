                arg2
                (fp #b1 #b011001110010 #b001100)))
(assert (fp.leq (fp #b1 #b011001110010 #b001100)
                arg2
                (fp #b0 #b111010001111 #b011111)))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101100000010 #b101110)
                arg3
                (fp #b1 #b000000000000 #b100111)))
(assert (fp.leq (fp #b1 #b000000000000 #b100111)
                arg3
                (fp #b0 #b011100001101 #b010001)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b100101011110 #b110011)
                expect
                (fp #b0 #b111001110010 #b001100)))
(assert (fp.leq (fp #b0 #b111001110010 #b001100)
                expect
                (fp #b0 #b111011110101 #b111000)))

(assert (= expect result))

(check-sat)
(exit)
