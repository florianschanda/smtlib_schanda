(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111111111111 #b0000)
                arg1
                (fp #b1 #b111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111)
                arg1
                (fp #b1 #b000000001000 #b0011)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110010110000 #b1110)
                arg2
                (fp #b1 #b010011111001 #b0111)))
(assert (fp.leq (fp #b1 #b010011111001 #b0111)
                arg2
                (fp #b1 #b001010100100 #b0100)))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111001011010 #b0100)
                arg3
                (fp #b1 #b100000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000100 #b0000)
                arg3
                (fp #b1 #b100000000001 #b1001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b001000010001 #b1011)
                expect
                (fp #b0 #b110011111001 #b0111)))
(assert (fp.leq (fp #b0 #b110011111001 #b0111)
                expect
                (fp #b0 #b111011101011 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
