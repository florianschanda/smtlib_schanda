; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101100110011100101 #b0)
                arg1
                (fp #b1 #b000000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0)
                arg1
                (fp #b0 #b000000111111101000 #b1)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111110111000000001 #b1)
                arg2
                (fp #b1 #b100000000000000001 #b0)))
(assert (fp.leq (fp #b1 #b100000000000000001 #b0)
                arg2
                (fp #b0 #b111011011110000000 #b0)))

(declare-const arg3 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b0 #b111101001100000011 #b0)
                arg3
                (fp #b0 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0)
                arg3
                (fp #b0 #b111111111111111111 #b0)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b010111010010100110 #b1)
                expect
                (fp #b0 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0)
                expect
                (fp #b0 #b111111111111111110 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
