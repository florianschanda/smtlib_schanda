(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100010001111 #b001)
                arg1
                (fp #b0 #b100000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000011 #b000)
                arg1
                (fp #b0 #b100101001011 #b011)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111011100100 #b010)
                arg2
                (fp #b1 #b100000000011 #b000)))
(assert (fp.leq (fp #b1 #b100000000011 #b000)
                arg2
                (fp #b0 #b010001010111 #b000)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111101001101 #b111)
                arg3
                (fp #b1 #b110001100100 #b101)))
(assert (fp.leq (fp #b1 #b110001100100 #b101)
                arg3
                (fp #b0 #b111100011010 #b100)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110001100111 #b110)
                expect
                (fp #b1 #b110001100100 #b101)))
(assert (fp.leq (fp #b1 #b110001100100 #b101)
                expect
                (fp #b0 #b101110010110 #b001)))

(assert (= expect result))

(check-sat)
(exit)
