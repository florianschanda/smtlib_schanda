(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110110101111111 #b000)
                arg1
                (fp #b1 #b1110110010110100 #b000)))
(assert (fp.leq (fp #b1 #b1110110010110100 #b000)
                arg1
                (fp #b1 #b1101010101000100 #b110)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0111100110111011 #b101)
                arg2
                (fp #b1 #b0000000000000000 #b101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b101)
                arg2
                (fp #b0 #b0110100111100101 #b111)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0011001000100110 #b011)
                arg3
                (fp #b0 #b1000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b1000000000000011 #b000)
                arg3
                (fp #b0 #b1001110011111001 #b010)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0010111000101011 #b011)
                expect
                (fp #b0 #b1000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b1000000000000011 #b000)
                expect
                (fp #b0 #b1101100100110010 #b110)))

(assert (= expect result))

(check-sat)
(exit)
