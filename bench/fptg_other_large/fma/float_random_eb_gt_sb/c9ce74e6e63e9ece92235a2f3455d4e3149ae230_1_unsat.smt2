(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b00110000000 #b0001)
                arg2
                (fp #b0 #b10000000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000000100 #b0000)
                arg2
                (fp #b0 #b10000111100 #b0101)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00000111011 #b0001)
                arg3
                (fp #b1 #b00000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100)
                arg3
                (fp #b0 #b10011010111 #b1110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
