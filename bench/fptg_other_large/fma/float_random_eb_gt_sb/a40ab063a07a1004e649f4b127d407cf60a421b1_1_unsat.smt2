(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg2
                (fp #b0 #b110000011 #b1000)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101010101 #b0101)
                arg3
                (fp #b0 #b000000000 #b0010)))
(assert (fp.leq (fp #b0 #b000000000 #b0010)
                arg3
                (fp #b0 #b111110010 #b0010)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110001110 #b1001)
                expect
                (fp #b0 #b000000000 #b0010)))
(assert (fp.leq (fp #b0 #b000000000 #b0010)
                expect
                (fp #b0 #b000010101 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
