(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110001111 #b110)
                arg1
                (fp #b1 #b11001111011 #b010)))
(assert (fp.leq (fp #b1 #b11001111011 #b010)
                arg1
                (fp #b1 #b11001011011 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110101111 #b011)
                arg2
                (fp #b1 #b11110011110 #b110)))
(assert (fp.leq (fp #b1 #b11110011110 #b110)
                arg2
                (fp #b0 #b00100001110 #b100)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00010001000 #b010)
                arg3
                (fp #b0 #b00000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000)
                arg3
                (fp #b0 #b11101110001 #b010)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10110101101 #b100)
                expect
                (fp #b0 #b11111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111)
                expect
                (fp #b0 #b11111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
