(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11011101011011 #b011000)
                arg2
                (fp #b0 #b00000000000000 #b011111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b011111)
                arg2
                (fp #b0 #b00110101001110 #b000111)))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01110101010110 #b111100)
                arg3
                (fp #b0 #b00000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000)
                arg3
                (fp #b0 #b00010010011111 #b111001)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
