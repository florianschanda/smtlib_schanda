(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101111100 #b01101000)
                arg1
                (fp #b0 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000000)
                arg1
                (fp #b0 #b0100010100 #b01001000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0001011110 #b10000111)
                arg2
                (fp #b0 #b0000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000011)
                arg2
                (fp #b0 #b1111001010 #b11111111)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110101011 #b11000010)
                arg3
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                arg3
                (fp #b0 #b1100010110 #b11100010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0010010001 #b01011010)
                expect
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                expect
                (fp #b0 #b1011111100 #b00110011)))

(assert (= expect result))

(check-sat)
(exit)
