(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111000010100 #b01)
                arg1
                (fp #b0 #b100000000010 #b00)))
(assert (fp.leq (fp #b0 #b100000000010 #b00)
                arg1
                (fp #b0 #b100111101010 #b00)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000010110101 #b10)
                arg2
                (fp #b0 #b111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111101 #b00)
                arg2
                (fp #b0 #b111111111111 #b00)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111011110010 #b01)
                arg3
                (fp #b1 #b011000000000 #b11)))
(assert (fp.leq (fp #b1 #b011000000000 #b11)
                arg3
                (fp #b1 #b000000000001 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101001010100 #b10)
                expect
                (fp #b0 #b111111111110 #b11)))
(assert (fp.leq (fp #b0 #b111111111110 #b11)
                expect
                (fp #b0 #b111111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
