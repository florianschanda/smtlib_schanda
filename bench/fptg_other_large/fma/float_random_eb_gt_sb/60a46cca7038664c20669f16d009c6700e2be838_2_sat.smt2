(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111001100010 #b101110010)
                arg1
                (fp #b1 #b100000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b100000001001 #b000000000)
                arg1
                (fp #b0 #b101010000000 #b110100110)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111000010001 #b100010001)
                arg2
                (fp #b1 #b100111110101 #b011101010)))
(assert (fp.leq (fp #b1 #b100111110101 #b011101010)
                arg2
                (fp #b1 #b011100111010 #b000111100)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b100011100110 #b111111001)
                arg3
                (fp #b0 #b111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111111)
                arg3
                (fp #b0 #b111111111111 #b000000000)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
