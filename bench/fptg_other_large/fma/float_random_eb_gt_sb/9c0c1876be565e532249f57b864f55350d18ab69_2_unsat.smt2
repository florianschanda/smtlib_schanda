; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
