;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0101000111011110 #b0001)
                arg1
                (fp #b1 #b0101000000000100 #b1100)))
(assert (fp.leq (fp #b1 #b0101000000000100 #b1100)
                arg1
                (fp #b0 #b1101100100010011 #b0001)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1011010101000010 #b1100)
                arg2
                (fp #b1 #b0101011001110111 #b0000)))
(assert (fp.leq (fp #b1 #b0101011001110111 #b0000)
                arg2
                (fp #b1 #b0001000000100000 #b1110)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b0 #b1011110011000000 #b0000)
                arg3
                (fp #b0 #b1111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111)
                arg3
                (fp #b0 #b1111111111111111 #b0000)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
