(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b001000100101 #b1110010010)
                arg1
                (fp #b0 #b101001010101 #b0000011000)))
(assert (fp.leq (fp #b0 #b101001010101 #b0000011000)
                arg1
                (fp #b0 #b101010101001 #b0110100000)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b010101001000 #b0111011000)
                arg2
                (fp #b0 #b100000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b100000001010 #b0000000000)
                arg2
                (fp #b0 #b110001000000 #b1111010010)))

(declare-const arg3 (_ FloatingPoint 12 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
