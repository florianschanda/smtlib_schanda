;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011100011010 #b11011)
                arg1
                (fp #b0 #b100011110110 #b00011)))
(assert (fp.leq (fp #b0 #b100011110110 #b00011)
                arg1
                (fp #b0 #b111000001111 #b01011)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111111111 #b00000)
                arg2
                (fp #b1 #b111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111)
                arg2
                (fp #b1 #b100110000010 #b00011)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111111110 #b01001)
                arg3
                (fp #b1 #b111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000)
                arg3
                (fp #b1 #b010000111101 #b00111)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
