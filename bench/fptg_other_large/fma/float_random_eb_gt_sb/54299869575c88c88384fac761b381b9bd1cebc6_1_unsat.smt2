; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b101111100011010 #b111001111)
                arg2
                (fp #b1 #b100010101110110 #b001101101)))
(assert (fp.leq (fp #b1 #b100010101110110 #b001101101)
                arg2
                (fp #b1 #b010110011111101 #b100001011)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b010111110100001 #b101000111)
                arg3
                (fp #b1 #b000000000000000 #b010001001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010001001)
                arg3
                (fp #b0 #b010001100100010 #b001101111)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
