(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11011100100111 #b1000)
                arg1
                (fp #b1 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b0000)
                arg1
                (fp #b0 #b00101110100110 #b0001)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01101101000101 #b0111)
                arg2
                (fp #b0 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100)
                arg2
                (fp #b0 #b00000011110000 #b1111)))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00010100011110 #b0110)
                arg3
                (fp #b0 #b11000011111001 #b0110)))
(assert (fp.leq (fp #b0 #b11000011111001 #b0110)
                arg3
                (fp #b0 #b11110100011000 #b1111)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11110111010000 #b1001)
                expect
                (fp #b0 #b11000011111001 #b0110)))
(assert (fp.leq (fp #b0 #b11000011111001 #b0110)
                expect
                (fp #b0 #b11011101001010 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
