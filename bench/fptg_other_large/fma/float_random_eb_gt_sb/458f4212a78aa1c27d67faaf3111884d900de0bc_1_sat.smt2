; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11101111100100 #b000000000)
                arg1
                (fp #b1 #b11100101100110 #b101001010)))
(assert (fp.leq (fp #b1 #b11100101100110 #b101001010)
                arg1
                (fp #b1 #b11011010111110 #b111111010)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00100111100100 #b001100001)
                arg2
                (fp #b1 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000000)
                arg2
                (fp #b0 #b00101011100101 #b000010010)))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
