(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110110011 #b0110)
                arg1
                (fp #b1 #b0000000000 #b0011)))
(assert (fp.leq (fp #b1 #b0000000000 #b0011)
                arg1
                (fp #b0 #b1011010110 #b0011)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110010011 #b1001)
                arg2
                (fp #b1 #b1100000001 #b0011)))
(assert (fp.leq (fp #b1 #b1100000001 #b0011)
                arg2
                (fp #b1 #b1010011000 #b1001)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111100110 #b0011)
                expect
                (fp #b1 #b1100000001 #b0010)))
(assert (fp.leq (fp #b1 #b1100000001 #b0010)
                expect
                (fp #b1 #b0001000100 #b0001)))

(assert (not (= expect result)))

(check-sat)
(exit)
