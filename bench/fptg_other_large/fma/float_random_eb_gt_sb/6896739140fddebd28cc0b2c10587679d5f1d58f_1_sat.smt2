; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +ZERO
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010011000 #b1000110)
                arg1
                (fp #b1 #b000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b000000000 #b1111010)
                arg1
                (fp #b0 #b000010101 #b1111111)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b000001111 #b0000010)
                arg2
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                arg2
                (fp #b0 #b010001111 #b1000110)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101100011 #b0110100)
                arg3
                (fp #b1 #b101001111 #b1001111)))
(assert (fp.leq (fp #b1 #b101001111 #b1001111)
                arg3
                (fp #b0 #b100111101 #b0110001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110011100 #b1000100)
                expect
                (fp #b1 #b101001111 #b1001111)))
(assert (fp.leq (fp #b1 #b101001111 #b1001111)
                expect
                (fp #b1 #b010011010 #b0011010)))

(assert (= expect result))

(check-sat)
(exit)
