; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0101000111 #b10101010)
                arg1
                (fp #b0 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000)
                arg1
                (fp #b0 #b1111111101 #b00010111)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111001001 #b10101111)
                arg2
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                arg2
                (fp #b0 #b1110101000 #b00001100)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111001111 #b00111110)
                arg3
                (fp #b1 #b0101111110 #b10100111)))
(assert (fp.leq (fp #b1 #b0101111110 #b10100111)
                arg3
                (fp #b1 #b0000000110 #b00001110)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0100101100 #b00000011)
                expect
                (fp #b0 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111111)
                expect
                (fp #b0 #b1111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
