; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INT_BOUNDARY
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b100001000001100001 #b1101)
                arg1
                (fp #b0 #b000000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000)
                arg1
                (fp #b0 #b111010011101001100 #b1101)))

(declare-const arg2 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b100100110100000010 #b1111)
                arg2
                (fp #b1 #b100000000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000000000100 #b0000)
                arg2
                (fp #b0 #b101110001001000011 #b0110)))

(declare-const arg3 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0000)
                arg3
                (fp #b1 #b111111111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1111)
                arg3
                (fp #b1 #b101001101001110001 #b0110)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0000)
                expect
                (fp #b1 #b111111111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1111)
                expect
                (fp #b0 #b110101011011110000 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
