(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100101001 #b00)
                arg1
                (fp #b1 #b100010001 #b11)))
(assert (fp.leq (fp #b1 #b100010001 #b11)
                arg1
                (fp #b0 #b001110111 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101001011 #b10)
                arg2
                (fp #b0 #b000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000 #b10)
                arg2
                (fp #b0 #b011111101 #b10)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011101001 #b01)
                arg3
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                arg3
                (fp #b0 #b110001001 #b11)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001110000 #b01)
                expect
                (fp #b1 #b000010010 #b10)))
(assert (fp.leq (fp #b1 #b000010010 #b10)
                expect
                (fp #b0 #b010111101 #b01)))

(assert (= expect result))

(check-sat)
(exit)
