                (fp #b0 #b000000000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00)
                arg3
                (fp #b0 #b001100001111011 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

