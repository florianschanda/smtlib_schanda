(assert (fp.leq (fp #b1 #b1111111111111110 #b1111111)
                arg2
                (fp #b0 #b1110000010100011 #b1000111)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1101111100000011 #b1000101)
                arg3
                (fp #b1 #b0011001110110111 #b1111000)))
(assert (fp.leq (fp #b1 #b0011001110110111 #b1111000)
                arg3
                (fp #b0 #b0100101101101111 #b0101100)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0111100011001010 #b1101010)
                expect
                (fp #b1 #b0011001110110111 #b1111000)))
(assert (fp.leq (fp #b1 #b0011001110110111 #b1111000)
                expect
                (fp #b0 #b1011011011000100 #b1000001)))

(assert (= expect result))

(check-sat)
(exit)
