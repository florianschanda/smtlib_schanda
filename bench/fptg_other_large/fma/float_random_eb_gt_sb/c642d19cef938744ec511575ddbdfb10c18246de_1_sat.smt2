                (fp #b0 #b01100111110 #b010110001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00111110110 #b011010011)
                arg2
                (fp #b0 #b10000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b10000001001 #b000000000)
                arg2
                (fp #b0 #b11101110010 #b110001001)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00100100110 #b100111010)
                arg3
                (fp #b1 #b00000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b010000000)
                arg3
                (fp #b0 #b10011110101 #b010110111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111011110 #b011010101)
                expect
                (fp #b1 #b00110000001 #b000000101)))
(assert (fp.leq (fp #b1 #b00110000001 #b000000101)
                expect
                (fp #b0 #b11110001100 #b100010110)))

(assert (= expect result))

(check-sat)
(exit)
