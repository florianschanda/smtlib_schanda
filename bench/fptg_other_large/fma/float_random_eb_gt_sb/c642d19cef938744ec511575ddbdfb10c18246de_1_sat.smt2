;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11000010010 #b101111101)
                arg1
                (fp #b1 #b00101110111 #b000000101)))
(assert (fp.leq (fp #b1 #b00101110111 #b000000101)
