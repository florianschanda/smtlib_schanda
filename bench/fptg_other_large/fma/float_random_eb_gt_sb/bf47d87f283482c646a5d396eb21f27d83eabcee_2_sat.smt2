(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00100100011 #b1110011)
                arg1
                (fp #b0 #b00000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000)
                arg1
                (fp #b0 #b11010101100 #b1110110)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11000101100 #b1101001)
                arg2
                (fp #b1 #b10010101000 #b1011000)))
(assert (fp.leq (fp #b1 #b10010101000 #b1011000)
                arg2
                (fp #b0 #b00110010100 #b1000111)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00101011011 #b0101010)
                expect
                (fp #b0 #b10010101000 #b1011000)))
(assert (fp.leq (fp #b0 #b10010101000 #b1011000)
                expect
                (fp #b0 #b10100010111 #b1001001)))

(assert (= expect result))

(check-sat)
(exit)
