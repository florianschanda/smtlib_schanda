(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +ZERO
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10100100011 #b0111)
                arg1
                (fp #b1 #b00000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100)
                arg1
                (fp #b0 #b11101000101 #b0100)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01010111100 #b1100)
                arg2
                (fp #b0 #b00000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000)
                arg2
                (fp #b0 #b10011101010 #b0011)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
