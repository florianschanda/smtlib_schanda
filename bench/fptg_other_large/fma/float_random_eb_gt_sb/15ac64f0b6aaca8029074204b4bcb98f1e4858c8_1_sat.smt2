                (fp #b1 #b100000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000111 #b0000000)
                arg2
                (fp #b0 #b010010010 #b0010011)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101000011 #b0110111)
                arg3
                (fp #b1 #b000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000 #b0111011)
                arg3
                (fp #b0 #b010110111 #b1011101)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111111 #b0000000)
                expect
                (fp #b1 #b111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111110 #b1111111)
                expect
                (fp #b0 #b001010011 #b1101111)))

(assert (= expect result))

(check-sat)
(exit)
