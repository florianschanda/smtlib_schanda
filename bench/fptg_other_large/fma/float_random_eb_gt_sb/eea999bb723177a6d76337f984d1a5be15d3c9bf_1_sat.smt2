(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001110100 #b01101)
                arg1
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                arg1
                (fp #b0 #b111100000 #b10111)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110111001 #b01000)
                arg2
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg2
                (fp #b0 #b111011011 #b00100)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101100100 #b00011)
                arg3
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                arg3
                (fp #b0 #b101111011 #b01100)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011000001 #b01101)
                expect
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                expect
                (fp #b0 #b101000010 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
