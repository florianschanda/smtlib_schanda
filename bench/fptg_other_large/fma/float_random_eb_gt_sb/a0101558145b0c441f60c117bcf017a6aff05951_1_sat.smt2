(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011011011 #b010)
                arg1
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                arg1
                (fp #b0 #b010100000 #b100)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b001110101 #b110)
                arg2
                (fp #b0 #b111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111110 #b111)
                arg2
                (fp #b0 #b111111111 #b000)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000110000 #b010)
                arg3
                (fp #b0 #b010000101 #b111)))
(assert (fp.leq (fp #b0 #b010000101 #b111)
                arg3
                (fp #b0 #b111101101 #b110)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100111001 #b001)
                expect
                (fp #b0 #b010000101 #b111)))
(assert (fp.leq (fp #b0 #b010000101 #b111)
                expect
                (fp #b0 #b100100111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
