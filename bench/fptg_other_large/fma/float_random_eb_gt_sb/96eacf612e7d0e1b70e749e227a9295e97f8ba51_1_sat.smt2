(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -ZERO
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0011001011100110 #b11110)
                arg2
                (fp #b1 #b0000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000)
                arg2
                (fp #b0 #b0110000010101110 #b01011)))

(declare-const arg3 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111011100010110 #b01100)
                arg3
                (fp #b1 #b1001101000110010 #b00000)))
(assert (fp.leq (fp #b1 #b1001101000110010 #b00000)
                arg3
                (fp #b0 #b0101110100001110 #b10100)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
