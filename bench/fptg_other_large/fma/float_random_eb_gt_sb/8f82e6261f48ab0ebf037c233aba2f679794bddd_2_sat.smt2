(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0110011110100 #b001000)
                arg1
                (fp #b0 #b0000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010000)
                arg1
                (fp #b0 #b1001010111100 #b010001)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0110010011011 #b100001)
                arg2
                (fp #b0 #b0000000000000 #b011111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b011111)
                arg2
                (fp #b0 #b1101001011001 #b000110)))

(declare-const arg3 (_ FloatingPoint 13 7))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1100111010010 #b110000)
                expect
                (fp #b0 #b0000000000000 #b100000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b100000)
                expect
                (fp #b0 #b0110001111001 #b110101)))

(assert (= expect result))

(check-sat)
(exit)
