(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001110101110000 #b0101101)
                arg1
                (fp #b0 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000)
                arg1
                (fp #b0 #b110010100101001 #b0000001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b001001101011100 #b0011000)
                arg2
                (fp #b1 #b000000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1101110)
                arg2
                (fp #b0 #b101010100100011 #b1011111)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b110100000111101 #b1000010)
                expect
                (fp #b1 #b000000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1101110)
                expect
                (fp #b0 #b110011010100011 #b1110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
