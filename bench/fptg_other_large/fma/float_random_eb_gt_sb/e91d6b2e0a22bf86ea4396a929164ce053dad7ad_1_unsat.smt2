(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INFINITY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0100101111 #b1000100)
                arg1
                (fp #b1 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000)
                arg1
                (fp #b0 #b0001101010 #b0110001)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100101111 #b1110000)
                arg3
                (fp #b0 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0100000)
                arg3
                (fp #b0 #b1100100011 #b0111100)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
