(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1010111100111001 #b0111101010)
                arg2
                (fp #b1 #b1000001010010001 #b1111110010)))
(assert (fp.leq (fp #b1 #b1000001010010001 #b1111110010)
                arg2
                (fp #b1 #b0101101010000110 #b1110100101)))

(declare-const arg3 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1011111111001010 #b0101001001)
                arg3
                (fp #b1 #b1010100011001110 #b0011011010)))
(assert (fp.leq (fp #b1 #b1010100011001110 #b0011011010)
                arg3
                (fp #b0 #b0011100111000001 #b1100001101)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
