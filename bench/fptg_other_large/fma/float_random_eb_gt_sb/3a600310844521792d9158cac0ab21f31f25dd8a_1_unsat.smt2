; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01111000001 #b111100101)
                arg1
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                arg1
                (fp #b0 #b10000111010 #b111110001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10011110111 #b100110111)
                arg3
                (fp #b1 #b01010000000 #b001100110)))
(assert (fp.leq (fp #b1 #b01010000000 #b001100110)
                arg3
                (fp #b0 #b11100011110 #b110001010)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
