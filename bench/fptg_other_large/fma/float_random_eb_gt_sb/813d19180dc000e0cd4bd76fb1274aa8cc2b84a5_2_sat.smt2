(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                arg2
                (fp #b0 #b1111111101 #b00001)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0110010011 #b00011)
                arg3
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg3
                (fp #b0 #b1110110111 #b11011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
