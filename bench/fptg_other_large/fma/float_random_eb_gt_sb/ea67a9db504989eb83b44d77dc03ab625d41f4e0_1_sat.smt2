(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1110111001 #b00111111)
                arg1
                (fp #b0 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000)
                arg1
                (fp #b0 #b1111111110 #b00000101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0101001000 #b11011101)
                arg2
                (fp #b0 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000000)
                arg2
                (fp #b0 #b0111100101 #b01111111)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
