(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0111000111 #b1100)
                arg1
                (fp #b0 #b1100100111 #b1000)))
(assert (fp.leq (fp #b0 #b1100100111 #b1000)
                arg1
                (fp #b0 #b1110001011 #b1010)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001000101 #b0000)
                arg2
                (fp #b1 #b1000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000100 #b0000)
                arg2
                (fp #b0 #b0010010101 #b0010)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001101001 #b1011)
                arg3
                (fp #b1 #b0000000000 #b1011)))
(assert (fp.leq (fp #b1 #b0000000000 #b1011)
                arg3
                (fp #b0 #b0001110101 #b1001)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101110010 #b1110)
                expect
                (fp #b1 #b1100101100 #b1000)))
(assert (fp.leq (fp #b1 #b1100101100 #b1000)
                expect
                (fp #b1 #b1001001110 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
