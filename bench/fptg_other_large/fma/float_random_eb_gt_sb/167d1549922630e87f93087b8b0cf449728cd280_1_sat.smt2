(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 15))
(assert (fp.leq (fp #b0 #b000100110001001010 #b11110100011100)
                arg1
                (fp #b0 #b001000101000010010 #b10000100101100)))
(assert (fp.leq (fp #b0 #b001000101000010010 #b10000100101100)
                arg1
                (fp #b0 #b111101111110101001 #b01110110001010)))

(declare-const arg2 (_ FloatingPoint 18 15))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 18 15))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 18 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
