(declare-const arg2 (_ FloatingPoint 18 15))
(assert (fp.leq (fp #b1 #b010001001111011010 #b11101001010011)
                arg2
                (fp #b1 #b000000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b011001010111110001 #b00110111110001)))

(declare-const arg3 (_ FloatingPoint 18 15))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 18 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
