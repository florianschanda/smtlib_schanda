;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110110101 #b1001)
                arg1
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                arg1
                (fp #b1 #b001110111 #b0001)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111110 #b1100)
                arg2
                (fp #b1 #b111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000)
                arg2
                (fp #b0 #b000110011 #b0001)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000111010 #b1100)
                arg3
                (fp #b1 #b000000000 #b1011)))
(assert (fp.leq (fp #b1 #b000000000 #b1011)
                arg3
                (fp #b0 #b100111000 #b0010)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111110 #b1000)
                expect
                (fp #b0 #b111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111110 #b1111)
                expect
                (fp #b0 #b111111111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
