(assert (fp.leq (fp #b1 #b0001010000110101 #b101100)
                expect
                (fp #b0 #b1101001111001000 #b111010)))
(assert (fp.leq (fp #b0 #b1101001111001000 #b111010)
                expect
                (fp #b0 #b1101101011100010 #b100101)))

(assert (= expect result))

(check-sat)
