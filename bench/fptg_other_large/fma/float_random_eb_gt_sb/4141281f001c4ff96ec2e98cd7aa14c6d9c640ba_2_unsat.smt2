(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11011010001 #b01110)
                arg1
                (fp #b1 #b00000000000 #b00111)))
(assert (fp.leq (fp #b1 #b00000000000 #b00111)
                arg1
                (fp #b0 #b01000011011 #b11001)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10010101110 #b01110)
                arg2
                (fp #b0 #b11111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111)
                arg2
                (fp #b0 #b11111111111 #b00000)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10101001110 #b01101)
                arg3
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                arg3
                (fp #b0 #b01101110100 #b10101)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11011011101 #b10111)
                expect
                (fp #b1 #b01111111110 #b11000)))
(assert (fp.leq (fp #b1 #b01111111110 #b11000)
                expect
                (fp #b0 #b10100011000 #b10001)))

(assert (not (= expect result)))

(check-sat)
(exit)
