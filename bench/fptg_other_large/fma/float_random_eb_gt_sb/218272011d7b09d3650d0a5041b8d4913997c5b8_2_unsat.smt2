(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110001101 #b001)
                arg1
                (fp #b1 #b00000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000 #b010)
                arg1
                (fp #b0 #b11110110101 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10101011000 #b011)
                arg3
                (fp #b0 #b00000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000)
                arg3
                (fp #b0 #b10100010001 #b010)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00011010001 #b000)
                expect
                (fp #b1 #b00000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000 #b001)
                expect
                (fp #b0 #b00010011011 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
