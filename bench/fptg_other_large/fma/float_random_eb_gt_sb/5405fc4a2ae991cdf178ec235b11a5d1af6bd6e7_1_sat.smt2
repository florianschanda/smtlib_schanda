                (fp #b1 #b111111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0000)
                arg2
                (fp #b0 #b010010111100001 #b0010)))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100101101011010 #b0000)
                arg3
                (fp #b0 #b100111011011001 #b1010)))
(assert (fp.leq (fp #b0 #b100111011011001 #b1010)
                arg3
                (fp #b0 #b110011111111011 #b1111)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110101101111000 #b0101)
                expect
                (fp #b1 #b101011111011101 #b1100)))
(assert (fp.leq (fp #b1 #b101011111011101 #b1100)
                expect
                (fp #b1 #b100111010100110 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
