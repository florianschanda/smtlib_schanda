; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001011011000001111 #b01)
                arg1
                (fp #b1 #b000000000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00)
                arg1
                (fp #b0 #b010101000001110000 #b11)))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b111110111001100001 #b11)
                arg3
                (fp #b1 #b000000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b01)
                arg3
                (fp #b0 #b010100111100110000 #b00)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
