; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01001101101 #b010101111)
                arg1
                (fp #b1 #b00000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b010000000)
                arg1
                (fp #b0 #b01010010010 #b001001001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11001000100 #b011011100)
                arg3
                (fp #b1 #b10111111010 #b110010000)))
(assert (fp.leq (fp #b1 #b10111111010 #b110010000)
                arg3
                (fp #b0 #b10010110100 #b001101100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
