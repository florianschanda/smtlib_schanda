; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01110001100 #b11110)
                arg1
                (fp #b0 #b01110001001 #b10111)))
(assert (fp.leq (fp #b0 #b01110001001 #b10111)
                arg1
                (fp #b0 #b11001000000 #b10010)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11011111111 #b11001)
                arg2
                (fp #b0 #b00000000000 #b10101)))
(assert (fp.leq (fp #b0 #b00000000000 #b10101)
                arg2
                (fp #b0 #b00111111100 #b01011)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11000101001 #b10011)
                arg3
                (fp #b0 #b00000000000 #b10111)))
(assert (fp.leq (fp #b0 #b00000000000 #b10111)
                arg3
                (fp #b0 #b10011100100 #b10110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11011101101 #b10111)
                expect
                (fp #b0 #b00000000000 #b11000)))
(assert (fp.leq (fp #b0 #b00000000000 #b11000)
                expect
                (fp #b0 #b01000111010 #b01111)))

(assert (= expect result))

(check-sat)
(exit)
