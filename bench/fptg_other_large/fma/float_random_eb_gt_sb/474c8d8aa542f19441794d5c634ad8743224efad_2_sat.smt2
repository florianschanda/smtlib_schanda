(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1000000110111110 #b100011)
                arg1
                (fp #b0 #b0001001110110010 #b000000)))
(assert (fp.leq (fp #b0 #b0001001110110010 #b000000)
                arg1
                (fp #b0 #b1111110001011011 #b101010)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1101010111010101 #b010011)
                arg3
                (fp #b0 #b0000010101011000 #b100110)))
(assert (fp.leq (fp #b0 #b0000010101011000 #b100110)
                arg3
                (fp #b0 #b0011011100110001 #b000011)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1100111111000110 #b111010)
                expect
                (fp #b0 #b0000010101011000 #b100110)))
(assert (fp.leq (fp #b0 #b0000010101011000 #b100110)
                expect
                (fp #b0 #b0110001110110111 #b000011)))

(assert (= expect result))

(check-sat)
(exit)
