(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011101011 #b01111)
                arg1
                (fp #b1 #b1001101111 #b11110)))
(assert (fp.leq (fp #b1 #b1001101111 #b11110)
                arg1
                (fp #b1 #b0000101011 #b11010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0010110110 #b11101)
                arg2
                (fp #b1 #b0000000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000)
                arg2
                (fp #b0 #b1000110010 #b00010)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0010000100 #b00101)
                arg3
                (fp #b1 #b0000000000 #b10000)))
(assert (fp.leq (fp #b1 #b0000000000 #b10000)
                arg3
                (fp #b0 #b1000110001 #b10101)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111001010 #b00001)
                expect
                (fp #b0 #b0001101111 #b11110)))
(assert (fp.leq (fp #b0 #b0001101111 #b11110)
                expect
                (fp #b0 #b1000110101 #b00111)))

(assert (= expect result))

(check-sat)
(exit)
