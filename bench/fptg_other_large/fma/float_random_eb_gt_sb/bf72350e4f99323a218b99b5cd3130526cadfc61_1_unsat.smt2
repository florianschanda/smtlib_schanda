                arg3
                (fp #b0 #b11000000010110111 #b01)))
(assert (fp.leq (fp #b0 #b11000000010110111 #b01)
                arg3
                (fp #b0 #b11101001011011001 #b11)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10001110010010110 #b11)
                expect
                (fp #b0 #b11000000010110111 #b00)))
(assert (fp.leq (fp #b0 #b11000000010110111 #b00)
                expect
                (fp #b0 #b11001111101111000 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
