(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111100111100 #b1110010)
                arg1
                (fp #b1 #b101001001101 #b1001101)))
(assert (fp.leq (fp #b1 #b101001001101 #b1001101)
                arg1
                (fp #b1 #b100101011000 #b0001010)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111111 #b0000000)
                arg3
                (fp #b1 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111111)
                arg3
                (fp #b0 #b111100011111 #b1000111)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111111 #b0000000)
                expect
                (fp #b1 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111111)
                expect
                (fp #b0 #b111011001011 #b0010011)))

(assert (= expect result))

(check-sat)
(exit)
