(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001101111101110 #b01)
                arg1
                (fp #b1 #b000000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00)
                arg1
                (fp #b0 #b111011111111000 #b11)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000011101100001 #b11)
                arg2
                (fp #b0 #b111111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00)
                arg2
                (fp #b0 #b111111111111110 #b11)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111111111111101 #b01)
                arg3
                (fp #b1 #b111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00)
                arg3
                (fp #b0 #b100001110000110 #b11)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111111111111101 #b01)
                expect
                (fp #b1 #b111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00)
                expect
                (fp #b1 #b110010010000110 #b00)))

(assert (= expect result))

(check-sat)
(exit)
