(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10110010001 #b1100001)
                arg1
                (fp #b1 #b01001000111 #b0100111)))
(assert (fp.leq (fp #b1 #b01001000111 #b0100111)
                arg1
                (fp #b0 #b00110110110 #b1001010)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10110101000 #b0100100)
                arg2
                (fp #b1 #b00000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000)
                arg2
                (fp #b0 #b01100100110 #b1100111)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01111011100 #b1101110)
                arg3
                (fp #b0 #b00000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000110)
                arg3
                (fp #b0 #b00011101000 #b0100101)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01011101011 #b1010111)
                expect
                (fp #b0 #b00000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000110)
                expect
                (fp #b0 #b11110110001 #b0101111)))

(assert (= expect result))

(check-sat)
(exit)
