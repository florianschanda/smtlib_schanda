(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01111100101 #b1001)
                arg1
                (fp #b1 #b00111011111 #b1110)))
(assert (fp.leq (fp #b1 #b00111011111 #b1110)
                arg1
                (fp #b0 #b11010010101 #b0101)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01010101000 #b1100)
                arg3
                (fp #b1 #b00000000000 #b1011)))
(assert (fp.leq (fp #b1 #b00000000000 #b1011)
                arg3
                (fp #b0 #b00101100010 #b0101)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01000110000 #b1101)
                expect
                (fp #b1 #b00000000000 #b1011)))
(assert (fp.leq (fp #b1 #b00000000000 #b1011)
                expect
                (fp #b0 #b10101100001 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
