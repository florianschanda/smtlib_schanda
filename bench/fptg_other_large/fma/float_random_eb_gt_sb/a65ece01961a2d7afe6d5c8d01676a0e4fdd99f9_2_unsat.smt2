(assert (fp.leq (fp #b1 #b000000000 #b1110)
                arg2
                (fp #b0 #b001110111 #b0011)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111101000 #b1000)
                arg3
                (fp #b1 #b101111010 #b0001)))
(assert (fp.leq (fp #b1 #b101111010 #b0001)
                arg3
                (fp #b0 #b011111000 #b0001)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111010 #b0111)
                expect
                (fp #b1 #b101111010 #b0010)))
(assert (fp.leq (fp #b1 #b101111010 #b0010)
                expect
                (fp #b0 #b001111010 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
