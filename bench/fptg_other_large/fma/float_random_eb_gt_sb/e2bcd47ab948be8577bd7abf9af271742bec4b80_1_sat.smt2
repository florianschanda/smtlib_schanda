(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +ZERO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b010101010011 #b0010000001)
                arg2
                (fp #b0 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000000000)
                arg2
                (fp #b0 #b000010010001 #b1011001011)))

(declare-const arg3 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011101000000 #b1000000000)
                arg3
                (fp #b0 #b000000000000 #b1000001110)))
(assert (fp.leq (fp #b0 #b000000000000 #b1000001110)
                arg3
                (fp #b0 #b111111110011 #b0101001110)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
