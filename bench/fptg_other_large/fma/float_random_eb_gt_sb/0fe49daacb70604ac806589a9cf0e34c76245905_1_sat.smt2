(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0110010001100011 #b11)
                arg1
                (fp #b0 #b0000000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00)
                arg1
                (fp #b0 #b0110010100011101 #b11)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111010111101100 #b00)
                arg2
                (fp #b1 #b1001110000111000 #b10)))
(assert (fp.leq (fp #b1 #b1001110000111000 #b10)
                arg2
                (fp #b1 #b0001001001000001 #b00)))

(declare-const arg3 (_ FloatingPoint 16 3))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b0100110000101001 #b00)
                expect
                (fp #b0 #b1001110000111000 #b10)))
(assert (fp.leq (fp #b0 #b1001110000111000 #b10)
                expect
                (fp #b0 #b1101101010001101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
