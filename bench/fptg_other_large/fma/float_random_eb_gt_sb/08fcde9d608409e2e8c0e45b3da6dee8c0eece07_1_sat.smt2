(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111111110 #b10)
                arg1
                (fp #b1 #b111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111101 #b00)
                arg1
