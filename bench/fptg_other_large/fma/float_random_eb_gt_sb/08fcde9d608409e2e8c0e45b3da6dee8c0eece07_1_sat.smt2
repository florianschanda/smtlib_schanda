                (fp #b0 #b000000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000000 #b00)
                arg2
                (fp #b0 #b101000001001 #b01)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b110011001001 #b10)
                arg3
                (fp #b1 #b000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000 #b00)
                arg3
                (fp #b0 #b101101101000 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101101100001 #b10)
                expect
                (fp #b1 #b000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000 #b00)
                expect
                (fp #b0 #b000001001100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
