; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111101 #b00001000)
                arg1
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg1
                (fp #b1 #b1111001011 #b11101110)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1011111111 #b10101101)
                arg2
                (fp #b1 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b1000001000 #b00000000)
                arg2
                (fp #b0 #b1010111111 #b00011000)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
