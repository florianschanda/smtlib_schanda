(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111001 #b0011111)
                arg1
                (fp #b1 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100000)
                arg1
                (fp #b0 #b0011001010 #b1110011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110001110 #b1101010)
                arg2
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                arg2
                (fp #b0 #b0001111010 #b0011101)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b1101010011 #b1111011)
                arg3
                (fp #b0 #b1111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000000)
                arg3
                (fp #b0 #b1111111110 #b1101000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0110111101 #b0101000)
                expect
                (fp #b0 #b1111111101 #b0000001)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000001)
                expect
                (fp #b0 #b1111111101 #b0010001)))

(assert (= expect result))

(check-sat)
(exit)
