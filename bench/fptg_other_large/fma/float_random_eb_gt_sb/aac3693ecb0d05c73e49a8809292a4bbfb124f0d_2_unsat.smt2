                arg2
                (fp #b0 #b10110100110100 #b101011010101)))

(declare-const arg3 (_ FloatingPoint 14 13))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b01011001000100 #b110111010000)
                expect
                (fp #b0 #b10001111101110 #b110110000000)))
(assert (fp.leq (fp #b0 #b10001111101110 #b110110000000)
                expect
                (fp #b0 #b11111011110110 #b111001001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
