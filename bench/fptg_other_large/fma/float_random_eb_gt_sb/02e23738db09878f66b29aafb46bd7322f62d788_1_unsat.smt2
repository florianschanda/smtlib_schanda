; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11111111110 #b1)
                arg1
                (fp #b1 #b11111111110 #b0)))
(assert (fp.leq (fp #b1 #b11111111110 #b0)
                arg1
                (fp #b0 #b01010011001 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10001011111 #b0)
                arg2
                (fp #b1 #b10000000001 #b0)))
(assert (fp.leq (fp #b1 #b10000000001 #b0)
                arg2
                (fp #b1 #b00100000010 #b0)))

(declare-const arg3 (_ FloatingPoint 11 2))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
