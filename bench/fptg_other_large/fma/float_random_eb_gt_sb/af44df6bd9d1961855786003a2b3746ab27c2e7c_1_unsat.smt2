(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001100010010 #b11011111)
                arg2
                (fp #b0 #b000000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000011)
                arg2
                (fp #b0 #b000111000010 #b01101000)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
