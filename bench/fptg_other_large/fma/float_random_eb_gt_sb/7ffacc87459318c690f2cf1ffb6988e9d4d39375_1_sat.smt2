; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111101110100011 #b11101)
                arg1
                (fp #b1 #b1111101001001001 #b00011)))
(assert (fp.leq (fp #b1 #b1111101001001001 #b00011)
                arg1
                (fp #b0 #b0111110001010010 #b01001)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1100111110101010 #b10101)
                arg3
                (fp #b1 #b1000000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000000101 #b00000)
                arg3
                (fp #b1 #b0101110011101111 #b10010)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
