(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0000011001110101 #b1)
                arg1
                (fp #b0 #b1110000010000110 #b0)))
(assert (fp.leq (fp #b0 #b1110000010000110 #b0)
                arg1
                (fp #b0 #b1110001000000011 #b1)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0101001110001010 #b0)
                arg2
                (fp #b0 #b1000000000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000000000001 #b0)
                arg2
                (fp #b0 #b1000111011110101 #b1)))

(declare-const arg3 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b1001000010100110 #b0)
                arg3
                (fp #b0 #b1111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b0)
                arg3
                (fp #b0 #b1111111111111110 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b1011010000110000 #b1)
                expect
                (fp #b0 #b1111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b0)
                expect
                (fp #b0 #b1111111111111111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
