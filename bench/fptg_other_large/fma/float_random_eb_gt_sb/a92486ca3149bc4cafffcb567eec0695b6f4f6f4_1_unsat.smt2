                (fp #b0 #b1111111111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11)
                arg3
                (fp #b0 #b1111111111111111 #b00)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b0101101001010101 #b10)
                expect
