(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b10001100111001110 #b111010010)
                arg2
                (fp #b0 #b00000000000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b010000000)
                arg2
                (fp #b0 #b10010001100001011 #b000101010)))

(declare-const arg3 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b0 #b01110100011100101 #b010011000)
                arg3
                (fp #b0 #b10000000000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b10000000000001001 #b000000000)
                arg3
                (fp #b0 #b10110010000011001 #b001110000)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
