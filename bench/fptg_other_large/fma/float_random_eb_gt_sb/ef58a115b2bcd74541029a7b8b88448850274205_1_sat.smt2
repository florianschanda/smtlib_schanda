(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00000111001 #b1011010)
                arg1
                (fp #b0 #b00000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b00000000000 #b1100101)
                arg1
                (fp #b0 #b10101001111 #b0110001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11100110001 #b1001110)
                arg2
                (fp #b1 #b00110011111 #b1100110)))
(assert (fp.leq (fp #b1 #b00110011111 #b1100110)
                arg2
                (fp #b0 #b01011011001 #b0011111)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01111111000 #b0000001)
                expect
                (fp #b1 #b00110011111 #b1100110)))
(assert (fp.leq (fp #b1 #b00110011111 #b1100110)
                expect
                (fp #b1 #b00101101110 #b1011111)))

(assert (= expect result))

(check-sat)
(exit)
