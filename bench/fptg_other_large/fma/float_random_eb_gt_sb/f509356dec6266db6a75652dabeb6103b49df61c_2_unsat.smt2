                arg2
                (fp #b1 #b001110100011 #b10)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101000000111 #b10)
                arg3
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg3
                (fp #b0 #b101100010110 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111000010010 #b01)
                expect
                (fp #b0 #b100000000101 #b01)))
(assert (fp.leq (fp #b0 #b100000000101 #b01)
                expect
                (fp #b0 #b110111101111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
