;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1001111101010 #b101)
                arg1
                (fp #b1 #b1000000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000000011 #b000)
                arg1
                (fp #b1 #b0010101110100 #b100)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b1111001011011 #b010)
                arg2
                (fp #b0 #b1111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000)
                arg2
                (fp #b0 #b1111111111101 #b100)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1011101110101 #b010)
                arg3
                (fp #b0 #b1111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000)
                arg3
                (fp #b0 #b1111111111101 #b101)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
