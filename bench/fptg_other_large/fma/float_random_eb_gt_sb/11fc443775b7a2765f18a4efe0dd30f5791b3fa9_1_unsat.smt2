(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -ZERO
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b0 #b100101001100 #b0001001)
                arg1
                (fp #b0 #b111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b0000000)
                arg1
                (fp #b0 #b111111111101 #b0101101)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b101100111011 #b1110011)
                arg2
                (fp #b1 #b000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000)
                arg2
                (fp #b0 #b110000000010 #b1010010)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
