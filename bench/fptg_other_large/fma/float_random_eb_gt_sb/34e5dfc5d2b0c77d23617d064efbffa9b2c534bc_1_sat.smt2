(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INFINITY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10111111001000 #b011)
                arg1
                (fp #b0 #b00000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010)
                arg1
                (fp #b0 #b00010011000001 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10011011100011 #b111)
                arg3
                (fp #b1 #b10000000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000000011 #b000)
                arg3
                (fp #b0 #b10000011011100 #b111)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
