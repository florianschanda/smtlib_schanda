(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b001010110101110 #b01)
                arg2
                (fp #b0 #b100000000000010 #b00)))
(assert (fp.leq (fp #b0 #b100000000000010 #b00)
                arg2
                (fp #b0 #b110111011000111 #b11)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000010110000011 #b10)
                arg3
                (fp #b0 #b000100000110111 #b00)))
(assert (fp.leq (fp #b0 #b000100000110111 #b00)
                arg3
                (fp #b0 #b011010010101101 #b11)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
