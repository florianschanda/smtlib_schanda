; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -INFINITY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111000110100010 #b11010011010)
                arg1
                (fp #b1 #b0000000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11011000100)
                arg1
                (fp #b0 #b0111101000111011 #b10010000010)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1100110011100101 #b10100001001)
                arg3
                (fp #b0 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000)
                arg3
                (fp #b0 #b1100011010011111 #b01111111000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
