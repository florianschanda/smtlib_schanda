(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0001110000 #b00111011)
                arg1
                (fp #b0 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000000)
                arg1
                (fp #b0 #b1010010101 #b01101101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0101011100 #b01000110)
                arg2
                (fp #b0 #b0111110111 #b00101101)))
(assert (fp.leq (fp #b0 #b0111110111 #b00101101)
                arg2
                (fp #b0 #b1011101001 #b01100010)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0011111111 #b10110000)
                arg3
                (fp #b0 #b0000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01110011)
                arg3
                (fp #b0 #b1010001010 #b11101001)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1011001100 #b01001000)
                expect
                (fp #b0 #b0000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01110011)
                expect
                (fp #b0 #b0111111011 #b00101011)))

(assert (= expect result))

(check-sat)
(exit)
