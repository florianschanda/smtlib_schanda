; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111011111 #b1011001)
                arg1
                (fp #b1 #b00000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111010)
                arg1
                (fp #b0 #b11111000111 #b1101111)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01001101101 #b1010110)
                arg2
                (fp #b1 #b00000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000)
                arg2
                (fp #b0 #b00101101001 #b0001111)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10010100100 #b1111100)
                arg3
                (fp #b1 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000)
                arg3
                (fp #b0 #b01101011110 #b0101001)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11010100110 #b1110101)
                expect
                (fp #b1 #b10000000110 #b1111111)))
(assert (fp.leq (fp #b1 #b10000000110 #b1111111)
                expect
                (fp #b1 #b01010101101 #b0010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
