(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INFINITY
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111100000 #b1111)
                arg1
                (fp #b1 #b1011100011 #b0010)))
(assert (fp.leq (fp #b1 #b1011100011 #b0010)
                arg1
                (fp #b0 #b1100000010 #b0011)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111111 #b0000)
                arg3
                (fp #b1 #b1111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111)
                arg3
                (fp #b1 #b0000000010 #b1101)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
