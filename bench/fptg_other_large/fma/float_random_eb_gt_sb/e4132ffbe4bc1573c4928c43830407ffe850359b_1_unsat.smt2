; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0100010101100111 #b0100100000000)
                arg1
                (fp #b1 #b0000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000000000)
                arg1
                (fp #b0 #b1101111001110110 #b1110001101000)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1101100000111011 #b1011110001010)
                arg2
                (fp #b1 #b1000000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001101 #b0000000000000)
                arg2
                (fp #b0 #b0100110110100000 #b1001000101000)))

(declare-const arg3 (_ FloatingPoint 16 14))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
