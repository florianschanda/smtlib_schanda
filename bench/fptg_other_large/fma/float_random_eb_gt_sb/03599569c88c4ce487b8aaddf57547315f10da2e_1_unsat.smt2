(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111100001 #b00)
                arg1
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                arg1
                (fp #b0 #b001101111 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010010110 #b00)
                arg2
                (fp #b0 #b001011000 #b00)))
(assert (fp.leq (fp #b0 #b001011000 #b00)
                arg2
                (fp #b0 #b001100100 #b11)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101000010 #b11)
                arg3
                (fp #b1 #b100000010 #b00)))
(assert (fp.leq (fp #b1 #b100000010 #b00)
                arg3
                (fp #b1 #b000111000 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110000000 #b00)
                expect
                (fp #b1 #b100000001 #b11)))
(assert (fp.leq (fp #b1 #b100000001 #b11)
                expect
                (fp #b1 #b010011011 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
