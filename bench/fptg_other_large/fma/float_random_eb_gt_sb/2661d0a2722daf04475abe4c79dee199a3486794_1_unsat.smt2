                (fp #b0 #b11111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111111)
                arg2
                (fp #b0 #b11111111111 #b00000000)))

(declare-const arg3 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11111111101 #b01010000)
                arg3
                (fp #b1 #b11111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000000)
                arg3
                (fp #b0 #b11000010001 #b00000110)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11111111101 #b00111111)
                expect
                (fp #b1 #b11111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000000)
                expect
                (fp #b1 #b10011010110 #b11010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
