(assert (fp.leq (fp #b0 #b111111111111101 #b000)
                arg2
                (fp #b0 #b111111111111110 #b100)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110111101111100 #b101)
                arg3
                (fp #b0 #b100000000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000000011 #b000)
                arg3
                (fp #b0 #b111110010111101 #b001)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
