(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010010110110 #b11111)
                arg2
                (fp #b1 #b000000011001 #b00000)))
(assert (fp.leq (fp #b1 #b000000011001 #b00000)
                arg2
                (fp #b0 #b101010001010 #b00100)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b001001100000 #b10100)
                arg3
                (fp #b0 #b111100101010 #b00100)))
(assert (fp.leq (fp #b0 #b111100101010 #b00100)
                arg3
                (fp #b0 #b111101011001 #b01001)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
