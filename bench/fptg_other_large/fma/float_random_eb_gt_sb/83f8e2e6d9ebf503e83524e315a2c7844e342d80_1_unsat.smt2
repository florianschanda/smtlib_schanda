; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111101110 #b10000)
                arg1
                (fp #b1 #b10100101010 #b10111)))
(assert (fp.leq (fp #b1 #b10100101010 #b10111)
                arg1
                (fp #b0 #b10100101001 #b11000)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10101110100 #b10101)
                arg2
                (fp #b0 #b11111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111101 #b00000)
                arg2
                (fp #b0 #b11111111101 #b01111)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10001101011 #b10010)
                arg3
                (fp #b1 #b00000000000 #b10000)))
(assert (fp.leq (fp #b1 #b00000000000 #b10000)
                arg3
                (fp #b0 #b11001011001 #b00011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111111 #b00000)
                expect
                (fp #b1 #b11111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111110 #b11111)
                expect
                (fp #b0 #b11100111000 #b10111)))

(assert (not (= expect result)))

(check-sat)
(exit)
