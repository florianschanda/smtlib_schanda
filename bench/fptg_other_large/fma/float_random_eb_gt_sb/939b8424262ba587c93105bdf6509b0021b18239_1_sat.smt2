(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00011100100000 #b000)
                arg1
                (fp #b0 #b00000000000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b110)
                arg1
                (fp #b0 #b01100000001010 #b010)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111110 #b111)
                arg2
                (fp #b1 #b11111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000)
                arg2
                (fp #b1 #b11010001001111 #b001)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111110 #b101)
                arg3
                (fp #b1 #b11111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000)
                arg3
                (fp #b1 #b11011110000100 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111110 #b111)
                expect
                (fp #b1 #b11111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000)
                expect
                (fp #b0 #b11000010011000 #b110)))

(assert (= expect result))

(check-sat)
(exit)
