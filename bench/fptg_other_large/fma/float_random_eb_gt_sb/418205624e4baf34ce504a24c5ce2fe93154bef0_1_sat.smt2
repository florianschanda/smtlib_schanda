; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -NAN
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01000011001011110 #b00110011)
                arg1
                (fp #b0 #b00000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00000000)
                arg1
                (fp #b0 #b10010010111001010 #b10100000)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 17 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
