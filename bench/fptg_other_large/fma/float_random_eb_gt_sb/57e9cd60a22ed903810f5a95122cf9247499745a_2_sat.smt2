                arg2
                (fp #b0 #b11111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111101 #b00000)
                arg2
                (fp #b0 #b11111111110 #b00001)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01111011010 #b11100)
                arg3
                (fp #b0 #b00000000000 #b10111)))
(assert (fp.leq (fp #b0 #b00000000000 #b10111)
                arg3
                (fp #b0 #b01101111001 #b10011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111100011 #b00111)
                expect
                (fp #b1 #b11111100010 #b10001)))
(assert (fp.leq (fp #b1 #b11111100010 #b10001)
                expect
                (fp #b0 #b00101010111 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
