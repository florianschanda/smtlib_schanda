; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b010010101010010 #b0100100001010)
                arg2
                (fp #b1 #b000000000000000 #b0100000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0100000000000)
                arg2
                (fp #b0 #b101111100101111 #b0101011101100)))

(declare-const arg3 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b110110100101100 #b0101101100100)
                arg3
                (fp #b1 #b000000000000000 #b0001101100001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0001101100001)
                arg3
                (fp #b0 #b110101000101101 #b1110010001001)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
