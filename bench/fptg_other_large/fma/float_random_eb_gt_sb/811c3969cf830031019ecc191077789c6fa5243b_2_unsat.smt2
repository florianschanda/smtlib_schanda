                (fp #b0 #b100000000000001 #b0)))
(assert (fp.leq (fp #b0 #b100000000000001 #b0)
                arg2
                (fp #b0 #b101100011011001 #b1)))

(declare-const arg3 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110011110100000 #b0)
                arg3
                (fp #b0 #b011001000100010 #b0)))
(assert (fp.leq (fp #b0 #b011001000100010 #b0)
                arg3
                (fp #b0 #b011010110101010 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 2))
