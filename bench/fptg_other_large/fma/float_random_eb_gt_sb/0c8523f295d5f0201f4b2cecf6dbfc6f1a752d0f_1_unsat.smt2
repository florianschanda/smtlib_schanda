(assert (fp.leq (fp #b0 #b0010100001 #b001110)
                arg2
                (fp #b0 #b0011110100 #b010011)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111101 #b110000)
                arg3
                (fp #b1 #b1111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000)
                arg3
                (fp #b0 #b1100110001 #b010111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111101 #b101011)
                expect
                (fp #b1 #b1111111100 #b111111)))
(assert (fp.leq (fp #b1 #b1111111100 #b111111)
                expect
                (fp #b0 #b0011100100 #b001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
