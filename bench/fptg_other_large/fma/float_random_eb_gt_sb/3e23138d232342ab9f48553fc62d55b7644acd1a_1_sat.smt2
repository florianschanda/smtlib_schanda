(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110101001 #b1111111)
                arg1
                (fp #b1 #b100000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000111 #b0000000)
                arg1
                (fp #b0 #b110111111 #b1000000)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011000111 #b0100000)
                arg2
                (fp #b0 #b101111000 #b0001011)))
(assert (fp.leq (fp #b0 #b101111000 #b0001011)
                arg2
                (fp #b0 #b111110011 #b1110000)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b110100000 #b0001010)
                arg3
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                arg3
                (fp #b0 #b011101000 #b0001111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110100110 #b1100010)
                expect
                (fp #b1 #b110000000 #b0001011)))
(assert (fp.leq (fp #b1 #b110000000 #b0001011)
                expect
                (fp #b0 #b001011011 #b0101011)))

(assert (= expect result))

(check-sat)
(exit)
