;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010011100 #b11101)
                arg1
                (fp #b0 #b0000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000)
                arg1
                (fp #b0 #b1001010111 #b00011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100001111 #b01001)
                arg2
                (fp #b1 #b1000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000101 #b00000)
                arg2
                (fp #b0 #b0110011110 #b10111)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111010100 #b10100)
                arg3
                (fp #b0 #b1100011111 #b10101)))
(assert (fp.leq (fp #b0 #b1100011111 #b10101)
                arg3
                (fp #b0 #b1111011011 #b00010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0000110011 #b10010)
                expect
                (fp #b0 #b1100011111 #b10101)))
(assert (fp.leq (fp #b0 #b1100011111 #b10101)
                expect
                (fp #b0 #b1111111100 #b11000)))

(assert (not (= expect result)))

(check-sat)
(exit)
