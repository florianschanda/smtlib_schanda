                arg2
                (fp #b0 #b00000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000)
                arg2
                (fp #b0 #b10101001111 #b10100)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00010100111 #b01110)
                arg3
                (fp #b0 #b00000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000)
                arg3
                (fp #b0 #b11101000011 #b01101)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00101101000 #b10011)
                expect
                (fp #b0 #b00000000101 #b00000)))
(assert (fp.leq (fp #b0 #b00000000101 #b00000)
                expect
                (fp #b0 #b00100110111 #b01111)))

(assert (= expect result))

(check-sat)
(exit)
