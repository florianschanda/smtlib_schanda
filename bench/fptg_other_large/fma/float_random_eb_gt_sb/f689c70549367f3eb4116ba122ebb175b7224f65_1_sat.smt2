(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01101101110 #b11111)
                arg1
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                arg1
