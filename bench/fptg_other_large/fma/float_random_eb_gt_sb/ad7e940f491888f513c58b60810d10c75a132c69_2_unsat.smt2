;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b0 #b1000001111110 #b11100100001)
                arg1
                (fp #b0 #b1101110001001 #b01100111000)))
(assert (fp.leq (fp #b0 #b1101110001001 #b01100111000)
                arg1
                (fp #b0 #b1111001010011 #b11010000001)))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1011010111000 #b00101010010)
                arg3
                (fp #b1 #b0110000111000 #b00111100111)))
(assert (fp.leq (fp #b1 #b0110000111000 #b00111100111)
                arg3
                (fp #b0 #b1101001111011 #b11000001100)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
