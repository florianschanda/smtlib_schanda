                (fp #b1 #b0000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000000)
                arg3
                (fp #b0 #b0011001111101 #b001001110)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

