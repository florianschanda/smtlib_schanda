; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b11100101001101 #b01010101)
                arg2
                (fp #b0 #b11111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000000)
                arg2
                (fp #b0 #b11111111111101 #b01011010)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11011011101100 #b01110001)
                arg3
                (fp #b0 #b00000000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01110011)
                arg3
                (fp #b0 #b00111010110100 #b01001100)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
