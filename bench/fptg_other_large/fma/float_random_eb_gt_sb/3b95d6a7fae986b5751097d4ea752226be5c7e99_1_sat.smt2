                (fp #b0 #b000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000 #b010000)
                arg2
                (fp #b0 #b010111111 #b101110)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b110111000 #b011110)
                arg3
                (fp #b0 #b111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111101 #b000000)
                arg3
                (fp #b0 #b111111101 #b000010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010110101 #b111001)
                expect
                (fp #b0 #b111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111101 #b000000)
                expect
                (fp #b0 #b111111110 #b010000)))

(assert (= expect result))

(check-sat)
(exit)
