(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1010001011 #b00111)
                arg1
                (fp #b1 #b0010110001 #b10000)))
(assert (fp.leq (fp #b1 #b0010110001 #b10000)
                arg1
                (fp #b0 #b1110001010 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111110001 #b01001)
                arg2
                (fp #b0 #b0010011000 #b00111)))
(assert (fp.leq (fp #b0 #b0010011000 #b00111)
                arg2
                (fp #b0 #b0101110110 #b01000)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1001110001 #b10000)
                arg3
                (fp #b1 #b0000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000)
                arg3
                (fp #b0 #b0011110101 #b01000)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0000101011 #b11100)
                expect
                (fp #b1 #b0000000000 #b00001)))
(assert (fp.leq (fp #b1 #b0000000000 #b00001)
                expect
                (fp #b0 #b1101000011 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
