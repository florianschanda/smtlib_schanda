(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1111111111111110 #b000010101010)
                arg1
                (fp #b1 #b1111111111111101 #b000000000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000000000)
                arg1
                (fp #b1 #b1000001000101100 #b101100111111)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1111011000110011 #b001111010001)
                arg2
                (fp #b0 #b1010110100000000 #b101011000000)))
(assert (fp.leq (fp #b0 #b1010110100000000 #b101011000000)
                arg2
                (fp #b0 #b1100011010100000 #b110110011101)))

(declare-const arg3 (_ FloatingPoint 16 13))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
