(assert (fp.leq (fp #b0 #b000000000000000000 #b01000)
                arg2
                (fp #b0 #b001000001011011011 #b11010)))

(declare-const arg3 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111111111111111110 #b10011)
                arg3
                (fp #b1 #b111111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00000)
                arg3
                (fp #b1 #b100100001000101010 #b10001)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111111111111111101 #b01101)
                expect
                (fp #b1 #b111111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00000)
                expect
                (fp #b1 #b001000010111000010 #b11010)))

(assert (= expect result))

(check-sat)
(exit)
