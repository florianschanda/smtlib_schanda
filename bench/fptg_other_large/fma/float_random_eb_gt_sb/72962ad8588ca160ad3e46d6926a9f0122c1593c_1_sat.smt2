(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1001001010 #b010010)
                arg1
                (fp #b1 #b0000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000)
                arg1
                (fp #b0 #b1001101101 #b100001)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0100010000 #b000110)
                arg2
                (fp #b0 #b1000111101 #b110000)))
(assert (fp.leq (fp #b0 #b1000111101 #b110000)
                arg2
                (fp #b0 #b1100110000 #b010100)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
