                arg3
                (fp #b0 #b00000000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1)
                arg3
                (fp #b0 #b10001011001110 #b0)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11001010111010 #b1)
                expect
                (fp #b0 #b11111111111110 #b1)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1)
                expect
                (fp #b0 #b11111111111111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
