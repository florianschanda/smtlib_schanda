(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101000110 #b01011)
                arg1
                (fp #b0 #b0000000000 #b11001)))
(assert (fp.leq (fp #b0 #b0000000000 #b11001)
                arg1
                (fp #b0 #b1001101110 #b00100)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0000100001 #b10001)
                expect
                (fp #b0 #b0000000000 #b11001)))
(assert (fp.leq (fp #b0 #b0000000000 #b11001)
                expect
                (fp #b0 #b1011101100 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
