; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0111100011111010 #b111111)
                arg1
                (fp #b0 #b0000000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010000)
                arg1
                (fp #b0 #b0000101101011010 #b101011)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1110101011110010 #b101000)
                arg2
                (fp #b0 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000)
                arg2
                (fp #b0 #b1000001111110011 #b010000)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
