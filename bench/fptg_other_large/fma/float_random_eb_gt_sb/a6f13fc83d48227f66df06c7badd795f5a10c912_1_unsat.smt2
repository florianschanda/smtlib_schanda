(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100111111 #b0000110)
                arg1
                (fp #b1 #b001111001 #b1100110)))
(assert (fp.leq (fp #b1 #b001111001 #b1100110)
                arg1
                (fp #b0 #b111110001 #b1110110)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101000101 #b1010101)
                arg2
                (fp #b1 #b000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b000000000 #b1101110)
                arg2
                (fp #b0 #b100001101 #b1110100)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
