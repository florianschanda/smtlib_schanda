(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +ZERO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10010110001 #b00100)
                arg1
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                arg1
                (fp #b0 #b10011111100 #b10111)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10010100100 #b10010)
                arg2
                (fp #b0 #b00000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000)
                arg2
                (fp #b0 #b00011010101 #b00100)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111110 #b00011)
                arg3
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                arg3
                (fp #b1 #b11011010110 #b00101)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111101 #b01000)
                expect
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                expect
                (fp #b1 #b11100011100 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
