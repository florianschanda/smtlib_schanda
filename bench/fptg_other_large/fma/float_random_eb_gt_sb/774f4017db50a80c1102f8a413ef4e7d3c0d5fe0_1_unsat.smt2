(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111110100101 #b110100001)
                arg2
                (fp #b1 #b000000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b010000100)
                arg2
                (fp #b0 #b010111100110 #b110010100)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100100110000 #b101101111)
                arg3
                (fp #b1 #b000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b010000000)
                arg3
                (fp #b0 #b000001110111 #b111010010)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
