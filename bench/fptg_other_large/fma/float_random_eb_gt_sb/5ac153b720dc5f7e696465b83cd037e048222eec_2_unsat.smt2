                (fp #b1 #b111111110 #b1111)))
(assert (fp.leq (fp #b1 #b111111110 #b1111)
                arg1
                (fp #b1 #b100011111 #b1010)))

(declare-const arg2 (_ FloatingPoint 9 5))
