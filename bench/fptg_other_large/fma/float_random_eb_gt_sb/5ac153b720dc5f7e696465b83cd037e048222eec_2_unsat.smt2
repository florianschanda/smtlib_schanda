                arg2
                (fp #b1 #b110101111 #b1011)))
(assert (fp.leq (fp #b1 #b110101111 #b1011)
                arg2
                (fp #b1 #b000100000 #b0100)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101001010 #b0010)
                arg3
                (fp #b0 #b000000000 #b0010)))
(assert (fp.leq (fp #b0 #b000000000 #b0010)
                arg3
                (fp #b0 #b011000001 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
