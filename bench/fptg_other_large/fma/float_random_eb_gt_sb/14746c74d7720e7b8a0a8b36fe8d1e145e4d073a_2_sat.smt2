(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0100001110 #b11010000)
                arg1
                (fp #b0 #b0000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b0000000000 #b01010111)
                arg1
                (fp #b0 #b1011110000 #b00110000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101101000 #b10111101)
                arg3
                (fp #b0 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111111)
                arg3
                (fp #b0 #b1111111111 #b00000000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1111110010 #b00100010)
                expect
                (fp #b0 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111111)
                expect
                (fp #b0 #b1111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
