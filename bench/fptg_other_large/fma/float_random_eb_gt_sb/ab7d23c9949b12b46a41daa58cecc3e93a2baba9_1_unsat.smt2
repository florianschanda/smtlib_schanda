; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01100101110111 #b10000)
                arg2
                (fp #b0 #b00000111000101 #b11000)))
(assert (fp.leq (fp #b0 #b00000111000101 #b11000)
                arg2
                (fp #b0 #b01111011101111 #b01111)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10010110010011 #b10010)
                arg3
                (fp #b0 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000)
                arg3
                (fp #b0 #b10110011000101 #b11000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
