(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111001001100100 #b1)
                arg1
                (fp #b1 #b1110101110011101 #b0)))
(assert (fp.leq (fp #b1 #b1110101110011101 #b0)
                arg1
                (fp #b1 #b0110011101011011 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0011101111111011 #b0)
                arg2
                (fp #b0 #b1011010110010010 #b1)))
(assert (fp.leq (fp #b0 #b1011010110010010 #b1)
                arg2
                (fp #b0 #b1101011111110111 #b0)))

(declare-const arg3 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111111111111 #b0)
                arg3
                (fp #b1 #b1111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b1)
                arg3
                (fp #b1 #b0011111100110010 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111111111111 #b0)
                expect
                (fp #b1 #b1111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b1)
                expect
                (fp #b1 #b0011111010100100 #b0)))

(assert (= expect result))

(check-sat)
(exit)
