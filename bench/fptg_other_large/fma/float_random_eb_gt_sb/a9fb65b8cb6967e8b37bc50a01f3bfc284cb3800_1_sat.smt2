(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +ZERO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b111010000 #b0011101)
                arg1
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                arg1
                (fp #b0 #b111001110 #b1101100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b010011011 #b0100000)
                arg2
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                arg2
                (fp #b0 #b000111100 #b1011101)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000100000 #b0011110)
                arg3
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg3
                (fp #b0 #b110111111 #b1000010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b001111110 #b0001011)
                expect
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                expect
                (fp #b0 #b111001100 #b1111110)))

(assert (= expect result))

(check-sat)
(exit)
