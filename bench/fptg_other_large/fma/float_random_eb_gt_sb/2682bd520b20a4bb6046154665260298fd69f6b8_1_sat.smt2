(assert (fp.leq (fp #b1 #b100000000000111 #b0000000)
                arg2
                (fp #b1 #b010110001011100 #b0100111)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b001000011010011 #b0110100)
                arg3
                (fp #b0 #b000000000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1000110)
                arg3
                (fp #b0 #b001111010100000 #b1110000)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b001111011011010 #b1101000)
                expect
                (fp #b0 #b111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111)
                expect
                (fp #b0 #b111111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
