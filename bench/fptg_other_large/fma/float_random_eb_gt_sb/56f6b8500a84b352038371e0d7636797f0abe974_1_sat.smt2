(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001111110 #b1101)
                arg1
                (fp #b1 #b0110110000 #b1000)))
(assert (fp.leq (fp #b1 #b0110110000 #b1000)
                arg1
                (fp #b0 #b0101100100 #b1101)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b1011100100 #b0000)
                arg2
                (fp #b0 #b1111111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000)
                arg2
                (fp #b0 #b1111111101 #b0110)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0010011100 #b1000)
                arg3
                (fp #b0 #b1111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111)
                arg3
                (fp #b0 #b1111111111 #b0000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010011101 #b1101)
                expect
                (fp #b0 #b1111111110 #b1110)))
(assert (fp.leq (fp #b0 #b1111111110 #b1110)
                expect
                (fp #b0 #b1111111111 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
