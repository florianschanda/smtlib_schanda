(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111111111 #b00)
                arg1
                (fp #b1 #b11111111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11)
                arg1
                (fp #b0 #b11100100010000 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111111110 #b01)
                arg2
                (fp #b1 #b11111111111101 #b00)))
(assert (fp.leq (fp #b1 #b11111111111101 #b00)
                arg2
                (fp #b1 #b10011011101010 #b11)))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111111110 #b01)
                arg3
                (fp #b1 #b11111111111101 #b00)))
(assert (fp.leq (fp #b1 #b11111111111101 #b00)
                arg3
                (fp #b1 #b01110100100000 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b10000111011011 #b01)
                expect
                (fp #b0 #b11111111111110 #b11)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11)
                expect
                (fp #b0 #b11111111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
