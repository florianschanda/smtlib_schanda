                arg2
                (fp #b0 #b110110011000 #b1101011)))
(assert (fp.leq (fp #b0 #b110110011000 #b1101011)
                arg2
                (fp #b0 #b111011010110 #b1001010)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100000010111 #b0000100)
                arg3
                (fp #b1 #b000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000000 #b0111011)
                arg3
                (fp #b0 #b010001100100 #b0101011)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
