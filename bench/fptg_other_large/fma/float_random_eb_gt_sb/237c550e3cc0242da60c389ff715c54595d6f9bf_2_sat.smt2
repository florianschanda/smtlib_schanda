(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b101110110100 #b1101101)
                arg1
                (fp #b0 #b101100000101 #b0010011)))
(assert (fp.leq (fp #b0 #b101100000101 #b0010011)
                arg1
                (fp #b0 #b111001100010 #b0110000)))

(declare-const arg2 (_ FloatingPoint 12 8))
