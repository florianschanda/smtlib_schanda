(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10010100101 #b010100110)
                arg1
                (fp #b1 #b00101110111 #b000000101)))
(assert (fp.leq (fp #b1 #b00101110111 #b000000101)
                arg1
                (fp #b0 #b11001101011 #b011110010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00100000011 #b100001111)
                arg2
                (fp #b1 #b00001000010 #b010101101)))
(assert (fp.leq (fp #b1 #b00001000010 #b010101101)
                arg2
                (fp #b0 #b01111100100 #b010111100)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10110100001 #b001111000)
                arg3
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                arg3
                (fp #b0 #b11101001111 #b111000111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00110101101 #b110111110)
                expect
                (fp #b0 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000000)
                expect
                (fp #b0 #b11101101011 #b001101111)))

(assert (= expect result))

(check-sat)
(exit)
