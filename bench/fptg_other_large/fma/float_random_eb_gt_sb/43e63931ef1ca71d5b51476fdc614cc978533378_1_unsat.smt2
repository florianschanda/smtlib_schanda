(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -ZERO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10010010100 #b1100111)
                arg2
                (fp #b1 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000)
                arg2
                (fp #b0 #b11011010001 #b0110000)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11101010100 #b1011101)
                arg3
                (fp #b0 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000)
                arg3
                (fp #b0 #b00010111010 #b0000110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
