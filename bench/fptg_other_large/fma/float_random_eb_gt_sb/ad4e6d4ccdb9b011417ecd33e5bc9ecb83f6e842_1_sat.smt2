; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b000000100 #b0011000)
                arg1
                (fp #b0 #b001110110 #b1000000)))
(assert (fp.leq (fp #b0 #b001110110 #b1000000)
                arg1
                (fp #b0 #b111111101 #b1000011)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110110 #b1110001)
                arg2
                (fp #b1 #b010101110 #b0111000)))
(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b0 #b000100000 #b1101010)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011010110 #b1100001)
                arg3
                (fp #b0 #b101000000 #b0000001)))
(assert (fp.leq (fp #b0 #b101000000 #b0000001)
                arg3
                (fp #b0 #b111101100 #b1000010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b010101011 #b0011001)
                expect
                (fp #b0 #b101000000 #b0000000)))
(assert (fp.leq (fp #b0 #b101000000 #b0000000)
                expect
                (fp #b0 #b111001001 #b0001100)))

(assert (= expect result))

(check-sat)
(exit)
