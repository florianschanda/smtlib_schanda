(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0001010011 #b0011101)
                arg1
                (fp #b0 #b0001010110 #b1010011)))
(assert (fp.leq (fp #b0 #b0001010110 #b1010011)
                arg1
                (fp #b0 #b0111111100 #b0010010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0111000001 #b1010001)
                arg2
                (fp #b1 #b0000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101110)
                arg2
                (fp #b0 #b0110000011 #b0000000)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111110101 #b0001011)
                arg3
                (fp #b0 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0100000)
                arg3
                (fp #b0 #b0001011100 #b1000010)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101011001 #b1010111)
                expect
                (fp #b0 #b0000000000 #b0011111)))
(assert (fp.leq (fp #b0 #b0000000000 #b0011111)
                expect
                (fp #b0 #b0101011110 #b1110101)))

(assert (= expect result))

(check-sat)
(exit)
