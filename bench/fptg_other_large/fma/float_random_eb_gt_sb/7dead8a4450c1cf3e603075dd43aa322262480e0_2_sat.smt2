(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100000011 #b0010)
                arg1
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg1
                (fp #b0 #b111010010 #b0011)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011100010 #b1010)
                arg2
                (fp #b0 #b111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111110 #b1111)
                arg2
                (fp #b0 #b111111111 #b0000)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b100110110 #b0000)
                arg3
                (fp #b0 #b110001111 #b0101)))
(assert (fp.leq (fp #b0 #b110001111 #b0101)
                arg3
                (fp #b0 #b110111100 #b1011)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b010011100 #b0010)
                expect
                (fp #b0 #b110001111 #b0110)))
(assert (fp.leq (fp #b0 #b110001111 #b0110)
                expect
                (fp #b0 #b110111010 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
