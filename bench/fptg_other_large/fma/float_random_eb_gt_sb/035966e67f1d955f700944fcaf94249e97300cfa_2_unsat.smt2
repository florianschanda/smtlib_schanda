(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0011001100 #b1001110)
                arg1
                (fp #b0 #b1111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000000)
                arg1
                (fp #b0 #b1111111110 #b0010101)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001110010 #b1101011)
                arg2
                (fp #b0 #b0000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100000)
                arg2
                (fp #b0 #b0110100111 #b0011010)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111100011 #b1010000)
                arg3
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                arg3
                (fp #b1 #b0100010100 #b1101100)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010000010 #b0101101)
                expect
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                expect
                (fp #b0 #b0110110110 #b0101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
