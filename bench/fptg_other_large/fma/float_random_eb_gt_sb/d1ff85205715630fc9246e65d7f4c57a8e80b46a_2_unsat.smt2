(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010011011010 #b10111110)
                arg1
                (fp #b0 #b010100001000 #b01111101)))
(assert (fp.leq (fp #b0 #b010100001000 #b01111101)
                arg1
                (fp #b0 #b110111010101 #b00101000)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001010011100 #b11110010)
                arg2
                (fp #b1 #b000000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000000 #b01111101)
                arg2
                (fp #b0 #b101000110111 #b11111001)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000010101100 #b10010000)
                expect
                (fp #b1 #b000000000000 #b01111110)))
(assert (fp.leq (fp #b1 #b000000000000 #b01111110)
                expect
                (fp #b0 #b000111011011 #b10000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
