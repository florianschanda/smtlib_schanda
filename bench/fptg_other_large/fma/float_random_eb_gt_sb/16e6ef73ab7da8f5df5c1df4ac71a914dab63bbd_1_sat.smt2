(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001110001011 #b0110)
                arg2
                (fp #b0 #b111010111100 #b1011)))
(assert (fp.leq (fp #b0 #b111010111100 #b1011)
                arg2
                (fp #b0 #b111011011011 #b0100)))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111101001000 #b0011)
                arg3
                (fp #b1 #b100000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000100 #b0000)
                arg3
                (fp #b1 #b011010100000 #b1110)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
