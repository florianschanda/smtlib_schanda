(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0100100100110 #b0010011100)
                arg2
                (fp #b1 #b0000000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1000101100)
                arg2
                (fp #b0 #b0101100100001 #b0010010100)))

(declare-const arg3 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1000101100010 #b0111110001)
                arg3
                (fp #b0 #b0000000000000 #b1000001110)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1000001110)
                arg3
                (fp #b0 #b0000110000111 #b1000011111)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
