(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10000100010110 #b110011)
                arg2
                (fp #b1 #b00000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b101100)
                arg2
                (fp #b0 #b00001110010100 #b101111)))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10001101011101 #b001011)
                arg3
                (fp #b1 #b10000000000110 #b000000)))
(assert (fp.leq (fp #b1 #b10000000000110 #b000000)
                arg3
                (fp #b0 #b11000011010011 #b110000)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
