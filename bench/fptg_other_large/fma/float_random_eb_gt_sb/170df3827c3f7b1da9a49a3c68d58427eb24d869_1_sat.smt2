                arg3
                (fp #b0 #b01100011011111 #b011101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11011011111110 #b001011)
                expect
