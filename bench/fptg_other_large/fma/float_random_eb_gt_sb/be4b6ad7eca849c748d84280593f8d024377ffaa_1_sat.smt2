; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01011111100000 #b011)
                arg1
                (fp #b0 #b01010110000011 #b010)))
(assert (fp.leq (fp #b0 #b01010110000011 #b010)
                arg1
                (fp #b0 #b11110110001101 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111111 #b000)
                arg3
                (fp #b1 #b11111111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111)
                arg3
                (fp #b1 #b00000001101001 #b100)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
