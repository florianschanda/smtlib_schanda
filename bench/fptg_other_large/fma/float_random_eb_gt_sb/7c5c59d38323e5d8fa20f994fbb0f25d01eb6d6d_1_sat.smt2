; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101011101010 #b10011000)
                arg1
                (fp #b1 #b100100010011 #b11011101)))
(assert (fp.leq (fp #b1 #b100100010011 #b11011101)
                arg1
                (fp #b1 #b011011101110 #b01101111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101001111001 #b10100110)
                arg2
                (fp #b1 #b000000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000000 #b01111101)
                arg2
                (fp #b0 #b010111001100 #b01100110)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
