(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b1111101100 #b111011)
                arg1
                (fp #b0 #b1111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000)
                arg1
                (fp #b0 #b1111111110 #b001110)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100011100 #b011111)
                arg2
                (fp #b1 #b0011011111 #b011011)))
(assert (fp.leq (fp #b1 #b0011011111 #b011011)
                arg2
                (fp #b0 #b0101001010 #b111001)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b1101101101 #b011001)
                arg3
                (fp #b0 #b1111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000)
                arg3
                (fp #b0 #b1111111101 #b011000)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100001001 #b001110)
                expect
                (fp #b0 #b1111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000)
                expect
                (fp #b0 #b1111111101 #b011111)))

(assert (= expect result))

(check-sat)
(exit)
