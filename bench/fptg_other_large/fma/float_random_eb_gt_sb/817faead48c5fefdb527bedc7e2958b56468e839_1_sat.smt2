(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b00001011000000 #b01011101)
                arg1
                (fp #b0 #b11111111111110 #b11111111)))
