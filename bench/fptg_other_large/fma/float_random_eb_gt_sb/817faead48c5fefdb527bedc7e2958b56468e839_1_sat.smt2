                arg2
                (fp #b0 #b00000000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000011)
                arg2
                (fp #b0 #b00100100100110 #b11101011)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10011100100000 #b00111101)
                arg3
                (fp #b1 #b00000000000000 #b11001101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b11001101)
                arg3
                (fp #b0 #b11011110000110 #b10110100)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b00010111110010 #b10011100)
                expect
                (fp #b0 #b01111111111111 #b00001011)))
(assert (fp.leq (fp #b0 #b01111111111111 #b00001011)
                expect
                (fp #b0 #b11011110111110 #b11110010)))

(assert (= expect result))

(check-sat)
(exit)
