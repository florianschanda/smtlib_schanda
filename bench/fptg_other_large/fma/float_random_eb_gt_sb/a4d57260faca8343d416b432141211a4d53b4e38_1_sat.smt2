(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111111101 #b10)
                arg1
                (fp #b1 #b111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111101 #b00)
                arg1
                (fp #b0 #b010010100000 #b10)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100011010110 #b01)
                arg2
                (fp #b0 #b000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000 #b10)
                arg2
                (fp #b0 #b001001011001 #b00)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001010100101 #b11)
                arg3
                (fp #b0 #b000100010010 #b01)))
(assert (fp.leq (fp #b0 #b000100010010 #b01)
                arg3
                (fp #b0 #b111101101101 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111001001010 #b00)
                expect
                (fp #b1 #b011111111101 #b11)))
(assert (fp.leq (fp #b1 #b011111111101 #b11)
                expect
                (fp #b0 #b110000001111 #b11)))

(assert (= expect result))

(check-sat)
(exit)
