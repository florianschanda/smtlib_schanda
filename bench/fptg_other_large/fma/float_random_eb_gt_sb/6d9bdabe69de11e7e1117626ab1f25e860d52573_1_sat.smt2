(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b010001000100100 #b1111000)
                arg1
                (fp #b0 #b000000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1100101)
                arg1
                (fp #b0 #b011001001000110 #b0111001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b000000100100110 #b1111100)
                arg2
                (fp #b1 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000)
                arg2
                (fp #b0 #b010000010110010 #b1101011)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
