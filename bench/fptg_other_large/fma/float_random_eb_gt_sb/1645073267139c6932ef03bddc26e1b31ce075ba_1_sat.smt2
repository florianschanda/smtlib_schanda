(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b1010110001110001 #b11011000)
                arg1
                (fp #b0 #b1111111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b00000000)
                arg1
                (fp #b0 #b1111111111111110 #b00110110)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001011101001101 #b00101010)
                arg2
                (fp #b0 #b0000000000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000011)
                arg2
                (fp #b0 #b1110010000001111 #b00010001)))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0110000010011011 #b10010100)
                arg3
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                arg3
                (fp #b0 #b1111111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b1111100111111111 #b00000110)
                expect
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                expect
                (fp #b0 #b1111111111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
