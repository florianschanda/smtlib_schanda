(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0101110001101 #b110000000)
                arg2
                (fp #b1 #b0010111010110 #b101111100)))
(assert (fp.leq (fp #b1 #b0010111010110 #b101111100)
                arg2
                (fp #b0 #b0011100011011 #b100111110)))

(declare-const arg3 (_ FloatingPoint 13 10))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0011111001010 #b101001111)
                arg3
                (fp #b0 #b0000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000)
                arg3
                (fp #b0 #b1111100001101 #b001100110)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
