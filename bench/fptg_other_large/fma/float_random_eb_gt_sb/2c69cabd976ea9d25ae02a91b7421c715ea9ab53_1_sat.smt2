(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1001010110111001 #b000)
                arg3
                (fp #b1 #b0000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010)
                arg3
                (fp #b0 #b1101011011110101 #b010)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0010011010000000 #b001)
                expect
                (fp #b0 #b0111111111111110 #b110)))
(assert (fp.leq (fp #b0 #b0111111111111110 #b110)
                expect
                (fp #b0 #b1111101110101110 #b111)))

(assert (= expect result))

(check-sat)
(exit)
