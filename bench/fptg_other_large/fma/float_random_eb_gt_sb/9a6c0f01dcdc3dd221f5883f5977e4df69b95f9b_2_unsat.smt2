(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110010100 #b0011)
                arg1
                (fp #b1 #b000000000 #b0011)))
(assert (fp.leq (fp #b1 #b000000000 #b0011)
                arg1
                (fp #b0 #b010110000 #b0110)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011001101 #b0110)
                arg2
                (fp #b0 #b111011110 #b1000)))
(assert (fp.leq (fp #b0 #b111011110 #b1000)
                arg2
                (fp #b0 #b111100001 #b0111)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b011000110 #b0001)
                expect
                (fp #b0 #b111011110 #b1000)))
(assert (fp.leq (fp #b0 #b111011110 #b1000)
                expect
                (fp #b0 #b111111000 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
