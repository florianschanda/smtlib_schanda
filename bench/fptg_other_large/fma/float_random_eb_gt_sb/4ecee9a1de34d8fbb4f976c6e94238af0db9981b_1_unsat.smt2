(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111111 #b000000)
                arg1
                (fp #b1 #b111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111110 #b111111)
                arg1
                (fp #b1 #b011110111 #b001000)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110010100 #b110000)
                arg2
                (fp #b1 #b011011000 #b011101)))
(assert (fp.leq (fp #b1 #b011011000 #b011101)
                arg2
                (fp #b1 #b000110100 #b100110)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b101101110 #b101111)
                expect
                (fp #b0 #b111011000 #b011100)))
(assert (fp.leq (fp #b0 #b111011000 #b011100)
                expect
                (fp #b0 #b111110100 #b110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
