; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INFINITY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011011110 #b10010)
                arg1
                (fp #b0 #b001101101 #b00100)))
(assert (fp.leq (fp #b0 #b001101101 #b00100)
                arg1
                (fp #b0 #b011010101 #b01101)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b010100111 #b00111)
                arg3
                (fp #b0 #b000000000 #b10111)))
(assert (fp.leq (fp #b0 #b000000000 #b10111)
                arg3
                (fp #b0 #b000001111 #b10001)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
