(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11111111100110110 #b0010)
                arg2
                (fp #b1 #b11001111110101110 #b1001)))
(assert (fp.leq (fp #b1 #b11001111110101110 #b1001)
                arg2
                (fp #b0 #b00100000100111100 #b0110)))

(declare-const arg3 (_ FloatingPoint 17 5))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
