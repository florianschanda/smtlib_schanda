(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b11100001100100 #b0010)
                arg1
                (fp #b0 #b11111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111)
                arg1
                (fp #b0 #b11111111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11100011100000 #b1101)
                arg2
                (fp #b1 #b10010111010010 #b1111)))
(assert (fp.leq (fp #b1 #b10010111010010 #b1111)
                arg2
                (fp #b1 #b01001010010000 #b1001)))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000)
                expect
                (fp #b1 #b11111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111)
                expect
                (fp #b0 #b11101011100011 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
