; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111101101 #b0100)
                arg1
                (fp #b0 #b001100011 #b1110)))
(assert (fp.leq (fp #b0 #b001100011 #b1110)
                arg1
                (fp #b0 #b110110100 #b1100)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100100011 #b0011)
                arg2
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                arg2
                (fp #b1 #b001101101 #b1101)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b000111000 #b1000)
                arg3
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                arg3
                (fp #b0 #b010010110 #b0000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111011110 #b0111)
                expect
                (fp #b1 #b001101000 #b1110)))
(assert (fp.leq (fp #b1 #b001101000 #b1110)
                expect
                (fp #b1 #b000100100 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
