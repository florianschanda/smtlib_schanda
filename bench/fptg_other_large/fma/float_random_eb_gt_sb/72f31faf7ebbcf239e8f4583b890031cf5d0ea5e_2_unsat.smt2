(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00000001110110 #b110)
                arg1
                (fp #b0 #b01010110000011 #b010)))
(assert (fp.leq (fp #b0 #b01010110000011 #b010)
                arg1
                (fp #b0 #b10010000110111 #b111)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11101111111010 #b100)
                expect
                (fp #b0 #b01010110000011 #b010)))
(assert (fp.leq (fp #b0 #b01010110000011 #b010)
                expect
                (fp #b0 #b01111101001100 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
