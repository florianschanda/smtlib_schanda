(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +NAN
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 10))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b11101100001001000 #b011000010)
                arg3
                (fp #b1 #b10000000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10000000000001001 #b000000000)
                arg3
                (fp #b0 #b01010101010011101 #b100010011)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
