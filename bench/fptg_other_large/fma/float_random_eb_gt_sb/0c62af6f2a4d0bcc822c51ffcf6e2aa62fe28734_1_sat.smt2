(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010010010111101 #b000)
                arg1
                (fp #b1 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000)
                arg1
                (fp #b0 #b1110111110001100 #b111)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011000011111101 #b010)
                arg2
                (fp #b1 #b0000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010)
                arg2
                (fp #b0 #b0010001100000000 #b100)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0100101100100000 #b101)
                arg3
                (fp #b0 #b1111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000)
                arg3
                (fp #b0 #b1111111111111110 #b110)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1010111010010100 #b110)
                expect
                (fp #b0 #b1111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000)
                expect
                (fp #b0 #b1111111111111110 #b010)))

(assert (= expect result))

(check-sat)
(exit)
