; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b0 #b001011111011100 #b1110001110001)
                arg2
                (fp #b0 #b100000000001101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b100000000001101 #b0000000000000)
                arg2
                (fp #b0 #b100100111111101 #b1100001100001)))

(declare-const arg3 (_ FloatingPoint 15 14))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b011100100000001 #b0001001001001)
                arg3
                (fp #b1 #b000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000000000)
                arg3
                (fp #b0 #b011010011100110 #b1110010111111)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
