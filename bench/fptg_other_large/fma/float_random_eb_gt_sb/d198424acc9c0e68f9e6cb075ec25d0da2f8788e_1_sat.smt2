; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1010110000101010 #b11000100)
                arg1
                (fp #b0 #b0000000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000000)
                arg1
                (fp #b0 #b0101011010010001 #b11101000)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b1000000100101101 #b10111110)
                arg3
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                arg3
                (fp #b0 #b1111111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
