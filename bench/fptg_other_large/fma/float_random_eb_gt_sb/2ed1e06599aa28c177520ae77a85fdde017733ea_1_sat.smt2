;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10111101110100111 #b01001)
                arg1
                (fp #b1 #b00000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00000)
                arg1
                (fp #b0 #b11100010010000110 #b11101)))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b0 #b01000101110110110 #b10011)
