                (fp #b0 #b11111111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b11111)
                arg2
                (fp #b0 #b11111111111111111 #b00000)))

(declare-const arg3 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b10100000010000000 #b01001)
                arg3
                (fp #b0 #b00000000000000000 #b10111)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b10111)
                arg3
                (fp #b0 #b01000100000011000 #b01001)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11000111001111000 #b00011)
                expect
                (fp #b0 #b00000000000000000 #b10111)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b10111)
                expect
                (fp #b0 #b10010010010001010 #b11011)))

(assert (= expect result))

(check-sat)
(exit)
