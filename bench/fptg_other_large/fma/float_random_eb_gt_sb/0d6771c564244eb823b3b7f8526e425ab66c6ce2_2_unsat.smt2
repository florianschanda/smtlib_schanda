(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1111111000100 #b1011101010)
                arg1
                (fp #b1 #b1110111100001 #b1101001010)))
(assert (fp.leq (fp #b1 #b1110111100001 #b1101001010)
                arg1
                (fp #b0 #b0100111100101 #b1111110111)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 11))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
