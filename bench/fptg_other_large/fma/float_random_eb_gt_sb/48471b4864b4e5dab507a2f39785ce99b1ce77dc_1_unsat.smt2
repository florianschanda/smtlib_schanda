(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111011011110110 #b11)
                arg1
                (fp #b1 #b100000000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000000010 #b00)
                arg1
                (fp #b1 #b011100100011110 #b11)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101000000111111 #b11)
                arg2
                (fp #b0 #b000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01)
                arg2
                (fp #b0 #b110000100010010 #b01)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
