                arg2
                (fp #b0 #b101101110101111 #b000)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111000001100011 #b001)
                arg3
                (fp #b1 #b010010000001011 #b100)))
(assert (fp.leq (fp #b1 #b010010000001011 #b100)
                arg3
                (fp #b0 #b001011111101111 #b010)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b000001101000110 #b110)
                expect
                (fp #b0 #b100000000000000 #b010)))
(assert (fp.leq (fp #b0 #b100000000000000 #b010)
                expect
                (fp #b0 #b101000001111100 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
