; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -NAN
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111100011010101 #b1000)
                arg1
                (fp #b1 #b100100101001000 #b1001)))
(assert (fp.leq (fp #b1 #b100100101001000 #b1001)
                arg1
                (fp #b1 #b010111000011000 #b1100)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b101100101000000 #b0100)
                arg3
                (fp #b1 #b000000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0100)
                arg3
                (fp #b0 #b001110110000111 #b1001)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
