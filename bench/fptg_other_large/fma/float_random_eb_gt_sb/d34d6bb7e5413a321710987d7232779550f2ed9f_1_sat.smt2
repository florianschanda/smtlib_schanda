; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11100100110101 #b0000)
                arg1
                (fp #b1 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b0000)
                arg1
                (fp #b0 #b11100001101100 #b0101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00000100101011 #b0001)
                arg3
                (fp #b0 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100)
                arg3
                (fp #b0 #b11111001101100 #b0101)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
