(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11101111110 #b001100111)
                arg1
                (fp #b0 #b00000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b00000000000 #b111100110)
                arg1
                (fp #b0 #b11110011010 #b010011001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01101111000 #b110100110)
                arg2
                (fp #b1 #b00000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b010000000)
                arg2
                (fp #b0 #b01010011011 #b100011101)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
