(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0100010000 #b00)
                arg1
                (fp #b0 #b1100100010 #b01)))
(assert (fp.leq (fp #b0 #b1100100010 #b01)
                arg1
                (fp #b0 #b1101110110 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010100000 #b10)
                arg2
                (fp #b1 #b1000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000010 #b00)
                arg2
                (fp #b1 #b0110110101 #b10)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0111111111 #b00)
                arg3
                (fp #b0 #b1111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111110 #b11)
                arg3
                (fp #b0 #b1111111111 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011001010 #b01)
                expect
                (fp #b0 #b1111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111110 #b11)
                expect
                (fp #b0 #b1111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
