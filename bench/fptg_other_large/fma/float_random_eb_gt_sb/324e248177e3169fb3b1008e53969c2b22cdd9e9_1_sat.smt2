; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111000000011001010 #b111111000)
                arg2
                (fp #b0 #b000011101010100100 #b111010110)))
(assert (fp.leq (fp #b0 #b000011101010100100 #b111010110)
                arg2
                (fp #b0 #b011111101100111011 #b001111010)))

(declare-const arg3 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111111111111111111 #b000000000)
                arg3
                (fp #b1 #b111111111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b111111111)
                arg3
                (fp #b0 #b001000101110000101 #b100101111)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
