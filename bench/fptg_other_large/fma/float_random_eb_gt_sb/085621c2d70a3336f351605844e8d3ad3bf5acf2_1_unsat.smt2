(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0011000011110110 #b000)
                expect
                (fp #b1 #b0000000000000000 #b100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100)
                expect
                (fp #b0 #b1110101111100111 #b111)))

(assert (not (= expect result)))

