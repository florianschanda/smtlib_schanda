(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0001000000 #b11)
                arg1
                (fp #b1 #b0000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000 #b10)
                arg1
                (fp #b0 #b0101100100 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010010001 #b11)
                arg2
                (fp #b0 #b0000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000 #b10)
                arg2
                (fp #b0 #b1011101100 #b10)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1100000001 #b10)
                expect
                (fp #b1 #b0000000000 #b11)))
(assert (fp.leq (fp #b1 #b0000000000 #b11)
                expect
                (fp #b0 #b1111010001 #b11)))

(assert (= expect result))

(check-sat)
(exit)
