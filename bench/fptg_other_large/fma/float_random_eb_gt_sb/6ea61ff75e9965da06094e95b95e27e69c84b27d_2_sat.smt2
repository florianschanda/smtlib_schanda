; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000)
                arg1
                (fp #b1 #b111111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111)
                arg1
                (fp #b1 #b101000110100110 #b11000)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101100101110111 #b11000)
                arg2
                (fp #b0 #b100000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000000101 #b00000)
                arg2
                (fp #b0 #b101001110110001 #b11110)))

(declare-const arg3 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b110100110100001 #b00011)
                arg3
                (fp #b1 #b100000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b100000000000101 #b00000)
                arg3
                (fp #b0 #b001110101010011 #b01011)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
