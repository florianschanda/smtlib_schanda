(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110011100010110 #b1110)
                arg2
                (fp #b1 #b100000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000000100 #b0000)
                arg2
                (fp #b1 #b001011011110000 #b1000)))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100110110111101 #b0001)
                arg3
                (fp #b0 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000)
                arg3
                (fp #b0 #b000110111001111 #b1110)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
