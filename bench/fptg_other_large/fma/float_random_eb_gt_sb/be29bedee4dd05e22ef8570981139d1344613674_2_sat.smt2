                arg3
                (fp #b1 #b011010010 #b11101)))
(assert (fp.leq (fp #b1 #b011010010 #b11101)
                arg3
                (fp #b1 #b010010111 #b11001)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101111111 #b10100)
                expect
                (fp #b1 #b011010010 #b11101)))
(assert (fp.leq (fp #b1 #b011010010 #b11101)
                expect
                (fp #b0 #b100000011 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
