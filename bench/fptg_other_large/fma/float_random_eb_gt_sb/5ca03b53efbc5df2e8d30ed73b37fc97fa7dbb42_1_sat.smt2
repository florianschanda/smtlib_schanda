(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b000111100011 #b000)
                arg2
                (fp #b0 #b000101100000 #b000)))
(assert (fp.leq (fp #b0 #b000101100000 #b000)
                arg2
                (fp #b0 #b110000010010 #b010)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b001001110111 #b101)
                arg3
                (fp #b0 #b011010100011 #b011)))
(assert (fp.leq (fp #b0 #b011010100011 #b011)
                arg3
                (fp #b0 #b111011100111 #b110)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
