(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -NAN
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10110000110000 #b100111)
                arg3
                (fp #b0 #b00000000000000 #b010001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010001)
                arg3
                (fp #b0 #b01101000000100 #b000101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
