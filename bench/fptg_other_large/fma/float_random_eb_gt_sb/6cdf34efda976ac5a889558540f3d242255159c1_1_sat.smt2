; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b1 #b11001101100001101 #b0111011100)
                arg1
                (fp #b0 #b00000000000000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b1111111000)
                arg1
                (fp #b0 #b11011011110010010 #b1010111111)))

(declare-const arg2 (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b0 #b00110100010100101 #b1010000111)
                arg2
                (fp #b0 #b11011001111101100 #b1011001011)))
(assert (fp.leq (fp #b0 #b11011001111101100 #b1011001011)
                arg2
                (fp #b0 #b11101011100001110 #b1011111110)))

(declare-const arg3 (_ FloatingPoint 17 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 17 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b0 #b00111100101110010 #b1000000010)
                expect
                (fp #b0 #b11011001111101100 #b1011001011)))
(assert (fp.leq (fp #b0 #b11011001111101100 #b1011001011)
                expect
                (fp #b0 #b11011111111110101 #b0111110001)))

(assert (= expect result))

(check-sat)
(exit)
