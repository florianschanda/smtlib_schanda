; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100101001 #b11)
                arg1
                (fp #b0 #b000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000 #b10)
                arg1
                (fp #b0 #b100001100 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111010 #b01)
                arg2
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                arg2
                (fp #b0 #b110001000 #b10)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111110 #b11)
                arg3
                (fp #b1 #b111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111101 #b00)
                arg3
                (fp #b1 #b110100011 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111110 #b01)
                expect
                (fp #b1 #b111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111101 #b00)
                expect
                (fp #b0 #b110111111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
