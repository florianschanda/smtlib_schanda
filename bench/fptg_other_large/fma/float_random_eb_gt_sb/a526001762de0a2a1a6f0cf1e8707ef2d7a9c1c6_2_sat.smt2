(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111110 #b1101010)
                arg1
                (fp #b1 #b11111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000)
                arg1
                (fp #b0 #b10100000111001 #b0000101)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101001101101 #b0011000)
                arg2
                (fp #b1 #b00000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1101110)
                arg2
                (fp #b0 #b01010110110011 #b1100100)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01000101011010 #b0110101)
                arg3
                (fp #b0 #b00000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000)
                arg3
                (fp #b0 #b10010111100111 #b0011100)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11011100101100 #b0100010)
                expect
                (fp #b0 #b01111111111110 #b1011101)))
(assert (fp.leq (fp #b0 #b01111111111110 #b1011101)
                expect
                (fp #b0 #b10010111010011 #b0110100)))

(assert (= expect result))

(check-sat)
(exit)
