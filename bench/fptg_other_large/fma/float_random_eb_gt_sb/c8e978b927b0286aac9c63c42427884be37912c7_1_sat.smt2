(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b101000100 #b101011)
                arg1
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                arg1
                (fp #b0 #b001101010 #b110110)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010011110 #b110101)
                arg2
                (fp #b1 #b000000000 #b101100)))
(assert (fp.leq (fp #b1 #b000000000 #b101100)
                arg2
                (fp #b0 #b010000111 #b010000)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001000001 #b001111)
                arg3
                (fp #b1 #b000000000 #b010000)))
(assert (fp.leq (fp #b1 #b000000000 #b010000)
                arg3
                (fp #b0 #b100101110 #b000100)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b000011010 #b111101)
                expect
                (fp #b1 #b000000000 #b010000)))
(assert (fp.leq (fp #b1 #b000000000 #b010000)
                expect
                (fp #b0 #b010001101 #b110011)))

(assert (= expect result))

(check-sat)
(exit)
