(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -ZERO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1010001010011010 #b1111101)
                arg2
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                arg2
                (fp #b0 #b1100001010110011 #b1000011)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1101010101110100 #b1111100)
                arg3
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                arg3
                (fp #b0 #b1111101101101010 #b1011111)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
