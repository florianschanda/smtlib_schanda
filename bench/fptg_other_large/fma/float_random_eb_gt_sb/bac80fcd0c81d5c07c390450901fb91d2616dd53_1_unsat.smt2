(assert (fp.leq (fp #b1 #b10000000011011 #b001011)
                arg3
                (fp #b1 #b00010011110101 #b111100)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
