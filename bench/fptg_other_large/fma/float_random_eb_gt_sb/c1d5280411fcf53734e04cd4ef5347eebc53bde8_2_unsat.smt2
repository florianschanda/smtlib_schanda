(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001110110110111 #b10011101)
                arg1
                (fp #b1 #b0000000000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00010010)
                arg1
                (fp #b0 #b1110010000101000 #b11001010)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0011001101000110 #b00101000)
                arg3
                (fp #b1 #b0000000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000)
                arg3
                (fp #b0 #b0010001000000110 #b01101000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1011111001101100 #b00100110)
                expect
                (fp #b0 #b0000000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000001)
                expect
                (fp #b0 #b0110111110101001 #b01001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
