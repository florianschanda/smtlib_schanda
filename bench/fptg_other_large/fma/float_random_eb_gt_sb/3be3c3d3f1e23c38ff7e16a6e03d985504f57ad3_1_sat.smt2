(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111001100 #b1101101)
                arg1
                (fp #b1 #b110001111 #b1111011)))
(assert (fp.leq (fp #b1 #b110001111 #b1111011)
                arg1
                (fp #b1 #b010001011 #b0001111)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011001100 #b1011010)
                arg2
                (fp #b1 #b010101110 #b0111000)))
(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b0 #b011111101 #b1110110)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100001011 #b1000001)
                arg3
                (fp #b1 #b000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000000)
                arg3
                (fp #b0 #b001110110 #b0000110)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b011101010 #b1001100)
                expect
                (fp #b0 #b100111111 #b0110100)))
(assert (fp.leq (fp #b0 #b100111111 #b0110100)
                expect
                (fp #b0 #b101000011 #b0101000)))

(assert (= expect result))

(check-sat)
(exit)
