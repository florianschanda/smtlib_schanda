;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0110100000 #b11101)
                arg1
                (fp #b1 #b0010110001 #b10000)))
(assert (fp.leq (fp #b1 #b0010110001 #b10000)
                arg1
                (fp #b1 #b0001000010 #b00000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100100100 #b10000)
                arg3
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg3
                (fp #b0 #b1001011110 #b10110)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0001111011 #b11110)
                expect
                (fp #b0 #b1000000100 #b11111)))
(assert (fp.leq (fp #b0 #b1000000100 #b11111)
                expect
                (fp #b0 #b1100010111 #b01110)))

(assert (not (= expect result)))

(check-sat)
(exit)
