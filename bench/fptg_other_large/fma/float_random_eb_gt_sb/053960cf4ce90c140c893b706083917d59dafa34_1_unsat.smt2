(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01010110011 #b1010)
                arg1
                (fp #b0 #b00000000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100)
                arg1
                (fp #b0 #b00011110011 #b1110)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00011001010 #b1111)
                arg2
                (fp #b0 #b10000000011 #b0011)))
(assert (fp.leq (fp #b0 #b10000000011 #b0011)
                arg2
                (fp #b0 #b11010011100 #b1101)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10010000110 #b0100)
                expect
                (fp #b1 #b10000000011 #b0010)))
(assert (fp.leq (fp #b1 #b10000000011 #b0010)
                expect
                (fp #b0 #b11011011100 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
