; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01110001101000 #b11)
                arg1
                (fp #b1 #b01001111111111 #b11)))
(assert (fp.leq (fp #b1 #b01001111111111 #b11)
                arg1
                (fp #b0 #b00111110011001 #b00)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111110000 #b10)
                arg3
                (fp #b1 #b11111111000100 #b00)))
(assert (fp.leq (fp #b1 #b11111111000100 #b00)
                arg3
                (fp #b1 #b00111100100110 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111001001 #b10)
                expect
                (fp #b1 #b11111111000100 #b00)))
(assert (fp.leq (fp #b1 #b11111111000100 #b00)
                expect
                (fp #b0 #b11011110011110 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
