; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111111111111111 #b0000000)
                arg2
                (fp #b1 #b111111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b1111111)
                arg2
                (fp #b0 #b001000110011000 #b1101101)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b100001100011001 #b0011010)
                arg3
                (fp #b0 #b000100011000111 #b1100110)))
(assert (fp.leq (fp #b0 #b000100011000111 #b1100110)
                arg3
                (fp #b0 #b111110011110001 #b1110100)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
