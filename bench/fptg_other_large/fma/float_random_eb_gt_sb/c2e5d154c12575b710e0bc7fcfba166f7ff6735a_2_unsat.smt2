                arg2
                (fp #b0 #b111111111110 #b1)))
(assert (fp.leq (fp #b0 #b111111111110 #b1)
                arg2
                (fp #b0 #b111111111111 #b0)))

(declare-const arg3 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b001011011011 #b1)
                arg3
                (fp #b1 #b000000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000000 #b1)
                arg3
                (fp #b0 #b100111010100 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
