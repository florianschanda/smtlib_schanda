(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +ZERO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101111000 #b1011111)
                arg1
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                arg1
                (fp #b0 #b0111011000 #b1000010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1101001100 #b1010100)
                arg2
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                arg2
                (fp #b0 #b1101111101 #b1110010)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001111000 #b0111010)
                arg3
                (fp #b1 #b0000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b0000000000 #b0111011)
                arg3
                (fp #b0 #b1110001111 #b0110110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101000011 #b1110111)
                expect
                (fp #b1 #b0000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b0000000000 #b0111011)
                expect
                (fp #b0 #b0101110011 #b1001011)))

(assert (= expect result))

(check-sat)
(exit)
