(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1010011001 #b0)
                arg1
                (fp #b1 #b0111000100 #b1)))
(assert (fp.leq (fp #b1 #b0111000100 #b1)
                arg1
                (fp #b0 #b1010100010 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1011011001 #b1)
                arg2
                (fp #b1 #b1010100101 #b1)))
(assert (fp.leq (fp #b1 #b1010100101 #b1)
                arg2
                (fp #b0 #b1000001100 #b1)))

(declare-const arg3 (_ FloatingPoint 10 2))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1111000101 #b0)
                expect
                (fp #b0 #b1010100110 #b0)))
(assert (fp.leq (fp #b0 #b1010100110 #b0)
                expect
                (fp #b0 #b1100100100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
