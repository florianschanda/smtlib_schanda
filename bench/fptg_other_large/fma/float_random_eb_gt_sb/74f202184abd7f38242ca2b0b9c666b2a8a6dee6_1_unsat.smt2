(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001000100001 #b001110001)
                arg1
                (fp #b0 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000000)
                arg1
                (fp #b0 #b000001011000 #b001111010)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111111111110 #b111100101)
                arg2
                (fp #b1 #b111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000000000)
                arg2
                (fp #b1 #b011111100101 #b010110011)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
