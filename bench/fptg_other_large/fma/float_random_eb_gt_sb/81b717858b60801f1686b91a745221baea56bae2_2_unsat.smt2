(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111010010000 #b011000)
                arg1
                (fp #b1 #b110100110010 #b101101)))
(assert (fp.leq (fp #b1 #b110100110010 #b101101)
                arg1
                (fp #b1 #b000001010110 #b111101)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b010101001101 #b001000)
                arg3
                (fp #b1 #b000000000000 #b100111)))
(assert (fp.leq (fp #b1 #b000000000000 #b100111)
                arg3
                (fp #b0 #b001110010001 #b011101)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
