(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b110001101011000 #b1100100001)
                arg1
                (fp #b0 #b100000000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b100000000001010 #b0000000000)
                arg1
                (fp #b0 #b100101101100001 #b1101011000)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100001110101011 #b0111111110)
                arg2
                (fp #b1 #b000000000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1000101100)
                arg2
                (fp #b0 #b011100111110001 #b1000001100)))

(declare-const arg3 (_ FloatingPoint 15 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b000011000111001 #b1111010001)
                expect
                (fp #b1 #b000000000001011 #b0001011001)))
(assert (fp.leq (fp #b1 #b000000000001011 #b0001011001)
                expect
                (fp #b0 #b110110110100100 #b0110010001)))

(assert (= expect result))

(check-sat)
(exit)
