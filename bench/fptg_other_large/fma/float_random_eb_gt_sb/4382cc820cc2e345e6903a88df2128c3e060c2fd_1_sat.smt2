; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101010001 #b0111001)
                arg2
                (fp #b1 #b010101110 #b0111000)))
(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b0 #b111101101 #b1101100)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111110 #b0000101)
                arg3
                (fp #b1 #b111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000000)
                arg3
                (fp #b0 #b001011101 #b0101111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
