; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111101111110 #b10011)
                arg2
                (fp #b0 #b001101100111 #b01011)))
(assert (fp.leq (fp #b0 #b001101100111 #b01011)
                arg2
                (fp #b0 #b111110100111 #b11110)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101100010100 #b00110)
                arg3
                (fp #b1 #b000000000000 #b10000)))
(assert (fp.leq (fp #b1 #b000000000000 #b10000)
                arg3
                (fp #b0 #b100001111110 #b01000)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
