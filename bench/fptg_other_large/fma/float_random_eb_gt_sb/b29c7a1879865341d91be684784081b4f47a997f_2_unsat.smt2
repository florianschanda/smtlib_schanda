(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1111110)
