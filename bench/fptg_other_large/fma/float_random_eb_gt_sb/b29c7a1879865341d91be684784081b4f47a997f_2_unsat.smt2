                (fp #b1 #b111111111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0000000)
                arg1
                (fp #b1 #b110111001000000101 #b0010110)))

(declare-const arg2 (_ FloatingPoint 18 8))
