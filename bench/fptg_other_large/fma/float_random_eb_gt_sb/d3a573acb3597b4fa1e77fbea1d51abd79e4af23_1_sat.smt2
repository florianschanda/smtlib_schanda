(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b01011010101 #b100111)
                arg1
                (fp #b0 #b01100111010 #b000001)))
(assert (fp.leq (fp #b0 #b01100111010 #b000001)
                arg1
                (fp #b0 #b10010010000 #b010111)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b01110001110 #b000010)
                arg2
                (fp #b0 #b10110111100 #b011011)))
(assert (fp.leq (fp #b0 #b10110111100 #b011011)
                arg2
                (fp #b0 #b11011111111 #b101000)))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
