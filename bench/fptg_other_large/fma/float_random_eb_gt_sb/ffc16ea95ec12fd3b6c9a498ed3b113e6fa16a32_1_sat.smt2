(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111001 #b0101)
                arg1
                (fp #b1 #b000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000 #b0100)
                arg1
                (fp #b0 #b111000001 #b1001)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001010001 #b0000)
                arg2
                (fp #b1 #b000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000 #b0100)
                arg2
                (fp #b0 #b001101111 #b1101)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b010001010 #b0111)
                arg3
                (fp #b0 #b010101000 #b0010)))
(assert (fp.leq (fp #b0 #b010101000 #b0010)
                arg3
                (fp #b0 #b101110111 #b1000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111010 #b0101)
                expect
                (fp #b0 #b010101000 #b0010)))
(assert (fp.leq (fp #b0 #b010101000 #b0010)
                expect
                (fp #b0 #b110010001 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
