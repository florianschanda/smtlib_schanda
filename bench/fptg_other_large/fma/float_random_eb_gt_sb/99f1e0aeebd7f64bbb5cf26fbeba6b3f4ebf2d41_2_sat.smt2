; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b100101101110101 #b1011100110101)
                arg1
                (fp #b0 #b001010000101100 #b0000100110000)))
(assert (fp.leq (fp #b0 #b001010000101100 #b0000100110000)
                arg1
                (fp #b0 #b111010010011001 #b1011000011010)))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b010010110011110 #b0111110100101)
                arg2
                (fp #b1 #b000000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0111000000111)
                arg2
                (fp #b0 #b100010010011100 #b0111110101010)))

(declare-const arg3 (_ FloatingPoint 15 14))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b101100110001000 #b0100001001011)
                arg3
                (fp #b1 #b000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000000000)
                arg3
                (fp #b0 #b111111011001110 #b1111001010110)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111101001100100 #b0000010100101)
                expect
                (fp #b1 #b000000000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000000001)
                expect
                (fp #b0 #b010011010001011 #b0110100001000)))

(assert (= expect result))

(check-sat)
(exit)
