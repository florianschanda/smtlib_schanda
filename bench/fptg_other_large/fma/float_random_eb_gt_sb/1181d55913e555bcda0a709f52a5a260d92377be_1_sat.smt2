(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010101101111110 #b1)
                arg1
                (fp #b0 #b000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0)
                arg1
                (fp #b0 #b101001000011110 #b1)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b111010001011000 #b1)
                arg2
                (fp #b1 #b100000000000001 #b0)))
(assert (fp.leq (fp #b1 #b100000000000001 #b0)
                arg2
                (fp #b1 #b001110110000110 #b1)))

(declare-const arg3 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001011010000011 #b1)
                arg3
                (fp #b0 #b000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1)
                arg3
                (fp #b0 #b111011101011101 #b1)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b011011011010101 #b1)
                expect
                (fp #b0 #b000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1)
                expect
                (fp #b0 #b100101101001010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
