(assert (fp.leq (fp #b1 #b00010010011110 #b011010011)
                arg3
                (fp #b0 #b01010100111101 #b101011000)))
(assert (fp.leq (fp #b0 #b01010100111101 #b101011000)
                arg3
                (fp #b0 #b11101100010000 #b001100101)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

