(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10011111010111 #b1010000)
                arg1
                (fp #b1 #b01011101110000 #b1111011)))
(assert (fp.leq (fp #b1 #b01011101110000 #b1111011)
                arg1
                (fp #b0 #b10100011011000 #b0111101)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11010101000011 #b0011101)
                arg2
                (fp #b1 #b10000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000000111 #b0000000)
                arg2
                (fp #b1 #b01001001000011 #b1110010)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01100111001011 #b0001011)
                arg3
                (fp #b0 #b11111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000)
                arg3
                (fp #b0 #b11111111111101 #b0011010)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101011101001 #b0101100)
                expect
                (fp #b0 #b11111111111101 #b0000001)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000001)
                expect
                (fp #b0 #b11111111111110 #b0011000)))

(assert (= expect result))

(check-sat)
(exit)
