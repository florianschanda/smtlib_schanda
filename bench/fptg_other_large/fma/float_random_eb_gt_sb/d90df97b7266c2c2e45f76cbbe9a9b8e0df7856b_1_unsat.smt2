(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00100000001000 #b01)
                arg1
                (fp #b0 #b01001110101001 #b01)))
(assert (fp.leq (fp #b0 #b01001110101001 #b01)
                arg1
                (fp #b0 #b10011011010110 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00001110001100 #b10)
                arg2
                (fp #b1 #b00000000000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00)
                arg2
                (fp #b0 #b10000111101001 #b10)))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
