(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111001110100111011 #b1)
                arg1
                (fp #b1 #b110100000100111111 #b0)))
(assert (fp.leq (fp #b1 #b110100000100111111 #b0)
                arg1
                (fp #b1 #b001101101001001001 #b1)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b0 #b011110010000111010 #b1)
                arg2
                (fp #b0 #b111111111111111110 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b0)
                arg2
                (fp #b0 #b111111111111111110 #b1)))

(declare-const arg3 (_ FloatingPoint 18 2))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b101010111011001000 #b1)
                arg3
                (fp #b1 #b000000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0)
                arg3
                (fp #b0 #b110100010001101101 #b1)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0)
                expect
                (fp #b1 #b111111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1)
                expect
                (fp #b1 #b011110010000100000 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
