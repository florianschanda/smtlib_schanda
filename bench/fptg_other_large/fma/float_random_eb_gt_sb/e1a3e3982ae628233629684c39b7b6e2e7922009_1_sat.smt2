(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b1000010100 #b10111)
                arg1
                (fp #b0 #b1111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111)
                arg1
                (fp #b0 #b1111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011001110 #b01111)
                arg2
                (fp #b1 #b0010011100 #b00011)))
(assert (fp.leq (fp #b1 #b0010011100 #b00011)
                arg2
                (fp #b1 #b0001110100 #b11100)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101111000 #b00101)
                arg3
                (fp #b1 #b0000000000 #b10000)))
(assert (fp.leq (fp #b1 #b0000000000 #b10000)
                arg3
                (fp #b0 #b1101000111 #b01100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101001111 #b00111)
                expect
                (fp #b1 #b1010011100 #b00010)))
(assert (fp.leq (fp #b1 #b1010011100 #b00010)
                expect
                (fp #b0 #b1110000101 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
