;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10101011110111010 #b001)
                arg1
                (fp #b1 #b00111110000000100 #b100)))
(assert (fp.leq (fp #b1 #b00111110000000100 #b100)
                arg1
                (fp #b1 #b00000001010010001 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11111111111111110 #b000)
                arg3
                (fp #b1 #b11111111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b000)
                arg3
                (fp #b0 #b11110101101111110 #b101)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11111111111111110 #b100)
                expect
                (fp #b1 #b11111111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b000)
                expect
                (fp #b1 #b11000101101001110 #b111)))

(assert (= expect result))

(check-sat)
(exit)
