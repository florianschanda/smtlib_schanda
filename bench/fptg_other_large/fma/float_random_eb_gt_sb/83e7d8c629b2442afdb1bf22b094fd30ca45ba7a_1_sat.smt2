(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10110011011010110 #b11)
                arg1
                (fp #b1 #b00000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b10)
                arg1
                (fp #b0 #b00011000110111100 #b01)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10000011001101111 #b00)
                arg2
                (fp #b1 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b01)
                arg2
                (fp #b0 #b01000111110101101 #b10)))

(declare-const arg3 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10100001001000101 #b11)
                arg3
                (fp #b0 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01)
                arg3
                (fp #b0 #b01011111111101000 #b00)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11111010100010111 #b00)
                expect
                (fp #b0 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01)
                expect
                (fp #b0 #b11011100101010010 #b00)))

(assert (= expect result))

(check-sat)
(exit)
