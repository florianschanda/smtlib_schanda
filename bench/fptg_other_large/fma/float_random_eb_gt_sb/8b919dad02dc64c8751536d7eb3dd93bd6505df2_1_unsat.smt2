(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b000010010001010 #b01001110001)
                arg2
                (fp #b1 #b000000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000)
                arg2
                (fp #b0 #b001100011000110 #b11111010010)))

(declare-const arg3 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b111011000011110 #b10000111000)
                arg3
                (fp #b1 #b000000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000)
                arg3
                (fp #b0 #b100100011000011 #b10100010001)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
