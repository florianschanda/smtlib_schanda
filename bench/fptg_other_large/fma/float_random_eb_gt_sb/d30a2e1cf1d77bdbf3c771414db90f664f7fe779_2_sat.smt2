(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b010010111010101010 #b110)
                arg1
                (fp #b0 #b100000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000000000011 #b000)
                arg1
                (fp #b0 #b100101111101000001 #b010)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b010000101111011010 #b111)
                arg2
                (fp #b1 #b000101111011000010 #b101)))
(assert (fp.leq (fp #b1 #b000101111011000010 #b101)
                arg2
                (fp #b0 #b101011001011000100 #b111)))

(declare-const arg3 (_ FloatingPoint 18 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b010101111110110001 #b101)
                expect
                (fp #b1 #b000101111011000110 #b110)))
(assert (fp.leq (fp #b1 #b000101111011000110 #b110)
                expect
                (fp #b0 #b110111101010100110 #b010)))

(assert (= expect result))

(check-sat)
(exit)
