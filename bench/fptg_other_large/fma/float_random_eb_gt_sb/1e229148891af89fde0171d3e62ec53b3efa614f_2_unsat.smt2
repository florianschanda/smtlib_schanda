(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101011111 #b0111)
                arg1
                (fp #b1 #b100011000 #b0111)))
(assert (fp.leq (fp #b1 #b100011000 #b0111)
                arg1
                (fp #b1 #b010111101 #b1110)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000011011 #b0101)
                arg2
                (fp #b0 #b111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111110 #b1111)
                arg2
                (fp #b0 #b111111111 #b0000)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b011100110 #b0011)
                arg3
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                arg3
                (fp #b0 #b010111111 #b0100)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
