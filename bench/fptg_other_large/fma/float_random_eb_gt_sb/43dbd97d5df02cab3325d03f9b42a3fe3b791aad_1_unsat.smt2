(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1001010001101110 #b0010111)
                arg1
                (fp #b0 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000)
                arg1
                (fp #b0 #b0110110011101011 #b0000011)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0001000101011011 #b0100111)
                arg2
                (fp #b0 #b1000000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000000000111 #b0000000)
                arg2
                (fp #b0 #b1101100110010001 #b1000011)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
