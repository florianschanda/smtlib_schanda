                (fp #b0 #b11000101101 #b0000000)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111110000 #b1011111)
                arg3
                (fp #b0 #b00100001001 #b0101011)))
(assert (fp.leq (fp #b0 #b00100001001 #b0101011)
                arg3
                (fp #b0 #b11110001111 #b0100111)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b01000011001 #b1100001)
                expect
