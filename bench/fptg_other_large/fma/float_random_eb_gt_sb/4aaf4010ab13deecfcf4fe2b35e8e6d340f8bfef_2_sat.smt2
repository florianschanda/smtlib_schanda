(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111101 #b0001)
                arg1
                (fp #b1 #b1111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111101 #b0000)
                arg1
                (fp #b1 #b1001100011 #b0000)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1100101111 #b0111)
                arg2
                (fp #b1 #b0000000000 #b1110)))
(assert (fp.leq (fp #b1 #b0000000000 #b1110)
                arg2
                (fp #b0 #b1011001101 #b1001)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0100110111 #b1011)
                arg3
                (fp #b0 #b1000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000100 #b0000)
                arg3
                (fp #b0 #b1100000100 #b0101)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010111101 #b0001)
                expect
                (fp #b0 #b1000000100 #b0001)))
(assert (fp.leq (fp #b0 #b1000000100 #b0001)
                expect
                (fp #b0 #b1111010010 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
