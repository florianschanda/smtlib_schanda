(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111111111111101 #b1100)
                arg1
                (fp #b1 #b1111111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0000)
                arg1
                (fp #b0 #b0001011101100000 #b0011)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1100000100100000 #b0011)
                arg2
                (fp #b0 #b1111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111)
                arg2
                (fp #b0 #b1111111111111111 #b0000)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b0 #b1010110111011011 #b1000)
                arg3
                (fp #b0 #b1111111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b0000)
                arg3
                (fp #b0 #b1111111111111110 #b1001)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
