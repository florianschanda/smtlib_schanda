(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111010100010001 #b11101000110)
                arg1
                (fp #b1 #b1110110111100111 #b00100010010)))
(assert (fp.leq (fp #b1 #b1110110111100111 #b00100010010)
                arg1
                (fp #b1 #b0111010001010110 #b00110111001)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0001010100101100 #b01101000000)
                arg3
                (fp #b1 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000)
                arg3
                (fp #b0 #b1010001011100100 #b01010011101)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000)
                expect
                (fp #b1 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111)
                expect
                (fp #b0 #b1001111111111011 #b10011011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
