(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +ZERO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01110111010100 #b01011)
                arg2
                (fp #b0 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000)
                arg2
                (fp #b0 #b11111110110011 #b10001)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00101010001010 #b10010)
                arg3
                (fp #b0 #b10011010001010 #b11011)))
(assert (fp.leq (fp #b0 #b10011010001010 #b11011)
                arg3
                (fp #b0 #b10011011110101 #b10110)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
