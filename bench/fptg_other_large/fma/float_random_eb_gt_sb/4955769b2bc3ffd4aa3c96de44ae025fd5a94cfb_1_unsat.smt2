; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b010100111010101 #b1010100100)
                arg2
                (fp #b0 #b001111000011110 #b0000101101)))
(assert (fp.leq (fp #b0 #b001111000011110 #b0000101101)
                arg2
                (fp #b0 #b101101000100011 #b1100100110)))

(declare-const arg3 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100011111001011 #b1100110111)
                arg3
                (fp #b1 #b000000000000000 #b1100010101)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1100010101)
                arg3
                (fp #b0 #b110100101010011 #b0101011111)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
