                (fp #b0 #b111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000)
                arg2
                (fp #b0 #b111111101 #b00011)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101001111 #b10100)
                arg3
                (fp #b1 #b100101011 #b00001)))
(assert (fp.leq (fp #b1 #b100101011 #b00001)
                arg3
                (fp #b1 #b011101010 #b00010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110100100 #b01101)
                expect
                (fp #b0 #b101101011 #b00100)))
(assert (fp.leq (fp #b0 #b101101011 #b00100)
                expect
                (fp #b0 #b111100011 #b01010)))

(assert (not (= expect result)))

(check-sat)
(exit)
