; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b100010011100000 #b000001)
                arg1
                (fp #b1 #b100000000000110 #b000000)))
(assert (fp.leq (fp #b1 #b100000000000110 #b000000)
                arg1
                (fp #b0 #b101101010101010 #b000000)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111110 #b001101)
                arg2
                (fp #b1 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000)
                arg2
                (fp #b1 #b000011011011101 #b011010)))

(declare-const arg3 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111110 #b001001)
                arg3
                (fp #b1 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000)
                arg3
                (fp #b1 #b001000111011100 #b111111)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b0 #b010000100111011 #b100111)
                expect
                (fp #b0 #b111111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b111111)
                expect
                (fp #b0 #b111111111111111 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
