(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11001000110 #b1011)
                arg1
                (fp #b1 #b00111011111 #b1110)))
(assert (fp.leq (fp #b1 #b00111011111 #b1110)
                arg1
                (fp #b0 #b10110110010 #b1001)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10011111011 #b0000)
                arg2
                (fp #b1 #b00111010101 #b1000)))
(assert (fp.leq (fp #b1 #b00111010101 #b1000)
                arg2
                (fp #b0 #b11101111100 #b0010)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10001110101 #b0110)
                expect
                (fp #b1 #b00111010101 #b0111)))
(assert (fp.leq (fp #b1 #b00111010101 #b0111)
                expect
                (fp #b1 #b00010111010 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
