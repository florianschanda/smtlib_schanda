(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1110111001011110 #b01110010000)
                arg1
                (fp #b1 #b1110110111100111 #b00100010010)))
(assert (fp.leq (fp #b1 #b1110110111100111 #b00100010010)
                arg1
                (fp #b0 #b0100010111111010 #b11100111010)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000)
                arg3
                (fp #b1 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111)
                arg3
                (fp #b1 #b0101110011010100 #b00010110000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
