(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101110111 #b1000001)
                arg1
                (fp #b0 #b1111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111111)
                arg1
                (fp #b0 #b1111111111 #b0000000)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100000011 #b0001011)
                arg2
                (fp #b1 #b0000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101110)
                arg2
                (fp #b0 #b1000111000 #b1000111)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1011011100 #b1100101)
                arg3
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                arg3
                (fp #b0 #b1001001010 #b0000100)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011000001 #b0111011)
                expect
                (fp #b1 #b1000000000 #b1011100)))
(assert (fp.leq (fp #b1 #b1000000000 #b1011100)
                expect
                (fp #b0 #b0110100001 #b1001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
