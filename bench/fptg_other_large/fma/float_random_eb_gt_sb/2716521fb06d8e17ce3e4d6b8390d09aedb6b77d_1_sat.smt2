(assert (fp.leq (fp #b1 #b0100111001111 #b10)
                arg3
                (fp #b0 #b1011010000011 #b00)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111111111111 #b00)
