; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100000111111 #b1010101)
                arg1
                (fp #b1 #b100000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000000111 #b0000000)
                arg1
                (fp #b1 #b010111001110 #b0001001)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b001111000000 #b0111000)
                arg2
                (fp #b0 #b000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100000)
                arg2
                (fp #b0 #b100001010010 #b1001001)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111111 #b0000000)
                arg3
                (fp #b1 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111111)
                arg3
                (fp #b0 #b101101011000 #b0101111)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
