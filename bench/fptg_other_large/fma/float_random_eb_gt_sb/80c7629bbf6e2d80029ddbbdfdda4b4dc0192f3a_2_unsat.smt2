; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0110011100000000 #b0)
                arg1
                (fp #b0 #b1111111111111110 #b1)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1)
                arg1
                (fp #b0 #b1111111111111111 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0101111010100000 #b1)
                arg2
                (fp #b1 #b0000110100010101 #b0)))
(assert (fp.leq (fp #b1 #b0000110100010101 #b0)
                arg2
                (fp #b0 #b1010111111111011 #b1)))

(declare-const arg3 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0100000010101111 #b1)
                arg3
                (fp #b0 #b0000100110011011 #b1)))
(assert (fp.leq (fp #b0 #b0000100110011011 #b1)
                arg3
                (fp #b0 #b0000101000110111 #b1)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1001110001110010 #b1)
                expect
                (fp #b1 #b1000110100010100 #b1)))
(assert (fp.leq (fp #b1 #b1000110100010100 #b1)
                expect
                (fp #b1 #b0110011011111001 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
