(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b0 #b10101011101100101 #b10)
                arg1
                (fp #b0 #b11111111111111110 #b11)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b11)
                arg1
                (fp #b0 #b11111111111111111 #b00)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11110011011100010 #b11)
                arg2
                (fp #b1 #b10000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000000000010 #b00)
                arg2
                (fp #b0 #b00101011001000100 #b10)))

(declare-const arg3 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10000100100001001 #b10)
                arg3
                (fp #b1 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b01)
                arg3
                (fp #b0 #b11111000000000110 #b10)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
