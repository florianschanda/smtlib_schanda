(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b111000001001011 #b01101101010)
                arg2
                (fp #b1 #b100000000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000000001011 #b00000000000)
                arg2
                (fp #b1 #b011110010011110 #b10100010110)))

(declare-const arg3 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b010010011010101 #b11010010101)
                arg3
                (fp #b1 #b000101101100000 #b00101111011)))
(assert (fp.leq (fp #b1 #b000101101100000 #b00101111011)
                arg3
                (fp #b0 #b011000100011011 #b11111001010)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
