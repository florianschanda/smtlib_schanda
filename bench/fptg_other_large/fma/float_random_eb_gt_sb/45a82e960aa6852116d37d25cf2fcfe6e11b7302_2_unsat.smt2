(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101010111001 #b011)
                arg1
                (fp #b1 #b000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000 #b010)
                arg1
                (fp #b0 #b010000001010 #b101)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111010111001 #b110)
                arg2
                (fp #b1 #b110111010111 #b101)))
(assert (fp.leq (fp #b1 #b110111010111 #b101)
                arg2
                (fp #b1 #b100011001001 #b101)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111111101 #b111)
                arg3
                (fp #b1 #b111111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000)
                arg3
                (fp #b1 #b000111110101 #b111)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111111110 #b111)
                expect
                (fp #b1 #b111111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000)
                expect
                (fp #b1 #b001101100101 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
