(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0011011010 #b01010000)
                arg1
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                arg1
                (fp #b0 #b0011000011 #b00011100)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111111 #b00000000)
                arg2
                (fp #b1 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111111)
                arg2
                (fp #b0 #b1101100000 #b11000110)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110011001 #b00010111)
                arg3
                (fp #b1 #b0101111110 #b10100111)))
(assert (fp.leq (fp #b1 #b0101111110 #b10100111)
                arg3
                (fp #b1 #b0100000110 #b00110011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101000010 #b00111010)
                expect
                (fp #b1 #b0101111110 #b10100111)))
(assert (fp.leq (fp #b1 #b0101111110 #b10100111)
                expect
                (fp #b1 #b0101000011 #b10110001)))

(assert (= expect result))

(check-sat)
(exit)
