(assert (fp.leq (fp #b1 #b11111111111111101 #b00)
                arg2
                (fp #b1 #b01001100010000001 #b00)))

(declare-const arg3 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11111111111111101 #b11)
                arg3
                (fp #b1 #b11111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b00)
                arg3
                (fp #b1 #b11000100010101010 #b00)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 3))
