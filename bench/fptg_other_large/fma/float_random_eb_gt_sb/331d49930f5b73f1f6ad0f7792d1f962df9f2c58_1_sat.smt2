(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10000011100 #b100)
                arg1
                (fp #b1 #b00000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000 #b010)
                arg1
                (fp #b0 #b00011110011 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01100101000 #b111)
                arg2
                (fp #b1 #b01000101111 #b000)))
(assert (fp.leq (fp #b1 #b01000101111 #b000)
                arg2
                (fp #b0 #b10110001111 #b101)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10100111011 #b110)
                expect
                (fp #b1 #b01000101110 #b111)))
(assert (fp.leq (fp #b1 #b01000101110 #b111)
                expect
                (fp #b0 #b00001111111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
