(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                arg1
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                arg1
                (fp #b1 #b11010111101 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b10010010010 #b10)
                arg2
                (fp #b0 #b10100011000 #b01)))
(assert (fp.leq (fp #b0 #b10100011000 #b01)
                arg2
                (fp #b0 #b10111010111 #b10)))

(declare-const arg3 (_ FloatingPoint 11 3))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11010001111 #b11)
                arg3
                (fp #b0 #b00000000000 #b00)))
(assert (fp.leq (fp #b0 #b00000000000 #b00)
                arg3
                (fp #b0 #b11001011101 #b00)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
