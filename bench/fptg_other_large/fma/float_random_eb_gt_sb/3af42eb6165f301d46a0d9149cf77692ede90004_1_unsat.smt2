(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011101011000 #b01110)
                arg2
                (fp #b0 #b11001000111111 #b01001)))
(assert (fp.leq (fp #b0 #b11001000111111 #b01001)
                arg2
                (fp #b0 #b11011110000101 #b01011)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11011010100110 #b10100)
                arg3
                (fp #b0 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000)
                arg3
                (fp #b0 #b11111001101101 #b10010)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
