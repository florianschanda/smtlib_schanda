(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b110111110110 #b0)
                arg1
                (fp #b1 #b100000000001 #b0)))
(assert (fp.leq (fp #b1 #b100000000001 #b0)
                arg1
                (fp #b1 #b001101011101 #b0)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b001100110100 #b1)
                arg2
                (fp #b0 #b101001100011 #b1)))
(assert (fp.leq (fp #b0 #b101001100011 #b1)
                arg2
                (fp #b0 #b101001110001 #b1)))

(declare-const arg3 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111100101011 #b1)
                arg3
                (fp #b0 #b000101101101 #b1)))
(assert (fp.leq (fp #b0 #b000101101101 #b1)
                arg3
                (fp #b0 #b111100011011 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111001100100 #b1)
                expect
                (fp #b1 #b101001100101 #b0)))
(assert (fp.leq (fp #b1 #b101001100101 #b0)
                expect
                (fp #b1 #b100010110100 #b1)))

(assert (= expect result))

(check-sat)
(exit)
