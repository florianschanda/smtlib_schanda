                (fp #b0 #b10111111001001 #b1111111)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10000101011001 #b1110000)
                arg3
                (fp #b0 #b01010100001010 #b0000001)))
(assert (fp.leq (fp #b0 #b01010100001010 #b0000001)
                arg3
                (fp #b0 #b01100010000010 #b0100010)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b11011000110010 #b1110010)
                expect
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                expect
                (fp #b0 #b11111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
