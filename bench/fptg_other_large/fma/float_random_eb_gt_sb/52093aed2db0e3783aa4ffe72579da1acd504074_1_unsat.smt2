(assert (fp.leq (fp #b1 #b11111111101 #b000000000)
                arg2
                (fp #b1 #b10100000100 #b010101001)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01011111111 #b000011001)
                arg3
                (fp #b0 #b00000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b00000000000 #b001100101)
                arg3
                (fp #b0 #b10000111100 #b000000100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10001111111 #b011010011)
                expect
                (fp #b0 #b01111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b01111111101 #b000000000)
                expect
                (fp #b0 #b11101000000 #b010001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
