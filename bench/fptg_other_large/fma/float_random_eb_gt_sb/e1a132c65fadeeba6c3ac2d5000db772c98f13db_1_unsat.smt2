(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1101010000101100 #b010)
                arg2
                (fp #b1 #b1000000000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000000000011 #b000)
                arg2
                (fp #b1 #b0010011011100000 #b001)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0000101010011101 #b011)
                arg3
                (fp #b0 #b1101111101111000 #b001)))
(assert (fp.leq (fp #b0 #b1101111101111000 #b001)
                arg3
                (fp #b0 #b1110010110100011 #b100)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
