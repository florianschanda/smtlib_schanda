                arg2
                (fp #b0 #b000000000000000 #b01000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01000000000)
                arg2
                (fp #b0 #b001100001010101 #b11011010011)))

(declare-const arg3 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b000111000001111 #b10101100011)
                arg3
                (fp #b1 #b000101101100000 #b00101111011)))
(assert (fp.leq (fp #b1 #b000101101100000 #b00101111011)
                arg3
                (fp #b0 #b100001011001100 #b10100010100)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b100110111001011 #b01101101101)
                expect
                (fp #b1 #b000101101100000 #b00101111011)))
(assert (fp.leq (fp #b1 #b000101101100000 #b00101111011)
                expect
                (fp #b0 #b111001000101000 #b00010101010)))

(assert (= expect result))

(check-sat)
(exit)
