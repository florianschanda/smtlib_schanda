(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111001 #b11)
                arg1
                (fp #b1 #b100000010 #b00)))
(assert (fp.leq (fp #b1 #b100000010 #b00)
                arg1
                (fp #b0 #b101011010 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101000011 #b01)
                arg2
                (fp #b1 #b100101001 #b01)))
(assert (fp.leq (fp #b1 #b100101001 #b01)
                arg2
                (fp #b0 #b011010101 #b10)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111101 #b11)
                arg3
                (fp #b1 #b111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111101 #b00)
                arg3
                (fp #b1 #b110111010 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111101 #b01)
                expect
                (fp #b1 #b111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111101 #b00)
                expect
                (fp #b1 #b011000011 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
