; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00011011001 #b01001)
                arg1
                (fp #b0 #b11110010110 #b00010)))
(assert (fp.leq (fp #b0 #b11110010110 #b00010)
                arg1
                (fp #b0 #b11110101010 #b01111)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00110101001 #b00001)
                arg2
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                arg2
                (fp #b0 #b11111001110 #b11001)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10100110010 #b00000)
                arg3
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                arg3
                (fp #b0 #b10001001011 #b11111)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00011010011 #b00001)
                expect
                (fp #b0 #b11110011100 #b00011)))
(assert (fp.leq (fp #b0 #b11110011100 #b00011)
                expect
                (fp #b0 #b11110110101 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
