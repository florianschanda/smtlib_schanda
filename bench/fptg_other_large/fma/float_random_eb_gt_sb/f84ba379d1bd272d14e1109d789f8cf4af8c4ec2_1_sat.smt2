(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01010100110101 #b001)
                arg1
                (fp #b1 #b00000000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010)
                arg1
                (fp #b0 #b10110101110010 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111111 #b000)
                arg2
                (fp #b1 #b11111111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111)
                arg2
                (fp #b1 #b01000101101111 #b011)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01011011100100 #b100)
                arg3
                (fp #b1 #b00000000000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b100)
                arg3
                (fp #b0 #b11001101001100 #b001)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01010010001101 #b111)
                expect
                (fp #b0 #b01111111111110 #b110)))
(assert (fp.leq (fp #b0 #b01111111111110 #b110)
                expect
                (fp #b0 #b11111110101000 #b110)))

(assert (= expect result))

(check-sat)
(exit)
