(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b010010100 #b00)
                arg1
                (fp #b0 #b111000001 #b11)))
(assert (fp.leq (fp #b0 #b111000001 #b11)
                arg1
                (fp #b0 #b111110101 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
