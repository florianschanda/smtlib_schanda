                arg2
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                arg2
                (fp #b0 #b000101010 #b11)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011111001 #b00)
                arg3
                (fp #b1 #b000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000 #b10)
                arg3
                (fp #b0 #b011001101 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101110101 #b00)
                expect
                (fp #b0 #b011000001 #b10)))
(assert (fp.leq (fp #b0 #b011000001 #b10)
                expect
                (fp #b0 #b100000000 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
