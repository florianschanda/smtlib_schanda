                arg3
                (fp #b0 #b00000000000000 #b101)))
(assert (fp.leq (fp #b0 #b00000000000000 #b101)
                arg3
                (fp #b0 #b00111011101100 #b101)))

(declare-const result (_ FloatingPoint 14 4))
