(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111111100010 #b0111)
                arg1
                (fp #b0 #b00100110101101 #b1111)))
(assert (fp.leq (fp #b0 #b00100110101101 #b1111)
                arg1
                (fp #b0 #b10100101001100 #b0100)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00011011010001 #b1110)
                arg2
                (fp #b0 #b00000000000000 #b0111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0111)
                arg2
                (fp #b0 #b01001101011010 #b0011)))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111011100110 #b0011)
                expect
                (fp #b1 #b00000000000000 #b0110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0110)
                expect
                (fp #b0 #b11000100110011 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
