; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b10000001010110001 #b0110110001101)
                arg2
                (fp #b1 #b10000000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000000001101 #b0000000000000)
                arg2
                (fp #b0 #b00100010110010101 #b0110001111111)))

(declare-const arg3 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b11111100111011101 #b1110010111000)
                arg3
                (fp #b0 #b00000000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0100000000000)
                arg3
                (fp #b0 #b01000011001110001 #b0100100110011)))

(declare-const result (_ FloatingPoint 17 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
