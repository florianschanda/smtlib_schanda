; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111101 #b1000010)
                arg1
                (fp #b1 #b111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000000)
                arg1
                (fp #b0 #b010010111 #b1110100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111000 #b1110010)
                arg2
                (fp #b1 #b000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b000000000 #b0100000)
                arg2
                (fp #b0 #b100011101 #b1111110)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011100100 #b0110010)
                arg3
                (fp #b1 #b001000011 #b0101101)))
(assert (fp.leq (fp #b1 #b001000011 #b0101101)
                arg3
                (fp #b0 #b010010011 #b1010110)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b001100000 #b0011111)
                expect
                (fp #b0 #b011111101 #b0000000)))
(assert (fp.leq (fp #b0 #b011111101 #b0000000)
                expect
                (fp #b0 #b100111100 #b1101001)))

(assert (= expect result))

(check-sat)
(exit)
