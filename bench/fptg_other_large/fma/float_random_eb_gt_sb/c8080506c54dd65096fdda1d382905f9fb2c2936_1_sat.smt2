                arg2
                (fp #b0 #b0000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0100)
                arg2
                (fp #b0 #b1010010001111 #b1010)))

(declare-const arg3 (_ FloatingPoint 13 5))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
