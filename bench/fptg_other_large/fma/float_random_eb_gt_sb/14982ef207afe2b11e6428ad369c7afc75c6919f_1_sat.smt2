(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1111000111 #b01)
                arg1
                (fp #b0 #b0000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000 #b00)
                arg1
                (fp #b0 #b0011000011 #b00)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101001011 #b11)
                arg2
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg2
                (fp #b0 #b0000000011 #b11)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
