(assert (fp.leq (fp #b1 #b000000000000000 #b010000100)
                arg2
                (fp #b0 #b110011101100100 #b101000111)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b100110001011011 #b001101010)
                expect
                (fp #b1 #b000000000001001 #b000001111)))
(assert (fp.leq (fp #b1 #b000000000001001 #b000001111)
                expect
                (fp #b0 #b111011100111010 #b100100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
