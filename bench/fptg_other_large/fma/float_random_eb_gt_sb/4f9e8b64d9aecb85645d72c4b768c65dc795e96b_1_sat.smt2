; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10111001110111 #b010001)
                arg1
                (fp #b1 #b00000000000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000)
                arg1
                (fp #b0 #b00101001100110 #b000010)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10111011101011 #b010100)
                arg2
                (fp #b1 #b10000000000110 #b000000)))
(assert (fp.leq (fp #b1 #b10000000000110 #b000000)
                arg2
                (fp #b0 #b11101101101001 #b011010)))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101111110001 #b001001)
                arg3
                (fp #b0 #b11111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111)
                arg3
                (fp #b0 #b11111111111111 #b000000)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b01010101011110 #b101110)
                expect
                (fp #b0 #b11111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111)
                expect
                (fp #b0 #b11111111111111 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
