(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b0010101101111110 #b10111101)
                arg1
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                arg1
                (fp #b0 #b1111111111111111 #b00000000)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000)
                arg2
                (fp #b1 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111)
                arg2
                (fp #b1 #b1000001011100110 #b01011010)))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101000000101010 #b11111110)
                arg3
                (fp #b0 #b0000000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000000)
                arg3
                (fp #b0 #b0010001100110000 #b10010101)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
