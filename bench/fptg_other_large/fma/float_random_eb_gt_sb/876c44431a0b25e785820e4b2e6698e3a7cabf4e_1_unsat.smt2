(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11101001101 #b011101101)
                arg1
                (fp #b1 #b00101110111 #b000000101)))
(assert (fp.leq (fp #b1 #b00101110111 #b000000101)
                arg1
                (fp #b0 #b11101011110 #b110101010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01101001010 #b110010010)
                arg2
                (fp #b1 #b00000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b010000000)
                arg2
                (fp #b0 #b00100010111 #b111010101)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
