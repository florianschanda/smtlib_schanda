(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b000111111101000101 #b1)
                arg1
                (fp #b0 #b000000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1)
                arg1
                (fp #b0 #b111010110100000111 #b0)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b001101111011101111 #b0)
                arg2
                (fp #b0 #b001011001010100110 #b0)))
(assert (fp.leq (fp #b0 #b001011001010100110 #b0)
                arg2
                (fp #b0 #b011010001110011000 #b1)))

(declare-const arg3 (_ FloatingPoint 18 2))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b0 #b000011110111000100 #b1)
                expect
                (fp #b0 #b001011001010100110 #b1)))
(assert (fp.leq (fp #b0 #b001011001010100110 #b1)
                expect
                (fp #b0 #b101110001011010001 #b1)))

(assert (= expect result))

(check-sat)
(exit)
