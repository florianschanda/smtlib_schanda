                arg2
                (fp #b1 #b0010100001111 #b00100)))

(declare-const arg3 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111000001110 #b10101)
                arg3
                (fp #b1 #b1000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000101 #b00000)
                arg3
                (fp #b0 #b1011100100101 #b11111)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100000011001 #b00100)
                expect
                (fp #b1 #b1000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000101 #b00000)
                expect
                (fp #b0 #b0111011000000 #b11011)))

(assert (= expect result))

(check-sat)
(exit)
