                arg2
                (fp #b0 #b111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111110 #b111111)
                arg2
                (fp #b0 #b111111111 #b000000)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110001010 #b111011)
                arg3
                (fp #b0 #b000000000 #b010001)))
(assert (fp.leq (fp #b0 #b000000000 #b010001)
                arg3
                (fp #b0 #b110111011 #b101010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b011001100 #b100011)
                expect
                (fp #b0 #b100000110 #b010110)))
(assert (fp.leq (fp #b0 #b100000110 #b010110)
                expect
                (fp #b0 #b101101101 #b000101)))

(assert (= expect result))

(check-sat)
(exit)
