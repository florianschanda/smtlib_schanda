(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100110010011 #b110001111)
                arg2
                (fp #b1 #b000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b010000000)
                arg2
                (fp #b0 #b111011000001 #b000010000)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111110010101 #b100000000)
                arg3
                (fp #b1 #b110101100101 #b100000001)))
(assert (fp.leq (fp #b1 #b110101100101 #b100000001)
                arg3
                (fp #b1 #b000100000100 #b010001011)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
