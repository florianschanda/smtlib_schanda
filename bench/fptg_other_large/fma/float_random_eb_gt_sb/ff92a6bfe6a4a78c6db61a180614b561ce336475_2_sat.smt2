; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100001100111111 #b0000111100)
                arg1
                (fp #b0 #b111010010100011 #b1001101000)))
(assert (fp.leq (fp #b0 #b111010010100011 #b1001101000)
                arg1
                (fp #b0 #b111101001010101 #b1100100111)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b111111111111110 #b0101110110)
                arg2
                (fp #b1 #b111111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0000000000)
                arg2
                (fp #b1 #b010101001111011 #b1111011110)))

(declare-const arg3 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b0 #b001110110110001 #b0100100101)
                arg3
                (fp #b0 #b111111111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b0000000000)
                arg3
                (fp #b0 #b111111111111110 #b0101010010)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
