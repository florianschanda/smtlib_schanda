                arg3
                (fp #b0 #b11111111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b000000)
                arg3
                (fp #b0 #b11111111110 #b101000)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
