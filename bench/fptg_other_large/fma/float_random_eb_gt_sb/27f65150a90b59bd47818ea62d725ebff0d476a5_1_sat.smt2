(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                arg1
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                arg1
                (fp #b0 #b000111101 #b01001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101110000 #b11111)
                arg2
                (fp #b0 #b000000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000000 #b10101)
                arg2
                (fp #b0 #b010001111 #b10001)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b001000011 #b01111)
                arg3
                (fp #b0 #b111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000)
                arg3
                (fp #b0 #b111111101 #b10010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b101000010 #b01010)
                expect
                (fp #b0 #b111111100 #b11111)))
(assert (fp.leq (fp #b0 #b111111100 #b11111)
                expect
                (fp #b0 #b111111110 #b11101)))

(assert (= expect result))

(check-sat)
(exit)
