; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b00010010101000 #b01011100)
                arg1
                (fp #b0 #b00000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01010111)
                arg1
                (fp #b0 #b11111101100110 #b00001001)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b00101010000011 #b01010010)
                arg3
                (fp #b0 #b11111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000000)
                arg3
                (fp #b0 #b11111111111110 #b10110101)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b01000101000000 #b11001011)
                expect
                (fp #b0 #b11111111111100 #b11111111)))
(assert (fp.leq (fp #b0 #b11111111111100 #b11111111)
                expect
                (fp #b0 #b11111111111110 #b00000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
