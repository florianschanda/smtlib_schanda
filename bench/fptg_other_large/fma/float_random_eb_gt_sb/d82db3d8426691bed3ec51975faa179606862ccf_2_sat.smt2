(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000101011 #b111)
                arg1
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg1
                (fp #b0 #b0110100000 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100110010 #b011)
                arg2
                (fp #b1 #b0100111010 #b001)))
(assert (fp.leq (fp #b1 #b0100111010 #b001)
                arg2
                (fp #b0 #b0001011111 #b100)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000000000 #b110)
                expect
                (fp #b0 #b0100111110 #b010)))
(assert (fp.leq (fp #b0 #b0100111110 #b010)
                expect
                (fp #b0 #b1000111100 #b110)))

(assert (= expect result))

(check-sat)
(exit)
