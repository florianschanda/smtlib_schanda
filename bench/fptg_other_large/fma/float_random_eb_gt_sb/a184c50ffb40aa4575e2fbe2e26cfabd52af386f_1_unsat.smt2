(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00111001111 #b001)
                arg2
                (fp #b0 #b00000000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000000 #b110)
                arg2
                (fp #b0 #b10111001011 #b111)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01111010101 #b010)
                arg3
                (fp #b1 #b01110011101 #b000)))
(assert (fp.leq (fp #b1 #b01110011101 #b000)
                arg3
                (fp #b0 #b00111101100 #b001)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
