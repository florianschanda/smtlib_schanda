                (fp #b0 #b00000100100001 #b11)))
(assert (fp.leq (fp #b0 #b00000100100001 #b11)
                arg2
                (fp #b0 #b01011010100010 #b10)))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10110101001011 #b10)
                arg3
                (fp #b1 #b10000000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000000010 #b00)
                arg3
                (fp #b0 #b01111100011101 #b10)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10001011111000 #b00)
                expect
                (fp #b1 #b10000100100001 #b11)))
(assert (fp.leq (fp #b1 #b10000100100001 #b11)
                expect
                (fp #b0 #b00101000101011 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
