;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b0 #b00100010011001110 #b0101)
                arg1
                (fp #b0 #b11111111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111111111111101 #b0000)
                arg1
                (fp #b0 #b11111111111111110 #b0011)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11110111000110010 #b1111)
                arg2
                (fp #b1 #b00000000000000000 #b1110)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1110)
                arg2
                (fp #b0 #b00011111001100000 #b1001)))

(declare-const arg3 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b01010010100011100 #b0001)
                arg3
                (fp #b1 #b01001010011101000 #b1100)))
(assert (fp.leq (fp #b1 #b01001010011101000 #b1100)
                arg3
                (fp #b0 #b10000110011111111 #b1111)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10001010011100000 #b1100)
                expect
                (fp #b1 #b01111111111111110 #b1100)))
(assert (fp.leq (fp #b1 #b01111111111111110 #b1100)
                expect
                (fp #b1 #b01101101011110011 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
