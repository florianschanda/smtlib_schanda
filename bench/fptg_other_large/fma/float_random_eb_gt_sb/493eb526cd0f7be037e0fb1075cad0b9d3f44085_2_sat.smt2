; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111000111 #b00101)
                arg1
                (fp #b0 #b111101001 #b01100)))
(assert (fp.leq (fp #b0 #b111101001 #b01100)
                arg1
                (fp #b0 #b111110101 #b01001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001000100 #b11100)
                arg2
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg2
                (fp #b0 #b101010011 #b01100)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111000100 #b01001)
                arg3
                (fp #b0 #b000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000)
                arg3
                (fp #b0 #b111011101 #b00110)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b001011100 #b01101)
                expect
                (fp #b0 #b111101111 #b01101)))
(assert (fp.leq (fp #b0 #b111101111 #b01101)
                expect
                (fp #b0 #b111110011 #b10010)))

(assert (= expect result))

(check-sat)
(exit)
