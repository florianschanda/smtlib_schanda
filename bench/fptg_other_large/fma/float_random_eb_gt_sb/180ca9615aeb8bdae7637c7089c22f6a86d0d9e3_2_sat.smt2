(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01000000010 #b100)
                arg1
                (fp #b0 #b00000101001 #b010)))
(assert (fp.leq (fp #b0 #b00000101001 #b010)
                arg1
                (fp #b0 #b00011101011 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11001000001 #b111)
                arg2
                (fp #b0 #b00000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000 #b010)
                arg2
                (fp #b0 #b11111111101 #b101)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b11001111000 #b001)
                arg3
                (fp #b1 #b00000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000)
                arg3
                (fp #b0 #b01111011011 #b100)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10010010011 #b101)
                expect
                (fp #b0 #b00000000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000000 #b001)
                expect
                (fp #b0 #b00110110101 #b110)))

(assert (= expect result))

(check-sat)
(exit)
