(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111011000 #b0001000)
                arg1
                (fp #b1 #b000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000000)
                arg1
                (fp #b0 #b011011101 #b0111100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110000010 #b0110011)
                arg2
                (fp #b1 #b101001010 #b0000010)))
(assert (fp.leq (fp #b1 #b101001010 #b0000010)
                arg2
                (fp #b0 #b100000111 #b1010110)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000100101 #b0101001)
                arg3
                (fp #b0 #b000111111 #b0011110)))
(assert (fp.leq (fp #b0 #b000111111 #b0011110)
                arg3
                (fp #b0 #b110001001 #b0000101)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011100111 #b0110101)
                expect
                (fp #b0 #b000111111 #b0011110)))
(assert (fp.leq (fp #b0 #b000111111 #b0011110)
                expect
                (fp #b0 #b100110110 #b0010110)))

(assert (= expect result))

(check-sat)
(exit)
