(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101101101 #b11101001)
                arg1
                (fp #b0 #b0000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b0000000000 #b01010111)
                arg1
                (fp #b0 #b0000100110 #b01100001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000001100 #b10010100)
                arg2
                (fp #b0 #b0000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000011)
                arg2
                (fp #b0 #b0100111110 #b01100100)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1100110110 #b11100101)
                arg3
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                arg3
                (fp #b0 #b1011100001 #b10011011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110010011 #b11101011)
                expect
                (fp #b0 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000001)
                expect
                (fp #b0 #b1111110011 #b00110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
