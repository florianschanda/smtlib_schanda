                arg2
                (fp #b1 #b111111111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0000)
                arg2
                (fp #b0 #b100110111100001101 #b1111)))

(declare-const arg3 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b0 #b000001111110111101 #b0000)
                arg3
                (fp #b0 #b111111111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0000)
                arg3
                (fp #b0 #b111111111111111101 #b1010)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b0 #b010001110001111110 #b1000)
                expect
                (fp #b0 #b111111111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0000)
                expect
                (fp #b0 #b111111111111111101 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
