(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101101111011000 #b100)
                arg1
                (fp #b0 #b100000000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000000011 #b000)
                arg1
                (fp #b0 #b111100110011111 #b001)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111101 #b100)
                arg2
                (fp #b1 #b111111111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000)
                arg2
                (fp #b1 #b010100000100110 #b101)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b000011100100100 #b111)
                arg3
                (fp #b1 #b000000000000000 #b100)))
(assert (fp.leq (fp #b1 #b000000000000000 #b100)
                arg3
                (fp #b0 #b001011100001101 #b000)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111111 #b000)
                expect
                (fp #b1 #b111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111)
                expect
                (fp #b1 #b110111111001000 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
