; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
