(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11110001101110 #b101)
                arg1
                (fp #b1 #b00000000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010)
                arg1
                (fp #b0 #b00101011101101 #b101)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00011101111111 #b000)
                arg3
                (fp #b0 #b00011110001101 #b110)))
(assert (fp.leq (fp #b0 #b00011110001101 #b110)
                arg3
                (fp #b0 #b00100110111110 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
