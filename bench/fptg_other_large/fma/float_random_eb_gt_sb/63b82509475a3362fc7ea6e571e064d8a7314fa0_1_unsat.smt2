(assert (fp.leq (fp #b1 #b0111010001111 #b110)
                arg2
                (fp #b0 #b1011110110111 #b000)))
(assert (fp.leq (fp #b0 #b1011110110111 #b000)
                arg2
                (fp #b0 #b1110101100011 #b011)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1101000100100 #b110)
                arg3
                (fp #b0 #b0000000000000 #b101)))
(assert (fp.leq (fp #b0 #b0000000000000 #b101)
                arg3
                (fp #b0 #b1001100001000 #b000)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
