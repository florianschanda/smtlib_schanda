(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001011010000 #b01011111)
                arg1
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                arg1
                (fp #b0 #b111101011000 #b10100110)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110000100011 #b01110101)
                arg2
                (fp #b0 #b101011000001 #b00010000)))
(assert (fp.leq (fp #b0 #b101011000001 #b00010000)
                arg2
                (fp #b0 #b111011010110 #b01101011)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
