;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111111111111111110 #b001011010)
                arg2
                (fp #b1 #b111111111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b000000000)
                arg2
                (fp #b1 #b100011000100101101 #b000001010)))

(declare-const arg3 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b101000011110010010 #b111001100)
                arg3
                (fp #b0 #b000000000000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b010000000)
                arg3
                (fp #b0 #b111111110011111010 #b011101010)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
