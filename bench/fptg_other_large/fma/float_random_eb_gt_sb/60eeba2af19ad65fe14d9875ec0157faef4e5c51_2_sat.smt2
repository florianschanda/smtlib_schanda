(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11100100010 #b11100)
                arg1
                (fp #b0 #b00000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000)
                arg1
                (fp #b0 #b10100110010 #b01011)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10100101111 #b11010)
                arg2
                (fp #b1 #b10000000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000000101 #b00000)
                arg2
                (fp #b1 #b00101011101 #b11100)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10100111011 #b10110)
                arg3
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                arg3
                (fp #b0 #b11110100101 #b11110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01100011001 #b00110)
                expect
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                expect
                (fp #b0 #b11101001011 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
