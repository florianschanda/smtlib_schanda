(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011100000110 #b100001110)
                arg1
                (fp #b1 #b001101100010 #b011111101)))
(assert (fp.leq (fp #b1 #b001101100010 #b011111101)
                arg1
                (fp #b0 #b011101011011 #b100011101)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111111111110 #b011110010)
                arg3
                (fp #b1 #b111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000000000)
                arg3
                (fp #b1 #b110110100010 #b010111101)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111111111110 #b111101000)
                expect
                (fp #b1 #b111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000000000)
                expect
                (fp #b0 #b111000111110 #b111101110)))

(assert (= expect result))

(check-sat)
(exit)
