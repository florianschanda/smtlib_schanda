(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101001101 #b101011)
                arg1
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg1
                (fp #b0 #b1100001111 #b101110)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111110 #b110110)
                arg2
                (fp #b1 #b1111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000)
                arg2
                (fp #b0 #b1001101110 #b000110)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001100100 #b111101)
                arg3
                (fp #b0 #b0110111001 #b010010)))
(assert (fp.leq (fp #b0 #b0110111001 #b010010)
                arg3
                (fp #b0 #b1000100010 #b110001)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
