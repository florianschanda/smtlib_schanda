; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b101111001 #b001)
                arg1
                (fp #b0 #b111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111101 #b000)
                arg1
                (fp #b0 #b111111101 #b011)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001100110 #b001)
                arg3
                (fp #b0 #b100110001 #b001)))
(assert (fp.leq (fp #b0 #b100110001 #b001)
                arg3
                (fp #b0 #b110111001 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
