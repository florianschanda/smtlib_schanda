(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b100100110)
                arg1
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b1001011000 #b111100111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001111110 #b100000000)
                arg2
                (fp #b1 #b0000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b0001110001 #b100110011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101010 #b011010110)
                arg3
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                arg3
                (fp #b0 #b0101000010 #b010110011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111010 #b011101110)
                expect
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                expect
                (fp #b0 #b1111101011 #b100101111)))

(assert (= expect result))

(check-sat)
(exit)
