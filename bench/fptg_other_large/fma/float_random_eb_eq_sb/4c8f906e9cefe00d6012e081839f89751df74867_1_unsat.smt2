; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1110100101100110 #b111000000010010)
                arg1
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b1101110110101010 #b111111000100011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000001010000001 #b100100010111101)
                arg2
                (fp #b1 #b0000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b001010111010001)
                arg2
                (fp #b0 #b1111010001010101 #b011100110100110)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101110011101110 #b110010001010010)
                expect
                (fp #b0 #b0000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b001010111010001)
                expect
                (fp #b0 #b1001011110101111 #b000010001101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
