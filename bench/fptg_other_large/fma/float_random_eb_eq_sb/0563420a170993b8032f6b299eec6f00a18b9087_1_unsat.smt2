(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011001010 #b11011111)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b1 #b010000101 #b11101000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010000000 #b00000110)
                arg3
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg3
                (fp #b0 #b111010100 #b11100011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011010 #b00011011)
                expect
                (fp #b0 #b001010101 #b01100110)))
(assert (fp.leq (fp #b0 #b001010101 #b01100110)
                expect
                (fp #b0 #b110100100 #b00111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
