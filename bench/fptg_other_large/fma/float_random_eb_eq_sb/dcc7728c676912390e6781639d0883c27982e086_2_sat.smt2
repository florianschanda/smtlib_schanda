;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100010010100 #b11011000110)
                arg1
                (fp #b0 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000000)
                arg1
                (fp #b0 #b111111111101 #b00111001110)))

(declare-const arg2 (_ FloatingPoint 12 12))
