(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101010100 #b000111010)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1010111000 #b110110010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010100110 #b100000010)
                arg2
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b1101010010 #b000010000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110111 #b111001010)
                arg3
                (fp #b1 #b0000000000 #b010001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b010001001)
                arg3
                (fp #b0 #b1011101010 #b000110000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101000101 #b101111010)
                expect
                (fp #b1 #b0000000000 #b010001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b010001001)
                expect
                (fp #b0 #b0110010100 #b010010001)))

(assert (= expect result))

(check-sat)
(exit)
