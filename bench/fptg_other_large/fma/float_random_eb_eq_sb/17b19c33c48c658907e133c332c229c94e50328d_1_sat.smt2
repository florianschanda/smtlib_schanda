; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110011010001100 #b11101011010111)
                arg2
                (fp #b1 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b1 #b100000000001110 #b00000000000000)
                arg2
                (fp #b1 #b010111100111111 #b11001010111010)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100011000001010 #b00000011111000)
                arg3
                (fp #b1 #b010000101101011 #b11100101011011)))
(assert (fp.leq (fp #b1 #b010000101101011 #b11100101011011)
                arg3
                (fp #b1 #b001100100001000 #b01111011000110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
