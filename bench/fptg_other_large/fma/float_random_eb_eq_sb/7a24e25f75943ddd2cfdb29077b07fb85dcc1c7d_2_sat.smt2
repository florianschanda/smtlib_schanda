(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100110100010111 #b01001000110011)
                arg1
                (fp #b0 #b000101000010110 #b10000100101110)))
(assert (fp.leq (fp #b0 #b000101000010110 #b10000100101110)
                arg1
                (fp #b0 #b101110110111110 #b11001101001000)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100011110000 #b00111001111010)
                arg3
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                arg3
                (fp #b0 #b101010101001111 #b01100000000011)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011011111101011 #b11111110010000)
                expect
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                expect
                (fp #b0 #b010100101001011 #b00001000000000)))

(assert (= expect result))

(check-sat)
(exit)
