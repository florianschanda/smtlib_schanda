(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011110010101 #b01110011111)
                arg1
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                arg1
                (fp #b0 #b011101110100 #b11111110111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111000001 #b11000010100)
                arg3
                (fp #b1 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000001011 #b00000000000)
                arg3
                (fp #b0 #b000011100000 #b00000010010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
