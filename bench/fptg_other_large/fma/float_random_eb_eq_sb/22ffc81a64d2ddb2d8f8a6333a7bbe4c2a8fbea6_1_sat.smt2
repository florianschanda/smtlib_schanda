(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                arg3
                (fp #b1 #b010000010 #b11100100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011011 #b11110100)
                expect
                (fp #b1 #b100001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                expect
                (fp #b0 #b011101000 #b10010100)))

(assert (= expect result))

(check-sat)
