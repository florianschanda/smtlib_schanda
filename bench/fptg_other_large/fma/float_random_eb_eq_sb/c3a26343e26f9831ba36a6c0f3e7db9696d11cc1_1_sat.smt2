(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000110000110 #b00111111010)
                arg1
                (fp #b0 #b110100101001 #b10011011000)))
(assert (fp.leq (fp #b0 #b110100101001 #b10011011000)
                arg1
                (fp #b0 #b110111001001 #b00001100010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b001010111011 #b00101000000)
                arg3
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b101101110001 #b00000011000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
