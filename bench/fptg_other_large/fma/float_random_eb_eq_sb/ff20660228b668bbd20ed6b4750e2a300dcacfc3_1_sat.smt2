(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101010111111111 #b001101100011000)
                arg3
                (fp #b0 #b0000000000000000 #b110011110110001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110011110110001)
                arg3
                (fp #b0 #b1000101011110100 #b111111111101110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011111001111111 #b001011010010100)
                expect
                (fp #b0 #b0000000000000000 #b110011110110000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110011110110000)
                expect
                (fp #b0 #b1101110111011100 #b111001000000001)))

(assert (= expect result))

(check-sat)
(exit)
