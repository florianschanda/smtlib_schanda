(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0111111011110 #b100000100011)
                arg1
                (fp #b0 #b0100010001011 #b000101001110)))
(assert (fp.leq (fp #b0 #b0100010001011 #b000101001110)
                arg1
                (fp #b0 #b0101010001011 #b001000011110)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0101111001110 #b101101110110)
                arg2
                (fp #b0 #b0100000110110 #b010000101101)))
(assert (fp.leq (fp #b0 #b0100000110110 #b010000101101)
                arg2
                (fp #b0 #b0101110100000 #b001110000011)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001101001101 #b001001010101)
                expect
                (fp #b0 #b0100000110110 #b010000101101)))
(assert (fp.leq (fp #b0 #b0100000110110 #b010000101101)
                expect
                (fp #b0 #b1110001101101 #b001111011110)))

(assert (= expect result))

(check-sat)
(exit)
