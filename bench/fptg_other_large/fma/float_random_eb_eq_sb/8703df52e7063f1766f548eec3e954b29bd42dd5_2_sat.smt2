                arg3
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg3
                (fp #b0 #b0111000110 #b100001100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001101111 #b010011101)
                expect
                (fp #b0 #b1011101011 #b011110011)))
(assert (fp.leq (fp #b0 #b1011101011 #b011110011)
                expect
                (fp #b0 #b1110110000 #b010011010)))

(assert (= expect result))

(check-sat)
(exit)
