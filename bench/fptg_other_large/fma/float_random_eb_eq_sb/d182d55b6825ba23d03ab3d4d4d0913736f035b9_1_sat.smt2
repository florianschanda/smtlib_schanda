(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b0 #b10100100010 #b1010100110)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01001001000 #b1100001000)
                arg3
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg3
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00111111000 #b1010111001)
                expect
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000)))

(assert (= expect result))

(check-sat)
(exit)
