                arg2
                (fp #b1 #b000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000 #b01111101)
                arg2
                (fp #b0 #b001011010 #b01010010)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100101101 #b11000111)
                arg3
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg3
                (fp #b0 #b111111110 #b01100011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110010 #b11001011)
                expect
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                expect
                (fp #b0 #b111111101 #b00101100)))

(assert (= expect result))

(check-sat)
(exit)
