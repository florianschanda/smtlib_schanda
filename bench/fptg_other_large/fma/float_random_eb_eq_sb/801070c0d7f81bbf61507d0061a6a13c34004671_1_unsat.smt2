; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -NAN
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b110100000000 #b01010111100)
                arg1
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg1
                (fp #b0 #b100110101110 #b10000100110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001000001011 #b00110101111)
                arg3
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg3
                (fp #b0 #b111010010001 #b00101000100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
