                arg3
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg3
                (fp #b0 #b100011110 #b00011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101010 #b00011011)
                expect
                (fp #b0 #b000000000 #b00111111)))
(assert (fp.leq (fp #b0 #b000000000 #b00111111)
                expect
                (fp #b0 #b001100101 #b01011100)))

(assert (= expect result))

(check-sat)
(exit)
