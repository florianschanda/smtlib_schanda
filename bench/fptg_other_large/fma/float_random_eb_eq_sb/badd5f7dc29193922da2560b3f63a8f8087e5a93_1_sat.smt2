(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111101001 #b10010110011)
                arg2
                (fp #b1 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000001011 #b00000000000)
                arg2
                (fp #b0 #b000001101100 #b01001010011)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010001000011 #b01001001011)
                arg3
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg3
                (fp #b0 #b100101001000 #b00100001010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
