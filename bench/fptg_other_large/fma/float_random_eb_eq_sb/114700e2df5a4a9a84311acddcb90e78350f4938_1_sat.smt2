                arg2
                (fp #b0 #b11010011101011101 #b0000000000100100)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01001010101101110 #b0001101001101011)
                expect
                (fp #b0 #b01110100011101010 #b1010011101110000)))
(assert (fp.leq (fp #b0 #b01110100011101010 #b1010011101110000)
                expect
                (fp #b0 #b10100101110001100 #b0101010010100100)))

(assert (= expect result))

(check-sat)
