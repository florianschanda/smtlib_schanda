                (fp #b1 #b1001110000 #b000010100)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110100110 #b011110011)
                arg3
                (fp #b0 #b0101001010 #b101010011)))
(assert (fp.leq (fp #b0 #b0101001010 #b101010011)
                arg3
                (fp #b0 #b1101111000 #b110000011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000010000 #b011111111)
                expect
                (fp #b0 #b0111111101 #b000000001)))
(assert (fp.leq (fp #b0 #b0111111101 #b000000001)
                expect
                (fp #b0 #b1101011110 #b101100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
