(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10111101011101011 #b1110100101000110)
                arg1
                (fp #b0 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000000)
                arg1
                (fp #b0 #b10101100111101011 #b1111110110001100)))

