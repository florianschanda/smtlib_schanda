                arg2
                (fp #b0 #b00000000000000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0100100111101010)
                arg2
                (fp #b0 #b01010100100100110 #b1001000110111111)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10011001111000011 #b0001100001010100)
                expect
                (fp #b1 #b00000000000000000 #b0100100111101010)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0100100111101010)
                expect
                (fp #b0 #b01101110010100010 #b0100101001010001)))

(assert (= expect result))

(check-sat)
(exit)
