(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -LARGEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000000000000)
                arg2
                (fp #b1 #b111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111111111111)
                arg2
                (fp #b1 #b001011011101010 #b00010100101000)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
