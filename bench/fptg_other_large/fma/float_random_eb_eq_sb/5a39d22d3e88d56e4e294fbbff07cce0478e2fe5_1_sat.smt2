(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011001000 #b001110111)
                arg2
                (fp #b0 #b0000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100101010)
                arg2
                (fp #b0 #b1001000110 #b010101100)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101111100 #b001100110)
                arg3
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                arg3
                (fp #b0 #b1111010011 #b101101001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
