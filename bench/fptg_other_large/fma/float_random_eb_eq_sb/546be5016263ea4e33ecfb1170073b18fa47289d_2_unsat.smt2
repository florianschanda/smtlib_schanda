(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b1111101011 #b010101111)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000000011 #b001011110)
                arg3
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg3
                (fp #b0 #b1000011010 #b100001111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111101 #b101110100)
                expect
                (fp #b0 #b0000000000 #b010000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000001)
                expect
                (fp #b0 #b0110011111 #b111111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
