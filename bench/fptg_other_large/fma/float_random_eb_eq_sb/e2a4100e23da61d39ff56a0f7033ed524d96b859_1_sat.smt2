(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111000 #b100111101)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b0 #b1001000000 #b000000011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000001100 #b100111100)
                arg2
                (fp #b0 #b0000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100101010)
                arg2
                (fp #b0 #b1101010010 #b111011011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100110101 #b010101010)
                expect
                (fp #b1 #b0000000000 #b100101010)))
(assert (fp.leq (fp #b1 #b0000000000 #b100101010)
                expect
                (fp #b0 #b1101101010 #b101110100)))

(assert (= expect result))

(check-sat)
(exit)
