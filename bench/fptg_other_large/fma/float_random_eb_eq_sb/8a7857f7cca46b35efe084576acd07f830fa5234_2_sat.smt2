(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100101101 #b110011100)
                arg1
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b1011100110 #b000101100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110011101 #b101011100)
                arg2
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b1 #b1100100111 #b000000011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111101101 #b001000111)
                arg3
                (fp #b1 #b0010110110 #b101111111)))
(assert (fp.leq (fp #b1 #b0010110110 #b101111111)
                arg3
                (fp #b0 #b1010111011 #b010111100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101101011 #b010101001)
                expect
                (fp #b0 #b0101101000 #b001010101)))
(assert (fp.leq (fp #b0 #b0101101000 #b001010101)
                expect
                (fp #b0 #b0111010100 #b010100100)))

(assert (= expect result))

(check-sat)
(exit)
