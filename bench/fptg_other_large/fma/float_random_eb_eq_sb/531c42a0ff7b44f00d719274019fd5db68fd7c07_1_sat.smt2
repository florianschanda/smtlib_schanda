; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011110100000010 #b000000101110101)
                arg1
                (fp #b1 #b0000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010010100000101)
                arg1
                (fp #b0 #b1000000011111010 #b101001001110000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100001000110111 #b011100011101001)
                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b0 #b1000101100011110 #b001011000011000)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110010100110 #b101101000001000)
                expect
                (fp #b1 #b1010010000010100 #b010001111001001)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001001)
                expect
                (fp #b1 #b1001111011001101 #b010000010001110)))

(assert (= expect result))

(check-sat)
(exit)
