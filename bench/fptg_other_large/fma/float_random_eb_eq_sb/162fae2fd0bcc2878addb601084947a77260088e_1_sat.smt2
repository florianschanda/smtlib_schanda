(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg2
                (fp #b1 #b101110101 #b10011110)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011110 #b10011010)
                arg3
                (fp #b1 #b100001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                arg3
                (fp #b1 #b010111000 #b00101111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011101 #b11100110)
                expect
                (fp #b1 #b100001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                expect
                (fp #b0 #b011011100 #b01000011)))

(assert (= expect result))

(check-sat)
(exit)
