(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                arg1
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                arg1
                (fp #b0 #b101001000 #b11010111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001011110 #b01001001)
                arg2
                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b111100111 #b11010000)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b111010111 #b10111011)
                arg3
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                arg3
                (fp #b0 #b110100111 #b11100101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011001 #b10101100)
                expect
                (fp #b1 #b011111111 #b00001100)))
(assert (fp.leq (fp #b1 #b011111111 #b00001100)
                expect
                (fp #b1 #b000110000 #b00101000)))

(assert (= expect result))

(check-sat)
(exit)
