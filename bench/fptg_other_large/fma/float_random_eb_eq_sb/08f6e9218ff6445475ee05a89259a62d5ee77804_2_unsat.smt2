(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b110010000 #b10001110)
                arg1
                (fp #b0 #b111000010 #b00111001)))
(assert (fp.leq (fp #b0 #b111000010 #b00111001)
                arg1
                (fp #b0 #b111101000 #b10100110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000000011 #b11010001)
                arg3
                (fp #b0 #b011011000 #b00110011)))
(assert (fp.leq (fp #b0 #b011011000 #b00110011)
                arg3
                (fp #b0 #b100011001 #b01111111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
