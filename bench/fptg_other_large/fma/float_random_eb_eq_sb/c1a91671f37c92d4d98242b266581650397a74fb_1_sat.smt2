(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000100100 #b00001011)
                arg1
                (fp #b0 #b000011000 #b11110110)))
(assert (fp.leq (fp #b0 #b000011000 #b11110110)
                arg1
                (fp #b0 #b010100001 #b00111011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000110 #b00111110)
                arg2
                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b001110101 #b01111010)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011010111 #b00100100)
                expect
                (fp #b1 #b000000000 #b01000010)))
(assert (fp.leq (fp #b1 #b000000000 #b01000010)
                expect
                (fp #b0 #b011100001 #b01110111)))

(assert (= expect result))

(check-sat)
(exit)
