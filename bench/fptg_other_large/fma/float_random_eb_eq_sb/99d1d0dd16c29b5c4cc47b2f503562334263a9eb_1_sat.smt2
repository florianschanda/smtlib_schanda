(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01010001101 #b1000011101)
                arg1
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b01101101011 #b1011101011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111110110 #b0000100101)
                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b0 #b01100001110 #b1000010000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b10011101111 #b1011100100)
                expect
                (fp #b0 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b0 #b11110001011 #b0011101010)
                expect
                (fp #b0 #b11110011001 #b1110001001)))

(assert (= expect result))

(check-sat)
(exit)
