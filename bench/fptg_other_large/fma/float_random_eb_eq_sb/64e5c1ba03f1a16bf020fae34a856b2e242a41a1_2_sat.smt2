;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000111100000 #b11100001010000)
                arg1
                (fp #b0 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01000000000000)
                arg1
                (fp #b0 #b000001100100111 #b10011011100000)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111010111100 #b00000111001011)
                arg2
                (fp #b1 #b100100000101011 #b10001111001110)))
(assert (fp.leq (fp #b1 #b100100000101011 #b10001111001110)
                arg2
                (fp #b0 #b010001011010000 #b01001110010001)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011000111101100 #b10111110110001)
                expect
                (fp #b0 #b100100000101011 #b10001111001110)))
(assert (fp.leq (fp #b0 #b100100000101011 #b10001111001110)
                expect
                (fp #b0 #b110111101111101 #b00001010011101)))

(assert (= expect result))

(check-sat)
(exit)
