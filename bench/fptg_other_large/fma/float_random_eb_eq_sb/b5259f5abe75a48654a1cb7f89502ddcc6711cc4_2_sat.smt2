(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg2
                (fp #b0 #b010111001 #b10110101)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010011 #b11000011)
                arg3
                (fp #b0 #b110100100 #b10011111)))
(assert (fp.leq (fp #b0 #b110100100 #b10011111)
                arg3
                (fp #b0 #b111010100 #b00011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100100010 #b10101111)
                expect
                (fp #b0 #b110100100 #b10100000)))
(assert (fp.leq (fp #b0 #b110100100 #b10100000)
                expect
                (fp #b0 #b111010101 #b01111001)))

(assert (= expect result))

(check-sat)
(exit)
