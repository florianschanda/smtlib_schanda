(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0011001010111111 #b110110001111111)
                arg3
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg3
                (fp #b0 #b1110011100000110 #b010111111110001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0011101100100010 #b000010010000011)
                expect
                (fp #b0 #b1011111101000100 #b010101110100001)))
(assert (fp.leq (fp #b0 #b1011111101000100 #b010101110100001)
                expect
                (fp #b0 #b1101000111001000 #b111111101001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
