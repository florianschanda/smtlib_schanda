;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011000011111100 #b000100011001110)
                arg1
                (fp #b0 #b1001111110100001 #b101000110011100)))
(assert (fp.leq (fp #b0 #b1001111110100001 #b101000110011100)
                arg1
                (fp #b0 #b1110000111010011 #b100101000111000)))

(declare-const arg2 (_ FloatingPoint 16 16))
