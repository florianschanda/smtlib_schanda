(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000010001101011 #b111000101000100)
                arg1
                (fp #b1 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b1 #b0010000011101110 #b010110110111000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000010000101101 #b111111000000111)
                arg2
                (fp #b1 #b0001100001101011 #b001110100011101)))
(assert (fp.leq (fp #b1 #b0001100001101011 #b001110100011101)
                arg2
                (fp #b0 #b1001011100011110 #b011010010010111)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
