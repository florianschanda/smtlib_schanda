; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1101000111101 #b001010100011)
                arg1
                (fp #b1 #b0000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000000000)
                arg1
                (fp #b0 #b1011011010111 #b111111110111)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0001100011111 #b101100000111)
                arg2
                (fp #b1 #b0000000000000 #b111100100110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111100100110)
                arg2
                (fp #b0 #b0000001000001 #b000001001110)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1011110110011 #b001101011110)
                expect
                (fp #b1 #b0000000000000 #b111100100110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111100100110)
                expect
                (fp #b0 #b1111100011010 #b001000011000)))

(assert (= expect result))

(check-sat)
(exit)
