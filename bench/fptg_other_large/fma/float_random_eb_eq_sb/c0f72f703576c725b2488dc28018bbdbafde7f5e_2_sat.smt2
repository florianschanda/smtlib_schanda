                arg2
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg2
                (fp #b0 #b11100011001 #b0100010010)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100110010 #b0111111110)
                arg3
                (fp #b0 #b00000000000 #b1000001110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000001110)
                arg3
                (fp #b0 #b10011110000 #b0101011110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
