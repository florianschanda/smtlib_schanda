; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
