;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111000011 #b0010101001)
                arg1
                (fp #b0 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                arg1
                (fp #b0 #b10000101100 #b0110000011)))

(declare-const arg2 (_ FloatingPoint 11 11))
