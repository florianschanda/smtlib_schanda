(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001001011 #b0000000100)
                arg1
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg1
                (fp #b0 #b00010100101 #b0101011000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111011011 #b1111111110)
                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b0 #b11100001001 #b0110111100)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
