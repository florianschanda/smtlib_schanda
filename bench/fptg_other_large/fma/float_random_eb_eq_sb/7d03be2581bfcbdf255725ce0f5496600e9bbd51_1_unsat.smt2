;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00001011011 #b0011110010)
                arg1
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b11100001010 #b0110100011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111010000 #b0100001110)
                arg2
                (fp #b1 #b00000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000101100)
                arg2
                (fp #b0 #b01110001011 #b0010011001)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000111001 #b1111001110)
                expect
                (fp #b1 #b00000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000101100)
                expect
                (fp #b0 #b11100110101 #b1011101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
