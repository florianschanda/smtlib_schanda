(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000111011111001110 #b10110100001100100)
                arg1
                (fp #b1 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000000000000)
                arg1
                (fp #b0 #b111000110100010000 #b01100100110011101)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
