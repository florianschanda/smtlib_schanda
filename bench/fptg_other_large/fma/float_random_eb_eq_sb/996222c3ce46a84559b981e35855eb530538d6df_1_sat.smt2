(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110010000 #b10101001)
                arg1
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg1
                (fp #b0 #b110011110 #b10001000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000001 #b00000110)
                arg2
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                arg2
                (fp #b0 #b111111111 #b00000000)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000101101 #b00001110)
                arg3
                (fp #b1 #b000000000 #b11001101)))
(assert (fp.leq (fp #b1 #b000000000 #b11001101)
                arg3
                (fp #b0 #b011001101 #b01101000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000010010 #b10010000)
                expect
                (fp #b1 #b000000000 #b11001101)))
(assert (fp.leq (fp #b1 #b000000000 #b11001101)
                expect
                (fp #b0 #b010001011 #b00011110)))

(assert (= expect result))

(check-sat)
(exit)
