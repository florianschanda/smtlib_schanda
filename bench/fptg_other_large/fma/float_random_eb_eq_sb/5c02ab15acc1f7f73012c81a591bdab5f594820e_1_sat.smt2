                arg2
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg2
                (fp #b0 #b001010010 #b10111101)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010001 #b00011011)
                arg3
                (fp #b0 #b011011000 #b00110011)))
(assert (fp.leq (fp #b0 #b011011000 #b00110011)
                arg3
                (fp #b0 #b100100101 #b01000100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100100010 #b11001000)
                expect
                (fp #b0 #b011011000 #b00110010)))
(assert (fp.leq (fp #b0 #b011011000 #b00110010)
                expect
                (fp #b0 #b110000001 #b01010011)))

(assert (= expect result))

(check-sat)
(exit)
