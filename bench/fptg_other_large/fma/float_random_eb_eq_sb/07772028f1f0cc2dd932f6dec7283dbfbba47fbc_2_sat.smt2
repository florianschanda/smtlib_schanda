;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000111 #b001010101)
                arg1
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg1
                (fp #b0 #b0111000001 #b011011101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011011 #b101010101)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b0100101000 #b111011111)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101101 #b001000000)
                arg3
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                arg3
                (fp #b1 #b0111110011 #b000010010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110010 #b011111011)
                expect
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                expect
                (fp #b0 #b1101010100 #b001111010)))

(assert (= expect result))

(check-sat)
(exit)
