; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b01011111010100110 #b0111100011110100)
                arg2
                (fp #b0 #b10000000000010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b10000000000010000 #b0000000000000000)
                arg2
                (fp #b0 #b11101110010110101 #b0011100110111101)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
