                arg2
                (fp #b1 #b101001111100 #b10100010001)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b0 #b011100001100 #b11010001110)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001011010000 #b01001110010)
                arg3
                (fp #b1 #b000000000000 #b10010100101)))
(assert (fp.leq (fp #b1 #b000000000000 #b10010100101)
                arg3
                (fp #b0 #b011110010100 #b01011111101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
