; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +NAN
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00100000100110101 #b1010100101001100)
                arg1
                (fp #b0 #b10000000000010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b10000000000010000 #b0000000000000000)
                arg1
                (fp #b0 #b11101111100100000 #b0101010001100001)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
