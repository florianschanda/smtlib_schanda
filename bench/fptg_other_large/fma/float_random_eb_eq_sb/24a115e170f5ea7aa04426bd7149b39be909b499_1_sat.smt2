; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b111000100010 #b11110111101)
                arg1
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                arg1
                (fp #b0 #b111111111111 #b00000000000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
