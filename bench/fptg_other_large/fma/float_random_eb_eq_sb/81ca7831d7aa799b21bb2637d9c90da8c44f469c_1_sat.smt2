(assert (fp.leq (fp #b0 #b100000000000010001 #b00000000000000000)
                arg3
                (fp #b0 #b100110101000011100 #b11011110111101000)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
