; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b01010010001)
                arg1
                (fp #b1 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000000)
                arg1
                (fp #b0 #b001000111101 #b00000001111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101100011 #b00101101010)
                arg2
                (fp #b1 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000)
                arg2
                (fp #b0 #b110000100000 #b01001111111)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011101011110 #b10110010101)
                arg3
                (fp #b0 #b000000000000 #b11010010000)))
(assert (fp.leq (fp #b0 #b000000000000 #b11010010000)
                arg3
                (fp #b0 #b100011101101 #b01000000011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010001000001 #b10110111011)
                expect
                (fp #b0 #b011111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111111101 #b00000000000)
                expect
                (fp #b0 #b101010110110 #b00101010101)))

(assert (= expect result))

(check-sat)
(exit)
