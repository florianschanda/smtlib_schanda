; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100111010111101 #b001110111010011)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b0 #b1001110010001000 #b111111100011011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0011010101111101 #b011011011011101)
                arg3
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg3
                (fp #b0 #b0010101001111000 #b001001010000001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
