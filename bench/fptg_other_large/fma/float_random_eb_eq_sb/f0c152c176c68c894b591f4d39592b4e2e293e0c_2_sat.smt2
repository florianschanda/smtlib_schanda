                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b0 #b1010000110111110 #b001011110101110)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1010110011101000 #b110100010101111)
                arg3
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg3
                (fp #b0 #b0110101100111011 #b100001000110010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000000011000000 #b011101001110000)
                expect
                (fp #b0 #b0100010000111111 #b101111010100010)))
(assert (fp.leq (fp #b0 #b0100010000111111 #b101111010100010)
                expect
                (fp #b0 #b0101011101111010 #b001100111100110)))

(assert (= expect result))

(check-sat)
(exit)
