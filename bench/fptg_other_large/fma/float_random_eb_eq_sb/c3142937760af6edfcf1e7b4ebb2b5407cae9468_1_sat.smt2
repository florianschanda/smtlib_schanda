                (fp #b0 #b11111111111 #b0000000000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111100 #b0011101011)
                arg3
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg3
                (fp #b0 #b10011000011 #b1000101011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100000100 #b0110000100)
                expect
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                expect
                (fp #b0 #b11001111000 #b1110000000)))

(assert (= expect result))

(check-sat)
(exit)
