(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011011000110 #b11000010100)
                arg1
                (fp #b1 #b000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011000100)
                arg1
                (fp #b0 #b110001001010 #b11000010101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                arg3
                (fp #b1 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111111)
                arg3
                (fp #b1 #b101000010011 #b11000110011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                expect
                (fp #b1 #b111111111110 #b11111111110)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111110)
                expect
                (fp #b0 #b001001011111 #b11111111000)))

(assert (= expect result))

(check-sat)
(exit)
