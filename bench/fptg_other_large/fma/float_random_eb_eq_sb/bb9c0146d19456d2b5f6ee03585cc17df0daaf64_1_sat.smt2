                arg2
                (fp #b0 #b10000110010100100 #b0101111001000101)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11001101100001010 #b1100111011111010)
                expect
                (fp #b0 #b10100100000100111 #b1000111100101000)))
(assert (fp.leq (fp #b0 #b10100100000100111 #b1000111100101000)
                expect
                (fp #b0 #b11110011100011100 #b1101101011011011)))

(assert (= expect result))

(check-sat)
