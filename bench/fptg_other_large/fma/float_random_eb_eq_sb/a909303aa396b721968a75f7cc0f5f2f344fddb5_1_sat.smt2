(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000000100 #b0001100000)
                arg1
                (fp #b0 #b10011010111 #b1010011001)))
(assert (fp.leq (fp #b0 #b10011010111 #b1010011001)
                arg1
                (fp #b0 #b11111110100 #b1101010101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00011010111 #b1100111100)
                arg2
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                arg2
                (fp #b0 #b01011111110 #b0010111111)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111101100 #b1110001111)
                expect
                (fp #b0 #b00011011001 #b1000000110)))
(assert (fp.leq (fp #b0 #b00011011001 #b1000000110)
                expect
                (fp #b0 #b10011110000 #b1000000001)))

(assert (= expect result))

(check-sat)
(exit)
