(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0011010101011 #b110111000011)
                arg2
                (fp #b1 #b0010010111010 #b110111100110)))
(assert (fp.leq (fp #b1 #b0010010111010 #b110111100110)
                arg2
                (fp #b1 #b0010000101001 #b000000111001)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0110000101101 #b011100000011)
                arg3
                (fp #b0 #b1000000001100 #b000000000000)))
(assert (fp.leq (fp #b0 #b1000000001100 #b000000000000)
                arg3
                (fp #b0 #b1001001001010 #b001011011001)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
