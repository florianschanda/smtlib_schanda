(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101110111010101 #b11111001000000)
                arg3
                (fp #b1 #b010000101101011 #b11100101011011)))
(assert (fp.leq (fp #b1 #b010000101101011 #b11100101011011)
                arg3
                (fp #b0 #b101001001011111 #b00110110101101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
