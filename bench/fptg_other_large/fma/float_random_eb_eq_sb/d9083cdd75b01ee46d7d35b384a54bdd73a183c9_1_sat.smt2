(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001111011 #b101101100)
                arg1
                (fp #b1 #b0000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b0000000000 #b100100111)
                arg1
                (fp #b0 #b1100111100 #b111101010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100111 #b000100011)
                arg3
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                arg3
                (fp #b0 #b1101011111 #b011110100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001011 #b110010011)
                expect
                (fp #b0 #b1011011101 #b000010111)))
(assert (fp.leq (fp #b0 #b1011011101 #b000010111)
                expect
                (fp #b0 #b1100111101 #b000100101)))

(assert (= expect result))

(check-sat)
(exit)
