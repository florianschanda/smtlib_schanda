; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10111100001011001 #b0011010000100010)
                arg2
                (fp #b1 #b10100100000100111 #b1000111100101000)))
(assert (fp.leq (fp #b1 #b10100100000100111 #b1000111100101000)
                arg2
                (fp #b0 #b00101001110111001 #b0001000000110001)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
