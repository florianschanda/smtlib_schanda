(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +NAN
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010111001 #b010111100)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1100101000 #b110100010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
