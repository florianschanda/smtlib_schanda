(assert (fp.leq (fp #b1 #b11111111111 #b0000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111)
                arg2
                (fp #b1 #b10010001001 #b0111000011)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011001010 #b1011111010)
                arg3
                (fp #b1 #b00000000000 #b1100010101)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010101)
                arg3
                (fp #b0 #b10111111000 #b1100000101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
