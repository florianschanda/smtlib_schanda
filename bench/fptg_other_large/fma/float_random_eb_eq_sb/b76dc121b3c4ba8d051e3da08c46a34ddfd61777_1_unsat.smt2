(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000110011 #b010111110)
                arg2
                (fp #b1 #b0110100111 #b001011001)))
(assert (fp.leq (fp #b1 #b0110100111 #b001011001)
                arg2
                (fp #b0 #b1101110010 #b011011011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1000010001 #b111010001)
                arg3
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg3
                (fp #b0 #b1001011001 #b101111011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
