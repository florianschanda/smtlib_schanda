(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010101000010001 #b110011110111110)
                arg1
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg1
                (fp #b0 #b1111111111111110 #b010111011001100)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011001001011111 #b101001011110001)
                arg2
                (fp #b1 #b0000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b001010111010001)
                arg2
                (fp #b0 #b0110001101101100 #b111111001111010)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000110101101100 #b100101101000001)
                expect
                (fp #b1 #b0111111111111100 #b010111010000111)))
(assert (fp.leq (fp #b1 #b0111111111111100 #b010111010000111)
                expect
                (fp #b0 #b0110101110101001 #b101011110101000)))

(assert (= expect result))

(check-sat)
(exit)
