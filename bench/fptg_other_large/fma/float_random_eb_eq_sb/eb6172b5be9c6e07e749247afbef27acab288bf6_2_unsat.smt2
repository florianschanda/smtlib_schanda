                arg3
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                arg3
                (fp #b0 #b1100110110 #b011001101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110111100 #b011010111)
                expect
                (fp #b0 #b1011011101 #b000011001)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011001)
                expect
                (fp #b0 #b1100000001 #b101100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
