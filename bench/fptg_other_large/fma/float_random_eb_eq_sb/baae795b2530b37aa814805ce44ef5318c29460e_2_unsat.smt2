                (fp #b0 #b101000111 #b00011111)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010010001 #b10100010)
                arg3
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg3
                (fp #b0 #b100101101 #b01110101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001010010 #b11111010)
                expect
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                expect
                (fp #b0 #b001111000 #b01111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
