                arg2
                (fp #b0 #b101101111111100000 #b00100100001010010)))

(declare-const arg3 (_ FloatingPoint 18 18))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100110001101001100 #b11101101100011000)
                expect
                (fp #b0 #b011101000111010100 #b01001110111000011)))
(assert (fp.leq (fp #b0 #b011101000111010100 #b01001110111000011)
                expect
                (fp #b0 #b111010011001001000 #b11110101000110001)))

(assert (= expect result))

