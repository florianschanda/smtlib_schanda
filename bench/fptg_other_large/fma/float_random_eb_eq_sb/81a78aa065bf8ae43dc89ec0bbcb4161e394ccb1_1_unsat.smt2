; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010111101010 #b0011010101001)
                arg2
                (fp #b0 #b00000000000000 #b0010100010010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0010100010010)
                arg2
                (fp #b0 #b11001000110101 #b0011101010010)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00000011001011 #b0001011110001)
                arg3
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg3
                (fp #b0 #b00010010110001 #b1010011001010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
