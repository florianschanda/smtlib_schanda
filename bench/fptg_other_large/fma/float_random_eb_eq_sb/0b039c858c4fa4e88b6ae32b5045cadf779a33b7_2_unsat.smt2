(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b110111100100111 #b10010001001111)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010000001000100 #b11111100111100)
                expect
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                expect
                (fp #b0 #b010011011010010 #b01110111011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
