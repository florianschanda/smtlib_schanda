(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101011110 #b1011100010)
                arg1
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00000111110 #b0111111111)
                arg2
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                arg2
                (fp #b0 #b01001111111 #b1011101000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100010010 #b0111100011)
                expect
                (fp #b0 #b10000000000 #b1101001101)))
(assert (fp.leq (fp #b0 #b10000000000 #b1101001101)
                expect
                (fp #b0 #b10100100111 #b0100010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
