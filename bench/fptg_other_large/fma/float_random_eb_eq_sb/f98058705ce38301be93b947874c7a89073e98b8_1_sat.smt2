                arg2
                (fp #b0 #b0100111100000101 #b000100110100001)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1110110000100110 #b000110001100011)
                arg3
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg3
                (fp #b0 #b1101101010110001 #b110010011011100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010001100100010 #b011010111011001)
                expect
                (fp #b0 #b0001111110100010 #b110111110010010)))
(assert (fp.leq (fp #b0 #b0001111110100010 #b110111110010010)
                expect
                (fp #b0 #b1011110111001001 #b111101111001100)))

(assert (= expect result))

(check-sat)
(exit)
