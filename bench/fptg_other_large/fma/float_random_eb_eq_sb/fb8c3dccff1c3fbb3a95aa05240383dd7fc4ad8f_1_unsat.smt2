(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110101101 #b1101101101)
                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b1 #b10000100110 #b0001010111)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011010011 #b1001010001)
                arg3
                (fp #b1 #b01100111110 #b0111011110)))
(assert (fp.leq (fp #b1 #b01100111110 #b0111011110)
                arg3
                (fp #b0 #b00101111001 #b1011110101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
