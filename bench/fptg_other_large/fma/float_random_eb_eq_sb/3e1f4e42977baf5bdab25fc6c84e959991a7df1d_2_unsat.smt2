; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110110 #b10111001)
                arg1
                (fp #b1 #b000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000 #b00010010)
                arg1
                (fp #b0 #b111011000 #b10000011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010110001 #b00010100)
                arg3
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg3
                (fp #b0 #b000000100 #b10000111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010001000 #b11000000)
                expect
                (fp #b1 #b000000000 #b01000001)))
(assert (fp.leq (fp #b1 #b000000000 #b01000001)
                expect
                (fp #b0 #b100101010 #b01110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
