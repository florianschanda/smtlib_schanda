; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111001011 #b01110101110)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b0 #b000001100110 #b00111001000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110001011 #b11000000110)
                arg3
                (fp #b1 #b010101011010 #b01001111000)))
(assert (fp.leq (fp #b1 #b010101011010 #b01001111000)
                arg3
                (fp #b1 #b000001101101 #b11101101100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110000111 #b00001111010)
                expect
                (fp #b1 #b010110101111 #b00001110101)))
(assert (fp.leq (fp #b1 #b010110101111 #b00001110101)
                expect
                (fp #b0 #b000110010000 #b00010100000)))

(assert (= expect result))

(check-sat)
(exit)
