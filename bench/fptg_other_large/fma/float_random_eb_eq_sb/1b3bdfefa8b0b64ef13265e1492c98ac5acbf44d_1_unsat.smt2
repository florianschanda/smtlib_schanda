(assert (fp.leq (fp #b0 #b01101101010011 #b0001001111011)
                arg3
                (fp #b0 #b11011111000110 #b1110101011000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
