(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111000000 #b101011111)
                arg1
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg1
                (fp #b0 #b1000001101 #b100000001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110001111 #b110000101)
                arg2
                (fp #b0 #b0011101101 #b011110011)))
(assert (fp.leq (fp #b0 #b0011101101 #b011110011)
                arg2
                (fp #b0 #b0111011100 #b111111000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010010000 #b110111010)
                expect
                (fp #b1 #b0011110111 #b011110100)))
(assert (fp.leq (fp #b1 #b0011110111 #b011110100)
                expect
                (fp #b0 #b1001111100 #b010110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
