                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                arg2
                (fp #b0 #b111111111 #b00000000)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111010 #b11111010)
                arg3
                (fp #b0 #b110100100 #b10011111)))
(assert (fp.leq (fp #b0 #b110100100 #b10011111)
                arg3
                (fp #b0 #b111000000 #b01100110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
