; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101000010000 #b100100000011)
                arg1
                (fp #b1 #b1011101111000 #b000110000100)))
(assert (fp.leq (fp #b1 #b1011101111000 #b000110000100)
                arg1
                (fp #b1 #b1000110111001 #b110001010011)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1011001000000 #b001111001100)
                arg3
                (fp #b1 #b0000000000000 #b101110111110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b101110111110)
                arg3
                (fp #b0 #b0110001111100 #b001010011111)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111110000100 #b100001111000)
                expect
                (fp #b1 #b1111011110001 #b001100101101)))
(assert (fp.leq (fp #b1 #b1111011110001 #b001100101101)
                expect
                (fp #b1 #b0110001100111 #b000110010111)))

(assert (= expect result))

(check-sat)
(exit)
