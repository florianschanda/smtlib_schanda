                arg2
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b1010010000 #b001111111)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110011110 #b110000110)
                arg3
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg3
                (fp #b0 #b0110110010 #b011011001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100111001 #b101001110)
                expect
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                expect
                (fp #b0 #b0111111001 #b101111111)))

(assert (= expect result))

(check-sat)
(exit)
