                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg2
                (fp #b0 #b111100010001 #b00111110011)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000110101100 #b01001101110)
                arg3
                (fp #b0 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000000000)
                arg3
                (fp #b0 #b100101011100 #b10010111001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010011010 #b00111010010)
                expect
                (fp #b1 #b011011100011 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011100011 #b00000111010)
                expect
                (fp #b1 #b010110001000 #b00101000001)))

(assert (= expect result))

(check-sat)
(exit)
