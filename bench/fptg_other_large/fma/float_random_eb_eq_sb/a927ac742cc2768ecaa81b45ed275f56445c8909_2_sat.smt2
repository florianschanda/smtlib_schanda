(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100011000111010 #b010111111001111)
                arg1
                (fp #b1 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b0 #b1111000001110000 #b100001111101000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111111111011 #b001010000011001)
                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b1 #b0011000001000110 #b100111100101010)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1001010111100101 #b000101110110111)
                expect
                (fp #b0 #b1010010000100100 #b010001111001010)))
(assert (fp.leq (fp #b0 #b1010010000100100 #b010001111001010)
                expect
                (fp #b0 #b1101101000011000 #b010000001100101)))

(assert (= expect result))

(check-sat)
(exit)
