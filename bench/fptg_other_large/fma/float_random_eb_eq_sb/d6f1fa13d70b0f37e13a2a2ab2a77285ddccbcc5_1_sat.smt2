(assert (fp.leq (fp #b1 #b110110111111110 #b00000001001111)
                arg1
                (fp #b1 #b101110111000001 #b01000011110110)))
(assert (fp.leq (fp #b1 #b101110111000001 #b01000011110110)
                arg1
                (fp #b1 #b001010010101111 #b11011000111100)))

