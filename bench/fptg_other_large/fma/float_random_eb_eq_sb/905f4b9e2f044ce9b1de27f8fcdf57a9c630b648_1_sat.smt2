(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00001111111101 #b1111111011111)
                arg1
                (fp #b1 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000000000)
                arg1
                (fp #b0 #b01000001110100 #b0111111011110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010110011101 #b1011110110101)
                arg2
                (fp #b1 #b11000001100001 #b0001111011101)))
(assert (fp.leq (fp #b1 #b11000001100001 #b0001111011101)
                arg2
                (fp #b0 #b01111111100000 #b1101111111111)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101110110110 #b0100010010110)
                expect
                (fp #b0 #b11000001100001 #b0001111011101)))
(assert (fp.leq (fp #b0 #b11000001100001 #b0001111011101)
                expect
                (fp #b0 #b11100111011101 #b0001100001011)))

(assert (= expect result))

(check-sat)
(exit)
