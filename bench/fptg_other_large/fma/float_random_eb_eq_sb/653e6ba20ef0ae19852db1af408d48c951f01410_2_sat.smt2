(assert (fp.leq (fp #b0 #b001000111111 #b10110001011)
                arg2
                (fp #b0 #b001011010000 #b01110110011)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111110 #b11000110000)
                arg3
                (fp #b1 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000000)
                arg3
                (fp #b0 #b011101011111 #b01101011111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111110 #b10100111111)
                expect
                (fp #b1 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000000)
                expect
                (fp #b1 #b100000001000 #b10000101000)))

(assert (= expect result))

(check-sat)
(exit)
