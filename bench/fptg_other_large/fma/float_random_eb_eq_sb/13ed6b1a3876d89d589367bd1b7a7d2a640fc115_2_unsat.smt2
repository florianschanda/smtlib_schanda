(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b0 #b1001110001 #b001010011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1010100110 #b101101111)
                arg3
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                arg3
                (fp #b0 #b1011000010 #b101001001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110010110 #b100110000)
                expect
                (fp #b1 #b0101101010 #b000110111)))
(assert (fp.leq (fp #b1 #b0101101010 #b000110111)
                expect
                (fp #b1 #b0011011000 #b000010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
