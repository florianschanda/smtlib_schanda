; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -LARGEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111)
                arg2
                (fp #b0 #b01001000110 #b0000011101)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
