(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b1001001110100 #b011011101101)
                arg1
                (fp #b0 #b1111111111101 #b000000000000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000000000000)
                arg1
                (fp #b0 #b1111111111110 #b010011001111)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0011110111110 #b000001001010)
                arg2
                (fp #b0 #b0100000110110 #b010000101101)))
(assert (fp.leq (fp #b0 #b0100000110110 #b010000101101)
                arg2
                (fp #b0 #b0111111111111 #b011010011000)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0100100100010 #b000010111100)
                expect
                (fp #b0 #b1100000110100 #b010000101110)))
(assert (fp.leq (fp #b0 #b1100000110100 #b010000101110)
                expect
                (fp #b0 #b1100100000001 #b111001000101)))

(assert (= expect result))

(check-sat)
(exit)
