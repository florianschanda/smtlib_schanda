                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b1 #b00001111110 #b1001101101)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000011100 #b1011010110)
                arg3
                (fp #b1 #b00000000000 #b1100010101)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010101)
                arg3
                (fp #b0 #b01011010011 #b0011100101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
