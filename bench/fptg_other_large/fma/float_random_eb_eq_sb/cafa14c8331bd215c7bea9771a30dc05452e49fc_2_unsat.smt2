;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011001111 #b00100100)
                arg1
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg1
                (fp #b0 #b111111110 #b00101000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100100 #b00110011)
                arg2
                (fp #b1 #b010000111 #b11101000)))
(assert (fp.leq (fp #b1 #b010000111 #b11101000)
                arg2
                (fp #b0 #b111110101 #b00110010)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101001 #b10111001)
                expect
                (fp #b1 #b110000101 #b11101001)))
(assert (fp.leq (fp #b1 #b110000101 #b11101001)
                expect
                (fp #b1 #b100010010 #b10101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
