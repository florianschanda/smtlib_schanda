; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0100100111000 #b001001001011)
                arg2
                (fp #b0 #b0100000110110 #b010000101101)))
(assert (fp.leq (fp #b0 #b0100000110110 #b010000101101)
                arg2
                (fp #b0 #b0111111101110 #b110011110101)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1000100111000 #b011011010100)
                arg3
                (fp #b0 #b0000000000000 #b000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000000)
                arg3
                (fp #b0 #b1011011110011 #b010000010110)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
