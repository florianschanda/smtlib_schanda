(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000000110 #b100011110)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b0 #b0000000101 #b011010110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1010010010 #b111000101)
                arg3
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                arg3
                (fp #b0 #b1011111000 #b100011010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000111 #b010110010)
                expect
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                expect
                (fp #b0 #b1100101100 #b000010100)))

(assert (= expect result))

(check-sat)
(exit)
