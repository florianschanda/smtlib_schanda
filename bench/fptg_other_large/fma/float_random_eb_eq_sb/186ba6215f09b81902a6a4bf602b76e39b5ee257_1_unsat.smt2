; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000100111100 #b0100000101100)
                arg2
                (fp #b1 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000000)
                arg2
                (fp #b0 #b11010010000011 #b1001110001000)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011101110010 #b0101110101001)
                arg3
                (fp #b1 #b10010100111111 #b0100010101000)))
(assert (fp.leq (fp #b1 #b10010100111111 #b0100010101000)
                arg3
                (fp #b0 #b01111100010001 #b0011011011001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
