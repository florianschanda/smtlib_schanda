; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1000000000 #b000001000)
                arg1
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg1
                (fp #b0 #b1111010101 #b001000111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011111101 #b001101011)
                arg2
                (fp #b0 #b0011101101 #b011110011)))
(assert (fp.leq (fp #b0 #b0011101101 #b011110011)
                arg2
                (fp #b0 #b1101110100 #b001110000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110001000 #b001101011)
                arg3
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                arg3
                (fp #b1 #b0110100111 #b001111010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101000100 #b101001100)
                expect
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                expect
                (fp #b0 #b0110001101 #b011110110)))

(assert (= expect result))

(check-sat)
(exit)
