(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100001111 #b100100001)
                arg1
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg1
                (fp #b0 #b1101101010 #b000000111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000101011 #b110111010)
                arg2
                (fp #b1 #b0110100111 #b001011001)))
(assert (fp.leq (fp #b1 #b0110100111 #b001011001)
                arg2
                (fp #b0 #b1000101111 #b011010011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100111010 #b111011111)
                expect
                (fp #b1 #b0110110001 #b001011001)))
(assert (fp.leq (fp #b1 #b0110110001 #b001011001)
                expect
                (fp #b0 #b0110101000 #b101110000)))

(assert (= expect result))

(check-sat)
(exit)
