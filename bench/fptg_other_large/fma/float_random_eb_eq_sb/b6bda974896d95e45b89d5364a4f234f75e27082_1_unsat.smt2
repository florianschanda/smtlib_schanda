;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110011000 #b1000000010)
                arg1
                (fp #b1 #b10011111111 #b1001100110)))
(assert (fp.leq (fp #b1 #b10011111111 #b1001100110)
                arg1
                (fp #b0 #b01011011000 #b1110011101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01010110001 #b0100101100)
                arg3
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg3
                (fp #b0 #b00111111100 #b0010011100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
