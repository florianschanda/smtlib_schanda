                (fp #b0 #b110100100 #b10011111)))
(assert (fp.leq (fp #b0 #b110100100 #b10011111)
                arg3
                (fp #b0 #b111000001 #b00010011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

