(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011101001 #b101110001)
                arg1
                (fp #b0 #b1111001111 #b110100110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110100110)
                arg1
                (fp #b0 #b1111111001 #b111100101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100101000 #b101101011)
                arg3
                (fp #b0 #b0000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b001100101)
                arg3
                (fp #b0 #b0110010001 #b101111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                expect
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                expect
                (fp #b1 #b0100101111 #b111101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
