; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110100001111 #b001001011100)
                arg1
                (fp #b0 #b1000000001100 #b000000000000)))
(assert (fp.leq (fp #b0 #b1000000001100 #b000000000000)
                arg1
                (fp #b0 #b1110100011010 #b010100110001)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0101110110000 #b010101000110)
                arg2
                (fp #b0 #b1110101001111 #b101100001111)))
(assert (fp.leq (fp #b0 #b1110101001111 #b101100001111)
                arg2
                (fp #b0 #b1110101100111 #b000111011001)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101101011011 #b010000011001)
                expect
                (fp #b0 #b1110101011100 #b101100001111)))
(assert (fp.leq (fp #b0 #b1110101011100 #b101100001111)
                expect
                (fp #b0 #b1110111011111 #b100000001010)))

(assert (= expect result))

(check-sat)
(exit)
