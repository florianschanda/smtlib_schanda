(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111011 #b01100001)
                arg1
                (fp #b1 #b110101110 #b11110011)))
(assert (fp.leq (fp #b1 #b110101110 #b11110011)
                arg1
                (fp #b0 #b011110111 #b10110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010110101 #b10100110)
                arg2
                (fp #b1 #b010000111 #b11101000)))
(assert (fp.leq (fp #b1 #b010000111 #b11101000)
                arg2
                (fp #b0 #b000001101 #b00110100)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b11111111)
                arg3
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg3
                (fp #b1 #b010111010 #b01110010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b10001000)
                expect
                (fp #b1 #b111111100 #b11111111)))
(assert (fp.leq (fp #b1 #b111111100 #b11111111)
                expect
                (fp #b0 #b111000011 #b00110100)))

(assert (= expect result))

(check-sat)
(exit)
