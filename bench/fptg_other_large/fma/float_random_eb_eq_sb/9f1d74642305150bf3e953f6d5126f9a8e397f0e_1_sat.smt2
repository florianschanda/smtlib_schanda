(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100101011001 #b11110010101)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b1 #b001100110100 #b11110101111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110110101 #b01100011010)
                arg3
                (fp #b1 #b111101010111 #b01110011000)))
(assert (fp.leq (fp #b1 #b111101010111 #b01110011000)
                arg3
                (fp #b0 #b010101111100 #b10001000000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111011111 #b00111011111)
                expect
                (fp #b1 #b111101010111 #b01110011000)))
(assert (fp.leq (fp #b1 #b111101010111 #b01110011000)
                expect
                (fp #b1 #b001001001001 #b01100010111)))

(assert (= expect result))

(check-sat)
(exit)
