(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001110000 #b111100001)
                arg1
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg1
                (fp #b1 #b0011000001 #b000010111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000000 #b000101011)
                arg2
                (fp #b1 #b0000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b0001111101 #b100101000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101011001 #b100100000)
                arg3
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg3
                (fp #b0 #b1000001110 #b011101011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011010 #b011101000)
                expect
                (fp #b0 #b1000001001 #b000000001)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000001)
                expect
                (fp #b0 #b1100111011 #b001010000)))

(assert (= expect result))

(check-sat)
(exit)
