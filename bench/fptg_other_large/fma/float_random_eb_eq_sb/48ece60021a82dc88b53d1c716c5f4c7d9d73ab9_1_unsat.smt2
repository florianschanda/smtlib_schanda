; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100001101 #b111001000)
                arg1
                (fp #b1 #b1100001001 #b011011011)))
(assert (fp.leq (fp #b1 #b1100001001 #b011011011)
                arg1
                (fp #b0 #b1110110010 #b100010001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010101011 #b111000000)
                arg3
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg3
                (fp #b0 #b1101111100 #b111000111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
