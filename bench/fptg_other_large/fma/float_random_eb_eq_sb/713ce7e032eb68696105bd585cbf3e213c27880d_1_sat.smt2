(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001110010111 #b101100000000010)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b1 #b0000101100011000 #b011110101100000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011101010011100 #b111010111000111)
                arg2
                (fp #b0 #b0000000000000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b1011000001001011 #b110011111110001)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100100011010000 #b111101110100000)
                expect
                (fp #b1 #b0010111011011111 #b010010110100110)))
(assert (fp.leq (fp #b1 #b0010111011011111 #b010010110100110)
                expect
                (fp #b0 #b1100111111010111 #b111000011110000)))

(assert (= expect result))

(check-sat)
(exit)
