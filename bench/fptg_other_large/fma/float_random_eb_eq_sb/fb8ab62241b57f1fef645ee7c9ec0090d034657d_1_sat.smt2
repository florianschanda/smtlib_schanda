; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111101 #b00100111010111)
                arg1
                (fp #b1 #b111111111111101 #b00000000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000000000000)
                arg1
                (fp #b0 #b011100001100011 #b01000010010010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b001100101101111 #b10001000110101)
                arg2
                (fp #b0 #b110101101000010 #b01101010111010)))
(assert (fp.leq (fp #b0 #b110101101000010 #b01101010111010)
                arg2
                (fp #b0 #b111010101110001 #b00111011011101)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000000000000)
                expect
                (fp #b1 #b111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111111111111)
                expect
                (fp #b1 #b010111011011111 #b11001101101010)))

(assert (= expect result))

(check-sat)
(exit)
