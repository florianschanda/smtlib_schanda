(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg2
                (fp #b0 #b010100000 #b11010100)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100001 #b10101010)
                arg3
                (fp #b1 #b111011100 #b11100001)))
(assert (fp.leq (fp #b1 #b111011100 #b11100001)
                arg3
                (fp #b0 #b010010000 #b00010111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110110 #b11101101)
                expect
                (fp #b1 #b111011100 #b11100000)))
(assert (fp.leq (fp #b1 #b111011100 #b11100000)
                expect
                (fp #b1 #b001101100 #b00100001)))

(assert (= expect result))

(check-sat)
(exit)
