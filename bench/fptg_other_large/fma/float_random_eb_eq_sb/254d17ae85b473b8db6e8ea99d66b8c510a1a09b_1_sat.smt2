; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010011011001110 #b11110101111001)
                arg2
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b011101101001001 #b10001111100101)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100110110111110 #b11001101000101)
                arg3
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                arg3
                (fp #b0 #b110111000001001 #b11110110001110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
