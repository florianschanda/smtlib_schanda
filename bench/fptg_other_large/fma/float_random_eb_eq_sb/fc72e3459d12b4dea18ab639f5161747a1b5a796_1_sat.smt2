;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000100110 #b000111010)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b1 #b0110101010 #b101011011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111101111 #b011011110)
                arg3
                (fp #b1 #b0010110110 #b101111111)))
(assert (fp.leq (fp #b1 #b0010110110 #b101111111)
                arg3
                (fp #b0 #b0100101101 #b110101100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011110 #b001001011)
                expect
                (fp #b0 #b0101110101 #b001000110)))
(assert (fp.leq (fp #b0 #b0101110101 #b001000110)
                expect
                (fp #b0 #b1000101111 #b011000010)))

(assert (= expect result))

(check-sat)
(exit)
