                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100111110 #b1000100011)
                arg3
                (fp #b1 #b10011111010 #b0100000011)))
(assert (fp.leq (fp #b1 #b10011111010 #b0100000011)
                arg3
                (fp #b0 #b10100000101 #b1111100001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00010001010 #b0101000000)
                expect
                (fp #b0 #b10101101011 #b1101010100)))
(assert (fp.leq (fp #b0 #b10101101011 #b1101010100)
                expect
                (fp #b0 #b10111011100 #b1101001110)))

(assert (= expect result))

(check-sat)
(exit)
