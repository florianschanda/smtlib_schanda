                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg3
                (fp #b0 #b001110001 #b00110010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101100 #b10001100)
                expect
                (fp #b0 #b011111101 #b01011011)))
(assert (fp.leq (fp #b0 #b011111101 #b01011011)
                expect
                (fp #b0 #b101101100 #b11110000)))

(assert (not (= expect result)))

(check-sat)
