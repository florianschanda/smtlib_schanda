(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011110001100 #b00011110100)
                arg1
                (fp #b0 #b000000000000 #b10010110110)))
(assert (fp.leq (fp #b0 #b000000000000 #b10010110110)
                arg1
                (fp #b0 #b111000111001 #b01000000010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100100000101 #b00010110100)
                arg2
                (fp #b1 #b010010100111 #b00001001011)))
(assert (fp.leq (fp #b1 #b010010100111 #b00001001011)
                arg2
                (fp #b0 #b000001000101 #b11111000100)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001101011 #b01101010001)
                expect
                (fp #b1 #b010010100111 #b00001001011)))
(assert (fp.leq (fp #b1 #b010010100111 #b00001001011)
                expect
                (fp #b0 #b000010101010 #b00100010011)))

(assert (= expect result))

(check-sat)
(exit)
