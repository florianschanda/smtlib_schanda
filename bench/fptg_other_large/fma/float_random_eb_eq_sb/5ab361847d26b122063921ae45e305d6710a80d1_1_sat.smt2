                arg3
                (fp #b1 #b110001010010010 #b10100010000010)))
(assert (fp.leq (fp #b1 #b110001010010010 #b10100010000010)
                arg3
                (fp #b0 #b000100101001100 #b10000111110110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
