(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110111 #b01110100)
                arg1
                (fp #b1 #b110101110 #b11110011)))
(assert (fp.leq (fp #b1 #b110101110 #b11110011)
                arg1
                (fp #b1 #b010011110 #b00000111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111001 #b00010100)
                arg3
                (fp #b0 #b011011000 #b00110011)))
(assert (fp.leq (fp #b0 #b011011000 #b00110011)
                arg3
                (fp #b0 #b101010100 #b00100100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010100010 #b10101011)
                expect
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                expect
                (fp #b0 #b111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
