; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110101010 #b101101000)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1001010010 #b000011110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110000100 #b010111101)
                arg3
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg3
                (fp #b0 #b1001100000 #b110010100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001110000 #b001010011)
                expect
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                expect
                (fp #b0 #b1011101010 #b001101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
