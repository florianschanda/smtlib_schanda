(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b1 #b001101100010 #b11000111110)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101110111011 #b01111011110)
                arg3
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b000100000111 #b01110000010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                expect
                (fp #b1 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111111)
                expect
                (fp #b1 #b011001111100 #b01101101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
