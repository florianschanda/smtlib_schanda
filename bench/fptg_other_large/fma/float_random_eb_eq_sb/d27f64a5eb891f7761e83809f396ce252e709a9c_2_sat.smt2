                (fp #b0 #b101110100 #b11110001)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011011 #b11000110)
                arg3
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg3
                (fp #b0 #b110011101 #b00010010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001100001 #b10101100)
                expect
                (fp #b0 #b011111101 #b00001100)))
(assert (fp.leq (fp #b0 #b011111101 #b00001100)
                expect
                (fp #b0 #b111001111 #b10011100)))

(assert (= expect result))

(check-sat)
(exit)
