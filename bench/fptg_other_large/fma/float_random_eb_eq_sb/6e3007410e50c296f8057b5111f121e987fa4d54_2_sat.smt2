(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110110111 #b01100100010)
                arg1
                (fp #b1 #b000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011000100)
                arg1
                (fp #b0 #b111110000001 #b11001110110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110111010 #b01000100011)
                arg2
                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                arg2
                (fp #b0 #b110010001101 #b10000010100)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010001011110 #b10011100000)
                expect
                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                expect
                (fp #b0 #b111000101111 #b01011111111)))

(assert (= expect result))

(check-sat)
(exit)
