(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011010010100110 #b101101101101100)
                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b0 #b0001001000010010 #b101000100100111)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0111100100101010 #b010111110111110)
                arg3
                (fp #b0 #b0000011011000011 #b100001001001110)))
(assert (fp.leq (fp #b0 #b0000011011000011 #b100001001001110)
                arg3
                (fp #b0 #b0100000100101110 #b001010000100111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
