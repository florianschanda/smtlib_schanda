(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101010011101 #b00100011101)
                arg1
                (fp #b0 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000000)
                arg1
                (fp #b0 #b111111111110 #b11010110010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011110011010 #b11011110000)
                arg2
                (fp #b0 #b000000000000 #b10100101001)))
(assert (fp.leq (fp #b0 #b000000000000 #b10100101001)
                arg2
                (fp #b0 #b011000101111 #b11001111100)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100001100 #b01101100110)
                expect
                (fp #b0 #b011111111110 #b01001010010)))
(assert (fp.leq (fp #b0 #b011111111110 #b01001010010)
                expect
                (fp #b0 #b101100100101 #b00000101100)))

(assert (= expect result))

(check-sat)
(exit)
