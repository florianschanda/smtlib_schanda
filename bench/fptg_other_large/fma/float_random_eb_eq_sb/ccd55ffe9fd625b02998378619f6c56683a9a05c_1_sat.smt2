(assert (fp.leq (fp #b1 #b00000000000000 #b0001101100001)
                arg3
                (fp #b0 #b10010000011110 #b1011010011000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
