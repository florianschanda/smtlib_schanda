; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110111001010111101 #b11011111011100011)
                arg2
                (fp #b1 #b010011000011001011 #b01110100011010001)))
(assert (fp.leq (fp #b1 #b010011000011001011 #b01110100011010001)
                arg2
                (fp #b0 #b010000001111111010 #b10100111110100011)))

(declare-const arg3 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b111110011010101010 #b11001110111101001)
                arg3
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                arg3
                (fp #b0 #b010001010011001010 #b00111011100101001)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
