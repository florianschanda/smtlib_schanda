                (fp #b0 #b10110101100111110 #b0110101011010101)))
(assert (fp.leq (fp #b0 #b10110101100111110 #b0110101011010101)
                arg2
                (fp #b0 #b11010101001001111 #b1011000101111011)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
