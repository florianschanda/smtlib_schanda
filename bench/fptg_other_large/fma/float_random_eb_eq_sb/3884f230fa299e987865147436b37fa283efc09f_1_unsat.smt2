(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111110 #b0101100011)
                arg3
                (fp #b0 #b00000000000 #b1000001110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000001110)
                arg3
                (fp #b0 #b00111100001 #b1000000110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
