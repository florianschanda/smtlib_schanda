(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111100101 #b0000101011)
                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b0 #b00010110001 #b0001010000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110001001 #b0111010101)
                arg3
                (fp #b1 #b10011111010 #b0100000011)))
(assert (fp.leq (fp #b1 #b10011111010 #b0100000011)
                arg3
                (fp #b0 #b00100000100 #b1001001011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
