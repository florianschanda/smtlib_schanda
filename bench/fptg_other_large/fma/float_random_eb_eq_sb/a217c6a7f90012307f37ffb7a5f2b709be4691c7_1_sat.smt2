(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001100000110011 #b100010101100010)
                arg2
                (fp #b1 #b0000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b001010111010001)
                arg2
                (fp #b0 #b0010100001000101 #b111111101001011)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001111000001000 #b101001001011010)
                arg3
                (fp #b1 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001111 #b000000000000000)
                arg3
                (fp #b0 #b1111101011110000 #b101111011111111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
