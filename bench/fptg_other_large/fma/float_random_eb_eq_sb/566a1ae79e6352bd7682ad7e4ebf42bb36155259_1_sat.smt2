                arg2
                (fp #b0 #b111011111 #b11011111)))
(assert (fp.leq (fp #b0 #b111011111 #b11011111)
                arg2
                (fp #b0 #b111100000 #b00111111)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000101100 #b11111100)
                arg3
                (fp #b0 #b000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b000000000 #b01110011)
                arg3
                (fp #b0 #b101001000 #b11011011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000100 #b11110110)
                expect
                (fp #b0 #b000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b000000000 #b01110011)
                expect
                (fp #b0 #b100010011 #b10001001)))

(assert (= expect result))

(check-sat)
(exit)
