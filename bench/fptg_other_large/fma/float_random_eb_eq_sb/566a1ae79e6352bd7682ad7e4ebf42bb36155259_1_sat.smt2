; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
