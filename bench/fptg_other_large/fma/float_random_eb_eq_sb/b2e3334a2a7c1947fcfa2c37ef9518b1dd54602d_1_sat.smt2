(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01001101101 #b0010010111)
                arg1
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b11011001100 #b0011010100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000111100 #b0101111010)
                arg2
                (fp #b1 #b00000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000101100)
                arg2
                (fp #b0 #b01110100110 #b0010111010)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001110101 #b1000101101)
                arg3
                (fp #b1 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                arg3
                (fp #b0 #b11111110110 #b1100110001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00010100100 #b1010110000)
                expect
                (fp #b1 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                expect
                (fp #b0 #b01110000101 #b0011110111)))

(assert (= expect result))

(check-sat)
(exit)
