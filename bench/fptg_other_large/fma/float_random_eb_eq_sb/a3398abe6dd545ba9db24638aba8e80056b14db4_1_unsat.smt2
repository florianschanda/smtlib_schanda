;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010111000 #b010011001)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1110000010 #b011101101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011010111 #b000001111)
                arg3
                (fp #b1 #b0000000000 #b010001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b010001001)
                arg3
                (fp #b0 #b1010011001 #b011100110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011001 #b001100000)
                expect
                (fp #b0 #b0100010000 #b110101011)))
(assert (fp.leq (fp #b0 #b0100010000 #b110101011)
                expect
                (fp #b0 #b0101011000 #b110110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
