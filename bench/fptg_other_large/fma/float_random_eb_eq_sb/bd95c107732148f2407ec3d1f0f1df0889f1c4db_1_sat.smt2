(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b1111111110 #b011000000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100000001 #b000101100)
                arg3
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                arg3
                (fp #b0 #b1100101110 #b110011111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                expect
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                expect
                (fp #b0 #b0001000100 #b010111101)))

(assert (= expect result))

(check-sat)
(exit)
