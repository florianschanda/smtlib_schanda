(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000110 #b00111111)
                arg1
                (fp #b1 #b110101110 #b11110011)))
(assert (fp.leq (fp #b1 #b110101110 #b11110011)
                arg1
                (fp #b0 #b000010011 #b01001000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101001 #b01000011)
                arg2
                (fp #b1 #b100001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                arg2
                (fp #b1 #b001000000 #b11111000)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011001100 #b11011100)
                arg3
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg3
                (fp #b0 #b100111000 #b10000111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011001011 #b11110000)
                expect
                (fp #b0 #b110110111 #b11110100)))
(assert (fp.leq (fp #b0 #b110110111 #b11110100)
                expect
                (fp #b0 #b111011101 #b00100110)))

(assert (= expect result))

(check-sat)
(exit)
