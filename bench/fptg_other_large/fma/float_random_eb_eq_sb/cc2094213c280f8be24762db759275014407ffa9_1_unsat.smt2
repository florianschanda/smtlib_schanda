(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -INFINITY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100001 #b111110001)
                arg3
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                arg3
                (fp #b0 #b1010000110 #b100101100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
