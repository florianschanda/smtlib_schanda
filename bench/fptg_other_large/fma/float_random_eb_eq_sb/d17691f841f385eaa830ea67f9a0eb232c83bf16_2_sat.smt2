(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111100101 #b10111010101)
                arg1
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                arg1
                (fp #b0 #b111111111111 #b00000000000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b100011101110 #b01110101000)
                arg2
                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                arg2
                (fp #b0 #b111000001110 #b11110001000)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100100001000 #b00100101001)
                arg3
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b110010111101 #b11101110111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
