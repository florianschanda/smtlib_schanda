; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110010000011101 #b101100001001111)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b0 #b0010011111001110 #b110100001001001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011001110011101 #b001001110100101)
                arg2
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1110100110001000 #b011011110110101)
                arg3
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg3
                (fp #b0 #b0001000111111111 #b101100111101100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                expect
                (fp #b1 #b1111000110101011 #b110101101001100)))

(assert (= expect result))

(check-sat)
(exit)
