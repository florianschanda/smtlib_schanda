; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +NAN
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001111000 #b00001001000)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b000101011110 #b11001110100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b001011010001 #b00110010011)
                arg3
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b100010001001 #b11110101000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
