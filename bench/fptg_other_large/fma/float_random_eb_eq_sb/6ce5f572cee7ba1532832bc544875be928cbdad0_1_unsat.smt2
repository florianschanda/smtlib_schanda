(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000110101 #b10010010)
                arg1
                (fp #b1 #b000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000 #b00010010)
                arg1
                (fp #b0 #b001001101 #b11011011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111110 #b01010000)
                expect
                (fp #b0 #b000000000 #b00010010)))
(assert (fp.leq (fp #b0 #b000000000 #b00010010)
                expect
                (fp #b0 #b011100110 #b10110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
