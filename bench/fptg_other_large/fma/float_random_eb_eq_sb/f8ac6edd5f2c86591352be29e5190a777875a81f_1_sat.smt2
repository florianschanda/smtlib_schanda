(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01010100001110110 #b1101101000010101)
                arg2
                (fp #b1 #b00000000000000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111000111010011)
                arg2
                (fp #b0 #b01011110100000000 #b0111111111110100)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
