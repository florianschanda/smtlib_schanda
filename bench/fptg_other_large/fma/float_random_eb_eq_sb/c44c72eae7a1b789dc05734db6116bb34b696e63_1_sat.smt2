(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0011001001011110 #b011000100000100)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0010000010001000 #b001100101001001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100011101101010 #b011000001100010)
                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b0 #b1100000101011110 #b000111011101011)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
