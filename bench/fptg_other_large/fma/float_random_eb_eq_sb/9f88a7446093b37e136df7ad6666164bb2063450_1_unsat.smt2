(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011010011 #b10011011)
                arg3
                (fp #b0 #b011011000 #b00110011)))
(assert (fp.leq (fp #b0 #b011011000 #b00110011)
                arg3
                (fp #b0 #b100010101 #b11110100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001010 #b11011011)
                expect
                (fp #b0 #b011011000 #b00110011)))
(assert (fp.leq (fp #b0 #b011011000 #b00110011)
                expect
                (fp #b0 #b101000100 #b10011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
