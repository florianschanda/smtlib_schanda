; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111110 #b100011101)
                arg1
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b1100001100 #b000111000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001001 #b001011111)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b0001011100 #b000110000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011000 #b101110111)
                arg3
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg3
                (fp #b1 #b0110101110 #b010000001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
