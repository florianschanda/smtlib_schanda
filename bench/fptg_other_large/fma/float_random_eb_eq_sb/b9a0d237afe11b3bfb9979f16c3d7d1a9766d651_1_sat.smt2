(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000110100010 #b01001110011)
                arg1
                (fp #b0 #b000110100001 #b00110110110)))
(assert (fp.leq (fp #b0 #b000110100001 #b00110110110)
                arg1
                (fp #b0 #b111100111100 #b11100110100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001001100 #b11000111100)
                arg2
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                arg2
                (fp #b0 #b111111111111 #b00000000000)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b011110011011 #b00001101011)
                arg3
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b000011110101 #b10111000001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010001111000 #b01011110100)
                expect
                (fp #b0 #b100110100001 #b00110110101)))
(assert (fp.leq (fp #b0 #b100110100001 #b00110110101)
                expect
                (fp #b0 #b111101110010 #b01001110000)))

(assert (= expect result))

(check-sat)
(exit)
