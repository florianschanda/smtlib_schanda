(assert (fp.leq (fp #b1 #b1111011001100 #b101001110011)
                arg3
                (fp #b0 #b0000000000000 #b010010100111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010010100111)
                arg3
                (fp #b0 #b1101011010001 #b101001101101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
