(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100111111110 #b1000100001111)
                arg1
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg1
                (fp #b0 #b00111111100011 #b0000011000001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10001010111110 #b0011011101100)
                arg2
                (fp #b0 #b00001111100001 #b1001111010110)))
(assert (fp.leq (fp #b0 #b00001111100001 #b1001111010110)
                arg2
                (fp #b0 #b10000010110001 #b0001001010011)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10001001111110 #b0000100001001)
                expect
                (fp #b0 #b00001111100001 #b1001111010110)))
(assert (fp.leq (fp #b0 #b00001111100001 #b1001111010110)
                expect
                (fp #b0 #b01010010001010 #b0110001001001)))

(assert (= expect result))

(check-sat)
(exit)
