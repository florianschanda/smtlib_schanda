(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100100101101 #b11000011000)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b1 #b000110000111 #b11101000001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111101011 #b10100001111)
                arg2
                (fp #b1 #b101001111100 #b10100010001)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b1 #b010100001100 #b01001001111)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110000011 #b10000010000)
                expect
                (fp #b0 #b101010011110 #b00100111001)))
(assert (fp.leq (fp #b0 #b101010011110 #b00100111001)
                expect
                (fp #b0 #b111001100101 #b00010001101)))

(assert (= expect result))

(check-sat)
(exit)
