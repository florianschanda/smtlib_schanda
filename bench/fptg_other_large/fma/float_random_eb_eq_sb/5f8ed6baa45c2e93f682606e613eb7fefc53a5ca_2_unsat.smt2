; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110010 #b00000100)
                arg1
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg1
                (fp #b0 #b010000010 #b01110100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000000 #b11100111)
                arg2
                (fp #b1 #b101010010 #b00100101)))
(assert (fp.leq (fp #b1 #b101010010 #b00100101)
                arg2
                (fp #b0 #b110010100 #b00011100)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b00110010)
                arg3
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg3
                (fp #b0 #b000011100 #b00000001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b11001010)
                expect
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                expect
                (fp #b1 #b101110011 #b10111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
