(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100110 #b1101101101)
                arg1
                (fp #b1 #b01010111000 #b1011111111)))
(assert (fp.leq (fp #b1 #b01010111000 #b1011111111)
                arg1
                (fp #b0 #b01011101111 #b0010101101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011100011 #b1001010111)
                arg2
                (fp #b0 #b10110000110 #b0001100011)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100011)
                arg2
                (fp #b0 #b11000001010 #b0110100000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001010000 #b1100110010)
                expect
                (fp #b0 #b10110000110 #b0001100011)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100011)
                expect
                (fp #b0 #b11000101000 #b0110001010)))

(assert (= expect result))

(check-sat)
(exit)
