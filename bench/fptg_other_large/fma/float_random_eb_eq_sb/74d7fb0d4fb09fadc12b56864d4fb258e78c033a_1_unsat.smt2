                arg2
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b1 #b0001101010 #b110100000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0110000110 #b101001010)
                arg3
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg3
                (fp #b0 #b1111111101 #b000101001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1000010001 #b101000110)
                expect
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                expect
                (fp #b0 #b1111111110 #b100001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
