(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11100000010011010 #b0000111100010100)
                arg1
                (fp #b1 #b10101110110111010 #b0100001110110111)))
(assert (fp.leq (fp #b1 #b10101110110111010 #b0100001110110111)
                arg1
                (fp #b0 #b00111011001001111 #b1010111101110011)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
