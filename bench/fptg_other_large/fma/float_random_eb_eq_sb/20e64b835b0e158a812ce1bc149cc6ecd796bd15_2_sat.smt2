(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b11010111011111 #b1000100010011)
                arg1
                (fp #b0 #b11111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111111111)
                arg1
                (fp #b0 #b11111111111111 #b0000000000000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01000110111011 #b1110000001010)
                arg2
                (fp #b0 #b11011010010000 #b1101011001011)))
(assert (fp.leq (fp #b0 #b11011010010000 #b1101011001011)
                arg2
                (fp #b0 #b11110010010110 #b1001100100111)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
