                arg2
                (fp #b0 #b1001110111 #b101110100)))
(assert (fp.leq (fp #b0 #b1001110111 #b101110100)
                arg2
                (fp #b0 #b1011000100 #b000101100)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000001 #b110000010)
                arg3
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg3
                (fp #b0 #b1011110111 #b101000011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100101 #b011000011)
                expect
                (fp #b1 #b1010000001 #b101110100)))
(assert (fp.leq (fp #b1 #b1010000001 #b101110100)
                expect
                (fp #b0 #b0001000101 #b100010001)))

(assert (= expect result))

(check-sat)
(exit)
