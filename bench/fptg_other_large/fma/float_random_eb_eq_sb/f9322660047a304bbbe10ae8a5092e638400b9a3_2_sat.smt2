(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001000011 #b1011000100)
                arg1
                (fp #b1 #b10011111111 #b1001100110)))
(assert (fp.leq (fp #b1 #b10011111111 #b1001100110)
                arg1
                (fp #b0 #b10000100000 #b0100100100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001000100 #b1101011110)
                arg3
                (fp #b1 #b01100111110 #b0111011110)))
(assert (fp.leq (fp #b1 #b01100111110 #b0111011110)
                arg3
                (fp #b1 #b01010110011 #b0000001111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01111100101 #b0001011101)
                expect
                (fp #b0 #b11000000000 #b0100011111)))
(assert (fp.leq (fp #b0 #b11000000000 #b0100011111)
                expect
                (fp #b0 #b11000100101 #b1001110011)))

(assert (= expect result))

(check-sat)
(exit)
