                (fp #b0 #b11110001010 #b1001101111)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000000000 #b0111010011)
                arg3
                (fp #b0 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                arg3
                (fp #b0 #b10011000010 #b1101011000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010000010 #b1101111001)
                expect
                (fp #b1 #b10100001010 #b1001100110)))
(assert (fp.leq (fp #b1 #b10100001010 #b1001100110)
                expect
                (fp #b0 #b01101011010 #b0111110100)))

(assert (= expect result))

(check-sat)
(exit)
