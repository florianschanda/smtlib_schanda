                arg3
                (fp #b0 #b10001110111011 #b0010111100111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
