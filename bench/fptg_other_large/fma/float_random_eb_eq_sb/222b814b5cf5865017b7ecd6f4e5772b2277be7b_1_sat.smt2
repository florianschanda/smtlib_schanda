(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100000110 #b10000001)
                arg1
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg1
                (fp #b0 #b111111101 #b01000111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011001001 #b01010010)
                arg2
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg2
                (fp #b0 #b111001111 #b00001100)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b110111110 #b01010111)
                arg3
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg3
                (fp #b0 #b101100100 #b11000111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100000100 #b01100100)
                expect
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                expect
                (fp #b0 #b111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
