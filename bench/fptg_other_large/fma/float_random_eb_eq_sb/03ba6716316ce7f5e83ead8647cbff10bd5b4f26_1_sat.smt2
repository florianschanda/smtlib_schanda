(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101011010001 #b0110101101101)
                arg1
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                arg1
                (fp #b0 #b00010000001001 #b0001111100011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111101001010 #b0000011000101)
                arg2
                (fp #b1 #b00000111110111 #b1110101001101)))
(assert (fp.leq (fp #b1 #b00000111110111 #b1110101001101)
                arg2
                (fp #b0 #b10011011101110 #b1000100000101)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
