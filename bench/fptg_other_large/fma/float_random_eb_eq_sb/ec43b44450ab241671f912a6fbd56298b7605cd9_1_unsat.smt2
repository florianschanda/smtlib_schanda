;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01100101001001 #b1000000010110)
                arg2
                (fp #b0 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b10000000001101 #b0000000000000)
                arg2
                (fp #b0 #b11000011111001 #b1010000111011)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00010111001110 #b0101001001100)
                arg3
                (fp #b1 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000000000)
                arg3
                (fp #b0 #b00101110101100 #b1110100011011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
