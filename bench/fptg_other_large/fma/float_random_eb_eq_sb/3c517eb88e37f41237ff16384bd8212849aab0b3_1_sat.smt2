(assert (fp.leq (fp #b1 #b1011110011 #b111011101)
                arg3
                (fp #b1 #b0000000000 #b010001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b010001001)
                arg3
                (fp #b0 #b0100100011 #b110001001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100010101 #b101110111)
                expect
