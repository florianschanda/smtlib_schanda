;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100011111101 #b00010010101010)
                arg1
                (fp #b0 #b000101000010110 #b10000100101110)))
(assert (fp.leq (fp #b0 #b000101000010110 #b10000100101110)
                arg1
                (fp #b0 #b011010001011110 #b10101101111010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
