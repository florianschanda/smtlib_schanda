; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -ZERO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00000100111101 #b0001110000001)
                arg2
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg2
                (fp #b0 #b10111100001110 #b0011001101101)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000001111101 #b0100100001011)
                arg3
                (fp #b0 #b01101101010011 #b0001001111011)))
(assert (fp.leq (fp #b0 #b01101101010011 #b0001001111011)
                arg3
                (fp #b0 #b11101100000110 #b0011100011100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
