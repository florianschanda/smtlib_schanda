; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                arg1
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                arg1
                (fp #b1 #b010000100 #b00110100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111110 #b11000011)
                arg2
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg2
                (fp #b0 #b101111010 #b00111101)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111000 #b00011000)
                arg3
                (fp #b0 #b011011000 #b00110011)))
(assert (fp.leq (fp #b0 #b011011000 #b00110011)
                arg3
                (fp #b0 #b111110100 #b00011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                expect
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                expect
                (fp #b1 #b100011100 #b01110000)))

(assert (= expect result))

(check-sat)
(exit)
