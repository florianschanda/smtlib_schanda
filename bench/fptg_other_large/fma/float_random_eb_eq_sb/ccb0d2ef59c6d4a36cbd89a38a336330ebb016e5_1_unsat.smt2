                arg2
                (fp #b0 #b10010000100 #b1110100011)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101011111 #b1101101100)
                expect
                (fp #b1 #b00000001011 #b0001011000)))
(assert (fp.leq (fp #b1 #b00000001011 #b0001011000)
                expect
                (fp #b0 #b11101001001 #b0111000000)))

(assert (not (= expect result)))

(check-sat)
