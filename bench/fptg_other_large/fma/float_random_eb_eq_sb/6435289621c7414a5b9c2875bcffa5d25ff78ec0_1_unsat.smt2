(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100011011 #b0111001000)
                arg1
                (fp #b0 #b10011010111 #b1010011001)))
(assert (fp.leq (fp #b0 #b10011010111 #b1010011001)
                arg1
                (fp #b0 #b11000011000 #b0000100100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00111001000 #b0100111110)
                arg3
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg3
                (fp #b0 #b01110011100 #b1100111000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000101101 #b0101111010)
                expect
                (fp #b1 #b10110110000 #b0101110000)))
(assert (fp.leq (fp #b1 #b10110110000 #b0101110000)
                expect
                (fp #b0 #b11000100110 #b1100010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
