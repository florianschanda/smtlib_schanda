(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110001001011 #b1000010000110)
                arg2
                (fp #b0 #b00000000000000 #b0010100010010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0010100010010)
                arg2
                (fp #b0 #b00010110011010 #b0100010101100)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
