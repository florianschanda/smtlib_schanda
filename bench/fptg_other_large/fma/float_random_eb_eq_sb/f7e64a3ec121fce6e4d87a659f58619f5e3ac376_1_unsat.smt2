; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100101001101 #b01110011010)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b110100100110 #b10111001000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101000110 #b10101101101)
                arg3
                (fp #b0 #b000000000000 #b11010010000)))
(assert (fp.leq (fp #b0 #b000000000000 #b11010010000)
                arg3
                (fp #b0 #b110100001000 #b01010000110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011001011100 #b00000010100)
                expect
                (fp #b0 #b100001000001 #b11111110000)))
(assert (fp.leq (fp #b0 #b100001000001 #b11111110000)
                expect
                (fp #b0 #b110110000000 #b00101011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
