; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010110010 #b101111111)
                arg1
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0100110101 #b000101000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                arg2
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                arg2
                (fp #b0 #b1111000101 #b010001001)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001100111 #b011111000)
                arg3
                (fp #b0 #b0000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b001100101)
                arg3
                (fp #b0 #b0010011111 #b100011101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011001011 #b100111011)
                expect
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                expect
                (fp #b0 #b1001010001 #b101000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
