;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111010110 #b011001011)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b0 #b0100100101 #b101100001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011000101 #b000101011)
                arg2
                (fp #b0 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111111)
                arg2
                (fp #b0 #b1111111111 #b000000000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0011100101 #b010100110)
                arg3
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                arg3
                (fp #b0 #b1011111010 #b111010110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101111 #b111110100)
                expect
                (fp #b1 #b1110111010 #b000100001)))
(assert (fp.leq (fp #b1 #b1110111010 #b000100001)
                expect
                (fp #b0 #b1101011110 #b111100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
