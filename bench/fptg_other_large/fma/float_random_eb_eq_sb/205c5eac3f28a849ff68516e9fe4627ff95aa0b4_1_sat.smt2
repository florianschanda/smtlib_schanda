; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010011110010100 #b10100011000001)
                arg2
                (fp #b0 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b00000000000000)
                arg2
                (fp #b0 #b100010011011111 #b00100100101110)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110111010111001 #b11111001000010)
                arg3
                (fp #b0 #b000110110010010 #b00001001010111)))
(assert (fp.leq (fp #b0 #b000110110010010 #b00001001010111)
                arg3
                (fp #b0 #b001111111010000 #b01110100000101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
