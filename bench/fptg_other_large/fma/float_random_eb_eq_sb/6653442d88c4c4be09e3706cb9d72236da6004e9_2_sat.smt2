                arg2
                (fp #b1 #b000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000 #b01111101)
                arg2
                (fp #b0 #b011111110 #b11111111)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011101010 #b01001001)
                arg3
                (fp #b0 #b000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b000000000 #b01110011)
                arg3
                (fp #b0 #b100000110 #b10111000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110001 #b00111000)
                expect
                (fp #b0 #b010101111 #b11101000)))
(assert (fp.leq (fp #b0 #b010101111 #b11101000)
                expect
                (fp #b0 #b100010110 #b01110010)))

(assert (= expect result))

(check-sat)
(exit)
