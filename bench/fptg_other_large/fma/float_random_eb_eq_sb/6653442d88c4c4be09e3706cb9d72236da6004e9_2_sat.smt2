;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101111 #b10100100)
                arg1
                (fp #b1 #b110101110 #b11110011)))
(assert (fp.leq (fp #b1 #b110101110 #b11110011)
                arg1
                (fp #b1 #b100100000 #b00101100)))

