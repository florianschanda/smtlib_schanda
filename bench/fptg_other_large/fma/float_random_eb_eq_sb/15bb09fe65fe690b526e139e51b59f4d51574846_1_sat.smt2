(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg2
                (fp #b0 #b111111110 #b11100110)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b001100110 #b11001111)
                arg3
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                arg3
                (fp #b0 #b100110101 #b11111010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100010101 #b10101011)
                expect
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                expect
                (fp #b0 #b100111011 #b10000010)))

(assert (= expect result))

(check-sat)
(exit)
