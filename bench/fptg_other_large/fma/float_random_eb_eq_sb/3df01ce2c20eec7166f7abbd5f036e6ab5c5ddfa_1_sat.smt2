(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b00100111)
                arg2
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg2
                (fp #b1 #b101010010 #b10000110)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b001011110 #b01001111)
                arg3
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                arg3
                (fp #b0 #b001010000 #b11100001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
