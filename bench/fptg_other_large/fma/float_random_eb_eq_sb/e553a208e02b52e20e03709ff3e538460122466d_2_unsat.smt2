(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110100100100000 #b110000000101110)
                expect
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                expect
                (fp #b0 #b0011001111011111 #b001100001100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
