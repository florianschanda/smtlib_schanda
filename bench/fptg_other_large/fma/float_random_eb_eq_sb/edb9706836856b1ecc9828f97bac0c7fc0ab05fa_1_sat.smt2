(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b0111111001 #b101101011)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0010101011 #b101011110)
                arg3
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg3
                (fp #b0 #b1010000101 #b101111000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000001111 #b101001011)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0011000101 #b011110101)))

(assert (= expect result))

(check-sat)
