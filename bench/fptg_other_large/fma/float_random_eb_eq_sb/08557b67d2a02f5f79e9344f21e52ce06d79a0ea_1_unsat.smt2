; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011111000000000 #b100101100000010)
                arg1
                (fp #b1 #b0010000000101010 #b010110111111100)))
(assert (fp.leq (fp #b1 #b0010000000101010 #b010110111111100)
                arg1
                (fp #b0 #b0111101110100101 #b101100001101100)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
