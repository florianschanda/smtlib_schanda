(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010111110 #b000000110)
                arg1
                (fp #b1 #b0000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b0000000000 #b100100111)
                arg1
                (fp #b0 #b1101111000 #b000101011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010000 #b000011010)
                arg2
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b0 #b0100000110 #b101100000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101101100 #b011010101)
                expect
                (fp #b0 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b0 #b1101101000 #b001010101)
                expect
                (fp #b0 #b1111110000 #b000100000)))

(assert (= expect result))

(check-sat)
(exit)
