;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100000001 #b1010000011)
                arg1
                (fp #b0 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000)
                arg1
                (fp #b0 #b01101010000 #b0100001010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110011101 #b0011101000)
                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b1 #b01010111001 #b1010011101)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111011011 #b1001001001)
                expect
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                expect
                (fp #b1 #b11101110111 #b1100100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
