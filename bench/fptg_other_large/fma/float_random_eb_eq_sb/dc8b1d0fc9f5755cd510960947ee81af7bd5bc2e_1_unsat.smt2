(assert (fp.leq (fp #b1 #b0100110110010100 #b110111110100011)
                arg2
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg2
                (fp #b0 #b0101001100010101 #b111001101011110)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111101 #b010000100011100)
                arg3
                (fp #b1 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000000000000)
                arg3
                (fp #b1 #b0010001011011011 #b110101001100100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
