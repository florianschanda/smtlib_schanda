; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110101011 #b1011000001)
                arg1
                (fp #b1 #b10011111111 #b1001100110)))
(assert (fp.leq (fp #b1 #b10011111111 #b1001100110)
                arg1
                (fp #b1 #b00000001110 #b1001100011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01000111101 #b0001100000)
                arg2
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b10110011011 #b0011000111)
                arg3
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg3
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111)
                expect
                (fp #b1 #b01001001110 #b0110000110)))

(assert (= expect result))

(check-sat)
(exit)
