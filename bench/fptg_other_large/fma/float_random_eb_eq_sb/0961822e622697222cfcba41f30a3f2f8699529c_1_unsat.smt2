                (fp #b1 #b1111111111101 #b000000000000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b000000000000)
                arg3
                (fp #b1 #b0110101110101 #b010101011101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
