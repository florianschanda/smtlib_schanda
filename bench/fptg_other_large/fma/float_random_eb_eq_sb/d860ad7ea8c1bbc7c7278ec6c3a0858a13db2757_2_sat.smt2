; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101111111011000 #b000001010110101)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b0 #b1111011000110001 #b010000111010001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110110110101101 #b000100100001110)
                arg3
                (fp #b1 #b0001000010110100 #b011100101011000)))
(assert (fp.leq (fp #b1 #b0001000010110100 #b011100101011000)
                arg3
                (fp #b0 #b1111101111111010 #b110110111101010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110010000110101 #b110000110010110)
                expect
                (fp #b1 #b1101110110111101 #b010010000011100)))
(assert (fp.leq (fp #b1 #b1101110110111101 #b010010000011100)
                expect
                (fp #b1 #b1001110001111001 #b111011101111110)))

(assert (= expect result))

(check-sat)
(exit)
