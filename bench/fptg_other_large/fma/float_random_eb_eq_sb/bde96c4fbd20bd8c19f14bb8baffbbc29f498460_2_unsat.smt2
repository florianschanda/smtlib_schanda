(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101101 #b01001110)
                arg1
                (fp #b0 #b000011000 #b11110110)))
(assert (fp.leq (fp #b0 #b000011000 #b11110110)
                arg1
                (fp #b0 #b110001100 #b01100110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111111 #b01100101)
                arg3
                (fp #b0 #b000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b000000000 #b01110011)
                arg3
                (fp #b0 #b001011010 #b01001001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100000001 #b11111011)
                expect
                (fp #b0 #b000000000 #b01110100)))
(assert (fp.leq (fp #b0 #b000000000 #b01110100)
                expect
                (fp #b0 #b011011111 #b10000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
