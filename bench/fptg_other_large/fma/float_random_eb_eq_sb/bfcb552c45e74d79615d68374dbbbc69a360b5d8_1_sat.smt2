                arg3
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg3
                (fp #b0 #b000110011 #b00100000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000100011 #b11101011)
                expect
                (fp #b0 #b110101010 #b00101110)))
(assert (fp.leq (fp #b0 #b110101010 #b00101110)
                expect
                (fp #b0 #b111110011 #b00110000)))

(assert (= expect result))

(check-sat)
(exit)
