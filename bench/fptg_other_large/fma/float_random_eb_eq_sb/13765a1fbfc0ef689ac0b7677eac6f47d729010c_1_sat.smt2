                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b0100110011 #b001111000)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011001001 #b100111000)
                arg3
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg3
                (fp #b0 #b1011101011 #b001011010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011010011 #b101010111)
                expect
                (fp #b1 #b1000001000 #b111111111)))
(assert (fp.leq (fp #b1 #b1000001000 #b111111111)
                expect
                (fp #b0 #b0101110010 #b010011011)))

(assert (= expect result))

(check-sat)
(exit)
