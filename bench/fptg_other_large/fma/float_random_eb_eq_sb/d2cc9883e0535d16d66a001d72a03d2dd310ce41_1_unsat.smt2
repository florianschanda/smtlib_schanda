                arg2
                (fp #b0 #b111001000111000 #b00000101110010)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011001111110011 #b10111111110110)
                expect
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                expect
                (fp #b0 #b010100111111100 #b11010101111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
