(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010010101100 #b10111011001)
                arg1
                (fp #b1 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000)
                arg1
                (fp #b0 #b011011000110 #b00000011101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011101101 #b10100011001)
                arg2
                (fp #b0 #b001000111111 #b10110001011)))
(assert (fp.leq (fp #b0 #b001000111111 #b10110001011)
                arg2
                (fp #b0 #b100000000111 #b01000110110)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101101010 #b10101010001)
                expect
                (fp #b1 #b001000111111 #b10110001011)))
(assert (fp.leq (fp #b1 #b001000111111 #b10110001011)
                expect
                (fp #b0 #b111001101101 #b10011000100)))

(assert (= expect result))

(check-sat)
(exit)
