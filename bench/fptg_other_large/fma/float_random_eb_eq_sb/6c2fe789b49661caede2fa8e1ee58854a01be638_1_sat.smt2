(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111101111 #b1000101000)
                arg1
                (fp #b1 #b00000000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000000 #b1010010101)
                arg1
                (fp #b0 #b10110001000 #b0100001000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101001011 #b1101011001)
                arg2
                (fp #b1 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                arg2
                (fp #b0 #b11001011000 #b0001001100)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01110000000 #b1100111101)
                arg3
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                arg3
                (fp #b0 #b11111111101 #b1111111001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01101011001 #b1101101010)
                expect
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                expect
                (fp #b0 #b11111111101 #b1111110010)))

(assert (= expect result))

(check-sat)
(exit)
