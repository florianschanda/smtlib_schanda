(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101101100100000 #b11110101101110)
                arg2
                (fp #b1 #b011000011100001 #b01110100100110)))
(assert (fp.leq (fp #b1 #b011000011100001 #b01110100100110)
                arg2
                (fp #b0 #b011100111101111 #b01100011101110)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000000000000)
                arg3
                (fp #b1 #b111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111111111111)
                arg3
                (fp #b1 #b111001100010100 #b11010000000010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
