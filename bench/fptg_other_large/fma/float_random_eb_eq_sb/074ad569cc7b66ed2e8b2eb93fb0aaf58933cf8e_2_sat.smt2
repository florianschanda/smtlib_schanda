                arg3
                (fp #b0 #b01000011000 #b0011111011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101001111 #b1000010000)
                expect
                (fp #b0 #b10110110000 #b0101110001)))
(assert (fp.leq (fp #b0 #b10110110000 #b0101110001)
                expect
                (fp #b0 #b11101110101 #b0001111001)))

(assert (= expect result))

(check-sat)
(exit)
