(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100001111111 #b011101011110)
                arg1
                (fp #b1 #b1011101111000 #b000110000100)))
(assert (fp.leq (fp #b1 #b1011101111000 #b000110000100)
                arg1
                (fp #b0 #b0001111000000 #b111000111011)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111100011011 #b100010000010)
                expect
                (fp #b1 #b1111011110001 #b001100101100)))
(assert (fp.leq (fp #b1 #b1111011110001 #b001100101100)
                expect
                (fp #b0 #b1010110100011 #b000100110010)))

(assert (= expect result))

(check-sat)
(exit)
