; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1100000000101111 #b101001011100110)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0000100100100100 #b110100000100011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0111011000111100 #b011010011011000)
                arg2
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011111111100011 #b011011110010100)
                arg3
                (fp #b1 #b0001000010110100 #b011100101011000)))
(assert (fp.leq (fp #b1 #b0001000010110100 #b011100101011000)
                arg3
                (fp #b0 #b0100101010111011 #b101001000110000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000011001111111 #b110111011100000)
                expect
                (fp #b1 #b0001000010110100 #b011100101011000)))
(assert (fp.leq (fp #b1 #b0001000010110100 #b011100101011000)
                expect
                (fp #b0 #b1010010110010111 #b000010000100011)))

(assert (= expect result))

(check-sat)
(exit)
