(assert (fp.leq (fp #b1 #b010010100111 #b00001001011)
                arg2
                (fp #b1 #b000011111010 #b00001110100)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b101100001100 #b11011100100)
                arg3
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b111010011011 #b00110000100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011001111001 #b00010010101)
                expect
                (fp #b0 #b010011001000 #b01110110100)))
(assert (fp.leq (fp #b0 #b010011001000 #b01110110100)
                expect
                (fp #b0 #b111010101010 #b11001011011)))

(assert (= expect result))

(check-sat)
(exit)
