                arg2
                (fp #b0 #b11111111111111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1111111111111111)
                arg2
                (fp #b0 #b11111111111111111 #b0000000000000000)))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00110011011100100 #b1011000000100100)
                arg3
                (fp #b0 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000000)
                arg3
                (fp #b0 #b01111010010111011 #b0101111101110111)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
