(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010011110101 #b0001010010100)
                arg1
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                arg1
                (fp #b0 #b01001011101001 #b1101110100011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
