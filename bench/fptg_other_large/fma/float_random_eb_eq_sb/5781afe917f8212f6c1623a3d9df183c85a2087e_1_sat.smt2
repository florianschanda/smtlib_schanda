(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b0011110100 #b011101001)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                arg3
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                arg3
                (fp #b0 #b1111000011 #b000000011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                expect
                (fp #b1 #b1111111110 #b111111110)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111110)
                expect
                (fp #b0 #b1000000001 #b011101101)))

(assert (= expect result))

(check-sat)
(exit)
