                (fp #b0 #b101101011001111011 #b11010101101010101)))
(assert (fp.leq (fp #b0 #b101101011001111011 #b11010101101010101)
                arg2
                (fp #b0 #b111101011001111110 #b10011010001000110)))

(declare-const arg3 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b010010110110000111 #b01110111000000001)
                arg3
                (fp #b0 #b100000000000010001 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b100000000000010001 #b00000000000000000)
                arg3
                (fp #b0 #b111110111010100101 #b10001011011001011)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
