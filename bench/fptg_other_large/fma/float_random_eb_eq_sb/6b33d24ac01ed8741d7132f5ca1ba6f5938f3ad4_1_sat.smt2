(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110110111 #b0011100011)
                arg1
                (fp #b1 #b00000000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000000 #b1010010101)
                arg1
                (fp #b0 #b00011011100 #b1100101110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111)
                arg2
                (fp #b1 #b01010011101 #b0100001000)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10010010110 #b0101111100)
                arg3
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg3
                (fp #b0 #b01000110111 #b0001100001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000001110 #b0000100000)
                expect
                (fp #b0 #b10000000000 #b0100101001)))
(assert (fp.leq (fp #b0 #b10000000000 #b0100101001)
                expect
                (fp #b0 #b10000011000 #b0101111101)))

(assert (= expect result))

(check-sat)
(exit)
