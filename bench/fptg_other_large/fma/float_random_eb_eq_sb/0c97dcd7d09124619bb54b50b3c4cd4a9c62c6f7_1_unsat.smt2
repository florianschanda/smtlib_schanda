                (fp #b0 #b101110001 #b11010111)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110001 #b10100100)
                arg3
                (fp #b1 #b000000000 #b11001101)))
(assert (fp.leq (fp #b1 #b000000000 #b11001101)
                arg3
                (fp #b0 #b100000100 #b00111011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111011 #b00010001)
                expect
                (fp #b1 #b000001000 #b00000001)))
(assert (fp.leq (fp #b1 #b000001000 #b00000001)
                expect
                (fp #b0 #b000010010 #b01010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
