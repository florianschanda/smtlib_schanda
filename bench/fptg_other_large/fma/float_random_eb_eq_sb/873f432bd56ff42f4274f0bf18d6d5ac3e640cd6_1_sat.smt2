; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100001011110101 #b11001011000001)
                arg2
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                arg2
                (fp #b0 #b011110011110011 #b10010001001101)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101001011010000 #b10000001100011)
                arg3
                (fp #b1 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b1 #b100000000001110 #b00000000000000)
                arg3
                (fp #b0 #b010001111100011 #b10010010100000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
