; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1011100100010 #b011100000100)
                arg1
                (fp #b1 #b1000000001100 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000001100 #b000000000000)
                arg1
                (fp #b0 #b0010111001111 #b000110011111)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1010111101010 #b101111010100)
                arg2
                (fp #b0 #b0100000110110 #b010000101101)))
(assert (fp.leq (fp #b0 #b0100000110110 #b010000101101)
                arg2
                (fp #b0 #b1011111110100 #b001101011000)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101101110110 #b101100101011)
                expect
                (fp #b1 #b0100001000011 #b010000101101)))
(assert (fp.leq (fp #b1 #b0100001000011 #b010000101101)
                expect
                (fp #b0 #b1110011001110 #b100011101001)))

(assert (= expect result))

(check-sat)
(exit)
