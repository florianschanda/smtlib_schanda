; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
