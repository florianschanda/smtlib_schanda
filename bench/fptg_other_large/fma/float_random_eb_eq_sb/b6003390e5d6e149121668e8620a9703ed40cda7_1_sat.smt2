(assert (fp.leq (fp #b1 #b1110010110 #b010000101)
                arg3
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                arg3
                (fp #b0 #b1110100110 #b011100110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100110100 #b011011100)
                expect
                (fp #b0 #b1011011101 #b000011000)))
(assert (fp.leq (fp #b0 #b1011011101 #b000011000)
                expect
                (fp #b0 #b1111010101 #b000010000)))

(assert (= expect result))

(check-sat)
(exit)
