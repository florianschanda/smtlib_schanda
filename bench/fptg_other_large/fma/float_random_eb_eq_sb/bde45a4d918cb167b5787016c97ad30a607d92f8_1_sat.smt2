; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100100000100 #b0101011001000)
                arg2
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                arg2
                (fp #b0 #b01101110100011 #b0001000000111)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00100010010010 #b0000111000001)
                arg3
                (fp #b0 #b00000000000000 #b1110000100010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1110000100010)
                arg3
                (fp #b0 #b10101010110111 #b0100000011011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
