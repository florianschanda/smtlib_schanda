(assert (fp.leq (fp #b1 #b01110000101100 #b1111011001100)
                arg3
                (fp #b1 #b00000000000000 #b0001101100001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0001101100001)
                arg3
                (fp #b0 #b01100011110001 #b0011010001100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
