(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110001 #b110100011)
                arg1
                (fp #b0 #b0000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b111100110)
                arg1
                (fp #b0 #b1001010001 #b100001111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011101001 #b000110110)
                expect
                (fp #b1 #b0000000000 #b111100110)))
(assert (fp.leq (fp #b1 #b0000000000 #b111100110)
                expect
                (fp #b0 #b1111100010 #b100001111)))

(assert (= expect result))

(check-sat)
(exit)
