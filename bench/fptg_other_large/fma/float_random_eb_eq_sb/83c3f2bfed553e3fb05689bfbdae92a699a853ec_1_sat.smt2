(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111000000010011111 #b11111101100110001)
                arg1
                (fp #b1 #b000100000001001101 #b10110111111001010)))
(assert (fp.leq (fp #b1 #b000100000001001101 #b10110111111001010)
                arg1
                (fp #b0 #b111000001111110000 #b01000000001011110)))

