(assert (fp.leq (fp #b1 #b101010010 #b00100101)
                arg2
                (fp #b1 #b000010110 #b11111101)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b00011010)
                arg3
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg3
                (fp #b1 #b101101110 #b10111001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b01001000)
                expect
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                expect
                (fp #b0 #b001001010 #b11011111)))

(assert (= expect result))

(check-sat)
(exit)
