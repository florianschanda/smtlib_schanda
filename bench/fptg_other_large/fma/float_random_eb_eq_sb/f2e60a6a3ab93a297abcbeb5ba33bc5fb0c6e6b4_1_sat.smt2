; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110111110110011000 #b00001100110001101)
                arg1
                (fp #b1 #b101011101101110010 #b10000111011011011)))
(assert (fp.leq (fp #b1 #b101011101101110010 #b10000111011011011)
                arg1
                (fp #b1 #b000011011001010000 #b01110101001010010)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b000101000011000101 #b11000000001001001)
                arg2
                (fp #b0 #b011101000111010100 #b01001110111000011)))
(assert (fp.leq (fp #b0 #b011101000111010100 #b01001110111000011)
                arg2
                (fp #b0 #b110110101110000110 #b10010000010001110)))

(declare-const arg3 (_ FloatingPoint 18 18))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110110101001011101 #b01110100001111000)
                expect
                (fp #b1 #b101000110101001000 #b00000000000001001)))
(assert (fp.leq (fp #b1 #b101000110101001000 #b00000000000001001)
                expect
                (fp #b1 #b010111011010010111 #b10101110010101011)))

(assert (= expect result))

(check-sat)
(exit)
