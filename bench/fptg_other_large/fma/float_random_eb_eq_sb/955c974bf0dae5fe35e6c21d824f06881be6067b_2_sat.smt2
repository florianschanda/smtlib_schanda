(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111110 #b01110010101001)
                arg1
                (fp #b1 #b111111111111101 #b00000000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000000000000)
                arg1
                (fp #b1 #b101010111100010 #b10010010000010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010111011000111 #b01001011111110)
                arg2
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b011000001111111 #b00011111100101)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111101101000101 #b01111110100111)
                expect
                (fp #b0 #b011111111111101 #b11011101001100)))
(assert (fp.leq (fp #b0 #b011111111111101 #b11011101001100)
                expect
                (fp #b0 #b110010110100111 #b00010001101110)))

(assert (= expect result))

(check-sat)
(exit)
