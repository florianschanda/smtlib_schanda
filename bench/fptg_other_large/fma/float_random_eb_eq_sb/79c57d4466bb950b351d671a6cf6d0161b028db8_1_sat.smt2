;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01100110000 #b0100100000)
                arg1
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b11011100101 #b0101011101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01011111110 #b0000111010)
                arg2
                (fp #b0 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                arg2
                (fp #b0 #b11111010010 #b1000001011)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101110110 #b0010010100)
                arg3
                (fp #b0 #b00000000000 #b1000001110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000001110)
                arg3
                (fp #b0 #b11010001010 #b1000100001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011101011 #b0001110001)
                expect
                (fp #b0 #b00000000000 #b1000001110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000001110)
                expect
                (fp #b0 #b10000101110 #b0101111000)))

(assert (= expect result))

(check-sat)
(exit)
