; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100100010001 #b11101011111100)
                arg1
                (fp #b1 #b101110111000001 #b01000011110110)))
(assert (fp.leq (fp #b1 #b101110111000001 #b01000011110110)
                arg1
                (fp #b0 #b000100101010110 #b00101001010110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001010000011111 #b10000010110110)
                arg2
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b101010100011010 #b11111100010010)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111011101000 #b11001111001000)
                expect
                (fp #b0 #b001110111000010 #b00101101110100)))
(assert (fp.leq (fp #b0 #b001110111000010 #b00101101110100)
                expect
                (fp #b0 #b110010001001011 #b10011101000111)))

(assert (= expect result))

(check-sat)
(exit)
