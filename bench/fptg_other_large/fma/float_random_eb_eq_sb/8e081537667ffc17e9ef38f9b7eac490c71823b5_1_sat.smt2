(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000101101 #b11001100)
                arg1
                (fp #b0 #b111000010 #b00111001)))
(assert (fp.leq (fp #b0 #b111000010 #b00111001)
                arg1
                (fp #b0 #b111001100 #b00000101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                arg2
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                arg2
                (fp #b0 #b110110100 #b01101000)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100100011 #b11110111)
                arg3
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg3
                (fp #b0 #b011001101 #b10110110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                expect
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                expect
                (fp #b1 #b101100000 #b01101000)))

(assert (= expect result))

(check-sat)
(exit)
