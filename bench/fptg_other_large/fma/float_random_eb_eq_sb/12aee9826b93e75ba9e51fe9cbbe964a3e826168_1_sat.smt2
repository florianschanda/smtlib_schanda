(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +NAN
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001100010000100 #b111111110110100)
                arg3
                (fp #b0 #b0000011011000011 #b100001001001110)))
(assert (fp.leq (fp #b0 #b0000011011000011 #b100001001001110)
                arg3
                (fp #b0 #b1011100101100111 #b111101110011110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
