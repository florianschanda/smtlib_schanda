; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00011101011010 #b1011111110110)
                arg1
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                arg1
                (fp #b0 #b11111010001100 #b0100010000101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b11101001000100 #b1010010000101)
                arg2
                (fp #b0 #b11111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111111111)
                arg2
                (fp #b0 #b11111111111111 #b0000000000000)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
