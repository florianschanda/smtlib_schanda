(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1011101110001011 #b101110110010101)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0010100010000111 #b100101010000011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000010011111110 #b001101011010110)
                arg2
                (fp #b1 #b0000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b001010111010001)
                arg2
                (fp #b0 #b0010010111011010 #b111111100001001)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
