; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001011 #b101100010)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b0 #b0111011110 #b001010101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110101011 #b000001000)
                arg3
                (fp #b0 #b0000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b001100101)
                arg3
                (fp #b0 #b0101000001 #b011101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111010110 #b010110100)
                expect
                (fp #b0 #b0101110101 #b001000110)))
(assert (fp.leq (fp #b0 #b0101110101 #b001000110)
                expect
                (fp #b0 #b1100100001 #b100001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
