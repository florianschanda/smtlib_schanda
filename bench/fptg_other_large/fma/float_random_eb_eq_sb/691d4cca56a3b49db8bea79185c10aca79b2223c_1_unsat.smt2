                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011011110001111 #b101110101011100)
                arg3
                (fp #b0 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001111 #b000000000000000)
                arg3
                (fp #b0 #b1101110100001111 #b011111010101100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
