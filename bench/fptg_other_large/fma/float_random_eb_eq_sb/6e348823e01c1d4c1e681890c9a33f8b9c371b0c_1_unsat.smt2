; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: +INFINITY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110010000101110011 #b00100101100001100)
                arg3
                (fp #b1 #b010010000101100011 #b11100101010110001)))
(assert (fp.leq (fp #b1 #b010010000101100011 #b11100101010110001)
                arg3
                (fp #b0 #b110111100011100011 #b01111100100001101)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
