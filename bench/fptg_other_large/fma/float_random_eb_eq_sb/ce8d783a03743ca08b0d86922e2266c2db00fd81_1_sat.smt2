(assert (fp.leq (fp #b1 #b010000101101011 #b11100101011011)
                arg3
                (fp #b0 #b000000000111111 #b10101110010111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
