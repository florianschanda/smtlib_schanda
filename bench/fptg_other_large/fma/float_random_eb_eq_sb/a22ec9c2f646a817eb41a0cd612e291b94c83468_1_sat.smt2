;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00110100000011000 #b0010110100010010)
                arg1
                (fp #b1 #b00010000000101000 #b0101101111110100)))
(assert (fp.leq (fp #b1 #b00010000000101000 #b0101101111110100)
                arg1
                (fp #b0 #b01010101100101110 #b0000010100100010)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
