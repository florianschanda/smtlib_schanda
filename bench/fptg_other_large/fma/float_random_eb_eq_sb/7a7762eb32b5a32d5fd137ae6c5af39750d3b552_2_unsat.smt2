; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110010101001 #b1111010001000)
                arg1
                (fp #b1 #b11101110010101 #b1000100010010)))
(assert (fp.leq (fp #b1 #b11101110010101 #b1000100010010)
                arg1
                (fp #b1 #b01100101011011 #b0010100101111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00110000101101 #b0110010001111)
                arg3
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                arg3
                (fp #b0 #b10001101001101 #b0010111101100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
