; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110000001 #b011010100)
                arg1
                (fp #b0 #b0000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b111100110)
                arg1
                (fp #b0 #b0111111011 #b000000110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100011 #b101100101)
                arg2
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b0 #b0000010000 #b001111110)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010110 #b101100110)
                expect
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                expect
                (fp #b0 #b0000010011 #b010011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
