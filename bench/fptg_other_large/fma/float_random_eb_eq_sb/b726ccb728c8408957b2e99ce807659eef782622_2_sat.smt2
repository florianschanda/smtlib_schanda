                arg2
                (fp #b0 #b1111111111101 #b000000000000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000000000000)
                arg2
                (fp #b0 #b1111111111101 #b011100001001)))

(declare-const arg3 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0111100010000 #b111000010110)
                arg3
                (fp #b1 #b0000000000000 #b010000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b010000000000)
                arg3
                (fp #b0 #b1100111100111 #b011001010000)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 13))
