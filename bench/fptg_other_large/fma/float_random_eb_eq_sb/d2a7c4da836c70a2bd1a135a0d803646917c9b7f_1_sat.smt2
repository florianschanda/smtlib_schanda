(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010101000 #b001100001)
                arg1
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg1
                (fp #b0 #b0111011000 #b100001011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010110010 #b101010101)
                arg2
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b0010001000 #b110001001)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101000 #b101000100)
                arg3
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg3
                (fp #b0 #b1010111100 #b100111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100110110 #b010110111)
                expect
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                expect
                (fp #b0 #b1011100100 #b110000101)))

(assert (= expect result))

(check-sat)
(exit)
