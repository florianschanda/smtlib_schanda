                arg2
                (fp #b0 #b011001101110 #b00110110001)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b010111000010 #b00101001101)
                arg3
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg3
                (fp #b0 #b111111011001 #b11110000001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011101010 #b00111110010)
                expect
                (fp #b1 #b001001100001 #b00110010000)))
(assert (fp.leq (fp #b1 #b001001100001 #b00110010000)
                expect
                (fp #b0 #b101000011100 #b00010010001)))

(assert (= expect result))

(check-sat)
(exit)
