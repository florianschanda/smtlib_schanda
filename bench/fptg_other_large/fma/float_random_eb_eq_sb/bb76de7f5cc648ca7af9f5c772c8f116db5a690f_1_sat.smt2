; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011011001 #b01110111)
                arg1
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg1
                (fp #b0 #b101011111 #b01010000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010100 #b11011001)
                arg2
                (fp #b1 #b010000111 #b11101000)))
(assert (fp.leq (fp #b1 #b010000111 #b11101000)
                arg2
                (fp #b0 #b000100101 #b10110000)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010101010 #b10010101)
                arg3
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg3
                (fp #b0 #b011000110 #b11000100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010011111 #b01000011)
                expect
                (fp #b1 #b010010000 #b11101000)))
(assert (fp.leq (fp #b1 #b010010000 #b11101000)
                expect
                (fp #b0 #b011000000 #b01111000)))

(assert (= expect result))

(check-sat)
(exit)
