; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001111010010 #b11100111000)
                arg2
                (fp #b1 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000)
                arg2
                (fp #b0 #b101111100100 #b10011011001)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100010001 #b01111110100)
                arg3
                (fp #b0 #b000000000000 #b11010010000)))
(assert (fp.leq (fp #b0 #b000000000000 #b11010010000)
                arg3
                (fp #b0 #b100001000000 #b00000111000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
