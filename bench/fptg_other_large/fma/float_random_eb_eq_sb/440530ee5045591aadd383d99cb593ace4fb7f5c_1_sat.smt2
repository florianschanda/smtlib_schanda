(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1101000001 #b111010100)
                arg1
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg1
                (fp #b0 #b1011100111 #b100011000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000101100 #b111000101)
                arg2
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b0001110111 #b010000001)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000010010 #b100001010)
                arg3
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg3
                (fp #b0 #b1111111110 #b111100110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011011111 #b000110111)
                expect
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                expect
                (fp #b0 #b1111111101 #b000000111)))

(assert (= expect result))

(check-sat)
(exit)
