(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b10010000001100 #b0111001000101)
                arg2
                (fp #b0 #b11011010010000 #b1101011001011)))
(assert (fp.leq (fp #b0 #b11011010010000 #b1101011001011)
                arg2
                (fp #b0 #b11110001110000 #b0011010010001)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
