(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0111100011101111 #b110101100000000)
                arg2
                (fp #b0 #b1011010110011111 #b101101010110110)))
(assert (fp.leq (fp #b0 #b1011010110011111 #b101101010110110)
                arg2
                (fp #b0 #b1101111000010100 #b111110111101000)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1000100101001000 #b100011001010101)
                arg3
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg3
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
