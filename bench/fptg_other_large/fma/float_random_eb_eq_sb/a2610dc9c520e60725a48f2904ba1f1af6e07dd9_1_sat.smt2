; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000110000 #b000101000)
                arg1
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b1111111110 #b111111110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011000000 #b001100000)
                arg2
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b1001000111 #b010001100)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
