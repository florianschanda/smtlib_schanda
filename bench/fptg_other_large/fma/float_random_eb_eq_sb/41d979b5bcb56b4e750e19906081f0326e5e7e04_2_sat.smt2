(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111011111110 #b000000110100010)
                arg1
                (fp #b1 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b0 #b0110010011001011 #b111001000100010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111010101011 #b101000001110001)
                arg2
                (fp #b1 #b0001100001101011 #b001110100011101)))
(assert (fp.leq (fp #b1 #b0001100001101011 #b001110100011101)
                arg2
                (fp #b0 #b0001101101100000 #b100010100000011)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110101000100110 #b001001111110101)
                expect
                (fp #b0 #b0001100001111011 #b001110100011101)))
(assert (fp.leq (fp #b0 #b0001100001111011 #b001110100011101)
                expect
                (fp #b0 #b0111010110010010 #b100101010111111)))

(assert (= expect result))

(check-sat)
(exit)
