; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00001001100101 #b1100110100101)
                arg1
                (fp #b0 #b11111010101101 #b1000111001100)))
(assert (fp.leq (fp #b0 #b11111010101101 #b1000111001100)
                arg1
                (fp #b0 #b11111010111111 #b1001000111001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101110100101 #b0011001110100)
                arg3
                (fp #b1 #b00001011101010 #b1100101101001)))
(assert (fp.leq (fp #b1 #b00001011101010 #b1100101101001)
                arg3
                (fp #b0 #b00010010101100 #b0110000010001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
