(assert (fp.leq (fp #b1 #b1111110111111000 #b110000110011011)
                arg3
                (fp #b0 #b0000000000000000 #b110011110110001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110011110110001)
                arg3
                (fp #b0 #b0100111111100110 #b001101000001111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111100110000000 #b010011000110100)
                expect
                (fp #b1 #b0000101000010100 #b100011000001110)))
(assert (fp.leq (fp #b1 #b0000101000010100 #b100011000001110)
                expect
                (fp #b0 #b0101111001111000 #b100011100100110)))

(assert (= expect result))

(check-sat)
(exit)
