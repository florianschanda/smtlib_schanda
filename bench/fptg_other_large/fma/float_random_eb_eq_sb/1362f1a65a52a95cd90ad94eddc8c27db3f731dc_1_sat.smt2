(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100101000111 #b11110110101)
                arg1
                (fp #b0 #b000110100001 #b00110110110)))
(assert (fp.leq (fp #b0 #b000110100001 #b00110110110)
                arg1
                (fp #b0 #b111111101010 #b00001010001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101010011 #b11011010000)
                arg2
                (fp #b1 #b000000000000 #b10001001100)))
(assert (fp.leq (fp #b1 #b000000000000 #b10001001100)
                arg2
                (fp #b0 #b110111100001 #b00111000110)))

(declare-const arg3 (_ FloatingPoint 12 12))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101110010 #b11111100001)
                expect
                (fp #b0 #b000000000000 #b10001001011)))
(assert (fp.leq (fp #b0 #b000000000000 #b10001001011)
                expect
                (fp #b0 #b101100110001 #b10010000001)))

(assert (= expect result))

(check-sat)
(exit)
