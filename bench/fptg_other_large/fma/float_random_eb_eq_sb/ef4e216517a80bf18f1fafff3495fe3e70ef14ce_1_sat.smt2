                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b110010001 #b10100100)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100000110 #b10011010)
                arg3
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg3
                (fp #b0 #b111111000 #b01000010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110001 #b10000010)
                expect
                (fp #b0 #b100000111 #b11111111)))
(assert (fp.leq (fp #b0 #b100000111 #b11111111)
                expect
                (fp #b0 #b111101000 #b10011110)))

(assert (= expect result))

(check-sat)
(exit)
