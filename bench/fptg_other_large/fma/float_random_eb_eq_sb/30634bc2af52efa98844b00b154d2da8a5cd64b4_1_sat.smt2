;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110001000011 #b10001101000101)
                arg1
                (fp #b1 #b000000000000000 #b11001101100011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11001101100011)
                arg1
                (fp #b0 #b111000110100110 #b00100101111110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011100101011111 #b00111011011010)
                arg2
                (fp #b1 #b011000011100001 #b01110100100110)))
(assert (fp.leq (fp #b1 #b011000011100001 #b01110100100110)
                arg2
                (fp #b0 #b001111000100100 #b11010110000011)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101001111000100 #b11010101001000)
                expect
                (fp #b1 #b011000011100001 #b01110100100101)))
(assert (fp.leq (fp #b1 #b011000011100001 #b01110100100101)
                expect
                (fp #b1 #b010101000011100 #b10100011110110)))

(assert (= expect result))

(check-sat)
(exit)
