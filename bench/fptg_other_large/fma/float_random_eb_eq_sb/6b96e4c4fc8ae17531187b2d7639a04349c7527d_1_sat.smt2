(assert (fp.leq (fp #b1 #b1110111001 #b010001000)
                arg3
                (fp #b1 #b1100101110 #b010110111)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110111)
                arg3
                (fp #b0 #b0111110100 #b101110111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000111 #b011001000)
                expect
                (fp #b1 #b1100101110 #b010110110)))
(assert (fp.leq (fp #b1 #b1100101110 #b010110110)
                expect
                (fp #b1 #b0001001101 #b101100111)))

(assert (= expect result))

(check-sat)
