(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010001 #b10110000)
                arg1
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                arg1
                (fp #b0 #b111111111 #b00000000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110111 #b00010010)
                arg2
                (fp #b1 #b010000111 #b11101000)))
(assert (fp.leq (fp #b1 #b010000111 #b11101000)
                arg2
                (fp #b0 #b011101000 #b01101011)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100011 #b10111010)
                expect
                (fp #b1 #b110000111 #b11100111)))
(assert (fp.leq (fp #b1 #b110000111 #b11100111)
                expect
                (fp #b1 #b001011111 #b00111010)))

(assert (= expect result))

(check-sat)
(exit)
