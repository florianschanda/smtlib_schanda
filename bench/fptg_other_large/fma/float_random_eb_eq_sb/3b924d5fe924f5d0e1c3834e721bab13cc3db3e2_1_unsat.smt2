; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100001101100111 #b011010111011010)
                arg2
                (fp #b1 #b0001100001101011 #b001110100011101)))
(assert (fp.leq (fp #b1 #b0001100001101011 #b001110100011101)
                arg2
                (fp #b0 #b0110011101110010 #b011000000011110)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1010001100010101 #b011100100101100)
                arg3
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg3
                (fp #b0 #b1111111111111110 #b100010011010100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
