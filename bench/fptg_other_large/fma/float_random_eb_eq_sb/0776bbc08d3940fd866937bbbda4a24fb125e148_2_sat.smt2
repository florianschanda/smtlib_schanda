                arg3
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                arg3
                (fp #b0 #b01100110100111 #b1110001011100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111000001011 #b0110011100110)
                expect
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                expect
                (fp #b0 #b10110010111110 #b0000000100101)))

(assert (= expect result))

(check-sat)
(exit)
