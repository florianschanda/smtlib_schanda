; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -INFINITY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010001000 #b01111101)
                arg1
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg1
                (fp #b0 #b111111110 #b00001111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b110010010 #b01000000)
                arg3
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg3
                (fp #b0 #b001001000 #b00010100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
