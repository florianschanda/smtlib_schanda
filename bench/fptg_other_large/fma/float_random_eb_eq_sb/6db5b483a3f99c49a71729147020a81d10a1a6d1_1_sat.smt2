(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101101100100010 #b010001010010011)
                arg1
                (fp #b1 #b0010000000101010 #b010110111111100)))
(assert (fp.leq (fp #b1 #b0010000000101010 #b010110111111100)
                arg1
                (fp #b0 #b1010110110010010 #b101011110100011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010100110110110 #b111110011100011)
                arg2
                (fp #b1 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000000000000)
                arg2
                (fp #b0 #b1001010110001100 #b100100011010100)))

(declare-const arg3 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1010010000001011 #b110111011001001)
                arg3
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg3
                (fp #b0 #b0011100000100000 #b010111001101110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111000001000110 #b000001001001100)
                expect
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b1011011010100101 #b011111101000100)))

(assert (= expect result))

(check-sat)
(exit)
