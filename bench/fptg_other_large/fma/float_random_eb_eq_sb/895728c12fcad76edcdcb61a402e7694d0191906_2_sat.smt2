; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000000000000)
                arg1
                (fp #b1 #b111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111111111111)
                arg1
                (fp #b0 #b110000001001110 #b01110000001100)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010111010100100 #b10111011000011)
                arg2
                (fp #b0 #b111111111111101 #b00000000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00000000000000)
                arg2
                (fp #b0 #b111111111111101 #b11000111001111)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010001111011101 #b10110101100001)
                arg3
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                arg3
                (fp #b0 #b001111100101001 #b10001011111001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
