                arg3
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg3
                (fp #b0 #b011001111 #b10010011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000111111 #b10010100)
                expect
                (fp #b0 #b000000000 #b01000001)))
(assert (fp.leq (fp #b0 #b000000000 #b01000001)
                expect
                (fp #b0 #b111100000 #b11010100)))

(assert (= expect result))

(check-sat)
(exit)
