                arg3
                (fp #b0 #b11100100110110 #b0111011111111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101101000101 #b1110010001001)
                expect
                (fp #b0 #b01111111111110 #b0100010001111)))
(assert (fp.leq (fp #b0 #b01111111111110 #b0100010001111)
                expect
                (fp #b0 #b10110110001011 #b1011010000101)))

(assert (= expect result))

(check-sat)
