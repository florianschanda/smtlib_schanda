; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011010111 #b111011101)
                arg1
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0011000101 #b001011101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                arg2
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                arg2
                (fp #b1 #b1110110100 #b000000101)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
