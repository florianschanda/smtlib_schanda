(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010000 #b00010101)
                arg2
                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b101111101 #b00010010)))

(declare-const arg3 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
