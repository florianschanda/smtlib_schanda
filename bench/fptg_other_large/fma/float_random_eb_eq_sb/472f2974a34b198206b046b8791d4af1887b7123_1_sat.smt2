; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001101111000 #b0000000111111)
                arg2
                (fp #b1 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000000000)
                arg2
                (fp #b0 #b01001000000101 #b1010111100001)))

(declare-const arg3 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b11001111101011 #b1110011110010)
                arg3
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg3
                (fp #b0 #b00110101111100 #b0001101111000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
