                arg2
                (fp #b1 #b011100000101101 #b01011010011110)))

(declare-const arg3 (_ FloatingPoint 15 15))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100111001001101 #b01001101111101)
                expect
                (fp #b1 #b100100000101011 #b10001111001110)))
(assert (fp.leq (fp #b1 #b100100000101011 #b10001111001110)
