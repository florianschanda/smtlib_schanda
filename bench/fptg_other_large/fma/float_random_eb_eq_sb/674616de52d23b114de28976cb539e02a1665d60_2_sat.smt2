(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101101011 #b111110110)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1010111110 #b101101001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1111010100 #b101111011)
                arg3
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg3
                (fp #b0 #b1111111101 #b110111000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010011101 #b111000110)
                expect
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                expect
                (fp #b0 #b1111111110 #b110011101)))

(assert (= expect result))

(check-sat)
(exit)
