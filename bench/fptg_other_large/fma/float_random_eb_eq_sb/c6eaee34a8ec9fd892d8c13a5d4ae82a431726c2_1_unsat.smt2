(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111110 #b0010011010)
                arg1
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg1
                (fp #b1 #b00101001001 #b0111011000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110101100 #b0011001010)
                arg2
                (fp #b0 #b01111001011 #b1100000011)))
(assert (fp.leq (fp #b0 #b01111001011 #b1100000011)
                arg2
                (fp #b0 #b11111110110 #b1011111111)))

(declare-const arg3 (_ FloatingPoint 11 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b0010011001)
                expect
                (fp #b1 #b11111001001 #b1100000010)))
(assert (fp.leq (fp #b1 #b11111001001 #b1100000010)
                expect
                (fp #b0 #b01111011010 #b1100111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
