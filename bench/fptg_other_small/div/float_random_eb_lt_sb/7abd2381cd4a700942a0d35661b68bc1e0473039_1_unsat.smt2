(declare-const expect (_ FloatingPoint 3 24))
(assert (fp.leq (fp #b1 #b000 #b10101001010110011110100)
                expect
                (fp #b0 #b010 #b11010011011111011101110)))
(assert (fp.leq (fp #b0 #b010 #b11010011011111011101110)
                expect
