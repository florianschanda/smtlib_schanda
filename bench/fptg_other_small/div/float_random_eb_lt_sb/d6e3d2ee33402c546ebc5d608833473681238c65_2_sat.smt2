                expect
                (fp #b0 #b0101 #b000101010001010101)))
(assert (fp.leq (fp #b0 #b0101 #b000101010001010101)
                expect
                (fp #b0 #b1101 #b111001111100100111)))
; expect = 0.27058887481689453125

(assert (= expect result))

