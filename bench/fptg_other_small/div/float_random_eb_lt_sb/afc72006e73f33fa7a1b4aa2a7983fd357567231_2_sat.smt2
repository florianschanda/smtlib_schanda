(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b0 #b000 #b00000011)
                arg1
                (fp #b0 #b101 #b10000000)))
(assert (fp.leq (fp #b0 #b101 #b10000000)
                arg1
                (fp #b0 #b110 #b00110100)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b011 #b01100011)
                arg2
                (fp #b0 #b000 #b01000000)))
(assert (fp.leq (fp #b0 #b000 #b01000000)
                arg2
                (fp #b0 #b001 #b00100000)))
; arg2 = 0.0625

(declare-const result (_ FloatingPoint 3 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
