(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 16))
(assert (fp.leq (fp #b0 #b01 #b011111011110000)
                arg1
                (fp #b0 #b10 #b111000100111010)))
(assert (fp.leq (fp #b0 #b10 #b111000100111010)
                arg1
                (fp #b0 #b10 #b111111011000111)))
; arg1 = 3.7691650390625

(declare-const arg2 (_ FloatingPoint 2 16))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 2 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01 #b011101011010110)
                expect
                (fp #b0 #b00 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00 #b000000000000000)
                expect
                (fp #b0 #b10 #b101101100101100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
