; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 23))
(assert (fp.leq (fp #b0 #b01110 #b0111100001000110101111)
                arg1
                (fp #b0 #b11110 #b1111111111111110000001)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111111110000001)
                arg1
                (fp #b0 #b11110 #b1111111111111111101000)))
; arg1 = 65535.0078125

(declare-const arg2 (_ FloatingPoint 5 23))
(assert (fp.leq (fp #b1 #b11110 #b1111111111111111110000)
                arg2
                (fp #b1 #b11110 #b1111111111111110000111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111111110000111)
                arg2
                (fp #b0 #b10100 #b1001000000111001100101)))
; arg2 = -65535.0546875

(declare-const result (_ FloatingPoint 5 23))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 23))
(assert (fp.leq (fp #b1 #b10000 #b1101010100010000110110)
                expect
                (fp #b1 #b01110 #b1111111111111111111001)))
(assert (fp.leq (fp #b1 #b01110 #b1111111111111111111001)
                expect
                (fp #b0 #b00110 #b1101001010001101010101)))
; expect = -0.99999916553497314453125

(assert (= expect result))

(check-sat)
(exit)
