(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 14))
(assert (fp.leq (fp #b1 #b10 #b1001000001010)
                arg1
                (fp #b1 #b01 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01 #b0000000000000)
                arg1
                (fp #b0 #b01 #b0011010101010)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 2 14))
(assert (fp.leq (fp #b0 #b00 #b1000111101101)
                arg2
                (fp #b0 #b10 #b0011000110101)))
(assert (fp.leq (fp #b0 #b10 #b0011000110101)
                arg2
                (fp #b0 #b10 #b0011101110010)))
; arg2 = 2.387939453125

(declare-const result (_ FloatingPoint 2 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 14))
(assert (fp.leq (fp #b1 #b10 #b0011010110000)
                expect
                (fp #b1 #b00 #b0110101100111)))
(assert (fp.leq (fp #b1 #b00 #b0110101100111)
                expect
                (fp #b0 #b01 #b1001100110001)))
; expect = -0.4188232421875

(assert (not (= expect result)))

(check-sat)
(exit)
