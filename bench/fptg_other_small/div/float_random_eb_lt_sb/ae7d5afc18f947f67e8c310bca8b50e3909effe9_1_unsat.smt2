(declare-const expect (_ FloatingPoint 3 21))
(assert (fp.leq (fp #b1 #b000 #b11110000101100010110)
                expect
                (fp #b0 #b110 #b11111111111111111111)))
(assert (fp.leq (fp #b0 #b110 #b11111111111111111111)
                expect
                (fp #b0 #b111 #b00000000000000000000)))
; expect = 15.99999237060546875

(assert (not (= expect result)))

