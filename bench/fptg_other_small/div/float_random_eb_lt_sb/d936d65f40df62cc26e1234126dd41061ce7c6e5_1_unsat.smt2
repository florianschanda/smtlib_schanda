                arg2
                (fp #b0 #b000 #b0000000001000000000000)))
(assert (fp.leq (fp #b0 #b000 #b0000000001000000000000)
                arg2
                (fp #b0 #b010 #b1011101110100010000011)))
; arg2 = 0.000244140625

(declare-const result (_ FloatingPoint 3 23))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 23))
(assert (fp.leq (fp #b1 #b111 #b0000000000000000000000)
                expect
                (fp #b1 #b110 #b1111111111111111111111)))
(assert (fp.leq (fp #b1 #b110 #b1111111111111111111111)
                expect
                (fp #b1 #b010 #b1111001111010101011110)))
; expect = -15.9999980926513671875

(assert (not (= expect result)))

(check-sat)
(exit)
