; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b1110 #b10100000101000111111)
                arg1
                (fp #b1 #b1101 #b00000000000000000000)))
(assert (fp.leq (fp #b1 #b1101 #b00000000000000000000)
                arg1
                (fp #b1 #b1000 #b10000010001011100101)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b0100 #b00101011011011110110)
                arg2
                (fp #b1 #b0000 #b01000000000000000000)))
(assert (fp.leq (fp #b1 #b0000 #b01000000000000000000)
                arg2
                (fp #b0 #b1100 #b00000011110101101011)))
; arg2 = -0.00390625

(declare-const result (_ FloatingPoint 4 21))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b0 #b0001 #b11010000110100000011)
                expect
                (fp #b0 #b1110 #b11111111111111111111)))
(assert (fp.leq (fp #b0 #b1110 #b11111111111111111111)
                expect
                (fp #b0 #b1111 #b00000000000000000000)))
; expect = 255.9998779296875

(assert (not (= expect result)))

(check-sat)
(exit)
