(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 2 4))
(assert (fp.leq (fp #b1 #b10 #b100)
                arg1
                (fp #b0 #b01 #b000)))
(assert (fp.leq (fp #b0 #b01 #b000)
                arg1
                (fp #b0 #b01 #b111)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 2 4))
(assert (fp.leq (fp #b1 #b01 #b100)
                arg2
                (fp #b1 #b00 #b111)))
(assert (fp.leq (fp #b1 #b00 #b111)
                arg2
                (fp #b1 #b00 #b011)))
; arg2 = -0.875

(declare-const result (_ FloatingPoint 2 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 4))
(assert (fp.leq (fp #b1 #b10 #b110)
                expect
                (fp #b1 #b01 #b010)))
(assert (fp.leq (fp #b1 #b01 #b010)
                expect
                (fp #b0 #b10 #b101)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
