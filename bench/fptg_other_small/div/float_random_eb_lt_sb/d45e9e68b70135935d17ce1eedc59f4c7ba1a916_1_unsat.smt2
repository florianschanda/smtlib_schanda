(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 10))
(assert (fp.leq (fp #b0 #b00 #b010001101)
                arg1
                (fp #b0 #b00 #b011110111)))
(assert (fp.leq (fp #b0 #b00 #b011110111)
                arg1
                (fp #b0 #b00 #b110110001)))
; arg1 = 0.482421875

(declare-const arg2 (_ FloatingPoint 2 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 2 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 10))
(assert (fp.leq (fp #b1 #b10 #b011000001)
                expect
                (fp #b0 #b01 #b000000000)))
(assert (fp.leq (fp #b0 #b01 #b000000000)
                expect
                (fp #b0 #b10 #b001100101)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
