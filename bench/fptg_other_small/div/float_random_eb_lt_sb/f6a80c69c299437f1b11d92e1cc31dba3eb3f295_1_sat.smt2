; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 14))
(assert (fp.leq (fp #b1 #b01010110 #b1010100001000)
                arg1
                (fp #b0 #b00000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000001)
                arg1
                (fp #b0 #b11110110 #b1001000000110)))
; arg1 = 0.0000000000000000000000000000000000000000014349296274686126806258990932888741184309882284815521502792379227031460686703212559223175048828125

(declare-const arg2 (_ FloatingPoint 8 14))
(assert (fp.leq (fp #b1 #b00010000 #b0000001001011)
                arg2
                (fp #b0 #b10111110 #b0111101110010)))
(assert (fp.leq (fp #b0 #b10111110 #b0111101110010)
                arg2
                (fp #b0 #b11010100 #b1001111100100)))
; arg2 = 13675180268510511104.0

(declare-const result (_ FloatingPoint 8 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11110110 #b1110111110000)
                expect
                (fp #b0 #b00000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000000)
                expect
                (fp #b0 #b11000110 #b0111001000100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
