; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0000001 #b101)
                arg1
                (fp #b0 #b1000010 #b111)))
(assert (fp.leq (fp #b0 #b1000010 #b111)
                arg1
                (fp #b0 #b1110011 #b110)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1100101 #b110)
                arg2
                (fp #b1 #b1000010 #b100)))
(assert (fp.leq (fp #b1 #b1000010 #b100)
                arg2
                (fp #b0 #b1110000 #b110)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1011110 #b101)
                expect
                (fp #b1 #b0111111 #b010)))
(assert (fp.leq (fp #b1 #b0111111 #b010)
                expect
                (fp #b1 #b0000011 #b010)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
