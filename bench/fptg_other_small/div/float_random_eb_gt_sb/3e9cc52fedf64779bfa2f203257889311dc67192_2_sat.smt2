                arg2
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg2
                (fp #b0 #b11111001 #b101010)))
; arg2 = 128.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11100111 #b011111)
                expect
                (fp #b0 #b00000000 #b000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000001)
                expect
                (fp #b0 #b00100000 #b001000)))
; expect = 0.000000000000000000000000000000000000000183670992315982423120115083940975887159166493245638675235742454106002696789801120758056640625

(assert (= expect result))

