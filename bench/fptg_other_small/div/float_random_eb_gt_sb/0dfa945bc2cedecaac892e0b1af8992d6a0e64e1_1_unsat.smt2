(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01110 #b11)
                arg1
                (fp #b0 #b01111 #b11)))
(assert (fp.leq (fp #b0 #b01111 #b11)
                arg1
                (fp #b0 #b10100 #b11)))
; arg1 = 1.75

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10111 #b10)
                arg2
                (fp #b1 #b00000 #b00)))
(assert (fp.leq (fp #b1 #b00000 #b00)
                arg2
                (fp #b0 #b00110 #b01)))
; arg2 = -0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
