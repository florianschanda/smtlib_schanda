(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110000 #b10)
                arg1
                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg1
                (fp #b0 #b100000 #b01)))
; arg1 = 0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b110111 #b11)
                arg2
                (fp #b0 #b111000 #b01)))
(assert (fp.leq (fp #b0 #b111000 #b01)
                arg2
                (fp #b0 #b111011 #b11)))
; arg2 = 41943040.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000000 #b01)
                expect
                (fp #b0 #b000000 #b00)))
(assert (fp.leq (fp #b0 #b000000 #b00)
                expect
                (fp #b0 #b100100 #b10)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
