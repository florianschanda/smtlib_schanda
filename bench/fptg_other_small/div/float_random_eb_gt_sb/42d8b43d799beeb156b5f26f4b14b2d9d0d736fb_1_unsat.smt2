(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10011111 #b101)
                arg2
                (fp #b0 #b00000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000 #b111)
                arg2
                (fp #b0 #b01000001 #b010)))
; arg2 = 0.000000000000000000000000000000000000010285575569695015694726444700694649680913323621755765813201577429936151020228862762451171875

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
