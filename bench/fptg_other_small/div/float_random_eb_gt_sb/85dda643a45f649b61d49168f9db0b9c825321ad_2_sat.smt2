(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11010 #b01)
                arg1
                (fp #b0 #b01000 #b00)))
(assert (fp.leq (fp #b0 #b01000 #b00)
                arg1
                (fp #b0 #b11110 #b10)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00110 #b10)
                arg2
                (fp #b0 #b10110 #b11)))
(assert (fp.leq (fp #b0 #b10110 #b11)
                arg2
                (fp #b0 #b11010 #b11)))
; arg2 = 224.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00001 #b00)
                expect
                (fp #b0 #b00000 #b11)))
(assert (fp.leq (fp #b0 #b00000 #b11)
                expect
                (fp #b0 #b01101 #b11)))
; expect = 0.0000457763671875

(assert (= expect result))

(check-sat)
(exit)
