                arg2
                (fp #b0 #b0000001 #b00000)))
(assert (fp.leq (fp #b0 #b0000001 #b00000)
                arg2
                (fp #b0 #b0100101 #b00110)))
; arg2 = 0.00000000000000000021684043449710088680149056017398834228515625

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
