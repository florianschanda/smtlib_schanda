                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg1
                (fp #b0 #b0110000 #b00110)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 7 6))
