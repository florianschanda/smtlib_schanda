(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01011 #b101)
                arg1
                (fp #b0 #b01111 #b000)))
(assert (fp.leq (fp #b0 #b01111 #b000)
                arg1
                (fp #b0 #b11110 #b100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b110)
                arg2
                (fp #b0 #b00000 #b111)))
(assert (fp.leq (fp #b0 #b00000 #b111)
                arg2
                (fp #b0 #b01101 #b000)))
; arg2 = 0.00005340576171875

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b011)
                expect
                (fp #b0 #b11101 #b001)))
(assert (fp.leq (fp #b0 #b11101 #b001)
                expect
                (fp #b0 #b11110 #b110)))
; expect = 18432.0

(assert (= expect result))

(check-sat)
(exit)
