(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b000011 #b0100)
                arg1
                (fp #b0 #b011111 #b0100)))
(assert (fp.leq (fp #b0 #b011111 #b0100)
                arg1
                (fp #b0 #b101100 #b1101)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100011 #b1101)
                arg2
                (fp #b1 #b011111 #b0000)))
(assert (fp.leq (fp #b1 #b011111 #b0000)
                arg2
                (fp #b1 #b010110 #b1001)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110110 #b1110)
                expect
                (fp #b1 #b011111 #b0100)))
(assert (fp.leq (fp #b1 #b011111 #b0100)
                expect
                (fp #b0 #b110001 #b0001)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
