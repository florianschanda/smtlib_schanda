(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111000 #b010)
                arg1
                (fp #b0 #b011010 #b000)))
(assert (fp.leq (fp #b0 #b011010 #b000)
                arg1
                (fp #b0 #b100010 #b111)))
; arg1 = 0.03125

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010010 #b111)
                arg2
                (fp #b0 #b111110 #b111)))
(assert (fp.leq (fp #b0 #b111110 #b111)
                arg2
                (fp #b0 #b111111 #b000)))
; arg2 = 4026531840.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111000 #b010)
                expect
                (fp #b0 #b000000 #b001)))
(assert (fp.leq (fp #b0 #b000000 #b001)
                expect
                (fp #b0 #b001100 #b001)))
; expect = 0.000000000116415321826934814453125

(assert (= expect result))

(check-sat)
(exit)
