(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11000 #b110)
                arg1
                (fp #b1 #b10010 #b110)))
(assert (fp.leq (fp #b1 #b10010 #b110)
                arg1
                (fp #b0 #b11010 #b010)))
; arg1 = -14.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00111 #b010)
                arg2
                (fp #b0 #b10111 #b001)))
(assert (fp.leq (fp #b0 #b10111 #b001)
                arg2
                (fp #b0 #b11101 #b011)))
; arg2 = 288.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b110)
                expect
                (fp #b1 #b01010 #b101)))
(assert (fp.leq (fp #b1 #b01010 #b101)
                expect
                (fp #b1 #b00111 #b101)))
; expect = -0.05078125

(assert (not (= expect result)))

(check-sat)
(exit)
