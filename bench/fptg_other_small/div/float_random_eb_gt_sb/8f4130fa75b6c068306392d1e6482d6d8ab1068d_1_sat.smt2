(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00110 #b011)
                arg1
                (fp #b0 #b01000 #b000)))
(assert (fp.leq (fp #b0 #b01000 #b000)
                arg1
                (fp #b0 #b01001 #b110)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01101 #b011)
                arg2
                (fp #b1 #b00100 #b000)))
(assert (fp.leq (fp #b1 #b00100 #b000)
                arg2
                (fp #b0 #b11100 #b111)))
; arg2 = -0.00048828125

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b100)
                expect
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                expect
                (fp #b1 #b00011 #b110)))
; expect = -16.0

(assert (= expect result))

(check-sat)
(exit)
