(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1000 #b1)
                arg1
                (fp #b0 #b0110 #b0)))
(assert (fp.leq (fp #b0 #b0110 #b0)
                arg1
                (fp #b0 #b1110 #b0)))
; arg1 = 0.5

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b1)
                arg2
                (fp #b0 #b1000 #b1)))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg2
                (fp #b0 #b1101 #b0)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b0100 #b0)
                expect
                (fp #b0 #b0100 #b1)))
(assert (fp.leq (fp #b0 #b0100 #b1)
                expect
                (fp #b0 #b1101 #b1)))
; expect = 0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
