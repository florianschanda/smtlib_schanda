(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111100 #b00111)
                expect
                (fp #b1 #b11110111 #b00010)))
(assert (fp.leq (fp #b1 #b11110111 #b00010)
                expect
                (fp #b0 #b01010101 #b01001)))
; expect = -1412304745521473114960295001547866112.0

