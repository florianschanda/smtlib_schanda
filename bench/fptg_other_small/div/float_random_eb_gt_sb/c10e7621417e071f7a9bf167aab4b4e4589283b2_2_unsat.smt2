; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11100001 #b1001)
                arg1
                (fp #b1 #b11011000 #b0100)))
(assert (fp.leq (fp #b1 #b11011000 #b0100)
                arg1
                (fp #b0 #b01101110 #b1001)))
; arg1 = -773712524553362671811952640.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01001000 #b0111)
                arg2
                (fp #b0 #b00000000 #b0111)))
(assert (fp.leq (fp #b0 #b00000000 #b0111)
                arg2
                (fp #b0 #b01001110 #b0101)))
; arg2 = 0.0000000000000000000000000000000000000051427877848475078473632223503473248404566618108778829066007887149680755101144313812255859375

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
