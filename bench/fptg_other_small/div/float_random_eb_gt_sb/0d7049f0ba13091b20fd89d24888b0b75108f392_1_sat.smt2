                arg2
                (fp #b1 #b0000000 #b011)))
(assert (fp.leq (fp #b1 #b0000000 #b011)
                arg2
                (fp #b0 #b0000111 #b000)))
; arg2 = -0.00000000000000000008131516293641283255055896006524562835693359375

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111111 #b000)
                expect
                (fp #b1 #b1111110 #b111)))
(assert (fp.leq (fp #b1 #b1111110 #b111)
                expect
                (fp #b0 #b0100100 #b110)))
; expect = -17293822569102704640.0

(assert (= expect result))

(check-sat)
