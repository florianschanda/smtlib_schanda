(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000011 #b100)
                arg1
                (fp #b0 #b001110 #b011)))
(assert (fp.leq (fp #b0 #b001110 #b011)
                arg1
                (fp #b0 #b010000 #b011)))
; arg1 = 0.00001049041748046875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b111)
                arg2
                (fp #b1 #b011111 #b101)))
(assert (fp.leq (fp #b1 #b011111 #b101)
                arg2
                (fp #b0 #b111010 #b101)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101000 #b110)
                expect
                (fp #b1 #b001101 #b101)))
(assert (fp.leq (fp #b1 #b001101 #b101)
                expect
                (fp #b0 #b100000 #b100)))
; expect = -0.000006198883056640625

(assert (= expect result))

(check-sat)
(exit)
