(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10101011 #b11001)
                arg1
                (fp #b1 #b01111111 #b00000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000)
                arg1
                (fp #b1 #b00011010 #b11011)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111111 #b00000)
                arg2
                (fp #b1 #b11111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111)
                arg2
                (fp #b1 #b00110011 #b11011)))
; arg2 = -334965454937798799971759379190646833152.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10011100 #b11011)
                expect
                (fp #b0 #b00000000 #b01001)))
(assert (fp.leq (fp #b0 #b00000000 #b01001)
                expect
                (fp #b0 #b01100101 #b11101)))
; expect = 0.00000000000000000000000000000000000000330607786168768361616207151093756596886499687842149615424336417390804854221642017364501953125

(assert (= expect result))

(check-sat)
(exit)
