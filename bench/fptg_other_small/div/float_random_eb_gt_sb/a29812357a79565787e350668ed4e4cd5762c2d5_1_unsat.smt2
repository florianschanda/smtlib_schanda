(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110000 #b10101)
                arg1
                (fp #b1 #b1000100 #b10101)))
(assert (fp.leq (fp #b1 #b1000100 #b10101)
                arg1
                (fp #b0 #b0110000 #b11100)))
; arg1 = -53.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0001110 #b01111)
                arg2
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg2
                (fp #b0 #b1011000 #b10011)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
