(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000101 #b100)
                arg1
                (fp #b0 #b100010 #b111)))
(assert (fp.leq (fp #b0 #b100010 #b111)
                arg1
                (fp #b0 #b100011 #b011)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b001001 #b101)
                arg2
                (fp #b0 #b011111 #b101)))
(assert (fp.leq (fp #b0 #b011111 #b101)
                arg2
                (fp #b0 #b111000 #b011)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110100 #b010)
                expect
                (fp #b0 #b100010 #b010)))
(assert (fp.leq (fp #b0 #b100010 #b010)
                expect
                (fp #b0 #b100010 #b011)))
; expect = 10.0

(assert (not (= expect result)))

(check-sat)
(exit)
