(assert (fp.leq (fp #b0 #b0111111 #b110)
                arg2
                (fp #b0 #b1110010 #b111)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1000001 #b000)
                expect
                (fp #b0 #b0000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000 #b010)
                expect
                (fp #b0 #b1101011 #b101)))
; expect = 0.0000000000000000000542101086242752217003726400434970855712890625

(assert (not (= expect result)))

