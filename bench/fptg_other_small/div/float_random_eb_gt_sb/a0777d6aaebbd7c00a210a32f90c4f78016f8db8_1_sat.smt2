(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10100000 #b000000)
                arg1
                (fp #b1 #b00000000 #b100100)))
(assert (fp.leq (fp #b1 #b00000000 #b100100)
                arg1
                (fp #b0 #b01000100 #b000111)))
; arg1 = -0.0000000000000000000000000000000000000066121557233753672323241430218751319377299937568429923084867283478160970844328403472900390625

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b10111100 #b110110)
                arg2
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg2
                (fp #b0 #b11111101 #b010111)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10010000 #b001110)
                expect
                (fp #b1 #b00000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000)
                expect
                (fp #b0 #b11010001 #b100111)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
