                (fp #b0 #b0000010 #b11101)))
(assert (fp.leq (fp #b0 #b0000010 #b11101)
                expect
                (fp #b0 #b1010101 #b00101)))
; expect = 0.000000000000000000826704156520197130930682760663330554962158203125

