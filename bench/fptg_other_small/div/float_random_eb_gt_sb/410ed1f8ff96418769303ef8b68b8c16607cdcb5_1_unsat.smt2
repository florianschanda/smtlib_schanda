(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010111 #b110)
                arg1
                (fp #b0 #b100010 #b000)))
(assert (fp.leq (fp #b0 #b100010 #b000)
                arg1
                (fp #b0 #b110010 #b010)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000101 #b101)
                arg2
                (fp #b0 #b011111 #b101)))
(assert (fp.leq (fp #b0 #b011111 #b101)
                arg2
                (fp #b0 #b100001 #b111)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000100 #b100)
                expect
                (fp #b0 #b100001 #b001)))
(assert (fp.leq (fp #b0 #b100001 #b001)
                expect
                (fp #b0 #b110110 #b000)))
; expect = 4.5

(assert (not (= expect result)))

(check-sat)
(exit)
