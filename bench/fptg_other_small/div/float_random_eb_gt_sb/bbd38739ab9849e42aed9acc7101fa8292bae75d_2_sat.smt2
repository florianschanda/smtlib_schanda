(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b000)
                arg1
                (fp #b1 #b10110 #b011)))
(assert (fp.leq (fp #b1 #b10110 #b011)
                arg1
                (fp #b1 #b10010 #b011)))
; arg1 = -176.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00011 #b111)
                arg2
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                arg2
                (fp #b0 #b11111 #b000)))
; arg2 = 61440.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10010 #b101)
                expect
                (fp #b1 #b00110 #b100)))
(assert (fp.leq (fp #b1 #b00110 #b100)
                expect
                (fp #b0 #b00001 #b010)))
; expect = -0.0029296875

(assert (= expect result))

(check-sat)
(exit)
