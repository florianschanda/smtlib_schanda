(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1101 #b1)
                arg1
                (fp #b1 #b1010 #b1)))
(assert (fp.leq (fp #b1 #b1010 #b1)
                arg1
                (fp #b1 #b1000 #b0)))
; arg1 = -12.0

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1010 #b0)
                arg2
                (fp #b0 #b0000 #b0)))
(assert (fp.leq (fp #b0 #b0000 #b0)
                arg2
                (fp #b0 #b0001 #b0)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
