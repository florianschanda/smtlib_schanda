(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b110)
                arg1
                (fp #b1 #b11110 #b100)))
(assert (fp.leq (fp #b1 #b11110 #b100)
                arg1
                (fp #b0 #b11010 #b010)))
; arg1 = -49152.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01000 #b000)
                arg2
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg2
                (fp #b0 #b01000 #b000)))
; arg2 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b001)
                expect
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                expect
                (fp #b0 #b11111 #b000)))
; expect = 61440.0

(assert (not (= expect result)))

(check-sat)
(exit)
