(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b10)
                arg1
                (fp #b1 #b01111 #b01)))
(assert (fp.leq (fp #b1 #b01111 #b01)
                arg1
                (fp #b0 #b11000 #b00)))
; arg1 = -1.25

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11010 #b10)
                arg2
                (fp #b1 #b01110 #b10)))
(assert (fp.leq (fp #b1 #b01110 #b10)
                arg2
                (fp #b0 #b01101 #b10)))
; arg2 = -0.75

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00100 #b01)
                expect
                (fp #b0 #b01111 #b11)))
(assert (fp.leq (fp #b0 #b01111 #b11)
                expect
                (fp #b0 #b11100 #b00)))
; expect = 1.75

(assert (not (= expect result)))

(check-sat)
(exit)
