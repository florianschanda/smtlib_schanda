(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0011 #b00)
                arg1
                (fp #b0 #b1100 #b11)))
(assert (fp.leq (fp #b0 #b1100 #b11)
                arg1
                (fp #b0 #b1101 #b10)))
; arg1 = 56.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0101 #b01)
                arg2
                (fp #b1 #b0100 #b00)))
(assert (fp.leq (fp #b1 #b0100 #b00)
                arg2
                (fp #b1 #b0000 #b00)))
; arg2 = -0.125

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
