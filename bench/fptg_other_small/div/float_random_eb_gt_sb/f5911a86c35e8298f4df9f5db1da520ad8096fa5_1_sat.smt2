(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b0)
                arg1
                (fp #b1 #b10101 #b1)))
(assert (fp.leq (fp #b1 #b10101 #b1)
                arg1
                (fp #b1 #b01101 #b1)))
; arg1 = -96.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg2
                (fp #b1 #b11110 #b1)))
(assert (fp.leq (fp #b1 #b11110 #b1)
                arg2
                (fp #b0 #b10111 #b1)))
; arg2 = -49152.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01110 #b1)
                expect
                (fp #b0 #b00110 #b0)))
(assert (fp.leq (fp #b0 #b00110 #b0)
                expect
                (fp #b0 #b11000 #b0)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
