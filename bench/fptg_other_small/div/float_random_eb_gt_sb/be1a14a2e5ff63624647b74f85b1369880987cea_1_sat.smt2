(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00100101 #b1)
                arg1
                (fp #b0 #b00000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000 #b1)
                arg1
                (fp #b0 #b10110001 #b0)))
; arg1 = 0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b01101000 #b1)
                arg2
                (fp #b0 #b11011111 #b0)))
(assert (fp.leq (fp #b0 #b11011111 #b0)
                arg2
                (fp #b0 #b11100000 #b1)))
; arg2 = 79228162514264337593543950336.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10101010 #b0)
                expect
                (fp #b0 #b00000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000 #b0)
                expect
                (fp #b0 #b00100101 #b1)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
