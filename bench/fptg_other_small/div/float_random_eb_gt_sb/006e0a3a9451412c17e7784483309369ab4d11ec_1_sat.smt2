(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100111 #b0001)
                arg1
                (fp #b0 #b100100 #b0000)))
(assert (fp.leq (fp #b0 #b100100 #b0000)
                arg1
                (fp #b0 #b111101 #b0101)))
; arg1 = 32.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b011000 #b0110)
                arg2
                (fp #b1 #b000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000 #b0000)
                arg2
                (fp #b0 #b100101 #b0110)))
; arg2 = -0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
