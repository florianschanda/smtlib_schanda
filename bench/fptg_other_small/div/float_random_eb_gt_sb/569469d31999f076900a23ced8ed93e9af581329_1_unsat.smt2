(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101100 #b0011)
                expect
                (fp #b1 #b0000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000)
                expect
                (fp #b0 #b1101100 #b1101)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
