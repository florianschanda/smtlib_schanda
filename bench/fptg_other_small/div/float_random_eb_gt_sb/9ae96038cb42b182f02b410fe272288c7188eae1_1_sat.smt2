                arg2
                (fp #b0 #b1011000 #b1100)))
; arg2 = -131941395333120.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0110100 #b0011)
                expect
                (fp #b1 #b0010000 #b0111)))
(assert (fp.leq (fp #b1 #b0010000 #b0111)
                expect
                (fp #b1 #b0010000 #b0000)))
; expect = -0.000000000000010214051826551440171897411346435546875

(assert (= expect result))

