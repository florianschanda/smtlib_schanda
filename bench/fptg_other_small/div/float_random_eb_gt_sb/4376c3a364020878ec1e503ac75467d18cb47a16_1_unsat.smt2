; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00011 #b11)
                arg1
                (fp #b0 #b00111 #b00)))
(assert (fp.leq (fp #b0 #b00111 #b00)
                arg1
                (fp #b0 #b11000 #b10)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10101 #b01)
                arg2
                (fp #b1 #b00000 #b10)))
(assert (fp.leq (fp #b1 #b00000 #b10)
                arg2
                (fp #b0 #b01010 #b11)))
; arg2 = -0.000030517578125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11010 #b11)
                expect
                (fp #b1 #b10110 #b00)))
(assert (fp.leq (fp #b1 #b10110 #b00)
                expect
                (fp #b0 #b10010 #b10)))
; expect = -128.0

(assert (not (= expect result)))

(check-sat)
(exit)
