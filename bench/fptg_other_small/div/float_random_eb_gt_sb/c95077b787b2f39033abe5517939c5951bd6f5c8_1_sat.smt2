(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110001 #b0101)
                arg1
                (fp #b0 #b011111 #b0110)))
(assert (fp.leq (fp #b0 #b011111 #b0110)
                arg1
                (fp #b0 #b011111 #b1000)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110001 #b0000)
                arg2
                (fp #b0 #b000000 #b1111)))
(assert (fp.leq (fp #b0 #b000000 #b1111)
                arg2
                (fp #b0 #b010110 #b0110)))
; arg2 = 0.0000000008731149137020111083984375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110100 #b1100)
                expect
                (fp #b0 #b111101 #b0111)))
(assert (fp.leq (fp #b0 #b111101 #b0111)
                expect
                (fp #b0 #b111101 #b1101)))
; expect = 1543503872.0

(assert (= expect result))

(check-sat)
(exit)
