; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11100001 #b101)
                arg1
                (fp #b0 #b00000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000 #b001)
                arg1
                (fp #b0 #b11010011 #b000)))
; arg1 = 0.000000000000000000000000000000000000001469367938527859384960920671527807097273331945965109401885939632848021574318408966064453125

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b01001110 #b110)
                arg2
                (fp #b0 #b11111110 #b111)))
(assert (fp.leq (fp #b0 #b11111110 #b111)
                arg2
                (fp #b0 #b11111111 #b000)))
; arg2 = 319014718988379809496913694467282698240.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00100011 #b101)
                expect
                (fp #b0 #b00000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000 #b001)
                expect
                (fp #b0 #b01001100 #b110)))
; expect = 0.000000000000000000000000000000000000001469367938527859384960920671527807097273331945965109401885939632848021574318408966064453125

(assert (= expect result))

(check-sat)
(exit)
