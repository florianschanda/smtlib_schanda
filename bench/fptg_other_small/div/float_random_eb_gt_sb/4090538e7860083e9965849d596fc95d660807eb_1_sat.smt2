(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10010111 #b0101)
                arg1
                (fp #b1 #b10000001 #b1000)))
(assert (fp.leq (fp #b1 #b10000001 #b1000)
                arg1
                (fp #b0 #b11011111 #b0000)))
; arg1 = -6.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00100011 #b1001)
                arg2
                (fp #b0 #b10000011 #b0001)))
(assert (fp.leq (fp #b0 #b10000011 #b0001)
                arg2
                (fp #b0 #b10010110 #b0101)))
; arg2 = 17.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11011100 #b0001)
                expect
                (fp #b1 #b01111101 #b0110)))
(assert (fp.leq (fp #b1 #b01111101 #b0110)
                expect
                (fp #b1 #b01111011 #b1110)))
; expect = -0.34375

(assert (= expect result))

(check-sat)
(exit)
