; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11100000 #b0111)
                arg1
                (fp #b1 #b11011000 #b0100)))
(assert (fp.leq (fp #b1 #b11011000 #b0100)
                arg1
                (fp #b0 #b00001101 #b1010)))
; arg1 = -773712524553362671811952640.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00100000 #b1110)
                arg2
                (fp #b0 #b10111110 #b1111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111)
                arg2
                (fp #b0 #b11100010 #b1010)))
; arg2 = 17870283321406128128.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10100001 #b1001)
                expect
                (fp #b1 #b10011000 #b0100)))
(assert (fp.leq (fp #b1 #b10011000 #b0100)
                expect
                (fp #b0 #b00010110 #b1000)))
; expect = -41943040.0

(assert (not (= expect result)))

(check-sat)
(exit)
