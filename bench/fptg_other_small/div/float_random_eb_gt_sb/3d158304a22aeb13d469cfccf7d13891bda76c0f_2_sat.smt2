; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1001000 #b1)
                arg1
                (fp #b1 #b0111111 #b1)))
(assert (fp.leq (fp #b1 #b0111111 #b1)
                arg1
                (fp #b0 #b1000101 #b0)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1111111 #b0)
                arg2
                (fp #b1 #b1111110 #b0)))
(assert (fp.leq (fp #b1 #b1111110 #b0)
                arg2
                (fp #b1 #b1011000 #b1)))
; arg2 = -9223372036854775808.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1000110 #b0)
                expect
                (fp #b0 #b0000001 #b0)))
(assert (fp.leq (fp #b0 #b0000001 #b0)
                expect
                (fp #b0 #b0010110 #b1)))
; expect = 0.00000000000000000021684043449710088680149056017398834228515625

(assert (= expect result))

(check-sat)
(exit)
