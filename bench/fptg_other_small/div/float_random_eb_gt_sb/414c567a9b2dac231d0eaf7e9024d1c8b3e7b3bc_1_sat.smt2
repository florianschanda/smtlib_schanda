                arg2
                (fp #b0 #b0001110 #b1000)))
; arg2 = -131941395333120.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000101 #b1011)
                expect
                (fp #b1 #b0010101 #b0001)))
(assert (fp.leq (fp #b1 #b0010101 #b0001)
                expect
                (fp #b0 #b0101111 #b1101)))
; expect = -0.0000000000002415845301584340631961822509765625

(assert (= expect result))

