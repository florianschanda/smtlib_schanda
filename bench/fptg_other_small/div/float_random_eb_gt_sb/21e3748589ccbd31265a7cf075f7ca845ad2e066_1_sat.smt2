(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01010011 #b110)
                arg1
                (fp #b0 #b10011011 #b011)))
(assert (fp.leq (fp #b0 #b10011011 #b011)
                arg1
                (fp #b0 #b11110101 #b011)))
; arg1 = 369098752.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00110111 #b100)
                arg2
                (fp #b1 #b00000000 #b011)))
(assert (fp.leq (fp #b1 #b00000000 #b011)
                arg2
                (fp #b0 #b10100101 #b010)))
; arg2 = -0.000000000000000000000000000000000000004408103815583578154882762014583421291819995837895328205657818898544064722955226898193359375

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                expect
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                expect
                (fp #b0 #b10111001 #b100)))
; expect = -319014718988379809496913694467282698240.0

(assert (= expect result))

(check-sat)
(exit)
