;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1000011 #b0)
                arg1
                (fp #b1 #b0111111 #b1)))
(assert (fp.leq (fp #b1 #b0111111 #b1)
