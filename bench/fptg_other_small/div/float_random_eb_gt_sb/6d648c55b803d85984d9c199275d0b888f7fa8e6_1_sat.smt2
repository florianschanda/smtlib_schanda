                (fp #b1 #b0011111 #b1)))
(assert (fp.leq (fp #b1 #b0011111 #b1)
                arg2
                (fp #b0 #b1001011 #b1)))
; arg2 = -0.000000000349245965480804443359375

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1011011 #b1)
                expect
                (fp #b0 #b1011111 #b0)))
(assert (fp.leq (fp #b0 #b1011111 #b0)
                expect
                (fp #b0 #b1110101 #b0)))
; expect = 4294967296.0

(assert (= expect result))

(check-sat)
