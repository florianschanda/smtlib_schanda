(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b00001 #b1)
                arg1
                (fp #b0 #b00101 #b1)))
(assert (fp.leq (fp #b0 #b00101 #b1)
                arg1
                (fp #b0 #b10010 #b1)))
; arg1 = 0.00146484375

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                arg2
                (fp #b1 #b11011 #b0)))
(assert (fp.leq (fp #b1 #b11011 #b0)
                arg2
                (fp #b1 #b01011 #b0)))
; arg2 = -4096.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10010 #b0)
                expect
                (fp #b1 #b00000 #b1)))
(assert (fp.leq (fp #b1 #b00000 #b1)
                expect
                (fp #b0 #b01011 #b0)))
; expect = -0.000030517578125

(assert (= expect result))

(check-sat)
(exit)
