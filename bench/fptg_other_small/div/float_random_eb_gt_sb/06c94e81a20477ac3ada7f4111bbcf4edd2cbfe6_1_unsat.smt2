; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00011111 #b010100)
                arg1
                (fp #b0 #b01111111 #b000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000)
                arg1
                (fp #b0 #b10010011 #b110100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11001101 #b010000)
                arg2
                (fp #b1 #b10000110 #b000000)))
(assert (fp.leq (fp #b1 #b10000110 #b000000)
                arg2
                (fp #b0 #b00011001 #b000110)))
; arg2 = -128.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10101011 #b011111)
                expect
                (fp #b1 #b01111000 #b000000)))
(assert (fp.leq (fp #b1 #b01111000 #b000000)
                expect
                (fp #b0 #b01001110 #b010010)))
; expect = -0.0078125

(assert (not (= expect result)))

(check-sat)
(exit)
