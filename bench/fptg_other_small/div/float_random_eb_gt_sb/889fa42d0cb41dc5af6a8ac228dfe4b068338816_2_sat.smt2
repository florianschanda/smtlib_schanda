(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111111 #b000)
                arg1
                (fp #b1 #b111110 #b111)))
(assert (fp.leq (fp #b1 #b111110 #b111)
                arg1
                (fp #b1 #b000000 #b000)))
; arg1 = -4026531840.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100011 #b001)
                arg2
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg2
                (fp #b1 #b010011 #b001)))
; arg2 = -9.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001011 #b011)
                expect
                (fp #b0 #b111011 #b110)))
(assert (fp.leq (fp #b0 #b111011 #b110)
                expect
                (fp #b0 #b111110 #b110)))
; expect = 469762048.0

(assert (= expect result))

(check-sat)
(exit)
