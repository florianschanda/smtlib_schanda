(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b11)
                arg1
                (fp #b1 #b0000 #b01)))
(assert (fp.leq (fp #b1 #b0000 #b01)
                arg1
                (fp #b0 #b0110 #b01)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg2
                (fp #b0 #b1001 #b10)))
(assert (fp.leq (fp #b0 #b1001 #b10)
                arg2
                (fp #b0 #b1010 #b10)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0111 #b00)
                expect
                (fp #b1 #b0000 #b00)))
(assert (fp.leq (fp #b1 #b0000 #b00)
                expect
                (fp #b0 #b0111 #b11)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
