(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b01010111 #b010010)
                arg1
                (fp #b0 #b01111111 #b111111)))
(assert (fp.leq (fp #b0 #b01111111 #b111111)
                arg1
                (fp #b0 #b10010100 #b100101)))
; arg1 = 1.984375

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10111101 #b011111)
                arg2
                (fp #b1 #b01111111 #b001000)))
(assert (fp.leq (fp #b1 #b01111111 #b001000)
                arg2
                (fp #b0 #b11001110 #b011001)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10011011 #b011010)
                expect
                (fp #b1 #b01111111 #b110001)))
(assert (fp.leq (fp #b1 #b01111111 #b110001)
                expect
                (fp #b0 #b10010100 #b111001)))
; expect = -1.765625

(assert (= expect result))

(check-sat)
(exit)
