(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01101110 #b1000)
                arg1
                (fp #b0 #b00000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000 #b0100)
                arg1
                (fp #b0 #b01110000 #b0111)))
; arg1 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11010010 #b0001)
                arg2
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                arg2
                (fp #b0 #b00010000 #b1111)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
