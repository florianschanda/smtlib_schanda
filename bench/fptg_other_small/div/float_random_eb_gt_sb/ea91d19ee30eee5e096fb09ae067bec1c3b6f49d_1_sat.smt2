(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01010110 #b010)
                arg1
                (fp #b1 #b00110001 #b011)))
(assert (fp.leq (fp #b1 #b00110001 #b011)
                arg1
                (fp #b0 #b11101001 #b100)))
; arg1 = -0.000000000000000000000004549493369041652211792747806384795694611966609954833984375

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b10000000 #b010)
                arg2
                (fp #b0 #b11100000 #b001)))
(assert (fp.leq (fp #b0 #b11100000 #b001)
                arg2
                (fp #b0 #b11100000 #b011)))
; arg2 = 178263365657094759585473888256.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111011 #b100)
                expect
                (fp #b1 #b00000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000 #b000)
                expect
                (fp #b0 #b11001011 #b101)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
