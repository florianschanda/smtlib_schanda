(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101001 #b1111)
                arg1
                (fp #b1 #b000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000 #b0000)
                arg1
                (fp #b0 #b010001 #b1000)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b010101 #b0100)
                arg2
                (fp #b0 #b001011 #b0000)))
(assert (fp.leq (fp #b0 #b001011 #b0000)
                arg2
                (fp #b0 #b011111 #b0011)))
; arg2 = 0.00000095367431640625

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110010 #b0110)
                expect
                (fp #b1 #b000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000 #b0000)
                expect
                (fp #b0 #b100010 #b0110)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
