;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00101110 #b1101)
                arg1
                (fp #b0 #b00111110 #b0000)))
(assert (fp.leq (fp #b0 #b00111110 #b0000)
                arg1
