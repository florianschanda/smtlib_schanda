; arg1 = 0.00000000000000000002710505431213761085018632002174854278564453125

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11110010 #b1101)
                expect
                (fp #b0 #b00000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000)
                expect
                (fp #b0 #b11110101 #b1010)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
