; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000101 #b01)
                arg1
                (fp #b0 #b101110 #b11)))
(assert (fp.leq (fp #b0 #b101110 #b11)
                arg1
                (fp #b0 #b110010 #b01)))
; arg1 = 57344.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010001 #b10)
                arg2
                (fp #b0 #b001111 #b10)))
(assert (fp.leq (fp #b0 #b001111 #b10)
                arg2
                (fp #b0 #b011001 #b10)))
; arg2 = 0.00002288818359375

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b100000 #b11)
                expect
                (fp #b0 #b111110 #b01)))
(assert (fp.leq (fp #b0 #b111110 #b01)
                expect
                (fp #b0 #b111111 #b00)))
; expect = 2684354560.0

(assert (not (= expect result)))

(check-sat)
(exit)
