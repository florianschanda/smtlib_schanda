(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101100 #b111)
                arg1
                (fp #b0 #b100010 #b000)))
(assert (fp.leq (fp #b0 #b100010 #b000)
                arg1
                (fp #b0 #b110001 #b111)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100110 #b101)
                arg2
                (fp #b1 #b100000 #b000)))
(assert (fp.leq (fp #b1 #b100000 #b000)
                arg2
                (fp #b0 #b101001 #b110)))
; arg2 = -2.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b111)
                expect
                (fp #b1 #b100001 #b000)))
(assert (fp.leq (fp #b1 #b100001 #b000)
                expect
                (fp #b0 #b110111 #b110)))
; expect = -4.0

(assert (not (= expect result)))

(check-sat)
(exit)
