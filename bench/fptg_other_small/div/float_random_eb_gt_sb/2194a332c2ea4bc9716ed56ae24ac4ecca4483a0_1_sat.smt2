                arg2
                (fp #b0 #b0111011 #b11101)))
; arg2 = -0.000000000000000045970172113385388001915998756885528564453125

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1000010 #b10011)
                expect
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                expect
                (fp #b0 #b0010110 #b10100)))
; expect = 0.0

(assert (= expect result))

