; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10011 #b00)
                arg1
                (fp #b0 #b00000 #b11)))
(assert (fp.leq (fp #b0 #b00000 #b11)
                arg1
                (fp #b0 #b01010 #b01)))
; arg1 = 0.0000457763671875

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b00)
                arg2
                (fp #b0 #b00000 #b10)))
(assert (fp.leq (fp #b0 #b00000 #b10)
                arg2
                (fp #b0 #b11010 #b10)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01000 #b00)
                expect
                (fp #b0 #b01111 #b10)))
(assert (fp.leq (fp #b0 #b01111 #b10)
                expect
                (fp #b0 #b11000 #b10)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
