(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b0)
                arg1
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg1
                (fp #b1 #b01101 #b0)))
; arg1 = -192.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10000 #b0)
                arg2
                (fp #b1 #b00000 #b1)))
(assert (fp.leq (fp #b1 #b00000 #b1)
                arg2
                (fp #b0 #b01100 #b1)))
; arg2 = -0.000030517578125

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
