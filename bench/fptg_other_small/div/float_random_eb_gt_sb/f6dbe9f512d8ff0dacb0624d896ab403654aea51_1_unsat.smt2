(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11100001 #b11100)
                arg1
                (fp #b0 #b01111111 #b00111)))
(assert (fp.leq (fp #b0 #b01111111 #b00111)
                arg1
                (fp #b0 #b10010110 #b01100)))
; arg1 = 1.21875

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01001000 #b11101)
                arg2
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                arg2
                (fp #b0 #b10100111 #b00100)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
