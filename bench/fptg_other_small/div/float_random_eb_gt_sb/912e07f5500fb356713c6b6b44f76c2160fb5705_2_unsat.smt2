(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0111 #b11)
                arg1
                (fp #b1 #b0000 #b11)))
(assert (fp.leq (fp #b1 #b0000 #b11)
                arg1
                (fp #b1 #b0000 #b00)))
; arg1 = -0.01171875

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b01)
                arg2
                (fp #b0 #b0001 #b11)))
(assert (fp.leq (fp #b0 #b0001 #b11)
                arg2
                (fp #b0 #b0010 #b01)))
; arg2 = 0.02734375

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b10)
                expect
                (fp #b1 #b0101 #b11)))
(assert (fp.leq (fp #b1 #b0101 #b11)
                expect
                (fp #b0 #b0111 #b01)))
; expect = -0.4375

(assert (not (= expect result)))

(check-sat)
(exit)
