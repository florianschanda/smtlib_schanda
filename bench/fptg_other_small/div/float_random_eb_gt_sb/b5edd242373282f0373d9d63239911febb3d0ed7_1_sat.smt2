; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b1001111 #b100)
                arg1
                (fp #b0 #b1111110 #b001)))
(assert (fp.leq (fp #b0 #b1111110 #b001)
                arg1
                (fp #b0 #b1111110 #b011)))
; arg1 = 10376293541461622784.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0000001 #b100)
                expect
                (fp #b1 #b0000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000 #b000)
                expect
                (fp #b0 #b0101100 #b111)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
