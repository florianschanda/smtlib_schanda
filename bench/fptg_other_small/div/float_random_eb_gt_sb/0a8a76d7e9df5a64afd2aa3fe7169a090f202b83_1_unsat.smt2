; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110111 #b111)
                arg1
                (fp #b0 #b01111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111 #b000)
                arg1
                (fp #b0 #b11011011 #b100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10011101 #b101)
                arg2
                (fp #b0 #b00000000 #b011)))
(assert (fp.leq (fp #b0 #b00000000 #b011)
                arg2
                (fp #b0 #b10001010 #b100)))
; arg2 = 0.000000000000000000000000000000000000004408103815583578154882762014583421291819995837895328205657818898544064722955226898193359375

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b11001100 #b100)
                expect
                (fp #b0 #b11111110 #b010)))
(assert (fp.leq (fp #b0 #b11111110 #b010)
                expect
                (fp #b0 #b11111110 #b110)))
; expect = 212676479325586539664609129644855132160.0

(assert (not (= expect result)))

(check-sat)
(exit)
