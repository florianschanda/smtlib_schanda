(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110001 #b100)
                arg1
                (fp #b1 #b10000010 #b001)))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b0 #b11001110 #b011)))
; arg1 = -9.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00011101 #b110)
                arg2
                (fp #b0 #b00000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000 #b110)
                arg2
                (fp #b0 #b00100001 #b111)))
; arg2 = 0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
