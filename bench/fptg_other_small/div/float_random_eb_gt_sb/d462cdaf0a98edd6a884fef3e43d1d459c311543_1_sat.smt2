(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0111110 #b1110)
                arg1
                (fp #b1 #b0100000 #b0000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000)
                arg1
                (fp #b0 #b1010110 #b1001)))
; arg1 = -0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1100100 #b0111)
                arg2
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg2
                (fp #b0 #b0101010 #b1101)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
