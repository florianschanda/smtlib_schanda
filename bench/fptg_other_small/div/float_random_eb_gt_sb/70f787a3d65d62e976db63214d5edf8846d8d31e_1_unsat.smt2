; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00011100 #b01000)
                arg1
                (fp #b0 #b00000000 #b11101)))
(assert (fp.leq (fp #b0 #b00000000 #b11101)
                arg1
                (fp #b0 #b01111110 #b01111)))
; arg1 = 0.00000000000000000000000000000000000001065291755432698054096667486857660145523165660824704316367306233814815641380846500396728515625

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00100001 #b11000)
                expect
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                expect
                (fp #b0 #b00100110 #b10011)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
