;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10101111 #b01011)
                arg1
                (fp #b1 #b00100011 #b10110)))
(assert (fp.leq (fp #b1 #b00100011 #b10110)
                arg1
                (fp #b0 #b01101001 #b01000)))
