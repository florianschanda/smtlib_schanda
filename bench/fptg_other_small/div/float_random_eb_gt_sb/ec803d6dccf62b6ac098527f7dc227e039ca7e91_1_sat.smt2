(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00100001 #b10011)
                expect
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                expect
                (fp #b0 #b11011000 #b11100)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
