(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10010 #b111)
                arg1
                (fp #b0 #b10011 #b000)))
(assert (fp.leq (fp #b0 #b10011 #b000)
                arg1
                (fp #b0 #b11010 #b110)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b001)
                arg2
                (fp #b1 #b10010 #b001)))
(assert (fp.leq (fp #b1 #b10010 #b001)
                arg2
                (fp #b1 #b01011 #b111)))
; arg2 = -9.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11010 #b000)
                expect
                (fp #b1 #b01111 #b110)))
(assert (fp.leq (fp #b1 #b01111 #b110)
                expect
                (fp #b1 #b01001 #b001)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
