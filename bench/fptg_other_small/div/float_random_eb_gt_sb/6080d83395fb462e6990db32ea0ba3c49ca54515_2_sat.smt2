(assert (fp.leq (fp #b1 #b011100 #b100)
                arg2
                (fp #b1 #b001000 #b101)))
; arg2 = -0.1875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101011 #b000)
                expect
                (fp #b0 #b000001 #b011)))
(assert (fp.leq (fp #b0 #b000001 #b011)
                expect
                (fp #b0 #b000111 #b001)))
; expect = 0.000000001280568540096282958984375

(assert (= expect result))

(check-sat)
