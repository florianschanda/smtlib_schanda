                arg2
                (fp #b0 #b10011101 #b010110)))
(assert (fp.leq (fp #b0 #b10011101 #b010110)
                arg2
                (fp #b0 #b11000100 #b101100)))
; arg2 = 1442840576.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11100111 #b110101)
                expect
                (fp #b1 #b11011001 #b110011)))
(assert (fp.leq (fp #b1 #b11011001 #b110011)
                expect
                (fp #b1 #b01100000 #b110100)))
; expect = -2224423508090917681459363840.0

(assert (not (= expect result)))

