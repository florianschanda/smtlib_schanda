                (fp #b0 #b01111111 #b110)))
(assert (fp.leq (fp #b0 #b01111111 #b110)
                arg2
                (fp #b0 #b10011010 #b110)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10111110 #b011)
                expect
                (fp #b1 #b10111110 #b001)))
(assert (fp.leq (fp #b1 #b10111110 #b001)
                expect
                (fp #b0 #b10111101 #b100)))
; expect = -10376293541461622784.0

(assert (not (= expect result)))

