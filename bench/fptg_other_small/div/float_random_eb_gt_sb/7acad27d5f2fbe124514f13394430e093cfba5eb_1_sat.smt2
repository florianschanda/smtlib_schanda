(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0000001 #b01011)
                arg2
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg2
                (fp #b0 #b1010000 #b01100)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
