;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0001011 #b01011)
                arg1
                (fp #b1 #b0000000 #b00111)))
(assert (fp.leq (fp #b1 #b0000000 #b00111)
                arg1
                (fp #b0 #b0010010 #b11000)))
