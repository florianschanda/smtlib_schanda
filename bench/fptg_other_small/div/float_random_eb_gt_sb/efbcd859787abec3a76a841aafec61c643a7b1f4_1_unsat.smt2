(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10001 #b00)
                expect
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                expect
                (fp #b0 #b10101 #b00)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
