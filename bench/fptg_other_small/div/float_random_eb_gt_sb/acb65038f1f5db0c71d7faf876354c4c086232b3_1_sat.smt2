(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00011001 #b0100)
                arg1
                (fp #b0 #b01111111 #b0100)))
(assert (fp.leq (fp #b0 #b01111111 #b0100)
                arg1
                (fp #b0 #b10000011 #b1010)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11100010 #b1100)
                arg2
                (fp #b1 #b01110110 #b1111)))
(assert (fp.leq (fp #b1 #b01110110 #b1111)
                arg2
                (fp #b1 #b01001100 #b1011)))
; arg2 = -0.0037841796875

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10001100 #b1000)
                expect
                (fp #b1 #b10000111 #b0100)))
(assert (fp.leq (fp #b1 #b10000111 #b0100)
                expect
                (fp #b0 #b00010010 #b0100)))
; expect = -320.0

(assert (= expect result))

(check-sat)
(exit)
