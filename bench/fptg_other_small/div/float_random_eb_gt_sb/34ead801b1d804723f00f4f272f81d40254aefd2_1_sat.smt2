(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b011)
                arg1
                (fp #b1 #b10101 #b110)))
(assert (fp.leq (fp #b1 #b10101 #b110)
                arg1
                (fp #b1 #b00001 #b111)))
; arg1 = -112.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10000 #b010)
                expect
                (fp #b0 #b01111 #b000)))
(assert (fp.leq (fp #b0 #b01111 #b000)
                expect
                (fp #b0 #b10011 #b000)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
