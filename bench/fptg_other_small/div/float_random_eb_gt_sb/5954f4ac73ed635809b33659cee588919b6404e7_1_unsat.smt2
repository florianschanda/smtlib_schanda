(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1111 #b0)
                arg1
                (fp #b1 #b1101 #b1)))
(assert (fp.leq (fp #b1 #b1101 #b1)
                arg1
                (fp #b1 #b0110 #b1)))
; arg1 = -96.0

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1100 #b1)
                arg2
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg2
                (fp #b0 #b1101 #b1)))
; arg2 = 64.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1101 #b0)
                expect
                (fp #b1 #b0111 #b1)))
(assert (fp.leq (fp #b1 #b0111 #b1)
                expect
                (fp #b0 #b0101 #b0)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
