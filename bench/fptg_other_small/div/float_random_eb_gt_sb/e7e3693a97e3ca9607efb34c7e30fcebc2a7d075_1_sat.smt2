(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11001 #b0)
                arg1
                (fp #b0 #b00001 #b0)))
(assert (fp.leq (fp #b0 #b00001 #b0)
                arg1
                (fp #b0 #b01111 #b0)))
; arg1 = 0.00006103515625

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11001 #b0)
                arg2
                (fp #b0 #b11001 #b0)))
(assert (fp.leq (fp #b0 #b11001 #b0)
                arg2
                (fp #b0 #b11010 #b0)))
; arg2 = 1024.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100 #b0)
                expect
                (fp #b0 #b00000 #b0)))
(assert (fp.leq (fp #b0 #b00000 #b0)
                expect
                (fp #b0 #b01110 #b1)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
