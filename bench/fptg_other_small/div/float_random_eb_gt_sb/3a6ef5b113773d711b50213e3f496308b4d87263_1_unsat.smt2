; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100011 #b101)
                arg1
                (fp #b0 #b000001 #b000)))
(assert (fp.leq (fp #b0 #b000001 #b000)
                arg1
                (fp #b0 #b101000 #b000)))
; arg1 = 0.000000000931322574615478515625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b101)
                arg2
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg2
                (fp #b0 #b001110 #b010)))
; arg2 = -9.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100001 #b110)
                expect
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                expect
                (fp #b0 #b110101 #b001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
