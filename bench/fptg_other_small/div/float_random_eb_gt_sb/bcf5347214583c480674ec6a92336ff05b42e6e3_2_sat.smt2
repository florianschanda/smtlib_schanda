(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0000000 #b101)
                arg1
                (fp #b0 #b1101000 #b000)))
(assert (fp.leq (fp #b0 #b1101000 #b000)
                arg1
                (fp #b0 #b1110101 #b000)))
; arg1 = 2199023255552.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111001 #b111)
                arg2
                (fp #b0 #b0111110 #b001)))
(assert (fp.leq (fp #b0 #b0111110 #b001)
                arg2
                (fp #b0 #b1010001 #b101)))
; arg2 = 0.5625

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0001010 #b111)
                expect
                (fp #b0 #b1101000 #b111)))
(assert (fp.leq (fp #b0 #b1101000 #b111)
                expect
                (fp #b0 #b1110110 #b111)))
; expect = 4123168604160.0

(assert (= expect result))

(check-sat)
(exit)
