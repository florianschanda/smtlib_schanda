(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101100 #b0001)
                arg1
                (fp #b1 #b0111111 #b0111)))
(assert (fp.leq (fp #b1 #b0111111 #b0111)
                arg1
                (fp #b1 #b0011010 #b1000)))
; arg1 = -1.4375

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0101100 #b1010)
                expect
                (fp #b0 #b0111111 #b0000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000)
                expect
                (fp #b0 #b1100001 #b0001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
