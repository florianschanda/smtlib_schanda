(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b000 #b0)
                arg1
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                arg1
                (fp #b0 #b110 #b1)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b111 #b0)
                arg2
                (fp #b1 #b110 #b1)))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg2
                (fp #b0 #b011 #b1)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b111 #b0)
                expect
                (fp #b1 #b001 #b0)))
(assert (fp.leq (fp #b1 #b001 #b0)
                expect
                (fp #b1 #b000 #b1)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
