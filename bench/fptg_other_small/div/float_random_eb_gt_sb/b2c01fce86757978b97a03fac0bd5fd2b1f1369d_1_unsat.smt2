(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11011100 #b1111)
                arg1
                (fp #b1 #b10011110 #b1000)))
(assert (fp.leq (fp #b1 #b10011110 #b1000)
                arg1
                (fp #b1 #b01011000 #b1111)))
; arg1 = -3221225472.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00000011 #b0000)
                arg2
                (fp #b0 #b01111111 #b1101)))
(assert (fp.leq (fp #b0 #b01111111 #b1101)
                arg2
                (fp #b0 #b10111011 #b0010)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111011 #b1100)
                expect
                (fp #b1 #b10011101 #b1010)))
(assert (fp.leq (fp #b1 #b10011101 #b1010)
                expect
                (fp #b0 #b10111010 #b1111)))
; expect = -1744830464.0

(assert (not (= expect result)))

(check-sat)
(exit)
