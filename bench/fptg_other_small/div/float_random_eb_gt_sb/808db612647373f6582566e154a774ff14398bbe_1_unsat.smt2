                arg2
                (fp #b0 #b1111111 #b0)))
; arg2 = 13835058055282163712.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
