(assert (fp.leq (fp #b1 #b0011111 #b0)
                expect
                (fp #b1 #b0000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000 #b0)
                expect
                (fp #b0 #b1101101 #b1)))
; expect = -0

(assert (not (= expect result)))

