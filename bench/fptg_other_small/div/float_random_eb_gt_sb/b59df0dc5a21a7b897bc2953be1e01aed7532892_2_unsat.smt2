(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01101 #b11)
                arg1
                (fp #b0 #b00000 #b01)))
(assert (fp.leq (fp #b0 #b00000 #b01)
                arg1
                (fp #b0 #b00111 #b11)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01111 #b10)
                arg2
                (fp #b0 #b00000 #b11)))
(assert (fp.leq (fp #b0 #b00000 #b11)
                arg2
                (fp #b0 #b10100 #b00)))
; arg2 = 0.0000457763671875

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00111 #b00)
                expect
                (fp #b0 #b01101 #b10)))
(assert (fp.leq (fp #b0 #b01101 #b10)
                expect
                (fp #b0 #b11000 #b10)))
; expect = 0.375

(assert (not (= expect result)))

(check-sat)
(exit)
