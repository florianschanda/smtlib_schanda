(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10010010 #b100100)
                arg1
                (fp #b1 #b00000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000)
                arg1
                (fp #b0 #b01000011 #b001000)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111111 #b000000)
                arg2
                (fp #b1 #b11111110 #b111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111)
                arg2
                (fp #b0 #b00101001 #b000000)))
; arg2 = -337623910929368631717566993311207522304.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11000000 #b110001)
                expect
                (fp #b0 #b00000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000)
                expect
                (fp #b0 #b11001010 #b000100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
