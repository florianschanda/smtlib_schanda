(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000000 #b010)
                arg1
                (fp #b0 #b000001 #b000)))
(assert (fp.leq (fp #b0 #b000001 #b000)
                arg1
                (fp #b0 #b001000 #b111)))
; arg1 = 0.000000000931322574615478515625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110110 #b101)
                expect
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                expect
                (fp #b0 #b001010 #b100)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
