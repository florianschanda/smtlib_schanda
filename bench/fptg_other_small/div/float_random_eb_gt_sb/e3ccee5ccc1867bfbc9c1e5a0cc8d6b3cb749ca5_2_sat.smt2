(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001111 #b00)
                arg1
                (fp #b0 #b001111 #b00)))
(assert (fp.leq (fp #b0 #b001111 #b00)
                arg1
                (fp #b0 #b100100 #b00)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100100 #b01)
                arg2
                (fp #b0 #b011111 #b11)))
(assert (fp.leq (fp #b0 #b011111 #b11)
                arg2
                (fp #b0 #b101110 #b01)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001011 #b01)
                expect
                (fp #b0 #b001110 #b01)))
(assert (fp.leq (fp #b0 #b001110 #b01)
                expect
                (fp #b0 #b101110 #b01)))
; expect = 0.0000095367431640625

(assert (= expect result))

(check-sat)
(exit)
