(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b10010001 #b10)
                arg1
                (fp #b0 #b11001010 #b01)))
(assert (fp.leq (fp #b0 #b11001010 #b01)
                arg1
                (fp #b0 #b11111101 #b01)))
; arg1 = 47223664828696452136960.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11100101 #b11)
                arg2
                (fp #b1 #b10110000 #b11)))
(assert (fp.leq (fp #b1 #b10110000 #b11)
                arg2
                (fp #b0 #b10010010 #b11)))
; arg2 = -985162418487296.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011110 #b01)
                expect
                (fp #b1 #b10011000 #b01)))
(assert (fp.leq (fp #b1 #b10011000 #b01)
                expect
                (fp #b0 #b11101111 #b00)))
; expect = -41943040.0

(assert (= expect result))

(check-sat)
(exit)
