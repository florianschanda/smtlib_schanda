(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110011 #b0)
                arg1
                (fp #b1 #b100000 #b1)))
(assert (fp.leq (fp #b1 #b100000 #b1)
                arg1
                (fp #b0 #b100011 #b1)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b001010 #b0)
                arg2
                (fp #b0 #b010000 #b0)))
(assert (fp.leq (fp #b0 #b010000 #b0)
                arg2
                (fp #b0 #b011001 #b0)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110011 #b1)
                expect
                (fp #b1 #b101111 #b1)))
(assert (fp.leq (fp #b1 #b101111 #b1)
                expect
                (fp #b0 #b101000 #b0)))
; expect = -98304.0

(assert (not (= expect result)))

(check-sat)
(exit)
