(assert (fp.leq (fp #b1 #b0111111 #b101)
                arg2
                (fp #b0 #b1100110 #b001)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1110111 #b001)
                expect
                (fp #b0 #b1111100 #b010)))
(assert (fp.leq (fp #b0 #b1111100 #b010)
                expect
                (fp #b0 #b1111101 #b011)))
; expect = 2882303761517117440.0

(assert (= expect result))

