(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg1
                (fp #b1 #b1000 #b10)))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg1
                (fp #b0 #b0000 #b11)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1111 #b00)
                arg2
                (fp #b1 #b1110 #b11)))
(assert (fp.leq (fp #b1 #b1110 #b11)
                arg2
                (fp #b0 #b0011 #b00)))
; arg2 = -224.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b01)
                expect
                (fp #b0 #b0000 #b11)))
(assert (fp.leq (fp #b0 #b0000 #b11)
                expect
                (fp #b0 #b1011 #b01)))
; expect = 0.01171875

(assert (not (= expect result)))

(check-sat)
(exit)
