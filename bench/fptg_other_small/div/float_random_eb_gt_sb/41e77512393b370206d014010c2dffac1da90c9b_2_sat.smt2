(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11010110 #b00)
                arg1
                (fp #b1 #b01101000 #b01)))
(assert (fp.leq (fp #b1 #b01101000 #b01)
                arg1
                (fp #b0 #b00011010 #b10)))
; arg1 = -0.0000001490116119384765625

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b00001011 #b11)
                arg2
                (fp #b0 #b10000001 #b10)))
(assert (fp.leq (fp #b0 #b10000001 #b10)
                arg2
                (fp #b0 #b10110011 #b10)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01110110 #b10)
                expect
                (fp #b1 #b01100101 #b11)))
(assert (fp.leq (fp #b1 #b01100101 #b11)
                expect
                (fp #b0 #b00100101 #b00)))
; expect = -0.0000000260770320892333984375

(assert (= expect result))

(check-sat)
(exit)
