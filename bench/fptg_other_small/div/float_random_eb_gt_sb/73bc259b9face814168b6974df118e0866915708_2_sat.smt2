(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b000)
                arg1
                (fp #b1 #b010000 #b000)))
(assert (fp.leq (fp #b1 #b010000 #b000)
                arg1
                (fp #b1 #b001100 #b100)))
; arg1 = -0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010000 #b011)
                arg2
                (fp #b0 #b101110 #b111)))
(assert (fp.leq (fp #b0 #b101110 #b111)
                arg2
                (fp #b0 #b101111 #b101)))
; arg2 = 61440.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011100 #b010)
                expect
                (fp #b1 #b000000 #b101)))
(assert (fp.leq (fp #b1 #b000000 #b101)
                expect
                (fp #b0 #b110101 #b111)))
; expect = -0.000000000582076609134674072265625

(assert (= expect result))

(check-sat)
(exit)
