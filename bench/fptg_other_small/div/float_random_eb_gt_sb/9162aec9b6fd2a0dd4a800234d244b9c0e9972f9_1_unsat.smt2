                arg2
                (fp #b1 #b1011010 #b1100)))
(assert (fp.leq (fp #b1 #b1011010 #b1100)
                arg2
                (fp #b1 #b0111111 #b0010)))
; arg2 = -234881024.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1010110 #b1111)
                expect
                (fp #b0 #b0100011 #b1101)))
(assert (fp.leq (fp #b0 #b0100011 #b1101)
                expect
                (fp #b0 #b1100100 #b0011)))
; expect = 0.00000000675208866596221923828125

(assert (not (= expect result)))

(check-sat)
(exit)
