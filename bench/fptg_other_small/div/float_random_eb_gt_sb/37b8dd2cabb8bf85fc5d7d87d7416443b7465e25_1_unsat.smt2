(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00011010 #b101)
                arg1
                (fp #b0 #b01111111 #b111)))
(assert (fp.leq (fp #b0 #b01111111 #b111)
                arg1
                (fp #b0 #b11101001 #b000)))
; arg1 = 1.875

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10011100 #b010)
                arg2
                (fp #b0 #b10000000 #b100)))
(assert (fp.leq (fp #b0 #b10000000 #b100)
                arg2
                (fp #b0 #b10001100 #b001)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000101 #b000)
                expect
                (fp #b0 #b01111110 #b010)))
(assert (fp.leq (fp #b0 #b01111110 #b010)
                expect
                (fp #b0 #b11111100 #b101)))
; expect = 0.625

(assert (not (= expect result)))

(check-sat)
(exit)
