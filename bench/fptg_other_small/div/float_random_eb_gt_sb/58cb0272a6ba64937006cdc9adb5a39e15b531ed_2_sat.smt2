; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10001010 #b010110)
                arg1
                (fp #b1 #b01111111 #b101110)))
(assert (fp.leq (fp #b1 #b01111111 #b101110)
                arg1
                (fp #b0 #b01000100 #b011110)))
; arg1 = -1.71875

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00001100 #b000110)
                arg2
                (fp #b0 #b00110110 #b000111)))
(assert (fp.leq (fp #b0 #b00110110 #b000111)
                arg2
                (fp #b0 #b01101100 #b101011)))
; arg2 = 0.0000000000000000000001174596469825299298317400342739347252063453197479248046875

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11011101 #b100100)
                expect
                (fp #b1 #b11001000 #b100100)))
(assert (fp.leq (fp #b1 #b11001000 #b100100)
                expect
                (fp #b1 #b01101111 #b101010)))
; expect = -14757395258967641292800.0

(assert (= expect result))

(check-sat)
(exit)
