(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00110001 #b1)
                arg1
                (fp #b0 #b10000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000 #b1)
                arg1
                (fp #b0 #b11001110 #b0)))
; arg1 = 3.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00100101 #b0)
                arg2
                (fp #b0 #b00000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000 #b1)
                arg2
                (fp #b0 #b01101001 #b0)))
; arg2 = 0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b10110110 #b0)
                expect
                (fp #b0 #b11111110 #b1)))
(assert (fp.leq (fp #b0 #b11111110 #b1)
                expect
                (fp #b0 #b11111111 #b0)))
; expect = 255211775190703847597530955573826158592.0

(assert (not (= expect result)))

(check-sat)
(exit)
