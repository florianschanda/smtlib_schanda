(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0001001100111001)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b0100110 #b0010100001011111)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110011 #b1010100001001111)
                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1101000 #b0110110000101100)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001010 #b0110010010010100)
                expect
                (fp #b1 #b0111101 #b0111100001111011)))
(assert (fp.leq (fp #b1 #b0111101 #b0111100001111011)
                expect
                (fp #b1 #b0100111 #b0011110001001111)))
; expect = -0.367656707763671875

(assert (= expect result))

(check-sat)
(exit)
