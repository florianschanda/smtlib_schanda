                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b0110000 #b1010101100100101)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000101 #b0110110110111101)
                expect
                (fp #b0 #b1010100 #b0010010110010001)))
(assert (fp.leq (fp #b0 #b1010100 #b0010010110010001)
                expect
                (fp #b0 #b1100010 #b1000001110100010)))
; expect = 2404896.0

(assert (= expect result))

(check-sat)
(exit)
