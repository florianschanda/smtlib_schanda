                arg2
                (fp #b0 #b1111100 #b1101110011101000)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b0011001100110111)
                expect
                (fp #b1 #b1101110 #b0110100001101010)))
(assert (fp.leq (fp #b1 #b1101110 #b0110100001101010)
                expect
                (fp #b0 #b0010100 #b1110100100110010)))
; expect = -198139726266368.0

(assert (not (= expect result)))

