;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011111 #b1001111001110101)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b0110111 #b1110111001101111)))
; arg1 = -130165.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111010 #b1011011000101010)
                arg2
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                arg2
                (fp #b0 #b1010111 #b0111101110111001)))
; arg2 = 9884160.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0111010110011001)
                expect
                (fp #b1 #b0111000 #b1010111110000111)))
(assert (fp.leq (fp #b1 #b0111000 #b1010111110000111)
                expect
                (fp #b0 #b1111001 #b1101110011100011)))
; expect = -0.01316916942596435546875

(assert (= expect result))

(check-sat)
(exit)
