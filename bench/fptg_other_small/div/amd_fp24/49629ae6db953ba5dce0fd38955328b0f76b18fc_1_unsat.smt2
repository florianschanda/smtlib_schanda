; Format: AMD_FP24
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110110 #b0001011100111101)
                arg1
                (fp #b0 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b1101000 #b1001110001010001)))
; arg1 = 0.00000000000000000021684043449710088680149056017398834228515625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1111011010001000)
                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b1 #b0100110 #b0000010111110100)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1011011 #b0111100010011001)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0001101 #b1000010110101010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
