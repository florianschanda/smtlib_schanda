                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1011001 #b0001100101000000)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010100 #b0100100001101001)
                expect
                (fp #b0 #b1000010 #b1110100101110011)))
(assert (fp.leq (fp #b0 #b1000010 #b1110100101110011)
                expect
                (fp #b0 #b1100110 #b1001010100011000)))
; expect = 15.2952880859375

(assert (= expect result))

(check-sat)
(exit)
