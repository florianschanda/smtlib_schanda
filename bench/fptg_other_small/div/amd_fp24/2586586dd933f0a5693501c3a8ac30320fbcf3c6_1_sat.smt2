;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010101 #b1001110101111000)
                arg1
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                arg1
                (fp #b0 #b1101111 #b0100100111101001)))
