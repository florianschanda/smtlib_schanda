                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg2
                (fp #b0 #b1111111 #b0000000000000000)))
; arg2 = 18446603336221196288.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101111 #b0011011110001000)
                expect
                (fp #b0 #b0000000 #b0100000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000001)
                expect
                (fp #b0 #b1101011 #b1000010111111010)))
; expect = 0.000000000000000000054213417346725433811072125678265365422703325748443603515625

(assert (= expect result))

(check-sat)
(exit)
