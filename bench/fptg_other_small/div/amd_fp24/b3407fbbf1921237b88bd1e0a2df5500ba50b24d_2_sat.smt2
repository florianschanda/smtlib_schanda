; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010011 #b0001100100000101)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b1000000 #b1101010001011000)))
; arg1 = -1.417633056640625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100101 #b1111100110011101)
                arg2
                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1101101 #b1100100100100111)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001000 #b1001111010011101)
                expect
                (fp #b1 #b0111110 #b1011101110110111)))
(assert (fp.leq (fp #b1 #b0111110 #b1011101110110111)
                expect
                (fp #b1 #b0011111 #b0000010111101001)))
; expect = -0.86663055419921875

(assert (= expect result))

(check-sat)
(exit)
