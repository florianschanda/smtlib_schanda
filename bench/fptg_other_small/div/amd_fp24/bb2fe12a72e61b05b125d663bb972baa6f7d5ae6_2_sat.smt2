(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b0111100111011111)
                arg2
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                arg2
                (fp #b0 #b1100001 #b1100101110110001)))
; arg2 = -0.0003445781767368316650390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
