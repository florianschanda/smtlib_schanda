(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1000010100010011)
                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1100101 #b0011011110101101)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
