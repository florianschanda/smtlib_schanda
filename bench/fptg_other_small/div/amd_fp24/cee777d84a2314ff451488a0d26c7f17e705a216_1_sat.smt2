(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0111100101101111)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1111100 #b1011110101111010)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1100111110011110)
                arg2
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b1 #b1000100 #b0011111011000100)))
; arg2 = -59593208102912.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000100 #b1100010110101110)
                expect
                (fp #b0 #b0110001 #b0010111001001001)))
(assert (fp.leq (fp #b0 #b0110001 #b0010111001001001)
                expect
                (fp #b0 #b1000000 #b1110000110001000)))
; expect = 0.000072070397436618804931640625

(assert (= expect result))

(check-sat)
(exit)
