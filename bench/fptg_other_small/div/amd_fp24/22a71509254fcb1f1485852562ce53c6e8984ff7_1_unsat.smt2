(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1100100 #b0001100000110100)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b1110011011001111)
                expect
                (fp #b1 #b0111111 #b0011000010001110)))
(assert (fp.leq (fp #b1 #b0111111 #b0011000010001110)
                expect
                (fp #b1 #b0010110 #b1101110100101101)))
; expect = -1.189666748046875

(assert (not (= expect result)))

