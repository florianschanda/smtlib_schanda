(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b1110111111010100)
                expect
                (fp #b1 #b1000001 #b0000010011010000)))
(assert (fp.leq (fp #b1 #b1000001 #b0000010011010000)
                expect
                (fp #b0 #b1111101 #b1000100111001000)))
; expect = -4.0751953125

(assert (not (= expect result)))

