(assert (fp.leq (fp #b1 #b0000010 #b0110101010000110)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0100111 #b0000010110101000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
