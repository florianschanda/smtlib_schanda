(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1101000 #b1110100011000001)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011111 #b1101011001011001)
                expect
                (fp #b0 #b1011000 #b0010100110101111)))
(assert (fp.leq (fp #b0 #b1011000 #b0010100110101111)
                expect
                (fp #b0 #b1111101 #b0010011110100100)))
; expect = 39017984.0

(assert (not (= expect result)))

