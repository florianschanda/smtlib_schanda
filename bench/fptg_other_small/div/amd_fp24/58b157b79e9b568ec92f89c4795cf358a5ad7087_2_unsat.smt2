; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0000110110000111)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b0010100 #b0100010101100000)))
; arg1 = -1.417633056640625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001000 #b1100011001001100)
                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1100100 #b0001100000011000)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0111111001000101)
                expect
                (fp #b1 #b0101110 #b0111010001101010)))
(assert (fp.leq (fp #b1 #b0101110 #b0111010001101010)
                expect
                (fp #b0 #b1010010 #b1000101010011101)))
; expect = -0.00001109880395233631134033203125

(assert (not (= expect result)))

(check-sat)
(exit)
