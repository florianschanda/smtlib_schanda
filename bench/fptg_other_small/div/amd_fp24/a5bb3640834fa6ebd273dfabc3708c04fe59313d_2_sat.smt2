; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0110110101010000)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1110001 #b1101001111110101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0110110011011001)
                arg2
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1010111 #b0111111010111100)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101001 #b1111010111111010)
                expect
                (fp #b0 #b0011111 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0011111 #b0000000000000001)
                expect
                (fp #b0 #b1101001 #b1000111011011010)))
; expect = 0.000000000232834196367548429407179355621337890625

(assert (= expect result))

(check-sat)
(exit)
