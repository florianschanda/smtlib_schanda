; Format: AMD_FP24
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110000 #b1110010011000001)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1110010 #b0011100111101110)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101111 #b0111011001111011)
                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b0110111 #b0101110010111001)))
; arg2 = 0.00179137289524078369140625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000010 #b1101111010001011)
                expect
                (fp #b0 #b1001000 #b0001011100011110)))
(assert (fp.leq (fp #b0 #b1001000 #b0001011100011110)
                expect
                (fp #b0 #b1111011 #b0001100111010000)))
; expect = 558.234375

(assert (= expect result))

(check-sat)
(exit)
