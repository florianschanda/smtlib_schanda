(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b0001111000101101)
                arg1
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b0100011 #b1110011111010100)))
; arg1 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011100 #b1001010000111101)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0010001 #b0010000000000001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
