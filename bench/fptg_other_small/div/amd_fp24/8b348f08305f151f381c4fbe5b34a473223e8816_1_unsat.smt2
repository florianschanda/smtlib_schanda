(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1000010 #b1111101001110001)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010110 #b1000110101000011)
                expect
                (fp #b0 #b1001100 #b0010101110011110)))
(assert (fp.leq (fp #b0 #b1001100 #b0010101110011110)
                expect
                (fp #b0 #b1111100 #b0101000100111111)))
; expect = 9587.75

(assert (not (= expect result)))

