(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b1111100000110000)
                arg2
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b1 #b1000110 #b1111101001011010)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101100 #b1011111101110000)
                expect
                (fp #b0 #b0110101 #b0001001101010101)))
(assert (fp.leq (fp #b0 #b0110101 #b0001001101010101)
                expect
                (fp #b0 #b1111101 #b1100111111111100)))
; expect = 0.00105030834674835205078125

(assert (not (= expect result)))

(check-sat)
(exit)
