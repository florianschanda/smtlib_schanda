;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b1001110101000100)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b0100111 #b0010011111101001)))
