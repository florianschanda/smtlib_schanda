; Format: AMD_FP24
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1001011 #b1100010101111001)
                arg1
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b1010011 #b0011111101110001)))
; arg1 = 131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010001 #b0000000010000010)
                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1110000 #b0011001100011110)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b0010011000111000)
                expect
                (fp #b0 #b0111111 #b0000011010110100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011010110100)
                expect
                (fp #b0 #b1011010 #b0010101110111011)))
; expect = 1.02618408203125

(assert (= expect result))

(check-sat)
(exit)
