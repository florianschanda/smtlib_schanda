; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1101110010010001)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b1 #b0001001 #b0101010010001111)))
; arg1 = -36787.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100100 #b1111111110111011)
                arg2
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1110011 #b0011100011101100)))
; arg2 = 4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000100 #b0000001001000101)
                expect
                (fp #b1 #b0101110 #b0001111101100111)))
(assert (fp.leq (fp #b1 #b0101110 #b0001111101100111)
                expect
                (fp #b0 #b0010001 #b0101111001010111)))
; expect = -0.000008565257303416728973388671875

(assert (= expect result))

(check-sat)
(exit)
