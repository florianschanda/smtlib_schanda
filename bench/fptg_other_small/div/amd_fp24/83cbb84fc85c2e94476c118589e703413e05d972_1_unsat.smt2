                arg2
                (fp #b0 #b1100100 #b0000001001110100)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b1100110010001101)
                expect
                (fp #b1 #b0111111 #b1001010010011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1001010010011110)
                expect
                (fp #b0 #b1101011 #b1010011000011111)))
; expect = -1.580535888671875

(assert (not (= expect result)))

(check-sat)
