(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010011 #b1100110110010100)
                expect
                (fp #b1 #b0000000 #b0000000000000011)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000011)
                expect
