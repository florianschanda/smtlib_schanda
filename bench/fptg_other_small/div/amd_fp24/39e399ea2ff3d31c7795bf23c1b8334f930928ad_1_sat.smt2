; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b1000011101111100)
                arg1
                (fp #b0 #b0100001 #b0110000110111010)))
(assert (fp.leq (fp #b0 #b0100001 #b0110000110111010)
                arg1
                (fp #b0 #b0110110 #b1111100011011010)))
; arg1 = 0.000000001286849737880402244627475738525390625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1100001 #b0001000000101001)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1011101 #b0110000100100101)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
