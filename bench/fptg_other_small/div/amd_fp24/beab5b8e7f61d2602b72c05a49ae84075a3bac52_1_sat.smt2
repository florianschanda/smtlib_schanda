(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011100 #b1101010001010000)
                arg1
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                arg1
                (fp #b0 #b1110101 #b0001010010011011)))
; arg1 = 4983772676096.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0000101011001011)
                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b1 #b0110000 #b0100001111110111)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b1110101010011101)
                expect
                (fp #b1 #b1010001 #b0110000010111001)))
(assert (fp.leq (fp #b1 #b1010001 #b0110000010111001)
                expect
                (fp #b0 #b0011111 #b1110110110110100)))
; expect = -361188.0

(assert (= expect result))

(check-sat)
(exit)
