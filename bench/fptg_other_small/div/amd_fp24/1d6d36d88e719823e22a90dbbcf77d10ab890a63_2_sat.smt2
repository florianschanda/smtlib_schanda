(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000011 #b1000010100010110)
                arg1
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b1101011 #b0110011110110110)))
; arg1 = 131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1001010100111001)
                arg2
                (fp #b1 #b0111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1011110111011110)
                arg2
                (fp #b0 #b1001111 #b0010101001100110)))
; arg2 = -1.741668701171875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010100 #b1001010011001110)
                expect
                (fp #b1 #b1001111 #b0010010111111001)))
(assert (fp.leq (fp #b1 #b1001111 #b0010010111111001)
                expect
                (fp #b0 #b1110101 #b0011011100010010)))
; expect = -75257.0

(assert (= expect result))

(check-sat)
(exit)
