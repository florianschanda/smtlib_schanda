; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b0001001011110110)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b1 #b0001111 #b1000100010000000)))
; arg1 = -130165.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b1011010000010000)
                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1101010 #b0110011110100111)))
; arg2 = 0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                expect
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                expect
                (fp #b1 #b0110011 #b1001100110100110)))
; expect = -18446603336221196288.0

(assert (= expect result))

(check-sat)
(exit)
