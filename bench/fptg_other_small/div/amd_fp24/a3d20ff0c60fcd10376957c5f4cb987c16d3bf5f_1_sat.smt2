(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1111000 #b0110000010010100)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1101110011010000)
                expect
                (fp #b1 #b1010001 #b0000110011000010)))
(assert (fp.leq (fp #b1 #b1010001 #b0000110011000010)
                expect
                (fp #b1 #b0101101 #b0101001111010111)))
; expect = -275208.0

(assert (= expect result))

(check-sat)
