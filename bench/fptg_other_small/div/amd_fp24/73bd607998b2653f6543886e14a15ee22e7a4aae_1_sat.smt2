; Format: AMD_FP24
; Arg1: -ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101001 #b0000111000011010)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1000000 #b1101101101111001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b1000010100111001)
                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0011011 #b0011110111110001)))
; arg2 = 0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1010101110010110)
                expect
                (fp #b1 #b1111101 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000001)
                expect
                (fp #b0 #b1001001 #b1010101100101011)))
; expect = -4611756387171565568.0

(assert (= expect result))

(check-sat)
(exit)
