                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b0 #b1111000 #b1011000100110100)))
; arg2 = -717963500751683584.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100111 #b1000011001001100)
                expect
                (fp #b0 #b0101111 #b0100111101101110)))
(assert (fp.leq (fp #b0 #b0101111 #b0100111101101110)
                expect
                (fp #b0 #b1100001 #b1011001100001000)))
; expect = 0.0000199931673705577850341796875

(assert (= expect result))

(check-sat)
(exit)
