                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1111100 #b1101000011001010)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001111 #b1101101000010001)
                expect
                (fp #b0 #b0101110 #b0010100100111100)))
(assert (fp.leq (fp #b0 #b0101110 #b0010100100111100)
                expect
                (fp #b0 #b1111001 #b0001111001101111)))
; expect = 0.0000088582746684551239013671875

(assert (not (= expect result)))

(check-sat)
(exit)
