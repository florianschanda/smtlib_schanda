                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1000010 #b1101011110100000)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0110110110110101)
                expect
                (fp #b1 #b1101001 #b0011001100110001)))
(assert (fp.leq (fp #b1 #b1101001 #b0011001100110001)
                expect
                (fp #b1 #b0010011 #b1001111110111000)))
; expect = -5277508173824.0

(assert (not (= expect result)))

(check-sat)
(exit)
