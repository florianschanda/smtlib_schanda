; Format: AMD_FP24
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b0100011101010010)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b0000001 #b1110011101011000)))
; arg1 = -131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000000 #b0011101011100100)
                arg2
                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1110000 #b0011110000011011)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1111010100000110)
                expect
                (fp #b1 #b0100111 #b0011101001011110)))
(assert (fp.leq (fp #b1 #b0100111 #b0011101001011110)
                expect
                (fp #b0 #b0101001 #b0101011110011000)))
; expect = -0.000000073194314609281718730926513671875

(assert (= expect result))

(check-sat)
(exit)
