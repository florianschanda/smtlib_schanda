                arg2
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                arg2
                (fp #b0 #b1110000 #b1000011101000101)))
; arg2 = 40629698560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011010 #b1000100111011110)
                expect
                (fp #b1 #b1000111 #b0110000101001101)))
(assert (fp.leq (fp #b1 #b1000111 #b0110000101001101)
                expect
                (fp #b0 #b0101111 #b0100100111100001)))
; expect = -353.30078125

(assert (= expect result))

(check-sat)
(exit)
