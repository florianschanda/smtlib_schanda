(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1101111 #b0101111111011011)))
; arg2 = -131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100010 #b0111011000110100)
                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1100000 #b1110001011000110)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
