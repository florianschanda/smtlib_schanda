(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0101010010000010)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
