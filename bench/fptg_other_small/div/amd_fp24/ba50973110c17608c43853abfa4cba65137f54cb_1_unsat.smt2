                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b1 #b0111100 #b1011011110000011)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b1001010111110111)
                expect
                (fp #b1 #b0110000 #b0000100000100000)))
(assert (fp.leq (fp #b1 #b0110000 #b0000100000100000)
                expect
                (fp #b1 #b0010111 #b0010000111111110)))
; expect = -0.00003148615360260009765625

(assert (not (= expect result)))

(check-sat)
(exit)
