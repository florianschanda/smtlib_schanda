(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b0000110011111011)
                expect
                (fp #b1 #b0101111 #b1101001011100001)))
(assert (fp.leq (fp #b1 #b0101111 #b1101001011100001)
                expect
                (fp #b1 #b0010101 #b1000110011101110)))
; expect = -0.00002782815136015415191650390625

(assert (not (= expect result)))

(check-sat)
(exit)
