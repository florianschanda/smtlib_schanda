(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111001 #b0101000111010101)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1111110 #b0010101011000110)))
; arg1 = 26078.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101101 #b1001011011000010)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b0 #b0001110 #b1000010110001100)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1110110100011110)
                expect
                (fp #b1 #b0111110 #b0111001110001111)))
(assert (fp.leq (fp #b1 #b0111110 #b0111001110001111)
                expect
                (fp #b0 #b0011101 #b0011100111000101)))
; expect = -0.72570037841796875

(assert (= expect result))

(check-sat)
(exit)
