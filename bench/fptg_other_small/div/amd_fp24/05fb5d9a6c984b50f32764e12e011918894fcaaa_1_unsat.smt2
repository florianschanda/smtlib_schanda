(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b1010010100110010)
                expect
                (fp #b0 #b0110000 #b1000100011001101)))
(assert (fp.leq (fp #b0 #b0110000 #b1000100011001101)
                expect
                (fp #b0 #b1111101 #b0100111011011110)))
; expect = 0.0000468255020678043365478515625

(assert (not (= expect result)))

