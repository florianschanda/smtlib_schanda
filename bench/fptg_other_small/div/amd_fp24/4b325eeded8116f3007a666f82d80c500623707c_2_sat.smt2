(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001110 #b1010100010101010)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b0110010 #b0111011110100101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001011 #b1111000010011100)
                arg2
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                arg2
                (fp #b0 #b1010110 #b1000111101101001)))
; arg2 = 9884160.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b0011111000010001)
                expect
                (fp #b1 #b0100111 #b1011001010001000)))
(assert (fp.leq (fp #b1 #b0100111 #b1011001010001000)
                expect
                (fp #b0 #b0100001 #b0111111011000010)))
; expect = -0.0000001011721906252205371856689453125

(assert (= expect result))

(check-sat)
(exit)
