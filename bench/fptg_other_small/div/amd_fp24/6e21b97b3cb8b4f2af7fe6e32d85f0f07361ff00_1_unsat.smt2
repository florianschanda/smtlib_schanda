; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110011 #b0100110100001110)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                arg1
                (fp #b0 #b1010001 #b1111101111100101)))
; arg1 = 1.02752685546875

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1010100 #b1101001110000101)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1100101 #b0000111111000111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
