(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1110001110010100)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b0110111 #b0101100001101010)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1011110 #b0010001111111100)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1110000 #b0011101101011000)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
