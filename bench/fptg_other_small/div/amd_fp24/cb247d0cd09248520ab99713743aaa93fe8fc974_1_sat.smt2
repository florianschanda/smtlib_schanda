(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101011 #b1001001001000010)
                arg1
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                arg1
                (fp #b0 #b1010101 #b0110011111011000)))
; arg1 = 41.60205078125

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001110 #b1000010010010110)
                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b1001101 #b1000011011000110)))
; arg2 = 0.00179137289524078369140625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000001 #b1011000100110010)
                expect
                (fp #b0 #b1001101 #b0110101011011110)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101011011110)
                expect
                (fp #b0 #b1100100 #b1001111000011111)))
; expect = 23223.5

(assert (= expect result))

(check-sat)
(exit)
