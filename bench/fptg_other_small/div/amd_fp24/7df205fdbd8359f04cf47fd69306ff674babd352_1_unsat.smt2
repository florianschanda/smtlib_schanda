                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b1 #b0010111 #b1010001110101110)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b1101101011000000)
                expect
                (fp #b0 #b1001100 #b1010100110011111)))
(assert (fp.leq (fp #b0 #b1001100 #b1010100110011111)
                expect
                (fp #b0 #b1101100 #b0110110101000100)))
; expect = 13619.875

(assert (not (= expect result)))

(check-sat)
(exit)
