(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: +ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000010 #b1110001010110111)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1001000 #b1110101101010100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0011100010000010)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1010011 #b1000100100101011)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001011 #b1010001010110101)
                expect
                (fp #b0 #b0110000 #b0110100001101001)))
(assert (fp.leq (fp #b0 #b0110000 #b0110100001101001)
                expect
                (fp #b0 #b1101001 #b0000101111101101)))
; expect = 0.0000429642386734485626220703125

(assert (not (= expect result)))

(check-sat)
(exit)
