(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b0 #b0001110 #b0010011100110110)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b0001000011100100)
                expect
                (fp #b0 #b1000101 #b1011001000101010)))
(assert (fp.leq (fp #b0 #b1000101 #b1011001000101010)
                expect
                (fp #b0 #b1001011 #b0010110010101110)))
; expect = 108.541015625

(assert (= expect result))

(check-sat)
(exit)
