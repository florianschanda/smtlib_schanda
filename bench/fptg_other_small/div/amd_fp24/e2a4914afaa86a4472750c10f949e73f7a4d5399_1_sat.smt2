(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b0001001111001111)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b1 #b0010000 #b1011001000000101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b1011011000001110)
                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b0 #b0000110 #b0001101101010000)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b1010101101101000)
                expect
                (fp #b0 #b0100111 #b0011011101000101)))
(assert (fp.leq (fp #b0 #b0100111 #b0011011101000101)
                expect
                (fp #b0 #b1010010 #b1111111111000000)))
; expect = 0.0000000724730853107757866382598876953125

(assert (= expect result))

(check-sat)
(exit)
