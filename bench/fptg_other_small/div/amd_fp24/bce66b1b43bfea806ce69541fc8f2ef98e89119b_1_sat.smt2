(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1001101 #b0111000000100100)
                expect
                (fp #b0 #b1111101 #b0111110101101011)))
(assert (fp.leq (fp #b0 #b1111101 #b0111110101101011)
                expect
                (fp #b0 #b1111110 #b1000000110010001)))
; expect = 6871015287739645952.0

(assert (= expect result))

