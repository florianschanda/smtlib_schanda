(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001100 #b1010001011101101)
                arg1
                (fp #b0 #b0011000 #b0000000000000000)))
