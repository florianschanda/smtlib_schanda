; Format: AMD_FP24
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100010 #b1110000001000001)
                arg1
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b0001000 #b1010100010000101)))
; arg1 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0000111 #b0111001101011001)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1001110 #b0001100100101001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
