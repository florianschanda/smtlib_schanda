                arg2
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b0000110 #b1101110110111011)))
; arg2 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0101000000000010)
                expect
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                expect
                (fp #b0 #b1111111 #b0000000000000000)))
; expect = 18446603336221196288.0

(assert (= expect result))

(check-sat)
(exit)
