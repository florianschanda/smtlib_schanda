                arg2
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1010110 #b0001011111001100)))
; arg2 = 131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101101 #b1111001101111011)
                expect
                (fp #b0 #b1001101 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1001101 #b1111111111111111)
                expect
                (fp #b0 #b1100100 #b0111001101001100)))
; expect = 32767.75

(assert (not (= expect result)))

