(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1110100 #b1111100001000100)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b0000000111100100)
                expect
                (fp #b1 #b1000001 #b0110010111101100)))
(assert (fp.leq (fp #b1 #b1000001 #b0110010111101100)
                expect
                (fp #b0 #b0101100 #b0100100101010100)))
; expect = -5.592529296875

(assert (= expect result))

(check-sat)
