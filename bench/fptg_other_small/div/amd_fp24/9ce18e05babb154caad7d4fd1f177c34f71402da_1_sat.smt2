(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1000001001100001)
                arg1
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg1
                (fp #b1 #b1000011 #b0101010101100000)))
; arg1 = -4611686018427387904.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001100 #b0000110011000111)
                arg2
                (fp #b0 #b0000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b1001000 #b1011100011000111)))
; arg2 = 0.00000000000000000006260764620291355865566718108539134846068918704986572265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                expect
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                expect
                (fp #b1 #b0111110 #b1100110110110101)))
; expect = -18446603336221196288.0

(assert (= expect result))

(check-sat)
(exit)
