; Format: AMD_FP24
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011010 #b1011000000000000)
                arg1
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg1
                (fp #b0 #b1111111 #b0000000000000000)))
; arg1 = 18446603336221196288.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100000 #b1010101000100100)
                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1111001 #b1001111111111111)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001100 #b1111010011110001)
                expect
                (fp #b0 #b1111101 #b0111100001111010)))
(assert (fp.leq (fp #b0 #b1111101 #b0111100001111010)
                expect
                (fp #b0 #b1111101 #b1000001111100000)))
; expect = 6781998826354900992.0

(assert (= expect result))

(check-sat)
(exit)
