(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b0011110110000010)
                expect
                (fp #b1 #b1011101 #b0100111100111111)))
(assert (fp.leq (fp #b1 #b1011101 #b0100111100111111)
                expect
