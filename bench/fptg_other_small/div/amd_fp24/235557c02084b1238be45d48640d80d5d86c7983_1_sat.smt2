(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0110110100110110)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                arg1
                (fp #b0 #b1110000 #b1111110100001101)))
; arg1 = 1.02752685546875

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b1110001000111100)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1100010 #b0010110100100000)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b0001100101011110)
                expect
                (fp #b0 #b0110000 #b0111001001010101)))
(assert (fp.leq (fp #b0 #b0110000 #b0111001001010101)
                expect
                (fp #b0 #b1011100 #b0100011100101001)))
; expect = 0.0000441470183432102203369140625

(assert (= expect result))

(check-sat)
(exit)
