(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -INT_BOUNDARY
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b0110100010111111)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b0000000 #b0011101010100010)))
; arg1 = -131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b1001010110101101)
                arg2
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b1 #b0100111 #b0010010000101101)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0101100100101111)
                expect
                (fp #b0 #b0110000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0110000 #b0000000000000000)
                expect
                (fp #b0 #b0110100 #b1100000011110101)))
; expect = 0.000030517578125

(assert (= expect result))

(check-sat)
(exit)
