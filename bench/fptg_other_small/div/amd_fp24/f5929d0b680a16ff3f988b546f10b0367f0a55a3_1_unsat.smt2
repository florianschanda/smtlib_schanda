(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0110101011111001)
                expect
                (fp #b0 #b1000111 #b1011001010000110)))
(assert (fp.leq (fp #b0 #b1000111 #b1011001010000110)
                expect
                (fp #b0 #b1010011 #b1110001011101111)))
; expect = 434.5234375

(assert (not (= expect result)))

