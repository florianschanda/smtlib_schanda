; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1000100000110110)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b1100111 #b1011111101000000)))
; arg1 = -130165.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1011110011000001)
                arg2
                (fp #b1 #b0111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1011110111011110)
                arg2
                (fp #b1 #b0000000 #b0010110000001010)))
; arg2 = -1.741668701171875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b0111110001110110)
                expect
                (fp #b0 #b1001111 #b0010001111101111)))
(assert (fp.leq (fp #b0 #b1001111 #b0010001111101111)
                expect
                (fp #b0 #b1110001 #b1011111000110111)))
; expect = 74735.0

(assert (= expect result))

(check-sat)
(exit)
