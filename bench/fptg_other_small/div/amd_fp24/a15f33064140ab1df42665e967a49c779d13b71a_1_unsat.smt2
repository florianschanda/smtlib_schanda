;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b0101010110001010)
                arg1
                (fp #b1 #b0000000 #b1010101010101000)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101000)
                arg1
                (fp #b0 #b1101111 #b1010010011011000)))
