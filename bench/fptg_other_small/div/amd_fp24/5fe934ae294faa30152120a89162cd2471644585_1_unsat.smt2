                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b0 #b0101001 #b0100111110101100)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110011 #b0001010100111101)
                expect
                (fp #b0 #b0111000 #b0011010100011110)))
(assert (fp.leq (fp #b0 #b0111000 #b0011010100011110)
                expect
                (fp #b0 #b1111110 #b1010010001000100)))
; expect = 0.0094335079193115234375

(assert (not (= expect result)))

(check-sat)
(exit)
