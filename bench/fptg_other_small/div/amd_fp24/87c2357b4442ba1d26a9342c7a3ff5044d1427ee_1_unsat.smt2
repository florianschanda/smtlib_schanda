(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000101 #b0111100111011000)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1101010 #b0110111010000110)))
; arg1 = 357453824.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0110101 #b1100010010011011)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b1000001 #b0101011101100010)))
; arg2 = -0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
