                expect
                (fp #b1 #b1001010 #b0110101011000011)))
(assert (fp.leq (fp #b1 #b1001010 #b0110101011000011)
                expect
                (fp #b1 #b0010000 #b1111111101000000)))
; expect = -2902.09375

(assert (not (= expect result)))

(check-sat)
