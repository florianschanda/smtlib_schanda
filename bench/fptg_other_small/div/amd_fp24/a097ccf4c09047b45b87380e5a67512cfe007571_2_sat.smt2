; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001100 #b0111010111101010)
                arg1
                (fp #b1 #b0110111 #b1011000001001100)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001100)
                arg1
                (fp #b0 #b1111100 #b1000000000011000)))
; arg1 = -0.0065963268280029296875

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010111 #b0000101001010111)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1110100 #b0000000110101101)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b1011111001000000)
                expect
                (fp #b1 #b0101001 #b0011000001001111)))
(assert (fp.leq (fp #b1 #b0101001 #b0011000001001111)
                expect
                (fp #b0 #b1100111 #b0100001111111111)))
; expect = -0.00000028340946300886571407318115234375

(assert (= expect result))

(check-sat)
(exit)
