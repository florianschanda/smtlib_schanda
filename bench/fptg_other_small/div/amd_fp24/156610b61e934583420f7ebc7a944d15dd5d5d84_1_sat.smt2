; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000011 #b0001010010110110)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1010101 #b0001100011101011)))
; arg1 = 26078.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b0000101000001110)
                arg2
                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b0010000 #b1011100001100000)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101101 #b1000000100110010)
                expect
                (fp #b1 #b1001100 #b1011001001110110)))
(assert (fp.leq (fp #b1 #b1001100 #b1011001001110110)
                expect
                (fp #b0 #b1100100 #b1101110000110100)))
; expect = -13902.75

(assert (= expect result))

(check-sat)
(exit)
