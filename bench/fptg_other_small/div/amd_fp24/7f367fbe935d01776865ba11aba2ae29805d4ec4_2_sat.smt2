; Format: AMD_FP24
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000100 #b1110111011011001)
                arg1
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1100010 #b1110100111110000)))
; arg1 = 4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b1000110100101100)
                arg2
                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1101100 #b1100010110001010)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101101 #b1010001111010100)
                expect
                (fp #b0 #b0110110 #b0011101001011101)))
(assert (fp.leq (fp #b0 #b0110110 #b0011101001011101)
                expect
                (fp #b0 #b1100000 #b1100111010011101)))
; expect = 0.0023984014987945556640625

(assert (= expect result))

(check-sat)
(exit)
