(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1011110 #b0001011000111101)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1010000011100101)
                expect
                (fp #b0 #b0111110 #b0110001000100101)))
(assert (fp.leq (fp #b0 #b0111110 #b0110001000100101)
                expect
                (fp #b0 #b1011011 #b1111011110111000)))
; expect = 0.69168853759765625

(assert (not (= expect result)))

(check-sat)
(exit)
