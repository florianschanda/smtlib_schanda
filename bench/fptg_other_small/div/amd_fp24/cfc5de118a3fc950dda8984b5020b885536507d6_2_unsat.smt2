                arg2
                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1001011 #b1101010001111001)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101110 #b0001001011000100)
                expect
                (fp #b0 #b1101000 #b0110001010101111)))
(assert (fp.leq (fp #b0 #b1101000 #b0110001010101111)
                expect
                (fp #b0 #b1101101 #b0011110110110101)))
; expect = 3046708871168.0

(assert (not (= expect result)))

(check-sat)
(exit)
