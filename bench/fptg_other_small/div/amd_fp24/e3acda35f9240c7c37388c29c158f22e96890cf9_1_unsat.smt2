(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b1 #b0000110 #b1101001100000100)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b0110110111000101)
                expect
                (fp #b1 #b1001111 #b1001001110101110)))
(assert (fp.leq (fp #b1 #b1001111 #b1001001110101110)
                expect
                (fp #b0 #b1000101 #b0101100101000111)))
; expect = -103342.0

(assert (not (= expect result)))

(check-sat)
(exit)
