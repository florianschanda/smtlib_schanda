; Format: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0001011010011101)
                arg1
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                arg1
                (fp #b1 #b1100001 #b1100010111100011)))
; arg1 = -129003500263702528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001111 #b0011111011000000)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0101000 #b1001001001111101)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
