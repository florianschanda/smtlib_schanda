(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000001 #b1011100011011000)
                expect
                (fp #b0 #b0110000 #b1100011001001010)))
(assert (fp.leq (fp #b0 #b0110000 #b1100011001001010)
                expect
                (fp #b0 #b1110010 #b0111011111100100)))
; expect = 0.000054155476391315460205078125

(assert (= expect result))

