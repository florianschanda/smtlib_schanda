(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b1101110000110010)
                arg2
                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b1110110 #b1011101100111101)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111001 #b0000100001001110)
                expect
                (fp #b0 #b0111111 #b0000100110011010)))
(assert (fp.leq (fp #b0 #b0111111 #b0000100110011010)
                expect
                (fp #b0 #b1010100 #b1101001110111100)))
; expect = 1.037506103515625

(assert (= expect result))

(check-sat)
(exit)
