(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111011 #b1010110110111001)
                expect
                (fp #b0 #b0111111 #b0000000000000010)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000010)
                expect
                (fp #b0 #b1000110 #b0101000000101010)))
; expect = 1.000030517578125

(assert (= expect result))

(check-sat)
