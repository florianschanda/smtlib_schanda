                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b10001001 #b1100010)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111101 #b1000001)
                expect
                (fp #b0 #b01110111 #b1111111)))
(assert (fp.leq (fp #b0 #b01110111 #b1111111)
                expect
                (fp #b0 #b11000101 #b0111011)))
; expect = 0.007781982421875

(assert (not (= expect result)))

(check-sat)
(exit)
