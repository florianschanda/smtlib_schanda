(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000000 #b1010001)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b11001111 #b0000010)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000111 #b1000010)
                expect
                (fp #b0 #b00000000 #b1001100)))
(assert (fp.leq (fp #b0 #b00000000 #b1001100)
                expect
                (fp #b0 #b01001101 #b0001100)))
; expect = 0.00000000000000000000000000000000000000697949770800733207856437318975708371204832674333426965895821325602810247801244258880615234375

(assert (= expect result))

(check-sat)
