(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001010 #b0001110)
                arg1
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg1
                (fp #b1 #b00000100 #b1000000)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010101 #b1011101)
                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b11011100 #b0010010)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011001 #b1001100)
                expect
                (fp #b1 #b01110111 #b0000110)))
(assert (fp.leq (fp #b1 #b01110111 #b0000110)
                expect
                (fp #b0 #b00000101 #b1111110)))
; expect = -0.00408935546875

(assert (= expect result))

(check-sat)
(exit)
