                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b10011110 #b1000001)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b0000011)
                expect
                (fp #b1 #b01110011 #b1000011)))
(assert (fp.leq (fp #b1 #b01110011 #b1000011)
                expect
                (fp #b0 #b11100111 #b0010111)))
; expect = -0.0003719329833984375

(assert (= expect result))

(check-sat)
(exit)
