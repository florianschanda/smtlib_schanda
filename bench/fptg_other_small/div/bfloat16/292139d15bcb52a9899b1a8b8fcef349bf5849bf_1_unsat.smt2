(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                arg2
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                arg2
                (fp #b0 #b01000111 #b1000111)))
; arg2 = -338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001011 #b1101011)
                expect
                (fp #b0 #b01111101 #b0000000)))
(assert (fp.leq (fp #b0 #b01111101 #b0000000)
                expect
                (fp #b0 #b10001111 #b1110101)))
; expect = 0.25

(assert (not (= expect result)))

(check-sat)
(exit)
