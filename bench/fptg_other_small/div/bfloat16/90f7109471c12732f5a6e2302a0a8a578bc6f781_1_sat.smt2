; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010100 #b0101100)
                arg1
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                arg1
                (fp #b0 #b10101101 #b1010000)))
; arg1 = 3489792.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011110 #b1111010)
                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b10101111 #b1001101)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b1000000)
                expect
                (fp #b0 #b10010011 #b1011111)))
(assert (fp.leq (fp #b0 #b10010011 #b1011111)
                expect
                (fp #b0 #b10111100 #b0011110)))
; expect = 1826816.0

(assert (= expect result))

(check-sat)
(exit)
