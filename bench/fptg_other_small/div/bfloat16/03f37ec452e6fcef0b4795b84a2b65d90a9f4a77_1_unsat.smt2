(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b1011101)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b0 #b00001111 #b0111000)))
; arg1 = -177.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111000 #b0000010)
                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b10100110 #b0110111)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100100 #b1110100)
                expect
                (fp #b1 #b10000101 #b0111001)))
(assert (fp.leq (fp #b1 #b10000101 #b0111001)
                expect
                (fp #b1 #b01100110 #b1100111)))
; expect = -92.5

(assert (not (= expect result)))

(check-sat)
(exit)
