; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000101 #b1001001)
                arg1
                (fp #b1 #b01111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111 #b0101111)
                arg1
                (fp #b0 #b00110111 #b0111100)))
; arg1 = -1.3671875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000010 #b0111100)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b00011011 #b1001010)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b0010001)
                expect
                (fp #b0 #b01111110 #b1010000)))
(assert (fp.leq (fp #b0 #b01111110 #b1010000)
                expect
                (fp #b0 #b11111110 #b1011011)))
; expect = 0.8125

(assert (not (= expect result)))

(check-sat)
(exit)
