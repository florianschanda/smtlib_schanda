; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000111 #b1000101)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b10100011 #b1000111)))
; arg1 = 86.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001111 #b0001111)
                arg2
                (fp #b0 #b00000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000)
                arg2
                (fp #b0 #b11010110 #b0111011)))
; arg2 = 0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
