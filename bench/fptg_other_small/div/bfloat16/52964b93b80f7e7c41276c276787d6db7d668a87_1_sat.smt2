(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b1001111)
                arg1
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg1
                (fp #b0 #b00111011 #b0010001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001001 #b1100111)
                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b1 #b10000011 #b1010001)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100100 #b0111000)
                expect
                (fp #b0 #b01011111 #b1101101)))
(assert (fp.leq (fp #b0 #b01011111 #b1101101)
                expect
                (fp #b0 #b11010100 #b1011000)))
; expect = 0.000000000431100488640367984771728515625

(assert (= expect result))

(check-sat)
(exit)
