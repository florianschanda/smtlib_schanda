                arg2
                (fp #b0 #b11110001 #b1110010)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011000 #b1011101)
                expect
                (fp #b0 #b00011010 #b1000100)))
(assert (fp.leq (fp #b0 #b00011010 #b1000100)
                expect
                (fp #b0 #b10010110 #b0100001)))
; expect = 0.0000000000000000000000000000006039716305598371635183546827946332070935486768803457380272448062896728515625

(assert (= expect result))

