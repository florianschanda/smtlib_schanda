(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100011 #b1010100)
                expect
                (fp #b0 #b11111101 #b0101011)))
(assert (fp.leq (fp #b0 #b11111101 #b0101011)
                expect
                (fp #b0 #b11111101 #b1100111)))
; expect = 113648993639610307133275503653969461248.0

(assert (= expect result))

