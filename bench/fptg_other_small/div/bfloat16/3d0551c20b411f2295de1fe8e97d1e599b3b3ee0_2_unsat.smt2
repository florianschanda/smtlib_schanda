                arg2
                (fp #b0 #b01011110 #b0011101)))
; arg2 = -16924961474604808445886464.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010010 #b1010000)
                expect
                (fp #b0 #b00110010 #b1001011)))
(assert (fp.leq (fp #b0 #b00110010 #b1001011)
                expect
                (fp #b0 #b10001011 #b0000001)))
; expect = 0.000000000000000000000010494854021766538624930997780637653704616241157054901123046875

(assert (not (= expect result)))

