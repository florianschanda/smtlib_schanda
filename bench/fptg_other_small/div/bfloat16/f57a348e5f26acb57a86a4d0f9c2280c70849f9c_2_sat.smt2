; Format: BFLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001110 #b0000111)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b0 #b10100111 #b1011101)))
; arg1 = -256.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                arg2
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                arg2
                (fp #b0 #b00100100 #b0101011)))
; arg2 = -338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111001 #b0110011)
                expect
                (fp #b0 #b00000111 #b0000001)))
(assert (fp.leq (fp #b0 #b00000111 #b0000001)
                expect
                (fp #b0 #b00011111 #b0101000)))
; expect = 0.0000000000000000000000000000000000007581938562803754426398350665083484621930392841179964513731448505495791323482990264892578125

(assert (= expect result))

(check-sat)
(exit)
