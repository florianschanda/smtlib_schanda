;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100100 #b0001110)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b10100100 #b0101100)))
; arg1 = 86.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101111 #b0010100)
                arg2
                (fp #b0 #b00111110 #b0111101)))
(assert (fp.leq (fp #b0 #b00111110 #b0111101)
                arg2
                (fp #b0 #b11100010 #b1010100)))
; arg2 = 0.000000000000000000040022306757765691020978238157113082706928253173828125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100001 #b1100110)
                expect
                (fp #b0 #b11000101 #b1101001)))
(assert (fp.leq (fp #b0 #b11000101 #b1101001)
                expect
                (fp #b0 #b11011100 #b0110011)))
; expect = 2149045684587162763264.0

(assert (= expect result))

(check-sat)
(exit)
