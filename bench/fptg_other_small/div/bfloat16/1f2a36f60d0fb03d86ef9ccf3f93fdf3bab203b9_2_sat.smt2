(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0011001)
                expect
                (fp #b1 #b11111101 #b1110001)))
(assert (fp.leq (fp #b1 #b11111101 #b1110001)
                expect
