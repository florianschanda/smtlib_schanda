(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b10111000 #b1111010)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000011 #b0010010)
                expect
                (fp #b0 #b10010100 #b1010011)))
(assert (fp.leq (fp #b0 #b10010100 #b1010011)
                expect
                (fp #b0 #b11000111 #b1000000)))
; expect = 3457024.0

(assert (not (= expect result)))

