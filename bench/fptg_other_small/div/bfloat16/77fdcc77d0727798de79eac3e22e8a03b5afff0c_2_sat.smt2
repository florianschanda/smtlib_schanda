                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b11011001 #b0001010)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000011 #b1011011)
                expect
                (fp #b1 #b00111011 #b0111110)))
(assert (fp.leq (fp #b1 #b00111011 #b0111110)
                expect
                (fp #b0 #b11110000 #b0100111)))
; expect = -0.00000000000000000000502925812432240826321816484778537414968013763427734375

(assert (= expect result))

(check-sat)
(exit)
