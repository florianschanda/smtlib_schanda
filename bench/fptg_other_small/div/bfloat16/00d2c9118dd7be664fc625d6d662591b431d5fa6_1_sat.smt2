(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001101 #b1111111)
                arg1
                (fp #b1 #b00000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000 #b1111010)
                arg1
                (fp #b0 #b01100110 #b1011000)))
; arg1 = -0.000000000000000000000000000000000000011203930531274927810327020120399529116709156087983959189380289700466164504177868366241455078125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1110100)
                arg2
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b0 #b01110111 #b1000001)))
; arg2 = -10627982632313475302148359673872384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10010011 #b0110101)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b10111110 #b1111110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
