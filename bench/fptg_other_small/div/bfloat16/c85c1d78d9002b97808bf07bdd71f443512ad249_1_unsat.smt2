                (fp #b0 #b11111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000)
                arg2
                (fp #b0 #b11111101 #b1000111)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11011101 #b0011111)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b10110010 #b1000001)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
