                expect
                (fp #b0 #b00011000 #b0110111)))
(assert (fp.leq (fp #b0 #b00011000 #b0110111)
                expect
                (fp #b0 #b01011001 #b1001001)))
; expect = 0.00000000000000000000000000000014097807192914566444369758539721667971698904064936641589156351983547210693359375

