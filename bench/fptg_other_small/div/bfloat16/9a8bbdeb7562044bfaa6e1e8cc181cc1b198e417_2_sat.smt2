; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000000 #b1000000)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b10100111 #b1110001)))
; arg1 = 30.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b1001011)
                arg2
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg2
                (fp #b0 #b11100000 #b1111101)))
; arg2 = 0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
