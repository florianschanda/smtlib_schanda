                arg2
                (fp #b1 #b11011100 #b1000101)))
; arg2 = -338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b0000111)
                expect
                (fp #b1 #b00000111 #b0000001)))
(assert (fp.leq (fp #b1 #b00000111 #b0000001)
                expect
                (fp #b0 #b01000000 #b1011101)))
; expect = -0.0000000000000000000000000000000000007581938562803754426398350665083484621930392841179964513731448505495791323482990264892578125

(assert (not (= expect result)))

