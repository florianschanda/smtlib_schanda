; Format: BFLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110001 #b1011100)
                arg1
                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg1
                (fp #b0 #b10111101 #b0001011)))
; arg1 = 0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010101 #b0001110)
                arg2
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg2
                (fp #b0 #b11011001 #b1011001)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001110 #b0011001)
                expect
                (fp #b1 #b01111110 #b1111110)))
(assert (fp.leq (fp #b1 #b01111110 #b1111110)
                expect
                (fp #b1 #b01110011 #b0100111)))
; expect = -0.9921875

(assert (= expect result))

(check-sat)
(exit)
