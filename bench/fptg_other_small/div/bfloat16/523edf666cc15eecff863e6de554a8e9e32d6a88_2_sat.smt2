                arg2
                (fp #b1 #b11010100 #b0010010)))
; arg2 = -10627982632313475302148359673872384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101100 #b0011010)
                expect
                (fp #b0 #b01101010 #b1010111)))
(assert (fp.leq (fp #b0 #b01101010 #b1010111)
                expect
