                arg2
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                arg2
                (fp #b0 #b11111111 #b0000000)))
; arg2 = 338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101011 #b1011011)
                expect
                (fp #b0 #b00000000 #b0100001)))
(assert (fp.leq (fp #b0 #b00000000 #b0100001)
                expect
                (fp #b0 #b01011100 #b0010101)))
; expect = 0.0000000000000000000000000000000000000030305713732137099814818988850261021381262471385530381413897504927490444970317184925079345703125

(assert (not (= expect result)))

(check-sat)
(exit)
