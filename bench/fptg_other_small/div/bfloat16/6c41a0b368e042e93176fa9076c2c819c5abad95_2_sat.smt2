(assert (fp.leq (fp #b1 #b11011011 #b0011000)
                arg2
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg2
                (fp #b1 #b01001011 #b1010110)))
; arg2 = -18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100010 #b0011101)
                expect
                (fp #b0 #b10101100 #b1110100)))
(assert (fp.leq (fp #b0 #b10101100 #b1110100)
                expect
                (fp #b0 #b11011011 #b0100101)))
; expect = 67070209294336.0

(assert (= expect result))

(check-sat)
(exit)
