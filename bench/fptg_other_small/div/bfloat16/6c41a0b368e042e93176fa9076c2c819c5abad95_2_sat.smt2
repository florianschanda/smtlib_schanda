;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b0101100)
                arg1
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                arg1
                (fp #b1 #b11011011 #b1011111)))
; arg1 = -1232156383421838978254795515625472.0

