                expect
                (fp #b1 #b10111110 #b0000110)))
(assert (fp.leq (fp #b1 #b10111110 #b0000110)
                expect
                (fp #b0 #b10011000 #b1101110)))
; expect = -9655717601082343424.0

(assert (not (= expect result)))

