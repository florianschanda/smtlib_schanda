; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101001 #b0000001)
                arg1
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                arg1
                (fp #b0 #b10101001 #b1011101)))
; arg1 = 1.3359375

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10001000 #b0001010)
                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b11111010 #b0000001)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00001111 #b0001111)
                expect
                (fp #b0 #b01101100 #b0111100)))
(assert (fp.leq (fp #b0 #b01101100 #b0111100)
                expect
                (fp #b0 #b10001110 #b0001000)))
; expect = 0.000002801418304443359375

(assert (= expect result))

(check-sat)
(exit)
