; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b0100011)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b11010110 #b1111101)))
; arg1 = 30.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111101 #b1111101)
                arg2
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b10011001 #b0100010)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000111 #b0010000)
                expect
                (fp #b0 #b10000011 #b1101110)))
(assert (fp.leq (fp #b0 #b10000011 #b1101110)
                expect
                (fp #b0 #b11100110 #b0101011)))
; expect = 29.75

(assert (not (= expect result)))

(check-sat)
(exit)
