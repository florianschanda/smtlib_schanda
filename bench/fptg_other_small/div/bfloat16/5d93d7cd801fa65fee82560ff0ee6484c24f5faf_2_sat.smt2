;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b0101111)
                arg1
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                arg1
                (fp #b1 #b10001010 #b1001101)))
; arg1 = -8510837770086989389931479040.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101001 #b0001101)
                arg2
                (fp #b0 #b10110000 #b1010100)))
(assert (fp.leq (fp #b0 #b10110000 #b1010100)
                arg2
                (fp #b0 #b11010011 #b1101001)))
; arg2 = 932385860354048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b0110001)
                expect
                (fp #b1 #b10101010 #b0000101)))
(assert (fp.leq (fp #b1 #b10101010 #b0000101)
                expect
                (fp #b0 #b00110101 #b1101010)))
; expect = -9139690405888.0

(assert (= expect result))

(check-sat)
(exit)
