                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b01101110 #b1111001)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100001 #b0011101)
                expect
                (fp #b1 #b10010011 #b1111101)))
(assert (fp.leq (fp #b1 #b10010011 #b1111101)
                expect
                (fp #b1 #b10000011 #b1011110)))
; expect = -2072576.0

(assert (= expect result))

(check-sat)
