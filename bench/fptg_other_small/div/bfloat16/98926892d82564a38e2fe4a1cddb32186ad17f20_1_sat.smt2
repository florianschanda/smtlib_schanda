                arg2
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b11000011 #b1111110)))
; arg2 = -0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b0011000)
                expect
                (fp #b1 #b11000111 #b1110011)))
(assert (fp.leq (fp #b1 #b11000111 #b1110011)
                expect
                (fp #b1 #b01111101 #b0110111)))
; expect = -8965117619822842085376.0

(assert (= expect result))

(check-sat)
(exit)
