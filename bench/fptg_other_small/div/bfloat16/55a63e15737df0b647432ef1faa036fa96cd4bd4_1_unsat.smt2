                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg2
                (fp #b0 #b01011110 #b0010100)))
; arg2 = -18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b0001110)
                expect
                (fp #b1 #b01000111 #b0000000)))
(assert (fp.leq (fp #b1 #b01000111 #b0000000)
                expect
                (fp #b1 #b00110111 #b1011110)))
; expect = -0.00000000000000001387778780781445675529539585113525390625

(assert (not (= expect result)))

(check-sat)
(exit)
