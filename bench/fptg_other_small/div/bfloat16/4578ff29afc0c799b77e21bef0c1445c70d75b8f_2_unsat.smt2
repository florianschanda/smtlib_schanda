(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b11001011 #b1010111)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100000 #b1101111)
                expect
                (fp #b1 #b11011010 #b1100111)))
(assert (fp.leq (fp #b1 #b11011010 #b1100111)
                expect
                (fp #b1 #b01100100 #b0111010)))
; expect = -4468189829295669429714026496.0

(assert (not (= expect result)))

