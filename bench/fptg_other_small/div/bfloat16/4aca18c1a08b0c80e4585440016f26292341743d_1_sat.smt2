                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b10100111 #b0110100)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b0010111)
                expect
                (fp #b0 #b01101100 #b0001100)))
(assert (fp.leq (fp #b0 #b01101100 #b0001100)
                expect
                (fp #b0 #b11110111 #b1010001)))
; expect = 0.000002086162567138671875

(assert (= expect result))

(check-sat)
(exit)
