; arg2 = 338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111010 #b0010100)
                expect
                (fp #b1 #b00000110 #b0000111)))
(assert (fp.leq (fp #b1 #b00000110 #b0000111)
                expect
                (fp #b0 #b10100011 #b0001110)))
; expect = -0.00000000000000000000000000000000000039672934340252203393944858131250791626379962541057953850920370086896582506597042083740234375

(assert (= expect result))

