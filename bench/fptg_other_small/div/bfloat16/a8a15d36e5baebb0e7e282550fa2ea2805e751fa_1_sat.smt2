; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011111 #b1000111)
                arg1
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                arg1
                (fp #b0 #b10111101 #b1000111)))
; arg1 = -8510837770086989389931479040.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0101111)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b11000110 #b0100111)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11001001 #b1101000)
                expect
                (fp #b0 #b11011011 #b0000010)))
(assert (fp.leq (fp #b0 #b11011011 #b0000010)
                expect
                (fp #b0 #b11110001 #b0100101)))
; expect = 5029131409596857366777692160.0

(assert (= expect result))

(check-sat)
(exit)
