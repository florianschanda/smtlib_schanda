                (fp #b0 #b00110011 #b0010011)))
(assert (fp.leq (fp #b0 #b00110011 #b0010011)
                expect
                (fp #b0 #b01000000 #b0000100)))
; expect = 0.00000000000000000000001519944375566188352576213471678556743427179753780364990234375

(assert (not (= expect result)))

