                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b11101000 #b1101011)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b0000110)
                expect
                (fp #b1 #b01111110 #b0110000)))
(assert (fp.leq (fp #b1 #b01111110 #b0110000)
                expect
                (fp #b1 #b00111110 #b1001110)))
; expect = -0.6875

(assert (not (= expect result)))

(check-sat)
(exit)
