; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010101 #b0111100)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b10111001 #b1000100)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
