                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b10110000 #b1011100)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000101 #b0111011)
                expect
                (fp #b0 #b01110010 #b0000100)))
(assert (fp.leq (fp #b0 #b01110010 #b0000100)
                expect
                (fp #b0 #b10111001 #b1110000)))
; expect = 0.000125885009765625

(assert (not (= expect result)))

(check-sat)
(exit)
