(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                arg2
                (fp #b0 #b11011010 #b1011101)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101001 #b1100001)
                expect
                (fp #b1 #b10100110 #b1110110)))
(assert (fp.leq (fp #b1 #b10100110 #b1110110)
                expect
