(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b00111010 #b0001011)))
; arg2 = -0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001100 #b0010111)
                expect
                (fp #b0 #b11000001 #b1110111)))
(assert (fp.leq (fp #b0 #b11000001 #b1110111)
                expect
                (fp #b0 #b11110011 #b1011011)))
; expect = 142385805818945601536.0

(assert (= expect result))

(check-sat)
