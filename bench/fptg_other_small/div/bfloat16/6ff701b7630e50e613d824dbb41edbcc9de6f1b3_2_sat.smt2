(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100111 #b1101000)
                expect
                (fp #b1 #b10111100 #b1010100)))
(assert (fp.leq (fp #b1 #b10111100 #b1010100)
                expect
