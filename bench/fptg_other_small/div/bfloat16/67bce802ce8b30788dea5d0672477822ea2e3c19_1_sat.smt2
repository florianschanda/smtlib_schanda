(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000100 #b1101011)
                expect
                (fp #b1 #b11000010 #b0011100)))
(assert (fp.leq (fp #b1 #b11000010 #b0011100)
                expect
