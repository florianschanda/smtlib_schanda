; Format: BFLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000111 #b0110100)
                arg1
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg1
                (fp #b0 #b00110000 #b0100110)))
; arg1 = 0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b1101111)
                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b0 #b11010100 #b1011011)))
; arg2 = -522272047294030513416641720614912.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00100101 #b1011101)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b00101011 #b1001100)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
