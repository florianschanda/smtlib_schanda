                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg2
                (fp #b0 #b01011110 #b1101111)))
; arg2 = 0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100011 #b0010110)
                expect
                (fp #b1 #b01111000 #b0000001)))
(assert (fp.leq (fp #b1 #b01111000 #b0000001)
                expect
                (fp #b0 #b00101000 #b1010001)))
; expect = -0.00787353515625

(assert (= expect result))

(check-sat)
