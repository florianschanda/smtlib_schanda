; Format: BFLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111110 #b1001000)
                arg1
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg1
                (fp #b0 #b10111011 #b1101101)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101010 #b0101010)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b10010011 #b1001011)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010110 #b0100000)
                expect
                (fp #b0 #b00000000 #b0000010)))
(assert (fp.leq (fp #b0 #b00000000 #b0000010)
                expect
                (fp #b0 #b11011011 #b0110010)))
; expect = 0.000000000000000000000000000000000000000183670992315982423120115083940975887159166493245638675235742454106002696789801120758056640625

(assert (= expect result))

(check-sat)
(exit)
