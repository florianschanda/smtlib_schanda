; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1100000)
                arg1
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                arg1
                (fp #b1 #b01010110 #b1011101)))
; arg1 = -70116776777654312295675822429788176384.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01011110 #b1111000)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b10101011 #b1110010)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
