(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001001 #b0101110)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b1 #b10000000 #b1010000)))
; arg1 = -177.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101110 #b1000101)
                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b0 #b11101010 #b0100010)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1110010)
                expect
                (fp #b0 #b01100111 #b0100101)))
(assert (fp.leq (fp #b0 #b01100111 #b0100101)
                expect
                (fp #b0 #b01110111 #b0111111)))
; expect = 0.0000000768341124057769775390625

(assert (not (= expect result)))

(check-sat)
(exit)
