(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b0011011)
                expect
                (fp #b1 #b01111111 #b0101000)))
(assert (fp.leq (fp #b1 #b01111111 #b0101000)
                expect
                (fp #b0 #b01010011 #b1010011)))
; expect = -1.3125

(assert (= expect result))

