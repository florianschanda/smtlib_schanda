(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b11101110 #b0111000)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111101 #b1101111)
                expect
                (fp #b1 #b01110111 #b1111111)))
(assert (fp.leq (fp #b1 #b01110111 #b1111111)
                expect
                (fp #b0 #b10110101 #b1110111)))
; expect = -0.007781982421875

(assert (not (= expect result)))

(check-sat)
(exit)
