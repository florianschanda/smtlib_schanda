(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b1 #b01111111 #b0000010)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10110100 #b1111001)
                expect
                (fp #b0 #b11110110 #b0010010)))
(assert (fp.leq (fp #b0 #b11110110 #b0010010)
                expect
                (fp #b0 #b11111101 #b1010000)))
; expect = 758075341346084833765452464066134016.0

(assert (not (= expect result)))

