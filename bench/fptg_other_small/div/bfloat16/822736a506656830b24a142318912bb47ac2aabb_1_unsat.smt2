(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg2
                (fp #b0 #b10000111 #b1011101)))
; arg2 = 256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11000001 #b1101010)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b01000101 #b0011011)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
