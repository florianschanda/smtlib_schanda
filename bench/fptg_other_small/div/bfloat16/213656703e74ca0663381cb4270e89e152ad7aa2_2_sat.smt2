(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b1 #b01011011 #b0000100)))
; arg2 = -16924961474604808445886464.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000001 #b0111010)
                expect
                (fp #b0 #b10000111 #b1111100)))
(assert (fp.leq (fp #b0 #b10000111 #b1111100)
                expect
