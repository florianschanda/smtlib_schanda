; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b1001101)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b0 #b00010000 #b1101101)))
; arg1 = -134.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100101 #b1110101)
                arg2
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg2
                (fp #b0 #b01110111 #b0111011)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
