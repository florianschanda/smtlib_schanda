(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b0 #b10010010 #b1110100)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010110 #b1001110)
                expect
                (fp #b0 #b10010000 #b0000100)))
(assert (fp.leq (fp #b0 #b10010000 #b0000100)
                expect
                (fp #b0 #b11001000 #b1101101)))
; expect = 135168.0

(assert (= expect result))

(check-sat)
