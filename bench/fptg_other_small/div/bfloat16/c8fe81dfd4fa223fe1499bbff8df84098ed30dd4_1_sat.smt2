(assert (fp.leq (fp #b0 #b10110000 #b1010100)
                arg2
                (fp #b0 #b11110101 #b0011111)))
; arg2 = 932385860354048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011001 #b1000010)
                expect
                (fp #b1 #b11001010 #b1111110)))
(assert (fp.leq (fp #b1 #b11001010 #b1111110)
                expect
                (fp #b0 #b10000001 #b0001101)))
; expect = -74967567915555617767424.0

(assert (= expect result))

