                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b0 #b00000111 #b0011010)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b1110011)
                expect
                (fp #b1 #b10000101 #b0011100)))
(assert (fp.leq (fp #b1 #b10000101 #b0011100)
                expect
                (fp #b0 #b01100111 #b0110011)))
; expect = -78.0

(assert (not (= expect result)))

(check-sat)
(exit)
