                arg2
                (fp #b1 #b11110010 #b0001001)))
; arg2 = -338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001101 #b1001101)
                expect
                (fp #b1 #b00000011 #b1110000)))
(assert (fp.leq (fp #b1 #b00000011 #b1110000)
                expect
                (fp #b0 #b10011110 #b1000011)))
; expect = -0.0000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

