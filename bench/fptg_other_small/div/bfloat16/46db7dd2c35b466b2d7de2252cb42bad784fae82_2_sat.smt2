                arg2
                (fp #b0 #b11110000 #b1101000)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000000 #b0101110)
                expect
                (fp #b0 #b00101111 #b1001001)))
(assert (fp.leq (fp #b0 #b00101111 #b1001001)
                expect
                (fp #b0 #b11000111 #b1001101)))
; expect = 0.000000000000000000000001298932055649676270696508961766113543490064330399036407470703125

(assert (= expect result))

