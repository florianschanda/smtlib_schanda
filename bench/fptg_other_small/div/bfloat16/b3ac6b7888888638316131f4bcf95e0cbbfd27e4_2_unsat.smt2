(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b0001001)
                expect
                (fp #b0 #b11111101 #b1000011)))
(assert (fp.leq (fp #b0 #b11111101 #b1000011)
                expect
                (fp #b0 #b11111110 #b0110000)))
; expect = 129599729589029297608121188377333596160.0

(assert (not (= expect result)))

