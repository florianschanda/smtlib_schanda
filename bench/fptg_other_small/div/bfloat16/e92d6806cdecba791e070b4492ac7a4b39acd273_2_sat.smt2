; Format: BFLOAT16
; Arg1: +ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101100 #b0110101)
                arg1
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg1
                (fp #b0 #b10101010 #b1010001)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010011 #b1100011)
                arg2
                (fp #b1 #b00000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000 #b1101110)
                arg2
                (fp #b0 #b00100110 #b0111011)))
; arg2 = -0.000000000000000000000000000000000000010101904577379033271606329616753673793754157128510127137965834975830148323439061641693115234375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0111110)
                expect
                (fp #b1 #b11111101 #b0010101)))
(assert (fp.leq (fp #b1 #b11111101 #b0010101)
                expect
                (fp #b1 #b11111011 #b1000101)))
; expect = -99027485685976232531333625990885670912.0

(assert (= expect result))

(check-sat)
(exit)
