                arg2
                (fp #b0 #b11111100 #b1000010)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011100 #b1101001)
                expect
                (fp #b0 #b00011001 #b0000011)))
(assert (fp.leq (fp #b0 #b00011001 #b0000011)
                expect
                (fp #b0 #b01100000 #b0100000)))
; expect = 0.0000000000000000000000000000002018374581717823174002664883829003829827930527329726828611455857753753662109375

(assert (= expect result))

