                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b0 #b00011010 #b1110000)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001101 #b1010000)
                expect
                (fp #b1 #b01100110 #b0011111)))
(assert (fp.leq (fp #b1 #b01100110 #b0011111)
                expect
                (fp #b1 #b00001100 #b1000111)))
; expect = -0.00000003702007234096527099609375

(assert (not (= expect result)))

(check-sat)
(exit)
