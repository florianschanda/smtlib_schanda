(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10111110 #b0110011111)
                expect
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                expect
                (fp #b0 #b11000011 #b0101001001)))
; expect = -0

(assert (not (= expect result)))

