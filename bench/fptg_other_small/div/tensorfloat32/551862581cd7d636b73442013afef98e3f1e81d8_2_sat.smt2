(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b0100010001)
                arg1
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg1
                (fp #b0 #b11111111 #b0000000000)))
; arg1 = 340116213421465348979261631549233168384.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101111 #b0011110100)
                arg2
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b0 #b00110110 #b0100101010)))
; arg2 = -13052620958651699370655744.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1111010001)
                expect
                (fp #b1 #b10101011 #b0111101101)))
(assert (fp.leq (fp #b1 #b10101011 #b0111101101)
                expect
                (fp #b0 #b01110010 #b1110101010)))
; expect = -26061861552128.0

(assert (= expect result))

(check-sat)
(exit)
