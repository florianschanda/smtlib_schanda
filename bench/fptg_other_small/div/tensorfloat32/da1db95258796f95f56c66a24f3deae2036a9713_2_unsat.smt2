                (fp #b0 #b11010010 #b0100101111)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101001 #b1011101000)
                expect
                (fp #b0 #b00010100 #b0000111010)))
(assert (fp.leq (fp #b0 #b00010100 #b0000111010)
                expect
                (fp #b0 #b11010001 #b1100100000)))
; expect = 0.00000000000000000000000000000000651205062445934122814552541836528549580695619802828133515504305250942707061767578125

(assert (not (= expect result)))

