                arg2
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                arg2
                (fp #b0 #b11011100 #b0111101111)))
; arg2 = 1893763643309293568.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011110 #b1110000111)
                expect
                (fp #b1 #b11000000 #b0011011110)))
(assert (fp.leq (fp #b1 #b11000000 #b0011011110)
                expect
                (fp #b0 #b11111010 #b0100111000)))
; expect = -44891881085629104128.0

(assert (= expect result))

(check-sat)
(exit)
