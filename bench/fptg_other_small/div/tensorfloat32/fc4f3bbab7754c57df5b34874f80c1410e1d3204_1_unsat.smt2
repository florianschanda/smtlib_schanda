                arg2
                (fp #b0 #b10111010 #b0001001000)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101110 #b1101001000)
                expect
                (fp #b1 #b10100111 #b1101110110)))
(assert (fp.leq (fp #b1 #b10100111 #b1101110110)
                expect
                (fp #b0 #b00001101 #b1100001001)))
; expect = -2050846883840.0

(assert (not (= expect result)))

(check-sat)
