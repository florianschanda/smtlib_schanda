                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b00101011 #b1001010011)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0010110110)
                expect
                (fp #b1 #b11111100 #b1001101000)))
(assert (fp.leq (fp #b1 #b11111100 #b1001101000)
                expect
                (fp #b1 #b10111000 #b0100100000)))
; expect = -68122934783976938486320111839367659520.0

(assert (= expect result))

(check-sat)
(exit)
