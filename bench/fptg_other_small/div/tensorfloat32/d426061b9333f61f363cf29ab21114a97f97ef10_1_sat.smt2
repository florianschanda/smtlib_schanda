                arg2
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                arg2
                (fp #b0 #b11110010 #b1111110100)))
; arg2 = 1893763643309293568.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b1100110010)
                expect
                (fp #b0 #b10100110 #b1101101001)))
(assert (fp.leq (fp #b0 #b10100110 #b1101101001)
                expect
                (fp #b0 #b11111000 #b1110110100)))
; expect = 1018444120064.0

(assert (= expect result))

(check-sat)
(exit)
