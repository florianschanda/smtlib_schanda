; arg2 = 0.000000000000000000000000000000000000126549313705711889529759292835332386252665713846245047237426550879035858088172972202301025390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                expect
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                expect
                (fp #b1 #b11010110 #b1110011100)))
; expect = -340116213421465348979261631549233168384.0

(assert (= expect result))

(check-sat)
