                (fp #b0 #b10010001 #b0001111011)))
(assert (fp.leq (fp #b0 #b10010001 #b0001111011)
                expect
                (fp #b0 #b11100011 #b1111001011)))
; expect = 293632.0

(assert (= expect result))

