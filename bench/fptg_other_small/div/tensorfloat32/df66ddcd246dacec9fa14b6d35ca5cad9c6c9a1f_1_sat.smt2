(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000101 #b0011111100)
                arg1
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b01011110 #b1001111100)))
; arg1 = -18437736874454810624.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00100010 #b0000100110)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11010011 #b1100000000)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1111100000)
                expect
                (fp #b1 #b10110100 #b1000100000)))
(assert (fp.leq (fp #b1 #b10110100 #b1000100000)
                expect
                (fp #b1 #b01100101 #b1110100100)))
; expect = -13792273858822144.0

(assert (= expect result))

(check-sat)
(exit)
