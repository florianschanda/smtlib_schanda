; arg2 = -0.0000000000000000000000000000000018567168370108195645867787352732814930281386202326476819735034951008856296539306640625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b1110001001)
                expect
                (fp #b1 #b11110110 #b0101101011)))
(assert (fp.leq (fp #b1 #b11110110 #b0101101011)
                expect
                (fp #b0 #b01100101 #b1100010000)))
; expect = -900214467848475740096474801078534144.0

(assert (= expect result))

