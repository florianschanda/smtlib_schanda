                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11110111 #b0100011001)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011101 #b0011000001)
                expect
                (fp #b0 #b11001011 #b0011011101)))
(assert (fp.leq (fp #b0 #b11001011 #b0011011101)
                expect
                (fp #b0 #b11101000 #b1111000001)))
; expect = 91864785487073567047680.0

(assert (= expect result))

(check-sat)
(exit)
