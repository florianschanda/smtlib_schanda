                arg2
                (fp #b0 #b11111101 #b1000011001)))
; arg2 = 60812180807159901185349173007825764352.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110010 #b0001101001)
                expect
                (fp #b1 #b01101000 #b1101010011)))
(assert (fp.leq (fp #b1 #b01101000 #b1101010011)
                expect
                (fp #b0 #b00000000 #b1101110001)))
; expect = -0.000000218278728425502777099609375

(assert (= expect result))

