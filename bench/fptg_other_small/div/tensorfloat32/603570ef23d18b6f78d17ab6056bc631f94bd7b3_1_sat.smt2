                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b1 #b11100000 #b0011100000)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100000 #b0100000111)
                expect
                (fp #b0 #b00001001 #b0100010100)))
(assert (fp.leq (fp #b0 #b00001001 #b0100010100)
                expect
                (fp #b0 #b10110001 #b1110100011)))
; expect = 0.000000000000000000000000000000000003820356640172434400898393745972298452910663059509284444903443045404856093227863311767578125

(assert (= expect result))

(check-sat)
