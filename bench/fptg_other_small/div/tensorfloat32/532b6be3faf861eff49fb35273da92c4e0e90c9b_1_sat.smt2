; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011010 #b0110001110)
                expect
                (fp #b1 #b01110111 #b0010100011)))
(assert (fp.leq (fp #b1 #b01110111 #b0010100011)
                expect
                (fp #b0 #b00000011 #b1101000010)))
; expect = -0.004528045654296875

(assert (= expect result))

