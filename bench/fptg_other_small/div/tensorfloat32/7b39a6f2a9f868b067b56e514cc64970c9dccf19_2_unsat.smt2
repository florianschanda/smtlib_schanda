                (fp #b0 #b11100001 #b1001110011)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010001 #b0101011010)
                expect
                (fp #b1 #b10001001 #b1001001010)))
(assert (fp.leq (fp #b1 #b10001001 #b1001001010)
                expect
                (fp #b0 #b10010001 #b0000001101)))
; expect = -1610.0

(assert (not (= expect result)))

