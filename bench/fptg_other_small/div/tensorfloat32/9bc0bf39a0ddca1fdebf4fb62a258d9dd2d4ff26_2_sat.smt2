                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b0 #b01111110 #b0111010001)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001011 #b0011111100)
                expect
                (fp #b1 #b01110111 #b0100111011)))
(assert (fp.leq (fp #b1 #b01110111 #b0100111011)
                expect
                (fp #b0 #b10010100 #b1110110010)))
; expect = -0.005107879638671875

(assert (= expect result))

(check-sat)
(exit)
