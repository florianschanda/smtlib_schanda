                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b01001110 #b1100101000)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01010111 #b1101101110)
                expect
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00011100 #b0111010100)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
