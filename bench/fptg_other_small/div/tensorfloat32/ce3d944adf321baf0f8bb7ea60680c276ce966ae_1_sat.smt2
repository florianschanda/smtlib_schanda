                arg2
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b1 #b00110010 #b0000100101)))
; arg2 = -13052620958651699370655744.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01000110 #b1101001111)
                expect
                (fp #b0 #b10010010 #b1111000001)))
(assert (fp.leq (fp #b0 #b10010010 #b1111000001)
                expect
                (fp #b0 #b11110110 #b1000100001)))
; expect = 1016320.0

(assert (= expect result))

(check-sat)
(exit)
