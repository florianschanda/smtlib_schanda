                arg2
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg2
                (fp #b0 #b11111111 #b0000000000)))
; arg2 = 340116213421465348979261631549233168384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0110110110)
                expect
                (fp #b1 #b01111110 #b0100100110)))
(assert (fp.leq (fp #b1 #b01111110 #b0100100110)
                expect
                (fp #b0 #b01111010 #b1010111100)))
; expect = -0.6435546875

(assert (= expect result))

(check-sat)
