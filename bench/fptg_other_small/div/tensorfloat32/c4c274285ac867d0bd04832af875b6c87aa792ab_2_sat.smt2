(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100111 #b0111110111)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b11111001 #b0100111111)))
; arg1 = 2048.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011011 #b0101100111)
                arg2
                (fp #b0 #b01111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b10001001 #b1000101111)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001100 #b1001101100)
                expect
                (fp #b0 #b10001001 #b1011001101)))
(assert (fp.leq (fp #b0 #b10001001 #b1011001101)
                expect
                (fp #b0 #b10001011 #b0100101000)))
; expect = 1741.0

(assert (= expect result))

(check-sat)
(exit)
