; Format: TENSORFLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010000 #b0001001000)
                arg1
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b11111010 #b0000011001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010111 #b1001110000)
                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b01010011 #b1001000111)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110001 #b1000011010)
                expect
                (fp #b0 #b01111110 #b1110110101)))
(assert (fp.leq (fp #b0 #b01111110 #b1110110101)
                expect
                (fp #b0 #b10111111 #b0110010111)))
; expect = 0.96337890625

(assert (not (= expect result)))

(check-sat)
(exit)
