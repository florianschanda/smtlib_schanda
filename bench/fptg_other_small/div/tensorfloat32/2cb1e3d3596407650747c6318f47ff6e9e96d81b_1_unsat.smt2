                arg2
                (fp #b0 #b01111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b11010100 #b0000111110)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b0100110110)
                expect
                (fp #b1 #b01111111 #b0000010110)))
(assert (fp.leq (fp #b1 #b01111111 #b0000010110)
                expect
                (fp #b0 #b00010010 #b0101101100)))
; expect = -1.021484375

(assert (not (= expect result)))

(check-sat)
(exit)
