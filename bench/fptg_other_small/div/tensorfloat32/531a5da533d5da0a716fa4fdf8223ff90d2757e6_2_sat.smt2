(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010100 #b0000000011)
                expect
                (fp #b0 #b00111111 #b1111110101)))
(assert (fp.leq (fp #b0 #b00111111 #b1111110101)
                expect
                (fp #b0 #b10010110 #b1100001011)))
; expect = 0.00000000000000000010783788209731311191763580836777691729366779327392578125

(assert (= expect result))

