                arg2
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                arg2
                (fp #b1 #b01010111 #b1010011100)))
; arg2 = -340116213421465348979261631549233168384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110100 #b0100100001)
                expect
                (fp #b0 #b00000000 #b0100110101)))
(assert (fp.leq (fp #b0 #b00000000 #b0100110101)
                expect
                (fp #b0 #b00111100 #b0000010111)))
; expect = 0.0000000000000000000000000000000000000035471460391024105465072225586100968207614029008063969154902761449221770817530341446399688720703125

(assert (= expect result))

(check-sat)
