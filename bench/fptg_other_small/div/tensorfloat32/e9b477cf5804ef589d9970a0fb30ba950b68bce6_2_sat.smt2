;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110000 #b0010000011)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b10110110 #b0000111011)))
