                (fp #b0 #b11001111 #b0110000000)))
; arg1 = 1872.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b0010010001)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10110100 #b1010010001)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001001 #b0110010100)
                expect
                (fp #b0 #b10000001 #b0001000011)))
(assert (fp.leq (fp #b0 #b10000001 #b0001000011)
                expect
                (fp #b0 #b11011010 #b0100110011)))
; expect = 4.26171875

(assert (not (= expect result)))

(check-sat)
(exit)
