(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b11101101 #b0110110101)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000011 #b1001110000)
                expect
                (fp #b1 #b01110110 #b0010101010)))
(assert (fp.leq (fp #b1 #b01110110 #b0010101010)
                expect
                (fp #b1 #b01011001 #b1100100000)))
; expect = -0.002277374267578125

(assert (not (= expect result)))

(check-sat)
(exit)
