(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11101101 #b1011000001)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b11110101 #b1101110100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
