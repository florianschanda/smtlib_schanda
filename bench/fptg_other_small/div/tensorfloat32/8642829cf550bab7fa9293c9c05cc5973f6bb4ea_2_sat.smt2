; Format: TENSORFLOAT32
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b0011011011)
                arg1
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg1
                (fp #b0 #b11111110 #b0101011111)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01001011 #b1010011100)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11110100 #b0100010100)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001100 #b1010010011)
                expect
                (fp #b0 #b11110010 #b1000100010)))
(assert (fp.leq (fp #b0 #b11110010 #b1000100010)
                expect
                (fp #b0 #b11110110 #b0000010110)))
; expect = 63686766155466245131194369038090240.0

(assert (= expect result))

(check-sat)
(exit)
