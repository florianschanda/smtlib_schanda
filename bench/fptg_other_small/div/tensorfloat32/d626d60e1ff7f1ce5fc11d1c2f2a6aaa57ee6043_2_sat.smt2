                arg2
                (fp #b0 #b01111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b10010010 #b1010100011)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001111 #b1001001001)
                expect
                (fp #b0 #b11010101 #b0101100101)))
(assert (fp.leq (fp #b0 #b11010101 #b0101100101)
                expect
                (fp #b0 #b11101000 #b1111001011)))
; expect = 104345409805487680641826816.0

(assert (= expect result))

(check-sat)
(exit)
