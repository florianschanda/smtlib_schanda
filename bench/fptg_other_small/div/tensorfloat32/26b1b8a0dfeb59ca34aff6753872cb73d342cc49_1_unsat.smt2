; Format: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1010111000)
                arg1
                (fp #b1 #b10011100 #b0001111011)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111011)
                arg1
                (fp #b1 #b00101001 #b0101100000)))
; arg1 = -601358336.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101100 #b1001010011)
                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b01001011 #b0010000010)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10001101 #b0011111111)
                expect
                (fp #b0 #b10011011 #b1100101110)))
(assert (fp.leq (fp #b0 #b10011011 #b1100101110)
                expect
                (fp #b0 #b10011011 #b1110111100)))
; expect = 481820672.0

(assert (not (= expect result)))

(check-sat)
(exit)
