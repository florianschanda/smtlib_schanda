                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11100111 #b0001100001)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b1000110000)
                expect
                (fp #b1 #b11110100 #b1000100000)))
(assert (fp.leq (fp #b1 #b11110100 #b1000100000)
                expect
                (fp #b1 #b10101111 #b1011111000)))
; expect = -254422546068206553797994320131784704.0

(assert (not (= expect result)))

(check-sat)
(exit)
