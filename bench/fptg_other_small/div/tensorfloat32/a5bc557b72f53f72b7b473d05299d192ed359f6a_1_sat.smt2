(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001100 #b1110111100)
                expect
                (fp #b0 #b01011001 #b0110111000)))
(assert (fp.leq (fp #b0 #b01011001 #b0110111000)
                expect
                (fp #b0 #b10011011 #b1111000110)))
; expect = 0.000000000005201172825763933360576629638671875

(assert (= expect result))

