; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011010 #b0000010100)
                arg1
                (fp #b0 #b00101101 #b1010110100)))
(assert (fp.leq (fp #b0 #b00101101 #b1010110100)
                arg1
                (fp #b0 #b10011011 #b0000010001)))
; arg1 = 0.000000000000000000000000346543440219969602070150711814466859550520894117653369903564453125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110010 #b1010110010)
                arg2
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg2
                (fp #b0 #b11111111 #b0000000000)))
; arg2 = 340116213421465348979261631549233168384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010110 #b0100111000)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b10010110 #b1001111110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
