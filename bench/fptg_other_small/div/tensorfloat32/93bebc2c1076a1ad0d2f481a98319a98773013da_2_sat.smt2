; Format: TENSORFLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010110 #b0010000101)
                arg1
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg1
                (fp #b0 #b11111111 #b0000000000)))
; arg1 = 340116213421465348979261631549233168384.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000010 #b1100100011)
                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111101 #b1001111101)))
; arg2 = 60812180807159901185349173007825764352.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110111 #b1101000000)
                expect
                (fp #b0 #b10000001 #b0110011000)))
(assert (fp.leq (fp #b0 #b10000001 #b0110011000)
                expect
                (fp #b0 #b11101010 #b1111001110)))
; expect = 5.59375

(assert (= expect result))

(check-sat)
(exit)
