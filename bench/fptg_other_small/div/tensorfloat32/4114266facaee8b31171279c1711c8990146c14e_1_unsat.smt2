(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000001 #b1100110000)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10011011 #b1101001001)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b0101111101)
                expect
                (fp #b1 #b11011101 #b1000011010)))
(assert (fp.leq (fp #b1 #b11011101 #b1000011010)
                expect
                (fp #b1 #b01110010 #b0111111001)))
; expect = -30213474083808812334256750592.0

(assert (not (= expect result)))

(check-sat)
(exit)
