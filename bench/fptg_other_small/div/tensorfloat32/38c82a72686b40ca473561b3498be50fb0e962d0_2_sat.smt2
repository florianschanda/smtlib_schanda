(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b0 #b11010001 #b0011100110)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010111 #b1101100110)
                expect
                (fp #b0 #b10100101 #b1101111000)))
(assert (fp.leq (fp #b0 #b10100101 #b1101111000)
                expect
                (fp #b0 #b11000100 #b0011001111)))
; expect = 513248591872.0

(assert (= expect result))

(check-sat)
