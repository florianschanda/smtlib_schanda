(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111110 #b1110010101)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b11111100 #b1101000101)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b0100111110)
                arg2
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b1 #b01110110 #b0011010110)))
; arg2 = -13052620958651699370655744.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01111001 #b1101100101)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b11110100 #b0101110101)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
