; Format: TENSORFLOAT32
; Arg1: +ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100100 #b1000001001)
                arg1
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b10101011 #b1010111100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110011 #b1011011111)
                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b0 #b00010101 #b0111000100)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110010 #b1100100011)
                expect
                (fp #b1 #b01110110 #b1010001011)))
(assert (fp.leq (fp #b1 #b01110110 #b1010001011)
                expect
                (fp #b0 #b00000110 #b1011001000)))
; expect = -0.0031948089599609375

(assert (not (= expect result)))

(check-sat)
(exit)
