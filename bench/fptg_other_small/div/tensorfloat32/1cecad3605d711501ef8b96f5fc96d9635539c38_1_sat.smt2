(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11011001 #b0010110110)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b1110000011)
                expect
                (fp #b1 #b11011100 #b0000000011)))
(assert (fp.leq (fp #b1 #b11011100 #b0000000011)
                expect
                (fp #b1 #b11000101 #b1010100001)))
; expect = -9932534533953793299385942016.0

(assert (= expect result))

