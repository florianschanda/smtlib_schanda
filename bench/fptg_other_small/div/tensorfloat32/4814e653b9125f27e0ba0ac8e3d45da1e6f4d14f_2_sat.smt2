                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b0 #b00111100 #b1000000001)))
; arg2 = -13052620958651699370655744.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011101 #b0011101100)
                expect
                (fp #b0 #b00110011 #b1000011101)))
(assert (fp.leq (fp #b0 #b00110011 #b1000011101)
                expect
                (fp #b0 #b11111100 #b1111100100)))
; expect = 0.00000000000000000000002022715091633575486208991567327331040360149927437305450439453125

(assert (= expect result))

(check-sat)
