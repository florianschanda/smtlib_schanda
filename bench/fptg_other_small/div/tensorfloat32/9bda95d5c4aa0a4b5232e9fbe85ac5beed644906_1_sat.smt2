;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100110 #b1011001111)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b11100101 #b0011110100)))
