                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11011010 #b1100001010)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001000 #b1101000010)
                expect
                (fp #b0 #b01111111 #b0110011010)))
(assert (fp.leq (fp #b0 #b01111111 #b0110011010)
                expect
                (fp #b0 #b10000001 #b1100001010)))
; expect = 1.400390625

(assert (= expect result))

(check-sat)
(exit)
