                arg2
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                arg2
                (fp #b0 #b10001110 #b1110001001)))
; arg2 = -340116213421465348979261631549233168384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010100 #b0000101101)
                expect
                (fp #b1 #b00000000 #b0101011110)))
(assert (fp.leq (fp #b1 #b00000000 #b0101011110)
                expect
                (fp #b0 #b01100101 #b1001010000)))
; expect = -0.000000000000000000000000000000000000004017802956912115505752517461208847531606767039748346020781866183568808992276899516582489013671875

(assert (= expect result))

(check-sat)
