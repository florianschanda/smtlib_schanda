; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010011 #b0010001001)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b11100101 #b0111110100)))
; arg1 = 1872.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10110100 #b0111000110)
                arg2
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b11101001 #b0011011010)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
