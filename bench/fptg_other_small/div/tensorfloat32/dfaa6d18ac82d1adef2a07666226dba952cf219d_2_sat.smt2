                arg2
                (fp #b0 #b11100011 #b0000110011)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000011 #b1010110001)
                expect
                (fp #b0 #b01000011 #b1110111111)))
(assert (fp.leq (fp #b0 #b01000011 #b1110111111)
                expect
                (fp #b0 #b10111111 #b0001000100)))
; expect = 0.0000000000000000016796663344052775723724835188477300107479095458984375

(assert (= expect result))

(check-sat)
(exit)
