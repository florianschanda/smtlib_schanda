; Format: TENSORFLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001101 #b0001111001)
                arg1
                (fp #b1 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b00110100 #b1000000101)))
; arg1 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0010110111)
                arg2
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b1 #b11001011 #b1010111111)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10000000 #b0111100100)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b01001100 #b0101000001)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
