; Format: TENSORFLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110011 #b0011100110)
                arg1
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b11000110 #b0011001100)))
; arg1 = -0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110000 #b1101101111)
                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b10010011 #b1110101101)))
; arg2 = -0.00000000000000000000000000000000000000638256698298038920342399916694891207878103564028594396444205028018359371344558894634246826171875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010100 #b1110100001)
                expect
                (fp #b0 #b01111111 #b1101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b1101011100)
                expect
                (fp #b0 #b10010011 #b0111010111)))
; expect = 1.83984375

(assert (= expect result))

(check-sat)
(exit)
