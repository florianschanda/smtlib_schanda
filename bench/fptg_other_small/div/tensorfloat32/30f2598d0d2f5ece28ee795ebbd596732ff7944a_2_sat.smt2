                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b0 #b11100010 #b1110101011)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010010 #b0011101111)
                expect
                (fp #b1 #b00110100 #b0011111101)))
(assert (fp.leq (fp #b1 #b00110100 #b0011111101)
                expect
                (fp #b0 #b11010110 #b0000010110)))
; expect = -0.0000000000000000000000330096763196942606503371531179169551251106895506381988525390625

(assert (= expect result))

(check-sat)
