(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11110100 #b0101011011)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010110 #b0110000101)
                expect
                (fp #b0 #b11110100 #b1000100001)))
(assert (fp.leq (fp #b0 #b11110100 #b1000100001)
                expect
                (fp #b0 #b11110111 #b0110101101)))
; expect = 254584805345035767161385898142072832.0

(assert (= expect result))

