(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg2
                (fp #b0 #b11111111 #b0000000000)))
; arg2 = 340116213421465348979261631549233168384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111001 #b1101111110)
                expect
                (fp #b1 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                expect
                (fp #b0 #b10101101 #b0111010000)))
; expect = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(assert (= expect result))

(check-sat)
