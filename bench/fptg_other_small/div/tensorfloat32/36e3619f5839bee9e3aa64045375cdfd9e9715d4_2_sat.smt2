; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111110 #b1011001111)
                arg1
                (fp #b1 #b00000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000 #b1010010101)
                arg1
                (fp #b0 #b00000111 #b1010000111)))
; arg1 = -0.0000000000000000000000000000000000000075879078700540238551497544053115663382630657522104477706766101352542364111286588013172149658203125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010111 #b0001001011)
                arg2
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b01100001 #b1000111111)))
; arg2 = -0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011110 #b0010000110)
                expect
                (fp #b0 #b01111110 #b0100101100)))
(assert (fp.leq (fp #b0 #b01111110 #b0100101100)
                expect
                (fp #b0 #b11101010 #b1000000111)))
; expect = 0.646484375

(assert (= expect result))

(check-sat)
(exit)
