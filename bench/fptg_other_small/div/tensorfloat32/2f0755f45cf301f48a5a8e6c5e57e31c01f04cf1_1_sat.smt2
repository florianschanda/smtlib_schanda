                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b00000101 #b0101010001)))
; arg2 = -18437736874454810624.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101000 #b1000011011)
                expect
                (fp #b1 #b10100011 #b1000010110)))
(assert (fp.leq (fp #b1 #b10100011 #b1000010110)
                expect
                (fp #b0 #b10110101 #b1111000001)))
; expect = -104555610112.0

(assert (= expect result))

(check-sat)
(exit)
