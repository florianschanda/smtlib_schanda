                expect
                (fp #b0 #b01000011 #b1110111110)))
(assert (fp.leq (fp #b0 #b01000011 #b1110111110)
                expect
                (fp #b0 #b10111101 #b0000000110)))
; expect = 0.000000000000000001678819301458023272033415196347050368785858154296875

(assert (not (= expect result)))

(check-sat)
