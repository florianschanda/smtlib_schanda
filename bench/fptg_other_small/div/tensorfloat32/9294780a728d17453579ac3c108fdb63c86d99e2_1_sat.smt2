(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101100 #b1110001010)
                expect
                (fp #b0 #b01001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b01001001 #b1010000111)
                expect
                (fp #b0 #b01001100 #b0010011000)))
; expect = 0.0000000000000000905850915111638954613226815126836299896240234375

(assert (= expect result))

(check-sat)
