; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000011 #b0110000011)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b11101101 #b1010111000)))
; arg1 = -1.203125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101011 #b0011101100)
                arg2
                (fp #b1 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001100)
                arg2
                (fp #b0 #b10001010 #b1101010011)))
; arg2 = -646.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100000 #b1000111001)
                expect
                (fp #b0 #b01110101 #b1110100000)))
(assert (fp.leq (fp #b0 #b01110101 #b1110100000)
                expect
                (fp #b0 #b11101011 #b0010100010)))
; expect = 0.001861572265625

(assert (not (= expect result)))

(check-sat)
(exit)
