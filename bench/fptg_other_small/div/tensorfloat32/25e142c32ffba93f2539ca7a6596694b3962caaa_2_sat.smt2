; Format: TENSORFLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010111 #b1100001001)
                arg1
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                arg1
                (fp #b0 #b11111000 #b1100001101)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010000 #b1010001011)
                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b11110111 #b1100101000)))
; arg2 = -0.00000000000000000000000000000000000000638256698298038920342399916694891207878103564028594396444205028018359371344558894634246826171875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010000 #b1011110110)
                expect
                (fp #b1 #b01111111 #b1101011110)))
(assert (fp.leq (fp #b1 #b01111111 #b1101011110)
                expect
                (fp #b1 #b00101110 #b0101111111)))
; expect = -1.841796875

(assert (= expect result))

(check-sat)
(exit)
