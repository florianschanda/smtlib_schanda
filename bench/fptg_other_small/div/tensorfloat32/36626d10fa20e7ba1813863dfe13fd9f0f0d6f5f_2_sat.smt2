;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011110 #b1100000000)
                arg1
                (fp #b1 #b10011100 #b0001111011)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111011)
                arg1
                (fp #b0 #b10110111 #b1101111000)))
; arg1 = -601358336.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01110111 #b0000000101)
                arg2
                (fp #b0 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b10101010 #b1111010101)))
; arg2 = 307090161664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110001 #b1111110101)
                expect
                (fp #b1 #b01110110 #b0000000011)))
(assert (fp.leq (fp #b1 #b01110110 #b0000000011)
                expect
                (fp #b0 #b00110000 #b1101110010)))
; expect = -0.0019588470458984375

(assert (= expect result))

(check-sat)
(exit)
