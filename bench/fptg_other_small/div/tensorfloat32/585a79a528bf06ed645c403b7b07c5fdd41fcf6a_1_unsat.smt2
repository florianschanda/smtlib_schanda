; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1111100000)
                arg1
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                arg1
                (fp #b0 #b11111000 #b1111001011)))
; arg1 = -218824158806091775576789237298651725824.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11001100 #b0101111011)
                expect
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00110011 #b0011010100)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
