(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b101)
                arg1
                (fp #b1 #b1011 #b111)))
(assert (fp.leq (fp #b1 #b1011 #b111)
                arg1
                (fp #b1 #b0011 #b100)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b000)
                arg2
                (fp #b0 #b0111 #b110)))
(assert (fp.leq (fp #b0 #b0111 #b110)
                arg2
                (fp #b0 #b1100 #b001)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b100)
                expect
                (fp #b1 #b1011 #b001)))
(assert (fp.leq (fp #b1 #b1011 #b001)
                expect
                (fp #b1 #b1010 #b111)))
; expect = -18.0

(assert (= expect result))

(check-sat)
(exit)
