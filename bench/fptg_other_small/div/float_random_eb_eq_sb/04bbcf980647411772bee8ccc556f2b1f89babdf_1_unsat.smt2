(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010100 #b01000)
                arg1
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg1
                (fp #b0 #b101101 #b00111)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b00110)
                arg2
                (fp #b1 #b101111 #b01111)))
(assert (fp.leq (fp #b1 #b101111 #b01111)
                arg2
                (fp #b0 #b001101 #b01000)))
; arg2 = -96256.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b00000)
                expect
                (fp #b1 #b010100 #b01011)))
(assert (fp.leq (fp #b1 #b010100 #b01011)
                expect
                (fp #b1 #b001011 #b00001)))
; expect = -0.0006561279296875

(assert (not (= expect result)))

(check-sat)
(exit)
