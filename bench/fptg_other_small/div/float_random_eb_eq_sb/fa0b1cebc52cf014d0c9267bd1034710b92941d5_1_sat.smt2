(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b01010)
                arg1
                (fp #b1 #b101110 #b11111)))
(assert (fp.leq (fp #b1 #b101110 #b11111)
                arg1
                (fp #b0 #b101001 #b10011)))
; arg1 = -64512.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b11010)
                arg2
                (fp #b1 #b011111 #b01000)))
(assert (fp.leq (fp #b1 #b011111 #b01000)
                arg2
                (fp #b1 #b010000 #b01000)))
; arg2 = -1.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011000 #b01000)
                expect
                (fp #b0 #b101110 #b10010)))
(assert (fp.leq (fp #b0 #b101110 #b10010)
                expect
                (fp #b0 #b110000 #b10011)))
; expect = 51200.0

(assert (= expect result))

(check-sat)
(exit)
