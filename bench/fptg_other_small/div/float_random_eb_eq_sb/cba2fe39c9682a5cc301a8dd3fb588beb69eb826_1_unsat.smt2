                arg2
                (fp #b0 #b0000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000 #b010000)
                arg2
                (fp #b0 #b1011100 #b001011)))
; arg2 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                expect
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                expect
                (fp #b0 #b0111101 #b001111)))
; expect = -18302628885633695744.0

(assert (not (= expect result)))

(check-sat)
(exit)
