(declare-const arg2 (_ FloatingPoint 7 7))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0000011 #b011000)
                expect
                (fp #b0 #b0111111 #b000000)))
(assert (fp.leq (fp #b0 #b0111111 #b000000)
                expect
                (fp #b0 #b1111011 #b010111)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
