(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b1011)
                arg1
                (fp #b1 #b10100 #b0000)))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg1
                (fp #b1 #b00110 #b1110)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1000)
                arg2
                (fp #b1 #b01010 #b1000)))
(assert (fp.leq (fp #b1 #b01010 #b1000)
                arg2
                (fp #b0 #b10000 #b1110)))
; arg2 = -0.046875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1000)
                expect
                (fp #b0 #b11000 #b0101)))
(assert (fp.leq (fp #b0 #b11000 #b0101)
                expect
                (fp #b0 #b11110 #b1011)))
; expect = 672.0

(assert (not (= expect result)))

(check-sat)
(exit)
