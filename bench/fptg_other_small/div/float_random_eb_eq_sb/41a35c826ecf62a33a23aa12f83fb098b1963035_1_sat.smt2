(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0001010 #b111100)
                arg1
                (fp #b0 #b0111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111 #b000100)
                arg1
                (fp #b0 #b1101110 #b110111)))
; arg1 = 1.0625

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100001 #b000001)
                arg2
                (fp #b0 #b0111111 #b111101)))
(assert (fp.leq (fp #b0 #b0111111 #b111101)
                arg2
                (fp #b0 #b1001010 #b001110)))
; arg2 = 1.953125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0011010 #b110000)
                expect
                (fp #b0 #b0111110 #b000101)))
(assert (fp.leq (fp #b0 #b0111110 #b000101)
                expect
                (fp #b0 #b1011101 #b010001)))
; expect = 0.5390625

(assert (= expect result))

(check-sat)
(exit)
