(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011001 #b01111)
                arg1
                (fp #b0 #b000001 #b00000)))
(assert (fp.leq (fp #b0 #b000001 #b00000)
                arg1
                (fp #b0 #b100110 #b10110)))
; arg1 = 0.000000000931322574615478515625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b111000 #b00000)
                arg2
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg2
                (fp #b0 #b111110 #b10011)))
; arg2 = 1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101101 #b01000)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b010101 #b11001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
