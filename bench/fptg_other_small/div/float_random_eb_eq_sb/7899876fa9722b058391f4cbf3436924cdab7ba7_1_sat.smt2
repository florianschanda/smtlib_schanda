                arg2
                (fp #b0 #b111110 #b11000)))
; arg2 = 1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000110 #b10010)
