(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b11000)
                arg1
                (fp #b0 #b011111 #b00111)))
(assert (fp.leq (fp #b0 #b011111 #b00111)
                arg1
                (fp #b0 #b101111 #b01011)))
; arg1 = 1.21875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b00101)
                arg2
                (fp #b1 #b100010 #b11000)))
(assert (fp.leq (fp #b1 #b100010 #b11000)
                arg2
                (fp #b0 #b110010 #b01110)))
; arg2 = -14.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011111 #b00010)
                expect
                (fp #b1 #b011011 #b01100)))
(assert (fp.leq (fp #b1 #b011011 #b01100)
                expect
                (fp #b0 #b100101 #b11100)))
; expect = -0.0859375

(assert (= expect result))

(check-sat)
(exit)
