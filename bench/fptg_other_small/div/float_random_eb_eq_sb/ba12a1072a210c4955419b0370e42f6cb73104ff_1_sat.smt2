(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100000 #b00011)
                arg1
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                arg1
                (fp #b0 #b101011 #b00000)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10000)
                arg2
                (fp #b1 #b011111 #b00110)))
(assert (fp.leq (fp #b1 #b011111 #b00110)
                arg2
                (fp #b1 #b000010 #b00101)))
; arg2 = -1.1875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b00111)
                expect
                (fp #b0 #b011110 #b10101)))
(assert (fp.leq (fp #b0 #b011110 #b10101)
                expect
                (fp #b0 #b110101 #b11011)))
; expect = 0.828125

(assert (= expect result))

(check-sat)
(exit)
