(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b0011)
                arg1
                (fp #b1 #b10010 #b1001)))
(assert (fp.leq (fp #b1 #b10010 #b1001)
                arg1
                (fp #b0 #b11001 #b0011)))
; arg1 = -12.5

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11010 #b1100)
                expect
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                expect
                (fp #b0 #b10010 #b0111)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
