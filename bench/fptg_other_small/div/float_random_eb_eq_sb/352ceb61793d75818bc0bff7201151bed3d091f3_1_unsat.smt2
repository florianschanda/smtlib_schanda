(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b11)))
(assert (fp.leq (fp #b0 #b110 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 14.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b11)
                arg2
                (fp #b1 #b011 #b00)))
(assert (fp.leq (fp #b1 #b011 #b00)
                arg2
                (fp #b0 #b011 #b00)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                expect
                (fp #b1 #b110 #b11)))
(assert (fp.leq (fp #b1 #b110 #b11)
                expect
                (fp #b0 #b100 #b11)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
(exit)
