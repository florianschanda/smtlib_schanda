(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b010010)
                arg1
                (fp #b1 #b1111101 #b101100)))
(assert (fp.leq (fp #b1 #b1111101 #b101100)
                arg1
                (fp #b0 #b0101101 #b100101)))
; arg1 = -7782220156096217088.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101111 #b100001)
                arg2
                (fp #b0 #b0111111 #b111101)))
(assert (fp.leq (fp #b0 #b0111111 #b111101)
                arg2
                (fp #b0 #b1111001 #b001001)))
; arg2 = 1.953125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b000001)
                expect
                (fp #b1 #b1111100 #b101111)))
(assert (fp.leq (fp #b1 #b1111100 #b101111)
                expect
                (fp #b0 #b0000001 #b001010)))
; expect = -3999196469105000448.0

(assert (= expect result))

(check-sat)
(exit)
