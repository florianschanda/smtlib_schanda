(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01001 #b0001)
                arg1
                (fp #b0 #b10011 #b0110)))
(assert (fp.leq (fp #b0 #b10011 #b0110)
                arg1
                (fp #b0 #b11101 #b0010)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01100 #b0001)
                arg2
                (fp #b0 #b01111 #b1101)))
(assert (fp.leq (fp #b0 #b01111 #b1101)
                arg2
                (fp #b0 #b11100 #b0011)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0110)
                expect
                (fp #b0 #b10010 #b1000)))
(assert (fp.leq (fp #b0 #b10010 #b1000)
                expect
                (fp #b0 #b11110 #b0110)))
; expect = 12.0

(assert (= expect result))

(check-sat)
(exit)
