(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b1110)
                arg1
                (fp #b1 #b10010 #b1110)))
(assert (fp.leq (fp #b1 #b10010 #b1110)
                arg1
                (fp #b1 #b00100 #b1101)))
; arg1 = -15.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01000 #b1111)
                arg2
                (fp #b0 #b11001 #b1101)))
(assert (fp.leq (fp #b0 #b11001 #b1101)
                arg2
                (fp #b0 #b11011 #b0001)))
; arg2 = 1856.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1101)
                expect
                (fp #b1 #b01000 #b0001)))
(assert (fp.leq (fp #b1 #b01000 #b0001)
                expect
                (fp #b0 #b01111 #b0001)))
; expect = -0.00830078125

(assert (not (= expect result)))

(check-sat)
(exit)
