; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111010 #b110001)
                arg1
                (fp #b1 #b1101101 #b011111)))
(assert (fp.leq (fp #b1 #b1101101 #b011111)
                arg1
                (fp #b1 #b1011011 #b110100)))
; arg1 = -104453604638720.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0000100 #b001101)
                arg2
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                arg2
                (fp #b0 #b1101010 #b010101)))
; arg2 = 4261412864.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110101 #b000111)
                expect
                (fp #b1 #b1001101 #b100000)))
(assert (fp.leq (fp #b1 #b1001101 #b100000)
                expect
                (fp #b1 #b0000101 #b010100)))
; expect = -24576.0

(assert (not (= expect result)))

(check-sat)
(exit)
