                (fp #b0 #b101001 #b01011)))
(assert (fp.leq (fp #b0 #b101001 #b01011)
                arg2
                (fp #b0 #b110100 #b00111)))
; arg2 = 1376.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b00111)
                expect
                (fp #b1 #b110100 #b00011)))
(assert (fp.leq (fp #b1 #b110100 #b00011)
                expect
                (fp #b0 #b001001 #b00000)))
; expect = -2293760.0

(assert (not (= expect result)))

