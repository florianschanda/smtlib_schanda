                arg2
                (fp #b0 #b101110 #b00011)))
; arg2 = -1984.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b10001)
                expect
                (fp #b0 #b000010 #b01110)))
(assert (fp.leq (fp #b0 #b000010 #b01110)
                expect
                (fp #b0 #b010001 #b11111)))
; expect = 0.000000002677552402019500732421875

(assert (= expect result))

