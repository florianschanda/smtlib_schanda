;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100110 #b11010)
                arg1
                (fp #b0 #b101010 #b11011)))
(assert (fp.leq (fp #b0 #b101010 #b11011)
                arg1
