                arg2
                (fp #b1 #b001101 #b01101)))
(assert (fp.leq (fp #b1 #b001101 #b01101)
                arg2
                (fp #b0 #b000011 #b10111)))
; arg2 = -0.00000536441802978515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01110)
                expect
                (fp #b1 #b111100 #b01001)))
(assert (fp.leq (fp #b1 #b111100 #b01001)
                expect
                (fp #b1 #b100001 #b11010)))
; expect = -687865856.0

(assert (not (= expect result)))

(check-sat)
(exit)
