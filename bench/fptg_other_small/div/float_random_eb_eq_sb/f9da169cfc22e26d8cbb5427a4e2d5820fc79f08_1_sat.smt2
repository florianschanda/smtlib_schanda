                arg2
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg2
                (fp #b0 #b1010110 #b101000)))
; arg2 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b111010)
                expect
                (fp #b1 #b0111110 #b011101)))
(assert (fp.leq (fp #b1 #b0111110 #b011101)
                expect
                (fp #b0 #b0110110 #b011001)))
; expect = -0.7265625

(assert (= expect result))

(check-sat)
(exit)
