(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b11001)
                arg1
                (fp #b0 #b010000 #b00000)))
(assert (fp.leq (fp #b0 #b010000 #b00000)
                arg1
                (fp #b0 #b100000 #b00101)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001100 #b11101)
                arg2
                (fp #b0 #b100011 #b00110)))
(assert (fp.leq (fp #b0 #b100011 #b00110)
                arg2
                (fp #b0 #b101111 #b00001)))
; arg2 = 19.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b01101)
                expect
                (fp #b0 #b001011 #b10110)))
(assert (fp.leq (fp #b0 #b001011 #b10110)
                expect
                (fp #b0 #b111011 #b11001)))
; expect = 0.000001609325408935546875

(assert (= expect result))

(check-sat)
(exit)
