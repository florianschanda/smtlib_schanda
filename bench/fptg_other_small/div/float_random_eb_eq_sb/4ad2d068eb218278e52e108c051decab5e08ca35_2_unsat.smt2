(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1111)
                arg1
                (fp #b0 #b10110 #b1111)))
(assert (fp.leq (fp #b0 #b10110 #b1111)
                arg1
                (fp #b0 #b11011 #b0111)))
; arg1 = 248.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1101)
                arg2
                (fp #b1 #b10110 #b0100)))
(assert (fp.leq (fp #b1 #b10110 #b0100)
                arg2
                (fp #b0 #b00000 #b1011)))
; arg2 = -160.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1100)
                expect
                (fp #b1 #b01111 #b1001)))
(assert (fp.leq (fp #b1 #b01111 #b1001)
                expect
                (fp #b0 #b10011 #b0010)))
; expect = -1.5625

(assert (not (= expect result)))

(check-sat)
(exit)
