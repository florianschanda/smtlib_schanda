(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b1011)
                arg1
                (fp #b1 #b00110 #b0000)))
(assert (fp.leq (fp #b1 #b00110 #b0000)
                arg1
                (fp #b0 #b00111 #b1111)))
; arg1 = -0.001953125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b1101)
                arg2
                (fp #b1 #b00000 #b0111)))
(assert (fp.leq (fp #b1 #b00000 #b0111)
                arg2
                (fp #b0 #b11000 #b0010)))
; arg2 = -0.000026702880859375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10000 #b0101)
                expect
                (fp #b0 #b10101 #b0011)))
(assert (fp.leq (fp #b0 #b10101 #b0011)
                expect
                (fp #b0 #b11110 #b1000)))
; expect = 76.0

(assert (not (= expect result)))

(check-sat)
(exit)
