(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b011 #b10)
                arg1
                (fp #b1 #b011 #b00)))
(assert (fp.leq (fp #b1 #b011 #b00)
                arg1
                (fp #b1 #b001 #b11)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b000 #b00)))
(assert (fp.leq (fp #b0 #b000 #b00)
                expect
                (fp #b0 #b000 #b10)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
