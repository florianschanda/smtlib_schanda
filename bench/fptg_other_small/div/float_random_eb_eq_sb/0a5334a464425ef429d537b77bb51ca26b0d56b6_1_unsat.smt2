(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b01011)
                arg1
                (fp #b1 #b100100 #b10101)))
(assert (fp.leq (fp #b1 #b100100 #b10101)
                arg1
                (fp #b0 #b111100 #b11110)))
; arg1 = -53.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000010 #b01001)
                arg2
                (fp #b0 #b101010 #b10000)))
(assert (fp.leq (fp #b0 #b101010 #b10000)
                arg2
                (fp #b0 #b110000 #b00100)))
; arg2 = 3072.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b11111)
                expect
                (fp #b1 #b011001 #b00011)))
(assert (fp.leq (fp #b1 #b011001 #b00011)
                expect
                (fp #b0 #b011101 #b00100)))
; expect = -0.01708984375

(assert (not (= expect result)))

(check-sat)
(exit)
