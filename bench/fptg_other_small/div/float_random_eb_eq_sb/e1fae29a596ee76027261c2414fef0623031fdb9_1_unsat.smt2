(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b011)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b0101 #b001)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b101)
                arg2
                (fp #b0 #b1110 #b101)))
(assert (fp.leq (fp #b0 #b1110 #b101)
                arg2
                (fp #b0 #b1111 #b000)))
; arg2 = 208.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110 #b001)
                expect
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                expect
                (fp #b0 #b0001 #b111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
