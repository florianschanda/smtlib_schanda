(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b01101)
                arg1
                (fp #b1 #b110110 #b01010)))
(assert (fp.leq (fp #b1 #b110110 #b01010)
                arg1
                (fp #b1 #b101101 #b00101)))
; arg1 = -11010048.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b11110)
                arg2
                (fp #b1 #b101110 #b11111)))
(assert (fp.leq (fp #b1 #b101110 #b11111)
                arg2
                (fp #b0 #b110001 #b00100)))
; arg2 = -64512.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10000)
                expect
                (fp #b0 #b100110 #b01011)))
(assert (fp.leq (fp #b0 #b100110 #b01011)
                expect
                (fp #b0 #b110011 #b01101)))
; expect = 172.0

(assert (not (= expect result)))

(check-sat)
(exit)
