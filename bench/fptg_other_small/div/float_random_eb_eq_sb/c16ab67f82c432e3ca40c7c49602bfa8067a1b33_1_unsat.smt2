(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00001 #b0000)
                arg1
                (fp #b0 #b01111 #b0110)))
(assert (fp.leq (fp #b0 #b01111 #b0110)
                arg1
                (fp #b0 #b11101 #b0010)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b1101)
                arg2
                (fp #b1 #b10110 #b1111)))
(assert (fp.leq (fp #b1 #b10110 #b1111)
                arg2
                (fp #b1 #b10001 #b0001)))
; arg2 = -248.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b1111)
                expect
                (fp #b1 #b00111 #b0110)))
(assert (fp.leq (fp #b1 #b00111 #b0110)
                expect
                (fp #b0 #b00011 #b0111)))
; expect = -0.00537109375

(assert (not (= expect result)))

(check-sat)
(exit)
