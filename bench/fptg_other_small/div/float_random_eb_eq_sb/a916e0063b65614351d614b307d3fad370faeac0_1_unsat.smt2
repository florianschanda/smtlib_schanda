(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b010)
                arg1
                (fp #b1 #b1011 #b111)))
(assert (fp.leq (fp #b1 #b1011 #b111)
                arg1
                (fp #b0 #b1001 #b001)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b111)
                arg2
                (fp #b1 #b1101 #b000)))
(assert (fp.leq (fp #b1 #b1101 #b000)
                arg2
                (fp #b1 #b0100 #b010)))
; arg2 = -64.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b100)
                expect
                (fp #b0 #b0101 #b111)))
(assert (fp.leq (fp #b0 #b0101 #b111)
                expect
                (fp #b0 #b1011 #b101)))
; expect = 0.46875

(assert (not (= expect result)))

(check-sat)
(exit)
