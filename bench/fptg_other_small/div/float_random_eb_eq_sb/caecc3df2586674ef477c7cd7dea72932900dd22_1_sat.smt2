(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101010 #b11100)
                arg1
                (fp #b1 #b011111 #b10100)))
(assert (fp.leq (fp #b1 #b011111 #b10100)
                arg1
                (fp #b0 #b010010 #b11101)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b11011)
                arg2
                (fp #b1 #b011111 #b01000)))
(assert (fp.leq (fp #b1 #b011111 #b01000)
                arg2
                (fp #b0 #b110110 #b01111)))
; arg2 = -1.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b01011)
                expect
                (fp #b0 #b011111 #b01001)))
(assert (fp.leq (fp #b0 #b011111 #b01001)
                expect
                (fp #b0 #b110001 #b10111)))
; expect = 1.28125

(assert (= expect result))

(check-sat)
(exit)
