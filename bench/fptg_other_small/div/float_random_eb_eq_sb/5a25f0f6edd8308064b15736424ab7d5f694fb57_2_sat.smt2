(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b000)
                arg1
                (fp #b1 #b0000 #b110)))
(assert (fp.leq (fp #b1 #b0000 #b110)
                arg1
                (fp #b0 #b1100 #b110)))
; arg1 = -0.01171875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b011)
                arg2
                (fp #b1 #b0101 #b001)))
(assert (fp.leq (fp #b1 #b0101 #b001)
                arg2
                (fp #b1 #b0010 #b101)))
; arg2 = -0.28125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0000 #b101)
                expect
                (fp #b0 #b0010 #b011)))
(assert (fp.leq (fp #b0 #b0010 #b011)
                expect
                (fp #b0 #b1100 #b000)))
; expect = 0.04296875

(assert (= expect result))

(check-sat)
(exit)
