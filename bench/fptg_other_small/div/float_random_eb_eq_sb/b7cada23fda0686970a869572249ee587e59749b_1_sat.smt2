(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b0001)
                arg1
                (fp #b1 #b00000 #b1000)))
(assert (fp.leq (fp #b1 #b00000 #b1000)
                arg1
                (fp #b0 #b01100 #b0100)))
; arg1 = -0.000030517578125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0100)
                arg2
                (fp #b1 #b10001 #b0011)))
(assert (fp.leq (fp #b1 #b10001 #b0011)
                arg2
                (fp #b1 #b00010 #b0000)))
; arg2 = -4.75

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1010)
                expect
                (fp #b0 #b00000 #b0001)))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                expect
                (fp #b0 #b11101 #b1111)))
; expect = 0.000003814697265625

(assert (= expect result))

(check-sat)
(exit)
