;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000111 #b01111)
                arg1
                (fp #b0 #b000000 #b11111)))
(assert (fp.leq (fp #b0 #b000000 #b11111)
                arg1
                (fp #b0 #b101111 #b00110)))
; arg1 = 0.00000000090221874415874481201171875

