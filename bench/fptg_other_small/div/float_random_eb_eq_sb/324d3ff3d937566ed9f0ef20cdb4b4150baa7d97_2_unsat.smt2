                arg2
                (fp #b0 #b000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000 #b10101)
                arg2
                (fp #b0 #b101111 #b11001)))
; arg2 = 0.00000000061118043959140777587890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101001 #b00111)
                expect
                (fp #b0 #b011111 #b10000)))
(assert (fp.leq (fp #b0 #b011111 #b10000)
                expect
                (fp #b0 #b100110 #b10000)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
