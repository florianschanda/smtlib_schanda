(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0111)
                arg1
                (fp #b1 #b10110 #b1111)))
(assert (fp.leq (fp #b1 #b10110 #b1111)
                arg1
                (fp #b1 #b10100 #b0110)))
; arg1 = -248.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0100)
                arg2
                (fp #b1 #b00001 #b0000)))
(assert (fp.leq (fp #b1 #b00001 #b0000)
                arg2
                (fp #b0 #b00111 #b0001)))
; arg2 = -0.00006103515625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b0100)
                expect
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                expect
                (fp #b0 #b11111 #b0000)))
; expect = 63488.0

(assert (= expect result))

(check-sat)
(exit)
