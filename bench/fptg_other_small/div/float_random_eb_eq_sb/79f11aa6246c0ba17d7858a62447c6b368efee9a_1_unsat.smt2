(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b101)
                arg1
                (fp #b1 #b0111 #b000)))
(assert (fp.leq (fp #b1 #b0111 #b000)
                arg1
                (fp #b0 #b0010 #b110)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b001)
                arg2
                (fp #b1 #b1010 #b111)))
(assert (fp.leq (fp #b1 #b1010 #b111)
                arg2
                (fp #b1 #b0000 #b000)))
; arg2 = -15.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b010)
                expect
                (fp #b0 #b0011 #b000)))
(assert (fp.leq (fp #b0 #b0011 #b000)
                expect
                (fp #b0 #b1101 #b111)))
; expect = 0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
