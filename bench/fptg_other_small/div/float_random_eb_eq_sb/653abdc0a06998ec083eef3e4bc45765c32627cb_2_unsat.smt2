(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                arg1
                (fp #b0 #b1001 #b111)))
; arg1 = 0.001953125

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b001)
                arg2
                (fp #b0 #b0000 #b111)))
(assert (fp.leq (fp #b0 #b0000 #b111)
                arg2
                (fp #b0 #b0010 #b001)))
; arg2 = 0.013671875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b110)
                expect
                (fp #b0 #b0100 #b010)))
(assert (fp.leq (fp #b0 #b0100 #b010)
                expect
                (fp #b0 #b0110 #b000)))
; expect = 0.15625

(assert (not (= expect result)))

(check-sat)
(exit)
