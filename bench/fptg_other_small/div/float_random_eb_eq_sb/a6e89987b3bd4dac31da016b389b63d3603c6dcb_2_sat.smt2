(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000011 #b11101)
                arg1
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                arg1
                (fp #b0 #b110010 #b01001)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b01100)
                arg2
                (fp #b1 #b010111 #b01100)))
(assert (fp.leq (fp #b1 #b010111 #b01100)
                arg2
                (fp #b0 #b111100 #b10111)))
; arg2 = -0.00537109375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b11001)
                expect
                (fp #b1 #b100110 #b01111)))
(assert (fp.leq (fp #b1 #b100110 #b01111)
                expect
                (fp #b0 #b001010 #b10000)))
; expect = -188.0

(assert (= expect result))

(check-sat)
(exit)
