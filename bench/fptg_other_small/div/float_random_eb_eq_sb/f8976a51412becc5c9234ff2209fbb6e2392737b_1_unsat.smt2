(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b010)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b1010 #b001)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b110)
                arg2
                (fp #b1 #b0001 #b000)))
(assert (fp.leq (fp #b1 #b0001 #b000)
                arg2
                (fp #b0 #b1110 #b111)))
; arg2 = -0.015625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b101)
                expect
                (fp #b1 #b0101 #b000)))
(assert (fp.leq (fp #b1 #b0101 #b000)
                expect
                (fp #b0 #b1001 #b011)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
