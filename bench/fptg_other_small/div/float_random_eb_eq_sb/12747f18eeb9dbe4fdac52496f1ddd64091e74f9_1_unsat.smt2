; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00010 #b0011)
                arg1
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                arg1
                (fp #b0 #b11101 #b1111)))
; arg1 = -0.000003814697265625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b0000)
                arg2
                (fp #b1 #b01111 #b0110)))
(assert (fp.leq (fp #b1 #b01111 #b0110)
                arg2
                (fp #b0 #b00001 #b0011)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010 #b1100)
                expect
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                expect
                (fp #b0 #b10100 #b1110)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
