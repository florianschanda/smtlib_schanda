; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011010 #b010101)
                arg1
                (fp #b0 #b0000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000 #b000001)
                arg1
                (fp #b0 #b0101101 #b100100)))
; arg1 = 0.00000000000000000000338813178901720135627329000271856784820556640625

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101010 #b101010)
                arg2
                (fp #b0 #b1111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111101 #b000000)
                arg2
                (fp #b0 #b1111110 #b110101)))
; arg2 = 4611686018427387904.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111011 #b010100)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b0010110 #b000000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
