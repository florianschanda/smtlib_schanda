(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b111)
                arg1
                (fp #b1 #b0010 #b011)))
(assert (fp.leq (fp #b1 #b0010 #b011)
                arg1
                (fp #b0 #b0011 #b001)))
; arg1 = -0.04296875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg2
                (fp #b1 #b0111 #b001)))
(assert (fp.leq (fp #b1 #b0111 #b001)
                arg2
                (fp #b1 #b0100 #b010)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                expect
                (fp #b0 #b0010 #b010)))
(assert (fp.leq (fp #b0 #b0010 #b010)
                expect
                (fp #b0 #b1110 #b111)))
; expect = 0.0390625

(assert (not (= expect result)))

(check-sat)
(exit)
