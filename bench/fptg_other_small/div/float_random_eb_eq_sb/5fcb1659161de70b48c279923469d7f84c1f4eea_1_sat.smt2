(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b001)
                arg1
                (fp #b1 #b0000 #b110)))
(assert (fp.leq (fp #b1 #b0000 #b110)
                arg1
                (fp #b0 #b0100 #b010)))
; arg1 = -0.01171875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0000 #b100)
                arg2
                (fp #b0 #b0010 #b011)))
(assert (fp.leq (fp #b0 #b0010 #b011)
                arg2
                (fp #b0 #b1011 #b100)))
; arg2 = 0.04296875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b101)
                expect
                (fp #b1 #b0101 #b000)))
(assert (fp.leq (fp #b1 #b0101 #b000)
                expect
                (fp #b0 #b1001 #b011)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
