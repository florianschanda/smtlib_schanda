                (fp #b1 #b1111101 #b010111)))
(assert (fp.leq (fp #b1 #b1111101 #b010111)
                arg2
                (fp #b0 #b1110000 #b100110)))
; arg2 = -6269010681299730432.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011110 #b110101)
                expect
                (fp #b0 #b0000111 #b000100)))
(assert (fp.leq (fp #b0 #b0000111 #b000100)
                expect
                (fp #b0 #b1110101 #b010010)))
; expect = 0.000000000000000014745149545802860302501358091831207275390625

(assert (= expect result))

(check-sat)
