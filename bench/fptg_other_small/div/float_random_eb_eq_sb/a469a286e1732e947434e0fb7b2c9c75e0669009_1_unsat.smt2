(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1101)
                arg1
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg1
                (fp #b0 #b11101 #b1001)))
; arg1 = -16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0000)
                arg2
                (fp #b1 #b00000 #b0100)))
(assert (fp.leq (fp #b1 #b00000 #b0100)
                arg2
                (fp #b0 #b11110 #b0001)))
; arg2 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b11010 #b1000)
                expect
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                expect
                (fp #b0 #b11111 #b0000)))
; expect = 63488.0

(assert (not (= expect result)))

(check-sat)
(exit)
