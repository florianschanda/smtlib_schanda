(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00010 #b1101)
                arg1
                (fp #b0 #b01111 #b0100)))
(assert (fp.leq (fp #b0 #b01111 #b0100)
                arg1
                (fp #b0 #b11010 #b1101)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b0010)
                arg2
                (fp #b1 #b10011 #b1110)))
(assert (fp.leq (fp #b1 #b10011 #b1110)
                arg2
                (fp #b0 #b11010 #b1011)))
; arg2 = -30.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b0101)
                expect
                (fp #b1 #b01010 #b0101)))
(assert (fp.leq (fp #b1 #b01010 #b0101)
                expect
                (fp #b0 #b01100 #b1101)))
; expect = -0.041015625

(assert (not (= expect result)))

(check-sat)
(exit)
