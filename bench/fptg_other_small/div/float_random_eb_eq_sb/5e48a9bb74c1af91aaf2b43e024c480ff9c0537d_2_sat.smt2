(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b00111)
                arg1
                (fp #b1 #b011111 #b10100)))
(assert (fp.leq (fp #b1 #b011111 #b10100)
                arg1
                (fp #b0 #b111100 #b00100)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011011 #b11100)
                arg2
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                arg2
                (fp #b0 #b100011 #b10111)))
; arg2 = 0.375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b00000)
                expect
                (fp #b1 #b100001 #b00011)))
(assert (fp.leq (fp #b1 #b100001 #b00011)
                expect
                (fp #b0 #b110101 #b01001)))
; expect = -4.375

(assert (= expect result))

(check-sat)
(exit)
