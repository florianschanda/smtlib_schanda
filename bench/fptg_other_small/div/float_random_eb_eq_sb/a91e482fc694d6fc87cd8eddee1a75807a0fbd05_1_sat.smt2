(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b1111)
                arg1
                (fp #b0 #b10010 #b0000)))
(assert (fp.leq (fp #b0 #b10010 #b0000)
                arg1
                (fp #b0 #b11001 #b0010)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b1001)
                arg2
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                arg2
                (fp #b0 #b11000 #b0101)))
; arg2 = 32.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1110)
                expect
                (fp #b0 #b01101 #b0000)))
(assert (fp.leq (fp #b0 #b01101 #b0000)
                expect
                (fp #b0 #b10110 #b1100)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
