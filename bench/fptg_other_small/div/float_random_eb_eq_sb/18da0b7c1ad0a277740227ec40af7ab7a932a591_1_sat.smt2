(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111100 #b000010)
                arg1
                (fp #b1 #b0111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111 #b000000)
                arg1
                (fp #b1 #b0010101 #b001100)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101000 #b110001)
                arg2
                (fp #b1 #b0111111 #b100001)))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg2
                (fp #b0 #b1111100 #b000000)))
; arg2 = -1.515625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0110010 #b011111)
                expect
                (fp #b0 #b0111110 #b010100)))
(assert (fp.leq (fp #b0 #b0111110 #b010100)
                expect
                (fp #b0 #b1001001 #b111111)))
; expect = 0.65625

(assert (= expect result))

(check-sat)
(exit)
