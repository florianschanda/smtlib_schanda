(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10100 #b0010)
                arg1
                (fp #b1 #b01001 #b0001)))
(assert (fp.leq (fp #b1 #b01001 #b0001)
                arg1
                (fp #b0 #b01101 #b0101)))
; arg1 = -0.0166015625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11111 #b0000)
                arg2
                (fp #b1 #b11110 #b0011)))
(assert (fp.leq (fp #b1 #b11110 #b0011)
                arg2
                (fp #b0 #b10111 #b0001)))
; arg2 = -38912.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01110 #b1110)
                expect
                (fp #b0 #b00000 #b0001)))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                expect
                (fp #b0 #b01101 #b1000)))
; expect = 0.000003814697265625

(assert (not (= expect result)))

(check-sat)
(exit)
