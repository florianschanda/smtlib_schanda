                arg1
                (fp #b0 #b110101 #b10110)))
; arg1 = -0.00000000020372681319713592529296875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b01010)
                expect
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                expect
                (fp #b0 #b001011 #b11010)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
