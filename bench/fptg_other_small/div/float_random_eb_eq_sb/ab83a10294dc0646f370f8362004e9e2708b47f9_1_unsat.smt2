(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01111 #b0100)
                arg1
                (fp #b1 #b00000 #b1111)))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                arg1
                (fp #b0 #b11110 #b1001)))
; arg1 = -0.000057220458984375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1000)
                arg2
                (fp #b1 #b11110 #b0011)))
(assert (fp.leq (fp #b1 #b11110 #b0011)
                arg2
                (fp #b0 #b01011 #b0100)))
; arg2 = -38912.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11011 #b1010)
                expect
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                expect
                (fp #b0 #b00000 #b0100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
