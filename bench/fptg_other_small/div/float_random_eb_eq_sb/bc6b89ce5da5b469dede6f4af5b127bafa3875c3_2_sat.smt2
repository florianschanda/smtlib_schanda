(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0001)
                arg1
                (fp #b1 #b01000 #b0000)))
(assert (fp.leq (fp #b1 #b01000 #b0000)
                arg1
                (fp #b0 #b10111 #b0000)))
; arg1 = -0.0078125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b1011)
                arg2
                (fp #b1 #b10011 #b1110)))
(assert (fp.leq (fp #b1 #b10011 #b1110)
                arg2
                (fp #b1 #b00011 #b0100)))
; arg2 = -30.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                expect
                (fp #b0 #b00011 #b0010)))
(assert (fp.leq (fp #b0 #b00011 #b0010)
                expect
                (fp #b0 #b01101 #b1001)))
; expect = 0.000274658203125

(assert (= expect result))

(check-sat)
(exit)
