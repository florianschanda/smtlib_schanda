; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1000)
                arg1
                (fp #b0 #b00111 #b0100)))
(assert (fp.leq (fp #b0 #b00111 #b0100)
                arg1
                (fp #b0 #b10111 #b0010)))
; arg1 = 0.0048828125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1101)
                arg2
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg2
                (fp #b0 #b11110 #b0000)))
; arg2 = -16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1011)
                expect
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                expect
                (fp #b0 #b00101 #b0111)))
; expect = -0.000003814697265625

(assert (not (= expect result)))

(check-sat)
(exit)
