                (fp #b1 #b1101010 #b001101)))
(assert (fp.leq (fp #b1 #b1101010 #b001101)
                arg2
                (fp #b0 #b0111100 #b110111)))
; arg2 = -10582799417344.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110100 #b001111)
                expect
                (fp #b0 #b0011010 #b001101)))
(assert (fp.leq (fp #b0 #b0011010 #b001101)
                expect
                (fp #b0 #b1010011 #b011001)))
; expect = 0.0000000000087538865045644342899322509765625

(assert (= expect result))

(check-sat)
(exit)
