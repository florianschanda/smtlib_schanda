(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0011 #b001)
                arg1
                (fp #b0 #b1110 #b111)))
(assert (fp.leq (fp #b0 #b1110 #b111)
                arg1
                (fp #b0 #b1111 #b000)))
; arg1 = 240.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0110 #b101)
                arg2
                (fp #b0 #b1110 #b101)))
(assert (fp.leq (fp #b0 #b1110 #b101)
                arg2
                (fp #b0 #b1110 #b111)))
; arg2 = 208.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b001)
                expect
                (fp #b0 #b0111 #b010)))
(assert (fp.leq (fp #b0 #b0111 #b010)
                expect
                (fp #b0 #b1011 #b010)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
