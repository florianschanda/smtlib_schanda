; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0010)
                arg1
                (fp #b0 #b11100 #b1111)))
(assert (fp.leq (fp #b0 #b11100 #b1111)
                arg1
                (fp #b0 #b11110 #b1111)))
; arg1 = 15872.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b0010)
                arg2
                (fp #b0 #b11010 #b0111)))
(assert (fp.leq (fp #b0 #b11010 #b0111)
                arg2
                (fp #b0 #b11101 #b1010)))
; arg2 = 2944.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00001 #b0111)
                expect
                (fp #b0 #b10001 #b0101)))
(assert (fp.leq (fp #b0 #b10001 #b0101)
                expect
                (fp #b0 #b10010 #b1001)))
; expect = 5.25

(assert (not (= expect result)))

(check-sat)
(exit)
