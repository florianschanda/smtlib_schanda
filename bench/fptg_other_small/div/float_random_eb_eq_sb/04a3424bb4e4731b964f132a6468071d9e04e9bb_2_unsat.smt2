(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100010 #b011011)
                arg1
                (fp #b1 #b0111111 #b101110)))
(assert (fp.leq (fp #b1 #b0111111 #b101110)
                arg1
                (fp #b0 #b1100110 #b101000)))
; arg1 = -1.71875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000110 #b101010)
                arg2
                (fp #b1 #b1000000 #b100000)))
(assert (fp.leq (fp #b1 #b1000000 #b100000)
                arg2
                (fp #b1 #b0110111 #b000101)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010010 #b000001)
                expect
                (fp #b0 #b0111110 #b001010)))
(assert (fp.leq (fp #b0 #b0111110 #b001010)
                expect
                (fp #b0 #b1101101 #b010000)))
; expect = 0.578125

(assert (not (= expect result)))

(check-sat)
(exit)
