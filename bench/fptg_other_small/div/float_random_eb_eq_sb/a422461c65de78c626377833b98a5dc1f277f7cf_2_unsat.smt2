                arg2
                (fp #b1 #b0000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000 #b010000)
                arg2
                (fp #b0 #b1001010 #b001000)))
; arg2 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
