                (fp #b1 #b0101000 #b111001)))
(assert (fp.leq (fp #b1 #b0101000 #b111001)
                arg2
                (fp #b0 #b0010011 #b100001)))
; arg2 = -0.00000022538006305694580078125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000000 #b010111)
                expect
                (fp #b0 #b1011100 #b000011)))
(assert (fp.leq (fp #b0 #b1011100 #b000011)
                expect
                (fp #b0 #b1100110 #b000110)))
; expect = 562036736.0

(assert (not (= expect result)))

