(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b1110)
                arg1
                (fp #b1 #b01000 #b0000)))
(assert (fp.leq (fp #b1 #b01000 #b0000)
                arg1
                (fp #b0 #b00010 #b0101)))
; arg1 = -0.0078125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01001 #b1010)
                arg2
                (fp #b0 #b11010 #b0111)))
(assert (fp.leq (fp #b0 #b11010 #b0111)
                arg2
                (fp #b0 #b11011 #b1000)))
; arg2 = 2944.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00010 #b1010)
                expect
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                expect
                (fp #b0 #b10101 #b0101)))
; expect = -0.000003814697265625

(assert (= expect result))

(check-sat)
(exit)
