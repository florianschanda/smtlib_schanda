; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01111 #b1010)
                arg1
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                arg1
                (fp #b0 #b11100 #b1001)))
; arg1 = 5120.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01100 #b0100)
                arg2
                (fp #b0 #b11010 #b0111)))
(assert (fp.leq (fp #b0 #b11010 #b0111)
                arg2
                (fp #b0 #b11011 #b1001)))
; arg2 = 2944.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b1010)
                expect
                (fp #b0 #b01111 #b1011)))
(assert (fp.leq (fp #b0 #b01111 #b1011)
                expect
                (fp #b0 #b10111 #b0110)))
; expect = 1.6875

(assert (not (= expect result)))

(check-sat)
(exit)
