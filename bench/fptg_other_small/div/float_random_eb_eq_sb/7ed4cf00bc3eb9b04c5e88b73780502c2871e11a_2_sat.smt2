                (fp #b1 #b1111101 #b101100)))
(assert (fp.leq (fp #b1 #b1111101 #b101100)
                arg1
                (fp #b0 #b0010101 #b001001)))
; arg1 = -7782220156096217088.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101011 #b110000)
                arg2
                (fp #b0 #b0000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000 #b010000)
                arg2
                (fp #b0 #b1100110 #b010001)))
; arg2 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
