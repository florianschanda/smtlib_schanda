(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b0000)
                arg1
                (fp #b0 #b00111 #b0100)))
(assert (fp.leq (fp #b0 #b00111 #b0100)
                arg1
                (fp #b0 #b10011 #b1100)))
; arg1 = 0.0048828125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00101 #b1010)
                arg2
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg2
                (fp #b0 #b00010 #b1101)))
; arg2 = -0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
