; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1001000 #b011010)
                arg1
                (fp #b0 #b1100010 #b101011)))
(assert (fp.leq (fp #b0 #b1100010 #b101011)
                arg1
                (fp #b0 #b1101101 #b110000)))
; arg1 = 57445187584.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101010 #b010011)
                expect
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                expect
                (fp #b0 #b1001010 #b110011)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
