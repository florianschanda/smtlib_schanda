; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010100 #b101100)
                arg1
                (fp #b1 #b0111111 #b101110)))
(assert (fp.leq (fp #b1 #b0111111 #b101110)
                arg1
                (fp #b0 #b0100100 #b011110)))
; arg1 = -1.71875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101010 #b011001)
                expect
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                expect
                (fp #b0 #b1001100 #b111101)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
