(assert (fp.leq (fp #b1 #b1011110 #b110000)
                expect
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                expect
                (fp #b0 #b0110101 #b101111)))
; expect = -0

