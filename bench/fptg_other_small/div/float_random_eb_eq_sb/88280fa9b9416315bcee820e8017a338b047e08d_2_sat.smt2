(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b11001)
                expect
                (fp #b0 #b000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000 #b00001)
                expect
                (fp #b0 #b001110 #b00101)))
; expect = 0.00000000002910383045673370361328125

(assert (= expect result))

