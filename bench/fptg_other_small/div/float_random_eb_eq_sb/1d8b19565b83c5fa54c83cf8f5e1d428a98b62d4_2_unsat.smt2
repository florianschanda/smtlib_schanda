(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0100)
                arg1
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                arg1
                (fp #b0 #b11101 #b1000)))
; arg1 = 32.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00010 #b1001)
                arg2
                (fp #b0 #b10001 #b1000)))
(assert (fp.leq (fp #b0 #b10001 #b1000)
                arg2
                (fp #b0 #b10100 #b0001)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01100 #b1010)
                expect
                (fp #b0 #b10001 #b0110)))
(assert (fp.leq (fp #b0 #b10001 #b0110)
                expect
                (fp #b0 #b10011 #b0000)))
; expect = 5.5

(assert (not (= expect result)))

(check-sat)
(exit)
