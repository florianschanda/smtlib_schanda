; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b10011)
                arg1
                (fp #b0 #b010000 #b00000)))
(assert (fp.leq (fp #b0 #b010000 #b00000)
                arg1
                (fp #b0 #b010000 #b01100)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000000 #b00100)
                arg2
                (fp #b0 #b011111 #b11010)))
(assert (fp.leq (fp #b0 #b011111 #b11010)
                arg2
                (fp #b0 #b100110 #b10000)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001100 #b11011)
                expect
                (fp #b0 #b001111 #b00100)))
(assert (fp.leq (fp #b0 #b001111 #b00100)
                expect
                (fp #b0 #b110000 #b10011)))
; expect = 0.0000171661376953125

(assert (not (= expect result)))

(check-sat)
(exit)
