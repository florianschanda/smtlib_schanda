(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00100 #b0010)
                arg1
                (fp #b0 #b00111 #b0100)))
(assert (fp.leq (fp #b0 #b00111 #b0100)
                arg1
                (fp #b0 #b01001 #b1111)))
; arg1 = 0.0048828125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10100 #b1100)
                arg2
                (fp #b1 #b01100 #b1001)))
(assert (fp.leq (fp #b1 #b01100 #b1001)
                arg2
                (fp #b1 #b00101 #b1000)))
; arg2 = -0.1953125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0001)
                expect
                (fp #b1 #b01001 #b1010)))
(assert (fp.leq (fp #b1 #b01001 #b1010)
                expect
                (fp #b1 #b00111 #b0001)))
; expect = -0.025390625

(assert (= expect result))

(check-sat)
(exit)
