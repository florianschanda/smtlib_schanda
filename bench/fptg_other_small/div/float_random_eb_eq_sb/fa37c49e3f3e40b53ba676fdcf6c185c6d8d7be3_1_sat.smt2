                arg2
                (fp #b1 #b0100000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000 #b000000)
                arg2
                (fp #b1 #b0000000 #b011100)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100110 #b011101)
                expect
                (fp #b0 #b1111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111110 #b111111)
                expect
                (fp #b0 #b1111111 #b000000)))
; expect = 18302628885633695744.0

(assert (= expect result))

(check-sat)
