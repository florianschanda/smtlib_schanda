(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b00)
                arg1
                (fp #b0 #b001 #b00)))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b010 #b10)))
; arg1 = 0.25

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b11)
                arg2
                (fp #b0 #b110 #b00)))
(assert (fp.leq (fp #b0 #b110 #b00)
                arg2
                (fp #b0 #b110 #b10)))
; arg2 = 8.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b10)
                expect
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                expect
                (fp #b0 #b111 #b00)))
; expect = 0.0625

(assert (= expect result))

(check-sat)
(exit)
