                (fp #b1 #b0111111 #b001000)))
(assert (fp.leq (fp #b1 #b0111111 #b001000)
                arg2
                (fp #b1 #b0010011 #b111001)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b011101)
                expect
                (fp #b0 #b1101101 #b010100)))
(assert (fp.leq (fp #b0 #b1101101 #b010100)
                expect
                (fp #b0 #b1101111 #b110100)))
; expect = 92358976733184.0

(assert (not (= expect result)))

