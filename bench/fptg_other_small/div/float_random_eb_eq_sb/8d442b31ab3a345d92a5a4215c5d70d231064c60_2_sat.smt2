(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001110 #b10001)
                arg1
                (fp #b0 #b000000 #b11001)))
(assert (fp.leq (fp #b0 #b000000 #b11001)
                arg1
                (fp #b0 #b110110 #b00100)))
; arg1 = 0.00000000072759576141834259033203125

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10111)
                arg2
                (fp #b1 #b000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000 #b11111)
                arg2
                (fp #b0 #b100001 #b10000)))
; arg2 = -0.00000000090221874415874481201171875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b00010)
                expect
                (fp #b1 #b011110 #b10100)))
(assert (fp.leq (fp #b1 #b011110 #b10100)
                expect
                (fp #b1 #b001001 #b01000)))
; expect = -0.8125

(assert (= expect result))

(check-sat)
(exit)
