(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg1
                (fp #b0 #b00110 #b0000)))
(assert (fp.leq (fp #b0 #b00110 #b0000)
                arg1
                (fp #b0 #b11000 #b0101)))
; arg1 = 0.001953125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1001)
                arg2
                (fp #b1 #b10011 #b0001)))
(assert (fp.leq (fp #b1 #b10011 #b0001)
                arg2
                (fp #b0 #b10001 #b0111)))
; arg2 = -17.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b0110)
                expect
                (fp #b1 #b00001 #b1111)))
(assert (fp.leq (fp #b1 #b00001 #b1111)
                expect
                (fp #b0 #b10000 #b0000)))
; expect = -0.000118255615234375

(assert (= expect result))

(check-sat)
(exit)
