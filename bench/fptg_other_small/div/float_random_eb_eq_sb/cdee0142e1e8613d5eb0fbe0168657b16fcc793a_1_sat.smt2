(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000101 #b001101)
                arg1
                (fp #b1 #b0111111 #b111101)))
(assert (fp.leq (fp #b1 #b0111111 #b111101)
                arg1
                (fp #b0 #b0100010 #b111010)))
; arg1 = -1.953125

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001011 #b110010)
                arg2
                (fp #b1 #b0111111 #b100001)))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg2
                (fp #b1 #b0101111 #b101100)))
; arg2 = -1.515625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010001 #b101111)
                expect
                (fp #b0 #b0111111 #b010010)))
(assert (fp.leq (fp #b0 #b0111111 #b010010)
                expect
                (fp #b0 #b1000000 #b001111)))
; expect = 1.28125

(assert (= expect result))

(check-sat)
(exit)
