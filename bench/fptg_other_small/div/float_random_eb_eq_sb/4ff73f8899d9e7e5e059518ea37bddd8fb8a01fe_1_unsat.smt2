(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                arg1
                (fp #b0 #b00111 #b0100)))
(assert (fp.leq (fp #b0 #b00111 #b0100)
                arg1
                (fp #b0 #b10100 #b1111)))
; arg1 = 0.0048828125

