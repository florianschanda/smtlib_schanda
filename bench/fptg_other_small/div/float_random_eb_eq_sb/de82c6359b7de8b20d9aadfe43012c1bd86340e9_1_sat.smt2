(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011101 #b01101)
                arg1
                (fp #b0 #b100100 #b01100)))
(assert (fp.leq (fp #b0 #b100100 #b01100)
                arg1
                (fp #b0 #b110011 #b01101)))
; arg1 = 44.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100001 #b00100)
                arg2
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg2
                (fp #b0 #b001000 #b01101)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
