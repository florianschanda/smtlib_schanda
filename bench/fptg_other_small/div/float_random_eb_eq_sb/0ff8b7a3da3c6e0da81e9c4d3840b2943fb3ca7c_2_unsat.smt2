; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b10100)
                arg1
                (fp #b1 #b111001 #b10100)))
(assert (fp.leq (fp #b1 #b111001 #b10100)
                arg1
                (fp #b1 #b000011 #b11110)))
; arg1 = -109051904.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b00100)
                arg2
                (fp #b1 #b100100 #b11110)))
(assert (fp.leq (fp #b1 #b100100 #b11110)
                arg2
                (fp #b0 #b111100 #b10110)))
; arg2 = -62.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b11110)
                expect
                (fp #b0 #b110011 #b10110)))
(assert (fp.leq (fp #b0 #b110011 #b10110)
                expect
                (fp #b0 #b110110 #b10110)))
; expect = 1769472.0

(assert (not (= expect result)))

(check-sat)
(exit)
