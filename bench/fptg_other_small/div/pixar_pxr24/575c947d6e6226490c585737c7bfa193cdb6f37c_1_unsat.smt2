(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00011101 #b011001010001000)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10011011 #b110110110000100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
