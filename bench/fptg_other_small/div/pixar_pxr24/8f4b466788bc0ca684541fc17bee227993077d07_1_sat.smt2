; Format: PIXAR_PXR24
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011100 #b011110110110100)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b00000101 #b000111100011000)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b110001001000000)
                arg2
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b1 #b10101010 #b000100001100000)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b100101010111101)
                expect
                (fp #b0 #b00100000 #b100011010000001)))
(assert (fp.leq (fp #b0 #b00100000 #b100011010000001)
                expect
                (fp #b0 #b11111011 #b101111010110001)))
; expect = 0.00000000000000000000000000003914799279357046573789825244333530061846028458294455276700318790972232818603515625

(assert (= expect result))

(check-sat)
(exit)
