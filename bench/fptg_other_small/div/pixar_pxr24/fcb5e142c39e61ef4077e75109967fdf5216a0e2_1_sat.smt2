; Format: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101010 #b101000110100111)
                arg1
                (fp #b0 #b11100101 #b010000111011001)))
(assert (fp.leq (fp #b0 #b11100101 #b010000111011001)
                arg1
                (fp #b0 #b11101111 #b001110111111010)))
; arg1 = 6411446205963895116236926746624.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10101100 #b100100010110100)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b00100000 #b010010111100010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
