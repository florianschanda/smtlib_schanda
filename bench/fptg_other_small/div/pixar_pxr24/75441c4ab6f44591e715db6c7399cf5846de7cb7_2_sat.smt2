;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000100 #b101000110010101)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b1 #b01100001 #b000011001110110)))
