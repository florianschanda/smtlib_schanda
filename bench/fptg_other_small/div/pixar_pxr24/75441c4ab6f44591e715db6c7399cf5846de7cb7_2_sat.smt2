                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b11000110 #b011001010000011)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000100 #b011111011011011)
                expect
                (fp #b1 #b01110001 #b100001101111000)))
(assert (fp.leq (fp #b1 #b01110001 #b100001101111000)
                expect
                (fp #b1 #b00100100 #b010010110000101)))
; expect = -0.00009320676326751708984375

(assert (= expect result))

(check-sat)
(exit)
