;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110101 #b000011110011101)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b01011010 #b000011110011100)))
