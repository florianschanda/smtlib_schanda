                arg2
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b1 #b01001001 #b000110111101000)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100011 #b010101110101111)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10011100 #b101001110111011)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
