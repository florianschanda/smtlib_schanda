(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001011 #b000011001110010)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b00101111 #b001110101011100)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b100011100110100)
                arg2
                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                arg2
                (fp #b0 #b01100001 #b100100100001001)))
; arg2 = -1.317169189453125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100110 #b010101011010011)
                expect
                (fp #b0 #b01111110 #b100001001011011)))
(assert (fp.leq (fp #b0 #b01111110 #b100001001011011)
                expect
                (fp #b0 #b10010111 #b101100000001000)))
; expect = 0.7592010498046875

(assert (not (= expect result)))

(check-sat)
(exit)
