                arg2
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b00111000 #b101110011100011)))
; arg2 = -0.000000000000000000000000000000000000002003520492353050455323911609004590487859267314017367189827385949574267698380936053581535816192626953125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111111 #b000000000000000)
                expect
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                expect
                (fp #b1 #b00001010 #b000100010001110)))
; expect = -340277174624079928635746076935438991360.0

(assert (not (= expect result)))

(check-sat)
