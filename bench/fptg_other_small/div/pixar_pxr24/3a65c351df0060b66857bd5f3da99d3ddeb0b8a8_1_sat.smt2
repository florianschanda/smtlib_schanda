; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001110 #b111001100100101)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11001111 #b001010001111111)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010110 #b011001101110011)
                arg2
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b00100111 #b011110101101111)))
; arg2 = 0.000000000000000000000000000000000000002989317146423987366913904286094047007221356226984193517069222402471329047557446756400167942047119140625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011101 #b001101010110110)
                expect
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                expect
                (fp #b0 #b11111111 #b000000000000000)))
; expect = 340277174624079928635746076935438991360.0

(assert (= expect result))

(check-sat)
(exit)
