                arg2
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b0 #b00100101 #b010111011101100)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01011101 #b001101010100011)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b01010110 #b100001000101111)))
; expect = 0.0

(assert (not (= expect result)))

