(assert (fp.leq (fp #b0 #b01111111 #b001111010011110)
                arg2
                (fp #b0 #b10111100 #b010001110010001)))
; arg2 = 1.23919677734375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001001 #b011010100010100)
                expect
                (fp #b0 #b10001110 #b100111010010101)))
(assert (fp.leq (fp #b0 #b10001110 #b100111010010101)
                expect
                (fp #b0 #b11010100 #b001111110101001)))
; expect = 52885.0

(assert (= expect result))

(check-sat)
(exit)
