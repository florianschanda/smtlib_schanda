                arg2
                (fp #b1 #b01011111 #b010000001010111)))
(assert (fp.leq (fp #b1 #b01011111 #b010000001010111)
                arg2
                (fp #b1 #b01000001 #b010001110010111)))
; arg2 = -0.00000000029165647674744832329452037811279296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101011 #b010000000001000)
                expect
                (fp #b1 #b10101101 #b110000001011010)))
(assert (fp.leq (fp #b1 #b10101101 #b110000001011010)
                expect
                (fp #b0 #b01000010 #b000100001100100)))
; expect = -123338575839232.0

(assert (= expect result))

(check-sat)
(exit)
