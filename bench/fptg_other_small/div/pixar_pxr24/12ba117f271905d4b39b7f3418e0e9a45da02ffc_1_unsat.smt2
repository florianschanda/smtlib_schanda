; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001010 #b011101011011011)
                arg1
                (fp #b0 #b01111111 #b100001110001010)))
(assert (fp.leq (fp #b0 #b01111111 #b100001110001010)
                arg1
                (fp #b0 #b11100011 #b000111101011000)))
; arg1 = 1.52764892578125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11010101 #b011101110011111)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10000001 #b000010000111100)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
