; Format: PIXAR_PXR24
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b111110110010110)
                arg1
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b01111111 #b111111000100010)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001101 #b101011011001111)
                arg2
                (fp #b0 #b01111111 #b001111010011110)))
(assert (fp.leq (fp #b0 #b01111111 #b001111010011110)
                arg2
                (fp #b0 #b11011001 #b000110010111100)))
; arg2 = 1.23919677734375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100100 #b001101100100010)
                expect
                (fp #b0 #b01111110 #b100111010010110)))
(assert (fp.leq (fp #b0 #b01111110 #b100111010010110)
                expect
                (fp #b0 #b11110110 #b011111011011110)))
; expect = 0.806976318359375

(assert (= expect result))

(check-sat)
(exit)
