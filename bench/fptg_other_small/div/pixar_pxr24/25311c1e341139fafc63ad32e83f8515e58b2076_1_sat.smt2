(assert (fp.leq (fp #b1 #b01111111 #b110011000011011)
                arg2
                (fp #b0 #b00101110 #b001010111001010)))
; arg2 = -1.797698974609375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000100 #b100001101110110)
                expect
                (fp #b0 #b10001110 #b000111001100111)))
(assert (fp.leq (fp #b0 #b10001110 #b000111001100111)
                expect
                (fp #b0 #b11110011 #b111110110110110)))
; expect = 36455.0

(assert (= expect result))

(check-sat)
(exit)
