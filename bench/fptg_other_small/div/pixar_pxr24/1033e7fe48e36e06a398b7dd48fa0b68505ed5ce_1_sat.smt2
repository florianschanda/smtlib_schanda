; Format: PIXAR_PXR24
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110101 #b001001111011011)
                arg1
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b00001010 #b011111011100001)))
; arg1 = -65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00101000 #b001011001110101)
                arg2
                (fp #b0 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                arg2
                (fp #b0 #b11100101 #b000110111111001)))
; arg2 = 18446462598732840960.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100110 #b111110101011111)
                expect
                (fp #b1 #b01001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01001111 #b000000000000000)
                expect
                (fp #b0 #b11101100 #b101000101101010)))
; expect = -0.000000000000003552713678800500929355621337890625

(assert (= expect result))

(check-sat)
(exit)
