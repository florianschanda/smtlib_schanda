(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000001 #b000011100111110)
                arg2
                (fp #b0 #b00000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b00000000 #b100100100100110)
                arg2
                (fp #b0 #b00101000 #b110111000100110)))
; arg2 = 0.00000000000000000000000000000000000000671762305099431026435014660523186418543467139163638639153225233513477832048010895960032939910888671875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b101000001101011)
                expect
                (fp #b1 #b11111101 #b101111111111100)))
(assert (fp.leq (fp #b1 #b11111101 #b101111111111100)
                expect
                (fp #b1 #b00101100 #b100001101111100)))
; expect = -148863150934193508109969329758740152320.0

(assert (= expect result))

(check-sat)
(exit)
