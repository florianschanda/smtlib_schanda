; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110101 #b100011110001101)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b11010110 #b000010011011001)))
; arg1 = 51436.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010100 #b101010110010101)
                arg2
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b10100010 #b001100000100000)))
; arg2 = 14088.75

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000101 #b100100000011100)
                expect
                (fp #b0 #b10000000 #b110100110100111)))
(assert (fp.leq (fp #b0 #b10000000 #b110100110100111)
                expect
                (fp #b0 #b10011000 #b010010101100000)))
; expect = 3.65081787109375

(assert (= expect result))

(check-sat)
(exit)
