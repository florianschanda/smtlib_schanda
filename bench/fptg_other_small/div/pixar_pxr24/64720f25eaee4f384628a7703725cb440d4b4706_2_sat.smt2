; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001001 #b000011110011110)
                arg1
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                arg1
                (fp #b0 #b11111001 #b110000111010001)))
; arg1 = 35973.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110001 #b110110110011101)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b10000001 #b010011001101110)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110111 #b111001011011001)
                expect
                (fp #b1 #b01111110 #b011000100001111)))
(assert (fp.leq (fp #b1 #b01111110 #b011000100001111)
                expect
                (fp #b0 #b11101110 #b011010110101010)))
; expect = -0.6916351318359375

(assert (= expect result))

(check-sat)
(exit)
