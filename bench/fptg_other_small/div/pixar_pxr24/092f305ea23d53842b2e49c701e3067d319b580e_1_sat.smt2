; Format: PIXAR_PXR24
; Arg1: +ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000000 #b110000101100111)
                arg1
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b11100101 #b101101011010010)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010010 #b000101011011111)
                arg2
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                arg2
                (fp #b0 #b11001011 #b101101101101100)))
; arg2 = 8115.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110011 #b101011001010100)
                expect
                (fp #b0 #b01110010 #b000000100110110)))
(assert (fp.leq (fp #b0 #b01110010 #b000000100110110)
                expect
                (fp #b0 #b10001011 #b000000100011111)))
; expect = 0.000123225152492523193359375

(assert (= expect result))

(check-sat)
(exit)
