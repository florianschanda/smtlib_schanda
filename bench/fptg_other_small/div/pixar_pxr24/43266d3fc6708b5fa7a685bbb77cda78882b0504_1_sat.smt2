                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b01001101 #b111001110101001)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101001 #b011111100111101)
                expect
                (fp #b0 #b01110000 #b001001001001110)))
(assert (fp.leq (fp #b0 #b01110000 #b001001001001110)
                expect
                (fp #b0 #b10001011 #b000110001011001)))
; expect = 0.00003488175570964813232421875

(assert (= expect result))

(check-sat)
(exit)
