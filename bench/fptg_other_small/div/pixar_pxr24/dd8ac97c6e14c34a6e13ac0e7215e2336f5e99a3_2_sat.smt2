(assert (fp.leq (fp #b1 #b11110101 #b101001000100101)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b11000000 #b100010000011101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00100000 #b111001110011110)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b10000011 #b010111110000101)))
; arg2 = -0.000000000000000000000000000000000000010253648385483839062582518445868972231778234133672051277857864386156006020200948114506900310516357421875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b11110111 #b110000011011101)
                expect
                (fp #b0 #b11111101 #b001001010111110)))
(assert (fp.leq (fp #b0 #b11111101 #b001001010111110)
                expect
                (fp #b0 #b11111110 #b101110011001100)))
; expect = 97526911893859667346688312551741063168.0

(assert (= expect result))

(check-sat)
(exit)
