; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b110110001110101)
                arg1
                (fp #b1 #b00000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b00000000 #b100101111110110)
                arg1
                (fp #b0 #b01111111 #b010111000010110)))
; arg1 = -0.00000000000000000000000000000000000000697591038393866054686280844202386152675224927276306577858251516122134461284076678566634654998779296875

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001000 #b100101001100001)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10110100 #b001011010001001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
