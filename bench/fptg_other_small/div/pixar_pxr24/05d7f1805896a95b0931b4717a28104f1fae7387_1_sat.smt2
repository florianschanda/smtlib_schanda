                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b11001100 #b011101010100100)))
; arg2 = 1.040771484375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000110 #b100110000101110)
                expect
                (fp #b0 #b01111110 #b111010111111000)))
(assert (fp.leq (fp #b0 #b01111110 #b111010111111000)
                expect
                (fp #b0 #b10010101 #b111000000110100)))
; expect = 0.9608154296875

(assert (= expect result))

(check-sat)
(exit)
