; Format: PIXAR_PXR24
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010100 #b100010111100000)
                arg1
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b10110011 #b111110010011110)))
