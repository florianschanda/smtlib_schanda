                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b11001100 #b111000011000100)))
; arg2 = 1.040771484375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010111 #b111001100100000)
                expect
                (fp #b1 #b01111110 #b111010111111000)))
(assert (fp.leq (fp #b1 #b01111110 #b111010111111000)
                expect
                (fp #b0 #b10111111 #b010001111011001)))
; expect = -0.9608154296875

(assert (not (= expect result)))

(check-sat)
(exit)
