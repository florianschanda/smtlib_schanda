                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                arg2
                (fp #b1 #b00100000 #b000100001001001)))
; arg2 = -1.317169189453125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b111011011100010)
                expect
                (fp #b1 #b10001101 #b101010101011101)))
(assert (fp.leq (fp #b1 #b10001101 #b101010101011101)
                expect
                (fp #b1 #b00100011 #b110011110111011)))
; expect = -27310.5

(assert (not (= expect result)))

(check-sat)
(exit)
