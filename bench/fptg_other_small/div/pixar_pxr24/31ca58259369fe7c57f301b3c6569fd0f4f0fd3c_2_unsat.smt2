(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b0 #b00101011 #b011010100100011)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101101 #b101100001000101)
                expect
                (fp #b0 #b01101011 #b010101110111011)))
(assert (fp.leq (fp #b0 #b01101011 #b010101110111011)
                expect
                (fp #b0 #b10100110 #b110100100000110)))
; expect = 0.00000127949169836938381195068359375

(assert (not (= expect result)))

(check-sat)
(exit)
