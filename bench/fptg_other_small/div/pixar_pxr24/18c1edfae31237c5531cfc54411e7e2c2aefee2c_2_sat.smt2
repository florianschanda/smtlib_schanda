                arg2
                (fp #b0 #b00011100 #b101010110010010)))
(assert (fp.leq (fp #b0 #b00011100 #b101010110010010)
                arg2
                (fp #b0 #b10000000 #b110100111110001)))
; arg2 = 0.00000000000000000000000000000263245734448569332574956345082220790534380423786320335466371034272015094757080078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b011101100001001)
                expect
                (fp #b1 #b11101100 #b011001011100111)))
(assert (fp.leq (fp #b1 #b11101100 #b011001011100111)
                expect
                (fp #b0 #b01110100 #b001010010111100)))
; expect = -907142653747698099361679845359616.0

(assert (= expect result))

(check-sat)
(exit)
