; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100100 #b100001111110111)
                arg1
                (fp #b0 #b01111111 #b100001110001010)))
(assert (fp.leq (fp #b0 #b01111111 #b100001110001010)
                arg1
                (fp #b0 #b10001011 #b100001000111101)))
; arg1 = 1.52764892578125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111100 #b101111110101011)
                arg2
                (fp #b0 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b11110001 #b000001100010110)))
; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00011101 #b110110111000010)
                expect
                (fp #b0 #b01101111 #b001101110001000)))
(assert (fp.leq (fp #b0 #b01101111 #b001101110001000)
                expect
                (fp #b0 #b11000001 #b001011111011110)))
; expect = 0.0000185407698154449462890625

(assert (= expect result))

(check-sat)
(exit)
