                arg2
                (fp #b0 #b11101001 #b010111011100010)))
; arg2 = 14088.75

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b110000110010101)
                expect
                (fp #b1 #b01110001 #b001010011011010)))
(assert (fp.leq (fp #b1 #b01110001 #b001010011011010)
                expect
                (fp #b0 #b01001100 #b000110000100111)))
; expect = -0.0000709779560565948486328125

(assert (= expect result))

(check-sat)
(exit)
