; Format: PIXAR_PXR24
; Arg1: -ONE
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000011 #b010100110001110)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b00011100 #b111001001100101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00100111 #b100111000010101)
                arg2
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b11111000 #b100010110110110)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
