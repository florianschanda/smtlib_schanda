                arg2
                (fp #b0 #b10011010 #b001100100010101)))
; arg2 = -1106900345914654720.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011010 #b001001101010011)
                expect
                (fp #b1 #b10010101 #b101010101001101)))
(assert (fp.leq (fp #b1 #b10010101 #b101010101001101)
                expect
                (fp #b0 #b10101011 #b101000101000011)))
; expect = -6989440.0

(assert (= expect result))

