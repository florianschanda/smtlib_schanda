;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001110 #b101101111110000)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
