; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001101 #b110000100110010)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11100011 #b000000011000111)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001110 #b110100101011111)
                arg2
                (fp #b0 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b10100011 #b110010011110001)))
; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01101001 #b000011001100011)
                expect
                (fp #b0 #b01111110 #b100101110100000)))
(assert (fp.leq (fp #b0 #b01111110 #b100101110100000)
                expect
                (fp #b0 #b10001011 #b001010001010011)))
; expect = 0.79541015625

(assert (not (= expect result)))

(check-sat)
(exit)
