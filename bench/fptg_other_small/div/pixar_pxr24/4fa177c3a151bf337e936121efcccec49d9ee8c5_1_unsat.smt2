(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00011110 #b110101010111000)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b10111110 #b010110010000110)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00111010 #b001001010000010)
                arg2
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                arg2
                (fp #b0 #b11101011 #b101111010011101)))
; arg2 = 8115.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100110 #b101000110110111)
                expect
                (fp #b0 #b10000010 #b000000100110110)))
(assert (fp.leq (fp #b0 #b10000010 #b000000100110110)
                expect
                (fp #b0 #b11110001 #b010001000110110)))
; expect = 8.07568359375

(assert (not (= expect result)))

(check-sat)
(exit)
