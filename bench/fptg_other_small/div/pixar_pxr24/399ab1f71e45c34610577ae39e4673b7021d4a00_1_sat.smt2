(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b100111110000101)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b00101100 #b010100100010100)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b000010100111010)
                expect
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b11011011 #b010000111111011)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
