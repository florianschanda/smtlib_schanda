                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b00100000 #b111111100010110)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010010 #b011010011100010)
                expect
                (fp #b0 #b10101110 #b011100110011101)))
(assert (fp.leq (fp #b0 #b10101110 #b011100110011101)
                expect
                (fp #b0 #b11000111 #b110001101110000)))
; expect = 204083961004032.0

(assert (not (= expect result)))

(check-sat)
(exit)
