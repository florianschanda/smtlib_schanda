;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101100 #b110100111111100)
                arg1
                (fp #b1 #b00000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b00000000 #b100101111110110)
