; arg2 = -0.00000000029165647674744832329452037811279296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101111 #b111111010011101)
                expect
                (fp #b0 #b10011110 #b100110001011110)))
(assert (fp.leq (fp #b0 #b10011110 #b100110001011110)
                expect
                (fp #b0 #b10100010 #b101010110101101)))
; expect = 3428712448.0

(assert (= expect result))

