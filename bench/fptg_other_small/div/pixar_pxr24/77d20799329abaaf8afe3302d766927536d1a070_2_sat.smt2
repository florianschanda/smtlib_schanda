                arg2
                (fp #b1 #b01001010 #b011001111100110)))
; arg2 = -1.317169189453125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000111 #b111111110101100)
                expect
                (fp #b1 #b01111110 #b100001001011100)))
(assert (fp.leq (fp #b1 #b01111110 #b100001001011100)
                expect
                (fp #b0 #b00111111 #b100111101100110)))
; expect = -0.75921630859375

(assert (= expect result))

(check-sat)
(exit)
