; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111001 #b010101000001010)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b0 #b10011101 #b001011100100011)))
; arg1 = -48335.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00011000 #b111001010100010)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b11100111 #b100000110101100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
