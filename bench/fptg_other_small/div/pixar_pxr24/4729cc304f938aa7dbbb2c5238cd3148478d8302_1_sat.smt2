; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110011 #b000011100110101)
                arg1
                (fp #b1 #b00000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b00000000 #b010010100000101)
                arg1
                (fp #b0 #b00100000 #b110110101001110)))
; arg1 = -0.000000000000000000000000000000000000003399707019880010593572911426774665005092618860329917432049084448364428823197158635593950748443603515625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b001111110000010)
                arg2
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b0 #b00100001 #b011110000110101)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000011 #b100101110011111)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b11111001 #b000110101111110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
