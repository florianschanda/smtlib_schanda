                expect
                (fp #b1 #b11001100 #b010000011010010)))
(assert (fp.leq (fp #b1 #b11001100 #b010000011010010)
                expect
                (fp #b1 #b00101111 #b101111000001100)))
; expect = -189863113378655560007680.0

(assert (= expect result))

