(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100101 #b001111001110000)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11001000 #b110011010110111)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110100 #b110001001111101)
                arg2
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b0 #b11010000 #b001000011100010)))
; arg2 = -60693.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001100 #b100101101011001)
                expect
                (fp #b1 #b01111111 #b000101000110111)))
(assert (fp.leq (fp #b1 #b01111111 #b000101000110111)
                expect
                (fp #b0 #b00100000 #b001010100110010)))
; expect = -1.079803466796875

(assert (= expect result))

(check-sat)
(exit)
