; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001010 #b101100010011010)
                arg1
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                arg1
                (fp #b0 #b01011001 #b010011010101101)))
; arg1 = -10614702846735548416.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110101 #b001110100011100)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b11110000 #b001010011011100)))
; arg2 = 5679104.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111011 #b100111010101000)
                expect
                (fp #b1 #b10100111 #b101100110010111)))
(assert (fp.leq (fp #b1 #b10100111 #b101100110010111)
                expect
                (fp #b0 #b00010110 #b111100011100000)))
; expect = -1869082525696.0

(assert (= expect result))

(check-sat)
(exit)
