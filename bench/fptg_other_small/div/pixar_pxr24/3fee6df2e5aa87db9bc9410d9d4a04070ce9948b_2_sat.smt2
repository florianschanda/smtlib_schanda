(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b01010000 #b101101011111000)))
; arg2 = -0.00000000000000000000059894338697374774189399922186272107182958279736340045928955078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011001 #b001011000000001)
                expect
                (fp #b1 #b11000101 #b011010100000101)))
(assert (fp.leq (fp #b1 #b11000101 #b011010100000101)
                expect
                (fp #b0 #b11010011 #b010101101011001)))
; expect = -1669610482655809241088.0

(assert (= expect result))

(check-sat)
(exit)
