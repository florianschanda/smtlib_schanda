(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0001010110)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b01001 #b1000110011)))
; arg1 = -1809.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10011 #b1000111010)
                arg2
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11110 #b0000011111)))
; arg2 = 255.875

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101101111)
                expect
                (fp #b1 #b10001 #b1100010010)))
(assert (fp.leq (fp #b1 #b10001 #b1100010010)
                expect
                (fp #b0 #b11001 #b0110101101)))
; expect = -7.0703125

(assert (not (= expect result)))

(check-sat)
(exit)
