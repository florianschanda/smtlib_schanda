(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1100000000)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b1 #b00110 #b0011000001)))
; arg1 = -264.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01010 #b1000010110)
                arg2
                (fp #b0 #b01011 #b0000100001)))
(assert (fp.leq (fp #b0 #b01011 #b0000100001)
                arg2
                (fp #b0 #b10110 #b0100010100)))
; arg2 = 0.06451416015625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101111101)
                expect
                (fp #b1 #b11010 #b1111111110)))
(assert (fp.leq (fp #b1 #b11010 #b1111111110)
                expect
                (fp #b1 #b01110 #b0100010100)))
; expect = -4092.0

(assert (not (= expect result)))

(check-sat)
(exit)
