                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg2
                (fp #b0 #b11101 #b0010000111)))
; arg2 = -0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100001100)
                expect
                (fp #b1 #b11011 #b0000000000)))
(assert (fp.leq (fp #b1 #b11011 #b0000000000)
                expect
                (fp #b0 #b10111 #b1000100011)))
; expect = -4096.0

(assert (not (= expect result)))

(check-sat)
(exit)
