(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                arg2
                (fp #b0 #b01101 #b0111100010)))
; arg2 = 0.000006973743438720703125

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10010 #b1010111011)
                expect
                (fp #b0 #b11011 #b1110100000)))
(assert (fp.leq (fp #b0 #b11011 #b1110100000)
                expect
                (fp #b0 #b11110 #b1101010111)))
; expect = 7808.0

(assert (not (= expect result)))

