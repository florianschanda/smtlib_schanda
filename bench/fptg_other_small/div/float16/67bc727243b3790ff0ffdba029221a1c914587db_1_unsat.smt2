(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b0111011001)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b01111 #b0100111010)))
; arg1 = -0.000039398670196533203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000010)
                arg2
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg2
                (fp #b0 #b00001 #b0011011011)))
; arg2 = 0.00006103515625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1011011001)
                expect
                (fp #b1 #b01110 #b0100101010)))
(assert (fp.leq (fp #b1 #b01110 #b0100101010)
                expect
                (fp #b1 #b01011 #b0110000001)))
; expect = -0.6455078125

(assert (not (= expect result)))

(check-sat)
(exit)
