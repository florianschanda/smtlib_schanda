(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00111 #b0100011101)
                arg1
                (fp #b0 #b11010 #b0010000000)))
(assert (fp.leq (fp #b0 #b11010 #b0010000000)
                arg1
                (fp #b0 #b11110 #b0101111000)))
; arg1 = 2304.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00010 #b0111101101)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b10101 #b1110010011)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00100 #b0001010101)
                expect
                (fp #b0 #b10110 #b0111010001)))
(assert (fp.leq (fp #b0 #b10110 #b0111010001)
                expect
                (fp #b0 #b11101 #b0010111000)))
; expect = 186.125

(assert (= expect result))

(check-sat)
(exit)
