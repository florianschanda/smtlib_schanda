; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b0010100011)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b01010 #b1000001110)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1000000011)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b10010 #b1001011111)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0011001001)
                expect
                (fp #b1 #b01011 #b0011000010)))
(assert (fp.leq (fp #b1 #b01011 #b0011000010)
                expect
                (fp #b0 #b10001 #b0100011111)))
; expect = -0.0743408203125

(assert (not (= expect result)))

(check-sat)
(exit)
