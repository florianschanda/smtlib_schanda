(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0110101100)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b10111 #b1111100001)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (= arg2 arg1))

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01000 #b0001001010)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b11000 #b0001000001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
