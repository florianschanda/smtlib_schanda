(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1111110111)
                arg1
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg1
                (fp #b0 #b11001 #b0000011100)))
; arg1 = 0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111110001)
                arg2
                (fp #b1 #b11110 #b1111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111001110)
                arg2
                (fp #b0 #b11001 #b1010001010)))
; arg2 = -63936.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11011 #b1100101101)
                expect
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                expect
                (fp #b0 #b00011 #b1011000001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
