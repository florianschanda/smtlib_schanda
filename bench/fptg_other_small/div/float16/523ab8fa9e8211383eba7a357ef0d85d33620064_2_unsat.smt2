                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b1 #b00110 #b1001111111)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0000101110)
                expect
                (fp #b1 #b00000 #b0001001010)))
(assert (fp.leq (fp #b1 #b00000 #b0001001010)
                expect
                (fp #b0 #b10110 #b1111010101)))
; expect = -0.00000441074371337890625

(assert (not (= expect result)))

(check-sat)
(exit)
