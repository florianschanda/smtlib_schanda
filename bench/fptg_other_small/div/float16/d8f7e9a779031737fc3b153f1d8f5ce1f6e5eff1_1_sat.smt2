(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0011011001)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11011 #b1110000101)))
; arg1 = 14.8359375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0100010111)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b0 #b01010 #b1100000100)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b1100110011)
                expect
                (fp #b1 #b01010 #b1000010001)))
(assert (fp.leq (fp #b1 #b01010 #b1000010001)
                expect
                (fp #b0 #b00011 #b1110101101)))
; expect = -0.047393798828125

(assert (= expect result))

(check-sat)
(exit)
