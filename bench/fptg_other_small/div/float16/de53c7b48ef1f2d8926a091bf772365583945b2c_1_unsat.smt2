(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b1011110000)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b01110 #b1010000011)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1110010011)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b1 #b01001 #b1111010100)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1000000001)
                expect
                (fp #b1 #b00000 #b0000110111)))
(assert (fp.leq (fp #b1 #b00000 #b0000110111)
                expect
                (fp #b0 #b11100 #b1110000011)))
; expect = -0.000003278255462646484375

(assert (not (= expect result)))

(check-sat)
(exit)
