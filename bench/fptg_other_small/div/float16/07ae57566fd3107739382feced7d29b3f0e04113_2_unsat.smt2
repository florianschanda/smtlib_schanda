                arg2
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                arg2
                (fp #b0 #b11100 #b0100001110)))
; arg2 = 439.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b1101111101)
                expect
                (fp #b1 #b00000 #b0001100000)))
(assert (fp.leq (fp #b1 #b00000 #b0001100000)
                expect
                (fp #b0 #b10001 #b0000100110)))
; expect = -0.0000057220458984375

(assert (not (= expect result)))

(check-sat)
(exit)
