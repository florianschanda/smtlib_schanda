(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0000111000)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b01111 #b1010100011)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100101100)
                arg2
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                arg2
                (fp #b1 #b00011 #b0000101000)))
; arg2 = -32416.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0010100001)
                expect
                (fp #b1 #b00000 #b1100111011)))
(assert (fp.leq (fp #b1 #b00000 #b1100111011)
                expect
                (fp #b0 #b00000 #b0100110000)))
; expect = -0.000049293041229248046875

(assert (not (= expect result)))

(check-sat)
(exit)
