(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1000010000)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00101 #b1011101000)))
; arg1 = -0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101100111)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b00011 #b0000011011)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b1111101100)
                expect
                (fp #b0 #b00001 #b0001100001)))
(assert (fp.leq (fp #b0 #b00001 #b0001100001)
                expect
                (fp #b0 #b11101 #b1000100101)))
; expect = 0.000066816806793212890625

(assert (not (= expect result)))

(check-sat)
(exit)
