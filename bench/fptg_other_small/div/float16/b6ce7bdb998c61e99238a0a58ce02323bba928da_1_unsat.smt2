(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1011111011)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b11001 #b0011111110)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1001100000)
                arg2
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg2
                (fp #b0 #b00010 #b1000011001)))
; arg2 = 0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b11100 #b0100011010)
                expect
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                expect
                (fp #b0 #b11111 #b0000000000)))
; expect = 65504.0

(assert (not (= expect result)))

(check-sat)
(exit)
