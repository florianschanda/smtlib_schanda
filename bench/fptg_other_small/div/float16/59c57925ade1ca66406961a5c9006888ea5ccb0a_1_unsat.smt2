                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b00100 #b1100101000)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b0110011011)
                expect
                (fp #b1 #b00100 #b1000011111)))
(assert (fp.leq (fp #b1 #b00100 #b1000011111)
                expect
                (fp #b0 #b11100 #b1000101010)))
; expect = -0.000747203826904296875

(assert (not (= expect result)))

(check-sat)
(exit)
