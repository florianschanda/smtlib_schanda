(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00001 #b1111101100)
                arg1
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg1
                (fp #b0 #b10101 #b0110001000)))
; arg1 = -0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110010011)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b0 #b00011 #b1100011010)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00010 #b1000010101)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b00000 #b0001110110)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
