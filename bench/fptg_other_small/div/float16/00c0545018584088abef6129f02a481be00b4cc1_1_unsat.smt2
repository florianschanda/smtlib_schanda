                (fp #b1 #b00001 #b1010100010)))
(assert (fp.leq (fp #b1 #b00001 #b1010100010)
                arg2
                (fp #b0 #b01101 #b0101101001)))
; arg2 = -0.00010120868682861328125

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1001100101)
                expect
                (fp #b1 #b11100 #b1010011100)))
(assert (fp.leq (fp #b1 #b11100 #b1010011100)
                expect
                (fp #b1 #b00101 #b0000001001)))
; expect = -13536.0

(assert (not (= expect result)))

