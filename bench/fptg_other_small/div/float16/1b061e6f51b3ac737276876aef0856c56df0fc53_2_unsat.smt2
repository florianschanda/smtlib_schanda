(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1111101101)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b11010 #b1100011110)))
; arg1 = 1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1110100101)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11101 #b0001111010)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01110 #b0110001111)
                expect
                (fp #b0 #b00011 #b1111111111)))
(assert (fp.leq (fp #b0 #b00011 #b1111111111)
                expect
                (fp #b0 #b10110 #b0001010001)))
; expect = 0.0004880428314208984375

(assert (not (= expect result)))

(check-sat)
(exit)
