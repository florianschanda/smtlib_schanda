(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1101101111)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b01110 #b1111010101)))
; arg1 = 0.0078125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1000111011)
                arg2
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b1 #b01001 #b0010000101)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0100010101)
                expect
                (fp #b1 #b00111 #b1110110100)))
(assert (fp.leq (fp #b1 #b00111 #b1110110100)
                expect
                (fp #b0 #b11011 #b1010101110)))
; expect = -0.0075225830078125

(assert (= expect result))

(check-sat)
(exit)
