(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1011111011)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b0 #b00000 #b1011110110)))
; arg1 = -25296.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101001010)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b10110 #b0000111001)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
