(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0000001000)
                arg1
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg1
                (fp #b0 #b00111 #b0100000111)))
; arg1 = 0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0010000010)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b00101 #b1101111110)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0101011000)
                expect
                (fp #b1 #b01111 #b1101011110)))
(assert (fp.leq (fp #b1 #b01111 #b1101011110)
                expect
                (fp #b1 #b01110 #b1000101111)))
; expect = -1.841796875

(assert (not (= expect result)))

(check-sat)
(exit)
