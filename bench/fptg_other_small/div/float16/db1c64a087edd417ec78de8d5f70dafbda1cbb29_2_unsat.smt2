                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b0 #b01100 #b1110010001)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1011111000)
                expect
                (fp #b1 #b01100 #b0001111011)))
(assert (fp.leq (fp #b1 #b01100 #b0001111011)
                expect
                (fp #b0 #b11011 #b0010001011)))
; expect = -0.1400146484375

(assert (not (= expect result)))

(check-sat)
