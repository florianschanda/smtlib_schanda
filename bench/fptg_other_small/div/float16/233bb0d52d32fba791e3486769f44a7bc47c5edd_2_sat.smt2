(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b1011011110)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b01110 #b0101010110)))
; arg1 = -0.000055372714996337890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b0010000010)
                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b00010 #b1010101000)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1101000000)
                expect
                (fp #b1 #b01110 #b1111110011)))
(assert (fp.leq (fp #b1 #b01110 #b1111110011)
                expect
                (fp #b1 #b00110 #b1011001001)))
; expect = -0.99365234375

(assert (= expect result))

(check-sat)
(exit)
