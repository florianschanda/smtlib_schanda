(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +INFINITY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1111111100)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11000 #b0000010110)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000 #b1011110100)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b10001 #b1010110010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
