(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0101111000)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b00011 #b0010010111)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10100 #b0001111001)
                arg2
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg2
                (fp #b0 #b11111 #b0000000000)))
; arg2 = 65504.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00111 #b1011001110)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b11011 #b1001100100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
