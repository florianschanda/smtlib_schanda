(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0110110110)
                arg1
                (fp #b0 #b11010 #b0010000000)))
(assert (fp.leq (fp #b0 #b11010 #b0010000000)
                arg1
                (fp #b0 #b11011 #b1000101011)))
; arg1 = 2304.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00000 #b0001110000)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b11010 #b1001101001)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01110 #b0011000001)
                expect
                (fp #b0 #b11001 #b1100001111)))
(assert (fp.leq (fp #b0 #b11001 #b1100001111)
                expect
                (fp #b0 #b11010 #b1101101010)))
; expect = 1807.0

(assert (= expect result))

(check-sat)
(exit)
