; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0000001000)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b11011 #b1100000110)))
; arg1 = 0.10479736328125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0001110111)
                arg2
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg2
                (fp #b0 #b00010 #b1011001100)))
; arg2 = -0.00006103515625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101110101)
                expect
                (fp #b1 #b11001 #b1010110101)))
(assert (fp.leq (fp #b1 #b11001 #b1010110101)
                expect
                (fp #b0 #b00110 #b1001101010)))
; expect = -1717.0

(assert (not (= expect result)))

(check-sat)
(exit)
