                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11011 #b0011100110)))
; arg2 = 255.875

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1100001100)
                expect
                (fp #b1 #b00000 #b0010100011)))
(assert (fp.leq (fp #b1 #b00000 #b0010100011)
                expect
                (fp #b0 #b00111 #b0000110001)))
; expect = -0.000009715557098388671875

(assert (not (= expect result)))

