(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b0010101010)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0110010011)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1111101010)
                arg2
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                arg2
                (fp #b0 #b00100 #b1001000101)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111000111)
                expect
                (fp #b1 #b11000 #b0000110001)))
(assert (fp.leq (fp #b1 #b11000 #b0000110001)
                expect
                (fp #b1 #b10010 #b1101101101)))
; expect = -536.5

(assert (not (= expect result)))

(check-sat)
(exit)
