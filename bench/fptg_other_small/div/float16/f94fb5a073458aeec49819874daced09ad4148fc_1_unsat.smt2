                arg2
                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b0 #b00100 #b1101111101)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0000110000)
                expect
                (fp #b1 #b00101 #b0100010110)))
(assert (fp.leq (fp #b1 #b00101 #b0100010110)
                expect
                (fp #b0 #b10001 #b1100101111)))
; expect = -0.0012416839599609375

(assert (not (= expect result)))

(check-sat)
(exit)
