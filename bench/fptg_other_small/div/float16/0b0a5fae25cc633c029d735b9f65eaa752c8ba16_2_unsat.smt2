                arg2
                (fp #b0 #b01111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111 #b0010110101)
                arg2
                (fp #b0 #b10010 #b0001101001)))
; arg2 = 1.1767578125

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010001110)
                expect
                (fp #b1 #b00100 #b1111100100)))
(assert (fp.leq (fp #b1 #b00100 #b1111100100)
                expect
                (fp #b1 #b00001 #b1010001110)))
; expect = -0.0009632110595703125

(assert (not (= expect result)))

(check-sat)
(exit)
