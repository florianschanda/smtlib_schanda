(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1000110001)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b01100 #b1110010101)))
; arg1 = 0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01111 #b0000001100)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b11010 #b0001111110)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b0110011110)
                expect
                (fp #b0 #b00000 #b0001010011)))
(assert (fp.leq (fp #b0 #b00000 #b0001010011)
                expect
                (fp #b0 #b00011 #b0101010010)))
; expect = 0.000004947185516357421875

(assert (= expect result))

(check-sat)
(exit)
