(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0001100111)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11010 #b1100001101)))
; arg1 = 1872.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg2
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg2
                (fp #b0 #b00011 #b0110100110)))
; arg2 = -65504.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b1011011101)
                expect
                (fp #b1 #b01001 #b1101010000)))
(assert (fp.leq (fp #b1 #b01001 #b1101010000)
                expect
                (fp #b0 #b01111 #b0011011110)))
; expect = -0.028564453125

(assert (not (= expect result)))

(check-sat)
(exit)
