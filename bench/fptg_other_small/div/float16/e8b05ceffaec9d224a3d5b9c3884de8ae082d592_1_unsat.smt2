(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1110000110)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b01000 #b0010011011)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0110101101)
                arg2
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg2
                (fp #b0 #b01011 #b1001001100)))
; arg2 = -0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01111 #b1000011101)
                expect
                (fp #b0 #b10000 #b1111111110)))
(assert (fp.leq (fp #b0 #b10000 #b1111111110)
                expect
                (fp #b0 #b10011 #b0111100000)))
; expect = 3.99609375

(assert (not (= expect result)))

(check-sat)
(exit)
