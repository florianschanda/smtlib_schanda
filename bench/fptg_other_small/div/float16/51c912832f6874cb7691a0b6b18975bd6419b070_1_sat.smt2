(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0010011110)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b0 #b10111 #b1100011010)))
; arg1 = -25296.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01110 #b1001110010)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b11011 #b0011110000)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110110100)
                expect
                (fp #b1 #b11001 #b1111111100)))
(assert (fp.leq (fp #b1 #b11001 #b1111111100)
                expect
                (fp #b0 #b10110 #b0110100101)))
; expect = -2044.0

(assert (= expect result))

(check-sat)
(exit)
