(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0010100001)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b0 #b10001 #b1011111100)))
; arg1 = -0.0078125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0111001001)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b0 #b01000 #b0001100100)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b0100000111)
                expect
                (fp #b0 #b00000 #b0110100011)))
(assert (fp.leq (fp #b0 #b00000 #b0110100011)
                expect
                (fp #b0 #b00010 #b0010000000)))
; expect = 0.000024974346160888671875

(assert (not (= expect result)))

(check-sat)
(exit)
