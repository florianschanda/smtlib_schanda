(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111100110)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b1 #b00001 #b1011110010)))
; arg1 = -0.0078125

(declare-const arg2 Float16)
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
