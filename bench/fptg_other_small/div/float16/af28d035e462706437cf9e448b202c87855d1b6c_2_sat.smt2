(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0001110001)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b11001 #b0000100010)))
; arg1 = 0.000060558319091796875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01100 #b1000100100)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b1010110111)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0111001100)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00010 #b0101100111)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
