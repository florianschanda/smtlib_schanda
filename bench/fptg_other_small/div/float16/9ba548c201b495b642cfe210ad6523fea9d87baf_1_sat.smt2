(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0100110100)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11011 #b1001101010)))
; arg1 = 1872.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0111010110)
                arg2
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg2
                (fp #b0 #b01010 #b0110011000)))
; arg2 = 0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b11010 #b1001001000)
                expect
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                expect
                (fp #b0 #b11111 #b0000000000)))
; expect = 65504.0

(assert (= expect result))

(check-sat)
(exit)
