(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0100110010)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b00111 #b0000111010)))
; arg1 = -0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111101100)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b1 #b10011 #b1000000111)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1101011011)
                expect
                (fp #b0 #b00000 #b0000001110)))
(assert (fp.leq (fp #b0 #b00000 #b0000001110)
                expect
                (fp #b0 #b00010 #b0100110000)))
; expect = 0.00000083446502685546875

(assert (= expect result))

(check-sat)
(exit)
