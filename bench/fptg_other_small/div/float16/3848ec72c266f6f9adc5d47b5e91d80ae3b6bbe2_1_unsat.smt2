(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1000001000)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b00011 #b0001111101)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
