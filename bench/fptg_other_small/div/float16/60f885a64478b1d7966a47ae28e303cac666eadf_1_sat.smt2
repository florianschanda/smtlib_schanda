(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -ZERO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1000111011)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b01011 #b0100100110)))
; arg1 = 0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00001 #b1011011000)
                arg2
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg2
                (fp #b0 #b11010 #b0010110101)))
; arg2 = -0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
