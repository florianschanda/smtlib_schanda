(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101001000)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0111000001)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11100 #b0111010011)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0111101101)
                expect
                (fp #b0 #b10011 #b1111111101)))
(assert (fp.leq (fp #b0 #b10011 #b1111111101)
                expect
                (fp #b0 #b11010 #b1011110011)))
; expect = 31.953125

(assert (= expect result))

(check-sat)
(exit)
