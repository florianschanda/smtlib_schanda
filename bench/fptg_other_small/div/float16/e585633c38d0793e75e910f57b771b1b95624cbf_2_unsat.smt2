(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b0101001100)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00011 #b1110010110)))
; arg1 = 0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0010111011)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b00110 #b0101001000)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b0000111111)
                expect
                (fp #b1 #b01101 #b1101011110)))
(assert (fp.leq (fp #b1 #b01101 #b1101011110)
                expect
                (fp #b1 #b00011 #b1101010011)))
; expect = -0.46044921875

(assert (not (= expect result)))

(check-sat)
(exit)
