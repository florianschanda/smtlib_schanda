(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b1 #b101 #b0110)))
; arg1 = -15.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0101)
                arg2
                (fp #b1 #b011 #b0110)))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg2
                (fp #b0 #b001 #b1101)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b101 #b0000)
                expect
                (fp #b0 #b110 #b0110)))
(assert (fp.leq (fp #b0 #b110 #b0110)
                expect
                (fp #b0 #b110 #b1110)))
; expect = 11.0

(assert (not (= expect result)))

(check-sat)
(exit)
