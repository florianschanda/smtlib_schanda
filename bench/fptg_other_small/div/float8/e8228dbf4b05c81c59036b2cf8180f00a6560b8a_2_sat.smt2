(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1110)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b0 #b101 #b1100)))
; arg1 = -0.234375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1001)
                arg2
                (fp #b0 #b000 #b1110)))
(assert (fp.leq (fp #b0 #b000 #b1110)
                arg2
                (fp #b0 #b110 #b0000)))
; arg2 = 0.21875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                expect
                (fp #b1 #b011 #b0010)))
(assert (fp.leq (fp #b1 #b011 #b0010)
                expect
                (fp #b0 #b110 #b0111)))
; expect = -1.125

(assert (= expect result))

(check-sat)
(exit)
