(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1010)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b011 #b0100)))
; arg1 = -0.046875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100 #b1000)
                expect
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b100 #b1110)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
