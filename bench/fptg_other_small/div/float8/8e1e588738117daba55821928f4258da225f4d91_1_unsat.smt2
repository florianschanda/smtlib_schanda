(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1110)
                arg1
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b001 #b0001)))
; arg1 = -0.75

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg2
                (fp #b1 #b110 #b0101)))
(assert (fp.leq (fp #b1 #b110 #b0101)
                arg2
                (fp #b0 #b001 #b1111)))
; arg2 = -10.5

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1001)
                expect
                (fp #b0 #b000 #b0100)))
(assert (fp.leq (fp #b0 #b000 #b0100)
                expect
                (fp #b0 #b001 #b0110)))
; expect = 0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
