(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1100)
                arg1
                (fp #b1 #b101 #b0100)))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b100 #b0100)))
; arg1 = -5.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                arg2
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg2
                (fp #b0 #b110 #b0000)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1101)
                expect
                (fp #b1 #b010 #b1010)))
(assert (fp.leq (fp #b1 #b010 #b1010)
                expect
                (fp #b0 #b011 #b0100)))
; expect = -0.8125

(assert (not (= expect result)))

(check-sat)
(exit)
