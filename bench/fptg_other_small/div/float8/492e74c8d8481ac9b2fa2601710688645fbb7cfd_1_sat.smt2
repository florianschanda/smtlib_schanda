(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b0 #b100 #b1100)))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b101 #b0110)))
; arg1 = 3.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1001)
                arg2
                (fp #b0 #b011 #b1101)))
(assert (fp.leq (fp #b0 #b011 #b1101)
                arg2
                (fp #b0 #b110 #b1011)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b011 #b1110)))
(assert (fp.leq (fp #b0 #b011 #b1110)
                expect
                (fp #b0 #b100 #b0111)))
; expect = 1.875

(assert (= expect result))

(check-sat)
(exit)
