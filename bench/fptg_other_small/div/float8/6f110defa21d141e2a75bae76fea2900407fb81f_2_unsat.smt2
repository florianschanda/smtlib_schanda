(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1101)
                arg1
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                arg1
                (fp #b0 #b110 #b0001)))
; arg1 = -0.125

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg2
                (fp #b1 #b000 #b1110)))
(assert (fp.leq (fp #b1 #b000 #b1110)
                arg2
                (fp #b0 #b000 #b0000)))
; arg2 = -0.21875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1000)
                expect
                (fp #b0 #b010 #b0011)))
(assert (fp.leq (fp #b0 #b010 #b0011)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 0.59375

(assert (not (= expect result)))

(check-sat)
(exit)
