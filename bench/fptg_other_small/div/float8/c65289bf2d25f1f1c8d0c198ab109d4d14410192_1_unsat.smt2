(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                arg1
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b110 #b0000)))
; arg1 = -0.25

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg2
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg2
                (fp #b0 #b101 #b0101)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                expect
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                expect
                (fp #b0 #b100 #b1000)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
