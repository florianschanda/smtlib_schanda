(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                arg1
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b1 #b000 #b1011)))
; arg1 = -0.25

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0010)
                arg2
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                arg2
                (fp #b0 #b110 #b0111)))
; arg2 = 0.015625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
