(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0010)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b0 #b010 #b1010)))
; arg1 = -0.234375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b0010)
                arg2
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg2
                (fp #b0 #b111 #b0000)))
; arg2 = 15.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0100)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b0011)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
