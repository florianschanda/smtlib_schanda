(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b1000)
                arg1
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg2
                (fp #b1 #b010 #b1011)))
(assert (fp.leq (fp #b1 #b010 #b1011)
                arg2
                (fp #b0 #b010 #b0001)))
; arg2 = -0.84375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1110)
                expect
                (fp #b1 #b101 #b1101)))
(assert (fp.leq (fp #b1 #b101 #b1101)
                expect
                (fp #b1 #b100 #b0100)))
; expect = -7.25

(assert (= expect result))

(check-sat)
(exit)
