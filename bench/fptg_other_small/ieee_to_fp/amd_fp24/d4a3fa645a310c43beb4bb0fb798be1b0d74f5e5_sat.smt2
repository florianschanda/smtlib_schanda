; Format: AMD_FP24
; Arg1: -INT_BOUNDARY

(declare-const arg1 (_ BitVec 24))
(assert (not (bvule arg1 #b110011111111111111111111)))
(assert (not (bvule #b110100000000000000000001 arg1)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b0010011100101101)
                expect
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                expect
                (fp #b0 #b0011011 #b0010000110110000)))
; expect = -131072.0

(assert (= expect result))

(check-sat)
(exit)
