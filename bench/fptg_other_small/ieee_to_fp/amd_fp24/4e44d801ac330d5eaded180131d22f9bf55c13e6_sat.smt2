(assert (not (bvule #b010100000000000000000001 arg1)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001001 #b1111011100010010)
                expect
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                expect
                (fp #b0 #b1100100 #b0010100100010100)))
; expect = 131072.0

(assert (= expect result))

(check-sat)
(exit)
