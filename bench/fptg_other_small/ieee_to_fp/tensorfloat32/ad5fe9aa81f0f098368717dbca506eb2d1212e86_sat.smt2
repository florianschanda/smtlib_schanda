; Format: TENSORFLOAT32
; Arg1: -INT_BOUNDARY

(declare-const arg1 (_ BitVec 19))
(assert (not (bvule arg1 #b1100010011111111111)))
(assert (not (bvule #b1100010100000000001 arg1)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011101 #b1010001000)
                expect
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                expect
                (fp #b0 #b01111110 #b0100110110)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
