(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO

(declare-const arg1 (_ BitVec 24))
(assert (not (bvule arg1 #b011111111111111111111111)))
(assert (not (bvule #b100000000000000000000001 arg1)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00011100 #b111110011101100)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b01001011 #b000001001100010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
