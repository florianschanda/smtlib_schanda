(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ZERO

(declare-const arg1 (_ BitVec 24))
(assert (not (bvule #b000000000000000000000001 arg1)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00010101 #b111000010101001)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10000110 #b100111100100110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
