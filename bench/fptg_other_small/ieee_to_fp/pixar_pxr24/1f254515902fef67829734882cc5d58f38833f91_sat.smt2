; Format: PIXAR_PXR24
; Arg1: -ONE

(declare-const arg1 (_ BitVec 24))
(assert (not (bvule arg1 #b101111110111111111111111)))
(assert (not (bvule #b101111111000000000000001 arg1)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000100 #b111010010110001)
                expect
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                expect
                (fp #b1 #b00100101 #b100001100101001)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
