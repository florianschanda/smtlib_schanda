; Format: FLOAT8
; Arg1: +LARGEST_NORMAL

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01101110)))
(assert (not (bvule #b01110000 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0001)
                expect
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 15.5

(assert (= expect result))

(check-sat)
(exit)
