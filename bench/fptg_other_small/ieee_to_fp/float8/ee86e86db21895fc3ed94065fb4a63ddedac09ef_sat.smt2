(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10001011)))
(assert (not (bvule #b10001101 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1010)
                expect
                (fp #b1 #b000 #b1100)))
(assert (fp.leq (fp #b1 #b000 #b1100)
                expect
                (fp #b0 #b001 #b0010)))
; expect = -0.1875

(assert (= expect result))

(check-sat)
(exit)
