                (fp #b1 #b101 #b0110)))
(assert (fp.leq (fp #b1 #b101 #b0110)
                expect
                (fp #b0 #b101 #b0100)))
; expect = -5.5

(assert (not (= expect result)))

(check-sat)
(exit)
