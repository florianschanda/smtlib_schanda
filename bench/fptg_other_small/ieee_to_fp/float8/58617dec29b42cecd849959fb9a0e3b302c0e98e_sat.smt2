; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b00110101)))
(assert (not (bvule #b00110111 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1101)
                expect
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                expect
                (fp #b0 #b101 #b1111)))
; expect = 1.375

(assert (= expect result))

(check-sat)
(exit)
