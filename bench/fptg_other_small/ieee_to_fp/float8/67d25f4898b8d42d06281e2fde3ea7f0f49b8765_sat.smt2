(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +ZERO

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule #b00000001 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100 #b0100)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b001 #b1000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
