; Format: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01011011)))
(assert (not (bvule #b01011101 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1111)
                expect
                (fp #b0 #b101 #b1100)))
(assert (fp.leq (fp #b0 #b101 #b1100)
                expect
                (fp #b0 #b101 #b1111)))
; expect = 7.0

(assert (= expect result))

(check-sat)
(exit)
