(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01000001)))
(assert (not (bvule #b01000011 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0111)
                expect
                (fp #b0 #b100 #b0010)))
(assert (fp.leq (fp #b0 #b100 #b0010)
                expect
                (fp #b0 #b100 #b1010)))
; expect = 2.25

(assert (= expect result))

(check-sat)
(exit)
