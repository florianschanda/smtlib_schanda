; Format: FLOAT8
; Arg1: -LARGEST_SUBNORMAL

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10001110)))
(assert (not (bvule #b10010000 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0111)
                expect
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                expect
                (fp #b0 #b001 #b0011)))
; expect = -0.234375

(assert (= expect result))

(check-sat)
(exit)
