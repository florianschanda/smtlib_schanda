; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10110010)))
(assert (not (bvule #b10110100 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0010)
                expect
                (fp #b1 #b011 #b0011)))
(assert (fp.leq (fp #b1 #b011 #b0011)
                expect
                (fp #b1 #b001 #b0100)))
; expect = -1.1875

(assert (not (= expect result)))

(check-sat)
(exit)
