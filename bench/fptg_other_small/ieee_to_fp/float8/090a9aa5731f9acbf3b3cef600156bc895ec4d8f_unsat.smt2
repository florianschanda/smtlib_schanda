; Format: FLOAT8
; Arg1: -SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10001111)))
(assert (not (bvule #b10010001 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                expect
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                expect
                (fp #b0 #b001 #b1000)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
