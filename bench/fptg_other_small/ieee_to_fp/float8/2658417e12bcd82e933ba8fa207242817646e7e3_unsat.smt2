                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                expect
                (fp #b0 #b110 #b1000)))
; expect = 0.078125

(assert (not (= expect result)))

(check-sat)
(exit)
