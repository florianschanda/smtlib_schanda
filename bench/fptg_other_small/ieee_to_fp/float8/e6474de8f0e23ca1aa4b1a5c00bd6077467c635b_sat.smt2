(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +INT_BOUNDARY

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01101101)))
(assert (not (bvule #b01101111 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0010)
                expect
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 15.0

(assert (= expect result))

(check-sat)
(exit)
