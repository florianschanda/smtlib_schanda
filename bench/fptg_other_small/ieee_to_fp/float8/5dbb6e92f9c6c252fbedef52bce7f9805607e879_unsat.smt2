(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b11010000)))
(assert (not (bvule #b11010010 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                expect
                (fp #b1 #b101 #b0001)))
(assert (fp.leq (fp #b1 #b101 #b0001)
                expect
                (fp #b1 #b011 #b0000)))
; expect = -4.25

(assert (not (= expect result)))

(check-sat)
(exit)
