; Format: FLOAT8
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b00000111)))
(assert (not (bvule #b00001001 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                expect
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                expect
                (fp #b0 #b010 #b1000)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
