; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10000111)))
(assert (not (bvule #b10001001 arg1)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                expect
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                expect
                (fp #b0 #b001 #b0110)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
