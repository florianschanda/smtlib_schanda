(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Arg1: +SMALLEST_SUBNORMAL

(declare-const arg1 (_ BitVec 4))
(assert (not (bvule arg1 #b0000)))
(assert (not (bvule #b0010 arg1)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
