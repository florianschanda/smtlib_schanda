; Format: FLOAT_2_2
; Arg1: -SMALLEST_SUBNORMAL

(declare-const arg1 (_ BitVec 4))
(assert (not (bvule arg1 #b1000)))
(assert (not (bvule #b1010 arg1)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
