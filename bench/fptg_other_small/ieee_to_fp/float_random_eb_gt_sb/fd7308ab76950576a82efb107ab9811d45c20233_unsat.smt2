(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const arg1 (_ BitVec 11))
(assert (not (bvule #b00000000001 arg1)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result ((_ to_fp 7 4) arg1)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011011 #b001)
                expect
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                expect
                (fp #b0 #b1100010 #b011)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
