(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const arg1 (_ BitVec 6))
(assert (not (bvule arg1 #b010100)))
(assert (not (bvule #b010110 arg1)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1010 #b0)
                expect
                (fp #b0 #b1010 #b1)))
(assert (fp.leq (fp #b0 #b1010 #b1)
                expect
                (fp #b0 #b1110 #b1)))
; expect = 12.0

(assert (= expect result))

(check-sat)
(exit)
