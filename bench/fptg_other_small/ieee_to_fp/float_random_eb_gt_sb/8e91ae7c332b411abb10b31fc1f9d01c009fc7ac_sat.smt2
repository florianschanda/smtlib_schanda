(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const arg1 (_ BitVec 6))
(assert (not (bvule arg1 #b100011)))
(assert (not (bvule #b100101 arg1)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0011 #b1)
                expect
                (fp #b1 #b0010 #b0)))
(assert (fp.leq (fp #b1 #b0010 #b0)
                expect
                (fp #b0 #b0101 #b0)))
; expect = -0.03125

(assert (= expect result))

(check-sat)
(exit)
