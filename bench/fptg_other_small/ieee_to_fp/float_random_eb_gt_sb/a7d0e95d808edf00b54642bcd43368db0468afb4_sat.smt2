(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const arg1 (_ BitVec 7))
(assert (not (bvule arg1 #b1101101)))
(assert (not (bvule #b1101111 arg1)))

(declare-const result (_ FloatingPoint 5 2))
(assert (= result ((_ to_fp 5 2) arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b1)
                expect
                (fp #b1 #b10111 #b0)))
(assert (fp.leq (fp #b1 #b10111 #b0)
                expect
                (fp #b0 #b00001 #b0)))
; expect = -256.0

(assert (= expect result))

(check-sat)
(exit)
