(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule #b00000001 arg1)))

(declare-const result (_ FloatingPoint 5 3))
(assert (= result ((_ to_fp 5 3) arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11100 #b00)
                expect
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                expect
                (fp #b0 #b00010 #b11)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
