(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01000000)))
(assert (not (bvule #b01000010 arg1)))

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100101 #b0)
                expect
                (fp #b0 #b100000 #b1)))
(assert (fp.leq (fp #b0 #b100000 #b1)
                expect
                (fp #b0 #b101001 #b0)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
