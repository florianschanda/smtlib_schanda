(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY

(declare-const arg1 (_ BitVec 15))
(assert (not (bvule arg1 #b111111110111111)))
(assert (not (bvule #b111111111000001 arg1)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result ((_ to_fp 8 7) arg1)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
