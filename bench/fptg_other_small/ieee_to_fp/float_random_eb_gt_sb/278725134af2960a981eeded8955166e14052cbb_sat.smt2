; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const arg1 (_ BitVec 6))
(assert (not (bvule arg1 #b001110)))
(assert (not (bvule #b010000 arg1)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1100 #b1)
                expect
                (fp #b0 #b0111 #b1)))
(assert (fp.leq (fp #b0 #b0111 #b1)
                expect
                (fp #b0 #b1011 #b1)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
