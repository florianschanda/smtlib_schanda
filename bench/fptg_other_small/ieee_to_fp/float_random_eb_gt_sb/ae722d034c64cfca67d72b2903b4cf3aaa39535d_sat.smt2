; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const arg1 (_ BitVec 11))
(assert (not (bvule arg1 #b01000000011)))
(assert (not (bvule #b01000000101 arg1)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b01010111 #b01)
                expect
                (fp #b0 #b10000001 #b00)))
(assert (fp.leq (fp #b0 #b10000001 #b00)
                expect
                (fp #b0 #b11010011 #b00)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
