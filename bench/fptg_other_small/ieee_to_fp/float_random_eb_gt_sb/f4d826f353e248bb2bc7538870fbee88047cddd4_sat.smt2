; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const arg1 (_ BitVec 5))
(assert (not (bvule arg1 #b00000)))
(assert (not (bvule #b00010 arg1)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                expect
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                expect
                (fp #b0 #b111 #b0)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
