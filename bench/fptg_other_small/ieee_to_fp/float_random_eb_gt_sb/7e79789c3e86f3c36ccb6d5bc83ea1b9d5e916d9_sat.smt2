; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 6))
(assert (not (bvule arg1 #b100111)))
(assert (not (bvule #b101001 arg1)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0100 #b1)
                expect
                (fp #b1 #b0100 #b0)))
(assert (fp.leq (fp #b1 #b0100 #b0)
                expect
                (fp #b0 #b0010 #b0)))
; expect = -0.125

(assert (= expect result))

(check-sat)
(exit)
