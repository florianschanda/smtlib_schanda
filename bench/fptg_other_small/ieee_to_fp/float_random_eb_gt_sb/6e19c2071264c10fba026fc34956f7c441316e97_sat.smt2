(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const arg1 (_ BitVec 11))
(assert (not (bvule arg1 #b10111111110)))
(assert (not (bvule #b11000000000 arg1)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011001 #b11)
                expect
                (fp #b1 #b01111111 #b11)))
(assert (fp.leq (fp #b1 #b01111111 #b11)
                expect
                (fp #b0 #b01111000 #b00)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
