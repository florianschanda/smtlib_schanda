(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +INFINITY

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0111111101111111)))
(assert (not (bvule #b0111111110000001 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
