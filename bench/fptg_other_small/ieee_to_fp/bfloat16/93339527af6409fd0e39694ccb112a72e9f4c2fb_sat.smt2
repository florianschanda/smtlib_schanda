(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011111111011101)))
(assert (not (bvule #b0011111111011111 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100001 #b1001011)
                expect
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                expect
                (fp #b0 #b11000000 #b0110001)))
; expect = 1.734375

(assert (= expect result))

(check-sat)
(exit)
