(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1011111110000000)))
(assert (not (bvule #b1011111110000010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101100 #b1110101)
                expect
                (fp #b1 #b01111111 #b0000001)))
(assert (fp.leq (fp #b1 #b01111111 #b0000001)
                expect
                (fp #b0 #b01100011 #b0111101)))
; expect = -1.0078125

(assert (= expect result))

(check-sat)
(exit)
