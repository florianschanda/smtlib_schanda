; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1100001100000101)))
(assert (not (bvule #b1100001100000111 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001011 #b0110110)
                expect
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                expect
                (fp #b1 #b00010000 #b0111001)))
; expect = -134.0

(assert (= expect result))

(check-sat)
(exit)
