(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0100001001111111)))
(assert (not (bvule #b0100001010000001 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111011 #b1101010)
                expect
                (fp #b0 #b10000101 #b0000000)))
(assert (fp.leq (fp #b0 #b10000101 #b0000000)
                expect
                (fp #b0 #b11000011 #b1011110)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
