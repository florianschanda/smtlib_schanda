; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011111111000100)))
(assert (not (bvule #b0011111111000110 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011100 #b1101000)
                expect
                (fp #b0 #b01111111 #b1000101)))
(assert (fp.leq (fp #b0 #b01111111 #b1000101)
                expect
                (fp #b0 #b11010010 #b0011000)))
; expect = 1.5390625

(assert (not (= expect result)))

(check-sat)
(exit)
