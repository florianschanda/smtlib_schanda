; Format: BFLOAT16
; Arg1: -LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111111101111110)))
(assert (not (bvule #b1111111110000000 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                expect
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                expect
                (fp #b0 #b11010000 #b0010110)))
; expect = -338953138925153547590470800371487866880.0

(assert (= expect result))

(check-sat)
(exit)
