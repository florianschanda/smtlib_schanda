; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011111110111011)))
(assert (not (bvule #b0011111110111101 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001010 #b1011000)
                expect
                (fp #b0 #b01111111 #b0111100)))
(assert (fp.leq (fp #b0 #b01111111 #b0111100)
                expect
                (fp #b0 #b11100101 #b0101000)))
; expect = 1.46875

(assert (= expect result))

(check-sat)
(exit)
