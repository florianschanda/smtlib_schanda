(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0100001001101110)))
(assert (not (bvule #b0100001001110000 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01110000 #b1011111)
                expect
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                expect
                (fp #b0 #b11011111 #b1101010)))
; expect = 59.75

(assert (= expect result))

(check-sat)
(exit)
