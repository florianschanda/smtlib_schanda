                expect
                (fp #b1 #b01111111 #b0001001)))
(assert (fp.leq (fp #b1 #b01111111 #b0001001)
                expect
                (fp #b0 #b11101101 #b1100001)))
; expect = -1.0703125

(assert (not (= expect result)))

(check-sat)
(exit)
