(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1100001100011100)))
(assert (not (bvule #b1100001100011110 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001100 #b1010011)
                expect
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                expect
                (fp #b0 #b00011000 #b1110001)))
; expect = -157.0

(assert (= expect result))

(check-sat)
(exit)
