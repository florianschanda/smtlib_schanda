; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111000100101000)))
(assert (not (bvule #b1111000100101010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1000011)
                expect
                (fp #b1 #b11100010 #b0101001)))
(assert (fp.leq (fp #b1 #b11100010 #b0101001)
                expect
                (fp #b0 #b01100110 #b1101100)))
; expect = -836847466556917065831807975424.0

(assert (= expect result))

(check-sat)
(exit)
