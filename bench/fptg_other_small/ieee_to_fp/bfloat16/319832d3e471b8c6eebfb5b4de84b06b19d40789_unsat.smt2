; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1100001100110000)))
(assert (not (bvule #b1100001100110010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101111 #b1000101)
                expect
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                expect
                (fp #b0 #b10001010 #b0000101)))
; expect = -177.0

(assert (not (= expect result)))

(check-sat)
(exit)
