                (fp #b0 #b10000110 #b1001000)))
(assert (fp.leq (fp #b0 #b10000110 #b1001000)
                expect
                (fp #b0 #b11101001 #b0100000)))
; expect = 200.0

(assert (not (= expect result)))

(check-sat)
(exit)
