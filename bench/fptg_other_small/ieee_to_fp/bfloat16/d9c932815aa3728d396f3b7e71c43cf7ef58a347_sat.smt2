(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0100101001010100)))
(assert (not (bvule #b0100101001010110 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000010 #b0100101)
                expect
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                expect
                (fp #b0 #b10111110 #b0000100)))
; expect = 3489792.0

(assert (= expect result))

(check-sat)
(exit)
