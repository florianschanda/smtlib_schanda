; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1011111110100110)))
(assert (not (bvule #b1011111110101000 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0101000)
                expect
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                expect
                (fp #b1 #b01010001 #b0011001)))
; expect = -1.3046875

(assert (not (= expect result)))

(check-sat)
(exit)
