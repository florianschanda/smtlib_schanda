(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +ZERO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule #b0000000000000001 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11001011 #b1100100)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b10001011 #b1111001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
