(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const arg1 (_ BitVec 6))
(assert (not (bvule arg1 #b100000)))
(assert (not (bvule #b100010 arg1)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b10)
                expect
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b110 #b01)))
; expect = -0.0625

(assert (= expect result))

(check-sat)
(exit)
