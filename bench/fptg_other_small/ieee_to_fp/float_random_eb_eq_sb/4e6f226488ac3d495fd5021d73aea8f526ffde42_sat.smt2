; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b00000001)))
(assert (not (bvule #b00000011 arg1)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b110)
                expect
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                expect
                (fp #b0 #b1000 #b001)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
