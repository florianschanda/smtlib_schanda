(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const arg1 (_ BitVec 14))
(assert (not (bvule #b00000000000001 arg1)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1010011 #b010100)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b1010111 #b101000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
