(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

(declare-const arg1 (_ BitVec 10))
(assert (not (bvule arg1 #b0111111111)))
(assert (not (bvule #b1000000001 arg1)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11001 #b0011)
                expect
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                expect
                (fp #b0 #b10011 #b1111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
