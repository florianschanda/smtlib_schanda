; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10000000)))
(assert (not (bvule #b10000010 arg1)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                expect
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                expect
                (fp #b0 #b0000 #b101)))
; expect = -0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
