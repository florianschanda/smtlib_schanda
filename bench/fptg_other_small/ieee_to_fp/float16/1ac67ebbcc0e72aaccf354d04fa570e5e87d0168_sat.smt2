; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0000000100101101)))
(assert (not (bvule #b0000000100101111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b0011000111)
                expect
                (fp #b0 #b00000 #b0100101110)))
(assert (fp.leq (fp #b0 #b00000 #b0100101110)
                expect
                (fp #b0 #b10011 #b1011110011)))
; expect = 0.00001800060272216796875

(assert (= expect result))

(check-sat)
(exit)
