(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000000000000000)))
(assert (not (bvule #b1000000000000010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1100001100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00100 #b1111011000)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
