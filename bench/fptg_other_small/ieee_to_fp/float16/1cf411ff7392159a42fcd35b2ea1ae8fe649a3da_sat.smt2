(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0101101111111110)))
(assert (not (bvule #b0101110000000000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10000 #b0100010111)
                expect
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                expect
                (fp #b0 #b11001 #b1001001101)))
; expect = 255.875

(assert (= expect result))

(check-sat)
(exit)
