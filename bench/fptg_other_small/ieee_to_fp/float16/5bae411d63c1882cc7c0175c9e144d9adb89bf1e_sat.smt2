; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0010111010110100)))
(assert (not (bvule #b0010111010110110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01110 #b1100001000)
                expect
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                expect
                (fp #b0 #b10110 #b1100001100)))
; expect = 0.10479736328125

(assert (= expect result))

(check-sat)
(exit)
