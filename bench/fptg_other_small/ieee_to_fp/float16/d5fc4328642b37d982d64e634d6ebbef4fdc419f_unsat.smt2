; Format: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000000011111111)))
(assert (not (bvule #b1000000100000001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                expect
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                expect
                (fp #b0 #b10001 #b1110111101)))
; expect = -0.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
