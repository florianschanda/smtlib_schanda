(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000000010001100)))
(assert (not (bvule #b1000000010001110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                expect
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                expect
                (fp #b0 #b10011 #b0000000111)))
; expect = -0.000008404254913330078125

(assert (= expect result))

(check-sat)
(exit)
