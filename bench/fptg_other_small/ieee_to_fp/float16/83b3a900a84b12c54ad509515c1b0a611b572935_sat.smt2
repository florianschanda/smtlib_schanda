(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1101100101001110)))
(assert (not (bvule #b1101100101010000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101010011)
                expect
                (fp #b1 #b10110 #b0101001111)))
(assert (fp.leq (fp #b1 #b10110 #b0101001111)
                expect
                (fp #b0 #b10011 #b1100101100)))
; expect = -169.875

(assert (= expect result))

(check-sat)
(exit)
