; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000011101110101)))
(assert (not (bvule #b1000011101110111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0010010000)
                expect
                (fp #b1 #b00001 #b1101110110)))
(assert (fp.leq (fp #b1 #b00001 #b1101110110)
                expect
                (fp #b0 #b11001 #b1001111111)))
; expect = -0.00011384487152099609375

(assert (= expect result))

(check-sat)
(exit)
