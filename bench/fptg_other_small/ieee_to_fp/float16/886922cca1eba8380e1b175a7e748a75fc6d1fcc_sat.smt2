(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000101001100110)))
(assert (not (bvule #b1000101001101000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0000101100)
                expect
                (fp #b1 #b00010 #b1001100111)))
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                expect
                (fp #b0 #b01110 #b1011101010)))
; expect = -0.00019538402557373046875

(assert (= expect result))

(check-sat)
(exit)
