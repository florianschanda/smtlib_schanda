(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111011000101100)))
(assert (not (bvule #b1111011000101110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111100010)
                expect
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                expect
                (fp #b1 #b01011 #b1100001001)))
; expect = -25296.0

(assert (not (= expect result)))

(check-sat)
(exit)
