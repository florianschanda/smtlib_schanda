(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0010011111001101)))
(assert (not (bvule #b0010011111001111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00010 #b0111001110)
                expect
                (fp #b0 #b01001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01001 #b1111001110)
                expect
                (fp #b0 #b10111 #b1011010101)))
; expect = 0.030487060546875

(assert (= expect result))

(check-sat)
(exit)
