(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0000010001001001)))
(assert (not (bvule #b0000010001001011 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b1111101111)
                expect
                (fp #b0 #b00001 #b0001001010)))
(assert (fp.leq (fp #b0 #b00001 #b0001001010)
                expect
                (fp #b0 #b10001 #b0000110001)))
; expect = 0.00006544589996337890625

(assert (= expect result))

(check-sat)
(exit)
