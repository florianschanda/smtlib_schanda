; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0000000111111110)))
(assert (not (bvule #b0000001000000000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                expect
                (fp #b0 #b00000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000 #b0111111111)
                expect
                (fp #b0 #b11000 #b1010101100)))
; expect = 0.000030457973480224609375

(assert (not (= expect result)))

(check-sat)
(exit)
