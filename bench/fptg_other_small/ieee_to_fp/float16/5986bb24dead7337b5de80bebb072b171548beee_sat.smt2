(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0111001101000110)))
(assert (not (bvule #b0111001101001000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1001000010)
                expect
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                expect
                (fp #b0 #b11101 #b0100010111)))
; expect = 14904.0

(assert (= expect result))

(check-sat)
(exit)
