; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1101101111111110)))
(assert (not (bvule #b1101110000000000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                expect
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                expect
                (fp #b1 #b01111 #b1000100111)))
; expect = -255.875

(assert (not (= expect result)))

(check-sat)
(exit)
