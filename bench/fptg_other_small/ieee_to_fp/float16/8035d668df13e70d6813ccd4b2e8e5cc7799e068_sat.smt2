(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111100111011010)))
(assert (not (bvule #b1111100111011100 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1011011101)
                expect
                (fp #b1 #b11110 #b0111011011)))
(assert (fp.leq (fp #b1 #b11110 #b0111011011)
                expect
                (fp #b1 #b10010 #b1011000111)))
; expect = -47968.0

(assert (= expect result))

(check-sat)
(exit)
