(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0111001001010010)))
(assert (not (bvule #b0111001001010100 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1110001110)
                expect
                (fp #b0 #b11100 #b1001010011)))
(assert (fp.leq (fp #b0 #b11100 #b1001010011)
                expect
                (fp #b0 #b11100 #b1100010100)))
; expect = 12952.0

(assert (= expect result))

(check-sat)
(exit)
