(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1011110010001001)))
(assert (not (bvule #b1011110010001011 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                expect
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                expect
                (fp #b0 #b01000 #b0111111001)))
; expect = -1.134765625

(assert (not (= expect result)))

(check-sat)
(exit)
