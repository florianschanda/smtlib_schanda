(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011111111110011)))
(assert (not (bvule #b0011111111110101 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110000011)
                expect
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                expect
                (fp #b0 #b11110 #b1011101000)))
; expect = 1.98828125

(assert (not (= expect result)))

(check-sat)
(exit)
