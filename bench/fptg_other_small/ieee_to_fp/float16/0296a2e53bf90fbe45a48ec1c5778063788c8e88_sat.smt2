(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0101000010001101)))
(assert (not (bvule #b0101000010001111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b1001110101)
                expect
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                expect
                (fp #b0 #b10110 #b0111111001)))
; expect = 36.4375

(assert (= expect result))

(check-sat)
(exit)
