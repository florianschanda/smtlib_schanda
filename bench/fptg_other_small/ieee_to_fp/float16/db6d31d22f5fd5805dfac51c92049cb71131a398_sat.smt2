(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1011110100101111)))
(assert (not (bvule #b1011110100110001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1001011110)
                expect
                (fp #b1 #b01111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111 #b0100110000)
                expect
                (fp #b0 #b01000 #b1000111101)))
; expect = -1.296875

(assert (= expect result))

(check-sat)
(exit)
