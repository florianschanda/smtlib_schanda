(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1001000101100100)))
(assert (not (bvule #b1001000101100110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1001011101)
                expect
                (fp #b1 #b00100 #b0101100101)))
(assert (fp.leq (fp #b1 #b00100 #b0101100101)
                expect
                (fp #b0 #b11100 #b1110110110)))
; expect = -0.000658512115478515625

(assert (= expect result))

(check-sat)
(exit)
