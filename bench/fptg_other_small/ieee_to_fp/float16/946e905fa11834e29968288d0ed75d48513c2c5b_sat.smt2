(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1110011100010000)))
(assert (not (bvule #b1110011100010010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0011010010)
                expect
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                expect
                (fp #b1 #b00011 #b1110111100)))
; expect = -1809.0

(assert (= expect result))

(check-sat)
(exit)
