; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0110011101001111)))
(assert (not (bvule #b0110011101010001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0100001010)
                expect
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                expect
                (fp #b0 #b11010 #b1010000001)))
; expect = 1872.0

(assert (not (= expect result)))

(check-sat)
(exit)
