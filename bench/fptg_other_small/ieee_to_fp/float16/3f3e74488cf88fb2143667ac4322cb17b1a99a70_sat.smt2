; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000001110100000)))
(assert (not (bvule #b1000001110100010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1100011100)
                expect
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                expect
                (fp #b0 #b10111 #b1000000101)))
; expect = -0.000055372714996337890625

(assert (= expect result))

(check-sat)
(exit)
