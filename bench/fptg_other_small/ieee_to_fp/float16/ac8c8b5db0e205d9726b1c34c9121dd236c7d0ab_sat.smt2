(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0111001010000000)))
(assert (not (bvule #b0111001010000010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10001 #b0010011110)
                expect
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                expect
                (fp #b0 #b11100 #b1111110100)))
; expect = 13320.0

(assert (= expect result))

(check-sat)
(exit)
