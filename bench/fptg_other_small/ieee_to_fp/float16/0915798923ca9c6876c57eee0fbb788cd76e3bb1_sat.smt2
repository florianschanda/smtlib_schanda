(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0110110101100111)))
(assert (not (bvule #b0110110101101001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b0000001000)
                expect
                (fp #b0 #b11011 #b0101101000)))
(assert (fp.leq (fp #b0 #b11011 #b0101101000)
                expect
                (fp #b0 #b11110 #b1001110011)))
; expect = 5536.0

(assert (= expect result))

(check-sat)
(exit)
