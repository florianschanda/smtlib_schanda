(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1011110001011100)))
(assert (not (bvule #b1011110001011110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0101011000)
                expect
                (fp #b1 #b01111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111 #b0001011101)
                expect
                (fp #b1 #b01000 #b0000110110)))
; expect = -1.0908203125

(assert (= expect result))

(check-sat)
(exit)
