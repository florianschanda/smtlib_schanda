(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0111011000010001)))
(assert (not (bvule #b0111011000010011 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0101001111)
                expect
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                expect
                (fp #b0 #b11101 #b1000101100)))
; expect = 24864.0

(assert (= expect result))

(check-sat)
(exit)
