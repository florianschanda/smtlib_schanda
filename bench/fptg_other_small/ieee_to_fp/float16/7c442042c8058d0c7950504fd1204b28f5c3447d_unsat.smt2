; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000001111111111)))
(assert (not (bvule #b1000010000000001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                expect
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                expect
                (fp #b0 #b10011 #b1100111011)))
; expect = -0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
