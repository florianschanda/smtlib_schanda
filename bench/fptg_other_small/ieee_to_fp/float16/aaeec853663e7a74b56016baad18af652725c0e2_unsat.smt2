; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1101101000001101)))
(assert (not (bvule #b1101101000001111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                expect
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                expect
                (fp #b0 #b01101 #b1111101100)))
; expect = -193.75

(assert (not (= expect result)))

(check-sat)
(exit)
