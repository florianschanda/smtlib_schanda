; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0110011010000110)))
(assert (not (bvule #b0110011010001000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                expect
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                expect
                (fp #b0 #b11101 #b1100111000)))
; expect = 1671.0

(assert (not (= expect result)))

(check-sat)
(exit)
