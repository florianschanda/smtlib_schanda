(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1110111100111100)))
(assert (not (bvule #b1110111100111110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1110010010)
                expect
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                expect
                (fp #b0 #b00001 #b1000000100)))
; expect = -7412.0

(assert (= expect result))

(check-sat)
(exit)
