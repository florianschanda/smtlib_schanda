(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0010101011111000)))
(assert (not (bvule #b0010101011111010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1110001011)
                expect
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                expect
                (fp #b0 #b11010 #b0011100100)))
; expect = 0.054473876953125

(assert (= expect result))

(check-sat)
(exit)
