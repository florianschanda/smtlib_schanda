; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1110010110110000)))
(assert (not (bvule #b1110010110110010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110011011)
                expect
                (fp #b1 #b11001 #b0110110001)))
(assert (fp.leq (fp #b1 #b11001 #b0110110001)
                expect
                (fp #b0 #b11010 #b0100111011)))
; expect = -1457.0

(assert (not (= expect result)))

(check-sat)
(exit)
