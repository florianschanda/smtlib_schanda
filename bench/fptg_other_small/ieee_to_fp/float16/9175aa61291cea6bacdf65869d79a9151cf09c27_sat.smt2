(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0101011011001111)))
(assert (not (bvule #b0101011011010001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b0010001000)
                expect
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                expect
                (fp #b0 #b11011 #b1010001101)))
; expect = 109.0

(assert (= expect result))

(check-sat)
(exit)
