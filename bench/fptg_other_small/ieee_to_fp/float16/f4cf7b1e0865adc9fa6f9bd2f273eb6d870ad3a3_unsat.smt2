; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1110010000110000)))
(assert (not (bvule #b1110010000110010 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                expect
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                expect
                (fp #b0 #b01010 #b1100110000)))
; expect = -1073.0

(assert (not (= expect result)))

(check-sat)
(exit)
