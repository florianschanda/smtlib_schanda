(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0110011111110010)))
(assert (not (bvule #b0110011111110100 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b0110001000)
                expect
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                expect
                (fp #b0 #b11110 #b1001001010)))
; expect = 2035.0

(assert (= expect result))

(check-sat)
(exit)
