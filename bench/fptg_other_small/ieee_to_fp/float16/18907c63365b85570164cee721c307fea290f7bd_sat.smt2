(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +ONE

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011101111111111)))
(assert (not (bvule #b0011110000000001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00011 #b1010000011)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b10011 #b0001011100)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
