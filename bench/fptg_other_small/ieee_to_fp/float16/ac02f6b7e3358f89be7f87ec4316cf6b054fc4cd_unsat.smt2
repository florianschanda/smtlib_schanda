; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0000000011111111)))
(assert (not (bvule #b0000000100000001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1010010100)
                expect
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                expect
                (fp #b0 #b00010 #b1011110100)))
; expect = 0.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
