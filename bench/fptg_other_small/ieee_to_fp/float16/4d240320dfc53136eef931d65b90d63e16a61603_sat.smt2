(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1110101011001110)))
(assert (not (bvule #b1110101011010000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010101001)
                expect
                (fp #b1 #b11010 #b1011001111)))
(assert (fp.leq (fp #b1 #b11010 #b1011001111)
                expect
                (fp #b0 #b10100 #b0100101011)))
; expect = -3486.0

(assert (= expect result))

(check-sat)
(exit)
