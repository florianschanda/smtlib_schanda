(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011110111111101)))
(assert (not (bvule #b0011110111111111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1000110010)
                expect
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                expect
                (fp #b0 #b10101 #b1101000001)))
; expect = 1.498046875

(assert (= expect result))

(check-sat)
(exit)
