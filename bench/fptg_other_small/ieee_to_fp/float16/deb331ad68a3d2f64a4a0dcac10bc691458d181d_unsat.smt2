; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1110001100000101)))
(assert (not (bvule #b1110001100000111 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101100)
                expect
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                expect
                (fp #b0 #b10000 #b0000010110)))
; expect = -899.0

(assert (not (= expect result)))

(check-sat)
(exit)
