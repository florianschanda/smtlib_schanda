; Format: FLOAT16
; Arg1: +LARGEST_SUBNORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0000001111111110)))
(assert (not (bvule #b0000010000000000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00000 #b0111101110)
                expect
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                expect
                (fp #b0 #b11000 #b1001000011)))
; expect = 0.000060975551605224609375

(assert (not (= expect result)))

(check-sat)
(exit)
