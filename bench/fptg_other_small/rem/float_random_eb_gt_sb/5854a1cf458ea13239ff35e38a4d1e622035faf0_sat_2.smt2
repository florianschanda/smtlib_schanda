(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101100 #b00)
                arg1
                (fp #b0 #b011111 #b00)))
(assert (fp.leq (fp #b0 #b011111 #b00)
                arg1
                (fp #b0 #b100000 #b01)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011000 #b01)
                arg2
                (fp #b0 #b011111 #b11)))
(assert (fp.leq (fp #b0 #b011111 #b11)
                arg2
                (fp #b0 #b100011 #b11)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111010 #b00)
                expect
                (fp #b1 #b011110 #b10)))
(assert (fp.leq (fp #b1 #b011110 #b10)
                expect
                (fp #b0 #b110010 #b10)))
; expect = -0.75

(assert (= expect result))

(check-sat)
(exit)
