; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b100000 #b011)
                arg1
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg1
                (fp #b0 #b100100 #b100)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101010 #b111)
                arg2
                (fp #b1 #b011111 #b000)))
(assert (fp.leq (fp #b1 #b011111 #b000)
                arg2
                (fp #b0 #b111110 #b101)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011001 #b101)
                expect
                (fp #b0 #b000000 #b000)))
(assert (fp.leq (fp #b0 #b000000 #b000)
                expect
                (fp #b0 #b010011 #b010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
