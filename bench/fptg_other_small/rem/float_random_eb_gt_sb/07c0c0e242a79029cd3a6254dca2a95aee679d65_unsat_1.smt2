(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b1)
                arg1
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg1
                (fp #b0 #b10000 #b0)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01011 #b1)
                arg2
                (fp #b0 #b00000 #b0)))
(assert (fp.leq (fp #b0 #b00000 #b0)
                arg2
                (fp #b0 #b10001 #b0)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
