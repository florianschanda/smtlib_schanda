(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00001011 #b010)
                arg1
                (fp #b0 #b10000010 #b000)))
(assert (fp.leq (fp #b0 #b10000010 #b000)
                arg1
                (fp #b0 #b11100000 #b110)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10100001 #b001)
                expect
                (fp #b0 #b10000010 #b000)))
(assert (fp.leq (fp #b0 #b10000010 #b000)
                expect
                (fp #b0 #b11110000 #b101)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
