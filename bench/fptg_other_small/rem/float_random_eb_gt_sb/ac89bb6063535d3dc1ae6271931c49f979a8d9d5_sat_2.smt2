(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101011 #b111)
                arg1
                (fp #b1 #b011111 #b000)))
(assert (fp.leq (fp #b1 #b011111 #b000)
                arg1
                (fp #b1 #b011101 #b001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg2
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg2
                (fp #b0 #b111101 #b100)))
; arg2 = 16.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111000 #b010)
                expect
                (fp #b1 #b011111 #b000)))
(assert (fp.leq (fp #b1 #b011111 #b000)
                expect
                (fp #b0 #b000011 #b101)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
