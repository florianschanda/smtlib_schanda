; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110101 #b110)
                arg1
                (fp #b1 #b10000010 #b001)))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b00000111 #b100)))
; arg1 = -9.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101100 #b011)
                arg2
                (fp #b1 #b10000010 #b100)))
(assert (fp.leq (fp #b1 #b10000010 #b100)
                arg2
                (fp #b1 #b01111100 #b000)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b01000101 #b110)
                expect
                (fp #b0 #b10000000 #b100)))
(assert (fp.leq (fp #b0 #b10000000 #b100)
                expect
                (fp #b0 #b11010000 #b101)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
