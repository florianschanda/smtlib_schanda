                arg2
                (fp #b1 #b011111 #b00)))
(assert (fp.leq (fp #b1 #b011111 #b00)
                arg2
                (fp #b0 #b001011 #b10)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011110 #b01)
                expect
                (fp #b1 #b011101 #b00)))
(assert (fp.leq (fp #b1 #b011101 #b00)
                expect
                (fp #b1 #b011100 #b00)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
