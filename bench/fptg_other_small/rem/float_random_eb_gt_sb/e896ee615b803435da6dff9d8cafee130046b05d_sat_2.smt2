;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011111 #b11)
                arg1
                (fp #b1 #b011111 #b01)))
(assert (fp.leq (fp #b1 #b011111 #b01)
                arg1
                (fp #b0 #b000001 #b10)))
