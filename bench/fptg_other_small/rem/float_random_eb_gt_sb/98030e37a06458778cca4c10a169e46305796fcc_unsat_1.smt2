(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010001 #b110)
                arg1
                (fp #b1 #b10111111 #b000)))
(assert (fp.leq (fp #b1 #b10111111 #b000)
                arg1
                (fp #b1 #b00110000 #b000)))
; arg1 = -18446744073709551616.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11110001 #b111)
                arg2
                (fp #b1 #b00000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000 #b000)
                arg2
                (fp #b0 #b01100010 #b100)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
