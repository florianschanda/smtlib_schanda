; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg1
                (fp #b0 #b1001 #b10)))
(assert (fp.leq (fp #b0 #b1001 #b10)
                arg1
                (fp #b0 #b1100 #b00)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b00)
                arg2
                (fp #b1 #b0111 #b10)))
(assert (fp.leq (fp #b1 #b0111 #b10)
                arg2
                (fp #b0 #b1011 #b00)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011 #b00)
                expect
                (fp #b0 #b0000 #b00)))
(assert (fp.leq (fp #b0 #b0000 #b00)
                expect
                (fp #b0 #b0101 #b00)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
