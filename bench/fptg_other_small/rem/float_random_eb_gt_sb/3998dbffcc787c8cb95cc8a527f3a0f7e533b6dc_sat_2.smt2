(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1101 #b00)
                arg1
                (fp #b1 #b0000 #b00)))
(assert (fp.leq (fp #b1 #b0000 #b00)
                arg1
                (fp #b0 #b1100 #b01)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg2
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                arg2
                (fp #b0 #b1101 #b01)))
; arg2 = 0.00390625

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001 #b00)
                expect
                (fp #b1 #b0000 #b00)))
(assert (fp.leq (fp #b1 #b0000 #b00)
                expect
                (fp #b0 #b0000 #b01)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
