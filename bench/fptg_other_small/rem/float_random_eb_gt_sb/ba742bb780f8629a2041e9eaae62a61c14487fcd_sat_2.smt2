(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11011010 #b000)
                arg1
                (fp #b1 #b01110010 #b110)))
(assert (fp.leq (fp #b1 #b01110010 #b110)
                arg1
                (fp #b1 #b01001100 #b111)))
; arg1 = -0.000213623046875

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111010 #b101)
                arg2
                (fp #b0 #b01111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111 #b000)
                arg2
                (fp #b0 #b10110010 #b010)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11001100 #b000)
                expect
                (fp #b1 #b01110010 #b110)))
(assert (fp.leq (fp #b1 #b01110010 #b110)
                expect
                (fp #b0 #b10100101 #b001)))
; expect = -0.000213623046875

(assert (= expect result))

(check-sat)
(exit)
