; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111101 #b1)
                arg1
                (fp #b1 #b101000 #b1)))
(assert (fp.leq (fp #b1 #b101000 #b1)
                arg1
                (fp #b1 #b100010 #b0)))
; arg1 = -768.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100100 #b0)
                arg2
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                arg2
                (fp #b0 #b101100 #b1)))
; arg2 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011000 #b0)
                expect
                (fp #b1 #b000000 #b0)))
(assert (fp.leq (fp #b1 #b000000 #b0)
                expect
                (fp #b0 #b010001 #b1)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
