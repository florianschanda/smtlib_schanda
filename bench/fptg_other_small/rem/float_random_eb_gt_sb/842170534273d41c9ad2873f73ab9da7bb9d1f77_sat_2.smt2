(assert (fp.leq (fp #b1 #b1100110 #b11)
                expect
                (fp #b0 #b0000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000 #b00)
                expect
                (fp #b0 #b1111001 #b01)))
; expect = 0.0

(assert (= expect result))

