(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b101)
                arg2
                (fp #b1 #b10010 #b001)))
(assert (fp.leq (fp #b1 #b10010 #b001)
                arg2
                (fp #b0 #b00011 #b111)))
; arg2 = -9.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
