(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1000011 #b10)
                arg1
                (fp #b1 #b1000001 #b00)))
(assert (fp.leq (fp #b1 #b1000001 #b00)
                arg1
                (fp #b0 #b1111001 #b00)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1000110 #b00)
                arg2
                (fp #b1 #b0111111 #b00)))
(assert (fp.leq (fp #b1 #b0111111 #b00)
                arg2
                (fp #b0 #b0101000 #b00)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101011 #b10)
                expect
                (fp #b1 #b0000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000 #b00)
                expect
                (fp #b0 #b1111101 #b01)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
