; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111100 #b11)
                arg1
                (fp #b1 #b1000000 #b10)))
(assert (fp.leq (fp #b1 #b1000000 #b10)
                arg1
                (fp #b0 #b1101111 #b00)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111001 #b10)
                expect
                (fp #b1 #b1000000 #b10)))
(assert (fp.leq (fp #b1 #b1000000 #b10)
                expect
                (fp #b0 #b0111001 #b10)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
