(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000100 #b110)
                arg1
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg1
                (fp #b0 #b101110 #b110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010011 #b001)
                arg2
                (fp #b0 #b110111 #b010)))
(assert (fp.leq (fp #b0 #b110111 #b010)
                arg2
                (fp #b0 #b110111 #b101)))
; arg2 = 20971520.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010000 #b000)
                expect
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                expect
                (fp #b0 #b100101 #b010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
