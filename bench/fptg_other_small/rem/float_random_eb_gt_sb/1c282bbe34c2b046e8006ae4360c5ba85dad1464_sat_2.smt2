                arg2
                (fp #b1 #b00000 #b00)))
; arg2 = -0.0078125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11010 #b11)
                expect
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                expect
                (fp #b0 #b11101 #b10)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
