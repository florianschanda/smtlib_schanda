; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11100 #b111)
                arg1
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                arg1
                (fp #b0 #b11010 #b101)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10001 #b100)
                arg2
                (fp #b0 #b10100 #b101)))
(assert (fp.leq (fp #b0 #b10100 #b101)
                arg2
                (fp #b0 #b11010 #b100)))
; arg2 = 52.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11011 #b001)
                expect
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                expect
                (fp #b0 #b10100 #b001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
