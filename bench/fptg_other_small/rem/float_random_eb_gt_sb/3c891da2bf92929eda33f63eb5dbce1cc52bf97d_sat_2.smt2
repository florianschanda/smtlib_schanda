; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b00101110 #b0)
                arg1
                (fp #b0 #b11111110 #b1)))
(assert (fp.leq (fp #b0 #b11111110 #b1)
                arg1
                (fp #b0 #b11111111 #b0)))
; arg1 = 255211775190703847597530955573826158592.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001001 #b0)
                arg2
                (fp #b1 #b01111111 #b1)))
(assert (fp.leq (fp #b1 #b01111111 #b1)
                arg2
                (fp #b0 #b10110111 #b0)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100010 #b1)
                expect
                (fp #b0 #b00000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000 #b0)
                expect
                (fp #b0 #b10011001 #b1)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
