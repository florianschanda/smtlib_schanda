;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111101 #b11000)
                arg1
                (fp #b1 #b11111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000)
                arg1
                (fp #b1 #b11111010 #b10001)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111101 #b11011)
                expect
                (fp #b1 #b11111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000)
                expect
                (fp #b1 #b00001101 #b00100)))
; expect = -85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
