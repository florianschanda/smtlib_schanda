; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0011111001)
                arg1
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg1
                (fp #b0 #b10100 #b0000111111)))
; arg1 = -1.98828125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0011100111)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b1110010001)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b1100101011)
                expect
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                expect
                (fp #b1 #b00110 #b0110101100)))
; expect = -1.98828125

(assert (= expect result))

(check-sat)
(exit)
