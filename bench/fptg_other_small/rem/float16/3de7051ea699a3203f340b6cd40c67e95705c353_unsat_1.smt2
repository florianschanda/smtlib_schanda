(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0000101011)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b11011 #b0100111011)))
; arg1 = -1809.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1001101100)
                arg2
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg2
                (fp #b0 #b01001 #b1011100000)))
; arg2 = 0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01111 #b1001000110)
                expect
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                expect
                (fp #b0 #b01010 #b1110000001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
