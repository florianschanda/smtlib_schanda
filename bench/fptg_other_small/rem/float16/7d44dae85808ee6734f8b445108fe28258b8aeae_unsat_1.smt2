(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1010001000)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b01000 #b0000000101)))
; arg1 = 0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0011001110)
                arg2
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg2
                (fp #b0 #b11000 #b0110111111)))
; arg2 = -0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11001 #b0000101111)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b10111 #b0111010001)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
