                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b01111 #b1110100110)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0001110001)
                expect
                (fp #b1 #b00000 #b0001111100)))
(assert (fp.leq (fp #b1 #b00000 #b0001111100)
                expect
                (fp #b0 #b00010 #b0001101010)))
; expect = -0.0000073909759521484375

(assert (= expect result))

(check-sat)
(exit)
