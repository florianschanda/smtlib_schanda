(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0011010111)
                arg1
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg1
                (fp #b1 #b01110 #b0111100000)))
; arg1 = -1.98828125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00010 #b0010110110)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b11000 #b1111010100)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b0111110000)
                expect
                (fp #b1 #b00000 #b0010010010)))
(assert (fp.leq (fp #b1 #b00000 #b0010010010)
                expect
                (fp #b0 #b01001 #b0001100010)))
; expect = -0.00000870227813720703125

(assert (= expect result))

(check-sat)
(exit)
