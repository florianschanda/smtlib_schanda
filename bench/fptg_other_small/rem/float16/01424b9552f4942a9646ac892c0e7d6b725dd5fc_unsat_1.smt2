(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10100 #b0110100111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11010 #b0001111101)))
; arg1 = 255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1001000110)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b00001 #b0101111011)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0100110111)
                expect
                (fp #b0 #b00000 #b0100000100)))
(assert (fp.leq (fp #b0 #b00000 #b0100000100)
                expect
                (fp #b0 #b10100 #b0101010010)))
; expect = 0.0000154972076416015625

(assert (not (= expect result)))

(check-sat)
(exit)
