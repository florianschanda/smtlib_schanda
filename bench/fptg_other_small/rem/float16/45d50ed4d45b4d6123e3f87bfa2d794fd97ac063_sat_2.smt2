(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b1001110001)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11011 #b1111011111)))
; arg1 = 551.5

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0001101000)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b01110 #b1001110111)))
; arg2 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100 #b1101011011)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b10110 #b0001101001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
