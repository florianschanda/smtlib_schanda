                arg2
                (fp #b0 #b10110 #b1101100100)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0101010100)
                expect
                (fp #b1 #b00000 #b0011111011)))
(assert (fp.leq (fp #b1 #b00000 #b0011111011)
                expect
                (fp #b0 #b10100 #b0101001100)))
; expect = -0.000014960765838623046875

(assert (not (= expect result)))

(check-sat)
(exit)
