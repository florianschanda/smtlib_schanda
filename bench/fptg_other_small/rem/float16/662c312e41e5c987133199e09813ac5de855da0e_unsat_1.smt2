(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010001110)
                arg1
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg1
                (fp #b0 #b00101 #b1100100001)))
; arg1 = 0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1000001010)
                arg2
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg2
                (fp #b0 #b01101 #b1011000000)))
; arg2 = 0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0110001100)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b11011 #b0111000001)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
