(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +ONE
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00111 #b0111101110)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b10110 #b0001100001)))
; arg1 = 1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0010101000)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11101 #b0010111001)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01100 #b0010000111)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b10101 #b1110000100)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
