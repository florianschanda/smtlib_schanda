; Format: FLOAT16
; Arg1: +ONE
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0111000110)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b11101 #b1110001100)))
; arg1 = 1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1100000110)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b10111 #b0010101001)))
; arg2 = 0.000244140625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01111 #b0111110000)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b01000 #b0111101101)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
