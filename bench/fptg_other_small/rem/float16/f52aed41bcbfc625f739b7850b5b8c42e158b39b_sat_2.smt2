(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1010100000)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b10100 #b1011010110)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01001 #b1011010010)
                arg2
                (fp #b0 #b01111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111 #b0010110101)
                arg2
                (fp #b0 #b11001 #b0000101100)))
; arg2 = 1.1767578125

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001101000)
                expect
                (fp #b1 #b01110 #b0000100110)))
(assert (fp.leq (fp #b1 #b01110 #b0000100110)
                expect
                (fp #b0 #b00000 #b0000010010)))
; expect = -0.5185546875

(assert (= expect result))

(check-sat)
(exit)
