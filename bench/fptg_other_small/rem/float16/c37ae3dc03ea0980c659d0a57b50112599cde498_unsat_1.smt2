                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b01111 #b1010100101)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1000101111)
                expect
                (fp #b1 #b00000 #b0100011000)))
(assert (fp.leq (fp #b1 #b00000 #b0100011000)
                expect
                (fp #b0 #b00001 #b1001010001)))
; expect = -0.000016689300537109375

(assert (not (= expect result)))

(check-sat)
(exit)
