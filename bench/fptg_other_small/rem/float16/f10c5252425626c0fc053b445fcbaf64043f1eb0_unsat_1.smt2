; Format: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01101 #b1001100001)
                arg1
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg1
                (fp #b0 #b11000 #b0100001111)))
; arg1 = -0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1101111100)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b11100 #b1001101010)))
; arg2 = 0.000244140625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b0101011010)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10011 #b0001101111)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
