; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000011010)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b01100 #b1001001100)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0111100000)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b10111 #b1111100001)))
; arg2 = 0.000244140625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1010000111)
                expect
                (fp #b0 #b00000 #b1000000000)))
(assert (fp.leq (fp #b0 #b00000 #b1000000000)
                expect
                (fp #b0 #b01110 #b0011100001)))
; expect = 0.000030517578125

(assert (not (= expect result)))

(check-sat)
(exit)
