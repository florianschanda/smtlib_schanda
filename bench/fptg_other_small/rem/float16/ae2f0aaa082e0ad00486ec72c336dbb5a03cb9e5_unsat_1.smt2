; Format: FLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00100 #b0011100011)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1010000100)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b00010 #b1100101100)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b1110101000)
                expect
                (fp #b1 #b00111 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111 #b0000000000)
                expect
                (fp #b0 #b00101 #b1001101100)))
; expect = -0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
