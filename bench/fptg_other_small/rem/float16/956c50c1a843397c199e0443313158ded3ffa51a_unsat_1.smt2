(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0101010110)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b1 #b01010 #b1001100101)))
; arg1 = -264.0

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01000 #b1011010101)
                arg2
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg2
                (fp #b0 #b10101 #b0100010110)))
; arg2 = 0.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
