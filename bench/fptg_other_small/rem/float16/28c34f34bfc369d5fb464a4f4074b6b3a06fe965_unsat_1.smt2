                (fp #b1 #b00001 #b1010100010)))
(assert (fp.leq (fp #b1 #b00001 #b1010100010)
                arg2
                (fp #b0 #b11001 #b1010000010)))
; arg2 = -0.00010120868682861328125

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b0001001000)
                expect
                (fp #b0 #b00000 #b0110001100)))
(assert (fp.leq (fp #b0 #b00000 #b0110001100)
                expect
                (fp #b0 #b11001 #b0010101011)))
; expect = 0.0000236034393310546875

(assert (not (= expect result)))

(check-sat)
