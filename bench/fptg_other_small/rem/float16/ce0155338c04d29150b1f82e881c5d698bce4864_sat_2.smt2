                arg2
                (fp #b1 #b10110 #b1000111001)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00110 #b0110001001)
                expect
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                expect
                (fp #b0 #b10111 #b0011100000)))
; expect = 1.3701171875

(assert (= expect result))

(check-sat)
