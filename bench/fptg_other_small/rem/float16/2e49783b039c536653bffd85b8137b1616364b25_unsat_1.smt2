; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10100 #b0000011111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11001 #b1100111001)))
; arg1 = 255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1111001000)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b1 #b00010 #b1111111010)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1001111001)
                expect
                (fp #b0 #b01001 #b1010000000)))
(assert (fp.leq (fp #b0 #b01001 #b1010000000)
                expect
                (fp #b0 #b11101 #b1110000000)))
; expect = 0.025390625

(assert (not (= expect result)))

(check-sat)
(exit)
