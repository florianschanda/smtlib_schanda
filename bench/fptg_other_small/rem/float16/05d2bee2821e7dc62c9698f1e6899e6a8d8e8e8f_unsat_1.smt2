(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1001110001)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11110 #b0111000000)))
; arg1 = 13320.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0001011001)
                arg2
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg2
                (fp #b0 #b11100 #b1100101000)))
; arg2 = 0.00006103515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000 #b0100011011)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b01100 #b0111010000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
