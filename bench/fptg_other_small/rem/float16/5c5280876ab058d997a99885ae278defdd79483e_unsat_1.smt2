                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b11011 #b1001110011)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b0000011011)
                expect
                (fp #b0 #b01101 #b1110101000)))
(assert (fp.leq (fp #b0 #b01101 #b1110101000)
                expect
                (fp #b0 #b10011 #b1010110111)))
; expect = 0.478515625

(assert (not (= expect result)))

(check-sat)
(exit)
