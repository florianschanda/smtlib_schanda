                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b10110 #b1011001100)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0010100100)
                expect
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                expect
                (fp #b0 #b01101 #b1100010100)))
; expect = 0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
