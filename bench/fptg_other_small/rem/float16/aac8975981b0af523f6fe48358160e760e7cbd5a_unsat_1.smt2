; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b1101010011)
                expect
                (fp #b0 #b00000 #b0010110111)))
(assert (fp.leq (fp #b0 #b00000 #b0010110111)
                expect
                (fp #b0 #b10000 #b1111111111)))
; expect = 0.000010907649993896484375

(assert (not (= expect result)))

