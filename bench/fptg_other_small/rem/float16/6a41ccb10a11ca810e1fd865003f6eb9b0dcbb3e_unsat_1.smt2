                arg2
                (fp #b0 #b10000 #b1111011111)))
; arg2 = 1.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b1110101001)
                expect
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                expect
                (fp #b0 #b10110 #b1001111110)))
; expect = -0.000060975551605224609375

(assert (not (= expect result)))

(check-sat)
(exit)
