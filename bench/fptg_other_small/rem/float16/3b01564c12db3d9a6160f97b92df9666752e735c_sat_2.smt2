(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000001100)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b1 #b01010 #b1101011101)))
; arg1 = -933.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1111001000)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b10110 #b0000111010)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b0000010001)
                expect
                (fp #b0 #b00000 #b0110000110)))
(assert (fp.leq (fp #b0 #b00000 #b0110000110)
                expect
                (fp #b0 #b10010 #b1100101100)))
; expect = 0.00002324581146240234375

(assert (= expect result))

(check-sat)
(exit)
