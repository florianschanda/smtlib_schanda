                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b1 #b00000 #b1100000100)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1001001011)
                expect
                (fp #b0 #b00000 #b0010001010)))
(assert (fp.leq (fp #b0 #b00000 #b0010001010)
                expect
                (fp #b0 #b11011 #b1110100100)))
; expect = 0.00000822544097900390625

(assert (not (= expect result)))

(check-sat)
(exit)
