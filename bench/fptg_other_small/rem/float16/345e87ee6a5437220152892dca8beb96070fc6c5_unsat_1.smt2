(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00110 #b0101100000)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0110001111)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0000010010)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b0 #b00110 #b0000110001)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1011111100)
                expect
                (fp #b1 #b01101 #b0111000000)))
(assert (fp.leq (fp #b1 #b01101 #b0111000000)
                expect
                (fp #b1 #b01101 #b0011011000)))
; expect = -0.359375

(assert (not (= expect result)))

(check-sat)
(exit)
