; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0101110000)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11101 #b0011111010)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1011010010)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b11000 #b1010001111)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01110 #b0110110110)
                expect
                (fp #b0 #b01101 #b0100101000)))
(assert (fp.leq (fp #b0 #b01101 #b0100101000)
                expect
                (fp #b0 #b10100 #b1101000011)))
; expect = 0.322265625

(assert (not (= expect result)))

(check-sat)
(exit)
