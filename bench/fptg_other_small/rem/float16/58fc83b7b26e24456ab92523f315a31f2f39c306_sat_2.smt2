(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1111001101)
                arg1
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg1
                (fp #b0 #b01011 #b1010010100)))
; arg1 = 0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10001 #b0011111111)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b01110 #b0100010000)))
; arg2 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b0010100010)
                expect
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                expect
                (fp #b0 #b10000 #b1000110011)))
; expect = 0.000244140625

(assert (= expect result))

(check-sat)
(exit)
