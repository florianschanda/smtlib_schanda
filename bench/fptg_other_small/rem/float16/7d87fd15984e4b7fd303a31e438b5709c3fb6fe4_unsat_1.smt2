(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +NAN
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101100001)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b1 #b00010 #b0100011111)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
