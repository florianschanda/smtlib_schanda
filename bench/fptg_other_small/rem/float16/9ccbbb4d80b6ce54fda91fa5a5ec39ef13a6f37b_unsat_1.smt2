; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001101100)
                expect
                (fp #b0 #b00000 #b0010100000)))
(assert (fp.leq (fp #b0 #b00000 #b0010100000)
                expect
                (fp #b0 #b00111 #b1111010000)))
; expect = 0.0000095367431640625

(assert (not (= expect result)))

