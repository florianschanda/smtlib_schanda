(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0011010111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11101 #b0000000001)))
; arg1 = 255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0110110000)
                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b00011 #b0001001100)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1110011110)
                expect
                (fp #b1 #b00000 #b0000011111)))
(assert (fp.leq (fp #b1 #b00000 #b0000011111)
                expect
                (fp #b0 #b10001 #b1100011111)))
; expect = -0.000001847743988037109375

(assert (= expect result))

(check-sat)
(exit)
