(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1000111001)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11000 #b0000010100)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0111111111)
                arg2
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b0 #b11101 #b0011100001)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b0011001001)
                expect
                (fp #b1 #b01110 #b0000001100)))
(assert (fp.leq (fp #b1 #b01110 #b0000001100)
                expect
                (fp #b0 #b01111 #b1100011101)))
; expect = -0.505859375

(assert (= expect result))

(check-sat)
(exit)
