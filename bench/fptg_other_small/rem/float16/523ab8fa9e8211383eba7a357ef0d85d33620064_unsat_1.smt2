                arg2
                (fp #b1 #b00110 #b1001111111)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1010111000)
                expect
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                expect
                (fp #b0 #b11000 #b1000001011)))
; expect = 0.0000045299530029296875

(assert (not (= expect result)))

(check-sat)
