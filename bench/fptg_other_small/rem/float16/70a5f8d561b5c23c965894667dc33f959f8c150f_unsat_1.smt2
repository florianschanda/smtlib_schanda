(assert (fp.leq (fp #b1 #b11001 #b0000110110)
                expect
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                expect
                (fp #b1 #b00110 #b0010100100)))
; expect = -0.0024929046630859375

(assert (not (= expect result)))

