(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00100 #b1000001101)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11010 #b0110010100)))
; arg1 = 1671.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00010 #b0000101001)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11010 #b0100101101)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1011011001)
                expect
                (fp #b1 #b10111 #b0111101100)))
(assert (fp.leq (fp #b1 #b10111 #b0111101100)
                expect
                (fp #b0 #b01101 #b1110001100)))
; expect = -379.0

(assert (= expect result))

(check-sat)
(exit)
