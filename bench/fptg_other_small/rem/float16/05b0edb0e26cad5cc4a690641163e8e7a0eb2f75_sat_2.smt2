(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01011 #b1001100110)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11110 #b0110000100)))
; arg1 = 1872.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1000001111)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b01000 #b1100011101)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1000001011)
                expect
                (fp #b0 #b00000 #b0100011101)))
(assert (fp.leq (fp #b0 #b00000 #b0100011101)
                expect
                (fp #b0 #b11000 #b1000111000)))
; expect = 0.000016987323760986328125

(assert (= expect result))

(check-sat)
(exit)
