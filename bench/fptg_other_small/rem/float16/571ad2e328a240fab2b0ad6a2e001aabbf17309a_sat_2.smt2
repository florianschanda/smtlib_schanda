(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b1000001001)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b10100 #b1001111110)))
; arg1 = 1.3701171875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001011000)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b1 #b00011 #b0010001110)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0100111010)
                expect
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                expect
                (fp #b0 #b11100 #b1111101001)))
; expect = 1.3701171875

(assert (= expect result))

(check-sat)
(exit)
