(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00111 #b1001010011)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b01100 #b0111010101)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101101101)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11010 #b0011100100)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b1011010111)
                expect
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                expect
                (fp #b0 #b11110 #b1001010001)))
; expect = 0.054473876953125

(assert (= expect result))

(check-sat)
(exit)
