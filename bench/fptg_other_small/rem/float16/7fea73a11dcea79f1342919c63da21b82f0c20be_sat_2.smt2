(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00101 #b0000100011)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11011 #b0011100101)))
; arg1 = 1671.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0011101111)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b10001 #b0100010000)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1110001000)
                expect
                (fp #b1 #b00000 #b0011111100)))
(assert (fp.leq (fp #b1 #b00000 #b0011111100)
                expect
                (fp #b0 #b01011 #b0001111000)))
; expect = -0.0000150203704833984375

(assert (= expect result))

(check-sat)
(exit)
