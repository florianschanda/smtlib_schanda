(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b1100000100)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00001 #b0011010101)))
; arg1 = 0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00101 #b0110110011)
                arg2
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg2
                (fp #b1 #b00000 #b1111110000)))
; arg2 = -0.00006103515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b0101110100)
                expect
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                expect
                (fp #b0 #b01011 #b1111111011)))
; expect = 0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
