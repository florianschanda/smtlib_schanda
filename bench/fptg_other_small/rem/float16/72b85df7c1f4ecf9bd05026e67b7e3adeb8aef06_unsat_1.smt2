                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b11100 #b0011100101)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0000001010)
                expect
                (fp #b1 #b00000 #b0100010100)))
(assert (fp.leq (fp #b1 #b00000 #b0100010100)
                expect
                (fp #b0 #b00000 #b0000010100)))
; expect = -0.0000164508819580078125

(assert (not (= expect result)))

(check-sat)
