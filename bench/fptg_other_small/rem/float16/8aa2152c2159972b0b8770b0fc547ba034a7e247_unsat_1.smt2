(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111000100)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b1 #b00101 #b0111101000)))
; arg1 = -16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0000011110)
                arg2
                (fp #b0 #b00000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                arg2
                (fp #b0 #b00001 #b1111001100)))
; arg2 = 0.000006973743438720703125

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b0100101011)
                expect
                (fp #b1 #b00000 #b0000000100)))
(assert (fp.leq (fp #b1 #b00000 #b0000000100)
                expect
                (fp #b0 #b11101 #b1110001101)))
; expect = -0.0000002384185791015625

(assert (not (= expect result)))

(check-sat)
(exit)
