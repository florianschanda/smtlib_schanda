(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111100111)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b11001 #b1000001000)))
; arg1 = 1.3701171875

(declare-const arg2 Float16)
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
