(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00111 #b0101011001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11001 #b1100111010)))
; arg1 = 1671.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0011100101)
                arg2
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg2
                (fp #b0 #b10100 #b0111101100)))
; arg2 = -0.00006103515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10101 #b0000111010)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b11000 #b0100001101)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
