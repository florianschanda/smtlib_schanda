(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0011010011)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b1 #b10010 #b1111110001)))
; arg1 = -2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0101110110)
                arg2
                (fp #b1 #b00001 #b1010100010)))
(assert (fp.leq (fp #b1 #b00001 #b1010100010)
                arg2
                (fp #b0 #b10000 #b0110001010)))
; arg2 = -0.00010120868682861328125

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b1111100000)
                expect
                (fp #b1 #b00000 #b0100101110)))
(assert (fp.leq (fp #b1 #b00000 #b0100101110)
                expect
                (fp #b0 #b10001 #b0011110000)))
; expect = -0.00001800060272216796875

(assert (not (= expect result)))

(check-sat)
(exit)
