; Format: FLOAT16
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1011110100)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b0 #b01010 #b1100110001)))
; arg1 = -1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b1100011011)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b11100 #b1100101111)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000001011)
                expect
                (fp #b1 #b01011 #b0110000000)))
(assert (fp.leq (fp #b1 #b01011 #b0110000000)
                expect
                (fp #b1 #b00111 #b0111011011)))
; expect = -0.0859375

(assert (not (= expect result)))

(check-sat)
(exit)
