; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b0101111100)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11001 #b1011011000)))
; arg1 = 1671.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0101000100)
                arg2
                (fp #b0 #b01011 #b0000100001)))
(assert (fp.leq (fp #b0 #b01011 #b0000100001)
                arg2
                (fp #b0 #b01011 #b0110010000)))
; arg2 = 0.06451416015625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0100000110)
                expect
                (fp #b0 #b01001 #b0011001100)))
(assert (fp.leq (fp #b0 #b01001 #b0011001100)
                expect
                (fp #b0 #b01100 #b1101111011)))
; expect = 0.01873779296875

(assert (not (= expect result)))

(check-sat)
(exit)
