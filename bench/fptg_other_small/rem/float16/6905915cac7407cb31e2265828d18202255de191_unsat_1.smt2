                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b01011 #b0111010000)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0110001100)
                expect
                (fp #b0 #b01011 #b1000000000)))
(assert (fp.leq (fp #b0 #b01011 #b1000000000)
                expect
                (fp #b0 #b01011 #b1100110100)))
; expect = 0.09375

(assert (not (= expect result)))

(check-sat)
(exit)
