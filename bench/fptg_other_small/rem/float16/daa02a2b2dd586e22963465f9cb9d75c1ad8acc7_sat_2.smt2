(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00100 #b1100100001)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0100110001)))
; arg1 = 2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0001010111)
                arg2
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                arg2
                (fp #b1 #b00110 #b0101101101)))
; arg2 = -646.0

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01110 #b1111011111)
                expect
                (fp #b0 #b10101 #b1011100000)))
(assert (fp.leq (fp #b0 #b10101 #b1011100000)
                expect
                (fp #b0 #b10101 #b1110011100)))
; expect = 110.0

(assert (= expect result))

(check-sat)
(exit)
