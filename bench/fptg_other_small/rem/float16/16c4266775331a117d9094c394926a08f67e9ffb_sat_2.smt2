(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0010110010)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b1 #b10011 #b1100010110)))
; arg1 = -3788.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b0100111011)
                arg2
                (fp #b0 #b01011 #b0000100001)))
(assert (fp.leq (fp #b0 #b01011 #b0000100001)
                arg2
                (fp #b0 #b01111 #b0111000110)))
; arg2 = 0.06451416015625

(declare-const result Float16)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00000 #b1101011110)
                expect
                (fp #b0 #b01000 #b1011100000)))
(assert (fp.leq (fp #b0 #b01000 #b1011100000)
                expect
                (fp #b0 #b10011 #b0111010011)))
; expect = 0.013427734375

(assert (= expect result))

(check-sat)
(exit)
