(assert (fp.leq (fp #b1 #b01001 #b1010111011)
                expect
                (fp #b0 #b00000 #b0001110111)))
(assert (fp.leq (fp #b0 #b00000 #b0001110111)
                expect
                (fp #b0 #b01001 #b1110100010)))
; expect = 0.000007092952728271484375

(assert (= expect result))

