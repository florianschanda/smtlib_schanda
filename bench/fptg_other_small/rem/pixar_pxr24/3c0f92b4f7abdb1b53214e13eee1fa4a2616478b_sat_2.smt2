(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b101001011000000)
                expect
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                expect
                (fp #b1 #b00101110 #b001110011010010)))
; expect = -48335.0

(assert (= expect result))

(check-sat)
(exit)
