; Format: PIXAR_PXR24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b100010011001111)
                arg1
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                arg1
                (fp #b0 #b10111000 #b000001010111001)))
; arg1 = -18446462598732840960.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
