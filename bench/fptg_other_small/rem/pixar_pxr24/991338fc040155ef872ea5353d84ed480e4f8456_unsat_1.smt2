; Format: PIXAR_PXR24
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110100 #b100001001101010)
                arg2
                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                arg2
                (fp #b0 #b10011011 #b010000101100011)))
; arg2 = -1.317169189453125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
