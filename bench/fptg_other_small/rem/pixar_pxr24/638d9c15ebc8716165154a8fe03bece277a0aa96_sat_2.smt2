(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111100 #b001100010010010)
                expect
                (fp #b1 #b11110110 #b011010110000111)))
(assert (fp.leq (fp #b1 #b11110110 #b011010110000111)
                expect
                (fp #b0 #b11111100 #b001010010100110)))
; expect = -942543856691296776271252714512449536.0

(assert (= expect result))

(check-sat)
(exit)
