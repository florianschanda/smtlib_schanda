(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010111 #b0100000000110111)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b1 #b0110110 #b1000000111110001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
