(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000010 #b0000110001110001)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1101001 #b1100110000110000)))
; arg1 = 26078.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1101100 #b0111011101111111)
                arg2
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b1011110 #b0011001011110010)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
