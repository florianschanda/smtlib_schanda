(assert (fp.leq (fp #b1 #b0001101 #b1100011110011010)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0010011 #b0010101000101001)))
; expect = -0

(assert (= expect result))

