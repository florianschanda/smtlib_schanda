; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1000101111010011)
                arg1
                (fp #b1 #b1010101 #b0001001101010100)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010100)
                arg1
                (fp #b0 #b0100111 #b1101100110111101)))
; arg1 = -4510976.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001011 #b1010100100110010)
                arg2
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b1010110 #b0101100000000011)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001111 #b0110100101000100)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1010110 #b1111010111110010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
