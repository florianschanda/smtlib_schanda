(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b1101110010000101)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b0100011 #b0100010100000010)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
