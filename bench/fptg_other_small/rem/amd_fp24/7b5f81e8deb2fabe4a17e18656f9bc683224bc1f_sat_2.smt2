(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001101 #b0110110001100010)
                expect
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                expect
                (fp #b0 #b1101000 #b1101010010111001)))
; expect = 26078.0

(assert (= expect result))

(check-sat)
(exit)
