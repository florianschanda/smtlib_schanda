                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg2
                (fp #b1 #b001 #b1001)))
; arg2 = -15.5

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101 #b0010)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b100 #b0001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
