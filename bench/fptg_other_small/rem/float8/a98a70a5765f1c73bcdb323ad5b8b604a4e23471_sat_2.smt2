(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0000)
                arg1
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg1
                (fp #b0 #b101 #b0001)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010 #b1011)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b101 #b0000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
