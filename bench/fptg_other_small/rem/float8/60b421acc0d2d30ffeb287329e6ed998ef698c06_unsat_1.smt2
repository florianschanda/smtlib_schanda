; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1001)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b001 #b1111)))
; arg1 = -0.046875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg2
                (fp #b1 #b110 #b1000)))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg2
                (fp #b1 #b011 #b1111)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0111)
                expect
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                expect
                (fp #b0 #b000 #b1010)))
; expect = -0.046875

(assert (not (= expect result)))

(check-sat)
(exit)
