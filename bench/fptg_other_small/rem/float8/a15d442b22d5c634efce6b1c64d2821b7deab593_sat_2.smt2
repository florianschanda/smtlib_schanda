(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0100)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b100 #b1000)))
; arg1 = -0.046875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1001)
                arg2
                (fp #b0 #b011 #b0000)))
(assert (fp.leq (fp #b0 #b011 #b0000)
                arg2
                (fp #b0 #b110 #b0101)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1010)
                expect
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                expect
                (fp #b0 #b101 #b1100)))
; expect = -0.046875

(assert (= expect result))

(check-sat)
(exit)
