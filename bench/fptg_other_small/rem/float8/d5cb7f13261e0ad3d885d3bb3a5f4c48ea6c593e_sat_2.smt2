(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1111)
                arg1
                (fp #b0 #b000 #b0100)))
(assert (fp.leq (fp #b0 #b000 #b0100)
                arg1
                (fp #b0 #b101 #b1000)))
; arg1 = 0.0625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100 #b1100)
                arg2
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg2
                (fp #b0 #b110 #b1000)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
