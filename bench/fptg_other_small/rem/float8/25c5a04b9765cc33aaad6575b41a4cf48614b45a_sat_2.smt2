; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1011)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b1 #b001 #b1110)))
; arg1 = -1.625

