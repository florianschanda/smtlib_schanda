                arg2
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg2
                (fp #b0 #b111 #b0000)))
; arg2 = 15.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0110)
                expect
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                expect
                (fp #b0 #b010 #b1101)))
; expect = -1.625

(assert (= expect result))

(check-sat)
(exit)
