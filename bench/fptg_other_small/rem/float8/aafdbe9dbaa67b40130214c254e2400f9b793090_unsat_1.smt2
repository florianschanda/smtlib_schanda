(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -ZERO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000 #b0100)
                arg1
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1011)
                arg2
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                arg2
                (fp #b0 #b011 #b0001)))
; arg2 = 0.015625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b010 #b0110)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
