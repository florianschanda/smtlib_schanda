(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b1 #b011 #b0000)))
(assert (fp.leq (fp #b1 #b011 #b0000)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1011)
                arg2
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg2
                (fp #b0 #b110 #b1011)))
; arg2 = -0.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000 #b0100)
                expect
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b101 #b0010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
