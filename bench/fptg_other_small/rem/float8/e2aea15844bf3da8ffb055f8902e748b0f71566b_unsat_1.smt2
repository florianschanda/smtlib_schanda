; Format: FLOAT8
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg1
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                arg1
                (fp #b0 #b001 #b0111)))
; arg1 = 0.015625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1000)
                arg2
                (fp #b1 #b011 #b0110)))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg2
                (fp #b1 #b000 #b0101)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0000)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b1101)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
