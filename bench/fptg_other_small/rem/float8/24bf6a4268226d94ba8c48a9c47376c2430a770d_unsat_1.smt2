                arg2
                (fp #b0 #b100 #b0110)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b001 #b1000)
                expect
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                expect
                (fp #b0 #b110 #b0101)))
; expect = 0.8125

(assert (not (= expect result)))

(check-sat)
(exit)
