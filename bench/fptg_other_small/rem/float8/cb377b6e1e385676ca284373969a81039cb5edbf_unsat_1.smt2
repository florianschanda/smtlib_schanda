(assert (fp.leq (fp #b1 #b110 #b1110)
                arg2
                (fp #b1 #b000 #b1001)))
; arg2 = -15.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                expect
                (fp #b0 #b101 #b0110)))
(assert (fp.leq (fp #b0 #b101 #b0110)
                expect
                (fp #b0 #b101 #b0111)))
; expect = 5.5

(assert (not (= expect result)))

(check-sat)
(exit)
