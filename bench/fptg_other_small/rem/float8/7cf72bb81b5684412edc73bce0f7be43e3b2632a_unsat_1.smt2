(assert (fp.leq (fp #b1 #b101 #b1010)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b010 #b1011)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
