(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0101110 #b0011000)
                arg1
                (fp #b1 #b0000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000)
                arg1
                (fp #b0 #b1110111 #b0000110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 8))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0000010 #b1000100)
                expect
                (fp #b1 #b0000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000)
                expect
                (fp #b0 #b1010101 #b1001101)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
