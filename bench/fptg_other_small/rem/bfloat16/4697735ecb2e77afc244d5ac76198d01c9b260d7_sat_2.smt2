; Format: BFLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001001 #b0011010)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11000101 #b1000011)))
; arg1 = -256.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101100 #b1011101)
                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b10100000 #b0111100)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011111 #b0011010)
                expect
                (fp #b0 #b10000000 #b0000000)))
(assert (fp.leq (fp #b0 #b10000000 #b0000000)
                expect
                (fp #b0 #b11111100 #b0001101)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
