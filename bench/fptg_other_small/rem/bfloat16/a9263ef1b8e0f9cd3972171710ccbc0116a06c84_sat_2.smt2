                (fp #b1 #b01111101 #b1101000)))
(assert (fp.leq (fp #b1 #b01111101 #b1101000)
                expect
                (fp #b1 #b00001101 #b1001101)))
; expect = -0.453125

(assert (= expect result))

(check-sat)
