; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b1010101)
                arg1
                (fp #b1 #b01111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111 #b0101111)
                arg1
                (fp #b0 #b00111001 #b1101001)))
