                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                expect
                (fp #b0 #b01100100 #b1011010)))
; expect = -0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

