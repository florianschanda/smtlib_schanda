                (fp #b0 #b11010100 #b0111101)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010101 #b0001000)
                expect
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                expect
                (fp #b0 #b10010110 #b0101000)))
; expect = 59.75

(assert (not (= expect result)))

(check-sat)
