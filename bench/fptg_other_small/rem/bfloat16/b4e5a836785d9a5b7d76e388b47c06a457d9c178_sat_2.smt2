(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b1100111)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b1 #b01111010 #b0010100)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000000 #b1011100)
                expect
                (fp #b0 #b01111101 #b0000000)))
(assert (fp.leq (fp #b0 #b01111101 #b0000000)
                expect
                (fp #b0 #b10000101 #b0110111)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
