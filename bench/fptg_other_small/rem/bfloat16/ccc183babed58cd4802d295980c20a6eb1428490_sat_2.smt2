(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg2
                (fp #b0 #b10010100 #b1001111)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
