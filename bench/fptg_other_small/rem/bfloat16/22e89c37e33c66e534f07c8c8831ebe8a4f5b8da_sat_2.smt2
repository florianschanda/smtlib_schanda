;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101001 #b0110000)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
