                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b0 #b11000000 #b0110110)))
; arg2 = -522272047294030513416641720614912.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000011 #b1111110)
                expect
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                expect
                (fp #b0 #b00011110 #b1011000)))
; expect = -134.0

(assert (= expect result))

(check-sat)
(exit)
