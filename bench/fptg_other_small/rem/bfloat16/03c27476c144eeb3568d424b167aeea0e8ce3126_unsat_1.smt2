; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010100 #b0110010)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b11110110 #b1110110)))
; arg1 = 86.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110010 #b0000100)
                expect
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                expect
                (fp #b0 #b10110010 #b1000011)))
; expect = 86.0

(assert (not (= expect result)))

(check-sat)
(exit)
