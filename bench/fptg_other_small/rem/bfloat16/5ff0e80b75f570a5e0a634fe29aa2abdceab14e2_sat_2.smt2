                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b1 #b00001000 #b0011010)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011100 #b0011111)
                expect
                (fp #b0 #b01111100 #b0010000)))
(assert (fp.leq (fp #b0 #b01111100 #b0010000)
                expect
                (fp #b0 #b11111011 #b0010011)))
; expect = 0.140625

(assert (= expect result))

(check-sat)
(exit)
