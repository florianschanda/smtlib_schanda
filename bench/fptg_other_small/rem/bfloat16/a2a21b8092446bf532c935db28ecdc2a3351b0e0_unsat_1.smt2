(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0111101)
                expect
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                expect
                (fp #b1 #b01011001 #b0011001)))
; expect = -70116776777654312295675822429788176384.0

(assert (not (= expect result)))

