                arg2
                (fp #b1 #b00010001 #b1101100)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001111 #b0011101)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b00010100 #b0010101)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
