; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10000001 #b0010010)
                arg1
                (fp #b0 #b11001001 #b0100010)))
(assert (fp.leq (fp #b0 #b11001001 #b0100010)
                arg1
                (fp #b0 #b11110000 #b1011001)))
