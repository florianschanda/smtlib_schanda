                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b10001000 #b1111000)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100000 #b0101011)
                expect
                (fp #b1 #b01111100 #b1000000)))
(assert (fp.leq (fp #b1 #b01111100 #b1000000)
                expect
                (fp #b1 #b01111100 #b0100110)))
; expect = -0.1875

(assert (= expect result))

(check-sat)
(exit)
