(assert (fp.leq (fp #b1 #b10000101 #b0100101)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b11110111 #b0000011)))
; expect = 0.0

(assert (not (= expect result)))

