; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110010 #b0111111)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b11010001 #b1000111)))
; arg1 = 30.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100000 #b1001100)
                arg2
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                arg2
                (fp #b0 #b11111111 #b0000000)))
; arg2 = 338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b0111110)
                expect
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                expect
                (fp #b0 #b10001011 #b1111100)))
; expect = 30.0

(assert (= expect result))

(check-sat)
(exit)
