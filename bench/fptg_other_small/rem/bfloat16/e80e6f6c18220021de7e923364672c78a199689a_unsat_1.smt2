(assert (fp.leq (fp #b1 #b10110110 #b1011011)
                expect
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                expect
                (fp #b0 #b01001101 #b0110101)))
; expect = -134.0

(assert (not (= expect result)))

