(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Arg1: -INT_BOUNDARY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b1)))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg1
                (fp #b1 #b00 #b1)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg2
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg2
                (fp #b1 #b00 #b0)))
; arg2 = -0.5

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b1 #b00 #b0)))
(assert (fp.leq (fp #b1 #b00 #b0)
                expect
                (fp #b0 #b01 #b0)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
