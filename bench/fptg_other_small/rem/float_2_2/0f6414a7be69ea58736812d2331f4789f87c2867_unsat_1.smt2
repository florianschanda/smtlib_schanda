(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_2_2
; Arg1: +ZERO
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b0 #b00 #b0)))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 2 2))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
