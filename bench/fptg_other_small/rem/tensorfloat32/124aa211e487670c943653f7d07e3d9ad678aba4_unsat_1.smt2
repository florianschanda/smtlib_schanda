                arg2
                (fp #b0 #b00100111 #b1001010010)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100001 #b1100111000)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b10000110 #b1110110001)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
