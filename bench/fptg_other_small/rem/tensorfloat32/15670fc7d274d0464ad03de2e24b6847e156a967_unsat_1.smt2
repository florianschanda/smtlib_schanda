(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +INFINITY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010010 #b0011000100)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b10011011 #b1100110011)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
