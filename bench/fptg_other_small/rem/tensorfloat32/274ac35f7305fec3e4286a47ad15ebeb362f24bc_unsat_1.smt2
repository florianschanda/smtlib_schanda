                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b0 #b11111101 #b0010011000)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001010 #b0100101101)
                expect
                (fp #b1 #b10000110 #b0001111000)))
(assert (fp.leq (fp #b1 #b10000110 #b0001111000)
                expect
                (fp #b1 #b01010000 #b0011111000)))
; expect = -143.0

(assert (not (= expect result)))

(check-sat)
(exit)
