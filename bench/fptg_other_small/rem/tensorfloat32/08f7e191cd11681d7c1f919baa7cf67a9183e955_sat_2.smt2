(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011111 #b0011000100)
                expect
                (fp #b0 #b11010101 #b1001011001)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011001)
                expect
                (fp #b0 #b11011000 #b1110111100)))
; expect = 122781528554610775556096000.0

(assert (= expect result))

(check-sat)
(exit)
