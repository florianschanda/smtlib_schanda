; Format: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010100 #b0111010000)
                arg1
                (fp #b0 #b11010101 #b1001011001)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011001)
                arg1
                (fp #b0 #b11101110 #b0000010100)))
