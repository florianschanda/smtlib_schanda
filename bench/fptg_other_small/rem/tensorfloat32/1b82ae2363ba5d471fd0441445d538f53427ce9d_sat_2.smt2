(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010011 #b1110010011)
                arg1
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                arg1
                (fp #b0 #b10100110 #b1000010011)))
; arg1 = 1671.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11001110 #b0000110000)
                arg2
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b11011000 #b1000100110)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
