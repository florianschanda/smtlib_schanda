; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
