(assert (fp.leq (fp #b1 #b11100001 #b1000010111)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b01110010 #b0101110010)))
; expect = 0.0

(assert (= expect result))

(check-sat)
