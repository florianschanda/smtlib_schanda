(assert (fp.leq (fp #b1 #b01000001 #b1111111011)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00110001 #b1110100100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
