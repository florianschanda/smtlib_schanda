(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b11100100 #b1110110101)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000111 #b1011010000)
                expect
                (fp #b1 #b01111100 #b1010000000)))
(assert (fp.leq (fp #b1 #b01111100 #b1010000000)
                expect
                (fp #b0 #b11101101 #b1010000011)))
; expect = -0.203125

(assert (= expect result))

(check-sat)
(exit)
