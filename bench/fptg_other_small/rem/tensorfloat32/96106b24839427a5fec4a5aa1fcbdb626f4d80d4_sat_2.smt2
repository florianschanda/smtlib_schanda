                arg2
                (fp #b1 #b01000011 #b1101101111)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010011 #b1111100011)
                expect
                (fp #b0 #b01111010 #b0111000000)))
(assert (fp.leq (fp #b0 #b01111010 #b0111000000)
                expect
                (fp #b0 #b10111100 #b0001100101)))
; expect = 0.044921875

(assert (= expect result))

(check-sat)
