(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10010100 #b0011110010)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b10101110 #b0011101100)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010111 #b1011000100)
                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11011010 #b0000000110)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00010010 #b1111111111)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b11111110 #b1000001000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
