(assert (fp.leq (fp #b1 #b10101 #b1000)
                expect
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                expect
                (fp #b0 #b01110 #b1010)))
; expect = -0

