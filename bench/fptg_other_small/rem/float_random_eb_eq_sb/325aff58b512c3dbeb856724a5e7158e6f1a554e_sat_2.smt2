(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b1010 #b100)
                arg1
                (fp #b0 #b1101 #b000)))
(assert (fp.leq (fp #b0 #b1101 #b000)
                arg1
                (fp #b0 #b1101 #b110)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0110 #b011)
                expect
                (fp #b0 #b1101 #b000)))
(assert (fp.leq (fp #b0 #b1101 #b000)
                expect
                (fp #b0 #b1110 #b000)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
