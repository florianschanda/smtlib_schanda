                arg2
                (fp #b0 #b101 #b00)))
(assert (fp.leq (fp #b0 #b101 #b00)
                arg2
                (fp #b0 #b110 #b01)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                expect
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                expect
                (fp #b0 #b101 #b11)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
