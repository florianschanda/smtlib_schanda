;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b11)
                arg1
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                arg1
                (fp #b0 #b011 #b00)))
; arg1 = 0.125

