; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b011 #b11)))
(assert (fp.leq (fp #b0 #b011 #b11)
                arg1
                (fp #b0 #b101 #b01)))
; arg1 = 1.75

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg2
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg2
                (fp #b0 #b010 #b10)))
; arg2 = -0.5

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b00)
                expect
                (fp #b1 #b001 #b00)))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b0 #b100 #b10)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
