; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b10011)
                arg1
                (fp #b1 #b111000 #b10110)))
(assert (fp.leq (fp #b1 #b111000 #b10110)
                arg1
                (fp #b1 #b110101 #b01100)))
; arg1 = -56623104.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b00010)
                expect
                (fp #b1 #b111000 #b10110)))
(assert (fp.leq (fp #b1 #b111000 #b10110)
                expect
                (fp #b0 #b111011 #b10100)))
; expect = -56623104.0

(assert (= expect result))

(check-sat)
(exit)
