                arg2
                (fp #b0 #b100000 #b10000)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100011 #b10011)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b101110 #b00100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
