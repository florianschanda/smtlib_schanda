; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b100)
                arg1
                (fp #b0 #b1011 #b010)))
(assert (fp.leq (fp #b0 #b1011 #b010)
                arg1
                (fp #b0 #b1101 #b110)))
; arg1 = 20.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg2
                (fp #b1 #b1110 #b010)))
(assert (fp.leq (fp #b1 #b1110 #b010)
                arg2
                (fp #b0 #b1110 #b010)))
; arg2 = -160.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b100)
                expect
                (fp #b0 #b1011 #b010)))
(assert (fp.leq (fp #b0 #b1011 #b010)
                expect
                (fp #b0 #b1110 #b110)))
; expect = 20.0

(assert (= expect result))

(check-sat)
(exit)
