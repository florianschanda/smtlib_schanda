(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b00)
                arg1
                (fp #b1 #b001 #b00)))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b10)))
; arg1 = -0.25

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b10)
                expect
                (fp #b1 #b001 #b00)))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b0 #b011 #b11)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
