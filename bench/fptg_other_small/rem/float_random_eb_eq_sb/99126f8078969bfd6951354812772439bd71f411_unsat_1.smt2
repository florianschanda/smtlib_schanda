; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b111000)
                arg1
                (fp #b1 #b1000101 #b110111)))
(assert (fp.leq (fp #b1 #b1000101 #b110111)
                arg1
                (fp #b1 #b0000011 #b000001)))
; arg1 = -119.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100001 #b110011)
                expect
                (fp #b1 #b1000101 #b110111)))
(assert (fp.leq (fp #b1 #b1000101 #b110111)
                expect
                (fp #b1 #b0110111 #b101111)))
; expect = -119.0

(assert (not (= expect result)))

(check-sat)
(exit)
