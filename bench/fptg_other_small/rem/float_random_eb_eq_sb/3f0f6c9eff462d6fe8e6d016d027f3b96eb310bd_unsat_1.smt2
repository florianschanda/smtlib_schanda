(assert (fp.leq (fp #b1 #b0110001 #b000111)
                arg2
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                arg2
                (fp #b0 #b0100101 #b001101)))
; arg2 = -0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
