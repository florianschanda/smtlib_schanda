(assert (fp.leq (fp #b1 #b0111 #b101)
                arg2
                (fp #b1 #b0101 #b110)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b000)
                expect
                (fp #b0 #b0010 #b101)))
(assert (fp.leq (fp #b0 #b0010 #b101)
                expect
                (fp #b0 #b1000 #b100)))
; expect = 0.05078125

(assert (= expect result))

(check-sat)
(exit)
