(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101010 #b100000)
                arg1
                (fp #b1 #b0111111 #b111101)))
(assert (fp.leq (fp #b1 #b0111111 #b111101)
                arg1
                (fp #b0 #b1000100 #b001100)))
; arg1 = -1.953125

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110101 #b110000)
                expect
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                expect
                (fp #b0 #b1110111 #b110100)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
