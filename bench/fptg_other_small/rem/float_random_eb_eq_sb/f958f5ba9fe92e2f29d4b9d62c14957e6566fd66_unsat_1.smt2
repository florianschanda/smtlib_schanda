(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011111 #b11011)
                expect
                (fp #b0 #b011111 #b10111)))
(assert (fp.leq (fp #b0 #b011111 #b10111)
                expect
                (fp #b0 #b110011 #b11110)))
; expect = 1.71875

(assert (not (= expect result)))

(check-sat)
(exit)
