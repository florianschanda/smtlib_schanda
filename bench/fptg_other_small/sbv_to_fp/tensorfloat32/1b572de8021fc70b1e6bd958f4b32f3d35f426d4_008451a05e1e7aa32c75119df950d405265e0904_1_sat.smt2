;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01111110)))
(assert (not (bvule #b10000000 arg1)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110101 #b0110100011)
                expect
                (fp #b0 #b10000101 #b1111110000)))
(assert (fp.leq (fp #b0 #b10000101 #b1111110000)
                expect
                (fp #b0 #b10110101 #b1011100100)))
; expect = 127.0

(assert (= expect result))

(check-sat)
(exit)
