(assert (not (bvule #b10000000000000011 arg1)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b1100101000)
                expect
                (fp #b1 #b10001111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b0000000000)
                expect
                (fp #b1 #b01000001 #b0000000001)))
; expect = -65536.0

(assert (= expect result))

(check-sat)
(exit)
