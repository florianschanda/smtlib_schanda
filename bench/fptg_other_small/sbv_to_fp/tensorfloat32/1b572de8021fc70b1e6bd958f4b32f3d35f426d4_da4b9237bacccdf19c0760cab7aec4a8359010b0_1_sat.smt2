;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b001)))
(assert (not (bvule #b011 arg1)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001000 #b1110101000)
                expect
                (fp #b0 #b10000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b0000000000)
                expect
                (fp #b0 #b11100100 #b0111110011)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
