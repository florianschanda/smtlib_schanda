(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 6))
(assert (not (bvule arg1 #b011101)))
(assert (not (bvule #b011111 arg1)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011101 #b1010)
                expect
                (fp #b0 #b100011 #b1110)))
(assert (fp.leq (fp #b0 #b100011 #b1110)
                expect
                (fp #b0 #b110011 #b0101)))
; expect = 30.0

(assert (= expect result))

(check-sat)
