(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: 127

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01111110)))
(assert (not (bvule #b10000000 arg1)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b000001 #b1010)
                expect
                (fp #b0 #b100101 #b1111)))
(assert (fp.leq (fp #b0 #b100101 #b1111)
                expect
                (fp #b0 #b101011 #b0111)))
; expect = 124.0

(assert (= expect result))

(check-sat)
(exit)
