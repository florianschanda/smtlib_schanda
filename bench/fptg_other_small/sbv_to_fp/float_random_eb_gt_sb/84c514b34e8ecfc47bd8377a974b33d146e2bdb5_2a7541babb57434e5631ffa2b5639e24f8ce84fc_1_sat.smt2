; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: 130

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ BitVec 9))
(assert (not (bvule arg1 #b010000001)))
(assert (not (bvule #b010000011 arg1)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100011 #b0111)
                expect
                (fp #b0 #b100110 #b0000)))
(assert (fp.leq (fp #b0 #b100110 #b0000)
                expect
                (fp #b0 #b111110 #b1000)))
; expect = 128.0

(assert (= expect result))

(check-sat)
(exit)
