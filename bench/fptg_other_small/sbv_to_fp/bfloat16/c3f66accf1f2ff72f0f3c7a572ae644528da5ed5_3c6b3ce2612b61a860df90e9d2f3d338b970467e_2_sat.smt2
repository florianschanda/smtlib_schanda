(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -32767

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000000000000000)))
(assert (not (bvule #b1000000000000010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001111 #b1001000)
                expect
                (fp #b1 #b10001110 #b0000000)))
(assert (fp.leq (fp #b1 #b10001110 #b0000000)
                expect
                (fp #b1 #b01110010 #b0010100)))
; expect = -32768.0

(assert (= expect result))

(check-sat)
(exit)
