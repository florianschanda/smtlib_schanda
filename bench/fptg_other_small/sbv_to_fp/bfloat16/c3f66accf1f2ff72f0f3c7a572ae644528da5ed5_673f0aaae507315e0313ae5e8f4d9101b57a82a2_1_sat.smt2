; Format: BFLOAT16
; Arg1: -127

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10000000)))
(assert (not (bvule #b10000010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b1011101)
                expect
                (fp #b1 #b10000101 #b1111110)))
(assert (fp.leq (fp #b1 #b10000101 #b1111110)
                expect
                (fp #b0 #b11101010 #b0101011)))
; expect = -127.0

(assert (= expect result))

(check-sat)
(exit)
