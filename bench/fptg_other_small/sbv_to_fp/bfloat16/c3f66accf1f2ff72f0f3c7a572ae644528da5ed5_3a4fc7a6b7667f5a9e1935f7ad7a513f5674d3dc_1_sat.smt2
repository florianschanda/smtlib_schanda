; Format: BFLOAT16
; Arg1: -65537

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ BitVec 18))
(assert (not (bvule arg1 #b101111111111111110)))
(assert (not (bvule #b110000000000000000 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101100 #b0111011)
                expect
                (fp #b1 #b10001111 #b0000000)))
(assert (fp.leq (fp #b1 #b10001111 #b0000000)
                expect
                (fp #b0 #b01011000 #b0001101)))
; expect = -65536.0

(assert (= expect result))

(check-sat)
(exit)
