(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110000 #b1101010)
                expect
                (fp #b1 #b10000110 #b0000000)))
(assert (fp.leq (fp #b1 #b10000110 #b0000000)
                expect
                (fp #b0 #b01111000 #b1111000)))
; expect = -128.0

(assert (= expect result))

