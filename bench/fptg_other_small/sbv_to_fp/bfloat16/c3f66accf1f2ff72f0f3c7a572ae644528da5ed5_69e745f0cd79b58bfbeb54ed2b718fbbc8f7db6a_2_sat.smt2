(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -65535

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ BitVec 17))
(assert (not (bvule arg1 #b10000000000000000)))
(assert (not (bvule #b10000000000000010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010001 #b0010010)
                expect
                (fp #b1 #b10001111 #b0000000)))
(assert (fp.leq (fp #b1 #b10001111 #b0000000)
                expect
                (fp #b0 #b00000101 #b0011001)))
; expect = -65536.0

(assert (= expect result))

(check-sat)
(exit)
