;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b101)))
(assert (not (bvule #b111 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101111 #b1100000)
                expect
                (fp #b1 #b10000000 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000 #b0000000)
                expect
                (fp #b0 #b10100000 #b1100011)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
