; Format: BFLOAT16
; Arg1: -111

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10010000)))
(assert (not (bvule #b10010010 arg1)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111000 #b0010100)
                expect
                (fp #b1 #b10000101 #b1011110)))
(assert (fp.leq (fp #b1 #b10000101 #b1011110)
                expect
                (fp #b0 #b11110101 #b1110000)))
; expect = -111.0

(assert (= expect result))

(check-sat)
(exit)
