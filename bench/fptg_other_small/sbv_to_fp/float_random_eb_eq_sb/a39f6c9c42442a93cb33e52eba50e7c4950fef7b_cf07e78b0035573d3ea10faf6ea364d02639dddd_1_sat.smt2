(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -111

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10010000)))
(assert (not (bvule #b10010010 arg1)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                expect
                (fp #b1 #b1101 #b101)))
(assert (fp.leq (fp #b1 #b1101 #b101)
                expect
                (fp #b1 #b1000 #b001)))
; expect = -104.0

(assert (= expect result))

(check-sat)
(exit)
