; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -77

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10110010)))
(assert (not (bvule #b10110100 arg1)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b010)
                expect
                (fp #b1 #b1101 #b010)))
(assert (fp.leq (fp #b1 #b1101 #b010)
                expect
                (fp #b0 #b0011 #b100)))
; expect = -80.0

(assert (= expect result))

(check-sat)
(exit)
