(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -127

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10000000)))
(assert (not (bvule #b10000010 arg1)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100110 #b010010111100100)
                expect
                (fp #b1 #b10000101 #b111111000000000)))
(assert (fp.leq (fp #b1 #b10000101 #b111111000000000)
                expect
                (fp #b0 #b01010010 #b111110110101000)))
; expect = -127.0

(assert (= expect result))

(check-sat)
(exit)
