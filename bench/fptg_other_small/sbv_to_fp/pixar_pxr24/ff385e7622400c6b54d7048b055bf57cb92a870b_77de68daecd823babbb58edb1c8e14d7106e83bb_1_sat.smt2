; Format: PIXAR_PXR24
; Arg1: 3

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b010)))
(assert (not (bvule #b100 arg1)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101010 #b111101111011011)
                expect
                (fp #b0 #b10000000 #b100000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b100000000000000)
                expect
                (fp #b0 #b10110110 #b100111111100010)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
