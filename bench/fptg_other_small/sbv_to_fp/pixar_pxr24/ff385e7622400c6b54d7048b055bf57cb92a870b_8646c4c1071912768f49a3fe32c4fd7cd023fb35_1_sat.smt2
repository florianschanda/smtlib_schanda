                expect
                (fp #b1 #b10000110 #b111111100000000)))
(assert (fp.leq (fp #b1 #b10000110 #b111111100000000)
                expect
                (fp #b0 #b11101101 #b110010100111100)))
; expect = -255.0

(assert (= expect result))

