(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -2049

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ BitVec 13))
(assert (not (bvule arg1 #b1011111111110)))
(assert (not (bvule #b1100000000000 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0010000010)
                expect
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                expect
                (fp #b1 #b11001 #b0001001010)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
