(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -3

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b100)))
(assert (not (bvule #b110 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1001011101)
                expect
                (fp #b1 #b10000 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000 #b1000000000)
                expect
                (fp #b1 #b01001 #b1010111111)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
