; Format: FLOAT16
; Arg1: -256

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 10))
(assert (not (bvule arg1 #b1011111111)))
(assert (not (bvule #b1100000001 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1100101100)
                expect
                (fp #b1 #b10111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111 #b0000000000)
                expect
                (fp #b1 #b00010 #b0111110011)))
; expect = -256.0

(assert (not (= expect result)))

(check-sat)
(exit)
