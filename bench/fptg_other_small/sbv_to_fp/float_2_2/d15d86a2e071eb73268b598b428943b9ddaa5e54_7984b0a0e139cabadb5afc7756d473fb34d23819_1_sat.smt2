; Format: FLOAT_2_2
; Arg1: -1

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 2))
(assert (not (bvule arg1 #b10)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b01 #b0)))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b1 #b00 #b0)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
