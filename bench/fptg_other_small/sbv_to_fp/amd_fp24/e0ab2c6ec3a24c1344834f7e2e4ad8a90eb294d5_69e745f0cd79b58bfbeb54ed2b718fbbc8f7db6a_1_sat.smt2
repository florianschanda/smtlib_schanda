                (fp #b1 #b1001110 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1111111111111110)
                expect
                (fp #b0 #b1001000 #b0000000001100011)))
; expect = -65535.0

(assert (= expect result))

