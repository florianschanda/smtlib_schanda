; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: 2

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b001)))
(assert (not (bvule #b011 arg1)))

(declare-const result (_ FloatingPoint 8 12))
(assert (= result ((_ to_fp 8 12) rm arg1)))

(declare-const expect (_ FloatingPoint 8 12))
(assert (fp.leq (fp #b0 #b01000100 #b01010100100)
                expect
                (fp #b0 #b10000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b00000000000)
                expect
                (fp #b0 #b10000101 #b00011001101)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
