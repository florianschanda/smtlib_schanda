; Format: PIXAR_PXR24
; Arg1: 4294967295

; Redundancy: False
; Validation for: UBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b11111111111111111111111111111110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp_unsigned 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101101 #b110001100001000)
                expect
                (fp #b0 #b10011110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10011110 #b111111111111111)
                expect
                (fp #b0 #b11100100 #b000110101001111)))
; expect = 4294901760.0

(assert (= expect result))

(check-sat)
(exit)
