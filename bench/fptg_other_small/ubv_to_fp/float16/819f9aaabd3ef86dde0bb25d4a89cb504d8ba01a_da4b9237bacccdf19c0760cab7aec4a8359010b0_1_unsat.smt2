; Format: FLOAT16
; Arg1: 2

; Redundancy: False
; Validation for: UBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 2))
(assert (not (bvule arg1 #b01)))
(assert (not (bvule #b11 arg1)))

(declare-const result Float16)
(assert (= result ((_ to_fp_unsigned 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0110111000)
                expect
                (fp #b0 #b10000 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000 #b0000000000)
                expect
                (fp #b0 #b11011 #b1010100011)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
