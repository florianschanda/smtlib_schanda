(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b100100 #b0010)
                expect
                (fp #b0 #b100110 #b0000)))
(assert (fp.leq (fp #b0 #b100110 #b0000)
                expect
                (fp #b0 #b101010 #b1110)))
; expect = 128.0

(assert (= expect result))

(check-sat)
