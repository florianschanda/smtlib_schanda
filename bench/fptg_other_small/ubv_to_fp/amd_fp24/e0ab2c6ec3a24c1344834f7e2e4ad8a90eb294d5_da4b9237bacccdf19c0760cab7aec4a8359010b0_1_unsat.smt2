(assert (fp.leq (fp #b1 #b0110111 #b1101000100011001)
                expect
                (fp #b0 #b1000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b0000000000000000)
                expect
                (fp #b0 #b1001111 #b0111001100001100)))
; expect = 2.0

