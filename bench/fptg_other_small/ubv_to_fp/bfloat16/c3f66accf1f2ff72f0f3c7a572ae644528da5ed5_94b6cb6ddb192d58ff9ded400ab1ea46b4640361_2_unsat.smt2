(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b0010011)
                expect
                (fp #b0 #b10001111 #b0000000)))
(assert (fp.leq (fp #b0 #b10001111 #b0000000)
                expect
                (fp #b0 #b11001001 #b0011000)))
; expect = 65536.0

(assert (not (= expect result)))

(check-sat)
