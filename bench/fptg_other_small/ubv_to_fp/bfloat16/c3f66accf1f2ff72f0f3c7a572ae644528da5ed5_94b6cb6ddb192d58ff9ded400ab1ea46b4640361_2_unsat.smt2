(assert (not (= rm RTZ)))

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111111111111101)))
(assert (not (bvule #b1111111111111111 arg1)))

(declare-const result (_ FloatingPoint 8 8))
