; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: 128

; Redundancy: False
; Validation for: UBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b01111111)))
(assert (not (bvule #b10000001 arg1)))

(declare-const result (_ FloatingPoint 8 12))
(assert (= result ((_ to_fp_unsigned 8 12) rm arg1)))

(declare-const expect (_ FloatingPoint 8 12))
(assert (fp.leq (fp #b1 #b10010011 #b11110100110)
                expect
                (fp #b0 #b10000110 #b00000000000)))
(assert (fp.leq (fp #b0 #b10000110 #b00000000000)
                expect
                (fp #b0 #b10011101 #b10101110100)))
; expect = 128.0

(assert (= expect result))

(check-sat)
(exit)
