;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110101 #b101001101001110)
                arg1
                (fp #b1 #b01111110 #b001011010100111)))
(assert (fp.leq (fp #b1 #b01111110 #b001011010100111)
                arg1
                (fp #b1 #b01000110 #b001010011101000)))
; arg1 = -0.5884857177734375

(declare-const result (_ FloatingPoint 8 16))
