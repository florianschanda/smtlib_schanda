; arg1 = -104.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                expect
                (fp #b1 #b1101 #b101)))
(assert (fp.leq (fp #b1 #b1101 #b101)
                expect
                (fp #b1 #b0010 #b001)))
; expect = -104.0

(assert (= expect result))

(check-sat)
(exit)
