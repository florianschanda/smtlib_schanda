; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg1
                (fp #b1 #b000 #b11)))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b000 #b00)))
; arg1 = -0.1875

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100 #b00)
                expect
                (fp #b1 #b000 #b00)))
(assert (fp.leq (fp #b1 #b000 #b00)
                expect
                (fp #b0 #b010 #b00)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
