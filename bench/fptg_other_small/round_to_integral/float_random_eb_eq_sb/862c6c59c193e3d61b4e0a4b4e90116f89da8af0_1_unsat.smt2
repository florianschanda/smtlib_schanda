(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg1
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg1
                (fp #b0 #b101 #b00)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010 #b01)
                expect
                (fp #b1 #b000 #b00)))
(assert (fp.leq (fp #b1 #b000 #b00)
                expect
                (fp #b0 #b001 #b01)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
