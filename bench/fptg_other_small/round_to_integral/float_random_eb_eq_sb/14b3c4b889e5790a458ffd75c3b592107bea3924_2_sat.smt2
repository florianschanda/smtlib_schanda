(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001010 #b00101)
                arg1
                (fp #b0 #b010011 #b10010)))
(assert (fp.leq (fp #b0 #b010011 #b10010)
                arg1
