(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b01111)
                expect
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                expect
                (fp #b0 #b100011 #b11101)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
