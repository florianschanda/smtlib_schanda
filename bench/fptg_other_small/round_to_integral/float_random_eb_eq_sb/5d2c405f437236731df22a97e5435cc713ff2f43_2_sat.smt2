(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg1
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.0625

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b10)
                expect
                (fp #b0 #b011 #b00)))
(assert (fp.leq (fp #b0 #b011 #b00)
                expect
                (fp #b0 #b110 #b01)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
