;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg1
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg1
                (fp #b1 #b01010 #b0)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11110 #b0)
                expect
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                expect
                (fp #b0 #b11011 #b0)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
