; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000111 #b0)
                arg1
                (fp #b0 #b011111 #b1)))
(assert (fp.leq (fp #b0 #b011111 #b1)
                arg1
                (fp #b0 #b100100 #b1)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001011 #b1)
                expect
                (fp #b0 #b100000 #b0)))
(assert (fp.leq (fp #b0 #b100000 #b0)
                expect
                (fp #b0 #b110110 #b0)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
