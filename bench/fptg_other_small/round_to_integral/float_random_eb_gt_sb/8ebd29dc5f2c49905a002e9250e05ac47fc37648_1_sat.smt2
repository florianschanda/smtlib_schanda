;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b10)
                arg1
                (fp #b1 #b1010 #b10)))
(assert (fp.leq (fp #b1 #b1010 #b10)
                arg1
                (fp #b0 #b0111 #b11)))
; arg1 = -12.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b00)
                expect
                (fp #b1 #b1010 #b10)))
(assert (fp.leq (fp #b1 #b1010 #b10)
                expect
                (fp #b0 #b1010 #b10)))
; expect = -12.0

(assert (= expect result))

(check-sat)
(exit)
