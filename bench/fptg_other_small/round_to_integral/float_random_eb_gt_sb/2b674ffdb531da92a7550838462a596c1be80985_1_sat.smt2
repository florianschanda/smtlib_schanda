(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11110001 #b11)
                arg1
                (fp #b1 #b01010000 #b01)))
(assert (fp.leq (fp #b1 #b01010000 #b01)
                arg1
                (fp #b0 #b00000100 #b00)))
; arg1 = -0.0000000000000088817841970012523233890533447265625

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111000 #b11)
                expect
                (fp #b1 #b00000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000 #b00)
                expect
                (fp #b0 #b00001001 #b01)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
