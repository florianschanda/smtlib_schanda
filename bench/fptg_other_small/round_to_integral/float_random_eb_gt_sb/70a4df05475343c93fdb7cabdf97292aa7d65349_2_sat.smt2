(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110101 #b10111)
                arg1
                (fp #b1 #b0111111 #b10110)))
(assert (fp.leq (fp #b1 #b0111111 #b10110)
                arg1
                (fp #b0 #b0001100 #b10010)))
; arg1 = -1.6875

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1000100 #b00001)
                expect
                (fp #b1 #b1000000 #b00000)))
(assert (fp.leq (fp #b1 #b1000000 #b00000)
                expect
                (fp #b1 #b0001001 #b10000)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
