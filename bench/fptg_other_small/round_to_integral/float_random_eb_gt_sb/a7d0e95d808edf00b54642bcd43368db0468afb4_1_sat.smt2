(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b0)
                arg1
                (fp #b1 #b10111 #b0)))
(assert (fp.leq (fp #b1 #b10111 #b0)
                arg1
                (fp #b1 #b01100 #b0)))
; arg1 = -256.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b1)
                expect
                (fp #b1 #b10111 #b0)))
(assert (fp.leq (fp #b1 #b10111 #b0)
                expect
                (fp #b0 #b00001 #b0)))
; expect = -256.0

(assert (= expect result))

(check-sat)
(exit)
