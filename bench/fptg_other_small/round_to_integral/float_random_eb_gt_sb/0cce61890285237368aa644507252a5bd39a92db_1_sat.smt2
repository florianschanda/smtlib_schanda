; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110101 #b010)
                arg1
                (fp #b0 #b1000100 #b111)))
(assert (fp.leq (fp #b0 #b1000100 #b111)
                arg1
                (fp #b0 #b1110011 #b010)))
; arg1 = 60.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111101 #b001)
                expect
                (fp #b0 #b1000100 #b111)))
(assert (fp.leq (fp #b0 #b1000100 #b111)
                expect
                (fp #b0 #b1111000 #b111)))
; expect = 60.0

(assert (= expect result))

(check-sat)
(exit)
