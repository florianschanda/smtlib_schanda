; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0001110 #b0101)
                arg1
                (fp #b0 #b0110100 #b1111)))
(assert (fp.leq (fp #b0 #b0110100 #b1111)
                arg1
                (fp #b0 #b1111101 #b1101)))
; arg1 = 0.000946044921875

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100110 #b1011)
                expect
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                expect
                (fp #b0 #b0101101 #b1010)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
