(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00101 #b101)
                arg1
                (fp #b0 #b01111 #b100)))
(assert (fp.leq (fp #b0 #b01111 #b100)
                arg1
                (fp #b0 #b10011 #b001)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00101 #b100)
                expect
                (fp #b0 #b01111 #b000)))
(assert (fp.leq (fp #b0 #b01111 #b000)
                expect
                (fp #b0 #b10111 #b001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
