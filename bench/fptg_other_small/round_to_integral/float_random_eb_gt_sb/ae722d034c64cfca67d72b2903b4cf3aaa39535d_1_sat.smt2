; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011011 #b01)
                arg1
                (fp #b0 #b10000001 #b00)))
(assert (fp.leq (fp #b0 #b10000001 #b00)
                arg1
                (fp #b0 #b11100101 #b01)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b01010111 #b01)
                expect
                (fp #b0 #b10000001 #b00)))
(assert (fp.leq (fp #b0 #b10000001 #b00)
                expect
                (fp #b0 #b11010011 #b00)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
