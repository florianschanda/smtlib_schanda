(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111100 #b100)
                arg1
                (fp #b0 #b01111111 #b001)))
(assert (fp.leq (fp #b0 #b01111111 #b001)
                arg1
                (fp #b0 #b11110000 #b111)))
; arg1 = 1.125

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00001011 #b101)
                expect
                (fp #b0 #b01111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111 #b000)
                expect
                (fp #b0 #b10010101 #b011)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
