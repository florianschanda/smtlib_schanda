; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1110 #b1)
                arg1
                (fp #b1 #b0100 #b0)))
(assert (fp.leq (fp #b1 #b0100 #b0)
                arg1
                (fp #b1 #b0001 #b0)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0011 #b1)
                expect
                (fp #b1 #b0000 #b0)))
(assert (fp.leq (fp #b1 #b0000 #b0)
                expect
                (fp #b0 #b0111 #b0)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
