(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b100)
                arg1
                (fp #b0 #b011111 #b111)))
(assert (fp.leq (fp #b0 #b011111 #b111)
                arg1
                (fp #b0 #b101000 #b101)))
; arg1 = 1.875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000111 #b000)
                expect
                (fp #b0 #b011111 #b000)))
(assert (fp.leq (fp #b0 #b011111 #b000)
                expect
                (fp #b0 #b110001 #b111)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
