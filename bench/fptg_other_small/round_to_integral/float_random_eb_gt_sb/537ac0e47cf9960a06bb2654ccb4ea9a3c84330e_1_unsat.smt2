; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101001 #b00)
                arg1
                (fp #b1 #b0111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111 #b11)
                arg1
                (fp #b0 #b1001100 #b00)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1001110 #b10)
                expect
                (fp #b1 #b0111111 #b00)))
(assert (fp.leq (fp #b1 #b0111111 #b00)
                expect
                (fp #b0 #b0111001 #b00)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
