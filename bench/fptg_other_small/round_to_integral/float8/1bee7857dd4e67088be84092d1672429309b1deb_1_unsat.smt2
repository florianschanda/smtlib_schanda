(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b1 #b011 #b0101)))
; arg1 = -3.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                expect
                (fp #b1 #b100 #b1000)))
(assert (fp.leq (fp #b1 #b100 #b1000)
                expect
                (fp #b0 #b010 #b0100)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
