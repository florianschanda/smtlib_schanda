; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg1
                (fp #b1 #b001 #b0100)))
(assert (fp.leq (fp #b1 #b001 #b0100)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -0.3125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000 #b0010)
                expect
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b000 #b0111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
