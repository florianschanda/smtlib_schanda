(assert (fp.leq (fp #b1 #b000 #b1100)
                expect
                (fp #b0 #b100 #b1000)))
(assert (fp.leq (fp #b0 #b100 #b1000)
                expect
                (fp #b0 #b100 #b1111)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
