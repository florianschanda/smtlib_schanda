(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0110)
                arg1
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                arg1
                (fp #b1 #b001 #b0110)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0011)
                expect
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                expect
                (fp #b1 #b011 #b1011)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
