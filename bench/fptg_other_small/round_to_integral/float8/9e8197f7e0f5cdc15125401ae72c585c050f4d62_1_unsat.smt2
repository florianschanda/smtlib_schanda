                expect
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                expect
                (fp #b0 #b000 #b0101)))
; expect = -15.0

(assert (not (= expect result)))

(check-sat)
