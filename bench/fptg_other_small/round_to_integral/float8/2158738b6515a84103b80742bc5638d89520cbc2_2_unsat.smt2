(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                expect
                (fp #b1 #b101 #b1000)))
(assert (fp.leq (fp #b1 #b101 #b1000)
                expect
                (fp #b1 #b101 #b0100)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
