(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 9))
(assert (fp.leq (fp #b1 #b01 #b11111110)
                arg1
                (fp #b1 #b00 #b10111100)))
(assert (fp.leq (fp #b1 #b00 #b10111100)
                arg1
                (fp #b1 #b00 #b01011100)))
; arg1 = -0.734375

(declare-const result (_ FloatingPoint 2 9))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 2 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10 #b10110000)
                expect
                (fp #b1 #b00 #b00000000)))
(assert (fp.leq (fp #b1 #b00 #b00000000)
                expect
                (fp #b0 #b00 #b01111100)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
