;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b1 #b0001 #b000000110)
                arg1
                (fp #b0 #b0101 #b011000110)))
(assert (fp.leq (fp #b0 #b0101 #b011000110)
                arg1
                (fp #b0 #b1100 #b011001010)))
; arg1 = 0.3466796875

(declare-const result (_ FloatingPoint 4 10))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b1 #b0110 #b110000010)
                expect
                (fp #b0 #b0111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111 #b000000000)
                expect
                (fp #b0 #b1001 #b011001101)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
