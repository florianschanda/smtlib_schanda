; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0111100101)
                arg1
                (fp #b0 #b00000 #b0100101110)))
(assert (fp.leq (fp #b0 #b00000 #b0100101110)
                arg1
                (fp #b0 #b10001 #b1110100011)))
; arg1 = 0.00001800060272216796875

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01110 #b0010110100)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b10000 #b0011111001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
