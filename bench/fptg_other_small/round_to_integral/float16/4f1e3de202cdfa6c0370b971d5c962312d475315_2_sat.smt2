; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001110100)
                arg1
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                arg1
                (fp #b0 #b11110 #b1110110011)))
; arg1 = 1.498046875

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01100 #b1011000011)
                expect
                (fp #b0 #b10000 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000 #b0000000000)
                expect
                (fp #b0 #b10010 #b1000101001)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
