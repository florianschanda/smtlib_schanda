(assert (fp.leq (fp #b0 #b00100 #b0011111110)
                expect
                (fp #b0 #b10100 #b0010100000)))
(assert (fp.leq (fp #b0 #b10100 #b0010100000)
                expect
                (fp #b0 #b10111 #b0110011011)))
; expect = 37.0

(assert (not (= expect result)))

(check-sat)
