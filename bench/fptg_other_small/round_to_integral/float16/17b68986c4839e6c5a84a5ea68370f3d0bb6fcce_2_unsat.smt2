(assert (fp.leq (fp #b1 #b11010 #b0110001100)
                expect
                (fp #b1 #b10000 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000 #b0000000000)
                expect
                (fp #b1 #b01110 #b1101001100)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
