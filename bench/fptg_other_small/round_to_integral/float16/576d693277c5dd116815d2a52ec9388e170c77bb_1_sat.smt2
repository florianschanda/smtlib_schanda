; arg1 = -5764.0

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111000)
                expect
                (fp #b1 #b11011 #b0110100001)))
(assert (fp.leq (fp #b1 #b11011 #b0110100001)
                expect
                (fp #b0 #b01100 #b0110101011)))
; expect = -5764.0

(assert (= expect result))

(check-sat)
(exit)
