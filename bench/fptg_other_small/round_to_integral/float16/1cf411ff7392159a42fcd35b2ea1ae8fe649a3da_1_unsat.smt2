; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000001111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b1000001010)))
; arg1 = 255.875

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01101 #b0101110100)
                expect
                (fp #b0 #b10110 #b1111111000)))
(assert (fp.leq (fp #b0 #b10110 #b1111111000)
                expect
                (fp #b0 #b11010 #b1000110010)))
; expect = 255.0

(assert (not (= expect result)))

(check-sat)
(exit)
