; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01100 #b0000111111)
                arg1
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                arg1
                (fp #b0 #b11110 #b1001110011)))
; arg1 = 109.0

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b0010001000)
                expect
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                expect
                (fp #b0 #b11011 #b1010001101)))
; expect = 109.0

(assert (= expect result))

(check-sat)
(exit)
