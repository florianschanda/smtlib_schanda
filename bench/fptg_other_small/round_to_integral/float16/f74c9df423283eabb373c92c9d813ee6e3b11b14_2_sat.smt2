(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b1 #b01111 #b1000100111)))
; arg1 = -255.875

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0000011111)
                expect
                (fp #b1 #b10111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111 #b0000000000)
                expect
                (fp #b0 #b00111 #b0100010100)))
; expect = -256.0

(assert (= expect result))

(check-sat)
(exit)
