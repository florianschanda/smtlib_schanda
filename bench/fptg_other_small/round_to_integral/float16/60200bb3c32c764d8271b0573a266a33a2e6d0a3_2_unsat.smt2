; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111110)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b1 #b00101 #b1001111111)))
; arg1 = -1.203125

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1101000110)
                expect
                (fp #b1 #b10000 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000 #b0000000000)
                expect
                (fp #b0 #b10001 #b0101001010)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
