(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101100)
                arg1
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                arg1
                (fp #b0 #b10000 #b0000010110)))
; arg1 = -899.0

(declare-const result Float16)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1011101011)
                expect
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                expect
                (fp #b1 #b00111 #b1100100111)))
; expect = -899.0

(assert (= expect result))

(check-sat)
(exit)
