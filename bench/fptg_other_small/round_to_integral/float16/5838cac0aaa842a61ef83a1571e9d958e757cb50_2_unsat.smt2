(assert (fp.leq (fp #b1 #b11010 #b1101011110)
                expect
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                expect
                (fp #b1 #b01101 #b0000110010)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
