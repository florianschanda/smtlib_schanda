(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1100001011001011)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1101001 #b0010100100001000)))
; arg1 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0101111 #b1110100010011110)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0001111 #b1000000000110101)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
