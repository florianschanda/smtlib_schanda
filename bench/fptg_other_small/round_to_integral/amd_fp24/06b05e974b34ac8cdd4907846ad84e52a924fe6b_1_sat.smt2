; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1110001101011000)
                arg1
                (fp #b0 #b1000110 #b1011110001110100)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110001110100)
                arg1
                (fp #b0 #b1110101 #b1001001101100100)))
; arg1 = 222.2265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000010 #b1111101001111110)
                expect
                (fp #b0 #b1000110 #b1011110000000000)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110000000000)
                expect
                (fp #b0 #b1011110 #b0010101001001100)))
; expect = 222.0

(assert (= expect result))

(check-sat)
(exit)
