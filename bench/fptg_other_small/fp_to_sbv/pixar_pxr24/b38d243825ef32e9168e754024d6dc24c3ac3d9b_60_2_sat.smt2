(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Target: bv60
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110111 #b010011011110100)
                arg
                (fp #b1 #b01111111 #b100111100100001)))
(assert (fp.leq (fp #b1 #b01111111 #b100111100100001)
                arg
                (fp #b0 #b01001101 #b110001011010000)))
; arg = -1.618194580078125

(declare-const result (_ BitVec 60))
(assert (= result ((_ fp.to_sbv 60) rm arg)))

(declare-const expect (_ BitVec 60))
(assert (not (bvule expect #b111111111111111111111111111111111111111111111111111111111101)))
(assert (not (bvule #b111111111111111111111111111111111111111111111111111111111111 expect)))

(assert (= expect result))

(check-sat)
(exit)
