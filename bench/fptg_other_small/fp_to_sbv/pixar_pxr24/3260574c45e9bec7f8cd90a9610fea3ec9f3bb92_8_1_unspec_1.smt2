(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100000 #b011111100100100)
                arg
                (fp #b0 #b11010010 #b011110001101100)))
(assert (fp.leq (fp #b0 #b11010010 #b011110001101100)
                arg
                (fp #b0 #b11011110 #b111010101110011)))
