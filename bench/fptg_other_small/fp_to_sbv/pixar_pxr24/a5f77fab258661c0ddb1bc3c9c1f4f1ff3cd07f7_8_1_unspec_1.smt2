; Format: PIXAR_PXR24
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b110000010011010)
                arg
                (fp #b1 #b10001110 #b110010010010110)))
(assert (fp.leq (fp #b1 #b10001110 #b110010010010110)
                arg
                (fp #b0 #b00000110 #b010110101001100)))
; arg = -58518.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111000)))
(assert (not (bvule #b11111010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
