; Format: PIXAR_PXR24
; Target: bv1
; Arg1: +ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b00101101 #b110101111110010)
                arg
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg
                (fp #b0 #b00110100 #b010010110001011)))
; arg = 0.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
