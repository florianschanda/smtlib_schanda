; Format: PIXAR_PXR24
; Target: bv4
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b011100001110001)
                arg
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                arg
                (fp #b0 #b10111011 #b001010011101001)))
; arg = -10614702846735548416.0

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b0101)))
(assert (not (bvule #b0111 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
