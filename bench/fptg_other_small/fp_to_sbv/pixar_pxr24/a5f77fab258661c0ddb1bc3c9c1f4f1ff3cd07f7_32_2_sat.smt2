(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b110000010011010)
                arg
                (fp #b1 #b10001110 #b110010010010110)))
(assert (fp.leq (fp #b1 #b10001110 #b110010010010110)
                arg
                (fp #b0 #b00000110 #b010110101001100)))
; arg = -58518.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111110001101101101001)))
(assert (not (bvule #b11111111111111110001101101101011 expect)))

(assert (= expect result))

(check-sat)
(exit)
