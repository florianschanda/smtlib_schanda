; Format: PIXAR_PXR24
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001011 #b011100111000101)
                arg
                (fp #b1 #b01111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b01111111 #b110100000111010)
                arg
                (fp #b0 #b00000010 #b011100101100111)))
; arg = -1.81427001953125

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111111111111111101)))
(assert (not (bvule #b1111111111111111111111111111111111111111111111111111111111111111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
