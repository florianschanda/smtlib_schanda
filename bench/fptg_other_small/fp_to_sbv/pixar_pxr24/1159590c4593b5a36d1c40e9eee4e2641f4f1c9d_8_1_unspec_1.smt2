(assert (fp.leq (fp #b1 #b11001100 #b100110100101110)
                arg
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                arg
                (fp #b1 #b10110000 #b101111001011000)))
