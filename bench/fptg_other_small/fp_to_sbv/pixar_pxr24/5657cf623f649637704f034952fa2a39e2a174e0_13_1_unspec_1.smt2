(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001101 #b111110010111001)
                arg
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg
                (fp #b1 #b00101110 #b100000001101000)))
; arg = -65536.0

(declare-const result (_ BitVec 13))
(assert (= result ((_ fp.to_sbv 13) rm arg)))

(declare-const expect (_ BitVec 13))
(assert (= expect #b0011110000110))

(assert (not (= expect result)))
