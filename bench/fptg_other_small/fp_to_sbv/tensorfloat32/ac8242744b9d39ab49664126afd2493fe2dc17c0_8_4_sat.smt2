; Format: TENSORFLOAT32
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b1001110011)
                arg
                (fp #b0 #b01111111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111111 #b1101111000)
                arg
                (fp #b0 #b10001111 #b0111010100)))
; arg = 1.8671875

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000001)))
(assert (not (bvule #b00000011 expect)))

(assert (= expect result))

(check-sat)
(exit)
