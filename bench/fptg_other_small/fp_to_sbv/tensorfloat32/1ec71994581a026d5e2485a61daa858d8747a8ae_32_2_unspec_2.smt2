; Format: TENSORFLOAT32
; Target: bv32
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b1111000100)
                arg
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg
                (fp #b0 #b00100001 #b1111110100)))
; arg = -18437736874454810624.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b10111111101101100100000100100010)))
(assert (not (bvule #b10111111101101100100000100100100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
