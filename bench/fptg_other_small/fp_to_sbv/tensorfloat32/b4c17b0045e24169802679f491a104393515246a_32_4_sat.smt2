; Format: TENSORFLOAT32
; Target: bv32
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111000 #b0100111001)
                arg
                (fp #b0 #b01101101 #b1110100000)))
(assert (fp.leq (fp #b0 #b01101101 #b1110100000)
                arg
                (fp #b0 #b11001100 #b1110010001)))
; arg = 0.00000727176666259765625

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
