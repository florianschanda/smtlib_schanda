; Format: TENSORFLOAT32
; Target: bv23
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1111010100)
                arg
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg
                (fp #b0 #b01100000 #b0001100000)))
; arg = -264.0

(declare-const result (_ BitVec 23))
(assert (= result ((_ fp.to_sbv 23) rm arg)))

(declare-const expect (_ BitVec 23))
(assert (not (bvule expect #b11111111111111011110111)))
(assert (not (bvule #b11111111111111011111001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
