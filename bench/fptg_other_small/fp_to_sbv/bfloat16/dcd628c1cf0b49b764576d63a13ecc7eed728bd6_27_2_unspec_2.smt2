(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b0010100)
                arg
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                arg
                (fp #b0 #b11111110 #b1101101)))
