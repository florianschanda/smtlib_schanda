; Format: BFLOAT16
; Target: bv24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011101 #b1100000)
                arg
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                arg
                (fp #b1 #b01010011 #b0010001)))
; arg = -157.0

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_sbv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (not (bvule expect #b111111111111111101100010)))
(assert (not (bvule #b111111111111111101100100 expect)))

(assert (= expect result))

(check-sat)
(exit)
