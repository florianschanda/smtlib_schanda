(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Target: bv8
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b11001011 #b1001101)
                arg
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg
                (fp #b0 #b11010110 #b0111101)))
; arg = -0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (= expect result))

(check-sat)
(exit)
