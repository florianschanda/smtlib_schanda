; Format: BFLOAT16
; Target: bv29
; Arg1: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b0111100)
                arg
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                arg
                (fp #b0 #b11111111 #b0000000)))
; arg = 338953138925153547590470800371487866880.0

(declare-const result (_ BitVec 29))
(assert (= result ((_ fp.to_sbv 29) rm arg)))

(declare-const expect (_ BitVec 29))
(assert (not (bvule expect #b10110100101101111101010110011)))
(assert (not (bvule #b10110100101101111101010110101 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
