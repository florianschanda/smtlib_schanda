; Format: BFLOAT16
; Target: bv9
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101000 #b1101101)
                arg
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg
                (fp #b0 #b11101001 #b0010100)))
; arg = 86.0

(declare-const result (_ BitVec 9))
(assert (= result ((_ fp.to_sbv 9) rm arg)))

(declare-const expect (_ BitVec 9))
(assert (not (bvule expect #b001010101)))
(assert (not (bvule #b001010111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
