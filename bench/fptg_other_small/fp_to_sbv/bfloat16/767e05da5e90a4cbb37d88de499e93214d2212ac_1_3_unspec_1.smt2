; Format: BFLOAT16
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0011011)
                arg
                (fp #b1 #b01111111 #b0000010)))
(assert (fp.leq (fp #b1 #b01111111 #b0000010)
                arg
                (fp #b1 #b00000100 #b1000000)))
; arg = -1.015625

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
