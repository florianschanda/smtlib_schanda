; Format: BFLOAT16
; Target: bv8
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010101 #b0110111)
                arg
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg
                (fp #b0 #b11011011 #b1101001)))
; arg = 30.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00011101)))
(assert (not (bvule #b00011111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
