(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv32
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b1 #b0001 #b000000110)
                arg
                (fp #b0 #b0101 #b011000110)))
(assert (fp.leq (fp #b0 #b0101 #b011000110)
                arg
                (fp #b0 #b1100 #b011001010)))
; arg = 0.3466796875

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
