(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 21))
(assert (fp.leq (fp #b1 #b000 #b10111101100010110011)
                arg
                (fp #b0 #b000 #b01100001011011001100)))
(assert (fp.leq (fp #b0 #b000 #b01100001011011001100)
                arg
                (fp #b0 #b001 #b10101110011010001001)))
