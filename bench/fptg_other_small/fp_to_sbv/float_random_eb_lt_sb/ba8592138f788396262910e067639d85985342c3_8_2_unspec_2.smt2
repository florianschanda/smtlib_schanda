; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv8
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 17))
(assert (fp.leq (fp #b0 #b1101 #b1011010000111010)
                arg
                (fp #b0 #b1110 #b1111111000000000)))
(assert (fp.leq (fp #b0 #b1110 #b1111111000000000)
                arg
                (fp #b0 #b1110 #b1111111001010111)))
; arg = 255.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00110011)))
(assert (not (bvule #b00110101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
