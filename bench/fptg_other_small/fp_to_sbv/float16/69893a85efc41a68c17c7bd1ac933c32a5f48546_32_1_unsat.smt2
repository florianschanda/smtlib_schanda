; Format: FLOAT16
; Target: bv32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111100010)
                arg
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg
                (fp #b1 #b01011 #b1100001001)))
; arg = -25296.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111001110100101111)))
(assert (not (bvule #b11111111111111111001110100110001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
