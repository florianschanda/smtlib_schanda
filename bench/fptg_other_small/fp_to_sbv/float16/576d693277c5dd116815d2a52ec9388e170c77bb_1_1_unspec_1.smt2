; Format: FLOAT16
; Target: bv1
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101000011)
                arg
                (fp #b1 #b11011 #b0110100001)))
(assert (fp.leq (fp #b1 #b11011 #b0110100001)
                arg
                (fp #b0 #b00100 #b1111000100)))
; arg = -5764.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
