(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                arg
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg
                (fp #b0 #b11101 #b1100111000)))
; arg = 1671.0

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (= expect #b10))

(assert (not (= expect result)))
