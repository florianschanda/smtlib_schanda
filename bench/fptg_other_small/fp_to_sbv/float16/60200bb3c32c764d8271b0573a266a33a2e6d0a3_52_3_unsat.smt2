; Format: FLOAT16
; Target: bv52
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111110)
                arg
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg
                (fp #b1 #b00101 #b1001111111)))
; arg = -1.203125

(declare-const result (_ BitVec 52))
(assert (= result ((_ fp.to_sbv 52) rm arg)))

(declare-const expect (_ BitVec 52))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
