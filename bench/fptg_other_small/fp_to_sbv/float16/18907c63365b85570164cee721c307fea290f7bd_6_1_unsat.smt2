(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Target: bv6
; Arg1: +ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101000001)
                arg
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg
                (fp #b0 #b10101 #b1010100011)))
; arg = 1.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b000000)))
(assert (not (bvule #b000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
