; Format: FLOAT16
; Target: bv8
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10010 #b1000001100)
                arg
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg
                (fp #b0 #b11100 #b1101010001)))
; arg = 0.0078125

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (not (= expect result)))

(check-sat)
(exit)
