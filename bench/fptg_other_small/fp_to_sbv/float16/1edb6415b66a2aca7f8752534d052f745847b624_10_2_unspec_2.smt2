(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv10
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111111)
                arg
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg
                (fp #b1 #b00000 #b0101101101)))
; arg = -2048.0

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_sbv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b0110101111)))
(assert (not (bvule #b0110110001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
