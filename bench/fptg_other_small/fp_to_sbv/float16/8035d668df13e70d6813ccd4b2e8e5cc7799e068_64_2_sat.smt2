; Format: FLOAT16
; Target: bv64
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110100011)
                arg
                (fp #b1 #b11110 #b0111011011)))
(assert (fp.leq (fp #b1 #b11110 #b0111011011)
                arg
                (fp #b1 #b10010 #b0110110111)))
; arg = -47968.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111110100010010011111)))
(assert (not (bvule #b1111111111111111111111111111111111111111111111110100010010100001 expect)))

(assert (= expect result))

(check-sat)
(exit)
