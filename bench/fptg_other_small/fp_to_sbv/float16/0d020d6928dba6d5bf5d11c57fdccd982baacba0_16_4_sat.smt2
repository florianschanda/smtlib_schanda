(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv16
; Arg1: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float16)
(assert (fp.leq (fp #b0 #b00001 #b1011010010)
                arg
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg
                (fp #b0 #b11010 #b1011001111)))
; arg = 0.000244140625

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (not (bvule expect #b0000000000000000)))
(assert (not (bvule #b0000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
