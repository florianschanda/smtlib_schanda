(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv15
; Arg1: +NAN

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.isNaN arg))
; arg = NaN

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_sbv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (not (bvule expect #b101010111000111)))
(assert (not (bvule #b101010111001001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
