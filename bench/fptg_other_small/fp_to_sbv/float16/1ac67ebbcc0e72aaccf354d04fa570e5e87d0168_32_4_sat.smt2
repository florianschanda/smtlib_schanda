(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv32
; Arg1: +RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11001 #b0111100101)
                arg
                (fp #b0 #b00000 #b0100101110)))
(assert (fp.leq (fp #b0 #b00000 #b0100101110)
                arg
                (fp #b0 #b10001 #b1110100011)))
; arg = 0.00001800060272216796875

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
