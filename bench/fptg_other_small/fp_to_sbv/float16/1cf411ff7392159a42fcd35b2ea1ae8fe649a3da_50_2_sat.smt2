(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv50
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000001111)
                arg
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg
                (fp #b0 #b11100 #b1000001010)))
; arg = 255.875

(declare-const result (_ BitVec 50))
(assert (= result ((_ fp.to_sbv 50) rm arg)))

(declare-const expect (_ BitVec 50))
(assert (not (bvule expect #b00000000000000000000000000000000000000000011111110)))
(assert (not (bvule #b00000000000000000000000000000000000000000100000000 expect)))

(assert (= expect result))

(check-sat)
(exit)
