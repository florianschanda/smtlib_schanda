; Format: FLOAT16
; Target: bv64
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b0101101011)
                arg
                (fp #b1 #b11010 #b1011001111)))
(assert (fp.leq (fp #b1 #b11010 #b1011001111)
                arg
                (fp #b0 #b01111 #b1011000101)))
; arg = -3486.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111111001001100001)))
(assert (not (bvule #b1111111111111111111111111111111111111111111111111111001001100011 expect)))

(assert (= expect result))

(check-sat)
(exit)
