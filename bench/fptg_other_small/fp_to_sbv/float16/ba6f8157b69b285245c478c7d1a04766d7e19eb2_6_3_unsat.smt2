; Format: FLOAT16
; Target: bv6
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b0 #b00110 #b1111111001)
                arg
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg
                (fp #b0 #b11000 #b1111011110)))
; arg = 14.8359375

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b001110)))
(assert (not (bvule #b010000 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
