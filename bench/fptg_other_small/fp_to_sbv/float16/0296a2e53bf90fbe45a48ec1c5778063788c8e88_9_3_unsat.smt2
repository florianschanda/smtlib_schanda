; Format: FLOAT16
; Target: bv9
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg
                (fp #b0 #b11100 #b1100100101)))
; arg = 36.4375

(declare-const result (_ BitVec 9))
(assert (= result ((_ fp.to_sbv 9) rm arg)))

(declare-const expect (_ BitVec 9))
(assert (not (bvule expect #b000100100)))
(assert (not (bvule #b000100110 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
