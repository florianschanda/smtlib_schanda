; Format: FLOAT16
; Target: bv7
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b10100 #b1100010001)
                arg
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg
                (fp #b0 #b10011 #b0010100110)))
; arg = -0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule #b0000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
