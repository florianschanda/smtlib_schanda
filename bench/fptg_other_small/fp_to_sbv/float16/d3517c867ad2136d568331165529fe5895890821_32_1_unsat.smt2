; Format: FLOAT16
; Target: bv32
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10001 #b1010110010)
                arg
                (fp #b0 #b00000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000 #b1011110010)
                arg
                (fp #b0 #b01111 #b0101001010)))
; arg = 0.00004494190216064453125

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule #b00000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
