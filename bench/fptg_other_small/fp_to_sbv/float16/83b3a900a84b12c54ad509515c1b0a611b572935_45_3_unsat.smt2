; Format: FLOAT16
; Target: bv45
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000110010)
                arg
                (fp #b1 #b10110 #b0101001111)))
(assert (fp.leq (fp #b1 #b10110 #b0101001111)
                arg
                (fp #b1 #b00111 #b1100011010)))
; arg = -169.875

(declare-const result (_ BitVec 45))
(assert (= result ((_ fp.to_sbv 45) rm arg)))

(declare-const expect (_ BitVec 45))
(assert (not (bvule expect #b111111111111111111111111111111111111101010110)))
(assert (not (bvule #b111111111111111111111111111111111111101011000 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
