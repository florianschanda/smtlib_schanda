; Format: FLOAT16
; Target: bv44
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01111 #b1101010110)
                arg
                (fp #b1 #b00010 #b1001100111)))
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                arg
                (fp #b0 #b11110 #b0011110100)))
; arg = -0.00019538402557373046875

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_sbv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (not (bvule #b00000000000000000000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
