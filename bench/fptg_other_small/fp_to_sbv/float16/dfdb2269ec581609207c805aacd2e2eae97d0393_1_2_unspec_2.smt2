; Format: FLOAT16
; Target: bv1
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110000011)
                arg
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                arg
                (fp #b0 #b11110 #b1011101000)))
; arg = 1.98828125

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
