(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Target: bv24
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111110111)
                arg
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg
                (fp #b0 #b11110 #b1010100111)))
; arg = 1.59765625

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_sbv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (not (bvule expect #b000000000000000000000000)))
(assert (not (bvule #b000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
