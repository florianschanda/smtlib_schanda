(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111110000000000011111)))
(assert (not (bvule #b1111111111111111111111111111111111111111111111110000000000100001 expect)))

(assert (not (= expect result)))

