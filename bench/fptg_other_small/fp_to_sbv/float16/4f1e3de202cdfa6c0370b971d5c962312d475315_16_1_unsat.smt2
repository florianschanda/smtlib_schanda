; Format: FLOAT16
; Target: bv16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001110100)
                arg
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                arg
                (fp #b0 #b11110 #b1110110011)))
; arg = 1.498046875

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (not (bvule expect #b0000000000000000)))
(assert (not (bvule #b0000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
