; Format: FLOAT16
; Target: bv7
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg
                (fp #b0 #b11100 #b0100000100)))
; arg = 1394.0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1001101)))
(assert (not (bvule #b1001111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
