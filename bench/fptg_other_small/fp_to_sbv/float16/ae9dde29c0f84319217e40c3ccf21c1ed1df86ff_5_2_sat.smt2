(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv5
; Arg1: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b00111 #b0010111101)
                arg
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg
                (fp #b0 #b11110 #b1101111111)))
; arg = 0.0000045299530029296875

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_sbv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule #b00001 expect)))

(assert (= expect result))

(check-sat)
(exit)
