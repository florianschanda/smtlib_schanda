; Format: FLOAT16
; Target: bv32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                arg
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                arg
                (fp #b0 #b01101 #b1111101100)))
; arg = -193.75

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b11111111111111111111111100111111))

(assert (= expect result))

(check-sat)
(exit)
