; Format: FLOAT16
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000101100)
                arg
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg
                (fp #b0 #b01110 #b1111100010)))
; arg = -1.98828125

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b11111111))

(assert (not (= expect result)))

(check-sat)
(exit)
