; Format: FLOAT16
; Target: bv25
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101000011)
                arg
                (fp #b1 #b11011 #b0110100001)))
(assert (fp.leq (fp #b1 #b11011 #b0110100001)
                arg
                (fp #b0 #b00100 #b1111000100)))
; arg = -5764.0

(declare-const result (_ BitVec 25))
(assert (= result ((_ fp.to_sbv 25) rm arg)))

(declare-const expect (_ BitVec 25))
(assert (not (bvule expect #b1111111111110100101111011)))
(assert (not (bvule #b1111111111110100101111101 expect)))

(assert (= expect result))

(check-sat)
(exit)
