(assert (fp.leq (fp #b1 #b11101 #b0000000010)
                arg
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg
                (fp #b0 #b01110 #b0100111000)))
; arg = -264.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1111111111111111111111111111111111111111111111111111111011111000))

(assert (not (= expect result)))

(check-sat)
(exit)
