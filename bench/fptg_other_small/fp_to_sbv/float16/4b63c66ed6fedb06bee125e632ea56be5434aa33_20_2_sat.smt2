(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv20
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10100 #b1100001100)
                arg
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg
                (fp #b0 #b00100 #b1111011000)))
; arg = -0.000000059604644775390625

(declare-const result (_ BitVec 20))
(assert (= result ((_ fp.to_sbv 20) rm arg)))

(declare-const expect (_ BitVec 20))
(assert (not (bvule #b00000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
