; Format: FLOAT16
; Target: bv26
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11100 #b1111011110)
                arg
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg
                (fp #b0 #b10100 #b0001011101)))
; arg = -1809.0

(declare-const result (_ BitVec 26))
(assert (= result ((_ fp.to_sbv 26) rm arg)))

(declare-const expect (_ BitVec 26))
(assert (not (bvule expect #b11111111111111100011101110)))
(assert (not (bvule #b11111111111111100011110000 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
