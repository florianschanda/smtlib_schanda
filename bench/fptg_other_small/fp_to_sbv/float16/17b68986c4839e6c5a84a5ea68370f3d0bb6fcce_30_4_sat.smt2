(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv30
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                arg
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                arg
                (fp #b0 #b01000 #b0111111001)))
; arg = -1.134765625

(declare-const result (_ BitVec 30))
(assert (= result ((_ fp.to_sbv 30) rm arg)))

(declare-const expect (_ BitVec 30))
(assert (not (bvule expect #b111111111111111111111111111110)))

(assert (= expect result))

(check-sat)
(exit)
