; Format: FLOAT16
; Target: bv44
; Arg1: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b00011 #b1010010100)
                arg
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg
                (fp #b0 #b00010 #b1011110100)))
; arg = 0.0000152587890625

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_sbv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (= expect #b00000000000000000000000000000000000000000001))

(assert (not (= expect result)))

(check-sat)
(exit)
