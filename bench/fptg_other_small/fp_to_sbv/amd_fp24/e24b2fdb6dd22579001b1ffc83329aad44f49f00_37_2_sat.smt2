; Format: AMD_FP24
; Target: bv37
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b1111011100011011)
                arg
                (fp #b0 #b1001110 #b1101101110011110)))
(assert (fp.leq (fp #b0 #b1001110 #b1101101110011110)
                arg
                (fp #b0 #b1101000 #b1111110101000011)))
; arg = 60879.0

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_sbv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (not (bvule expect #b0000000000000000000001110110111001110)))
(assert (not (bvule #b0000000000000000000001110110111010000 expect)))

(assert (= expect result))

(check-sat)
(exit)
