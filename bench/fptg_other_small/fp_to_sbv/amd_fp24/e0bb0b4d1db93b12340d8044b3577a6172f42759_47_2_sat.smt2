(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0101011101100011)
                arg
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg
                (fp #b0 #b1111000 #b0110100001010001)))
; arg = 26078.0

(declare-const result (_ BitVec 47))
(assert (= result ((_ fp.to_sbv 47) rm arg)))

(declare-const expect (_ BitVec 47))
(assert (not (bvule expect #b00000000000000000000000000000000110010111011101)))
(assert (not (bvule #b00000000000000000000000000000000110010111011111 expect)))

(assert (= expect result))

(check-sat)
(exit)
