; Format: AMD_FP24
; Target: bv64
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1001111010011011)
                arg
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg
                (fp #b1 #b0110101 #b1100101100100110)))
; arg = -4294934528.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111100000000000000000111111111111111)))
(assert (not (bvule #b1111111111111111111111111111111100000000000000001000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
