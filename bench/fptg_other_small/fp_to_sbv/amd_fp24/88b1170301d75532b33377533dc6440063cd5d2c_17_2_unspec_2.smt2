; Format: AMD_FP24
; Target: bv17
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0000101100101110)
                arg
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg
                (fp #b0 #b0111000 #b1100010001111100)))
; arg = -14354451791872.0

(declare-const result (_ BitVec 17))
(assert (= result ((_ fp.to_sbv 17) rm arg)))

(declare-const expect (_ BitVec 17))
(assert (not (bvule expect #b11000110101001011)))
(assert (not (bvule #b11000110101001101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

