; Format: AMD_FP24
; Target: bv60
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1001101101101001)
                arg
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg
                (fp #b0 #b0101101 #b1100110011110100)))
; arg = -1.946075439453125

(declare-const result (_ BitVec 60))
(assert (= result ((_ fp.to_sbv 60) rm arg)))

(declare-const expect (_ BitVec 60))
(assert (not (bvule expect #b111111111111111111111111111111111111111111111111111111111101)))
(assert (not (bvule #b111111111111111111111111111111111111111111111111111111111111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
