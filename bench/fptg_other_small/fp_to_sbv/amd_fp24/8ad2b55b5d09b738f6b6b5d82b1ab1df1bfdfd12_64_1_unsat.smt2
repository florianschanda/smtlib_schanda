(assert (fp.leq (fp #b1 #b1110001 #b1001111011111101)
                arg
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg
                (fp #b0 #b1111011 #b1010010101000011)))
