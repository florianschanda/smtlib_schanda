(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1010110 #b0001001110001111)
                arg
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg
                (fp #b0 #b1111111 #b0000000000000000)))
; arg = 18446603336221196288.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b01110110))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

