(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111101110110010101011111111)))
(assert (not (bvule #b1111111111111111111111111111111111111111101110110010101100000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
