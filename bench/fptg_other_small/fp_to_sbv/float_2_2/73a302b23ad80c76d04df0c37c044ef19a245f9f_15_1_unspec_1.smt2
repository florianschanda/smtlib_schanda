; Format: FLOAT_2_2
; Target: bv15
; Arg1: -INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.isNegative arg))
(assert (fp.isInfinite arg))
; arg = -Infinity

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_sbv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (= expect #b110111011111001))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
