; Format: FLOAT_2_2
; Target: bv64
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))
; arg = Infinity

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1001111001111010100100010011111001101111100101011100101011111110)))
(assert (not (bvule #b1001111001111010100100010011111001101111100101011100101100000000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
