(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg
                (fp #b0 #b10 #b0)))
; arg = -1.5

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
