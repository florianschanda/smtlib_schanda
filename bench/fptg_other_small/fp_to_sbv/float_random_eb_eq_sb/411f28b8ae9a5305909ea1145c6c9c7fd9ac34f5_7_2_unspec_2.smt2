(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv7
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011001 #b110101)
                arg
                (fp #b1 #b1000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000101 #b011101)
                arg
                (fp #b1 #b0001111 #b110011)))
; arg = -93.0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1011010)))
(assert (not (bvule #b1011100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
