(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b001)
                arg
                (fp #b0 #b0111 #b000)))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg
                (fp #b0 #b1011 #b111)))
; arg = 1.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (= expect #b000001))

(assert (not (= expect result)))

