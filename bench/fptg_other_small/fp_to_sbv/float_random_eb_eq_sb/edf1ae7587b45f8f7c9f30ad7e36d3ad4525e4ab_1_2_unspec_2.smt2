; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0100 #b100)
                arg
                (fp #b0 #b1010 #b110)))
(assert (fp.leq (fp #b0 #b1010 #b110)
                arg
                (fp #b0 #b1110 #b010)))
; arg = 14.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

