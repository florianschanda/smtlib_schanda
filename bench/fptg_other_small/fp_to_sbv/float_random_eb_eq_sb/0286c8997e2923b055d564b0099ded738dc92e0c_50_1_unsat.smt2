; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv50
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b0000)
                arg
                (fp #b1 #b10010 #b1110)))
(assert (fp.leq (fp #b1 #b10010 #b1110)
                arg
                (fp #b0 #b10010 #b0011)))
; arg = -15.0

(declare-const result (_ BitVec 50))
(assert (= result ((_ fp.to_sbv 50) rm arg)))

(declare-const expect (_ BitVec 50))
(assert (not (bvule expect #b11111111111111111111111111111111111111111111110000)))
(assert (not (bvule #b11111111111111111111111111111111111111111111110010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
