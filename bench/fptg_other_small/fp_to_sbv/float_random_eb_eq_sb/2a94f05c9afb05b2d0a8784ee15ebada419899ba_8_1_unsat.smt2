(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010111 #b10101)
                arg
                (fp #b0 #b011111 #b10100)))
(assert (fp.leq (fp #b0 #b011111 #b10100)
                arg
                (fp #b0 #b110110 #b00111)))
; arg = 1.625

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000000)))
(assert (not (bvule #b00000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
