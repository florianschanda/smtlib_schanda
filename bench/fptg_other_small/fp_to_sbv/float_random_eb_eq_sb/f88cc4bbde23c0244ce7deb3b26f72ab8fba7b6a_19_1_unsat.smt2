;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b101)
                arg
                (fp #b1 #b1010 #b001)))
(assert (fp.leq (fp #b1 #b1010 #b001)
                arg
                (fp #b0 #b0110 #b000)))
; arg = -9.0

(declare-const result (_ BitVec 19))
(assert (= result ((_ fp.to_sbv 19) rm arg)))

(declare-const expect (_ BitVec 19))
(assert (not (bvule expect #b1111111111111110110)))
(assert (not (bvule #b1111111111111111000 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
