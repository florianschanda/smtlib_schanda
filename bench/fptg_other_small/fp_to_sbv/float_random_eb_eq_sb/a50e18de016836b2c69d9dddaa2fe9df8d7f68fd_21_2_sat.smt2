(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001111 #b00111)
                arg
                (fp #b0 #b000000 #b11001)))
(assert (fp.leq (fp #b0 #b000000 #b11001)
                arg
                (fp #b0 #b110111 #b01000)))
