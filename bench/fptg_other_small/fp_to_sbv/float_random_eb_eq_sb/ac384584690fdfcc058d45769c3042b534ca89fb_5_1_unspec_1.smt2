; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv5
; Arg1: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b010)
                arg
                (fp #b1 #b1100 #b010)))
(assert (fp.leq (fp #b1 #b1100 #b010)
                arg
                (fp #b0 #b1100 #b010)))
; arg = -40.0

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_sbv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b10101)))
(assert (not (bvule #b10111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
