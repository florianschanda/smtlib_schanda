(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv35
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                arg
                (fp #b0 #b100 #b11)))
; arg = -1.25

(declare-const result (_ BitVec 35))
(assert (= result ((_ fp.to_sbv 35) rm arg)))

(declare-const expect (_ BitVec 35))
(assert (not (bvule expect #b11111111111111111111111111111111101)))
(assert (not (bvule #b11111111111111111111111111111111111 expect)))

(assert (= expect result))

(check-sat)
(exit)
