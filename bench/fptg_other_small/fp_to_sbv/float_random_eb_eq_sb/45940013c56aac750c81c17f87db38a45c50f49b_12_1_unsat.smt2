(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv12
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1001)
                arg
                (fp #b1 #b10010 #b1111)))
(assert (fp.leq (fp #b1 #b10010 #b1111)
                arg
                (fp #b0 #b10100 #b0100)))
; arg = -15.5

(declare-const result (_ BitVec 12))
(assert (= result ((_ fp.to_sbv 12) rm arg)))

(declare-const expect (_ BitVec 12))
(assert (not (bvule expect #b111111101111)))
(assert (not (bvule #b111111110001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
