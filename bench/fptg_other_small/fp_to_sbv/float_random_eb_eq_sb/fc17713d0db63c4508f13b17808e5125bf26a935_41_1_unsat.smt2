(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv41
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg
                (fp #b1 #b0110 #b001)))
(assert (fp.leq (fp #b1 #b0110 #b001)
                arg
                (fp #b0 #b1000 #b100)))
; arg = -0.5625

(declare-const result (_ BitVec 41))
(assert (= result ((_ fp.to_sbv 41) rm arg)))

(declare-const expect (_ BitVec 41))
(assert (not (bvule #b00000000000000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
