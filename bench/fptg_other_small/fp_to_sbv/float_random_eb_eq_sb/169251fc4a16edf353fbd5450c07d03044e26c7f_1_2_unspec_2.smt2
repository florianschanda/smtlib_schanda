(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b11001)
                arg
                (fp #b0 #b100010 #b11000)))
(assert (fp.leq (fp #b0 #b100010 #b11000)
                arg
                (fp #b0 #b110000 #b00111)))
; arg = 14.0

