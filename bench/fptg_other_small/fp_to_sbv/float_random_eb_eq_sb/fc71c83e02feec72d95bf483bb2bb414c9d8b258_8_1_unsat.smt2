; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00010)
                arg
                (fp #b1 #b100100 #b11000)))
(assert (fp.leq (fp #b1 #b100100 #b11000)
                arg
                (fp #b0 #b100110 #b11011)))
; arg = -56.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11000111)))
(assert (not (bvule #b11001001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
