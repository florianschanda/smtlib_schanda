(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg
                (fp #b1 #b110 #b01)))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg
                (fp #b0 #b110 #b00)))
; arg = -10.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11110101)))
(assert (not (bvule #b11110111 expect)))

(assert (= expect result))

(check-sat)
(exit)
