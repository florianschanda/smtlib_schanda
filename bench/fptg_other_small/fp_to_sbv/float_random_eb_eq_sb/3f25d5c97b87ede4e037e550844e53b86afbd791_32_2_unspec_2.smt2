;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.isNaN arg))
; arg = NaN

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11011100101101001010101000111000)))
(assert (not (bvule #b11011100101101001010101000111010 expect)))

(assert (= expect result))
