; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010001 #b111011)
                arg
                (fp #b0 #b1111001 #b100000)))
(assert (fp.leq (fp #b0 #b1111001 #b100000)
                arg
                (fp #b0 #b1111010 #b111111)))
; arg = 432345564227567616.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11110111)))
(assert (not (bvule #b11111001 expect)))

(assert (= expect result))
