(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg
                (fp #b0 #b001 #b00)))
; arg = 0.0625

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_sbv 28) rm arg)))

(declare-const expect (_ BitVec 28))
