; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0000)
                arg
                (fp #b1 #b10010 #b0011)))
(assert (fp.leq (fp #b1 #b10010 #b0011)
                arg
                (fp #b1 #b10000 #b1100)))
; arg = -9.5

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1111111111111111111111111111111111111111111111111111111111110110))

(assert (not (= expect result)))

(check-sat)
(exit)
