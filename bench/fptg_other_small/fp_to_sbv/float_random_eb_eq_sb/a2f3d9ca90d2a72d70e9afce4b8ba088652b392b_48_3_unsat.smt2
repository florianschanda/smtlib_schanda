(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv48
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg
                (fp #b1 #b000 #b11)))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg
                (fp #b0 #b000 #b00)))
; arg = -0.1875

(declare-const result (_ BitVec 48))
(assert (= result ((_ fp.to_sbv 48) rm arg)))

(declare-const expect (_ BitVec 48))
(assert (not (bvule expect #b111111111111111111111111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
