(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv4
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b1010 #b010)
                arg
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg
                (fp #b0 #b1000 #b001)))
; arg = -0

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule #b0001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
