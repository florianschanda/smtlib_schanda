; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0000)
                arg
                (fp #b1 #b10010 #b1010)))
(assert (fp.leq (fp #b1 #b10010 #b1010)
                arg
                (fp #b0 #b10001 #b1001)))
; arg = -13.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111111111111110010)))
(assert (not (bvule #b11111111111111111111111111110100 expect)))

(assert (= expect result))

(check-sat)
(exit)
