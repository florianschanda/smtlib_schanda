(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01001 #b1)
                arg
                (fp #b1 #b00111 #b1)))
(assert (fp.leq (fp #b1 #b00111 #b1)
                arg
                (fp #b0 #b11001 #b0)))
; arg = -0.005859375

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
