; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv4
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10100100 #b111011)
                arg
                (fp #b1 #b10000101 #b011101)))
(assert (fp.leq (fp #b1 #b10000101 #b011101)
                arg
                (fp #b0 #b01001110 #b000011)))
; arg = -93.0

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (= expect #b0010))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
