; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv14
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 3))
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))
; arg = Infinity

(declare-const result (_ BitVec 14))
(assert (= result ((_ fp.to_sbv 14) rm arg)))

(declare-const expect (_ BitVec 14))
(assert (not (bvule expect #b10101110001111)))
(assert (not (bvule #b10101110010001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
