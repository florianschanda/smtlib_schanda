(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv29
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                arg
                (fp #b0 #b010 #b0)))
(assert (fp.leq (fp #b0 #b010 #b0)
                arg
                (fp #b0 #b101 #b1)))
; arg = 0.5

(declare-const result (_ BitVec 29))
(assert (= result ((_ fp.to_sbv 29) rm arg)))

(declare-const expect (_ BitVec 29))
(assert (not (bvule #b00000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
