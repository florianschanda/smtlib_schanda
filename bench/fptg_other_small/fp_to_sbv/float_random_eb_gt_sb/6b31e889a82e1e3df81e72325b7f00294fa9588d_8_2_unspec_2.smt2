; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg
                (fp #b1 #b11001 #b00)))
(assert (fp.leq (fp #b1 #b11001 #b00)
                arg
                (fp #b0 #b11100 #b10)))
; arg = -1024.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b10101110)))
(assert (not (bvule #b10110000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
