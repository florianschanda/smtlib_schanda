;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10110000 #b0)
                arg
                (fp #b0 #b10111110 #b1)))
(assert (fp.leq (fp #b0 #b10111110 #b1)
                arg
                (fp #b0 #b11110001 #b0)))
; arg = 13835058055282163712.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b01110001111101011011011000000001)))
(assert (not (bvule #b01110001111101011011011000000011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

