(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv6
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                arg
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg
                (fp #b0 #b00100 #b1)))
; arg = -4.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b111011)))
(assert (not (bvule #b111101 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
