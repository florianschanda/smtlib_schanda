; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b01)
                arg
                (fp #b1 #b1001 #b00)))
(assert (fp.leq (fp #b1 #b1001 #b00)
                arg
                (fp #b0 #b0101 #b11)))
; arg = -4.0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b1111100))

(assert (not (= expect result)))

(check-sat)
(exit)
