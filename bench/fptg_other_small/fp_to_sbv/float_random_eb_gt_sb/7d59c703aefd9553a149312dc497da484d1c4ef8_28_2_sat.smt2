; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv28
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg
                (fp #b1 #b110 #b0)))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg
                (fp #b1 #b010 #b1)))
; arg = -8.0

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_sbv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (= expect #b1111111111111111111111111000))

(assert (= expect result))

(check-sat)
(exit)
