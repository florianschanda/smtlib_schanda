(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv31
; Arg1: +ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg
                (fp #b0 #b000 #b0)))
(assert (fp.leq (fp #b0 #b000 #b0)
                arg
                (fp #b0 #b111 #b0)))
; arg = 0.0

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_sbv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule #b0000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
