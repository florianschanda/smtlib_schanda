(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                arg
                (fp #b0 #b01101101 #b010)))
; arg = -1.5

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b11111110))

(assert (= expect result))

(check-sat)
(exit)
