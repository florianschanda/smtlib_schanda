(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv13
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111100 #b11)
                arg
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg
                (fp #b1 #b00011011 #b10)))
; arg = -3.0

(declare-const result (_ BitVec 13))
(assert (= result ((_ fp.to_sbv 13) rm arg)))

(declare-const expect (_ BitVec 13))
(assert (not (bvule expect #b1111111111100)))
(assert (not (bvule #b1111111111110 expect)))

(assert (= expect result))

(check-sat)
(exit)
