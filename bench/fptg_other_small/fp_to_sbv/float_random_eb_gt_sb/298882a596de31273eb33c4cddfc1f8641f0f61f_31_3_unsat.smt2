(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv31
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111000 #b01101)
                arg
                (fp #b1 #b0111111 #b11111)))
(assert (fp.leq (fp #b1 #b0111111 #b11111)
                arg
                (fp #b1 #b0111101 #b10010)))
; arg = -1.96875

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_sbv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule expect #b1111111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
