; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg
                (fp #b1 #b101 #b1)))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg
                (fp #b0 #b101 #b0)))
; arg = -6.0

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (= expect #b1111111111111010))

(assert (not (= expect result)))

(check-sat)
(exit)
