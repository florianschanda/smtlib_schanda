; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv37
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111100 #b10)
                arg
                (fp #b1 #b1001000 #b01)))
(assert (fp.leq (fp #b1 #b1001000 #b01)
                arg
                (fp #b1 #b0011100 #b01)))
; arg = -640.0

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_sbv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (not (bvule expect #b1111111111111111111111111110101111111)))
(assert (not (bvule #b1111111111111111111111111110110000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
