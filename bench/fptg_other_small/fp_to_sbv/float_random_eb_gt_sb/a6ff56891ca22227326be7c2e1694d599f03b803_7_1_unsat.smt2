(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg
                (fp #b0 #b001 #b1)))
(assert (fp.leq (fp #b0 #b001 #b1)
                arg
                (fp #b0 #b011 #b1)))
; arg = 0.375

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b0000000))

(assert (not (= expect result)))

(check-sat)
(exit)
