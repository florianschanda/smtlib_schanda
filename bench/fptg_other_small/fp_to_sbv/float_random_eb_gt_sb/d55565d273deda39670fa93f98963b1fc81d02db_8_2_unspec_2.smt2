; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                arg
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                arg
                (fp #b1 #b01110100 #b100)))
; arg = -319014718988379809496913694467282698240.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b10101011)))
(assert (not (bvule #b10101101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
