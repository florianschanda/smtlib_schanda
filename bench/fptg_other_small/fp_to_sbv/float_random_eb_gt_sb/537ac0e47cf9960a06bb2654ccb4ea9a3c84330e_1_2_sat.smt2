(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101001 #b00)
                arg
                (fp #b1 #b0111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111 #b11)
                arg
                (fp #b0 #b1001100 #b00)))
; arg = -1.75

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))

(check-sat)
(exit)
