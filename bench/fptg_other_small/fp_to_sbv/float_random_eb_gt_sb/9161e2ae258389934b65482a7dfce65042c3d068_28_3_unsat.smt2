; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv28
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00111 #b11)
                arg
                (fp #b1 #b00111 #b00)))
(assert (fp.leq (fp #b1 #b00111 #b00)
                arg
                (fp #b0 #b11100 #b10)))
; arg = -0.00390625

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_sbv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (not (bvule expect #b1111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
