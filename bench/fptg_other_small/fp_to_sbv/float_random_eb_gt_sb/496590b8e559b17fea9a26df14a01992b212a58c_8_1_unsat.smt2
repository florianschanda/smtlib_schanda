; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010011 #b000)
                arg
                (fp #b0 #b100010 #b101)))
(assert (fp.leq (fp #b0 #b100010 #b101)
                arg
                (fp #b0 #b111101 #b110)))
; arg = 13.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00001100)))
(assert (not (bvule #b00001110 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
