(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv24
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11000010 #b00)
                arg
                (fp #b1 #b01111111 #b11)))
(assert (fp.leq (fp #b1 #b01111111 #b11)
                arg
                (fp #b1 #b00101011 #b01)))
; arg = -1.75

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_sbv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (not (bvule expect #b111111111111111111111101)))
(assert (not (bvule #b111111111111111111111111 expect)))

(assert (= expect result))

(check-sat)
(exit)
