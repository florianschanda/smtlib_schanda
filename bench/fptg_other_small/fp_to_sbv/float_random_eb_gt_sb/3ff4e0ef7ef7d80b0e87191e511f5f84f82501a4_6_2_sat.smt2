; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv6
; Arg1: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000010 #b11)
                arg
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg
                (fp #b0 #b001000 #b00)))
; arg = 0.0000000004656612873077392578125

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (= expect #b000000))

(assert (= expect result))

(check-sat)
(exit)
