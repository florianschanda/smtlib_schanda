(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv5
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b01)
                arg
                (fp #b1 #b1010 #b00)))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg
                (fp #b0 #b1110 #b11)))
; arg = -8.0

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_sbv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b10111)))
(assert (not (bvule #b11001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
