; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv6
; Arg1: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b10)
                arg
                (fp #b0 #b1010 #b10)))
(assert (fp.leq (fp #b0 #b1010 #b10)
                arg
                (fp #b0 #b1101 #b10)))
; arg = 12.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (= expect #b001100))

(assert (not (= expect result)))

(check-sat)
(exit)
