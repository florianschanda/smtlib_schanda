; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv30
; Arg1: +RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100000 #b000)
                arg
                (fp #b0 #b000000 #b101)))
(assert (fp.leq (fp #b0 #b000000 #b101)
                arg
                (fp #b0 #b110000 #b111)))
; arg = 0.000000000582076609134674072265625

(declare-const result (_ BitVec 30))
(assert (= result ((_ fp.to_sbv 30) rm arg)))

(declare-const expect (_ BitVec 30))
(assert (not (bvule expect #b000000000000000000000000000000)))
(assert (not (bvule #b000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
