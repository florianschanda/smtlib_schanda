(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg
                (fp #b1 #b100 #b1)))
(assert (fp.leq (fp #b1 #b100 #b1)
                arg
                (fp #b0 #b111 #b0)))
; arg = -3.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111100)))
(assert (not (bvule #b11111110 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
