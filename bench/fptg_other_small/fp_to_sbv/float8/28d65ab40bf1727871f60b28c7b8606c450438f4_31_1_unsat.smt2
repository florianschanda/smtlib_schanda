; Format: FLOAT8
; Target: bv31
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg
                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg
                (fp #b0 #b000 #b1101)))
; arg = -15.5

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_sbv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (= expect #b1111111111111111111111111110000))

(assert (not (= expect result)))

(check-sat)
(exit)
