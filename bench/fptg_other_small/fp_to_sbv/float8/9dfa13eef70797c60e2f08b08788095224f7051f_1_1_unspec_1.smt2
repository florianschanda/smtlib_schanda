(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv1
; Arg1: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                arg
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg
                (fp #b0 #b111 #b0000)))
; arg = 15.5

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
