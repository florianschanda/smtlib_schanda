; Format: FLOAT8
; Target: bv7
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg
                (fp #b1 #b000 #b0000)))
; arg = -0.234375

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b0000000))

(assert (not (= expect result)))

(check-sat)
(exit)
