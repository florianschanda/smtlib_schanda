(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv39
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0111)
                arg
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg
                (fp #b1 #b101 #b0100)))
; arg = -9.5

(declare-const result (_ BitVec 39))
(assert (= result ((_ fp.to_sbv 39) rm arg)))

(declare-const expect (_ BitVec 39))
(assert (not (bvule expect #b111111111111111111111111111111111110110)))
(assert (not (bvule #b111111111111111111111111111111111111000 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
