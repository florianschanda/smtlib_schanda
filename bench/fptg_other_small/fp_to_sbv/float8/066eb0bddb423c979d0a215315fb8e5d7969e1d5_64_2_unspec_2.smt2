; Format: FLOAT8
; Target: bv64
; Arg1: -INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.isNegative arg))
(assert (fp.isInfinite arg))
; arg = -Infinity

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0010100001011010000101001011111010110111100111111011110100000000)))
(assert (not (bvule #b0010100001011010000101001011111010110111100111111011110100000010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
