(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv3
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg
                (fp #b1 #b011 #b1100)))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg
                (fp #b0 #b010 #b0111)))
; arg = -1.75

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (= expect #b111))

(assert (not (= expect result)))

(check-sat)
(exit)
