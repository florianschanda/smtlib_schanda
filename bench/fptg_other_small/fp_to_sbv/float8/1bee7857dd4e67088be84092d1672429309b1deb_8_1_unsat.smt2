(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv8
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg
                (fp #b1 #b011 #b0101)))
; arg = -3.875

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111011)))
(assert (not (bvule #b11111101 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
