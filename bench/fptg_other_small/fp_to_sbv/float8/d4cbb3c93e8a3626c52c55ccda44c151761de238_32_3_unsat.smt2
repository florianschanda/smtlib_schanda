; Format: FLOAT8
; Target: bv32
; Arg1: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg
                (fp #b0 #b011 #b1101)))
; arg = 0.125

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000001))

(assert (not (= expect result)))

(check-sat)
(exit)
