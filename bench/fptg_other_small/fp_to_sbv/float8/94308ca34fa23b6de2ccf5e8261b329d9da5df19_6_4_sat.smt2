(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv6
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                arg
                (fp #b0 #b001 #b0011)))
(assert (fp.leq (fp #b0 #b001 #b0011)
                arg
                (fp #b0 #b110 #b0011)))
; arg = 0.296875

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (= expect #b000001))

(assert (= expect result))

(check-sat)
(exit)
