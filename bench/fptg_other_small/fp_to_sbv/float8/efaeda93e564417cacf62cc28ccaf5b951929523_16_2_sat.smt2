(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg
                (fp #b0 #b110 #b1101)))
; arg = 6.0

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (not (bvule expect #b0000000000000101)))
(assert (not (bvule #b0000000000000111 expect)))

(assert (= expect result))

(check-sat)
(exit)
