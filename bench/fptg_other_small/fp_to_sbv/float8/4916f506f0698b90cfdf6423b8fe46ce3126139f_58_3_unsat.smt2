; Format: FLOAT8
; Target: bv58
; Arg1: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                arg
                (fp #b0 #b001 #b0110)))
; arg = -0.125

(declare-const result (_ BitVec 58))
(assert (= result ((_ fp.to_sbv 58) rm arg)))

(declare-const expect (_ BitVec 58))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
