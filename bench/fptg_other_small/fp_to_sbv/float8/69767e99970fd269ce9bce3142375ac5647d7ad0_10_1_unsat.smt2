(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv10
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b011 #b1110)
                arg
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                arg
                (fp #b0 #b000 #b1100)))
; arg = -0

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_sbv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (= expect #b0000000000))

(assert (not (= expect result)))

(check-sat)
(exit)
