(assert (= result ((_ fp.to_sbv 17) rm arg)))

(declare-const expect (_ BitVec 17))
(assert (not (bvule expect #b00000000000001111)))
(assert (not (bvule #b00000000000010001 expect)))

(assert (= expect result))

