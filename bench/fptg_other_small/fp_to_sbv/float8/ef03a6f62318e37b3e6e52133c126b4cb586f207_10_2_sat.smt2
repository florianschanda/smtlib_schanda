(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv10
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b101 #b1011)
                arg
                (fp #b0 #b110 #b0110)))
(assert (fp.leq (fp #b0 #b110 #b0110)
                arg
                (fp #b0 #b110 #b1111)))
; arg = 11.0

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_sbv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b0000001010)))
(assert (not (bvule #b0000001100 expect)))

(assert (= expect result))

(check-sat)
(exit)
