; Format: FLOAT16
; Target class: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: REAL_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Real)
(assert (<= arg1 (/ 1.0 128.0)))
(assert (<= (/ 1.0 128.0) arg1))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b1000001100)
                expect
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                expect
                (fp #b0 #b11100 #b1101010001)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
