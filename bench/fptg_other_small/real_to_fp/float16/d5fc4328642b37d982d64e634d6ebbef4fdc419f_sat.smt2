; Format: FLOAT16
; Target class: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: REAL_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Real)
(assert (<= arg1 (- (/ 1.0 65536.0))))
(assert (<= (- (/ 1.0 65536.0)) arg1))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                expect
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                expect
                (fp #b0 #b10001 #b1110111101)))
; expect = -0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
