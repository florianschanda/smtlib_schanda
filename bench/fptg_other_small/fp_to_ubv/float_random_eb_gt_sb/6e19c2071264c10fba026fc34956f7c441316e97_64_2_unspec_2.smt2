;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11000010 #b00)
                arg
                (fp #b1 #b01111111 #b11)))
(assert (fp.leq (fp #b1 #b01111111 #b11)
                arg
                (fp #b1 #b00101011 #b01)))
; arg = -1.75

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1010101010011011101001011100101110101110011010110100011100001000)))
(assert (not (bvule #b1010101010011011101001011100101110101110011010110100011100001010 expect)))

(assert (= expect result))
