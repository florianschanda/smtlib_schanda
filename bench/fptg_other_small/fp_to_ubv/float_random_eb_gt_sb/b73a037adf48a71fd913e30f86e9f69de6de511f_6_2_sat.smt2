(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv6
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                arg
                (fp #b0 #b101 #b1)))
; arg = 1.5

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b000000)))
(assert (not (bvule #b000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
