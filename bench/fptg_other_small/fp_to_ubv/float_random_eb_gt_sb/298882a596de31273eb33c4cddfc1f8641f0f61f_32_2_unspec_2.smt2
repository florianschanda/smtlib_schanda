; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111000 #b01101)
                arg
                (fp #b1 #b0111111 #b11111)))
(assert (fp.leq (fp #b1 #b0111111 #b11111)
                arg
                (fp #b1 #b0111101 #b10010)))
; arg = -1.96875

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00010111000111110011001110101100)))
(assert (not (bvule #b00010111000111110011001110101110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
