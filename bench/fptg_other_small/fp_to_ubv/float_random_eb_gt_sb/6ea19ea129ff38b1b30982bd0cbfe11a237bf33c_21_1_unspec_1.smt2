; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv21
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))
; arg = Infinity

(declare-const result (_ BitVec 21))
(assert (= result ((_ fp.to_ubv 21) rm arg)))

(declare-const expect (_ BitVec 21))
(assert (not (bvule expect #b011110111010100011001)))
(assert (not (bvule #b011110111010100011011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

