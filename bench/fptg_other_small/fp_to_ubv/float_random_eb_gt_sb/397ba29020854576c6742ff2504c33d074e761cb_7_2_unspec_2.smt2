; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111111 #b0000)
                arg
                (fp #b1 #b111110 #b1111)))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg
                (fp #b0 #b111100 #b0100)))
; arg = -4160749568.0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1111100)))
(assert (not (bvule #b1111110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
