; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10010011 #b0)
                arg
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg
                (fp #b0 #b00110000 #b0)))
; arg = -3.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0111101100001010110000001100111110011111010111111010110011110101)))
(assert (not (bvule #b0111101100001010110000001100111110011111010111111010110011110111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

