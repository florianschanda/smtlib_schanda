;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111100 #b10)
                arg
                (fp #b1 #b1001000 #b01)))
(assert (fp.leq (fp #b1 #b1001000 #b01)
                arg
                (fp #b1 #b0011100 #b01)))
; arg = -640.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00001100))

(assert (= expect result))
