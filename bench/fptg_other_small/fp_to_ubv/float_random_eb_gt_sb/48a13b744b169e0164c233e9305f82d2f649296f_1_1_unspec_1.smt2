; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b1)
                arg
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg
                (fp #b0 #b10000 #b0)))
; arg = -192.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

