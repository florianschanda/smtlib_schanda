(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg
                (fp #b0 #b1110 #b1)))
; arg = 64.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00111111)))
(assert (not (bvule #b01000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
