; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv37
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101101 #b10)
                arg
                (fp #b1 #b011111 #b01)))
(assert (fp.leq (fp #b1 #b011111 #b01)
                arg
                (fp #b0 #b100000 #b10)))
; arg = -1.25

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_ubv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (not (bvule expect #b0100110101010111001100110010000000100)))
(assert (not (bvule #b0100110101010111001100110010000000110 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
