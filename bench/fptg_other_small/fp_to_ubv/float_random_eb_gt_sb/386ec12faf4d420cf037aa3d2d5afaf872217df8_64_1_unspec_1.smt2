;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg
                (fp #b1 #b0111 #b01)))
(assert (fp.leq (fp #b1 #b0111 #b01)
                arg
                (fp #b0 #b1101 #b11)))
; arg = -1.25

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0101001011011010010011101100001110110100001111111111000101111100)))
(assert (not (bvule #b0101001011011010010011101100001110110100001111111111000101111110 expect)))

(assert (not (= expect result)))
