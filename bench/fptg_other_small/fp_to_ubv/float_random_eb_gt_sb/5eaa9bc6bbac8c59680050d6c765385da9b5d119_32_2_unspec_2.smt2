; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1001110 #b1011)
                arg
                (fp #b1 #b0111111 #b0000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000)
                arg
                (fp #b1 #b0001110 #b0001)))
; arg = -1.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b10000011001011010111000111110110)))
(assert (not (bvule #b10000011001011010111000111111000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
