; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv14
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg
                (fp #b1 #b100 #b1)))
(assert (fp.leq (fp #b1 #b100 #b1)
                arg
                (fp #b0 #b111 #b0)))
; arg = -3.0

(declare-const result (_ BitVec 14))
(assert (= result ((_ fp.to_ubv 14) rm arg)))

(declare-const expect (_ BitVec 14))
(assert (not (bvule expect #b00111101101110)))
(assert (not (bvule #b00111101110000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
