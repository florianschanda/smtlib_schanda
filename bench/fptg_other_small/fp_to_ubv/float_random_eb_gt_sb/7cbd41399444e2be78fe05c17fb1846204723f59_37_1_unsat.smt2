(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv37
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b01)
                arg
                (fp #b0 #b1010 #b00)))
(assert (fp.leq (fp #b0 #b1010 #b00)
                arg
                (fp #b0 #b1010 #b01)))
; arg = 8.0

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_ubv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (not (bvule expect #b0000000000000000000000000000000000111)))
(assert (not (bvule #b0000000000000000000000000000000001001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
