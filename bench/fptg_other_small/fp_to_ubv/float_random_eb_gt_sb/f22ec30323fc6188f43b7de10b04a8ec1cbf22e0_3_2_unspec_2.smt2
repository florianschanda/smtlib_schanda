; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv3
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1100 #b1)
                arg
                (fp #b1 #b1001 #b1)))
(assert (fp.leq (fp #b1 #b1001 #b1)
                arg
                (fp #b1 #b1000 #b0)))
; arg = -6.0

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b101)))
(assert (not (bvule #b111 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
