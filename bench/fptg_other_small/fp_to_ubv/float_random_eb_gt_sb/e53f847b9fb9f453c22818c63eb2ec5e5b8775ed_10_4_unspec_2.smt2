;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b10)
                arg
                (fp #b1 #b000000 #b11)))
(assert (fp.leq (fp #b1 #b000000 #b11)
                arg
                (fp #b0 #b110101 #b01)))
; arg = -0.00000000069849193096160888671875

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_ubv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (= expect #b0100100110))

(assert (= expect result))
