(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv53
; Arg1: +ZERO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 4))
(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b0011011 #b001)
                arg
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg
                (fp #b0 #b1100010 #b011)))
; arg = 0.0

(declare-const result (_ BitVec 53))
(assert (= result ((_ fp.to_ubv 53) rm arg)))

(declare-const expect (_ BitVec 53))
(assert (not (bvule #b00000000000000000000000000000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
