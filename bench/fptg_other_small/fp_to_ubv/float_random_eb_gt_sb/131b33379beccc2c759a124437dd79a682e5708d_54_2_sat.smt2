; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv54
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00000 #b001)
                arg
                (fp #b0 #b10010 #b111)))
(assert (fp.leq (fp #b0 #b10010 #b111)
                arg
                (fp #b0 #b11000 #b011)))
; arg = 15.0

(declare-const result (_ BitVec 54))
(assert (= result ((_ fp.to_ubv 54) rm arg)))

(declare-const expect (_ BitVec 54))
(assert (not (bvule expect #b000000000000000000000000000000000000000000000000001110)))
(assert (not (bvule #b000000000000000000000000000000000000000000000000010000 expect)))

(assert (= expect result))

(check-sat)
(exit)
