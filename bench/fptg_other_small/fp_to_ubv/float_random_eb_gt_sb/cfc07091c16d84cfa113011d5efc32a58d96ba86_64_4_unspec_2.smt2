; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b100)
                arg
                (fp #b1 #b00000 #b011)))
(assert (fp.leq (fp #b1 #b00000 #b011)
                arg
                (fp #b0 #b11000 #b001)))
; arg = -0.00002288818359375

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b0001110100101010011011011011010111111010001000000000011101001011))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
