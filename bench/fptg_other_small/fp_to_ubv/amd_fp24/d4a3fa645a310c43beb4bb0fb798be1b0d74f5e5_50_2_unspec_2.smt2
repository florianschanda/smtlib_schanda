(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1001000011110011)
                arg
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg
                (fp #b0 #b0111110 #b1111001010000010)))
; arg = -131072.0

(declare-const result (_ BitVec 50))
(assert (= result ((_ fp.to_ubv 50) rm arg)))

(declare-const expect (_ BitVec 50))
(assert (not (bvule expect #b10110100001100011011000110100111110010001001000011)))
(assert (not (bvule #b10110100001100011011000110100111110010001001000101 expect)))

(assert (= expect result))
