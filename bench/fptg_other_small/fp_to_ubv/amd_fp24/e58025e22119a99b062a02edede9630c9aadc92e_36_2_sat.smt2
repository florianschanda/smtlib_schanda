;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110000 #b0000111110100110)
                arg
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg
                (fp #b0 #b1101110 #b1000010000011001)))
; arg = 357453824.0

(declare-const result (_ BitVec 36))
(assert (= result ((_ fp.to_ubv 36) rm arg)))

(declare-const expect (_ BitVec 36))
(assert (not (bvule expect #b000000010101010011100100111111111111)))
(assert (not (bvule #b000000010101010011100101000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
