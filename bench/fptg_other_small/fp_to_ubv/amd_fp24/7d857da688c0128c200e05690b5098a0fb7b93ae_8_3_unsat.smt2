; Format: AMD_FP24
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b1100001101000011)
                arg
                (fp #b0 #b0111111 #b1000110111010011)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110111010011)
                arg
                (fp #b0 #b1110100 #b1111101110001000)))
; arg = 1.5540008544921875

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000001)))
(assert (not (bvule #b00000011 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
