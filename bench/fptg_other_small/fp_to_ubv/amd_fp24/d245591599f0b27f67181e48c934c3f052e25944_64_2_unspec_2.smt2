(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001110 #b1010010111101110)
                arg
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg
                (fp #b1 #b0010010 #b0000101000000010)))
; arg = -1.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1000110010110000111101011010000010111101010010101010101110101110)))
(assert (not (bvule #b1000110010110000111101011010000010111101010010101010101110110000 expect)))

(assert (= expect result))
