; Format: AMD_FP24
; Target: bv32
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b1001000111100111)
                arg
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg
                (fp #b0 #b1101101 #b1101111000111111)))
; arg = 4294934528.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111110111111111111111)))
(assert (not (bvule #b11111111111111111000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
