; Format: AMD_FP24
; Target: bv32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0011100101001010)
                arg
                (fp #b1 #b1001110 #b1001100011111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1001100011111110)
                arg
                (fp #b0 #b0010010 #b1010111011100101)))
; arg = -52351.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00001000000000111001110001001110)))
(assert (not (bvule #b00001000000000111001110001010000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
