(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0100010010000000)
                arg
                (fp #b1 #b1100000 #b1001011101101101)))
(assert (fp.leq (fp #b1 #b1100000 #b1001011101101101)
                arg
                (fp #b1 #b1000001 #b1011101001001010)))
; arg = -13670940672.0

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_ubv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (not (bvule expect #b100010110010110)))
(assert (not (bvule #b100010110011000 expect)))

(assert (= expect result))
