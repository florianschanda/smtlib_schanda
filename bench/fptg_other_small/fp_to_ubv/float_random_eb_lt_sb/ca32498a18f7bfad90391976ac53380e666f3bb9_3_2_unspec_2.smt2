(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv3
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b010 #b11100110010)
                arg
                (fp #b0 #b110 #b01010011000)))
(assert (fp.leq (fp #b0 #b110 #b01010011000)
                arg
                (fp #b0 #b110 #b01100010110)))
; arg = 10.59375

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b011)))
(assert (not (bvule #b101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
