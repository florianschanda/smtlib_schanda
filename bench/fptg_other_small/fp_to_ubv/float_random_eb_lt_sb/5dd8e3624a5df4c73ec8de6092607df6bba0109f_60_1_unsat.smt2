; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv60
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 2 9))
(assert (fp.leq (fp #b1 #b01 #b11111110)
                arg
                (fp #b1 #b00 #b10111100)))
(assert (fp.leq (fp #b1 #b00 #b10111100)
                arg
                (fp #b1 #b00 #b01011100)))
; arg = -0.734375

(declare-const result (_ BitVec 60))
(assert (= result ((_ fp.to_ubv 60) rm arg)))

(declare-const expect (_ BitVec 60))
(assert (not (bvule #b000000000000000000000000000000000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
