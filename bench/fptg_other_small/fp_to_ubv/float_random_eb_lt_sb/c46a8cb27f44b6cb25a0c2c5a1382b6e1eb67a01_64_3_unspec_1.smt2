(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 4 15))
(assert (fp.leq (fp #b1 #b1101 #b00110001100100)
                arg
                (fp #b1 #b0000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b0000 #b00111010110000)
                arg
                (fp #b0 #b0000 #b01010111110110)))
; arg = -0.0035858154296875

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b0000111000001101000011100111011001111011111110001101111100100101))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

