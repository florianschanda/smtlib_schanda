(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv4
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 6 20))
(assert (fp.leq (fp #b1 #b001111 #b1101011111010011111)
                arg
                (fp #b1 #b000000 #b1001011011011001111)))
(assert (fp.leq (fp #b1 #b000000 #b1001011011011001111)
                arg
                (fp #b0 #b000001 #b1100100101001011001)))
; arg = -0.0000000005487930110348315793089568614959716796875

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_ubv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b1001)))
(assert (not (bvule #b1011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
