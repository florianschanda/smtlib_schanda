; Format: TENSORFLOAT32
; Target: bv8
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b0100101010)
                arg
                (fp #b1 #b10100101 #b0111110000)))
(assert (fp.leq (fp #b1 #b10100101 #b0111110000)
                arg
                (fp #b1 #b00111101 #b1101101100)))
; arg = -408021893120.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b10001100)))
(assert (not (bvule #b10001110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
