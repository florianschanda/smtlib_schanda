; Format: TENSORFLOAT32
; Target: bv9
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1011011110)
                arg
                (fp #b1 #b10001000 #b1100000110)))
(assert (fp.leq (fp #b1 #b10001000 #b1100000110)
                arg
                (fp #b0 #b01000110 #b0010100001)))
; arg = -899.0

(declare-const result (_ BitVec 9))
(assert (= result ((_ fp.to_ubv 9) rm arg)))

(declare-const expect (_ BitVec 9))
(assert (not (bvule expect #b001100001)))
(assert (not (bvule #b001100011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
