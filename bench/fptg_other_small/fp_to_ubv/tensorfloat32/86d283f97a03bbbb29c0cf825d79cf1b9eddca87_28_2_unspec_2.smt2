; Format: TENSORFLOAT32
; Target: bv28
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101111 #b1001000001)
                arg
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                arg
                (fp #b1 #b01110011 #b1111001100)))
; arg = -13270717221139276546918611681280.0

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_ubv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (not (bvule expect #b0010100101110101110001101000)))
(assert (not (bvule #b0010100101110101110001101010 expect)))

(assert (= expect result))
