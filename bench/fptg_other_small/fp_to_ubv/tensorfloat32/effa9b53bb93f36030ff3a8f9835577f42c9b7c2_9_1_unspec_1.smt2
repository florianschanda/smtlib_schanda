; Format: TENSORFLOAT32
; Target: bv9
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b1000001000)
                arg
                (fp #b1 #b10001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0000110001)
                arg
                (fp #b1 #b01111010 #b1011101100)))
; arg = -1073.0

(declare-const result (_ BitVec 9))
(assert (= result ((_ fp.to_ubv 9) rm arg)))

(declare-const expect (_ BitVec 9))
(assert (not (bvule expect #b011111101)))
(assert (not (bvule #b011111111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
