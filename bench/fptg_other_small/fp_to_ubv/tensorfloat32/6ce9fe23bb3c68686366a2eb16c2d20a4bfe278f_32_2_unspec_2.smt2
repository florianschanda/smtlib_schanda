; Format: TENSORFLOAT32
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0001100010)
                arg
                (fp #b1 #b01111111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010001010)
                arg
                (fp #b1 #b01100001 #b0010000111)))
; arg = -1.134765625

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111101111111111101000101001111)))
(assert (not (bvule #b11111101111111111101000101010001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
