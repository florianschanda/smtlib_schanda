(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                arg
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                arg
                (fp #b0 #b01101 #b1111101100)))
; arg = -193.75

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00100110000010001110111110110001))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

