(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv45
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101101000)
                arg
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg
                (fp #b0 #b11010 #b1101001101)))
; arg = -0.000244140625

(declare-const result (_ BitVec 45))
(assert (= result ((_ fp.to_ubv 45) rm arg)))

(declare-const expect (_ BitVec 45))
(assert (not (bvule expect #b100011010001010101011011110111101100100111000)))
(assert (not (bvule #b100011010001010101011011110111101100100111010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
