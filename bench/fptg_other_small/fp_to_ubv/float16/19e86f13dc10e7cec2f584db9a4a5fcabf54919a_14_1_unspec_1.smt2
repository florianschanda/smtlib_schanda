; Format: FLOAT16
; Target: bv14
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000101100)
                arg
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg
                (fp #b0 #b01110 #b1111100010)))
; arg = -1.98828125

(declare-const result (_ BitVec 14))
(assert (= result ((_ fp.to_ubv 14) rm arg)))

(declare-const expect (_ BitVec 14))
(assert (not (bvule expect #b11011000010110)))
(assert (not (bvule #b11011000011000 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
