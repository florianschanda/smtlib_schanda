(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv6
; Arg1: -INFINITY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.isNegative arg))
(assert (fp.isInfinite arg))
; arg = -Infinity

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b100101)))
(assert (not (bvule #b100111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
