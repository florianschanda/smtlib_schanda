; Format: FLOAT16
; Target: bv64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg
                (fp #b0 #b11100 #b0100000100)))
; arg = 1394.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0000000000000000000000000000000000000000000000000000010101110001)))
(assert (not (bvule #b0000000000000000000000000000000000000000000000000000010101110011 expect)))

(assert (= expect result))

(check-sat)
(exit)
