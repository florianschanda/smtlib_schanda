; Format: FLOAT16
; Target: bv44
; Arg1: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                arg
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg
                (fp #b0 #b10001 #b1110111101)))
; arg = -0.0000152587890625

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_ubv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (= expect #b01110111000011001000110111010111100100111000))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
