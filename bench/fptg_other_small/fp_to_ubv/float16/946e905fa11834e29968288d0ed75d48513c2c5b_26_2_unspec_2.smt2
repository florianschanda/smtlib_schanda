(assert (fp.leq (fp #b1 #b11100 #b1111011110)
                arg
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg
                (fp #b0 #b10100 #b0001011101)))
