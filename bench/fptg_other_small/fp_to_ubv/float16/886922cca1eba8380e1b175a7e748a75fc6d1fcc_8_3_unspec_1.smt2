; Format: FLOAT16
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01111 #b1101010110)
                arg
                (fp #b1 #b00010 #b1001100111)))
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                arg
                (fp #b0 #b11110 #b0011110100)))
; arg = -0.00019538402557373046875

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00010001))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
