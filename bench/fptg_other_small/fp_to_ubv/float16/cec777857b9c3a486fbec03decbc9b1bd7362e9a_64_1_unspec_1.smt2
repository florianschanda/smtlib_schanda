; Format: FLOAT16
; Target: bv64
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))
; arg = Infinity

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1011011011011111110011101111000101000010110110110010110010001011))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
