(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv26
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                arg
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg
                (fp #b0 #b10011 #b1100111011)))
; arg = -0.00006103515625

(declare-const result (_ BitVec 26))
(assert (= result ((_ fp.to_ubv 26) rm arg)))

(declare-const expect (_ BitVec 26))
(assert (not (bvule expect #b00101000001010011011100111)))
(assert (not (bvule #b00101000001010011011101001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
