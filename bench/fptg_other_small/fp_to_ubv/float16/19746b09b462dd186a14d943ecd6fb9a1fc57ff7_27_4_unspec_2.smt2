; Format: FLOAT16
; Target: bv27
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111110000)
                arg
                (fp #b1 #b00100 #b0101100101)))
(assert (fp.leq (fp #b1 #b00100 #b0101100101)
                arg
                (fp #b0 #b00100 #b0000100001)))
; arg = -0.000658512115478515625

(declare-const result (_ BitVec 27))
(assert (= result ((_ fp.to_ubv 27) rm arg)))

(declare-const expect (_ BitVec 27))
(assert (= expect #b101001101100101111010100101))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
