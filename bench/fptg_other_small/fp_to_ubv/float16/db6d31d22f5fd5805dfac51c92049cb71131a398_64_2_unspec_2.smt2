; Format: FLOAT16
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11100 #b1010010101)
                arg
                (fp #b1 #b01111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111 #b0100110000)
                arg
                (fp #b0 #b10111 #b0011000011)))
; arg = -1.296875

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0001011101010110110001111010010100100100101110111001101100000001)))
(assert (not (bvule #b0001011101010110110001111010010100100100101110111001101100000011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
