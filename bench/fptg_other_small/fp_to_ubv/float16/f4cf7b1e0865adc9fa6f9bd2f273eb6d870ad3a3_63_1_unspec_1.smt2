; Format: FLOAT16
; Target: bv63
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                arg
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                arg
                (fp #b0 #b01010 #b1100110000)))
; arg = -1073.0

(declare-const result (_ BitVec 63))
(assert (= result ((_ fp.to_ubv 63) rm arg)))

(declare-const expect (_ BitVec 63))
(assert (not (bvule expect #b010010101110000001001000111110001101010000111101101001100111001)))
(assert (not (bvule #b010010101110000001001000111110001101010000111101101001100111011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
