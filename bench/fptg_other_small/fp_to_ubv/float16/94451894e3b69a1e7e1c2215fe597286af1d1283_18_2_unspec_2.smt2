(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv18
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010110111)
                arg
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg
                (fp #b0 #b11001 #b1001000001)))
; arg = -933.0

(declare-const result (_ BitVec 18))
(assert (= result ((_ fp.to_ubv 18) rm arg)))

(declare-const expect (_ BitVec 18))
(assert (not (bvule expect #b100101100111101011)))
(assert (not (bvule #b100101100111101101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
