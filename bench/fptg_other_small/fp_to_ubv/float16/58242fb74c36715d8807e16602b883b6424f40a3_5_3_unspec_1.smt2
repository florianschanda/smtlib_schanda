; Format: FLOAT16
; Target: bv5
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10101 #b1100101111)
                arg
                (fp #b1 #b00001 #b1101110110)))
(assert (fp.leq (fp #b1 #b00001 #b1101110110)
                arg
                (fp #b0 #b10011 #b1001110010)))
; arg = -0.00011384487152099609375

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b11001)))
(assert (not (bvule #b11011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
