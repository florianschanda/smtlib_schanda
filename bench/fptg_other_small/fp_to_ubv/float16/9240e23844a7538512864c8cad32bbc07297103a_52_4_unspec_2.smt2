(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv52
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01000 #b0101000011)
                arg
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg
                (fp #b1 #b00101 #b1011111001)))
; arg = -0.0078125

(declare-const result (_ BitVec 52))
(assert (= result ((_ fp.to_ubv 52) rm arg)))

(declare-const expect (_ BitVec 52))
(assert (not (bvule expect #b1110010001000001110011000110011000001101011011110111)))
(assert (not (bvule #b1110010001000001110011000110011000001101011011111001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
