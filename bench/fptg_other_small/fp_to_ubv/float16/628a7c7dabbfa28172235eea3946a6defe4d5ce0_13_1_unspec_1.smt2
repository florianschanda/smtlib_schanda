; Format: FLOAT16
; Target: bv13
; Arg1: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101001010)
                arg
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg
                (fp #b0 #b01101 #b1101100111)))
; arg = -16384.0

(declare-const result (_ BitVec 13))
(assert (= result ((_ fp.to_ubv 13) rm arg)))

(declare-const expect (_ BitVec 13))
(assert (= expect #b1010000110110))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
