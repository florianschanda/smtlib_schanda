; Format: FLOAT16
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111110)
                arg
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg
                (fp #b1 #b00101 #b1001111111)))
; arg = -1.203125

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
