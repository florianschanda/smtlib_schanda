; Format: FLOAT16
; Target: bv44
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100110000)
                arg
                (fp #b1 #b11011 #b1100100001)))
(assert (fp.leq (fp #b1 #b11011 #b1100100001)
                arg
                (fp #b1 #b10101 #b1011100010)))
; arg = -7300.0

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_ubv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (not (bvule expect #b10011001011000110001111000110011010010101001)))
(assert (not (bvule #b10011001011000110001111000110011010010101011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
