; Format: FLOAT16
; Target: bv64
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010111110)
                arg
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                arg
                (fp #b0 #b00111 #b0010000111)))
; arg = -0.000008404254913330078125

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0111110011010111110001001011100010010101100110000100110010011100)))
(assert (not (bvule #b0111110011010111110001001011100010010101100110000100110010011110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
