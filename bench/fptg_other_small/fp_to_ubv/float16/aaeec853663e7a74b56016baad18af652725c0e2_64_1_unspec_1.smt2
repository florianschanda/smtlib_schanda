(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                arg
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                arg
                (fp #b0 #b01101 #b1111101100)))
; arg = -193.75

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1011000000101101000011000010001111010101001001100010010110100010)))
(assert (not (bvule #b1011000000101101000011000010001111010101001001100010010110100100 expect)))

(assert (not (= expect result)))
