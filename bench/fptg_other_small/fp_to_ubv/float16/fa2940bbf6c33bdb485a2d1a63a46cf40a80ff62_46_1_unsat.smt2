; Format: FLOAT16
; Target: bv46
; Arg1: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01011 #b1011011100)
                arg
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg
                (fp #b0 #b11101 #b1101010110)))
; arg = 16384.0

(declare-const result (_ BitVec 46))
(assert (= result ((_ fp.to_ubv 46) rm arg)))

(declare-const expect (_ BitVec 46))
(assert (not (bvule expect #b0000000000000000000000000000000011111111111111)))
(assert (not (bvule #b0000000000000000000000000000000100000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
