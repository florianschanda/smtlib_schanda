(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                arg
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg
                (fp #b1 #b01111 #b1000100111)))
; arg = -255.875

(declare-const result (_ BitVec 46))
(assert (= result ((_ fp.to_ubv 46) rm arg)))

(declare-const expect (_ BitVec 46))
(assert (= expect #b0110000000110100111011111100001101011100001000))

(assert (= expect result))
