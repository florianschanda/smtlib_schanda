(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000101100)
                arg
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg
                (fp #b0 #b01110 #b1111100010)))
; arg = -1.98828125

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00010110)))
(assert (not (bvule #b00011000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
