; Format: FLOAT16
; Target: bv43
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111111)
                arg
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg
                (fp #b1 #b00000 #b0101101101)))
; arg = -2048.0

(declare-const result (_ BitVec 43))
(assert (= result ((_ fp.to_ubv 43) rm arg)))

(declare-const expect (_ BitVec 43))
(assert (= expect #b0000110111100011101100110110000001101000000))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

