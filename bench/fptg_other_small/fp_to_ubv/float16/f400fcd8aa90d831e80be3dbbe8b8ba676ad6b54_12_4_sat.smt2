; Format: FLOAT16
; Target: bv12
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b00000 #b1110101010)
                arg
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg
                (fp #b0 #b10011 #b1001001111)))
; arg = 1.3701171875

(declare-const result (_ BitVec 12))
(assert (= result ((_ fp.to_ubv 12) rm arg)))

(declare-const expect (_ BitVec 12))
(assert (not (bvule expect #b000000000001)))
(assert (not (bvule #b000000000011 expect)))

(assert (= expect result))

(check-sat)
(exit)
