; Format: FLOAT16
; Target: bv64
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg
                (fp #b0 #b11100 #b0011010100)))
; arg = -65504.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1101011011001100100010010011110010101111110111101000111101001111)))
(assert (not (bvule #b1101011011001100100010010011110010101111110111101000111101010001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
