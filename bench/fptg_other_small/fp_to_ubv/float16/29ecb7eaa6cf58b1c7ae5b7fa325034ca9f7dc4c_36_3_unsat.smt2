(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Target: bv36
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10000 #b1111111001)
                arg
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg
                (fp #b0 #b01101 #b0001111101)))
; arg = 0.000000059604644775390625

(declare-const result (_ BitVec 36))
(assert (= result ((_ fp.to_ubv 36) rm arg)))

(declare-const expect (_ BitVec 36))
(assert (not (bvule expect #b000000000000000000000000000000000000)))
(assert (not (bvule #b000000000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
