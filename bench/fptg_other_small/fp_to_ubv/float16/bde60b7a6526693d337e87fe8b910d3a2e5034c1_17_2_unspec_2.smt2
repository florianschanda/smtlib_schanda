;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11100 #b0100001001)
                arg
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg
                (fp #b0 #b00011 #b0011101110)))
; arg = -1.0

(declare-const result (_ BitVec 17))
(assert (= result ((_ fp.to_ubv 17) rm arg)))

(declare-const expect (_ BitVec 17))
(assert (= expect #b10000110001010011))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

