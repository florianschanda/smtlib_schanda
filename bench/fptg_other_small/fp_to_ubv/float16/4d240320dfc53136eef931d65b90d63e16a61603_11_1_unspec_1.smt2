(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv11
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11101 #b0101101011)
                arg
                (fp #b1 #b11010 #b1011001111)))
(assert (fp.leq (fp #b1 #b11010 #b1011001111)
                arg
                (fp #b0 #b01111 #b1011000101)))
; arg = -3486.0

(declare-const result (_ BitVec 11))
(assert (= result ((_ fp.to_ubv 11) rm arg)))

(declare-const expect (_ BitVec 11))
(assert (not (bvule expect #b10111001110)))
(assert (not (bvule #b10111010000 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
