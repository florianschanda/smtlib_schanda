;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010111110)
                arg
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                arg
                (fp #b0 #b00111 #b0010000111)))
; arg = -0.000008404254913330078125

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_ubv 31) rm arg)))

(declare-const expect (_ BitVec 31))
