; Format: FLOAT16
; Target: bv1
; Arg1: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101001011)
                arg
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg
                (fp #b1 #b01000 #b1010011001)))
; arg = -7412.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
