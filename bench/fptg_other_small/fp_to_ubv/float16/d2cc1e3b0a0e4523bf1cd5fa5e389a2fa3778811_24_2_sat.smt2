(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv24
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111110111)
                arg
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg
                (fp #b0 #b11110 #b1010100111)))
; arg = 1.59765625

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_ubv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (= expect #b000000000000000000000001))

(assert (= expect result))

(check-sat)
(exit)
