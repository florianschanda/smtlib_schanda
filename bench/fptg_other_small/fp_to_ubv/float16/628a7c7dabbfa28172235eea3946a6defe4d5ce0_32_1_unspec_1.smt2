(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Target: bv32
; Arg1: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101001010)
                arg
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg
                (fp #b0 #b01101 #b1101100111)))
; arg = -16384.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11011011011100011110100001101100)))
(assert (not (bvule #b11011011011100011110100001101110 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
