; Format: FLOAT16
; Target: bv64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float16)
(assert (fp.leq (fp #b1 #b01011 #b1111100101)
                arg
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                arg
                (fp #b0 #b11010 #b1111100111)))
; arg = 2035.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0000000000000000000000000000000000000000000000000000011111110010)))
(assert (not (bvule #b0000000000000000000000000000000000000000000000000000011111110100 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
