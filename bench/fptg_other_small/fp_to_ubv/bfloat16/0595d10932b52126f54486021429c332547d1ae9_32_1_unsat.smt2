;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010100 #b1011011)
                arg
                (fp #b0 #b01111111 #b1011011)))
(assert (fp.leq (fp #b0 #b01111111 #b1011011)
                arg
                (fp #b0 #b10001100 #b1110000)))
; arg = 1.7109375

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
