; Format: BFLOAT16
; Target: bv6
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1100100)
                arg
                (fp #b1 #b11011101 #b1101001)))
(assert (fp.leq (fp #b1 #b11011101 #b1101001)
                arg
                (fp #b0 #b10001110 #b1111100)))
; arg = -36055003644186700506436993024.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b100000)))
(assert (not (bvule #b100010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
