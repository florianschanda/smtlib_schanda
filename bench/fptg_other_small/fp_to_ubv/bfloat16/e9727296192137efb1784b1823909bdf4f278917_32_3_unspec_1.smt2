; Format: BFLOAT16
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1101100)
                arg
                (fp #b1 #b01010110 #b0010101)))
(assert (fp.leq (fp #b1 #b01010110 #b0010101)
                arg
                (fp #b0 #b00000100 #b1010001)))
; arg = -0.000000000000529354338141274638473987579345703125

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b10000110110111011001000001101101)))
(assert (not (bvule #b10000110110111011001000001101111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
