(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b1101111)
                arg
                (fp #b1 #b01111111 #b0000001)))
(assert (fp.leq (fp #b1 #b01111111 #b0000001)
                arg
                (fp #b0 #b00001110 #b1000011)))
; arg = -1.0078125

(declare-const result (_ BitVec 32))
