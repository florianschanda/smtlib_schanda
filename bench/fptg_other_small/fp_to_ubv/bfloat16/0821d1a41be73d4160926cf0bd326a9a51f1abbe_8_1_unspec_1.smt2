(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10000110 #b1000010)
                arg
                (fp #b0 #b11111100 #b1110101)))
(assert (fp.leq (fp #b0 #b11111100 #b1110101)
                arg
                (fp #b0 #b11111101 #b0000001)))
; arg = 81415214741826097215358182442171105280.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b10001111)))
(assert (not (bvule #b10010001 expect)))

(assert (not (= expect result)))
