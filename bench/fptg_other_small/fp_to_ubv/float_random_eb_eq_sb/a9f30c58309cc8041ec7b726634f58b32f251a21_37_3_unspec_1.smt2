(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv37
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg
                (fp #b1 #b010 #b11)))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg
                (fp #b1 #b010 #b01)))
; arg = -0.875

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_ubv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (= expect #b0010000011100011000101100011010111101))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
