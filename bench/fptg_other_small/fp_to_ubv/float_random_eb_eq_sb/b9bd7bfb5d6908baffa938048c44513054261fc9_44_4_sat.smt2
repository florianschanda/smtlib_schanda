; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv44
; Arg1: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b1001)
                arg
                (fp #b0 #b00001 #b0000)))
(assert (fp.leq (fp #b0 #b00001 #b0000)
                arg
                (fp #b0 #b10101 #b1011)))
; arg = 0.00006103515625

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_ubv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (not (bvule expect #b00000000000000000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
