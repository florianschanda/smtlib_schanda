(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv43
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg
                (fp #b0 #b101 #b00)))
; arg = -0.5

(declare-const result (_ BitVec 43))
(assert (= result ((_ fp.to_ubv 43) rm arg)))

(declare-const expect (_ BitVec 43))
(assert (not (bvule expect #b1111100000011110011011100100110000110111000)))
(assert (not (bvule #b1111100000011110011011100100110000110111010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
