; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv3
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0100 #b100)
                arg
                (fp #b0 #b1010 #b110)))
(assert (fp.leq (fp #b0 #b1010 #b110)
                arg
                (fp #b0 #b1110 #b010)))
; arg = 14.0

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b011)))
(assert (not (bvule #b101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
