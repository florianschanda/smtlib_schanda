; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00010)
                arg
                (fp #b1 #b100100 #b11000)))
(assert (fp.leq (fp #b1 #b100100 #b11000)
                arg
                (fp #b0 #b100110 #b11011)))
; arg = -56.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b01001010100001000011001000001001)))
(assert (not (bvule #b01001010100001000011001000001011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
