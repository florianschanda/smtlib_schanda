(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg
                (fp #b0 #b0000 #b101)))
; arg = -0.001953125

(declare-const result (_ BitVec 55))
(assert (= result ((_ fp.to_ubv 55) rm arg)))

(declare-const expect (_ BitVec 55))
(assert (= expect #b0010101110011110111000011001101110101101110001011010011))

(assert (= expect result))
