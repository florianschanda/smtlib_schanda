(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv12
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg
                (fp #b0 #b1000 #b101)))
(assert (fp.leq (fp #b0 #b1000 #b101)
                arg
                (fp #b0 #b1110 #b000)))
; arg = 3.25

(declare-const result (_ BitVec 12))
(assert (= result ((_ fp.to_ubv 12) rm arg)))

(declare-const expect (_ BitVec 12))
(assert (not (bvule expect #b000000000011)))
(assert (not (bvule #b000000000101 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
