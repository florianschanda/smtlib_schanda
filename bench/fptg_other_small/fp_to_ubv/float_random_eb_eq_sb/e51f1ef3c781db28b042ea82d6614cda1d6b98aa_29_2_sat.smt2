(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv29
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                arg
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg
                (fp #b0 #b101 #b11)))
; arg = -0.0625

(declare-const result (_ BitVec 29))
(assert (= result ((_ fp.to_ubv 29) rm arg)))

(declare-const expect (_ BitVec 29))
(assert (not (bvule #b00000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
