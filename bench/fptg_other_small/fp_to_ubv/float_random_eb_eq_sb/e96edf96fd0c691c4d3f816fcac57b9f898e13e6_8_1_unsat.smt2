(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b011)
                arg
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg
                (fp #b0 #b1101 #b000)))
; arg = 56.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00110111)))
(assert (not (bvule #b00111001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
