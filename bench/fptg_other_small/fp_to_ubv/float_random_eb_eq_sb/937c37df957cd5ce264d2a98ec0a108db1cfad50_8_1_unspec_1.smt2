; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b111010)
                arg
                (fp #b1 #b1000101 #b110001)))
(assert (fp.leq (fp #b1 #b1000101 #b110001)
                arg
                (fp #b0 #b1101100 #b011000)))
; arg = -113.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00010100))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

