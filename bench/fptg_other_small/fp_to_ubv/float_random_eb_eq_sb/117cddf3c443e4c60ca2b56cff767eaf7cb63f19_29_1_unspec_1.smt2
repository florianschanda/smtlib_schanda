(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001001 #b01000)
                arg
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg
                (fp #b0 #b111101 #b11111)))
; arg = 1073741824.0

(declare-const result (_ BitVec 29))
(assert (= result ((_ fp.to_ubv 29) rm arg)))

(declare-const expect (_ BitVec 29))
(assert (not (bvule expect #b10101110100110000110001011010)))
(assert (not (bvule #b10101110100110000110001011100 expect)))

(assert (not (= expect result)))
