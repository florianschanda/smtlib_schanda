; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv11
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00010 #b0100)
                arg
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                arg
                (fp #b0 #b11101 #b0100)))
; arg = 5120.0

(declare-const result (_ BitVec 11))
(assert (= result ((_ fp.to_ubv 11) rm arg)))

(declare-const expect (_ BitVec 11))
(assert (not (bvule expect #b00110010011)))
(assert (not (bvule #b00110010101 expect)))

(assert (= expect result))
