; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv3
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01000 #b1100)
                arg
                (fp #b0 #b10110 #b1111)))
(assert (fp.leq (fp #b0 #b10110 #b1111)
                arg
                (fp #b0 #b11011 #b1111)))
; arg = 248.0

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b001)))
(assert (not (bvule #b011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
