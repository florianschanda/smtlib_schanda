; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg
                (fp #b0 #b110 #b00)))
(assert (fp.leq (fp #b0 #b110 #b00)
                arg
                (fp #b0 #b111 #b00)))
; arg = 8.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00001000))

(assert (not (= expect result)))

(check-sat)
(exit)
