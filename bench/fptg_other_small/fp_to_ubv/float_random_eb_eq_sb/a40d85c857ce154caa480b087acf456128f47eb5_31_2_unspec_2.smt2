; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv31
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100100 #b000001)
                arg
                (fp #b1 #b1011110 #b111111)))
(assert (fp.leq (fp #b1 #b1011110 #b111111)
                arg
                (fp #b1 #b0000111 #b010101)))
; arg = -4261412864.0

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_ubv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule expect #b0110010111100000000010110000000)))
(assert (not (bvule #b0110010111100000000010110000010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
