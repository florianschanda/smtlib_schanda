(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0000)
                arg
                (fp #b1 #b10010 #b1010)))
(assert (fp.leq (fp #b1 #b10010 #b1010)
                arg
                (fp #b0 #b10001 #b1001)))
; arg = -13.0

(declare-const result (_ BitVec 11))
(assert (= result ((_ fp.to_ubv 11) rm arg)))

(declare-const expect (_ BitVec 11))
(assert (= expect #b11110011101))

(assert (not (= expect result)))
