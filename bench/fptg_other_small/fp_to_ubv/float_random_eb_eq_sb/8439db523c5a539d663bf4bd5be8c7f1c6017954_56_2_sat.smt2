; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv56
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0011)
                arg
                (fp #b0 #b01111 #b0111)))
(assert (fp.leq (fp #b0 #b01111 #b0111)
                arg
                (fp #b0 #b11100 #b1110)))
; arg = 1.4375

(declare-const result (_ BitVec 56))
(assert (= result ((_ fp.to_ubv 56) rm arg)))

(declare-const expect (_ BitVec 56))
(assert (not (bvule expect #b00000000000000000000000000000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
