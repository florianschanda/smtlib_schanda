(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv20
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg
                (fp #b1 #b000 #b11)))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg
                (fp #b0 #b000 #b00)))
; arg = -0.1875

(declare-const result (_ BitVec 20))
(assert (= result ((_ fp.to_ubv 20) rm arg)))

(declare-const expect (_ BitVec 20))
(assert (not (bvule expect #b01011101000110011111)))
(assert (not (bvule #b01011101000110100001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
