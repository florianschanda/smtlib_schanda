(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv41
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b001)
                arg
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg
                (fp #b1 #b0010 #b001)))
; arg = -0.21875

(declare-const result (_ BitVec 41))
(assert (= result ((_ fp.to_ubv 41) rm arg)))

(declare-const expect (_ BitVec 41))
(assert (not (bvule expect #b01010000000111110100010101101011111010110)))
(assert (not (bvule #b01010000000111110100010101101011111011000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
