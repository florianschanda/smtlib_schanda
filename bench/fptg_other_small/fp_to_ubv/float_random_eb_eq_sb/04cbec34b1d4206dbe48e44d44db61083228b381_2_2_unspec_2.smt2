; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv2
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0010)
                arg
                (fp #b1 #b10001 #b0000)))
(assert (fp.leq (fp #b1 #b10001 #b0000)
                arg
                (fp #b1 #b01100 #b1110)))
; arg = -4.0

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule expect #b10)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
