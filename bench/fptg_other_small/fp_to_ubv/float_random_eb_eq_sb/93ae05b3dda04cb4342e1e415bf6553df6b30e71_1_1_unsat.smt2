(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg
                (fp #b1 #b0110 #b101)))
(assert (fp.leq (fp #b1 #b0110 #b101)
                arg
                (fp #b1 #b0011 #b011)))
; arg = -0.8125

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b0))

(assert (not (= expect result)))

(check-sat)
(exit)
