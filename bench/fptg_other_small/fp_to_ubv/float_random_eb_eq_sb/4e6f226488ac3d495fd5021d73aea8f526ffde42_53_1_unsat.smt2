; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv53
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b111)
                arg
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg
                (fp #b0 #b1000 #b011)))
; arg = 0.00390625

(declare-const result (_ BitVec 53))
(assert (= result ((_ fp.to_ubv 53) rm arg)))

(declare-const expect (_ BitVec 53))
(assert (not (bvule #b00000000000000000000000000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
