; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv48
; Arg1: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
