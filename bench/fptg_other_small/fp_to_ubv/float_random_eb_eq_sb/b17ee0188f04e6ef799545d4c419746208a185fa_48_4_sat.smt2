(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b10)
                arg
                (fp #b0 #b001 #b00)))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg
                (fp #b0 #b110 #b01)))
; arg = 0.25

(declare-const result (_ BitVec 48))
(assert (= result ((_ fp.to_ubv 48) rm arg)))

(declare-const expect (_ BitVec 48))
(assert (= expect #b000000000000000000000000000000000000000000000001))

(assert (= expect result))

(check-sat)
(exit)
