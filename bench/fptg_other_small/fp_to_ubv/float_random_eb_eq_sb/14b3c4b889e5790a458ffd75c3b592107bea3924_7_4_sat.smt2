; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv7
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001010 #b00101)
                arg
                (fp #b0 #b010011 #b10010)))
(assert (fp.leq (fp #b0 #b010011 #b10010)
                arg
                (fp #b0 #b011111 #b01111)))
; arg = 0.0003814697265625

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b0000000)))
(assert (not (bvule #b0000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
