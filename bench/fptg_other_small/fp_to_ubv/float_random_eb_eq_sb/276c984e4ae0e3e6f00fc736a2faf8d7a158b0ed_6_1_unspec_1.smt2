(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv6
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg
                (fp #b1 #b1101 #b101)))
(assert (fp.leq (fp #b1 #b1101 #b101)
                arg
                (fp #b0 #b1011 #b011)))
; arg = -104.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b010010)))
(assert (not (bvule #b010100 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
