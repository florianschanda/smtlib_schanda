; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv12
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1001)
                arg
                (fp #b1 #b10010 #b1111)))
(assert (fp.leq (fp #b1 #b10010 #b1111)
                arg
                (fp #b0 #b10100 #b0100)))
; arg = -15.5

(declare-const result (_ BitVec 12))
(assert (= result ((_ fp.to_ubv 12) rm arg)))

(declare-const expect (_ BitVec 12))
(assert (not (bvule expect #b001010100110)))
(assert (not (bvule #b001010101000 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
