(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                arg
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg
                (fp #b0 #b101 #b11)))
; arg = -0.0625

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b11011101000101001000000001111110))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
