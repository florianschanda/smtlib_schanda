; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv3
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                arg
                (fp #b0 #b100 #b11)))
; arg = -1.25

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b110)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
