; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv31
; Arg1: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                arg
                (fp #b0 #b001 #b00)))
; arg = 0.125

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_ubv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (= expect #b0000000000000000000000000000001))

(assert (not (= expect result)))

(check-sat)
(exit)
