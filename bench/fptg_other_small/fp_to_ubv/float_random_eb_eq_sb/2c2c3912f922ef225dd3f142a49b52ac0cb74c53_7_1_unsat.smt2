; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv7
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00101)
                arg
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                arg
                (fp #b0 #b100110 #b00111)))
; arg = 0.375

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule #b0000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
