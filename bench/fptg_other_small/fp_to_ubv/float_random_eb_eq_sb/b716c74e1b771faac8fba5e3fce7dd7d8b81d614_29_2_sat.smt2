(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b11)
                arg
                (fp #b0 #b110 #b10)))
(assert (fp.leq (fp #b0 #b110 #b10)
                arg
                (fp #b0 #b110 #b11)))
; arg = 12.0

