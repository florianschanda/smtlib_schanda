; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg
                (fp #b0 #b0110 #b101)))
; arg = -1.625

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b10011010010110001101001101101011))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
