; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b110101 #b10001)
                arg
                (fp #b0 #b110111 #b01110)))
(assert (fp.leq (fp #b0 #b110111 #b01110)
                arg
                (fp #b0 #b111011 #b11111)))
; arg = 24117248.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b01010000)))
(assert (not (bvule #b01010010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

