(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b011010110011000)
                arg
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                arg
                (fp #b0 #b11111111 #b000000000000000)))
; arg = 340277174624079928635746076935438991360.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00101011110101010000001111111100)))
(assert (not (bvule #b00101011110101010000001111111110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

