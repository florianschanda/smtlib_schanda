; Format: PIXAR_PXR24
; Target: bv8
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b001001000000001)
                arg
                (fp #b1 #b11010110 #b100101000001010)))
(assert (fp.leq (fp #b1 #b11010110 #b100101000001010)
                arg
                (fp #b0 #b00010011 #b000111110001101)))
; arg = -244250239226983789742784512.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b10001000)))
(assert (not (bvule #b10001010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
