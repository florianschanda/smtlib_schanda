; Format: PIXAR_PXR24
; Target: bv7
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010011 #b001110111010100)
                arg
                (fp #b0 #b10001101 #b011011001010000)))
(assert (fp.leq (fp #b0 #b10001101 #b011011001010000)
                arg
                (fp #b0 #b11010100 #b101011100100100)))
; arg = 23336.0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b0011111)))
(assert (not (bvule #b0100001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
