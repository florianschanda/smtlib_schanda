; Format: PIXAR_PXR24
; Target: bv15
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110101 #b110110110001000)
                arg
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                arg
                (fp #b0 #b10011010 #b100100011110001)))
; arg = 35973.0

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_ubv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (not (bvule expect #b101000111001110)))
(assert (not (bvule #b101000111010000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
