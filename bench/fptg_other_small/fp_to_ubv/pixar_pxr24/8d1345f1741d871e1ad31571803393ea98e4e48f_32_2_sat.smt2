(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00000000000000001111111111111111)))
(assert (not (bvule #b00000000000000010000000000000001 expect)))

(assert (= expect result))

