(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100110 #b011100010100011)
                arg
                (fp #b1 #b10001110 #b110101110010011)))
(assert (fp.leq (fp #b1 #b10001110 #b110101110010011)
                arg
                (fp #b1 #b00101001 #b001001101110010)))
