; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001011 #b011100111000101)
                arg
                (fp #b1 #b01111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b01111111 #b110100000111010)
                arg
                (fp #b0 #b00000010 #b011100101100111)))
; arg = -1.81427001953125

(declare-const result (_ BitVec 20))
(assert (= result ((_ fp.to_ubv 20) rm arg)))

(declare-const expect (_ BitVec 20))
(assert (not (bvule expect #b01001101101000100100)))
(assert (not (bvule #b01001101101000100110 expect)))

(assert (not (= expect result)))
