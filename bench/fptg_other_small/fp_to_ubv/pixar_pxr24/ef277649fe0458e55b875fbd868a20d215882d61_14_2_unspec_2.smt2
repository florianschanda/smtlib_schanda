(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b110010100110010)
                arg
                (fp #b0 #b10001101 #b000000011000110)))
(assert (fp.leq (fp #b0 #b10001101 #b000000011000110)
                arg
                (fp #b0 #b11110010 #b011101111010111)))
; arg = 16483.0

(declare-const result (_ BitVec 14))
(assert (= result ((_ fp.to_ubv 14) rm arg)))

(declare-const expect (_ BitVec 14))
(assert (not (bvule expect #b10101101001001)))
(assert (not (bvule #b10101101001011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

