(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b010101110100010)
                arg
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                arg
                (fp #b1 #b01111110 #b110110001000111)))
; arg = -1.38848876953125

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11011110)))
(assert (not (bvule #b11100000 expect)))

(assert (not (= expect result)))
