(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv8
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                arg
                (fp #b0 #b110 #b0101)))
; arg = 6.25

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000101)))
(assert (not (bvule #b00000111 expect)))

(assert (= expect result))

(check-sat)
(exit)
