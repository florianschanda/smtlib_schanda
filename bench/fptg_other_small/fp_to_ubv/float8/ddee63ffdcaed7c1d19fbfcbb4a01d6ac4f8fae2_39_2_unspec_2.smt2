; Format: FLOAT8
; Target: bv39
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg
                (fp #b1 #b011 #b0100)))
; arg = -1.625

(declare-const result (_ BitVec 39))
(assert (= result ((_ fp.to_ubv 39) rm arg)))

(declare-const expect (_ BitVec 39))
(assert (not (bvule expect #b111100010011100101001000111100000110011)))
(assert (not (bvule #b111100010011100101001000111100000110101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

