; Format: FLOAT8
; Target: bv64
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0111)
                arg
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg
                (fp #b1 #b101 #b0100)))
; arg = -9.5

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0100110001111001001101111010000001100000100111101111101111001000)))
(assert (not (bvule #b0100110001111001001101111010000001100000100111101111101111001010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

