; Format: FLOAT8
; Target: bv3
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg
                (fp #b0 #b110 #b0010)))
; arg = 1.375

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (= expect #b010))

(assert (not (= expect result)))

(check-sat)
(exit)
