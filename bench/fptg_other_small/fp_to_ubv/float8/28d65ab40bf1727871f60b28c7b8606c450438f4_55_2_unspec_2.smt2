; Format: FLOAT8
; Target: bv55
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg
                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg
                (fp #b0 #b000 #b1101)))
; arg = -15.5

(declare-const result (_ BitVec 55))
(assert (= result ((_ fp.to_ubv 55) rm arg)))

(declare-const expect (_ BitVec 55))
(assert (not (bvule expect #b0010000101010100000111100111110100010011111110101100010)))
(assert (not (bvule #b0010000101010100000111100111110100010011111110101100100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
