; Format: FLOAT8
; Target: bv3
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg
                (fp #b1 #b110 #b1100)))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg
                (fp #b1 #b110 #b0001)))
; arg = -14.0

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (= expect #b001))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

