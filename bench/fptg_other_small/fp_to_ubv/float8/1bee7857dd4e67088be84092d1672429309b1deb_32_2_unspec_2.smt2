(assert (fp.leq (fp #b1 #b110 #b0001)
                arg
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg
                (fp #b1 #b011 #b0101)))
; arg = -3.875

(declare-const result (_ BitVec 32))
