;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0001)
                arg
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg
                (fp #b0 #b110 #b1111)))
; arg = 15.0

(declare-const result (_ BitVec 62))
(assert (= result ((_ fp.to_ubv 62) rm arg)))

(declare-const expect (_ BitVec 62))
(assert (not (bvule expect #b00000000000000000000000000000000000000000000000000000000001110)))
(assert (not (bvule #b00000000000000000000000000000000000000000000000000000000010000 expect)))

(assert (= expect result))

(check-sat)
(exit)
