; Format: FLOAT8
; Target: bv39
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg
                (fp #b1 #b000 #b0000)))
; arg = -0.234375

(declare-const result (_ BitVec 39))
(assert (= result ((_ fp.to_ubv 39) rm arg)))

(declare-const expect (_ BitVec 39))
(assert (not (bvule #b000000000000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
