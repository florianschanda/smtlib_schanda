; Format: FLOAT8
; Target: bv52
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg
                (fp #b0 #b011 #b0111)))
; arg = -0.046875

(declare-const result (_ BitVec 52))
(assert (= result ((_ fp.to_ubv 52) rm arg)))

(declare-const expect (_ BitVec 52))
(assert (not (bvule expect #b0101110001011110010101010011110111101001000010010011)))
(assert (not (bvule #b0101110001011110010101010011110111101001000010010101 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
