;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                arg
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                arg
                (fp #b0 #b110 #b1111)))
; arg = -0.015625

(declare-const result (_ BitVec 53))
(assert (= result ((_ fp.to_ubv 53) rm arg)))

(declare-const expect (_ BitVec 53))
(assert (= expect #b11011110110101101010111101101001001110000111001011000))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

