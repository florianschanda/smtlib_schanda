; Format: FLOAT8
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg
                (fp #b1 #b001 #b0100)))
(assert (fp.leq (fp #b1 #b001 #b0100)
                arg
                (fp #b0 #b101 #b0100)))
; arg = -0.3125

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b11010000101101100011000110000101))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
