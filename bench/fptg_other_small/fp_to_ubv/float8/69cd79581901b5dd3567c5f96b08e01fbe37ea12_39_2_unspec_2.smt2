; Format: FLOAT8
; Target: bv39
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0111)
                arg
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg
                (fp #b1 #b101 #b0100)))
; arg = -9.5

(declare-const result (_ BitVec 39))
(assert (= result ((_ fp.to_ubv 39) rm arg)))

(declare-const expect (_ BitVec 39))
(assert (not (bvule expect #b010011000111100100110111101000011100011)))
(assert (not (bvule #b010011000111100100110111101000011100101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
