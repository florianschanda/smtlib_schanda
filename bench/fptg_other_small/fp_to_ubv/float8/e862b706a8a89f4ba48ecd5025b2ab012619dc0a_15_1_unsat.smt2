(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv15
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                arg
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg
                (fp #b0 #b101 #b0100)))
; arg = 3.875

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_ubv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (not (bvule expect #b000000000000010)))
(assert (not (bvule #b000000000000100 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
