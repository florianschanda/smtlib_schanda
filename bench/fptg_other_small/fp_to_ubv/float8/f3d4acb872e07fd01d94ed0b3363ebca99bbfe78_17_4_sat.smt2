; Format: FLOAT8
; Target: bv17
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg
                (fp #b0 #b011 #b0011)))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg
                (fp #b0 #b100 #b0011)))
; arg = 1.1875

(declare-const result (_ BitVec 17))
(assert (= result ((_ fp.to_ubv 17) rm arg)))

(declare-const expect (_ BitVec 17))
(assert (not (bvule expect #b00000000000000001)))
(assert (not (bvule #b00000000000000011 expect)))

(assert (= expect result))

(check-sat)
(exit)
