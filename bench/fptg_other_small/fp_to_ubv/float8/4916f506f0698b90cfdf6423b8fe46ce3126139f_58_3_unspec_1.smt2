; Format: FLOAT8
; Target: bv58
; Arg1: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                arg
                (fp #b0 #b001 #b0110)))
; arg = -0.125

(declare-const result (_ BitVec 58))
(assert (= result ((_ fp.to_ubv 58) rm arg)))

(declare-const expect (_ BitVec 58))
(assert (= expect #b1101011110011011000000001000110110011110111010110110000100))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
