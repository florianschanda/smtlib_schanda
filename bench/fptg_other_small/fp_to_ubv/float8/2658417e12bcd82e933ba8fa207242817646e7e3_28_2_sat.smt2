(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv28
; Arg1: +RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg
                (fp #b0 #b110 #b1000)))
; arg = 0.078125

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_ubv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (not (bvule #b0000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
