(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv42
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg
                (fp #b0 #b011 #b0111)))
(assert (fp.leq (fp #b0 #b011 #b0111)
                arg
                (fp #b0 #b111 #b0000)))
; arg = 1.4375

(declare-const result (_ BitVec 42))
(assert (= result ((_ fp.to_ubv 42) rm arg)))

(declare-const expect (_ BitVec 42))
(assert (not (bvule expect #b000000000000000000000000000000000000000001)))
(assert (not (bvule #b000000000000000000000000000000000000000011 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
