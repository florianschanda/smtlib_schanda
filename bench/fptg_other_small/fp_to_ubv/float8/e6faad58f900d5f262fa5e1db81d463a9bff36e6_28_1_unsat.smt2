; Format: FLOAT8
; Target: bv28
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg
                (fp #b1 #b010 #b0000)))
(assert (fp.leq (fp #b1 #b010 #b0000)
                arg
                (fp #b0 #b100 #b1001)))
; arg = -0.5

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_ubv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (= expect #b0000000000000000000000000000))

(assert (not (= expect result)))

(check-sat)
(exit)
