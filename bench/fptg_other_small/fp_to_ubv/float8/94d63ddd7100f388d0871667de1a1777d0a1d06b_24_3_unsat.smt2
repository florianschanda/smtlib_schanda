(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Target: bv24
; Arg1: +RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg
                (fp #b0 #b000 #b1100)))
(assert (fp.leq (fp #b0 #b000 #b1100)
                arg
                (fp #b0 #b011 #b0110)))
; arg = 0.1875

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_ubv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (not (bvule expect #b000000000000000000000000)))
(assert (not (bvule #b000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
