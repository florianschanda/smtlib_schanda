(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv5
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                arg
                (fp #b1 #b101 #b0110)))
(assert (fp.leq (fp #b1 #b101 #b0110)
                arg
                (fp #b0 #b101 #b0100)))
; arg = -5.5

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b11000)))
(assert (not (bvule #b11010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
