; Format: FLOAT8
; Target: bv44
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg
                (fp #b1 #b110 #b0001)))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg
                (fp #b0 #b101 #b1001)))
; arg = -8.5

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_ubv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (not (bvule expect #b11111110001001101111111000110010101000010110)))
(assert (not (bvule #b11111110001001101111111000110010101000011000 expect)))

(assert (not (= expect result)))
