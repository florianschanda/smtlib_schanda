(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv24
; Arg1: -ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg
                (fp #b1 #b011 #b0000)))
(assert (fp.leq (fp #b1 #b011 #b0000)
                arg
                (fp #b1 #b000 #b1001)))
; arg = -1.0

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_ubv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (not (bvule expect #b110010101100100110101110)))
(assert (not (bvule #b110010101100100110110000 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
