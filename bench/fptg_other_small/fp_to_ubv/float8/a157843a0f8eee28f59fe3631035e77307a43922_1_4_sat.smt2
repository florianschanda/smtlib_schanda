(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv1
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                arg
                (fp #b0 #b000 #b0011)))
(assert (fp.leq (fp #b0 #b000 #b0011)
                arg
                (fp #b0 #b110 #b1010)))
; arg = 0.046875

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))

(check-sat)
(exit)
