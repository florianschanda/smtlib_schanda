; Format: FLOAT8
; Target: bv52
; Arg1: +ZERO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b011 #b0100)
                arg
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg
                (fp #b0 #b100 #b1111)))
; arg = 0.0

(declare-const result (_ BitVec 52))
(assert (= result ((_ fp.to_ubv 52) rm arg)))

(declare-const expect (_ BitVec 52))
(assert (not (bvule #b0000000000000000000000000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
