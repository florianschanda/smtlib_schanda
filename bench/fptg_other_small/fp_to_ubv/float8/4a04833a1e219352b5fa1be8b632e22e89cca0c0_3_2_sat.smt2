(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Target: bv3
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                arg
                (fp #b0 #b110 #b0101)))
; arg = 0.8125

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule #b001 expect)))

(assert (= expect result))

(check-sat)
(exit)
