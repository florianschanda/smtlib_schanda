; Format: FLOAT_2_2
; Target: bv48
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg
                (fp #b0 #b10 #b0)))
; arg = -1.5

(declare-const result (_ BitVec 48))
(assert (= result ((_ fp.to_ubv 48) rm arg)))

(declare-const expect (_ BitVec 48))
(assert (not (bvule expect #b001100001001101110011111100101001001011000111010)))
(assert (not (bvule #b001100001001101110011111100101001001011000111100 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
