; Format: FLOAT_2_2
; Target: bv5
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg
                (fp #b1 #b10 #b1)))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg
                (fp #b0 #b01 #b0)))
; arg = -3.0

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule #b00001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
