; Format: FLOAT_2_2
; Target: bv33
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                arg
                (fp #b0 #b11 #b0)))
; arg = 2.0

(declare-const result (_ BitVec 33))
(assert (= result ((_ fp.to_ubv 33) rm arg)))

(declare-const expect (_ BitVec 33))
(assert (not (bvule expect #b000000000000000000000000000000001)))
(assert (not (bvule #b000000000000000000000000000000011 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
