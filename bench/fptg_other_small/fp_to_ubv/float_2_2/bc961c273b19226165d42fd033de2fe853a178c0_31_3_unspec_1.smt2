(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Target: bv31
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg
                (fp #b0 #b10 #b1)))
; arg = -0.5

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_ubv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule expect #b1001001101010110100101000010000)))
(assert (not (bvule #b1001001101010110100101000010010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
