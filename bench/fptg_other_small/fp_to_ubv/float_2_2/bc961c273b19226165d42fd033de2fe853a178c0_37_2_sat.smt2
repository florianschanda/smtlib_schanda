(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Target: bv37
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg
                (fp #b0 #b10 #b1)))
; arg = -0.5

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_ubv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (= expect #b0000000000000000000000000000000000000))

(assert (= expect result))

(check-sat)
(exit)
