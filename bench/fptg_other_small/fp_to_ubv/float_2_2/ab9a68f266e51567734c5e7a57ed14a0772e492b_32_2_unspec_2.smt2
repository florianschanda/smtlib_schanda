; Format: FLOAT_2_2
; Target: bv32
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg
                (fp #b1 #b01 #b0)))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg
                (fp #b0 #b10 #b1)))
; arg = -1.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11101111001111011111011110110000)))
(assert (not (bvule #b11101111001111011111011110110010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
