(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10011 #b1100111011)))
; arg1 = -0.00006103515625

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1001011000)
                expect
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                expect
                (fp #b0 #b11011 #b1000110100)))
; expect = 0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
