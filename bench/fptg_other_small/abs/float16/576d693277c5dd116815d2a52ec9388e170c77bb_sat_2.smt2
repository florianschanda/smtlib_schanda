                expect
                (fp #b0 #b11011 #b0110100001)))
(assert (fp.leq (fp #b0 #b11011 #b0110100001)
                expect
                (fp #b0 #b11110 #b0100000100)))
; expect = 5764.0

(assert (= expect result))

(check-sat)
