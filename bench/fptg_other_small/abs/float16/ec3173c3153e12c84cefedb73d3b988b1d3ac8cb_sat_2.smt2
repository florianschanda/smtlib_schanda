                expect
                (fp #b0 #b00000 #b0101100101)))
(assert (fp.leq (fp #b0 #b00000 #b0101100101)
                expect
                (fp #b0 #b11110 #b0100001100)))
; expect = 0.000021278858184814453125

(assert (= expect result))

(check-sat)
