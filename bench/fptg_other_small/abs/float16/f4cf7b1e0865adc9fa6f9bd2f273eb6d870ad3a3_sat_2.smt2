(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                arg1
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                arg1
                (fp #b0 #b01010 #b1100110000)))
; arg1 = -1073.0

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10011 #b0011000101)
                expect
                (fp #b0 #b11001 #b0000110001)))
(assert (fp.leq (fp #b0 #b11001 #b0000110001)
                expect
                (fp #b0 #b11110 #b0111000000)))
; expect = 1073.0

(assert (= expect result))

(check-sat)
(exit)
