(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010110111)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b0 #b11001 #b1001000001)))
; arg1 = -933.0

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1111011000)
                expect
                (fp #b0 #b11000 #b1101001010)))
(assert (fp.leq (fp #b0 #b11000 #b1101001010)
                expect
                (fp #b0 #b11100 #b0100111001)))
; expect = 933.0

(assert (= expect result))

(check-sat)
(exit)
