; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100110000)
                arg1
                (fp #b1 #b11011 #b1100100001)))
(assert (fp.leq (fp #b1 #b11011 #b1100100001)
                arg1
                (fp #b1 #b10101 #b1011100010)))
; arg1 = -7300.0

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100111010)
                expect
                (fp #b0 #b11011 #b1100100001)))
(assert (fp.leq (fp #b0 #b11011 #b1100100001)
                expect
                (fp #b0 #b11110 #b1000001000)))
; expect = 7300.0

(assert (= expect result))

(check-sat)
(exit)
