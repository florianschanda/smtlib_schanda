; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010111110)
                arg1
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                arg1
                (fp #b0 #b00111 #b0010000111)))
; arg1 = -0.000008404254913330078125

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1100111110)
                expect
                (fp #b0 #b00000 #b0010001101)))
(assert (fp.leq (fp #b0 #b00000 #b0010001101)
                expect
                (fp #b0 #b00001 #b0101001000)))
; expect = 0.000008404254913330078125

(assert (= expect result))

(check-sat)
(exit)
