; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111110100)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b00011 #b1101100101)))
; arg1 = -0.000039398670196533203125

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0001110010)
                expect
                (fp #b0 #b00000 #b1010010101)))
(assert (fp.leq (fp #b0 #b00000 #b1010010101)
                expect
                (fp #b0 #b11110 #b0010001000)))
; expect = 0.000039398670196533203125

(assert (= expect result))

(check-sat)
(exit)
