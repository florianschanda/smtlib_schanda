; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1000011111)
                arg1
                (fp #b0 #b01111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111 #b1101111000)
                arg1
                (fp #b0 #b10011 #b1101000111)))
; arg1 = 1.8671875

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0010101011)
                expect
                (fp #b0 #b01111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111 #b1101111000)
                expect
                (fp #b0 #b10000 #b0110001111)))
; expect = 1.8671875

(assert (not (= expect result)))

(check-sat)
(exit)
