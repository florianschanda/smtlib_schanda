; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101001011)
                arg1
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg1
                (fp #b1 #b01000 #b1010011001)))
; arg1 = -7412.0

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01101 #b0101110101)
                expect
                (fp #b0 #b11011 #b1100111101)))
(assert (fp.leq (fp #b0 #b11011 #b1100111101)
                expect
                (fp #b0 #b11100 #b1100101101)))
; expect = 7412.0

(assert (not (= expect result)))

(check-sat)
(exit)
