(assert (fp.leq (fp #b1 #b01101 #b1011001101)
                expect
                (fp #b0 #b00100 #b0101100101)))
(assert (fp.leq (fp #b0 #b00100 #b0101100101)
                expect
                (fp #b0 #b01111 #b1011111010)))
; expect = 0.000658512115478515625

(assert (= expect result))

(check-sat)
(exit)
