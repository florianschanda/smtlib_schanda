; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111110000)
                arg1
                (fp #b1 #b00100 #b0101100101)))
(assert (fp.leq (fp #b1 #b00100 #b0101100101)
                arg1
