(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b1 #b00000 #b0101101101)))
; arg1 = -2048.0

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1000011100)
                expect
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                expect
                (fp #b0 #b11011 #b1101000001)))
; expect = 2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
