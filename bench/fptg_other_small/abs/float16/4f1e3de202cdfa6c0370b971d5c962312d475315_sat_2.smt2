; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001110100)
                arg1
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                arg1
                (fp #b0 #b11110 #b1110110011)))
; arg1 = 1.498046875

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1000110010)
                expect
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                expect
                (fp #b0 #b10101 #b1101000001)))
; expect = 1.498046875

(assert (= expect result))

(check-sat)
(exit)
