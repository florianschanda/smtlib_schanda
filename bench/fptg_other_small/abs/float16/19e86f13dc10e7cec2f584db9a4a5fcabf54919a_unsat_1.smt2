; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000101100)
                arg1
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg1
                (fp #b0 #b01110 #b1111100010)))
; arg1 = -1.98828125

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1011101110)
                expect
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                expect
                (fp #b0 #b11110 #b0000101100)))
; expect = 1.98828125

(assert (not (= expect result)))

(check-sat)
(exit)
