(assert (fp.leq (fp #b1 #b11010 #b0100111001)
                expect
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                expect
                (fp #b0 #b00010 #b0101111110)))
; expect = 0.0000045299530029296875

(assert (= expect result))

(check-sat)
