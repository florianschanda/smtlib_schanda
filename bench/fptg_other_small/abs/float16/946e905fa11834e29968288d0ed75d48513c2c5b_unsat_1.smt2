; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1111011110)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10100 #b0001011101)))
; arg1 = -1809.0

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b1110010101)
                expect
                (fp #b0 #b11001 #b1100010001)))
(assert (fp.leq (fp #b0 #b11001 #b1100010001)
                expect
                (fp #b0 #b11100 #b1010110101)))
; expect = 1809.0

(assert (not (= expect result)))

(check-sat)
(exit)
