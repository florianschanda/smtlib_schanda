; arg1 = -0.000006616115570068359375

(declare-const result Float16)
(assert (= result (fp.abs arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0011101000)
                expect
                (fp #b0 #b00000 #b0001101111)))
(assert (fp.leq (fp #b0 #b00000 #b0001101111)
                expect
                (fp #b0 #b10000 #b1010001100)))
; expect = 0.000006616115570068359375

(assert (= expect result))

(check-sat)
(exit)
