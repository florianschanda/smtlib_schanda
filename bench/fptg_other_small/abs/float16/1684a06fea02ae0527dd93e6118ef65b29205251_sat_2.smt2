; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(5)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110000001)
                arg1
                (fp #b1 #b00000 #b0001101111)))
(assert (fp.leq (fp #b1 #b00000 #b0001101111)
                arg1
