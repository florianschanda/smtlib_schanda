(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Arg1: -ZERO

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b1 #b00 #b0)))
(assert (fp.leq (fp #b1 #b00 #b0)
                arg1
                (fp #b0 #b00 #b1)))
; arg1 = -0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b0 #b00 #b0)))
(assert (fp.leq (fp #b0 #b00 #b0)
                expect
                (fp #b0 #b11 #b0)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
