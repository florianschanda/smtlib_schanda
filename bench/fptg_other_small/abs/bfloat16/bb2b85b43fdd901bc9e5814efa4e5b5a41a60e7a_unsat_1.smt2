; Format: BFLOAT16
; Arg1: -ONE

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111010 #b1000101)
                arg1
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg1
                (fp #b0 #b10000110 #b1100010)))
; arg1 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101001 #b1011010)
                expect
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                expect
                (fp #b0 #b10000010 #b1110101)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
