(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1101 #b0)
                arg1
                (fp #b1 #b1000 #b1)))
(assert (fp.leq (fp #b1 #b1000 #b1)
                arg1
                (fp #b1 #b1000 #b0)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1000 #b1)
                expect
                (fp #b0 #b1000 #b1)))
(assert (fp.leq (fp #b0 #b1000 #b1)
                expect
                (fp #b0 #b1101 #b0)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
