(assert (fp.leq (fp #b1 #b1010 #b10)
                expect
                (fp #b0 #b1010 #b00)))
(assert (fp.leq (fp #b0 #b1010 #b00)
                expect
                (fp #b0 #b1011 #b01)))
; expect = 8.0

(assert (not (= expect result)))

(check-sat)
(exit)
