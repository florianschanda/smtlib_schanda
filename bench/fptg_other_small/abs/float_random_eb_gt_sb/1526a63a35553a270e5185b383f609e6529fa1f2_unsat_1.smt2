; arg1 = 0.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01001 #b11)
                expect
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                expect
                (fp #b0 #b10111 #b11)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
