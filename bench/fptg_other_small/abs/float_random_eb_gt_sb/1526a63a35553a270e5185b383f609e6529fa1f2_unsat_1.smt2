;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11100 #b00)
                arg1
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                arg1
