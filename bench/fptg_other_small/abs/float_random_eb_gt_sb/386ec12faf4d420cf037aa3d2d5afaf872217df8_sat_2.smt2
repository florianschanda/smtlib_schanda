; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg1
                (fp #b1 #b0111 #b01)))
(assert (fp.leq (fp #b1 #b0111 #b01)
                arg1
                (fp #b0 #b1101 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0010 #b10)
                expect
                (fp #b0 #b0111 #b01)))
(assert (fp.leq (fp #b0 #b0111 #b01)
                expect
                (fp #b0 #b1100 #b10)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
