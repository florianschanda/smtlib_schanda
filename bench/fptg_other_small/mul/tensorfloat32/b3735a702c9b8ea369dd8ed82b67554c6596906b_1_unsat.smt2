; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000111 #b0101001000)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b1 #b01010011 #b1010101000)))
; arg1 = -264.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01111101 #b0000000101)
                arg2
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                arg2
                (fp #b0 #b11100010 #b1001111011)))
; arg2 = 1893763643309293568.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100110 #b0100110011)
                expect
                (fp #b1 #b11000011 #b1011000110)))
(assert (fp.leq (fp #b1 #b11000011 #b1011000110)
                expect
                (fp #b0 #b00110011 #b1011101111)))
; expect = -499791472247068164096.0

(assert (not (= expect result)))

(check-sat)
(exit)
