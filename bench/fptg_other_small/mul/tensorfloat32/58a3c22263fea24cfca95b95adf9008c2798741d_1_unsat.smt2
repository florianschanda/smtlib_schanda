                expect
                (fp #b0 #b11010110 #b0100100111)))
(assert (fp.leq (fp #b0 #b11010110 #b0100100111)
                expect
                (fp #b0 #b11100101 #b0101101010)))
; expect = 199321644508961985179680768.0

(assert (not (= expect result)))

