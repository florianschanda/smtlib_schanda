(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011011 #b1101100110)
                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11000101 #b0100010111)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0010010011)
                expect
                (fp #b1 #b10010100 #b1101010000)))
(assert (fp.leq (fp #b1 #b10010100 #b1101010000)
                expect
                (fp #b1 #b01101101 #b0010001100)))
; expect = -3833856.0

(assert (= expect result))

(check-sat)
(exit)
