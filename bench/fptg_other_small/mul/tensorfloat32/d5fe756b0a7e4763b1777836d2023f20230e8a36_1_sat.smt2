;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b1001011100)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b10110110 #b0001001010)))
