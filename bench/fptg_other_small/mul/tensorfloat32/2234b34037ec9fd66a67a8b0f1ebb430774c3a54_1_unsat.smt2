                arg2
                (fp #b0 #b01110010 #b0010010011)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b1000111101)
                expect
                (fp #b0 #b11010111 #b0001000010)))
(assert (fp.leq (fp #b0 #b11010111 #b0001000010)
                expect
                (fp #b0 #b11111101 #b0111100110)))
; expect = 329432285844986450107432960.0

(assert (not (= expect result)))

(check-sat)
