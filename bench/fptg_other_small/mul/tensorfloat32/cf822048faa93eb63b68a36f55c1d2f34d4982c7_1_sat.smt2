; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b1110011110)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11000100 #b0110011111)))
; arg1 = 1.59765625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0011000010)
                arg2
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b00111000 #b0101011011)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000000 #b0000000001)
                expect
                (fp #b1 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b1 #b01111111 #b1001100100)
                expect
                (fp #b1 #b00100010 #b0001110101)))
; expect = -1.59765625

(assert (= expect result))

(check-sat)
(exit)
