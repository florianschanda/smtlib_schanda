(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110110 #b1000010001)
                expect
                (fp #b1 #b00001001 #b0000011111)))
(assert (fp.leq (fp #b1 #b00001001 #b0000011111)
                expect
                (fp #b0 #b10111010 #b1100010010)))
; expect = -0.00000000000000000000000000000000000310036635029378330226754261692367297524673040598638083797933262530932552181184291839599609375

