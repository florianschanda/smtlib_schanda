                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b10010110 #b0111010001)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001000 #b0001000001)
                expect
                (fp #b1 #b01110110 #b1110000100)))
(assert (fp.leq (fp #b1 #b01110110 #b1110000100)
                expect
                (fp #b1 #b01000001 #b1101001111)))
; expect = -0.00366973876953125

(assert (= expect result))

(check-sat)
(exit)
