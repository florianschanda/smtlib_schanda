; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01111100 #b1111111100)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b11001111 #b0110000000)))
; arg1 = 1872.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b0010010001)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10110100 #b1010010001)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011100 #b1110001100)
                expect
                (fp #b0 #b10010010 #b1001000110)))
(assert (fp.leq (fp #b0 #b10010010 #b1001000110)
                expect
                (fp #b0 #b11111110 #b0001010011)))
; expect = 822272.0

(assert (not (= expect result)))

(check-sat)
(exit)
