                arg2
                (fp #b1 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001100)
                arg2
                (fp #b1 #b00011111 #b1011111100)))
; arg2 = -646.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110010 #b0010010111)
                expect
                (fp #b1 #b00001010 #b0100000010)))
(assert (fp.leq (fp #b1 #b00001010 #b0100000010)
                expect
                (fp #b0 #b00101111 #b0101100110)))
; expect = -0.000000000000000000000000000000000007534918788770862926079601203594594794817646218909081012871098437244654633104801177978515625

(assert (= expect result))

(check-sat)
