(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011101 #b0110000010)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b10100110 #b1001011111)))
; arg1 = 1.59765625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0001001111)
                arg2
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b1 #b10100101 #b1101110110)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0101011100)
                expect
                (fp #b1 #b11010110 #b1011011001)))
(assert (fp.leq (fp #b1 #b11010110 #b1011011001)
                expect
                (fp #b1 #b00101011 #b1000101010)))
; expect = -264905870223055617907490816.0

(assert (not (= expect result)))

(check-sat)
(exit)
