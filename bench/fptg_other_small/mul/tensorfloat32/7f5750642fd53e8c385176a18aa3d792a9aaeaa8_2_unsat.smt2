(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000100 #b0100001101)
                arg1
                (fp #b0 #b11010101 #b1001011001)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011001)
                arg1
                (fp #b0 #b11111000 #b0001100101)))
; arg1 = 122781528554610775556096000.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110011 #b0111010101)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11110111 #b0100011001)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01010000 #b0101010010)
                expect
                (fp #b0 #b11100000 #b0000100101)))
(assert (fp.leq (fp #b0 #b11100000 #b0000100101)
                expect
                (fp #b0 #b11110010 #b1101010000)))
; expect = 164181797710223558958496350208.0

(assert (not (= expect result)))

(check-sat)
(exit)
