; Format: TENSORFLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000111 #b0010000010)
                arg1
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b11100100 #b0111000001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101111 #b1111101101)
                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b00000010 #b1011010010)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101101 #b0110001111)
                expect
                (fp #b0 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b0 #b01111111 #b0011111110)
                expect
                (fp #b0 #b10100100 #b1011110001)))
; expect = 1.248046875

(assert (not (= expect result)))

(check-sat)
(exit)
