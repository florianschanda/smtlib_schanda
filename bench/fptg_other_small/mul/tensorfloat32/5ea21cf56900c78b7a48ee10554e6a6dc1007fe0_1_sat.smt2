(assert (fp.leq (fp #b0 #b00110100 #b1111010100)
                expect
                (fp #b0 #b01001011 #b0000000000)))
(assert (fp.leq (fp #b0 #b01001011 #b0000000000)
                expect
                (fp #b0 #b10111001 #b0001101011)))
; expect = 0.0000000000000002220446049250313080847263336181640625

