; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00011101 #b1000010010)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b01101011 #b0111100100)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100001 #b0111010101)
                arg2
                (fp #b1 #b00111100 #b1100110010)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110010)
                arg2
                (fp #b0 #b11000110 #b0100001010)))
; arg2 = -0.0000000000000000000121893335065814158169050784863429726101458072662353515625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000110 #b0111000001)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00110101 #b0011001001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
