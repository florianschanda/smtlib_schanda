                arg2
                (fp #b0 #b01111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011010)
                arg2
                (fp #b0 #b10000000 #b1011000001)))
; arg2 = 1.275390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010100 #b1001101001)
                expect
                (fp #b1 #b00000001 #b0100011001)))
(assert (fp.leq (fp #b1 #b00000001 #b0100011001)
                expect
                (fp #b0 #b10101110 #b1000011000)))
; expect = -0.0000000000000000000000000000000000000149806653107723163857343865339358457964195171053474044489152439130208449569181539118289947509765625

(assert (= expect result))

(check-sat)
