                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b11011000 #b1101100010)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101100 #b1001110100)
                expect
                (fp #b0 #b00001001 #b1011011010)))
(assert (fp.leq (fp #b0 #b00001001 #b1011011010)
                expect
                (fp #b0 #b00001110 #b1111011010)))
; expect = 0.0000000000000000000000000000000000051545427283557307224429097157195472972348484664456037818158762320308596827089786529541015625

(assert (= expect result))

(check-sat)
(exit)
