(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11011010 #b1100001010)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b0011101000)
                expect
                (fp #b0 #b10010100 #b0011000101)))
(assert (fp.leq (fp #b0 #b10010100 #b0011000101)
                expect
                (fp #b0 #b11011111 #b1111010101)))
; expect = 2500608.0

(assert (not (= expect result)))

(check-sat)
(exit)
