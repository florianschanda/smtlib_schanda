(assert (fp.leq (fp #b0 #b00000100 #b0101100010)
                arg2
                (fp #b0 #b01110001 #b1111011001)))
; arg2 = 0.000000000000000000000000000000000000126549313705711889529759292835332386252665713846245047237426550879035858088172972202301025390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11101000 #b1001011000)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00110110 #b0010000011)))
; expect = 0.0

(assert (not (= expect result)))

