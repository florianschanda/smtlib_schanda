                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10111100 #b1111100010)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10000110 #b1110101101)
                expect
                (fp #b0 #b10110000 #b0101101011)))
(assert (fp.leq (fp #b0 #b10110000 #b0101101011)
                expect
                (fp #b0 #b11111011 #b0100000011)))
; expect = 762511313862656.0

(assert (= expect result))

(check-sat)
(exit)
