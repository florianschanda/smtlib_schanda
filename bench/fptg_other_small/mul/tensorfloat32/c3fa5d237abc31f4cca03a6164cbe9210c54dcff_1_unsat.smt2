(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b00110110 #b1110001010)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b0000010001)
                expect
                (fp #b1 #b10001010 #b0010010000)))
(assert (fp.leq (fp #b1 #b10001010 #b0010010000)
                expect
                (fp #b1 #b10000001 #b0010110111)))
; expect = -2336.0

(assert (not (= expect result)))

(check-sat)
(exit)
