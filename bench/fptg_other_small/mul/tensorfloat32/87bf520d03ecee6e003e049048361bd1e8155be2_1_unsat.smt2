; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11011110 #b0000010100)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b11000010 #b1111000011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011001 #b1011110101)
                arg2
                (fp #b0 #b00000100 #b0101100010)))
(assert (fp.leq (fp #b0 #b00000100 #b0101100010)
                arg2
                (fp #b0 #b00011101 #b1011000010)))
; arg2 = 0.000000000000000000000000000000000000126549313705711889529759292835332386252665713846245047237426550879035858088172972202301025390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01101010 #b1010010101)
                expect
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                expect
                (fp #b0 #b10101010 #b0110010011)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
