(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011000 #b0110111001)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01010010 #b1111111011)))
; arg1 = -264.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00100011 #b0101101011)
                arg2
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg2
                (fp #b0 #b11111111 #b0000000000)))
; arg2 = 340116213421465348979261631549233168384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
