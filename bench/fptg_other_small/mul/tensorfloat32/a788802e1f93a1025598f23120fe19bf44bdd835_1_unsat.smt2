                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11000010 #b0001001001)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00111100 #b0001000011)
                expect
                (fp #b0 #b10001001 #b1100100110)))
(assert (fp.leq (fp #b0 #b10001001 #b1100100110)
                expect
                (fp #b0 #b11111010 #b1110000101)))
; expect = 1830.0

(assert (not (= expect result)))

(check-sat)
(exit)
