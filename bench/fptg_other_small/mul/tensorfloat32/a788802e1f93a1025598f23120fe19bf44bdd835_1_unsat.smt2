; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
