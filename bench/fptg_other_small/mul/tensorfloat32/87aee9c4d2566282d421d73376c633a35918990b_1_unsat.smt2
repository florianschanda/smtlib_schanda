; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001001 #b1101100000)
                arg1
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                arg1
                (fp #b1 #b01000000 #b1101111101)))
; arg1 = -1.98828125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110011 #b1010001101)
                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b1 #b00011010 #b0000011011)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011001 #b1101111101)
                expect
                (fp #b0 #b10001000 #b0011011100)))
(assert (fp.leq (fp #b0 #b10001000 #b0011011100)
                expect
                (fp #b0 #b10100000 #b1111001111)))
; expect = 622.0

(assert (not (= expect result)))

(check-sat)
(exit)
