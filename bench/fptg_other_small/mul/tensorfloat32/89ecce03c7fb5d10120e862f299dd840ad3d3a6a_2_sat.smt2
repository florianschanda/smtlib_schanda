; Format: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b0110100011)
                arg1
                (fp #b1 #b11100110 #b1110111011)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111011)
                arg1
                (fp #b1 #b10110010 #b0110111100)))
; arg1 = -19599066701966140512202934714368.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110111 #b1100000101)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11110010 #b1001011100)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0001110000)
                expect
                (fp #b1 #b11110001 #b0100001011)))
(assert (fp.leq (fp #b1 #b11110001 #b0100001011)
                expect
                (fp #b0 #b00101001 #b0010010001)))
; expect = -26184590798314306517315901410246656.0

(assert (= expect result))

(check-sat)
(exit)
