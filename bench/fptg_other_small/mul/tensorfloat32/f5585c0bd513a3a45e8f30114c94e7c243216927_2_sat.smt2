; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b1011101001)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b10000101 #b0100100111)))
; arg1 = -264.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000010 #b1101111000)
                arg2
                (fp #b0 #b00000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b01101110 #b1111101000)))
; arg2 = 0.0000000000000000000000000000000000000107332736134652228510817252178007784058637919490420100840886996618195325936540029942989349365234375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101010 #b0001100000)
                expect
                (fp #b1 #b00001000 #b1110001001)))
(assert (fp.leq (fp #b1 #b00001000 #b1110001001)
                expect
                (fp #b0 #b10101001 #b1001110111)))
; expect = -0.000000000000000000000000000000000002834410753420240753589615975377139890640257323766696036237977551763833616860210895538330078125

(assert (= expect result))

(check-sat)
(exit)
