; arg2 = 0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000101 #b0110010100)
                expect
                (fp #b1 #b00000001 #b0011001110)))
(assert (fp.leq (fp #b1 #b00000001 #b0011001110)
                expect
                (fp #b0 #b00011100 #b0101010010)))
; expect = -0.000000000000000000000000000000000000014119707534291148777358847077962521325360924168258473158747701159398957315715961158275604248046875

(assert (= expect result))

