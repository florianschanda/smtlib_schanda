; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1101111100)
                arg1
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                arg1
                (fp #b0 #b00101101 #b0010110111)))
; arg1 = -13270717221139276546918611681280.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000001 #b1100110000)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10011011 #b1101001001)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b1000111111)
                expect
                (fp #b1 #b11101111 #b0001111101)))
(assert (fp.leq (fp #b1 #b11101111 #b0001111101)
                expect
                (fp #b1 #b11010101 #b1100000101)))
; expect = -5826122158648942329278847931908096.0

(assert (= expect result))

(check-sat)
(exit)
