                arg2
                (fp #b1 #b00000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000 #b0101011111)
                arg2
                (fp #b0 #b11011111 #b1011000111)))
; arg2 = -0.0000000000000000000000000000000000000040292823939318644071975246539551585245542149455761984379841000869504341608262620866298675537109375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010111 #b0000111000)
                expect
                (fp #b0 #b00000000 #b0110100110)))
(assert (fp.leq (fp #b0 #b00000000 #b0110100110)
                expect
                (fp #b0 #b00001100 #b0111001001)))
; expect = 0.000000000000000000000000000000000000004844322422334036409793035338943239023823016259353720059342707227045821127831004559993743896484375

(assert (= expect result))

(check-sat)
