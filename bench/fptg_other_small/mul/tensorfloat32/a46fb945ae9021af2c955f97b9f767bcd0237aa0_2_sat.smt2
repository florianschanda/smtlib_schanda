(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b1 #b10011010 #b1001110111)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01001111 #b0100110001)
                expect
                (fp #b0 #b11001011 #b0100011001)))
(assert (fp.leq (fp #b0 #b11001011 #b0100011001)
                expect
                (fp #b0 #b11011010 #b1110011111)))
; expect = 96292004064763859435520.0

(assert (= expect result))

(check-sat)
(exit)
