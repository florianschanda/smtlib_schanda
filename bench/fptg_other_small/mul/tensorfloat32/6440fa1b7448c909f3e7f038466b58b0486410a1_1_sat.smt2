; arg2 = -0.00000000000000000000000000000000000000638256698298038920342399916694891207878103564028594396444205028018359371344558894634246826171875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010000 #b1110000100)
                expect
                (fp #b1 #b00001010 #b1100010110)))
(assert (fp.leq (fp #b1 #b00001010 #b1100010110)
                expect
                (fp #b0 #b00101001 #b0101001000)))
; expect = -0.000000000000000000000000000000000010661733761958147697276440392605768297815296599922833820084377975945244543254375457763671875

(assert (= expect result))

(check-sat)
