                arg2
                (fp #b0 #b00000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b11011111 #b1011000101)))
; arg2 = 0.0000000000000000000000000000000000000107332736134652228510817252178007784058637919490420100840886996618195325936540029942989349365234375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011010 #b1101000110)
                expect
                (fp #b1 #b10000000 #b0010110010)))
(assert (fp.leq (fp #b1 #b10000000 #b0010110010)
                expect
                (fp #b0 #b01000011 #b1101101100)))
; expect = -2.34765625

(assert (= expect result))

(check-sat)
(exit)
