;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101000 #b0100011011)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
