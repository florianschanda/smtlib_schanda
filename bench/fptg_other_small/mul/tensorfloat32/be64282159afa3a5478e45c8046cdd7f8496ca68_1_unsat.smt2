                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b1 #b10000110 #b1110010110)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101001 #b0011100000)
                expect
                (fp #b0 #b11010101 #b0100100000)))
(assert (fp.leq (fp #b0 #b11010101 #b0100100000)
                expect
                (fp #b0 #b11011110 #b1010000000)))
; expect = 99131917208399592325906432.0

(assert (not (= expect result)))

(check-sat)
(exit)
