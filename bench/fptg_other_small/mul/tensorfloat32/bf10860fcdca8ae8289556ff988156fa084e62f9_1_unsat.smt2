(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b1 #b01101111 #b1010101100)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101001 #b1000111110)
                expect
                (fp #b1 #b10010101 #b0000000000)))
(assert (fp.leq (fp #b1 #b10010101 #b0000000000)
                expect
                (fp #b1 #b00110101 #b1000000011)))
; expect = -4194304.0

(assert (not (= expect result)))

(check-sat)
