(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b00100110 #b1111001110)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00100001 #b1111001010)
                expect
                (fp #b0 #b10000000 #b0011110111)))
(assert (fp.leq (fp #b0 #b10000000 #b0011110111)
                expect
                (fp #b0 #b11100011 #b0000010010)))
; expect = 2.482421875

(assert (not (= expect result)))

