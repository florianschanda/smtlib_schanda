; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11001001 #b1011011100)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b01001101 #b0100100010)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000010 #b0111101001)
                arg2
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b11001010 #b0010010011)))
; arg2 = 0.00000000000000000000338813178901720135627329000271856784820556640625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100100 #b0110010011)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b10010001 #b0000101001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
