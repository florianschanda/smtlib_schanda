; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100100 #b0011010010)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b00011001 #b1101000010)))
; arg1 = -933.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0100011010)
                arg2
                (fp #b1 #b00000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000 #b0101011111)
                arg2
                (fp #b0 #b01100101 #b0100110101)))
; arg2 = -0.0000000000000000000000000000000000000040292823939318644071975246539551585245542149455761984379841000869504341608262620866298675537109375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010010 #b1011001001)
                expect
                (fp #b0 #b00001001 #b0100000000)))
(assert (fp.leq (fp #b0 #b00001001 #b0100000000)
                expect
                (fp #b0 #b00100100 #b0100111111)))
; expect = 0.000000000000000000000000000000000003761581922631320025499956919111186169019729781670680068828005460090935230255126953125

(assert (= expect result))

(check-sat)
(exit)
