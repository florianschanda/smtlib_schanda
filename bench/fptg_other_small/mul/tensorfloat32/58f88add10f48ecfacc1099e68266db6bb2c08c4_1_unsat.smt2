(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11111110 #b1100011010)))
; arg2 = 2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10000001 #b0101001110)
                expect
                (fp #b0 #b11001001 #b1111111111)))
(assert (fp.leq (fp #b0 #b11001001 #b1111111111)
                expect
                (fp #b0 #b11011111 #b1011001110)))
; expect = 37760485118883452157952.0

(assert (not (= expect result)))

