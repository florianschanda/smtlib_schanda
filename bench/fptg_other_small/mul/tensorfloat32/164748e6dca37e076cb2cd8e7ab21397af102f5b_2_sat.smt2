(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001100 #b0110110011)
                expect
                (fp #b0 #b10000000 #b1111111110)))
(assert (fp.leq (fp #b0 #b10000000 #b1111111110)
                expect
