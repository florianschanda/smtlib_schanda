(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b11011111 #b1001101011)))
; arg2 = 0.0000000000000000000000000000000000000107332736134652228510817252178007784058637919490420100840886996618195325936540029942989349365234375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01100111 #b1011001000)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b11101101 #b1100011001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
