                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                arg2
                (fp #b0 #b11101100 #b1101101111)))
; arg2 = 1893763643309293568.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b1101100101)
                expect
                (fp #b1 #b10111011 #b1111101000)))
(assert (fp.leq (fp #b1 #b10111011 #b1111101000)
                expect
                (fp #b1 #b01001001 #b0110001001)))
; expect = -2278821411449470976.0

(assert (not (= expect result)))

(check-sat)
(exit)
