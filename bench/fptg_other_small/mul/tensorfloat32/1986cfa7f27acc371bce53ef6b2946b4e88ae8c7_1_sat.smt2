(assert (fp.leq (fp #b1 #b10001001 #b1101010011)
                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b10000000 #b0101011111)))
; arg2 = -0.00000000000000000000000000000000000000638256698298038920342399916694891207878103564028594396444205028018359371344558894634246826171875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001100 #b0111000000)
                expect
                (fp #b0 #b01000000 #b0001010111)))
(assert (fp.leq (fp #b0 #b01000000 #b0001010111)
                expect
                (fp #b0 #b11100000 #b1100011010)))
; expect = 0.0000000000000000001176317005499409595881132872818852774798870086669921875

(assert (= expect result))

(check-sat)
(exit)
