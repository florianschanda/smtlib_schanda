(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101100 #b0001111101)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b1 #b00110101 #b0001110000)))
; arg1 = -933.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001100 #b1010110011)
                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b0 #b00111000 #b0010100110)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001110 #b0010111101)
                expect
                (fp #b0 #b10010001 #b0001110101)))
(assert (fp.leq (fp #b0 #b10010001 #b0001110101)
                expect
                (fp #b0 #b11111000 #b1110111000)))
; expect = 292096.0

(assert (= expect result))

(check-sat)
(exit)
