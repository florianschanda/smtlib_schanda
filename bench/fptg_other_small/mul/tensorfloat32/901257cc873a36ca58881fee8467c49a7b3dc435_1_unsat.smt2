(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001101 #b1010000001)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b11010101 #b0001101101)))
; arg1 = 1872.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000110 #b1000111100)
                expect
                (fp #b0 #b10010100 #b1010101111)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101111)
                expect
                (fp #b0 #b11101101 #b1010000010)))
; expect = 3504128.0

(assert (not (= expect result)))

(check-sat)
(exit)
