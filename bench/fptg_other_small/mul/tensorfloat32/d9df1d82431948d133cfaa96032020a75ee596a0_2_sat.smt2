                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b1 #b01010001 #b0110010001)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111000 #b1010101100)
                expect
                (fp #b1 #b11110011 #b0000001101)))
(assert (fp.leq (fp #b1 #b11110011 #b0000001101)
                expect
                (fp #b1 #b00110001 #b0001101001)))
; expect = -84131435035947128918533198334394368.0

(assert (= expect result))

(check-sat)
(exit)
