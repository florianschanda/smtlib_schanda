(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b1000001110)
                arg1
                (fp #b1 #b10011100 #b0001111011)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111011)
                arg1
                (fp #b1 #b01000101 #b0000110001)))
; arg1 = -601358336.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00100001 #b0101001011)
                arg2
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg2
                (fp #b0 #b11111110 #b0010001110)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
