                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b11101011 #b1000111000)))
; arg2 = 0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b1001001001)
                expect
                (fp #b0 #b00001011 #b1101001110)))
(assert (fp.leq (fp #b0 #b00001011 #b1101001110)
                expect
                (fp #b0 #b11000001 #b1110010110)))
; expect = 0.00000000000000000000000000000000002198174436037677639901537324605599417520904591163803665221365690740640275180339813232421875

(assert (= expect result))

(check-sat)
(exit)
