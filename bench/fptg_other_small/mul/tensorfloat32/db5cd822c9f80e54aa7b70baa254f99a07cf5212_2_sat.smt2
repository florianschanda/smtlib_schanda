; arg2 = 0.0000000000000000000000000000000000000107332736134652228510817252178007784058637919490420100840886996618195325936540029942989349365234375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001001 #b0010111111)
                expect
                (fp #b1 #b00000001 #b0001100101)))
(assert (fp.leq (fp #b1 #b00000001 #b0001100101)
                expect
                (fp #b0 #b01000001 #b1100100001)))
; expect = -0.0000000000000000000000000000000000000129143666472175141256330918395998670658788940563339693525131413043283146180328913033008575439453125

(assert (= expect result))

