                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b01101000 #b0111110001)))
; arg2 = -0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001110 #b0000011001)
                expect
                (fp #b1 #b00000000 #b0000000010)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000010)
                expect
                (fp #b0 #b01111100 #b0001000001)))
; expect = -0.000000000000000000000000000000000000000022958874039497802890014385492621985894895811655704834404467806763250337098725140094757080078125

