(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b11111010 #b0111110101)))
; arg2 = 307090161664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010110 #b0101010100)
                expect
                (fp #b1 #b10100110 #b0001110001)))
(assert (fp.leq (fp #b1 #b10100110 #b0001110001)
                expect
                (fp #b0 #b01111010 #b0011000100)))
; expect = -610422226944.0

(assert (= expect result))

(check-sat)
(exit)
