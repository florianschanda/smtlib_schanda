(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0100)
                arg1
                (fp #b1 #b01111 #b0000)))
(assert (fp.leq (fp #b1 #b01111 #b0000)
                arg1
                (fp #b0 #b01011 #b0111)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00101 #b1011)
                arg2
                (fp #b1 #b00000 #b1111)))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                arg2
                (fp #b0 #b10001 #b0001)))
; arg2 = -0.000057220458984375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0111)
                expect
                (fp #b0 #b00000 #b1111)))
(assert (fp.leq (fp #b0 #b00000 #b1111)
                expect
                (fp #b0 #b01011 #b1010)))
; expect = 0.000057220458984375

(assert (= expect result))

(check-sat)
(exit)
