; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0110)
                arg1
                (fp #b0 #b00000 #b1110)))
(assert (fp.leq (fp #b0 #b00000 #b1110)
                arg1
                (fp #b0 #b01001 #b0110)))
; arg1 = 0.00005340576171875

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0001)
                arg2
                (fp #b1 #b01111 #b0110)))
(assert (fp.leq (fp #b1 #b01111 #b0110)
                arg2
                (fp #b0 #b00101 #b0001)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01000 #b0100)
                expect
                (fp #b1 #b00001 #b0011)))
(assert (fp.leq (fp #b1 #b00001 #b0011)
                expect
                (fp #b0 #b01011 #b1110)))
; expect = -0.000072479248046875

(assert (not (= expect result)))

(check-sat)
(exit)
