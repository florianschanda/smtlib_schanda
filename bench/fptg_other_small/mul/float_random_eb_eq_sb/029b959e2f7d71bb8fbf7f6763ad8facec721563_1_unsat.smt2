; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011110 #b01011)
                arg1
                (fp #b0 #b100001 #b00000)))
(assert (fp.leq (fp #b0 #b100001 #b00000)
                arg1
                (fp #b0 #b100111 #b11001)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011001 #b01000)
                arg2
                (fp #b0 #b111110 #b10011)))
(assert (fp.leq (fp #b0 #b111110 #b10011)
                arg2
                (fp #b0 #b111110 #b11001)))
; arg2 = 3422552064.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011000 #b11010)
                expect
                (fp #b0 #b111110 #b11111)))
(assert (fp.leq (fp #b0 #b111110 #b11111)
                expect
                (fp #b0 #b111111 #b00000)))
; expect = 4227858432.0

(assert (not (= expect result)))

(check-sat)
(exit)
