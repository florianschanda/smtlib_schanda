; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b1111)
                arg1
                (fp #b0 #b11100 #b0111)))
(assert (fp.leq (fp #b0 #b11100 #b0111)
                arg1
                (fp #b0 #b11100 #b1101)))
; arg1 = 11776.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1001)
                arg2
                (fp #b1 #b01111 #b0000)))
(assert (fp.leq (fp #b1 #b01111 #b0000)
                arg2
                (fp #b0 #b11100 #b1111)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1110)
                expect
                (fp #b1 #b11100 #b0111)))
(assert (fp.leq (fp #b1 #b11100 #b0111)
                expect
                (fp #b0 #b00001 #b0100)))
; expect = -11776.0

(assert (= expect result))

(check-sat)
(exit)
