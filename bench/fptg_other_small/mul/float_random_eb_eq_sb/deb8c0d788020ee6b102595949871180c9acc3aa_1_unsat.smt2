(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b1 #b001 #b10)))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg1
                (fp #b0 #b100 #b00)))
; arg1 = -0.375

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg2
                (fp #b0 #b100 #b11)))
(assert (fp.leq (fp #b0 #b100 #b11)
                arg2
                (fp #b0 #b111 #b00)))
; arg2 = 3.5

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b00)
                expect
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                expect
                (fp #b0 #b101 #b10)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
