(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00010 #b0001)
                arg1
                (fp #b0 #b01111 #b0110)))
(assert (fp.leq (fp #b0 #b01111 #b0110)
                arg1
                (fp #b0 #b10010 #b0110)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b1101)
                arg2
                (fp #b0 #b00000 #b1110)))
(assert (fp.leq (fp #b0 #b00000 #b1110)
                arg2
                (fp #b0 #b11000 #b0000)))
; arg2 = 0.00005340576171875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b1010)
                expect
                (fp #b0 #b00001 #b0011)))
(assert (fp.leq (fp #b0 #b00001 #b0011)
                expect
                (fp #b0 #b11001 #b1111)))
; expect = 0.000072479248046875

(assert (= expect result))

(check-sat)
(exit)
