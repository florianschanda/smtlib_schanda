; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0011001 #b010010)
                arg1
                (fp #b0 #b1011000 #b111000)))
(assert (fp.leq (fp #b0 #b1011000 #b111000)
                arg1
                (fp #b0 #b1101101 #b001001)))
; arg1 = 62914560.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101001 #b110110)
                expect
                (fp #b0 #b1110010 #b110000)))
(assert (fp.leq (fp #b0 #b1110010 #b110000)
                expect
                (fp #b0 #b1111110 #b000111)))
; expect = 3940649673949184.0

(assert (= expect result))

(check-sat)
(exit)
