(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101001 #b101101)
                arg1
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg1
                (fp #b0 #b1010111 #b001100)))
; arg1 = 128.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011011 #b001101)
                arg2
                (fp #b1 #b0111111 #b001000)))
(assert (fp.leq (fp #b1 #b0111111 #b001000)
                arg2
                (fp #b1 #b0011110 #b110011)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b011111)
                expect
                (fp #b1 #b1000110 #b001000)))
(assert (fp.leq (fp #b1 #b1000110 #b001000)
                expect
                (fp #b0 #b1010100 #b111001)))
; expect = -144.0

(assert (not (= expect result)))

(check-sat)
(exit)
