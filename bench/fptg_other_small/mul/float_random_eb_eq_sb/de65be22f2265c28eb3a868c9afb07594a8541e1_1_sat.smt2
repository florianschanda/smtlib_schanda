(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01001)
                arg1
                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg1
                (fp #b1 #b101011 #b11010)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01010)
                arg2
                (fp #b1 #b011111 #b00110)))
(assert (fp.leq (fp #b1 #b011111 #b00110)
                arg2
                (fp #b1 #b001100 #b01101)))
; arg2 = -1.1875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000010 #b11000)
                expect
                (fp #b0 #b111101 #b00110)))
(assert (fp.leq (fp #b0 #b111101 #b00110)
                expect
                (fp #b0 #b111101 #b10101)))
; expect = 1275068416.0

(assert (= expect result))

(check-sat)
(exit)
