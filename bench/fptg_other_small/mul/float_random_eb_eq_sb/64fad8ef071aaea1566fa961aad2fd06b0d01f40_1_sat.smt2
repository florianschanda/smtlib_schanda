;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0000001 #b101011)
