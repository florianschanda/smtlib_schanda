                arg2
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                arg2
                (fp #b1 #b1101011 #b101101)))
; arg2 = -18302628885633695744.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001101 #b010011)
                expect
                (fp #b1 #b1001000 #b100101)))
(assert (fp.leq (fp #b1 #b1001000 #b100101)
                expect
                (fp #b1 #b0100111 #b110111)))
; expect = -808.0

(assert (= expect result))

(check-sat)
