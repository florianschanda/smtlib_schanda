(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0000 #b110)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b111)
                arg2
                (fp #b1 #b1100 #b101)))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg2
                (fp #b0 #b1001 #b010)))
; arg2 = -52.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b000)
                expect
                (fp #b0 #b1101 #b011)))
(assert (fp.leq (fp #b0 #b1101 #b011)
                expect
                (fp #b0 #b1110 #b101)))
; expect = 88.0

(assert (not (= expect result)))

(check-sat)
(exit)
