(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b111)
                arg1
                (fp #b1 #b0000 #b111)))
(assert (fp.leq (fp #b1 #b0000 #b111)
                arg1
                (fp #b0 #b1011 #b100)))
; arg1 = -0.013671875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0000 #b101)
                arg2
                (fp #b0 #b0100 #b011)))
(assert (fp.leq (fp #b0 #b0100 #b011)
                arg2
                (fp #b0 #b0101 #b100)))
; arg2 = 0.171875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                expect
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                expect
                (fp #b0 #b0101 #b011)))
; expect = -0.00390625

(assert (= expect result))

(check-sat)
(exit)
