(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                arg1
                (fp #b0 #b011111 #b00111)))
(assert (fp.leq (fp #b0 #b011111 #b00111)
                arg1
                (fp #b0 #b110000 #b01101)))
; arg1 = 1.21875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001011 #b00101)
                arg2
                (fp #b0 #b101001 #b01011)))
(assert (fp.leq (fp #b0 #b101001 #b01011)
                arg2
                (fp #b0 #b110011 #b11110)))
; arg2 = 1376.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b100100 #b11010)
                expect
                (fp #b0 #b101001 #b10100)))
(assert (fp.leq (fp #b0 #b101001 #b10100)
                expect
                (fp #b0 #b101101 #b10000)))
; expect = 1664.0

(assert (not (= expect result)))

(check-sat)
(exit)
