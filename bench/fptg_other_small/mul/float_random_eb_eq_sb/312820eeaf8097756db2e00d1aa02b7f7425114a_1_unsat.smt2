; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b01011)
                arg1
                (fp #b1 #b010000 #b11111)))
(assert (fp.leq (fp #b1 #b010000 #b11111)
                arg1
                (fp #b0 #b010011 #b00110)))
; arg1 = -0.00006008148193359375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b00011)
                arg2
                (fp #b1 #b001101 #b01101)))
(assert (fp.leq (fp #b1 #b001101 #b01101)
                arg2
                (fp #b0 #b000111 #b00100)))
; arg2 = -0.00000536441802978515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b01100)
                expect
                (fp #b0 #b000000 #b01011)))
(assert (fp.leq (fp #b0 #b000000 #b01011)
                expect
                (fp #b0 #b100110 #b11010)))
; expect = 0.00000000032014213502407073974609375

(assert (not (= expect result)))

(check-sat)
(exit)
