; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b0100)
                arg1
                (fp #b0 #b00000 #b1111)))
(assert (fp.leq (fp #b0 #b00000 #b1111)
                arg1
                (fp #b0 #b01010 #b1101)))
; arg1 = 0.000057220458984375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0001)
                arg2
                (fp #b1 #b10011 #b1110)))
(assert (fp.leq (fp #b1 #b10011 #b1110)
                arg2
                (fp #b1 #b01011 #b0100)))
; arg2 = -30.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1111)
                expect
                (fp #b1 #b00101 #b1100)))
(assert (fp.leq (fp #b1 #b00101 #b1100)
                expect
                (fp #b1 #b00000 #b0000)))
; expect = -0.001708984375

(assert (not (= expect result)))

(check-sat)
(exit)
