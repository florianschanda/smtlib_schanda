(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b0011)
                arg1
                (fp #b1 #b10010 #b1110)))
(assert (fp.leq (fp #b1 #b10010 #b1110)
                arg1
                (fp #b0 #b10010 #b0011)))
; arg1 = -15.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b1010)
                arg2
                (fp #b0 #b01111 #b1101)))
(assert (fp.leq (fp #b0 #b01111 #b1101)
                arg2
                (fp #b0 #b10010 #b1011)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1011)
                expect
                (fp #b1 #b10011 #b1011)))
(assert (fp.leq (fp #b1 #b10011 #b1011)
                expect
                (fp #b1 #b00011 #b0111)))
; expect = -27.0

(assert (not (= expect result)))

(check-sat)
(exit)
