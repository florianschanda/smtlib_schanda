(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b0001)
                arg1
                (fp #b1 #b01111 #b1010)))
(assert (fp.leq (fp #b1 #b01111 #b1010)
                arg1
                (fp #b1 #b00011 #b0110)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00001 #b0011)
                arg2
                (fp #b0 #b00100 #b0010)))
(assert (fp.leq (fp #b0 #b00100 #b0010)
                arg2
                (fp #b0 #b10011 #b0111)))
; arg2 = 0.00054931640625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0111)
                expect
                (fp #b1 #b00100 #b1101)))
(assert (fp.leq (fp #b1 #b00100 #b1101)
                expect
                (fp #b0 #b00101 #b0001)))
; expect = -0.000885009765625

(assert (= expect result))

(check-sat)
(exit)
