; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b001000)
                arg1
                (fp #b0 #b0000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000 #b000001)
                arg1
                (fp #b0 #b0000011 #b010100)))
; arg1 = 0.00000000000000000000338813178901720135627329000271856784820556640625

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100011 #b011100)
                arg2
                (fp #b0 #b0000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000 #b111111)
                arg2
                (fp #b0 #b1101010 #b110111)))
; arg2 = 0.00000000000000000021345230270808368544521727017126977443695068359375

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0101101 #b111101)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b1000101 #b110001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
