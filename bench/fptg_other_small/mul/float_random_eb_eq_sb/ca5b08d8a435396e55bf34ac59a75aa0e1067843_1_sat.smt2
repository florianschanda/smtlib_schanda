(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001110 #b011001)
                arg1
                (fp #b1 #b1000101 #b110111)))
(assert (fp.leq (fp #b1 #b1000101 #b110111)
                arg1
                (fp #b0 #b0000110 #b110110)))
; arg1 = -119.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1110010 #b111110)
                arg2
                (fp #b0 #b1111000 #b100111)))
(assert (fp.leq (fp #b0 #b1111000 #b100111)
                arg2
                (fp #b0 #b1111101 #b011010)))
; arg2 = 231935380809580544.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                expect
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                expect
                (fp #b1 #b1111000 #b010111)))
; expect = -18302628885633695744.0

(assert (= expect result))

(check-sat)
(exit)
