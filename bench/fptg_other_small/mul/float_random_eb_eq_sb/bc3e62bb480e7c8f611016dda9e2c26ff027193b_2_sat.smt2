(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0011100 #b001101)
                arg1
                (fp #b0 #b1000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000011 #b011000)
                arg1
                (fp #b0 #b1100010 #b110110)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b100000)
                arg2
                (fp #b0 #b0100111 #b011101)))
(assert (fp.leq (fp #b0 #b0100111 #b011101)
                arg2
                (fp #b0 #b1110001 #b011010)))
; arg2 = 0.000000086612999439239501953125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0010100 #b100101)
                expect
                (fp #b0 #b0101100 #b000000)))
(assert (fp.leq (fp #b0 #b0101100 #b000000)
                expect
                (fp #b0 #b1100100 #b110001)))
; expect = 0.0000019073486328125

(assert (= expect result))

(check-sat)
(exit)
