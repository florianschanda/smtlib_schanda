(assert (fp.leq (fp #b1 #b0000000 #b101100)
                arg2
                (fp #b0 #b0110111 #b001010)))
; arg2 = -0.000000000000000000149077798716756859676024760119616985321044921875

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110011 #b111001)
                expect
                (fp #b0 #b0110110 #b110011)))
(assert (fp.leq (fp #b0 #b0110110 #b110011)
                expect
                (fp #b0 #b1110011 #b001111)))
; expect = 0.003509521484375

(assert (= expect result))

(check-sat)
(exit)
