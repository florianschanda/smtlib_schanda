(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b010)
                arg1
                (fp #b0 #b0111 #b100)))
(assert (fp.leq (fp #b0 #b0111 #b100)
                arg1
                (fp #b0 #b1101 #b010)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b110)
                arg2
                (fp #b0 #b0000 #b111)))
(assert (fp.leq (fp #b0 #b0000 #b111)
                arg2
                (fp #b0 #b0011 #b111)))
; arg2 = 0.013671875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b101)
                expect
                (fp #b0 #b0001 #b011)))
(assert (fp.leq (fp #b0 #b0001 #b011)
                expect
                (fp #b0 #b1010 #b110)))
; expect = 0.021484375

(assert (not (= expect result)))

(check-sat)
(exit)
