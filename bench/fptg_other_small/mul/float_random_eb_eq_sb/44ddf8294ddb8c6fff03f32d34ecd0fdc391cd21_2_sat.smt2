(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b10111)
                arg1
                (fp #b1 #b100011 #b10110)))
(assert (fp.leq (fp #b1 #b100011 #b10110)
                arg1
                (fp #b1 #b011101 #b10001)))
; arg1 = -27.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b11001)
                expect
                (fp #b0 #b101000 #b01110)))
(assert (fp.leq (fp #b0 #b101000 #b01110)
                expect
                (fp #b0 #b111000 #b10101)))
; expect = 736.0

(assert (= expect result))

(check-sat)
(exit)
