(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0001 #b000)))
(assert (fp.leq (fp #b0 #b0001 #b000)
                arg1
                (fp #b0 #b0010 #b110)))
; arg1 = 0.015625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b111)
                arg2
                (fp #b0 #b0010 #b011)))
(assert (fp.leq (fp #b0 #b0010 #b011)
                arg2
                (fp #b0 #b0100 #b100)))
; arg2 = 0.04296875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b0001 #b100)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
