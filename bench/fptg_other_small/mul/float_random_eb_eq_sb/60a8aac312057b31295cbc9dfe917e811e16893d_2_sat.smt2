(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b10011)
                arg1
                (fp #b1 #b111001 #b10100)))
(assert (fp.leq (fp #b1 #b111001 #b10100)
                arg1
                (fp #b0 #b101111 #b11000)))
; arg1 = -109051904.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011110 #b01010)
                arg2
                (fp #b0 #b001101 #b01101)))
(assert (fp.leq (fp #b0 #b001101 #b01101)
                arg2
                (fp #b0 #b111100 #b01111)))
; arg2 = 0.00000536441802978515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b00000)
                expect
                (fp #b1 #b101000 #b00101)))
(assert (fp.leq (fp #b1 #b101000 #b00101)
                expect
                (fp #b1 #b000100 #b00000)))
; expect = -592.0

(assert (= expect result))

(check-sat)
(exit)
