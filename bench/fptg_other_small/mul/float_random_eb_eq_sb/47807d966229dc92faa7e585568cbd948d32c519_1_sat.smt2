; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b10000)
                arg1
                (fp #b1 #b111001 #b10100)))
(assert (fp.leq (fp #b1 #b111001 #b10100)
                arg1
                (fp #b1 #b110111 #b10000)))
; arg1 = -109051904.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000000 #b01111)
                arg2
                (fp #b0 #b000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000 #b01000)
                arg2
                (fp #b0 #b000110 #b00101)))
; arg2 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b10001)
                expect
                (fp #b1 #b011001 #b10100)))
(assert (fp.leq (fp #b1 #b011001 #b10100)
                expect
                (fp #b0 #b111101 #b01101)))
; expect = -0.025390625

(assert (= expect result))

(check-sat)
(exit)
