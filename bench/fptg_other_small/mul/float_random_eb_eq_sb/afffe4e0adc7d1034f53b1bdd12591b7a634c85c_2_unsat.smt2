(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101001 #b00101)
                arg1
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                arg1
                (fp #b0 #b110011 #b00110)))
; arg1 = -1.6875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000011 #b00111)
                arg2
                (fp #b0 #b101110 #b11111)))
(assert (fp.leq (fp #b0 #b101110 #b11111)
                arg2
                (fp #b0 #b110000 #b11101)))
; arg2 = 64512.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b01101)
                expect
                (fp #b1 #b101111 #b10110)))
(assert (fp.leq (fp #b1 #b101111 #b10110)
                expect
                (fp #b0 #b000001 #b11110)))
; expect = -110592.0

(assert (not (= expect result)))

(check-sat)
(exit)
