                arg2
                (fp #b0 #b1011110 #b111000)))
; arg2 = -0.00000022538006305694580078125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101111 #b011101)
                expect
                (fp #b1 #b1001100 #b100101)))
(assert (fp.leq (fp #b1 #b1001100 #b100101)
                expect
                (fp #b0 #b0101010 #b001100)))
; expect = -12928.0

(assert (= expect result))

