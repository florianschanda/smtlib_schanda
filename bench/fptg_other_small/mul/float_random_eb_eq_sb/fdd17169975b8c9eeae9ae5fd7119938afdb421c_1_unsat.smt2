(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011011 #b11101)
                arg1
                (fp #b0 #b100100 #b01100)))
(assert (fp.leq (fp #b0 #b100100 #b01100)
                arg1
                (fp #b0 #b100101 #b11111)))
; arg1 = 44.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100000 #b11110)
                arg2
                (fp #b1 #b000000 #b10110)))
(assert (fp.leq (fp #b1 #b000000 #b10110)
                arg2
                (fp #b0 #b011000 #b01101)))
; arg2 = -0.0000000006402842700481414794921875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010110 #b11000)
                expect
                (fp #b1 #b000101 #b11100)))
(assert (fp.leq (fp #b1 #b000101 #b11100)
                expect
                (fp #b0 #b110000 #b00110)))
; expect = -0.00000002793967723846435546875

(assert (not (= expect result)))

(check-sat)
(exit)
