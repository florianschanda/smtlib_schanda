; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00011 #b0011)
                arg1
                (fp #b0 #b11100 #b0111)))
(assert (fp.leq (fp #b0 #b11100 #b0111)
                arg1
                (fp #b0 #b11110 #b1000)))
; arg1 = 11776.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1010)
                arg2
                (fp #b1 #b01010 #b1000)))
(assert (fp.leq (fp #b1 #b01010 #b1000)
                arg2
                (fp #b0 #b11000 #b0011)))
; arg2 = -0.046875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0010)
                expect
                (fp #b1 #b11000 #b0001)))
(assert (fp.leq (fp #b1 #b11000 #b0001)
                expect
                (fp #b1 #b00000 #b0010)))
; expect = -544.0

(assert (not (= expect result)))

(check-sat)
(exit)
