(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00101 #b0001)
                arg1
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg1
                (fp #b0 #b10011 #b0010)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b1111)
                arg2
                (fp #b0 #b11001 #b1101)))
(assert (fp.leq (fp #b0 #b11001 #b1101)
                arg2
                (fp #b0 #b11110 #b1001)))
; arg2 = 1856.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0010)
                expect
                (fp #b0 #b01001 #b1101)))
(assert (fp.leq (fp #b0 #b01001 #b1101)
                expect
                (fp #b0 #b10001 #b1000)))
; expect = 0.0283203125

(assert (= expect result))

(check-sat)
(exit)
