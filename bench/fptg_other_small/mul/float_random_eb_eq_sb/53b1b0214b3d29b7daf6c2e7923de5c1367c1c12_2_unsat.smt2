(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00000)
                arg1
                (fp #b1 #b011111 #b10100)))
(assert (fp.leq (fp #b1 #b011111 #b10100)
                arg1
                (fp #b0 #b010101 #b01111)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b11011)
                arg2
                (fp #b1 #b110001 #b11001)))
(assert (fp.leq (fp #b1 #b110001 #b11001)
                arg2
                (fp #b0 #b001100 #b10110)))
; arg2 = -466944.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b01000)
                expect
                (fp #b0 #b110010 #b01111)))
(assert (fp.leq (fp #b0 #b110010 #b01111)
                expect
                (fp #b0 #b111110 #b10101)))
; expect = 770048.0

(assert (not (= expect result)))

(check-sat)
(exit)
