(assert (fp.leq (fp #b0 #b100011 #b00110)
                arg2
                (fp #b0 #b111110 #b01100)))
; arg2 = 19.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b01001)
                expect
                (fp #b1 #b000101 #b00100)))
(assert (fp.leq (fp #b1 #b000101 #b00100)
                expect
                (fp #b0 #b100100 #b01111)))
; expect = -0.00000001676380634307861328125

(assert (= expect result))

