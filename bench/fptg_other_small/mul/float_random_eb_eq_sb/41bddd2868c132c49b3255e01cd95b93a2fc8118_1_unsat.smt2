(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00010)
                arg1
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                arg1
                (fp #b0 #b110001 #b10001)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b101111 #b01001)
                arg2
                (fp #b0 #b111110 #b10011)))
(assert (fp.leq (fp #b0 #b111110 #b10011)
                arg2
                (fp #b0 #b111110 #b10110)))
; arg2 = 3422552064.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b10110)
                expect
                (fp #b0 #b111101 #b00110)))
(assert (fp.leq (fp #b0 #b111101 #b00110)
                expect
                (fp #b0 #b111101 #b01111)))
; expect = 1275068416.0

(assert (not (= expect result)))

(check-sat)
(exit)
