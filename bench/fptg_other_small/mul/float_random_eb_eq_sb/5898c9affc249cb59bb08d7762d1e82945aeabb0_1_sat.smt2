; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010011 #b011010)
                arg1
                (fp #b1 #b0000000 #b011011)))
(assert (fp.leq (fp #b1 #b0000000 #b011011)
                arg1
                (fp #b0 #b0101011 #b010000)))
; arg1 = -0.00000000000000000009147955830346443661937883007340133190155029296875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011010 #b010100)
                arg2
                (fp #b1 #b0101000 #b111001)))
(assert (fp.leq (fp #b1 #b0101000 #b111001)
                arg2
                (fp #b0 #b1011101 #b001100)))
; arg2 = -0.00000022538006305694580078125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1110100 #b101101)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b0100011 #b101000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
