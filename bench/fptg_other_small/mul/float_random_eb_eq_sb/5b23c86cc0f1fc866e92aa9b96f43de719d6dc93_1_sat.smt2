(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b00101)
                arg1
                (fp #b1 #b000011 #b11101)))
(assert (fp.leq (fp #b1 #b000011 #b11101)
                arg1
                (fp #b0 #b101100 #b00000)))
; arg1 = -0.000000007101334631443023681640625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000001 #b00001)
                arg2
                (fp #b0 #b100110 #b11100)))
(assert (fp.leq (fp #b0 #b100110 #b11100)
                arg2
                (fp #b0 #b110011 #b10011)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b00110)
                expect
                (fp #b1 #b001011 #b11001)))
(assert (fp.leq (fp #b1 #b001011 #b11001)
                expect
                (fp #b0 #b110110 #b10100)))
; expect = -0.0000016987323760986328125

(assert (= expect result))

(check-sat)
(exit)
