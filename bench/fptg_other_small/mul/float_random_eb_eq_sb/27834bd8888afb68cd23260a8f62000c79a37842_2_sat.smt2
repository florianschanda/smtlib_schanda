(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b011)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b0110 #b101)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b010)
                arg2
                (fp #b0 #b0111 #b101)))
(assert (fp.leq (fp #b0 #b0111 #b101)
                arg2
                (fp #b0 #b1111 #b000)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b111)
                expect
                (fp #b0 #b0000 #b100)))
(assert (fp.leq (fp #b0 #b0000 #b100)
                expect
                (fp #b0 #b0100 #b001)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
