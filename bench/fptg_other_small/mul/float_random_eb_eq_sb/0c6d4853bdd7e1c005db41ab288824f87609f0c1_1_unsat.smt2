; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0111)
                arg1
                (fp #b1 #b10011 #b1110)))
(assert (fp.leq (fp #b1 #b10011 #b1110)
                arg1
                (fp #b1 #b01000 #b0010)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0011)
                arg2
                (fp #b0 #b00000 #b1111)))
(assert (fp.leq (fp #b0 #b00000 #b1111)
                arg2
                (fp #b0 #b11110 #b0011)))
; arg2 = 0.000057220458984375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b0111)
                expect
                (fp #b1 #b00101 #b1100)))
(assert (fp.leq (fp #b1 #b00101 #b1100)
                expect
                (fp #b1 #b00100 #b1000)))
; expect = -0.001708984375

(assert (not (= expect result)))

(check-sat)
(exit)
