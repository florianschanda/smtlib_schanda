(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100000 #b00010)
                arg1
                (fp #b0 #b100111 #b11001)))
(assert (fp.leq (fp #b0 #b100111 #b11001)
                arg1
                (fp #b0 #b110100 #b01001)))
; arg1 = 456.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011111 #b10001)
                arg2
                (fp #b0 #b100100 #b00011)))
(assert (fp.leq (fp #b0 #b100100 #b00011)
                arg2
                (fp #b0 #b100111 #b11111)))
; arg2 = 35.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100101 #b00111)
                expect
                (fp #b0 #b101100 #b11110)))
(assert (fp.leq (fp #b0 #b101100 #b11110)
                expect
                (fp #b0 #b111000 #b11000)))
; expect = 15872.0

(assert (= expect result))

(check-sat)
(exit)
