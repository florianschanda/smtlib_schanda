(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b00000)
                arg1
                (fp #b0 #b100111 #b11001)))
(assert (fp.leq (fp #b0 #b100111 #b11001)
                arg1
                (fp #b0 #b111001 #b11100)))
; arg1 = 456.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010011 #b00011)
                arg2
                (fp #b0 #b101001 #b01011)))
(assert (fp.leq (fp #b0 #b101001 #b01011)
                arg2
                (fp #b0 #b111100 #b11101)))
; arg2 = 1376.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001001 #b01111)
                expect
                (fp #b0 #b110010 #b00110)))
(assert (fp.leq (fp #b0 #b110010 #b00110)
                expect
                (fp #b0 #b110101 #b01011)))
; expect = 622592.0

(assert (not (= expect result)))

(check-sat)
(exit)
