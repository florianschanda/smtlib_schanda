(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b110)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0000 #b011)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b010)
                expect
                (fp #b1 #b1000 #b010)))
(assert (fp.leq (fp #b1 #b1000 #b010)
                expect
                (fp #b0 #b1101 #b101)))
; expect = -2.5

(assert (= expect result))

(check-sat)
(exit)
