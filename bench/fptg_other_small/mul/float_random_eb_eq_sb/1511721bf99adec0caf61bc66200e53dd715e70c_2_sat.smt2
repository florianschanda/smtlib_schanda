(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011001 #b100000)
                arg1
                (fp #b1 #b0111111 #b111101)))
(assert (fp.leq (fp #b1 #b0111111 #b111101)
                arg1
                (fp #b0 #b1011011 #b111110)))
; arg1 = -1.953125

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110100 #b111000)
                arg2
                (fp #b1 #b1010111 #b110101)))
(assert (fp.leq (fp #b1 #b1010111 #b110101)
                arg2
                (fp #b0 #b1000100 #b110010)))
; arg2 = -30670848.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100101 #b010110)
                expect
                (fp #b0 #b1011000 #b110011)))
(assert (fp.leq (fp #b0 #b1011000 #b110011)
                expect
                (fp #b0 #b1100000 #b110100)))
; expect = 60293120.0

(assert (= expect result))

(check-sat)
(exit)
