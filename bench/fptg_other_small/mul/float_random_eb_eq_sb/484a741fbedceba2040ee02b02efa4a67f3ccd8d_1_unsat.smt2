; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10001)
                arg1
                (fp #b0 #b011111 #b10111)))
(assert (fp.leq (fp #b0 #b011111 #b10111)
                arg1
                (fp #b0 #b101001 #b00010)))
; arg1 = 1.71875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111111 #b00000)
                arg2
                (fp #b1 #b111110 #b11111)))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                arg2
                (fp #b0 #b000110 #b11110)))
; arg2 = -4227858432.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111111 #b00000)
                expect
                (fp #b1 #b111110 #b11111)))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                expect
                (fp #b0 #b110100 #b11111)))
; expect = -4227858432.0

(assert (not (= expect result)))

(check-sat)
(exit)
