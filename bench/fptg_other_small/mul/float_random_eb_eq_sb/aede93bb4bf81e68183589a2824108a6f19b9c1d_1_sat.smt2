(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b101)
                arg1
                (fp #b1 #b0010 #b011)))
(assert (fp.leq (fp #b1 #b0010 #b011)
                arg1
                (fp #b0 #b0000 #b110)))
; arg1 = -0.04296875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b000)
                arg2
                (fp #b0 #b1110 #b001)))
(assert (fp.leq (fp #b0 #b1110 #b001)
                arg2
                (fp #b0 #b1110 #b010)))
; arg2 = 144.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b001)
                expect
                (fp #b1 #b1001 #b100)))
(assert (fp.leq (fp #b1 #b1001 #b100)
                expect
                (fp #b1 #b0011 #b101)))
; expect = -6.0

(assert (= expect result))

(check-sat)
(exit)
