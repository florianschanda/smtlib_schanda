; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101011 #b001011)
                arg1
                (fp #b0 #b0100100 #b100111)))
(assert (fp.leq (fp #b0 #b0100100 #b100111)
                arg1
                (fp #b0 #b1010111 #b110101)))
; arg1 = 0.000000011990778148174285888671875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011111 #b010111)
                arg2
                (fp #b0 #b0001100 #b101111)))
(assert (fp.leq (fp #b0 #b0001100 #b101111)
                arg2
                (fp #b0 #b0010010 #b110011)))
; arg2 = 0.000000000000000770217223333702349918894469738006591796875

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0000010 #b111001)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b1111110 #b000000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
