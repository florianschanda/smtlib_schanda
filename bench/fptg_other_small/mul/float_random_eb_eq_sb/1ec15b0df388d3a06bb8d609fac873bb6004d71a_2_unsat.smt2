(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b000)
                arg1
                (fp #b1 #b1011 #b111)))
(assert (fp.leq (fp #b1 #b1011 #b111)
                arg1
                (fp #b0 #b0100 #b100)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b010)
                arg2
                (fp #b1 #b0000 #b011)))
(assert (fp.leq (fp #b1 #b0000 #b011)
                arg2
                (fp #b0 #b1101 #b011)))
; arg2 = -0.005859375

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b111)
                expect
                (fp #b0 #b0100 #b100)))
(assert (fp.leq (fp #b0 #b0100 #b100)
                expect
                (fp #b0 #b1001 #b010)))
; expect = 0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
