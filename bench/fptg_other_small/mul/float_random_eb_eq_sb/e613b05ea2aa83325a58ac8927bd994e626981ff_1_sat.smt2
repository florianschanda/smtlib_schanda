(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100111 #b010101)
                arg1
                (fp #b0 #b1011000 #b111000)))
(assert (fp.leq (fp #b0 #b1011000 #b111000)
                arg1
                (fp #b0 #b1110000 #b001100)))
; arg1 = 62914560.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1010010 #b111100)
                arg2
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                arg2
                (fp #b0 #b1000000 #b111001)))
; arg2 = -0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000011 #b010100)
                expect
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                expect
                (fp #b0 #b1111000 #b000001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
