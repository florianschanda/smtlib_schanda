(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10101)
                arg1
                (fp #b1 #b010000 #b11111)))
(assert (fp.leq (fp #b1 #b010000 #b11111)
                arg1
                (fp #b0 #b110111 #b10100)))
; arg1 = -0.00006008148193359375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101010 #b01110)
                arg2
                (fp #b1 #b101001 #b11110)))
(assert (fp.leq (fp #b1 #b101001 #b11110)
                arg2
                (fp #b1 #b000110 #b01000)))
; arg2 = -1984.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b00100)
                expect
                (fp #b0 #b011011 #b11110)))
(assert (fp.leq (fp #b0 #b011011 #b11110)
                expect
                (fp #b0 #b111101 #b01000)))
; expect = 0.12109375

(assert (not (= expect result)))

(check-sat)
(exit)
