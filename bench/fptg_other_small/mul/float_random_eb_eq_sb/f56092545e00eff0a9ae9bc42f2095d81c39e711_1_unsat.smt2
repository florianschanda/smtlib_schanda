(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0110)
                arg1
                (fp #b1 #b10010 #b1001)))
(assert (fp.leq (fp #b1 #b10010 #b1001)
                arg1
                (fp #b1 #b01001 #b1111)))
; arg1 = -12.5

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11111 #b0000)
                arg2
                (fp #b1 #b11110 #b1111)))
(assert (fp.leq (fp #b1 #b11110 #b1111)
                arg2
                (fp #b0 #b10110 #b0100)))
; arg2 = -63488.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b11100 #b0111)
                expect
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                expect
                (fp #b0 #b11111 #b0000)))
; expect = 63488.0

(assert (not (= expect result)))

(check-sat)
(exit)
