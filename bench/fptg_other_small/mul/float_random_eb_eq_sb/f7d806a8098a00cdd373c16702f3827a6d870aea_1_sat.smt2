; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010111 #b10111)
                arg1
                (fp #b0 #b000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000 #b00001)
                arg1
                (fp #b0 #b110101 #b00110)))
; arg1 = 0.00000000002910383045673370361328125

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b10100)
                arg2
                (fp #b1 #b010111 #b01100)))
(assert (fp.leq (fp #b1 #b010111 #b01100)
                arg2
                (fp #b0 #b101101 #b10100)))
; arg2 = -0.00537109375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000000 #b01111)
                expect
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                expect
                (fp #b0 #b111000 #b11000)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
