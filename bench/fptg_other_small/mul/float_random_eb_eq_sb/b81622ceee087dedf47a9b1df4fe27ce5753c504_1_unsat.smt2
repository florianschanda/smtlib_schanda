; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1001100 #b000010)
                arg1
                (fp #b0 #b1011000 #b111000)))
(assert (fp.leq (fp #b0 #b1011000 #b111000)
                arg1
                (fp #b0 #b1111101 #b001000)))
; arg1 = 62914560.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001111 #b000000)
                arg2
                (fp #b0 #b0100111 #b011101)))
(assert (fp.leq (fp #b0 #b0100111 #b011101)
                arg2
                (fp #b0 #b1010010 #b010110)))
; arg2 = 0.000000086612999439239501953125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0010111 #b110110)
                expect
                (fp #b0 #b1000001 #b010111)))
(assert (fp.leq (fp #b0 #b1000001 #b010111)
                expect
                (fp #b0 #b1001110 #b101100)))
; expect = 5.4375

(assert (not (= expect result)))

(check-sat)
(exit)
