                arg2
                (fp #b0 #b111000 #b10100)))
; arg2 = 64512.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b11110)
                expect
                (fp #b1 #b011101 #b01100)))
(assert (fp.leq (fp #b1 #b011101 #b01100)
                expect
                (fp #b1 #b010111 #b00110)))
; expect = -0.34375

(assert (not (= expect result)))

