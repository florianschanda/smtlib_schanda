(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100010 #b011011)
                arg1
                (fp #b1 #b0111111 #b101110)))
(assert (fp.leq (fp #b1 #b0111111 #b101110)
                arg1
                (fp #b0 #b1100110 #b101000)))
; arg1 = -1.71875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000110 #b101010)
                arg2
                (fp #b1 #b1000000 #b100000)))
(assert (fp.leq (fp #b1 #b1000000 #b100000)
                arg2
                (fp #b1 #b0110111 #b000101)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010100 #b111100)
                expect
                (fp #b0 #b1000001 #b010010)))
(assert (fp.leq (fp #b0 #b1000001 #b010010)
                expect
                (fp #b0 #b1011000 #b001010)))
; expect = 5.125

(assert (= expect result))

(check-sat)
(exit)
