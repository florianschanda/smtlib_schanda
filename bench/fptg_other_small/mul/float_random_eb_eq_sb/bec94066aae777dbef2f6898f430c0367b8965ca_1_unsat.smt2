(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01110 #b0101)
                arg1
                (fp #b0 #b01111 #b0100)))
(assert (fp.leq (fp #b0 #b01111 #b0100)
                arg1
                (fp #b0 #b10111 #b0111)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1101)
                arg2
                (fp #b1 #b00000 #b1111)))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                arg2
                (fp #b0 #b00111 #b1101)))
; arg2 = -0.000057220458984375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b1110)
                expect
                (fp #b1 #b00001 #b0010)))
(assert (fp.leq (fp #b1 #b00001 #b0010)
                expect
                (fp #b0 #b00010 #b1110)))
; expect = -0.00006866455078125

(assert (not (= expect result)))

(check-sat)
(exit)
