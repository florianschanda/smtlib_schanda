; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b11110)
                arg1
                (fp #b1 #b001101 #b01101)))
(assert (fp.leq (fp #b1 #b001101 #b01101)
                arg1
                (fp #b0 #b110110 #b11100)))
; arg1 = -0.00000536441802978515625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b01000)
                arg2
                (fp #b1 #b101001 #b11110)))
(assert (fp.leq (fp #b1 #b101001 #b11110)
                arg2
                (fp #b0 #b101110 #b00011)))
; arg2 = -1984.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011011 #b01000)
                expect
                (fp #b0 #b011000 #b01011)))
(assert (fp.leq (fp #b0 #b011000 #b01011)
                expect
                (fp #b0 #b111110 #b10100)))
; expect = 0.010498046875

(assert (not (= expect result)))

(check-sat)
(exit)
