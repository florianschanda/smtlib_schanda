(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b011)
                arg1
                (fp #b0 #b0111 #b111)))
(assert (fp.leq (fp #b0 #b0111 #b111)
                arg1
                (fp #b0 #b1001 #b111)))
; arg1 = 1.875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b011)
                arg2
                (fp #b1 #b1010 #b001)))
(assert (fp.leq (fp #b1 #b1010 #b001)
                arg2
                (fp #b0 #b0011 #b111)))
; arg2 = -9.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b101)
                expect
                (fp #b1 #b1011 #b000)))
(assert (fp.leq (fp #b1 #b1011 #b000)
                expect
                (fp #b0 #b0101 #b100)))
; expect = -16.0

(assert (= expect result))

(check-sat)
(exit)
