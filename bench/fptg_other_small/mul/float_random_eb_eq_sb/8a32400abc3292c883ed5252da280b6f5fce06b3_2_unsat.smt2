; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b00101)
                arg1
                (fp #b1 #b010000 #b11111)))
(assert (fp.leq (fp #b1 #b010000 #b11111)
                arg1
                (fp #b0 #b010011 #b11111)))
; arg1 = -0.00006008148193359375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b100101 #b11101)
                arg2
                (fp #b0 #b100110 #b11100)))
(assert (fp.leq (fp #b0 #b100110 #b11100)
                arg2
                (fp #b0 #b100111 #b10110)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10101)
                expect
                (fp #b1 #b011000 #b11100)))
(assert (fp.leq (fp #b1 #b011000 #b11100)
                expect
                (fp #b0 #b001101 #b10101)))
; expect = -0.0146484375

(assert (not (= expect result)))

(check-sat)
(exit)
