; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0011010 #b110011)
                arg1
                (fp #b0 #b0111111 #b111111)))
(assert (fp.leq (fp #b0 #b0111111 #b111111)
                arg1
                (fp #b0 #b1011010 #b111100)))
; arg1 = 1.984375

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b001100)
                arg2
                (fp #b0 #b0100111 #b011101)))
(assert (fp.leq (fp #b0 #b0100111 #b011101)
                arg2
                (fp #b0 #b1101000 #b100100)))
; arg2 = 0.000000086612999439239501953125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b111001)
                expect
                (fp #b0 #b0101000 #b011101)))
(assert (fp.leq (fp #b0 #b0101000 #b011101)
                expect
                (fp #b0 #b1010010 #b000010)))
; expect = 0.00000017322599887847900390625

(assert (= expect result))

(check-sat)
(exit)
