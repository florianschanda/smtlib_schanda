; arg2 = -64512.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b11000)
                expect
                (fp #b0 #b010000 #b11101)))
(assert (fp.leq (fp #b0 #b010000 #b11101)
                expect
                (fp #b0 #b111000 #b10101)))
; expect = 0.00005817413330078125

