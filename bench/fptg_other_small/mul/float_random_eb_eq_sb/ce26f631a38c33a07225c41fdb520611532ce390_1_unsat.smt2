(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b010)
                arg1
                (fp #b1 #b0111 #b000)))
(assert (fp.leq (fp #b1 #b0111 #b000)
                arg1
