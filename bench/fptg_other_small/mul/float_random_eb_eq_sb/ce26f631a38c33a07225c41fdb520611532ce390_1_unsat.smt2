                arg2
                (fp #b1 #b0000 #b011)))
(assert (fp.leq (fp #b1 #b0000 #b011)
                arg2
                (fp #b0 #b0110 #b001)))
; arg2 = -0.005859375

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b110)
                expect
                (fp #b0 #b0000 #b011)))
(assert (fp.leq (fp #b0 #b0000 #b011)
                expect
                (fp #b0 #b0100 #b110)))
; expect = 0.005859375

(assert (not (= expect result)))

(check-sat)
(exit)
