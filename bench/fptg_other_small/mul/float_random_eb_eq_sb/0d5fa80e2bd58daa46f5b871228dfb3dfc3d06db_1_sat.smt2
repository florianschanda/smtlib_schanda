(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00011 #b1101)
                arg1
                (fp #b0 #b01111 #b0110)))
(assert (fp.leq (fp #b0 #b01111 #b0110)
                arg1
                (fp #b0 #b01111 #b1100)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg2
                (fp #b0 #b00000 #b0001)))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                arg2
                (fp #b0 #b10011 #b1100)))
; arg2 = 0.000003814697265625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1101)
                expect
                (fp #b0 #b00000 #b0001)))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                expect
                (fp #b0 #b00101 #b1000)))
; expect = 0.000003814697265625

(assert (= expect result))

(check-sat)
(exit)
