(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 7))
(assert (fp.leq (fp #b1 #b10 #b110001)
                arg1
                (fp #b1 #b10 #b100111)))
(assert (fp.leq (fp #b1 #b10 #b100111)
                arg1
                (fp #b0 #b10 #b111011)))
; arg1 = -3.21875

(declare-const arg2 (_ FloatingPoint 2 7))
(assert (fp.leq (fp #b0 #b00 #b110101)
                arg2
                (fp #b0 #b10 #b100000)))
(assert (fp.leq (fp #b0 #b10 #b100000)
                arg2
                (fp #b0 #b10 #b110111)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 2 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 7))
(assert (fp.leq (fp #b1 #b11 #b000000)
                expect
                (fp #b1 #b10 #b111111)))
(assert (fp.leq (fp #b1 #b10 #b111111)
                expect
                (fp #b1 #b01 #b001100)))
; expect = -3.96875

(assert (not (= expect result)))

(check-sat)
(exit)
