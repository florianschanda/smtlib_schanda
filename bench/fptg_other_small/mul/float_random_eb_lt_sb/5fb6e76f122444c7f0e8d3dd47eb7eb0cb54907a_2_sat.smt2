(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 7))
(assert (fp.leq (fp #b1 #b11100 #b000110)
                arg1
                (fp #b1 #b11001 #b110111)))
(assert (fp.leq (fp #b1 #b11001 #b110111)
                arg1
                (fp #b0 #b11011 #b110000)))
; arg1 = -1904.0

(declare-const arg2 (_ FloatingPoint 5 7))
(assert (fp.leq (fp #b0 #b10000 #b111000)
                arg2
                (fp #b0 #b10101 #b101000)))
(assert (fp.leq (fp #b0 #b10101 #b101000)
                arg2
                (fp #b0 #b10111 #b001001)))
; arg2 = 104.0

(declare-const result (_ FloatingPoint 5 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
