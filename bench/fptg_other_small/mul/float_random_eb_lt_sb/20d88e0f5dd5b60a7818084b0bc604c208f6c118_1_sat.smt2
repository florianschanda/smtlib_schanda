;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 24))
(assert (fp.leq (fp #b1 #b1110 #b11111111010011011100100)
                arg1
                (fp #b1 #b1110 #b11111110001100011010000)))
(assert (fp.leq (fp #b1 #b1110 #b11111110001100011010000)
                arg1
                (fp #b1 #b1001 #b11101100110011001101101)))
; arg1 = -255.096923828125

(declare-const arg2 (_ FloatingPoint 4 24))
(assert (fp.leq (fp #b1 #b1100 #b11011011001000000010111)
                arg2
                (fp #b1 #b1010 #b01011110011101101010000)))
(assert (fp.leq (fp #b1 #b1010 #b01011110011101101010000)
                arg2
                (fp #b0 #b1110 #b01011111101010100001000)))
; arg2 = -10.9519805908203125

(declare-const result (_ FloatingPoint 4 24))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 24))
(assert (fp.leq (fp #b0 #b0011 #b01001001011011011000111)
                expect
                (fp #b0 #b1110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b1110 #b11111111111111111111111)
                expect
                (fp #b0 #b1111 #b00000000000000000000000)))
; expect = 255.9999847412109375

(assert (= expect result))

(check-sat)
(exit)
