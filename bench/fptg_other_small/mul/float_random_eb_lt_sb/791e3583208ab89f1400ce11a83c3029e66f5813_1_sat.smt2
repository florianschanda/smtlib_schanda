                arg2
                (fp #b0 #b0000 #b0001011010100)))
(assert (fp.leq (fp #b0 #b0000 #b0001011010100)
                arg2
                (fp #b0 #b0011 #b0110101101010)))
; arg2 = 0.00138092041015625

(declare-const result (_ FloatingPoint 4 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 14))
(assert (fp.leq (fp #b1 #b0001 #b1101010001000)
                expect
                (fp #b1 #b0001 #b0110100111111)))
(assert (fp.leq (fp #b1 #b0001 #b0110100111111)
                expect
                (fp #b1 #b0000 #b0000101001000)))
; expect = -0.0220928192138671875

(assert (= expect result))

(check-sat)
(exit)
