;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 14))
(assert (fp.leq (fp #b1 #b1100 #b1000011011101)
                arg1
                (fp #b1 #b1010 #b1111111111111)))
