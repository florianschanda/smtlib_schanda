; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b010 #b10111011011)
                arg1
                (fp #b0 #b110 #b11110101101)))
(assert (fp.leq (fp #b0 #b110 #b11110101101)
                arg1
                (fp #b0 #b110 #b11110111101)))
; arg1 = 15.67578125

(declare-const arg2 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b110 #b01111001100)
                arg2
                (fp #b0 #b000 #b00001011011)))
(assert (fp.leq (fp #b0 #b000 #b00001011011)
                arg2
                (fp #b0 #b101 #b11101100111)))
; arg2 = 0.0111083984375

(declare-const result (_ FloatingPoint 3 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b001 #b01010110111)
                expect
                (fp #b0 #b000 #b10110010010)))
(assert (fp.leq (fp #b0 #b000 #b10110010010)
                expect
                (fp #b0 #b101 #b00111111111)))
; expect = 0.174072265625

(assert (not (= expect result)))

(check-sat)
(exit)
