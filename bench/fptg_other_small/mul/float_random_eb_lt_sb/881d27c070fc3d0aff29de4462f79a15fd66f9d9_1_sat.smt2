                (fp #b1 #b1001010 #b0010110)))
(assert (fp.leq (fp #b1 #b1001010 #b0010110)
                arg2
                (fp #b0 #b0100011 #b0111110)))
; arg2 = -2400.0

(declare-const result (_ FloatingPoint 7 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 8))
(assert (fp.leq (fp #b1 #b1111101 #b1001110)
                expect
                (fp #b1 #b1101010 #b0010101)))
(assert (fp.leq (fp #b1 #b1101010 #b0010101)
                expect
                (fp #b1 #b0100000 #b1001011)))
; expect = -10239202033664.0

(assert (= expect result))

(check-sat)
