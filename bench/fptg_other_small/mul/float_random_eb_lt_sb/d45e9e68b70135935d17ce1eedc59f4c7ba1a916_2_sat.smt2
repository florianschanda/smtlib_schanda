(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 2 10))
(assert (fp.leq (fp #b0 #b00 #b010001101)
                arg1
                (fp #b0 #b00 #b011110111)))
(assert (fp.leq (fp #b0 #b00 #b011110111)
                arg1
                (fp #b0 #b00 #b110110001)))
; arg1 = 0.482421875

(declare-const arg2 (_ FloatingPoint 2 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 2 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 10))
(assert (fp.leq (fp #b1 #b10 #b010101101)
                expect
                (fp #b0 #b00 #b001111000)))
(assert (fp.leq (fp #b0 #b00 #b001111000)
                expect
                (fp #b0 #b10 #b100000101)))
; expect = 0.234375

(assert (= expect result))

(check-sat)
(exit)
