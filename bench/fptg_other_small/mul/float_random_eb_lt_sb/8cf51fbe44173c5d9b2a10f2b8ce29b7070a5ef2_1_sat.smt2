; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 13))
(assert (fp.leq (fp #b1 #b00111 #b100000001011)
                arg1
                (fp #b0 #b01111 #b001001111010)))
(assert (fp.leq (fp #b0 #b01111 #b001001111010)
                arg1
                (fp #b0 #b11010 #b000010101011)))
; arg1 = 1.15478515625

(declare-const arg2 (_ FloatingPoint 5 13))
(assert (fp.leq (fp #b1 #b10001 #b100011010101)
                arg2
                (fp #b1 #b00000 #b111111111111)))
(assert (fp.leq (fp #b1 #b00000 #b111111111111)
                arg2
                (fp #b0 #b00111 #b010010011000)))
; arg2 = -0.00006102025508880615234375

(declare-const result (_ FloatingPoint 5 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 13))
(assert (fp.leq (fp #b1 #b11101 #b100000000000)
                expect
                (fp #b1 #b00001 #b001001111000)))
(assert (fp.leq (fp #b1 #b00001 #b001001111000)
                expect
                (fp #b0 #b00000 #b101001100111)))
; expect = -0.00007045269012451171875

(assert (= expect result))

(check-sat)
(exit)
