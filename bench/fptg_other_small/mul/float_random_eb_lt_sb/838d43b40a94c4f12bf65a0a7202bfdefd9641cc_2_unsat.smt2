(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 14))
(assert (fp.leq (fp #b1 #b00110010 #b0100110001011)
                arg1
                (fp #b0 #b10001011 #b1011101000110)))
(assert (fp.leq (fp #b0 #b10001011 #b1011101000110)
                arg1
                (fp #b0 #b10100111 #b1000111010011)))
; arg1 = 7075.0

(declare-const arg2 (_ FloatingPoint 8 14))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 14))
(assert (fp.leq (fp #b1 #b01010011 #b0001011010011)
                expect
                (fp #b0 #b10011000 #b0111110111101)))
(assert (fp.leq (fp #b0 #b10011000 #b0111110111101)
                expect
                (fp #b0 #b10011101 #b0010111100011)))
; expect = 50057216.0

(assert (not (= expect result)))

(check-sat)
(exit)
