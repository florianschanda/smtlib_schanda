(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 15))
(assert (fp.leq (fp #b1 #b110 #b11010001010111)
                arg1
                (fp #b1 #b101 #b01000000000000)))
(assert (fp.leq (fp #b1 #b101 #b01000000000000)
                arg1
                (fp #b0 #b001 #b11100011111110)))
; arg1 = -5.0

(declare-const arg2 (_ FloatingPoint 3 15))
(assert (fp.leq (fp #b1 #b110 #b11111111101001)
                arg2
                (fp #b1 #b110 #b11101011011100)))
(assert (fp.leq (fp #b1 #b110 #b11101011011100)
                arg2
                (fp #b1 #b101 #b11010101111001)))
; arg2 = -15.357421875

(declare-const result (_ FloatingPoint 3 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
