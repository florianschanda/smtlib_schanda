(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 8))
(assert (fp.leq (fp #b1 #b1000 #b1000100)
                arg1
                (fp #b1 #b0111 #b0000000)))
(assert (fp.leq (fp #b1 #b0111 #b0000000)
                arg1
                (fp #b0 #b1110 #b0111001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 4 8))
(assert (fp.leq (fp #b0 #b0000 #b1110111)
                arg2
                (fp #b0 #b0100 #b0000000)))
(assert (fp.leq (fp #b0 #b0100 #b0000000)
                arg2
                (fp #b0 #b1101 #b0101010)))
; arg2 = 0.125

(declare-const result (_ FloatingPoint 4 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 8))
(assert (fp.leq (fp #b1 #b0101 #b0011110)
                expect
                (fp #b1 #b0100 #b0000000)))
(assert (fp.leq (fp #b1 #b0100 #b0000000)
                expect
                (fp #b0 #b0001 #b1001110)))
; expect = -0.125

(assert (= expect result))

(check-sat)
(exit)
