; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 6))
(assert (fp.leq (fp #b1 #b10001 #b00011)
                arg1
                (fp #b0 #b10101 #b00000)))
(assert (fp.leq (fp #b0 #b10101 #b00000)
                arg1
                (fp #b0 #b10110 #b11111)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 5 6))
(assert (fp.leq (fp #b1 #b01101 #b01000)
                arg2
                (fp #b0 #b00000 #b11111)))
(assert (fp.leq (fp #b0 #b00000 #b11111)
                arg2
                (fp #b0 #b00001 #b01111)))
; arg2 = 0.0000591278076171875

(declare-const result (_ FloatingPoint 5 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 6))
(assert (fp.leq (fp #b1 #b00000 #b10011)
                expect
                (fp #b0 #b00110 #b11110)))
(assert (fp.leq (fp #b0 #b00110 #b11110)
                expect
                (fp #b0 #b10000 #b10100)))
; expect = 0.0037841796875

(assert (= expect result))

(check-sat)
(exit)
