(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b101 #b110001001110)
                arg1
                (fp #b1 #b101 #b000000000000)))
(assert (fp.leq (fp #b1 #b101 #b000000000000)
                arg1
                (fp #b0 #b001 #b111111011100)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b101 #b110001111010)
                arg2
                (fp #b0 #b110 #b111001010111)))
(assert (fp.leq (fp #b0 #b110 #b111001010111)
                arg2
                (fp #b0 #b110 #b111111010010)))
; arg2 = 15.169921875

(declare-const result (_ FloatingPoint 3 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b111 #b000000000000)
                expect
                (fp #b1 #b110 #b111111111111)))
(assert (fp.leq (fp #b1 #b110 #b111111111111)
                expect
                (fp #b0 #b011 #b010011010010)))
; expect = -15.998046875

(assert (= expect result))

(check-sat)
(exit)
