                arg2
                (fp #b0 #b111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111110 #b11111111)
                arg2
                (fp #b0 #b111111 #b00000000)))
; arg2 = 4286578688.0

(declare-const result (_ FloatingPoint 6 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 9))
(assert (fp.leq (fp #b1 #b111011 #b00001100)
                expect
                (fp #b1 #b100000 #b11111101)))
(assert (fp.leq (fp #b1 #b100000 #b11111101)
                expect
                (fp #b0 #b010011 #b11001010)))
; expect = -3.9765625

(assert (= expect result))

(check-sat)
(exit)
