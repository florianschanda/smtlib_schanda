; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 9))
(assert (fp.leq (fp #b1 #b11110 #b01010001)
                arg1
                (fp #b1 #b01111 #b01010101)))
(assert (fp.leq (fp #b1 #b01111 #b01010101)
                arg1
                (fp #b0 #b10110 #b00001000)))
; arg1 = -1.33203125

(declare-const arg2 (_ FloatingPoint 5 9))
(assert (fp.leq (fp #b1 #b11110 #b00001011)
                arg2
                (fp #b1 #b11011 #b10000110)))
(assert (fp.leq (fp #b1 #b11011 #b10000110)
                arg2
                (fp #b1 #b10011 #b11000110)))
; arg2 = -6240.0

(declare-const result (_ FloatingPoint 5 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 9))
(assert (fp.leq (fp #b1 #b11110 #b01001111)
                expect
                (fp #b0 #b11100 #b00000100)))
(assert (fp.leq (fp #b0 #b11100 #b00000100)
                expect
                (fp #b0 #b11110 #b01001011)))
; expect = 8320.0

(assert (= expect result))

(check-sat)
(exit)
