(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 22))
(assert (fp.leq (fp #b1 #b11101 #b100011010101011100111)
                arg1
                (fp #b1 #b11101 #b011010011010010000000)))
(assert (fp.leq (fp #b1 #b11101 #b011010011010010000000)
                arg1
                (fp #b1 #b01110 #b101001010011101010100)))
; arg1 = -23145.0

(declare-const arg2 (_ FloatingPoint 5 22))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 22))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 22))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
