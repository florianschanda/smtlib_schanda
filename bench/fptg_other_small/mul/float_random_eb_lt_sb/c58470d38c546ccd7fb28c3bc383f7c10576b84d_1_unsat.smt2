(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 3))
(assert (fp.leq (fp #b1 #b11 #b00)
                arg1
                (fp #b0 #b10 #b11)))
(assert (fp.leq (fp #b0 #b10 #b11)
                arg1
                (fp #b0 #b11 #b00)))
; arg1 = 3.5

(declare-const arg2 (_ FloatingPoint 2 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00 #b00)
                arg2
                (fp #b0 #b00 #b00)))
(assert (fp.leq (fp #b0 #b00 #b00)
                arg2
                (fp #b0 #b10 #b01)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 2 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00 #b00)
                expect
                (fp #b0 #b00 #b00)))
(assert (fp.leq (fp #b0 #b00 #b00)
                expect
                (fp #b0 #b10 #b01)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
