(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b0 #b101 #b0000)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b001 #b0111)
                arg2
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg2
                (fp #b0 #b101 #b1110)))
; arg2 = 3.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b1 #b101 #b1010)))
(assert (fp.leq (fp #b1 #b101 #b1010)
                expect
                (fp #b1 #b001 #b0100)))
; expect = -6.5

(assert (= expect result))

(check-sat)
(exit)
