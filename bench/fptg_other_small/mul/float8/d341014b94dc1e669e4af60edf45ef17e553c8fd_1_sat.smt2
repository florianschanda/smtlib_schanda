(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1001)
                arg1
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg1
                (fp #b0 #b111 #b0000)))
; arg1 = 15.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0011)
                arg2
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg2
                (fp #b0 #b110 #b1111)))
; arg2 = 3.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                expect
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 15.5

(assert (= expect result))

(check-sat)
(exit)
