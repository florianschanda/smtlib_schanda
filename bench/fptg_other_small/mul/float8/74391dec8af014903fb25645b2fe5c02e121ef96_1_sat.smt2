(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                arg1
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b001 #b0100)))
; arg1 = -0.75

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1011)
                arg2
                (fp #b0 #b000 #b1111)))
(assert (fp.leq (fp #b0 #b000 #b1111)
                arg2
                (fp #b0 #b110 #b0001)))
; arg2 = 0.234375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                expect
                (fp #b1 #b000 #b1011)))
(assert (fp.leq (fp #b1 #b000 #b1011)
                expect
                (fp #b0 #b100 #b0110)))
; expect = -0.171875

(assert (= expect result))

(check-sat)
(exit)
