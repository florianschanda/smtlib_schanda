(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1000)
                arg1
                (fp #b1 #b001 #b0110)))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b0 #b101 #b0110)))
; arg1 = -0.34375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg2
                (fp #b0 #b110 #b0100)))
(assert (fp.leq (fp #b0 #b110 #b0100)
                arg2
                (fp #b0 #b111 #b0000)))
; arg2 = 10.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1010)
                expect
                (fp #b1 #b100 #b1011)))
(assert (fp.leq (fp #b1 #b100 #b1011)
                expect
                (fp #b0 #b100 #b0101)))
; expect = -3.375

(assert (not (= expect result)))

(check-sat)
(exit)
