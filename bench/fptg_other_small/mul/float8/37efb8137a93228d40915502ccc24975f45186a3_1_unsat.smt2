(assert (fp.leq (fp #b1 #b010 #b1110)
                arg2
                (fp #b0 #b010 #b1001)))
(assert (fp.leq (fp #b0 #b010 #b1001)
                arg2
                (fp #b0 #b100 #b1010)))
; arg2 = 0.78125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1010)
                expect
                (fp #b0 #b010 #b1001)))
(assert (fp.leq (fp #b0 #b010 #b1001)
                expect
                (fp #b0 #b110 #b1110)))
; expect = 0.78125

(assert (not (= expect result)))

(check-sat)
(exit)
