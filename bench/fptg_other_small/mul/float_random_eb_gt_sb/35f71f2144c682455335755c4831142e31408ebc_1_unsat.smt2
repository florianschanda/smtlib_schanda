; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg1
                (fp #b1 #b11110 #b111)))
(assert (fp.leq (fp #b1 #b11110 #b111)
                arg1
                (fp #b0 #b00111 #b100)))
; arg1 = -61440.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01011 #b010)
                arg2
                (fp #b1 #b00001 #b000)))
(assert (fp.leq (fp #b1 #b00001 #b000)
                arg2
                (fp #b0 #b00010 #b101)))
; arg2 = -0.00006103515625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10111 #b110)
                expect
                (fp #b0 #b10000 #b111)))
(assert (fp.leq (fp #b0 #b10000 #b111)
                expect
                (fp #b0 #b11011 #b101)))
; expect = 3.75

(assert (not (= expect result)))

(check-sat)
(exit)
