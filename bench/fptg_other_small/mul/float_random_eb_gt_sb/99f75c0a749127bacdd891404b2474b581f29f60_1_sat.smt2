(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b011111 #b010)
                arg1
                (fp #b0 #b101100 #b110)))
(assert (fp.leq (fp #b0 #b101100 #b110)
                arg1
                (fp #b0 #b111001 #b000)))
; arg1 = 14336.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110011 #b111)
                arg2
                (fp #b1 #b100010 #b100)))
(assert (fp.leq (fp #b1 #b100010 #b100)
                arg2
                (fp #b0 #b101001 #b101)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110110 #b011)
                expect
                (fp #b1 #b110000 #b010)))
(assert (fp.leq (fp #b1 #b110000 #b010)
                expect
                (fp #b1 #b001101 #b110)))
; expect = -163840.0

(assert (= expect result))

(check-sat)
(exit)
