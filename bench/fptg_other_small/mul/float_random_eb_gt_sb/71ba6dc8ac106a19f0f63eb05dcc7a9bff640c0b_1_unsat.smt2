; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
