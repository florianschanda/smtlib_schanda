;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00111000 #b000)
                arg1
                (fp #b0 #b11001011 #b000)))
(assert (fp.leq (fp #b0 #b11001011 #b000)
                arg1
                (fp #b0 #b11101111 #b001)))
; arg1 = 75557863725914323419136.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
