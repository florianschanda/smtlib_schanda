                (fp #b1 #b10100111 #b101)))
(assert (fp.leq (fp #b1 #b10100111 #b101)
                arg2
                (fp #b0 #b01100111 #b010)))
; arg2 = -1786706395136.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11001011 #b111)
                expect
                (fp #b1 #b11000100 #b001)))
(assert (fp.leq (fp #b1 #b11000100 #b001)
                expect
                (fp #b1 #b10000100 #b100)))
; expect = -664082786653543858176.0

(assert (not (= expect result)))

