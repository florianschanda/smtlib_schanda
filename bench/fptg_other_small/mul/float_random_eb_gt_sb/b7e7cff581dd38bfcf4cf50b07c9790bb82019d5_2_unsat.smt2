(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101100 #b0001)
                arg1
                (fp #b1 #b0111111 #b0111)))
(assert (fp.leq (fp #b1 #b0111111 #b0111)
                arg1
                (fp #b1 #b0011010 #b1000)))
; arg1 = -1.4375

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0010111 #b0011)
                expect
                (fp #b0 #b1000000 #b0001)))
(assert (fp.leq (fp #b0 #b1000000 #b0001)
                expect
                (fp #b0 #b1101000 #b1100)))
; expect = 2.125

(assert (not (= expect result)))

(check-sat)
(exit)
