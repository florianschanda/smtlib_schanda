(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b10010110 #b1110)
                arg1
                (fp #b0 #b10111010 #b1111)))
(assert (fp.leq (fp #b0 #b10111010 #b1111)
                arg1
                (fp #b0 #b11111011 #b0001)))
; arg1 = 1116892707587883008.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00100001 #b1010)
                arg2
                (fp #b0 #b01111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111 #b0110)
                arg2
                (fp #b0 #b11111011 #b0100)))
; arg2 = 1.375

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00100100 #b1010)
                expect
                (fp #b0 #b10111011 #b0101)))
(assert (fp.leq (fp #b0 #b10111011 #b0101)
                expect
                (fp #b0 #b11101100 #b0100)))
; expect = 1513209474796486656.0

(assert (not (= expect result)))

(check-sat)
(exit)
