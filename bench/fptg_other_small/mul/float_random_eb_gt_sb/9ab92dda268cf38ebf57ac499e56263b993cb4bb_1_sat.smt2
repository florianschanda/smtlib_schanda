; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110000 #b010)
                arg1
                (fp #b0 #b00100011 #b000)))
(assert (fp.leq (fp #b0 #b00100011 #b000)
                arg1
                (fp #b0 #b01100000 #b011)))
; arg1 = 0.00000000000000000000000000020194839173657902218540251271239327479634084738790988922119140625

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11100010 #b100)
                arg2
                (fp #b1 #b11011100 #b110)))
(assert (fp.leq (fp #b1 #b11011100 #b110)
                arg2
                (fp #b1 #b10000101 #b111)))
; arg2 = -17331160549995323848587739136.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110011 #b001)
                expect
                (fp #b1 #b10000000 #b110)))
(assert (fp.leq (fp #b1 #b10000000 #b110)
                expect
                (fp #b1 #b00000100 #b011)))
; expect = -3.5

(assert (= expect result))

(check-sat)
(exit)
