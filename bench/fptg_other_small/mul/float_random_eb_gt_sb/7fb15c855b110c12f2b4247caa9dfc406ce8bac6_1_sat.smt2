(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00000 #b10)
                arg1
                (fp #b0 #b00000 #b10)))
(assert (fp.leq (fp #b0 #b00000 #b10)
                arg1
                (fp #b0 #b10101 #b11)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b11)
                arg2
                (fp #b1 #b10011 #b01)))
(assert (fp.leq (fp #b1 #b10011 #b01)
                arg2
                (fp #b0 #b11110 #b10)))
; arg2 = -20.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00110 #b00)
                expect
                (fp #b1 #b00100 #b01)))
(assert (fp.leq (fp #b1 #b00100 #b01)
                expect
                (fp #b1 #b00010 #b01)))
; expect = -0.0006103515625

(assert (= expect result))

(check-sat)
(exit)
