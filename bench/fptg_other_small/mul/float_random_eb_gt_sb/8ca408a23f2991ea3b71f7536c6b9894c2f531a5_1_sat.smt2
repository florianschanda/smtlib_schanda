(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011100 #b10)
                arg1
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                arg1
                (fp #b0 #b111101 #b11)))
; arg1 = -0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110001 #b10)
                arg2
                (fp #b1 #b100000 #b10)))
(assert (fp.leq (fp #b1 #b100000 #b10)
                arg2
                (fp #b1 #b000110 #b11)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000101 #b01)
                expect
                (fp #b0 #b000001 #b10)))
(assert (fp.leq (fp #b0 #b000001 #b10)
                expect
                (fp #b0 #b001100 #b00)))
; expect = 0.0000000013969838619232177734375

(assert (= expect result))

(check-sat)
(exit)
