(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101010 #b00001)
                arg1
                (fp #b1 #b1001101 #b11101)))
(assert (fp.leq (fp #b1 #b1001101 #b11101)
                arg1
                (fp #b1 #b0101101 #b01001)))
; arg1 = -31232.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1011011 #b00100)
                arg2
                (fp #b0 #b0111111 #b11010)))
(assert (fp.leq (fp #b0 #b0111111 #b11010)
                arg2
                (fp #b0 #b1000010 #b01110)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1010100 #b11000)
                expect
                (fp #b1 #b1001110 #b11000)))
(assert (fp.leq (fp #b1 #b1001110 #b11000)
                expect
                (fp #b1 #b0100001 #b10001)))
; expect = -57344.0

(assert (= expect result))

(check-sat)
(exit)
