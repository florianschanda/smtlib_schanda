; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00001011 #b100011)
                arg1
                (fp #b0 #b10000111 #b101110)))
(assert (fp.leq (fp #b0 #b10000111 #b101110)
                arg1
                (fp #b0 #b10101011 #b000010)))
; arg1 = 440.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10001110 #b110101)
                arg2
                (fp #b0 #b10100101 #b111111)))
(assert (fp.leq (fp #b0 #b10100101 #b111111)
                arg2
                (fp #b0 #b11000101 #b111101)))
; arg2 = 545460846592.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00100011 #b001110)
                expect
                (fp #b0 #b10101110 #b101110)))
(assert (fp.leq (fp #b0 #b10101110 #b101110)
                expect
                (fp #b0 #b11001000 #b110010)))
; expect = 241892558110720.0

(assert (not (= expect result)))

(check-sat)
(exit)
