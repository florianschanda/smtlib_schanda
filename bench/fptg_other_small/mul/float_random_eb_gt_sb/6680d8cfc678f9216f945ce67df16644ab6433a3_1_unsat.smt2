(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111011 #b10111)
                arg1
                (fp #b1 #b1000100 #b10101)))
(assert (fp.leq (fp #b1 #b1000100 #b10101)
                arg1
                (fp #b1 #b0011011 #b11000)))
; arg1 = -53.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0110001 #b01111)
                arg2
                (fp #b0 #b1100001 #b00010)))
(assert (fp.leq (fp #b0 #b1100001 #b00010)
                arg2
                (fp #b0 #b1101000 #b00100)))
; arg2 = 18253611008.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101001 #b11101)
                expect
                (fp #b1 #b1100110 #b11000)))
(assert (fp.leq (fp #b1 #b1100110 #b11000)
                expect
                (fp #b1 #b1001000 #b01111)))
; expect = -962072674304.0

(assert (not (= expect result)))

(check-sat)
(exit)
