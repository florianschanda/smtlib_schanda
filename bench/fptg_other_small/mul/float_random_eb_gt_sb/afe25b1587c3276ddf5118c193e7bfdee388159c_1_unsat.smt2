; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10001 #b011)
                arg1
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg1
                (fp #b0 #b01011 #b100)))
; arg1 = -0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b101)
                arg2
                (fp #b1 #b01111 #b101)))
(assert (fp.leq (fp #b1 #b01111 #b101)
                arg2
                (fp #b1 #b01011 #b001)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b100)
                expect
                (fp #b0 #b00000 #b011)))
(assert (fp.leq (fp #b0 #b00000 #b011)
                expect
                (fp #b0 #b11100 #b100)))
; expect = 0.00002288818359375

(assert (not (= expect result)))

(check-sat)
(exit)
