; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b00101111 #b10111)
                arg1
                (fp #b0 #b11000010 #b01111)))
(assert (fp.leq (fp #b0 #b11000010 #b01111)
                arg1
                (fp #b0 #b11100101 #b00000)))
; arg1 = 216749242866087231488.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10110011 #b00000)
                arg2
                (fp #b1 #b10000010 #b11000)))
(assert (fp.leq (fp #b1 #b10000010 #b11000)
                arg2
                (fp #b0 #b10011111 #b11000)))
; arg2 = -14.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11010110 #b10010)
                expect
                (fp #b1 #b11000110 #b01010)))
(assert (fp.leq (fp #b1 #b11000110 #b01010)
                expect
                (fp #b1 #b10110000 #b01100)))
; expect = -3099053004383204671488.0

(assert (= expect result))

(check-sat)
(exit)
