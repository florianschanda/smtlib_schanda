(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b00)
                arg1
                (fp #b1 #b1010 #b00)))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg1
                (fp #b0 #b1110 #b00)))
; arg1 = -8.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg2
                (fp #b1 #b1001 #b10)))
(assert (fp.leq (fp #b1 #b1001 #b10)
                arg2
                (fp #b0 #b0100 #b01)))
; arg2 = -6.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b00)
                expect
                (fp #b0 #b1100 #b10)))
(assert (fp.leq (fp #b0 #b1100 #b10)
                expect
                (fp #b0 #b1110 #b01)))
; expect = 48.0

(assert (= expect result))

(check-sat)
(exit)
