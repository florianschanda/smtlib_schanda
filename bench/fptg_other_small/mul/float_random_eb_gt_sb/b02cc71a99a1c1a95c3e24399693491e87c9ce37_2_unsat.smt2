(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b0 #b0000110 #b1)
                arg1
                (fp #b0 #b1011010 #b1)))
(assert (fp.leq (fp #b0 #b1011010 #b1)
                arg1
                (fp #b0 #b1011011 #b1)))
; arg1 = 201326592.0

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b0 #b0011001 #b0)
                expect
                (fp #b0 #b1110110 #b1)))
(assert (fp.leq (fp #b0 #b1110110 #b1)
                expect
                (fp #b0 #b1111101 #b1)))
; expect = 54043195528445952.0

(assert (not (= expect result)))

(check-sat)
(exit)
