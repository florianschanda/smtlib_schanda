(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110011 #b1001)
                arg1
                (fp #b0 #b010000 #b0000)))
(assert (fp.leq (fp #b0 #b010000 #b0000)
                arg1
                (fp #b0 #b100001 #b1110)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001011 #b0111)
                arg2
                (fp #b0 #b011111 #b0110)))
(assert (fp.leq (fp #b0 #b011111 #b0110)
                arg2
                (fp #b0 #b100000 #b1101)))
; arg2 = 1.375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b000111 #b0001)
                expect
                (fp #b0 #b010000 #b0110)))
(assert (fp.leq (fp #b0 #b010000 #b0110)
                expect
                (fp #b0 #b010110 #b0010)))
; expect = 0.000041961669921875

(assert (= expect result))

(check-sat)
(exit)
