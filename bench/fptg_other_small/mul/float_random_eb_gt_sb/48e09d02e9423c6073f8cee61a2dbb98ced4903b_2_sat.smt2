(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111010 #b10010)
                arg1
                (fp #b0 #b0011101 #b01101)))
(assert (fp.leq (fp #b0 #b0011101 #b01101)
                arg1
                (fp #b0 #b1010101 #b01100)))
; arg1 = 0.000000000081854523159563541412353515625

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0111101 #b11010)
                arg2
                (fp #b0 #b1100001 #b00010)))
(assert (fp.leq (fp #b0 #b1100001 #b00010)
                arg2
                (fp #b0 #b1101001 #b10000)))
; arg2 = 18253611008.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0000000 #b01111)
                expect
                (fp #b0 #b0111111 #b10000)))
(assert (fp.leq (fp #b0 #b0111111 #b10000)
                expect
                (fp #b0 #b1010011 #b11010)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
