; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b110)
                arg1
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg1
                (fp #b0 #b110000 #b011)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110011 #b010)
                arg2
                (fp #b0 #b000000 #b111)))
(assert (fp.leq (fp #b0 #b000000 #b111)
                arg2
                (fp #b0 #b001110 #b100)))
; arg2 = 0.000000000814907252788543701171875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111001 #b101)
                expect
                (fp #b1 #b011110 #b110)))
(assert (fp.leq (fp #b1 #b011110 #b110)
                expect
                (fp #b0 #b111001 #b110)))
; expect = -0.875

(assert (not (= expect result)))

(check-sat)
(exit)
