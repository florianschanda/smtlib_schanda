(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b01)
                arg1
                (fp #b0 #b10001 #b11)))
(assert (fp.leq (fp #b0 #b10001 #b11)
                arg1
                (fp #b0 #b11100 #b11)))
; arg1 = 7.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11000 #b00)
                expect
                (fp #b1 #b10100 #b10)))
(assert (fp.leq (fp #b1 #b10100 #b10)
                expect
                (fp #b0 #b01101 #b11)))
; expect = -48.0

(assert (not (= expect result)))

(check-sat)
(exit)
