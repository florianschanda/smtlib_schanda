(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b000 #b0)
                arg1
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                arg1
                (fp #b0 #b011 #b1)))
; arg1 = 0.125

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b1)
                arg2
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                arg2
                (fp #b0 #b100 #b0)))
; arg2 = -0.125

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000 #b1)
                expect
                (fp #b1 #b000 #b0)))
(assert (fp.leq (fp #b1 #b000 #b0)
                expect
                (fp #b0 #b100 #b0)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
