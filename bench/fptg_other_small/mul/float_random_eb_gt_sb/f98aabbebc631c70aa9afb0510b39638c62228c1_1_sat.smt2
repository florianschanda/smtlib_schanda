(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00101 #b10)
                arg1
                (fp #b1 #b00000 #b01)))
(assert (fp.leq (fp #b1 #b00000 #b01)
                arg1
                (fp #b0 #b11001 #b10)))
; arg1 = -0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b11)
                arg2
                (fp #b1 #b10011 #b01)))
(assert (fp.leq (fp #b1 #b10011 #b01)
                arg2
                (fp #b0 #b00001 #b11)))
; arg2 = -20.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10010 #b01)
                expect
                (fp #b0 #b00011 #b01)))
(assert (fp.leq (fp #b0 #b00011 #b01)
                expect
                (fp #b0 #b10010 #b11)))
; expect = 0.00030517578125

(assert (= expect result))

(check-sat)
(exit)
