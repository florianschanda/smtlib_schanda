(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b00)
                arg1
                (fp #b0 #b0111 #b11)))
(assert (fp.leq (fp #b0 #b0111 #b11)
                arg1
                (fp #b0 #b1001 #b01)))
; arg1 = 1.75

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1111 #b00)
                arg2
                (fp #b1 #b1010 #b11)))
(assert (fp.leq (fp #b1 #b1010 #b11)
                arg2
                (fp #b0 #b0001 #b10)))
; arg2 = -14.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                expect
                (fp #b1 #b1011 #b11)))
(assert (fp.leq (fp #b1 #b1011 #b11)
                expect
                (fp #b0 #b0101 #b01)))
; expect = -28.0

(assert (not (= expect result)))

(check-sat)
(exit)
