(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100100 #b110)
                arg1
                (fp #b0 #b100010 #b111)))
(assert (fp.leq (fp #b0 #b100010 #b111)
                arg1
                (fp #b0 #b110011 #b000)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110111 #b011)
                arg2
                (fp #b1 #b101110 #b111)))
(assert (fp.leq (fp #b1 #b101110 #b111)
                arg2
                (fp #b0 #b110100 #b101)))
; arg2 = -61440.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110100 #b110)
                expect
                (fp #b1 #b110010 #b111)))
(assert (fp.leq (fp #b1 #b110010 #b111)
                expect
                (fp #b1 #b010001 #b111)))
; expect = -983040.0

(assert (= expect result))

(check-sat)
(exit)
