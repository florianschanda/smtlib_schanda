(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111111 #b0000)
                arg1
                (fp #b1 #b11111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111)
                arg1
                (fp #b1 #b10011010 #b1101)))
; arg1 = -329648542954659136480144150949525454848.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111011 #b0010)
                arg2
                (fp #b1 #b01111111 #b0110)))
(assert (fp.leq (fp #b1 #b01111111 #b0110)
                arg2
                (fp #b0 #b00101011 #b0010)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
