(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11100 #b11)
                arg1
                (fp #b1 #b01100 #b01)))
(assert (fp.leq (fp #b1 #b01100 #b01)
                arg1
                (fp #b1 #b01011 #b00)))
; arg1 = -0.15625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11011 #b10)
                arg2
                (fp #b1 #b00001 #b00)))
(assert (fp.leq (fp #b1 #b00001 #b00)
                arg2
                (fp #b0 #b10110 #b11)))
; arg2 = -0.00006103515625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00001 #b00)
                expect
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                expect
                (fp #b0 #b11101 #b11)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
