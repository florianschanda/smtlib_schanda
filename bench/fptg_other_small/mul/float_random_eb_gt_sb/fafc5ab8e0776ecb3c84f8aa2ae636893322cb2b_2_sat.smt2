(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b1011)
                arg1
                (fp #b0 #b000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000 #b0100)
                arg1
                (fp #b0 #b101000 #b0100)))
; arg1 = 0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110111 #b0101)
                arg2
                (fp #b1 #b011111 #b0010)))
(assert (fp.leq (fp #b1 #b011111 #b0010)
                arg2
                (fp #b1 #b011011 #b0010)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100101 #b1000)
                expect
                (fp #b1 #b000000 #b0101)))
(assert (fp.leq (fp #b1 #b000000 #b0101)
                expect
                (fp #b0 #b010000 #b1010)))
; expect = -0.0000000002910383045673370361328125

(assert (= expect result))

(check-sat)
(exit)
