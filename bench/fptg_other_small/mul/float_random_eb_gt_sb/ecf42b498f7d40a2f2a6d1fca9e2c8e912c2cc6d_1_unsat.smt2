(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00100111 #b0011)
                arg1
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                arg1
                (fp #b0 #b01110000 #b0110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111001 #b1001)
                arg2
                (fp #b0 #b10000011 #b0001)))
(assert (fp.leq (fp #b0 #b10000011 #b0001)
                arg2
                (fp #b0 #b11011010 #b1010)))
; arg2 = 17.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100110 #b1001)
                expect
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                expect
                (fp #b0 #b01100000 #b0010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
