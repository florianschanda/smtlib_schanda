(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101100 #b0101)
                arg1
                (fp #b1 #b1011110 #b1111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111)
                arg1
                (fp #b1 #b1000101 #b0111)))
; arg1 = -4160749568.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110110 #b1011)
                arg2
                (fp #b1 #b1011010 #b1100)))
(assert (fp.leq (fp #b1 #b1011010 #b1100)
                arg2
                (fp #b0 #b0000110 #b1001)))
; arg2 = -234881024.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0011011 #b0101)
                expect
                (fp #b0 #b1111010 #b1100)))
(assert (fp.leq (fp #b0 #b1111010 #b1100)
                expect
                (fp #b0 #b1111011 #b1111)))
; expect = 1008806316530991104.0

(assert (= expect result))

(check-sat)
(exit)
