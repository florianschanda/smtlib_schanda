(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101100 #b11)
                arg1
                (fp #b1 #b011111 #b01)))
(assert (fp.leq (fp #b1 #b011111 #b01)
                arg1
                (fp #b0 #b111000 #b01)))
; arg1 = -1.25

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b011100 #b01)
                arg2
                (fp #b0 #b111101 #b00)))
(assert (fp.leq (fp #b0 #b111101 #b00)
                arg2
                (fp #b0 #b111110 #b00)))
; arg2 = 1073741824.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b11)
                expect
                (fp #b1 #b111101 #b01)))
(assert (fp.leq (fp #b1 #b111101 #b01)
                expect
                (fp #b0 #b111100 #b10)))
; expect = -1342177280.0

(assert (= expect result))

(check-sat)
(exit)
