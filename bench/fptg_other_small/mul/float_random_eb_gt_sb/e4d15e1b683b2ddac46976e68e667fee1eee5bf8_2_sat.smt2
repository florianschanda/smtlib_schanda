(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010101 #b100)
                arg1
                (fp #b1 #b000000 #b110)))
(assert (fp.leq (fp #b1 #b000000 #b110)
                arg1
                (fp #b0 #b010011 #b010)))
; arg1 = -0.00000000069849193096160888671875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101010 #b101)
                expect
                (fp #b1 #b000000 #b001)))
(assert (fp.leq (fp #b1 #b000000 #b001)
                expect
                (fp #b0 #b110101 #b111)))
; expect = -0.000000000116415321826934814453125

(assert (= expect result))

(check-sat)
(exit)
