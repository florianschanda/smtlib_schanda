; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b010)
                arg1
                (fp #b0 #b010011 #b100)))
(assert (fp.leq (fp #b0 #b010011 #b100)
                arg1
                (fp #b0 #b111001 #b100)))
; arg1 = 0.0003662109375

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010000 #b000)
                arg2
                (fp #b0 #b011111 #b000)))
(assert (fp.leq (fp #b0 #b011111 #b000)
                arg2
                (fp #b0 #b101110 #b001)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b110)
                expect
                (fp #b0 #b010011 #b100)))
(assert (fp.leq (fp #b0 #b010011 #b100)
                expect
                (fp #b0 #b100100 #b001)))
; expect = 0.0003662109375

(assert (not (= expect result)))

(check-sat)
(exit)
