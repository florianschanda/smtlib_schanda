(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01111111 #b0001)
                arg1
                (fp #b0 #b10000011 #b0110)))
(assert (fp.leq (fp #b0 #b10000011 #b0110)
                arg1
                (fp #b0 #b11101010 #b0010)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10001001 #b0111)
                arg2
                (fp #b1 #b10000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000011 #b1110)
                arg2
                (fp #b0 #b01110010 #b0011)))
; arg2 = -30.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11000000 #b0110)
                expect
                (fp #b1 #b10001000 #b0101)))
(assert (fp.leq (fp #b1 #b10001000 #b0101)
                expect
                (fp #b1 #b00110001 #b1110)))
; expect = -672.0

(assert (= expect result))

(check-sat)
(exit)
