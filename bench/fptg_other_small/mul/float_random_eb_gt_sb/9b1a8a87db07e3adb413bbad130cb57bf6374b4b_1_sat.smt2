(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1110111 #b1)
                arg1
                (fp #b1 #b1100011 #b1)))
(assert (fp.leq (fp #b1 #b1100011 #b1)
                arg1
                (fp #b1 #b0000010 #b0)))
; arg1 = -103079215104.0

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0110101 #b0)
                arg2
                (fp #b0 #b0111111 #b1)))
(assert (fp.leq (fp #b0 #b0111111 #b1)
                arg2
                (fp #b0 #b1011100 #b0)))
; arg2 = 1.5

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1100101 #b0)
                expect
                (fp #b1 #b1100100 #b0)))
(assert (fp.leq (fp #b1 #b1100100 #b0)
                expect
                (fp #b1 #b1011110 #b0)))
; expect = -137438953472.0

(assert (= expect result))

(check-sat)
(exit)
