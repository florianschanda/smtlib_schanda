(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b01111101 #b0)
                arg1
                (fp #b0 #b10111111 #b1)))
(assert (fp.leq (fp #b0 #b10111111 #b1)
                arg1
                (fp #b0 #b11011010 #b0)))
; arg1 = 27670116110564327424.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11111101 #b1)
                arg2
                (fp #b1 #b11110101 #b0)))
(assert (fp.leq (fp #b1 #b11110101 #b0)
                arg2
                (fp #b1 #b10101000 #b1)))
; arg2 = -332306998946228968225951765070086144.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11111111 #b0)
                expect
                (fp #b1 #b11111110 #b1)))
(assert (fp.leq (fp #b1 #b11111110 #b1)
                expect
                (fp #b1 #b10001001 #b1)))
; expect = -255211775190703847597530955573826158592.0

(assert (= expect result))

(check-sat)
(exit)
