(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01001 #b011)
                arg1
                (fp #b0 #b00001 #b000)))
(assert (fp.leq (fp #b0 #b00001 #b000)
                arg1
                (fp #b0 #b11100 #b010)))
; arg1 = 0.00006103515625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10110 #b010)
                arg2
                (fp #b1 #b00000 #b001)))
(assert (fp.leq (fp #b1 #b00000 #b001)
                arg2
                (fp #b0 #b10001 #b111)))
; arg2 = -0.00000762939453125

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00111 #b101)
                expect
                (fp #b1 #b00000 #b001)))
(assert (fp.leq (fp #b1 #b00000 #b001)
                expect
                (fp #b0 #b11011 #b111)))
; expect = -0.00000762939453125

(assert (= expect result))

(check-sat)
(exit)
