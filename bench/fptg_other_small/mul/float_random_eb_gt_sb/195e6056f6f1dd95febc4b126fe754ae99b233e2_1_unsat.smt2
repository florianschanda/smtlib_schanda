;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0101001 #b111)
                arg1
                (fp #b1 #b0000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000 #b010)
                arg1
