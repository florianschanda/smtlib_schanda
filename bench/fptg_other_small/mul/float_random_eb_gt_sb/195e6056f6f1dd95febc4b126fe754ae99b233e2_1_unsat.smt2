                arg2
                (fp #b1 #b0000000 #b001)))
(assert (fp.leq (fp #b1 #b0000000 #b001)
                arg2
                (fp #b0 #b0001010 #b110)))
; arg2 = -0.00000000000000000002710505431213761085018632002174854278564453125

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1000111 #b001)
                expect
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                expect
                (fp #b0 #b1100100 #b100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
