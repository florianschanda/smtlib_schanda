(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01010 #b00)
                arg1
                (fp #b0 #b10011 #b10)))
(assert (fp.leq (fp #b0 #b10011 #b10)
                arg1
                (fp #b0 #b11000 #b01)))
; arg1 = 24.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11111 #b00)
                arg2
                (fp #b1 #b11110 #b11)))
(assert (fp.leq (fp #b1 #b11110 #b11)
                arg2
                (fp #b0 #b11110 #b00)))
; arg2 = -57344.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
