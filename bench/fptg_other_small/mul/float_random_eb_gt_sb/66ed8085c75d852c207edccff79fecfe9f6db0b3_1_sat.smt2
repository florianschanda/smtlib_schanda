; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b1010111 #b0011)
                arg1
                (fp #b0 #b1101100 #b0010)))
(assert (fp.leq (fp #b0 #b1101100 #b0010)
                arg1
                (fp #b0 #b1101111 #b1100)))
; arg1 = 39582418599936.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110100 #b0010)
                arg2
                (fp #b1 #b1011110 #b1111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111)
                arg2
                (fp #b1 #b1011100 #b0110)))
; arg2 = -4160749568.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111111 #b0000)
                expect
                (fp #b1 #b1111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111)
                expect
                (fp #b0 #b1111111 #b0000)))
; expect = -17870283321406128128.0

(assert (= expect result))

(check-sat)
(exit)
