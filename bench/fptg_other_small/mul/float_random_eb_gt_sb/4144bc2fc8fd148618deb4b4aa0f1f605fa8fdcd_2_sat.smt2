(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111100 #b1111)
                arg1
                (fp #b1 #b010100 #b0011)))
(assert (fp.leq (fp #b1 #b010100 #b0011)
                arg1
                (fp #b0 #b001000 #b0001)))
; arg1 = -0.000579833984375

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001100 #b1111)
                expect
                (fp #b0 #b001001 #b0111)))
(assert (fp.leq (fp #b0 #b001001 #b0111)
                expect
                (fp #b0 #b011011 #b1010)))
; expect = 0.00000034272670745849609375

(assert (= expect result))

(check-sat)
(exit)
