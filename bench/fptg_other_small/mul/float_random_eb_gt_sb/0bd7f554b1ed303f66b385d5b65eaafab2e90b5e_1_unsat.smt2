(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100111 #b0)
                arg1
                (fp #b1 #b100000 #b1)))
(assert (fp.leq (fp #b1 #b100000 #b1)
                arg1
                (fp #b0 #b100001 #b0)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111100 #b1)
                arg2
                (fp #b0 #b110101 #b1)))
(assert (fp.leq (fp #b0 #b110101 #b1)
                arg2
                (fp #b0 #b111111 #b0)))
; arg2 = 6291456.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111001 #b1)
                expect
                (fp #b1 #b110111 #b0)))
(assert (fp.leq (fp #b1 #b110111 #b0)
                expect
                (fp #b0 #b101110 #b0)))
; expect = -16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
