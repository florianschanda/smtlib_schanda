(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000111 #b10)
                arg1
                (fp #b0 #b100001 #b10)))
(assert (fp.leq (fp #b0 #b100001 #b10)
                arg1
                (fp #b0 #b111011 #b11)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg2
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                arg2
                (fp #b1 #b100010 #b01)))
; arg2 = -3758096384.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                expect
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                expect
                (fp #b0 #b100101 #b01)))
; expect = -3758096384.0

(assert (not (= expect result)))

(check-sat)
(exit)
