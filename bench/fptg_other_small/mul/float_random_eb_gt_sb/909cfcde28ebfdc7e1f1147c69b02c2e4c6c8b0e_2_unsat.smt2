(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010010 #b11)
                arg1
                (fp #b0 #b100011 #b10)))
(assert (fp.leq (fp #b0 #b100011 #b10)
                arg1
                (fp #b0 #b111001 #b00)))
; arg1 = 24.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101011 #b11)
                arg2
                (fp #b1 #b100001 #b10)))
(assert (fp.leq (fp #b1 #b100001 #b10)
                arg2
                (fp #b0 #b001111 #b10)))
; arg2 = -6.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101110 #b00)
                expect
                (fp #b1 #b100110 #b01)))
(assert (fp.leq (fp #b1 #b100110 #b01)
                expect
                (fp #b0 #b000001 #b00)))
; expect = -160.0

(assert (not (= expect result)))

(check-sat)
(exit)
