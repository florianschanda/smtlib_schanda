(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b00110100 #b00)
                arg1
                (fp #b1 #b00000000 #b11)))
(assert (fp.leq (fp #b1 #b00000000 #b11)
                arg1
                (fp #b0 #b00001001 #b01)))
; arg1 = -0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111111 #b00)
                arg2
                (fp #b1 #b11111110 #b11)))
(assert (fp.leq (fp #b1 #b11111110 #b11)
                arg2
                (fp #b0 #b01111011 #b01)))
; arg2 = -297747071055821155530452781502797185024.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00010011 #b10)
                expect
                (fp #b0 #b10000000 #b10)))
(assert (fp.leq (fp #b0 #b10000000 #b10)
                expect
                (fp #b0 #b10101110 #b01)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
