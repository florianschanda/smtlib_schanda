(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11100 #b011)
                expect
                (fp #b0 #b00111 #b110)))
(assert (fp.leq (fp #b0 #b00111 #b110)
                expect
                (fp #b0 #b11110 #b000)))
; expect = 0.0068359375

(assert (not (= expect result)))

