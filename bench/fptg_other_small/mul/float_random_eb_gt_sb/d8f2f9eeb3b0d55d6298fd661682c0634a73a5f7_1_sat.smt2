(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111101 #b111)
                arg1
                (fp #b1 #b0101111 #b111)))
(assert (fp.leq (fp #b1 #b0101111 #b111)
                arg1
                (fp #b0 #b0111010 #b011)))
; arg1 = -0.0000286102294921875

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0001100 #b111)
                arg2
                (fp #b0 #b0000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000 #b001)
                arg2
                (fp #b0 #b1000001 #b110)))
; arg2 = 0.00000000000000000002710505431213761085018632002174854278564453125

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110101 #b101)
                expect
                (fp #b1 #b0000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000 #b000)
                expect
                (fp #b0 #b0000110 #b101)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
