(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01111 #b01)
                arg1
                (fp #b1 #b01111 #b00)))
(assert (fp.leq (fp #b1 #b01111 #b00)
                arg1
                (fp #b1 #b01010 #b11)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b01)
                arg2
                (fp #b1 #b11101 #b00)))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg2
                (fp #b0 #b01110 #b11)))
; arg2 = -16384.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b01111 #b01)
                expect
                (fp #b0 #b11101 #b00)))
(assert (fp.leq (fp #b0 #b11101 #b00)
                expect
                (fp #b0 #b11101 #b11)))
; expect = 16384.0

(assert (= expect result))

(check-sat)
(exit)
