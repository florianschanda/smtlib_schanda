(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11100111 #b011)
                arg1
                (fp #b1 #b10111110 #b111)))
(assert (fp.leq (fp #b1 #b10111110 #b111)
                arg1
                (fp #b1 #b00111000 #b011)))
; arg1 = -17293822569102704640.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10111000 #b111)
                arg2
                (fp #b1 #b01111111 #b101)))
(assert (fp.leq (fp #b1 #b01111111 #b101)
                arg2
                (fp #b0 #b01011101 #b111)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110000 #b110)
                expect
                (fp #b0 #b10111111 #b100)))
(assert (fp.leq (fp #b0 #b10111111 #b100)
                expect
                (fp #b0 #b11101100 #b111)))
; expect = 27670116110564327424.0

(assert (= expect result))

(check-sat)
(exit)
