                arg2
                (fp #b1 #b0101100 #b10010)))
; arg2 = -0.00008392333984375

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0001110 #b00001)
                expect
                (fp #b0 #b0110010 #b00011)))
(assert (fp.leq (fp #b0 #b0110010 #b00011)
                expect
                (fp #b0 #b1111100 #b00111)))
; expect = 0.000133514404296875

(assert (not (= expect result)))

