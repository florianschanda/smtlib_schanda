;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011001 #b100)
                arg1
                (fp #b0 #b000000 #b111)))
(assert (fp.leq (fp #b0 #b000000 #b111)
                arg1
                (fp #b0 #b010101 #b111)))
; arg1 = 0.000000000814907252788543701171875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b101)
                arg2
                (fp #b0 #b111101 #b000)))
(assert (fp.leq (fp #b0 #b111101 #b000)
                arg2
                (fp #b0 #b111110 #b010)))
; arg2 = 1073741824.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110110 #b001)
                expect
                (fp #b0 #b011110 #b110)))
(assert (fp.leq (fp #b0 #b011110 #b110)
                expect
                (fp #b0 #b110011 #b011)))
; expect = 0.875

(assert (not (= expect result)))

(check-sat)
(exit)
