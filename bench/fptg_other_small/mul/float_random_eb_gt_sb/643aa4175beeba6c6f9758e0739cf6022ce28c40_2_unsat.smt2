(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01001 #b01)
                arg1
                (fp #b0 #b00000 #b10)))
(assert (fp.leq (fp #b0 #b00000 #b10)
                arg1
                (fp #b0 #b10101 #b00)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11011 #b00)
                arg2
                (fp #b0 #b01000 #b00)))
(assert (fp.leq (fp #b0 #b01000 #b00)
                arg2
                (fp #b0 #b10110 #b11)))
; arg2 = 0.0078125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10100 #b01)
                expect
                (fp #b0 #b00000 #b01)))
(assert (fp.leq (fp #b0 #b00000 #b01)
                expect
                (fp #b0 #b01101 #b01)))
; expect = 0.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
