(assert (fp.leq (fp #b1 #b01111111 #b00110)
                arg2
                (fp #b0 #b01000001 #b10011)))
; arg2 = -1.1875

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01001110 #b00100)
                expect
                (fp #b1 #b00000001 #b00011)))
(assert (fp.leq (fp #b1 #b00000001 #b00011)
                expect
