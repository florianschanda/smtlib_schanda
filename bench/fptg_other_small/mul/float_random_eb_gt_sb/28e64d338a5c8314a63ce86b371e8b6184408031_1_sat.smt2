(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110001 #b10)
                arg1
                (fp #b1 #b100000 #b10)))
(assert (fp.leq (fp #b1 #b100000 #b10)
                arg1
                (fp #b0 #b001100 #b01)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b001111 #b01)
                arg2
                (fp #b0 #b001111 #b10)))
(assert (fp.leq (fp #b0 #b001111 #b10)
                arg2
                (fp #b0 #b101100 #b01)))
; arg2 = 0.00002288818359375

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b01)
                expect
                (fp #b1 #b010001 #b00)))
(assert (fp.leq (fp #b1 #b010001 #b00)
                expect
                (fp #b0 #b011111 #b11)))
; expect = -0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
