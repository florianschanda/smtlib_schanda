(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011010 #b1011)
                arg1
                (fp #b0 #b000000 #b1110)))
(assert (fp.leq (fp #b0 #b000000 #b1110)
                arg1
                (fp #b0 #b110110 #b0111)))
; arg1 = 0.000000000814907252788543701171875

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111000 #b0110)
                arg2
                (fp #b0 #b001110 #b0000)))
(assert (fp.leq (fp #b0 #b001110 #b0000)
                arg2
                (fp #b0 #b100110 #b1001)))
; arg2 = 0.00000762939453125

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101111 #b0010)
                expect
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                expect
                (fp #b0 #b000100 #b0011)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
