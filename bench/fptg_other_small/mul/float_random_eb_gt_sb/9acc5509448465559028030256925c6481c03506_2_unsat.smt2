(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10011111 #b01)
                arg1
                (fp #b1 #b10000011 #b11)))
(assert (fp.leq (fp #b1 #b10000011 #b11)
                arg1
                (fp #b0 #b01001101 #b11)))
; arg1 = -28.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10001010 #b11)
                arg2
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg2
                (fp #b0 #b01000001 #b01)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01011111 #b10)
                expect
                (fp #b0 #b10000101 #b10)))
(assert (fp.leq (fp #b0 #b10000101 #b10)
                expect
                (fp #b0 #b11011110 #b11)))
; expect = 96.0

(assert (not (= expect result)))

(check-sat)
(exit)
