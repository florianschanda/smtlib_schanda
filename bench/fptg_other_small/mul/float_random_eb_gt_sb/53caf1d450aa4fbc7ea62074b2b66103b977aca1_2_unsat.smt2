(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b1100)
                arg1
                (fp #b1 #b011111 #b1010)))
(assert (fp.leq (fp #b1 #b011111 #b1010)
                arg1
                (fp #b0 #b100010 #b1101)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100011 #b1010)
                arg2
                (fp #b1 #b000000 #b0111)))
(assert (fp.leq (fp #b1 #b000000 #b0111)
                arg2
                (fp #b0 #b110101 #b1111)))
; arg2 = -0.0000000004074536263942718505859375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b1110)
                expect
                (fp #b0 #b000000 #b1100)))
(assert (fp.leq (fp #b0 #b000000 #b1100)
                expect
                (fp #b0 #b010100 #b1101)))
; expect = 0.00000000069849193096160888671875

(assert (not (= expect result)))

(check-sat)
(exit)
