; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101001 #b11001)
                arg1
                (fp #b1 #b0011101 #b01101)))
(assert (fp.leq (fp #b1 #b0011101 #b01101)
                arg1
                (fp #b1 #b0010011 #b10101)))
; arg1 = -0.000000000081854523159563541412353515625

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0000111 #b10100)
                arg2
                (fp #b0 #b1100001 #b00010)))
(assert (fp.leq (fp #b0 #b1100001 #b00010)
                arg2
                (fp #b0 #b1100111 #b10110)))
; arg2 = 18253611008.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1100011 #b00100)
                expect
                (fp #b1 #b0111111 #b01111)))
(assert (fp.leq (fp #b1 #b0111111 #b01111)
                expect
                (fp #b0 #b1011001 #b00011)))
; expect = -1.46875

(assert (= expect result))

(check-sat)
(exit)
