(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10101 #b11)
                arg1
                (fp #b0 #b10001 #b11)))
(assert (fp.leq (fp #b0 #b10001 #b11)
                arg1
                (fp #b0 #b10010 #b11)))
; arg1 = 7.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00000 #b00)
                arg2
                (fp #b0 #b01001 #b01)))
(assert (fp.leq (fp #b0 #b01001 #b01)
                arg2
                (fp #b0 #b01101 #b11)))
; arg2 = 0.01953125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b11)
                expect
                (fp #b0 #b01100 #b01)))
(assert (fp.leq (fp #b0 #b01100 #b01)
                expect
                (fp #b0 #b01101 #b00)))
; expect = 0.15625

(assert (not (= expect result)))

(check-sat)
(exit)
