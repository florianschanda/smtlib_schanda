(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10011001 #b011010)
                arg1
                (fp #b1 #b10001100 #b011011)))
(assert (fp.leq (fp #b1 #b10001100 #b011011)
                arg1
                (fp #b0 #b11001100 #b100100)))
; arg1 = -11648.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10010010 #b110100)
                arg2
                (fp #b1 #b01111111 #b001000)))
(assert (fp.leq (fp #b1 #b01111111 #b001000)
                arg2
                (fp #b0 #b11001111 #b011001)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00100110 #b010110)
                expect
                (fp #b0 #b10001100 #b100111)))
(assert (fp.leq (fp #b0 #b10001100 #b100111)
                expect
                (fp #b0 #b11001101 #b000010)))
; expect = 13184.0

(assert (not (= expect result)))

(check-sat)
(exit)
