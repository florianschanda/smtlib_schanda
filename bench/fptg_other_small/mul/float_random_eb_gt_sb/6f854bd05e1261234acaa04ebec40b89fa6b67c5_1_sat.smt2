(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b101 #b0)))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg1
                (fp #b1 #b011 #b0)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg2
                (fp #b1 #b010 #b1)))
(assert (fp.leq (fp #b1 #b010 #b1)
                arg2
                (fp #b0 #b111 #b0)))
; arg2 = -0.75

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b000 #b0)
                expect
                (fp #b0 #b100 #b1)))
(assert (fp.leq (fp #b0 #b100 #b1)
                expect
                (fp #b0 #b110 #b1)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
