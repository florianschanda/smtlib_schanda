; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111111 #b00)
                arg1
                (fp #b1 #b1111110 #b11)))
(assert (fp.leq (fp #b1 #b1111110 #b11)
                arg1
                (fp #b0 #b0110111 #b01)))
; arg1 = -16140901064495857664.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1011000 #b01)
                arg2
                (fp #b1 #b0000000 #b11)))
(assert (fp.leq (fp #b1 #b0000000 #b11)
                arg2
                (fp #b0 #b0010100 #b01)))
; arg2 = -0.0000000000000000001626303258728256651011179201304912567138671875

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0110110 #b10)
                expect
                (fp #b0 #b1000000 #b10)))
(assert (fp.leq (fp #b0 #b1000000 #b10)
                expect
                (fp #b0 #b1010000 #b00)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
