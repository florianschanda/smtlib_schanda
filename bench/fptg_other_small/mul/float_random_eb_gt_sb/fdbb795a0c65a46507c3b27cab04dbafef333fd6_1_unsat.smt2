(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10111 #b100)
                arg1
                (fp #b1 #b01111 #b100)))
(assert (fp.leq (fp #b1 #b01111 #b100)
                arg1
                (fp #b0 #b00011 #b111)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01111 #b101)
                arg2
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                arg2
                (fp #b0 #b00001 #b110)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10110 #b001)
                expect
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                expect
                (fp #b0 #b01010 #b001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
