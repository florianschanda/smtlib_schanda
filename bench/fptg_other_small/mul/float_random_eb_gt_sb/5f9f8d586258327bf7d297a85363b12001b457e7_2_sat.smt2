(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b11)
                arg1
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                arg1
                (fp #b0 #b0100 #b00)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b11)
                arg2
                (fp #b1 #b0011 #b00)))
(assert (fp.leq (fp #b1 #b0011 #b00)
                arg2
                (fp #b0 #b0111 #b00)))
; arg2 = -0.0625

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0101 #b11)
                expect
                (fp #b1 #b0000 #b01)))
(assert (fp.leq (fp #b1 #b0000 #b01)
                expect
                (fp #b0 #b0111 #b11)))
; expect = -0.00390625

(assert (= expect result))

(check-sat)
(exit)
