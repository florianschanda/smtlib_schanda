; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01111 #b01)
                arg1
                (fp #b1 #b01100 #b01)))
(assert (fp.leq (fp #b1 #b01100 #b01)
                arg1
                (fp #b1 #b01001 #b10)))
; arg1 = -0.15625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10110 #b10)
                arg2
                (fp #b1 #b01001 #b00)))
(assert (fp.leq (fp #b1 #b01001 #b00)
                arg2
                (fp #b0 #b10101 #b01)))
; arg2 = -0.015625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11011 #b00)
                expect
                (fp #b0 #b00110 #b01)))
(assert (fp.leq (fp #b0 #b00110 #b01)
                expect
                (fp #b0 #b11001 #b01)))
; expect = 0.00244140625

(assert (not (= expect result)))

(check-sat)
(exit)
