(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0101111 #b11100)
                arg1
                (fp #b0 #b1000001 #b00000)))
(assert (fp.leq (fp #b0 #b1000001 #b00000)
                arg1
                (fp #b0 #b1111101 #b10000)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0100011 #b10011)
                arg2
                (fp #b0 #b1111101 #b00010)))
(assert (fp.leq (fp #b0 #b1111101 #b00010)
                arg2
                (fp #b0 #b1111101 #b01111)))
; arg2 = 4899916394579099648.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0010000 #b01111)
                expect
                (fp #b0 #b1111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111110 #b11111)
                expect
                (fp #b0 #b1111111 #b00000)))
; expect = 18158513697557839872.0

(assert (= expect result))

(check-sat)
(exit)
