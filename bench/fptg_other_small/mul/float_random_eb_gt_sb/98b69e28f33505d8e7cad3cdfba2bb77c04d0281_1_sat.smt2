(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110001 #b110)
                arg1
                (fp #b0 #b000000 #b001)))
(assert (fp.leq (fp #b0 #b000000 #b001)
                arg1
                (fp #b0 #b111101 #b101)))
; arg1 = 0.000000000116415321826934814453125

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000000 #b010)
                arg2
                (fp #b0 #b010000 #b000)))
(assert (fp.leq (fp #b0 #b010000 #b000)
                arg2
                (fp #b0 #b110110 #b000)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010000 #b100)
                expect
                (fp #b0 #b000000 #b000)))
(assert (fp.leq (fp #b0 #b000000 #b000)
                expect
                (fp #b0 #b101101 #b101)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
