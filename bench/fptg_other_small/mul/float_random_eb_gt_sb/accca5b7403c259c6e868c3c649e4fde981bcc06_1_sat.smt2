(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01001 #b00)
                arg1
                (fp #b1 #b00000 #b11)))
(assert (fp.leq (fp #b1 #b00000 #b11)
                arg1
                (fp #b0 #b10001 #b01)))
; arg1 = -0.0000457763671875

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01000 #b01)
                arg2
                (fp #b0 #b00001 #b00)))
(assert (fp.leq (fp #b0 #b00001 #b00)
                arg2
                (fp #b0 #b10000 #b01)))
; arg2 = 0.00006103515625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00011 #b00)
                expect
                (fp #b1 #b00000 #b00)))
(assert (fp.leq (fp #b1 #b00000 #b00)
                expect
                (fp #b0 #b11000 #b11)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
