(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg1
                (fp #b0 #b11000 #b0)))
(assert (fp.leq (fp #b0 #b11000 #b0)
                arg1
                (fp #b0 #b11101 #b0)))
; arg1 = 512.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b00101 #b0)
                arg2
                (fp #b0 #b10010 #b0)))
(assert (fp.leq (fp #b0 #b10010 #b0)
                arg2
                (fp #b0 #b11001 #b1)))
; arg2 = 8.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b00111 #b0)
                expect
                (fp #b0 #b11011 #b0)))
(assert (fp.leq (fp #b0 #b11011 #b0)
                expect
                (fp #b0 #b11110 #b0)))
; expect = 4096.0

(assert (= expect result))

(check-sat)
(exit)
