(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b000)
                arg1
                (fp #b1 #b101111 #b000)))
(assert (fp.leq (fp #b1 #b101111 #b000)
                arg1
                (fp #b0 #b010111 #b111)))
; arg1 = -65536.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000110 #b000)
                arg2
                (fp #b0 #b010000 #b000)))
(assert (fp.leq (fp #b0 #b010000 #b000)
                arg2
                (fp #b0 #b100111 #b100)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100001 #b010)
                expect
                (fp #b1 #b100000 #b000)))
(assert (fp.leq (fp #b1 #b100000 #b000)
                expect
                (fp #b0 #b111010 #b010)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
