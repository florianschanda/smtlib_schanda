(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00100011 #b011)
                arg1
                (fp #b0 #b11111110 #b111)))
(assert (fp.leq (fp #b0 #b11111110 #b111)
                arg1
                (fp #b0 #b11111111 #b000)))
; arg1 = 319014718988379809496913694467282698240.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101001 #b010)
                arg2
                (fp #b0 #b10000001 #b000)))
(assert (fp.leq (fp #b0 #b10000001 #b000)
                arg2
                (fp #b0 #b10011111 #b000)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00000110 #b000)
                expect
                (fp #b0 #b11111110 #b111)))
(assert (fp.leq (fp #b0 #b11111110 #b111)
                expect
                (fp #b0 #b11111111 #b000)))
; expect = 319014718988379809496913694467282698240.0

(assert (= expect result))

(check-sat)
(exit)
