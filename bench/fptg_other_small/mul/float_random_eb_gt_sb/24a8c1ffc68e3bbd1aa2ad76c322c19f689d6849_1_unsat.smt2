(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1100 #b1)
                arg1
                (fp #b0 #b0110 #b0)))
(assert (fp.leq (fp #b0 #b0110 #b0)
                arg1
                (fp #b0 #b1101 #b1)))
; arg1 = 0.5

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0000 #b0)
                arg2
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg2
                (fp #b0 #b1110 #b0)))
; arg2 = 0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0101 #b0)
                expect
                (fp #b0 #b0000 #b0)))
(assert (fp.leq (fp #b0 #b0000 #b0)
                expect
                (fp #b0 #b1011 #b0)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
