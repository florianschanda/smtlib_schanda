(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110010 #b1111)
                arg1
                (fp #b1 #b1000011 #b1110)))
(assert (fp.leq (fp #b1 #b1000011 #b1110)
                arg1
                (fp #b1 #b0101001 #b0111)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0010010 #b0101)
                arg2
                (fp #b0 #b1000001 #b1000)))
(assert (fp.leq (fp #b0 #b1000001 #b1000)
                arg2
                (fp #b0 #b1101000 #b0110)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100100 #b0000)
                expect
                (fp #b1 #b1000110 #b0111)))
(assert (fp.leq (fp #b1 #b1000110 #b0111)
                expect
                (fp #b0 #b0110011 #b0001)))
; expect = -184.0

(assert (= expect result))

(check-sat)
(exit)
