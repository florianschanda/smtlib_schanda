(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110001 #b0111)
                arg1
                (fp #b1 #b101110 #b1111)))
(assert (fp.leq (fp #b1 #b101110 #b1111)
                arg1
                (fp #b1 #b100111 #b1100)))
; arg1 = -63488.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101111 #b0101)
                arg2
                (fp #b1 #b101110 #b1111)))
(assert (fp.leq (fp #b1 #b101110 #b1111)
                arg2
                (fp #b1 #b001111 #b1001)))
; arg2 = -63488.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b000010 #b1010)
                expect
                (fp #b0 #b111110 #b1110)))
(assert (fp.leq (fp #b0 #b111110 #b1110)
                expect
                (fp #b0 #b111111 #b0000)))
; expect = 4026531840.0

(assert (not (= expect result)))

(check-sat)
(exit)
