(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111001 #b1)
                arg1
                (fp #b1 #b011111 #b1)))
(assert (fp.leq (fp #b1 #b011111 #b1)
                arg1
                (fp #b0 #b001011 #b1)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100010 #b1)
                arg2
                (fp #b1 #b000000 #b1)))
(assert (fp.leq (fp #b1 #b000000 #b1)
                arg2
                (fp #b0 #b101010 #b0)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b010011 #b1)
                expect
                (fp #b0 #b000001 #b0)))
(assert (fp.leq (fp #b0 #b000001 #b0)
                expect
                (fp #b0 #b011000 #b1)))
; expect = 0.000000000931322574615478515625

(assert (= expect result))

(check-sat)
(exit)
