(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011000 #b1011)
                arg1
                (fp #b1 #b0111111 #b1010)))
(assert (fp.leq (fp #b1 #b0111111 #b1010)
                arg1
                (fp #b1 #b0011011 #b0011)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101111 #b0011)
                arg2
                (fp #b1 #b1011010 #b1100)))
(assert (fp.leq (fp #b1 #b1011010 #b1100)
                arg2
                (fp #b1 #b0111111 #b0010)))
; arg2 = -234881024.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0001000 #b0000)
                expect
                (fp #b0 #b1011011 #b0111)))
(assert (fp.leq (fp #b0 #b1011011 #b0111)
                expect
                (fp #b0 #b1101101 #b1001)))
; expect = 385875968.0

(assert (= expect result))

(check-sat)
(exit)
