(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101100 #b011)
                arg1
                (fp #b1 #b011111 #b101)))
(assert (fp.leq (fp #b1 #b011111 #b101)
                arg1
                (fp #b1 #b000101 #b010)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111001 #b100)
                arg2
                (fp #b1 #b011111 #b001)))
(assert (fp.leq (fp #b1 #b011111 #b001)
                arg2
                (fp #b1 #b000110 #b010)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000001 #b000)
                expect
                (fp #b0 #b011111 #b111)))
(assert (fp.leq (fp #b0 #b011111 #b111)
                expect
                (fp #b0 #b100101 #b110)))
; expect = 1.875

(assert (= expect result))

(check-sat)
(exit)
