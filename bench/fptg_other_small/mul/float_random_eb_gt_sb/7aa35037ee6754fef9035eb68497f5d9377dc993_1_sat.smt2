(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101011 #b01)
                arg1
                (fp #b1 #b1001000 #b01)))
(assert (fp.leq (fp #b1 #b1001000 #b01)
                arg1
                (fp #b0 #b0011100 #b10)))
; arg1 = -640.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010111 #b10)
                arg2
                (fp #b1 #b0111111 #b00)))
(assert (fp.leq (fp #b1 #b0111111 #b00)
                arg2
                (fp #b0 #b1100000 #b01)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1110001 #b01)
                expect
                (fp #b0 #b1001000 #b01)))
(assert (fp.leq (fp #b0 #b1001000 #b01)
                expect
                (fp #b0 #b1001010 #b10)))
; expect = 640.0

(assert (= expect result))

(check-sat)
(exit)
