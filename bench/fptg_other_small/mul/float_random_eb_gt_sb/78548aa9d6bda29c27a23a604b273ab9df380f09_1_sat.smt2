                arg2
                (fp #b1 #b1110001 #b11011)))
(assert (fp.leq (fp #b1 #b1110001 #b11011)
                arg2
                (fp #b1 #b1000011 #b10010)))
; arg2 = -2075877953241088.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111111 #b00000)
                expect
                (fp #b1 #b1111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111110 #b11111)
                expect
                (fp #b0 #b1010010 #b10010)))
; expect = -18158513697557839872.0

(assert (= expect result))

(check-sat)
(exit)
