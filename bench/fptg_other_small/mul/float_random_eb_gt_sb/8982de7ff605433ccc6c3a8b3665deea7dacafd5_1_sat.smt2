(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010111 #b110)
                arg1
                (fp #b1 #b1000011 #b000)))
(assert (fp.leq (fp #b1 #b1000011 #b000)
                arg1
                (fp #b1 #b0001110 #b110)))
; arg1 = -16.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010101 #b110)
                arg2
                (fp #b0 #b1000001 #b000)))
(assert (fp.leq (fp #b0 #b1000001 #b000)
                arg2
                (fp #b0 #b1110000 #b001)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1011100 #b110)
                expect
                (fp #b1 #b1000101 #b000)))
(assert (fp.leq (fp #b1 #b1000101 #b000)
                expect
                (fp #b0 #b0000101 #b000)))
; expect = -64.0

(assert (= expect result))

(check-sat)
(exit)
