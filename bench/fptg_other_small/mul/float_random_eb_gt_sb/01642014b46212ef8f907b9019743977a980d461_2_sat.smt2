(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0000001 #b101)
                arg1
                (fp #b0 #b1000010 #b111)))
(assert (fp.leq (fp #b0 #b1000010 #b111)
                arg1
                (fp #b0 #b1110011 #b110)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1100101 #b110)
                arg2
                (fp #b1 #b1000010 #b100)))
(assert (fp.leq (fp #b1 #b1000010 #b100)
                arg2
                (fp #b0 #b1110000 #b110)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101000 #b001)
                expect
                (fp #b1 #b1000110 #b100)))
(assert (fp.leq (fp #b1 #b1000110 #b100)
                expect
                (fp #b1 #b0000101 #b011)))
; expect = -192.0

(assert (= expect result))

(check-sat)
(exit)
