(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0000 #b01)
                arg1
                (fp #b0 #b1010 #b11)))
(assert (fp.leq (fp #b0 #b1010 #b11)
                arg1
                (fp #b0 #b1101 #b11)))
; arg1 = 14.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0001 #b11)
                arg2
                (fp #b0 #b0111 #b11)))
(assert (fp.leq (fp #b0 #b0111 #b11)
                arg2
                (fp #b0 #b1011 #b01)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0011 #b01)
                expect
                (fp #b0 #b1011 #b10)))
(assert (fp.leq (fp #b0 #b1011 #b10)
                expect
                (fp #b0 #b1101 #b10)))
; expect = 24.0

(assert (not (= expect result)))

(check-sat)
(exit)
