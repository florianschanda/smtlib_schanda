(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10010 #b001)
                arg1
                (fp #b1 #b01111 #b101)))
(assert (fp.leq (fp #b1 #b01111 #b101)
                arg1
                (fp #b1 #b01000 #b010)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b111)
                arg2
                (fp #b1 #b00110 #b011)))
(assert (fp.leq (fp #b1 #b00110 #b011)
                arg2
                (fp #b0 #b00010 #b011)))
; arg2 = -0.002685546875

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b110)
                expect
                (fp #b0 #b00111 #b000)))
(assert (fp.leq (fp #b0 #b00111 #b000)
                expect
                (fp #b0 #b10001 #b001)))
; expect = 0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
