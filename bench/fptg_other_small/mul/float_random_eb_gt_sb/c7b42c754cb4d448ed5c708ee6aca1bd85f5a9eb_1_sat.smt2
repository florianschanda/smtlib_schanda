(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                arg1
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                arg1
                (fp #b0 #b00111011 #b000)))
; arg1 = -319014718988379809496913694467282698240.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01010010 #b110)
                arg2
                (fp #b0 #b00000000 #b011)))
(assert (fp.leq (fp #b0 #b00000000 #b011)
                arg2
                (fp #b0 #b10111101 #b011)))
; arg2 = 0.000000000000000000000000000000000000004408103815583578154882762014583421291819995837895328205657818898544064722955226898193359375

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110100 #b011)
                expect
                (fp #b1 #b01111111 #b011)))
(assert (fp.leq (fp #b1 #b01111111 #b011)
                expect
                (fp #b1 #b01110011 #b111)))
; expect = -1.375

(assert (= expect result))

(check-sat)
(exit)
