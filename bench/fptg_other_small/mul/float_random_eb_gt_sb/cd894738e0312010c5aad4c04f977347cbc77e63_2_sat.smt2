(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b111)
                arg1
                (fp #b0 #b00000 #b110)))
(assert (fp.leq (fp #b0 #b00000 #b110)
                arg1
                (fp #b0 #b01011 #b011)))
; arg1 = 0.0000457763671875

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b111)
                arg2
                (fp #b1 #b01111 #b001)))
(assert (fp.leq (fp #b1 #b01111 #b001)
                arg2
                (fp #b0 #b01011 #b011)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b010)
                expect
                (fp #b1 #b00000 #b111)))
(assert (fp.leq (fp #b1 #b00000 #b111)
                expect
                (fp #b0 #b10011 #b011)))
; expect = -0.00005340576171875

(assert (= expect result))

(check-sat)
(exit)
