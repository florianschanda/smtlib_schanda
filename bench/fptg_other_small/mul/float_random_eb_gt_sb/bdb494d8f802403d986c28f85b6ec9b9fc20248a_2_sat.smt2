(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111010 #b0101)
                arg1
                (fp #b1 #b000000 #b1000)))
(assert (fp.leq (fp #b1 #b000000 #b1000)
                arg1
                (fp #b0 #b101100 #b1010)))
; arg1 = -0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000011 #b1001)
                arg2
                (fp #b0 #b011111 #b1101)))
(assert (fp.leq (fp #b0 #b011111 #b1101)
                arg2
                (fp #b0 #b101101 #b0110)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101011 #b1100)
                expect
                (fp #b1 #b000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000 #b1111)
                expect
                (fp #b0 #b001010 #b0000)))
; expect = -0.0000000008731149137020111083984375

(assert (= expect result))

(check-sat)
(exit)
