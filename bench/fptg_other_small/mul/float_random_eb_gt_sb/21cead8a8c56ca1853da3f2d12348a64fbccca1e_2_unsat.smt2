(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b00010 #b1)
                arg1
                (fp #b0 #b00011 #b0)))
(assert (fp.leq (fp #b0 #b00011 #b0)
                arg1
                (fp #b0 #b11000 #b0)))
; arg1 = 0.000244140625

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b00001 #b0)
                arg2
                (fp #b0 #b00001 #b0)))
(assert (fp.leq (fp #b0 #b00001 #b0)
                arg2
                (fp #b0 #b01101 #b1)))
; arg2 = 0.00006103515625

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10000 #b0)
                expect
                (fp #b0 #b00000 #b1)))
(assert (fp.leq (fp #b0 #b00000 #b1)
                expect
                (fp #b0 #b11001 #b1)))
; expect = 0.000030517578125

(assert (not (= expect result)))

(check-sat)
(exit)
