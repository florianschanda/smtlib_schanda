(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010110 #b111)
                arg1
                (fp #b1 #b0111111 #b101)))
(assert (fp.leq (fp #b1 #b0111111 #b101)
                arg1
                (fp #b0 #b1110010 #b111)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1110010 #b101)
                arg2
                (fp #b1 #b1000010 #b100)))
(assert (fp.leq (fp #b1 #b1000010 #b100)
                arg2
                (fp #b0 #b0101000 #b010)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0100000 #b001)
                expect
                (fp #b0 #b1000011 #b010)))
(assert (fp.leq (fp #b0 #b1000011 #b010)
                expect
                (fp #b0 #b1010010 #b110)))
; expect = 20.0

(assert (not (= expect result)))

(check-sat)
(exit)
