(assert (fp.leq (fp #b1 #b10110100 #b0)
                arg2
                (fp #b1 #b10010100 #b0)))
; arg2 = -9007199254740992.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11010100 #b0)
                expect
                (fp #b1 #b00110110 #b0)))
(assert (fp.leq (fp #b1 #b00110110 #b0)
                expect
                (fp #b0 #b11010111 #b1)))
; expect = -0.0000000000000000000001058791184067875423835403125849552452564239501953125

