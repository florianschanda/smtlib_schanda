;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0000010 #b110)
                arg1
                (fp #b0 #b0001110 #b100)))
(assert (fp.leq (fp #b0 #b0001110 #b100)
                arg1
                (fp #b0 #b0100011 #b010)))
; arg1 = 0.00000000000000266453525910037569701671600341796875

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
