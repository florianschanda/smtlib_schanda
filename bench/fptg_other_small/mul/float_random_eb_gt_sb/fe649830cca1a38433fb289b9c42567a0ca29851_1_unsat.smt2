(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01111111 #b0001)
                arg1
                (fp #b0 #b10000011 #b0110)))
(assert (fp.leq (fp #b0 #b10000011 #b0110)
                arg1
                (fp #b0 #b11101010 #b0010)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10001001 #b0111)
                arg2
                (fp #b1 #b10000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000011 #b1110)
                arg2
                (fp #b0 #b01110010 #b0011)))
; arg2 = -30.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111000 #b0110)
                expect
                (fp #b1 #b10001000 #b0100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100)
                expect
                (fp #b1 #b01111000 #b0000)))
; expect = -640.0

(assert (not (= expect result)))

(check-sat)
(exit)
