                arg2
                (fp #b0 #b10001 #b000)))
(assert (fp.leq (fp #b0 #b10001 #b000)
                arg2
                (fp #b0 #b10011 #b100)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                expect
                (fp #b0 #b00001 #b000)))
(assert (fp.leq (fp #b0 #b00001 #b000)
                expect
                (fp #b0 #b01111 #b111)))
; expect = 0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
