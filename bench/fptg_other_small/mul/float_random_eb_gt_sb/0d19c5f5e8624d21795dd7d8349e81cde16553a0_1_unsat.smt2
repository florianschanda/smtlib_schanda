(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10101 #b000)
                arg1
                (fp #b0 #b00000 #b010)))
(assert (fp.leq (fp #b0 #b00000 #b010)
                arg1
