(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10111000 #b000110)
                arg1
                (fp #b1 #b10000110 #b000000)))
(assert (fp.leq (fp #b1 #b10000110 #b000000)
                arg1
                (fp #b0 #b01001111 #b100011)))
; arg1 = -128.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01001100 #b011100)
                arg2
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg2
                (fp #b0 #b11111110 #b111011)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111111 #b000000)
                expect
                (fp #b1 #b11111110 #b111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111)
                expect
                (fp #b1 #b10001110 #b000110)))
; expect = -337623910929368631717566993311207522304.0

(assert (= expect result))

(check-sat)
(exit)
