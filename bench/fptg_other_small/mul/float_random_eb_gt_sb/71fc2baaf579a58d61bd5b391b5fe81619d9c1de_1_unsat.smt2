(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b11)
                arg1
                (fp #b1 #b00001 #b00)))
(assert (fp.leq (fp #b1 #b00001 #b00)
                arg1
