                arg2
                (fp #b0 #b01101 #b01)))
(assert (fp.leq (fp #b0 #b01101 #b01)
                arg2
                (fp #b0 #b11100 #b00)))
; arg2 = 0.3125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10101 #b01)
                expect
                (fp #b1 #b00000 #b01)))
(assert (fp.leq (fp #b1 #b00000 #b01)
                expect
                (fp #b0 #b10001 #b11)))
; expect = -0.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
