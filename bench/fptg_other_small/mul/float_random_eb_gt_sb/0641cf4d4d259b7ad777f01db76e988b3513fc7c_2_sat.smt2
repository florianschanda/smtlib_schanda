(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b101)
                arg1
                (fp #b1 #b101000 #b101)))
(assert (fp.leq (fp #b1 #b101000 #b101)
                arg1
                (fp #b1 #b001000 #b000)))
; arg1 = -832.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000001 #b000)
                arg2
                (fp #b0 #b101110 #b111)))
(assert (fp.leq (fp #b0 #b101110 #b111)
                arg2
                (fp #b0 #b111100 #b110)))
; arg2 = 61440.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b010)
                expect
                (fp #b1 #b111000 #b101)))
(assert (fp.leq (fp #b1 #b111000 #b101)
                expect
                (fp #b0 #b011010 #b110)))
; expect = -54525952.0

(assert (= expect result))

(check-sat)
(exit)
