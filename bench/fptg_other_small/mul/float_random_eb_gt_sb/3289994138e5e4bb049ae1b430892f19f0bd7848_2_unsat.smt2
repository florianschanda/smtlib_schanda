(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110111 #b10)
                arg1
                (fp #b1 #b101110 #b11)))
(assert (fp.leq (fp #b1 #b101110 #b11)
                arg1
                (fp #b1 #b001001 #b01)))
; arg1 = -57344.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110101 #b10)
                arg2
                (fp #b0 #b100001 #b10)))
(assert (fp.leq (fp #b0 #b100001 #b10)
                arg2
                (fp #b0 #b101011 #b01)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111100 #b00)
                expect
                (fp #b1 #b110001 #b10)))
(assert (fp.leq (fp #b1 #b110001 #b10)
                expect
                (fp #b0 #b111010 #b10)))
; expect = -393216.0

(assert (not (= expect result)))

(check-sat)
(exit)
