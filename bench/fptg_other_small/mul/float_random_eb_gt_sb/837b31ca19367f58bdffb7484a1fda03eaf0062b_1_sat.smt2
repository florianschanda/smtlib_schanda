(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11110111 #b10001)
                expect
                (fp #b0 #b00000110 #b01100)))
(assert (fp.leq (fp #b0 #b00000110 #b01100)
                expect
                (fp #b0 #b00110110 #b11110)))
; expect = 0.0000000000000000000000000000000000005172175143618065035062440763777880982402128449797185094638507507625035941600799560546875

