                arg2
                (fp #b0 #b00000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000 #b110)
                arg2
                (fp #b0 #b10001001 #b111)))
; arg2 = 0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11011010 #b011)
                expect
                (fp #b1 #b01000000 #b100)))
(assert (fp.leq (fp #b1 #b01000000 #b100)
                expect
                (fp #b0 #b11001101 #b111)))
; expect = -0.0000000000000000001626303258728256651011179201304912567138671875

(assert (= expect result))

(check-sat)
(exit)
