                (fp #b1 #b1001000 #b0)))
(assert (fp.leq (fp #b1 #b1001000 #b0)
                arg2
                (fp #b1 #b1000011 #b0)))
; arg2 = -512.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1111001 #b1)
                expect
                (fp #b1 #b1100011 #b1)))
(assert (fp.leq (fp #b1 #b1100011 #b1)
                expect
                (fp #b1 #b0110001 #b1)))
; expect = -103079215104.0

(assert (not (= expect result)))

(check-sat)
