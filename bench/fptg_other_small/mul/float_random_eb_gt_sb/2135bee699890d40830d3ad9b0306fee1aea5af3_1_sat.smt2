(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1011100 #b100)
                arg1
                (fp #b1 #b0111111 #b100)))
(assert (fp.leq (fp #b1 #b0111111 #b100)
                arg1
                (fp #b0 #b0100110 #b110)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111010 #b010)
                arg2
                (fp #b1 #b1100011 #b110)))
(assert (fp.leq (fp #b1 #b1100011 #b110)
                arg2
                (fp #b0 #b1011101 #b101)))
; arg2 = -120259084288.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0001101 #b001)
                expect
                (fp #b0 #b1100100 #b010)))
(assert (fp.leq (fp #b0 #b1100100 #b010)
                expect
                (fp #b0 #b1110111 #b010)))
; expect = 171798691840.0

(assert (= expect result))

(check-sat)
(exit)
