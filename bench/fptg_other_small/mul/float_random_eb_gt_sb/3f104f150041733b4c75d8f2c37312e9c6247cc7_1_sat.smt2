(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111100 #b1011)
                arg1
                (fp #b1 #b01101011 #b0010)))
(assert (fp.leq (fp #b1 #b01101011 #b0010)
                arg1
                (fp #b0 #b01010100 #b1110)))
; arg1 = -0.00000107288360595703125

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11001000 #b0100)
                arg2
                (fp #b1 #b10111110 #b1111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111)
                arg2
                (fp #b0 #b11110000 #b0001)))
; arg2 = -17870283321406128128.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b10101000 #b0001)
                expect
                (fp #b0 #b10101011 #b0001)))
(assert (fp.leq (fp #b0 #b10101011 #b0001)
                expect
                (fp #b0 #b11010100 #b1110)))
; expect = 18691697672192.0

(assert (= expect result))

(check-sat)
(exit)
