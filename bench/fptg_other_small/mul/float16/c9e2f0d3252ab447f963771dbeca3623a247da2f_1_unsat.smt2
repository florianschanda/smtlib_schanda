; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00101 #b1111010111)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11101 #b1000111110)))
; arg1 = 14.8359375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1000101101)
                arg2
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b0 #b11000 #b1000010000)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1110101001)
                expect
                (fp #b1 #b10010 #b1110110011)))
(assert (fp.leq (fp #b1 #b10010 #b1110110011)
                expect
                (fp #b1 #b01110 #b1110010110)))
; expect = -15.3984375

(assert (not (= expect result)))

(check-sat)
(exit)
