(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101010100)
                arg1
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg1
                (fp #b0 #b00110 #b0011011110)))
; arg1 = -7412.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1110101110)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b0 #b11001 #b0011100000)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10011 #b0010111101)
                expect
                (fp #b0 #b11100 #b0010000100)))
(assert (fp.leq (fp #b0 #b11100 #b0010000100)
                expect
                (fp #b0 #b11101 #b1011001101)))
; expect = 9248.0

(assert (not (= expect result)))

(check-sat)
(exit)
