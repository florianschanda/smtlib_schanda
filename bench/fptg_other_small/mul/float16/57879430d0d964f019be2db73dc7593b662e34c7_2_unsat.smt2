(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b1001011101)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11100 #b1010010010)))
; arg1 = 1872.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b0001101101)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b1 #b00000 #b0011001000)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010011100)
                expect
                (fp #b1 #b11010 #b0010010001)))
(assert (fp.leq (fp #b1 #b11010 #b0010010001)
                expect
                (fp #b1 #b01000 #b0011110110)))
; expect = -2338.0

(assert (not (= expect result)))

(check-sat)
(exit)
