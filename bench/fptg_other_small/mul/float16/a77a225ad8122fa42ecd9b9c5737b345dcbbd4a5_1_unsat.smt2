(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00100 #b0011011001)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11010 #b0110001010)))
; arg1 = 255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101010010)
                arg2
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                arg2
                (fp #b1 #b10000 #b1011000111)))
; arg2 = -646.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                expect
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                expect
                (fp #b1 #b11000 #b0101010010)))
; expect = -65504.0

(assert (not (= expect result)))

(check-sat)
(exit)
