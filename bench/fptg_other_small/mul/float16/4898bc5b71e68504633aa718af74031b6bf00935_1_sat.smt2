(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0100000100)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11110 #b0111101110)))
; arg1 = 13320.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b0001011100)
                arg2
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg2
                (fp #b0 #b10100 #b0000011101)))
; arg2 = -0.00006103515625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1001101111)
                expect
                (fp #b1 #b01110 #b1010000001)))
(assert (fp.leq (fp #b1 #b01110 #b1010000001)
                expect
                (fp #b1 #b01001 #b1010111100)))
; expect = -0.81298828125

(assert (= expect result))

(check-sat)
(exit)
