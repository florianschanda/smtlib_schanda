(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0001101000)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b00100 #b0001100111)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0001000101)
                arg2
                (fp #b0 #b11011 #b0100110010)))
(assert (fp.leq (fp #b0 #b11011 #b0100110010)
                arg2
                (fp #b0 #b11110 #b0111000100)))
; arg2 = 5320.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b0010011101)
                expect
                (fp #b0 #b01001 #b1000101100)))
(assert (fp.leq (fp #b0 #b01001 #b1000101100)
                expect
                (fp #b0 #b10110 #b1001000100)))
; expect = 0.02410888671875

(assert (= expect result))

(check-sat)
(exit)
