(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001011011)
                arg1
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg1
                (fp #b1 #b01110 #b1101100010)))
; arg1 = -7412.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0101010101)
                arg2
                (fp #b0 #b00000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                arg2
                (fp #b0 #b11110 #b0111100101)))
; arg2 = 0.000006973743438720703125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0001101111)
                expect
                (fp #b1 #b01010 #b1010011110)))
(assert (fp.leq (fp #b1 #b01010 #b1010011110)
                expect
                (fp #b0 #b01001 #b1100101101)))
; expect = -0.05169677734375

(assert (= expect result))

(check-sat)
(exit)
