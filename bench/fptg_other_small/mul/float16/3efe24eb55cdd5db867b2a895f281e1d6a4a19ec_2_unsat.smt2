(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1110000110)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11110 #b0010110000)))
; arg1 = 13320.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b0010010100)
                arg2
                (fp #b0 #b00000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                arg2
                (fp #b0 #b01010 #b0110100111)))
; arg2 = 0.000006973743438720703125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1001011100)
                expect
                (fp #b0 #b01011 #b0111110010)))
(assert (fp.leq (fp #b0 #b01011 #b0111110010)
                expect
                (fp #b0 #b10011 #b0110110100)))
; expect = 0.0928955078125

(assert (not (= expect result)))

(check-sat)
(exit)
