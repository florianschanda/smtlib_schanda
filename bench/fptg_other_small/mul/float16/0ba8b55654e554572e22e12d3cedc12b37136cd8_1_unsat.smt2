(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0010001001)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b0 #b11110 #b0101111000)))
; arg1 = -1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1011001011)
                arg2
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg2
                (fp #b1 #b00000 #b1001101001)))
; arg2 = -0.0078125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000001011)
                expect
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                expect
                (fp #b0 #b01111 #b0111001100)))
; expect = 0.0078125

(assert (not (= expect result)))

(check-sat)
(exit)
