(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0011001110)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b11010 #b0110100101)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0011100101)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b1 #b10110 #b1000010101)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1100101101)
                expect
                (fp #b1 #b10011 #b0001000100)))
(assert (fp.leq (fp #b1 #b10011 #b0001000100)
                expect
                (fp #b1 #b00111 #b1111111000)))
; expect = -17.0625

(assert (not (= expect result)))

(check-sat)
(exit)
