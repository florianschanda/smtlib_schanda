(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1011111110)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b00011 #b0110111001)))
; arg1 = -0.000055372714996337890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0101100100)
                arg2
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                arg2
                (fp #b1 #b01000 #b0101100011)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b0111100110)
                expect
                (fp #b0 #b00101 #b1011101100)))
(assert (fp.leq (fp #b0 #b00101 #b1011101100)
                expect
                (fp #b0 #b01101 #b1111100010)))
; expect = 0.001689910888671875

(assert (not (= expect result)))

(check-sat)
(exit)
