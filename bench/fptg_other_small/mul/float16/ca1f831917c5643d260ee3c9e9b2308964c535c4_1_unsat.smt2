(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b1 #b01001 #b1101111010)))
; arg1 = -65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0001110001)
                arg2
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg2
                (fp #b0 #b10000 #b0010111001)))
; arg2 = -0.0078125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101100001)
                expect
                (fp #b0 #b10111 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111 #b1111111111)
                expect
                (fp #b0 #b11011 #b1011000111)))
; expect = 511.75

(assert (not (= expect result)))

(check-sat)
(exit)
