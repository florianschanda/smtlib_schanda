(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b0000111101)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b10101 #b1100000101)))
; arg1 = -0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000010)
                arg2
                (fp #b1 #b00000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000 #b0101011111)
                arg2
                (fp #b0 #b00010 #b0001000000)))
; arg2 = -0.000020921230316162109375

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010 #b0000110011)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b01000 #b1001001010)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
