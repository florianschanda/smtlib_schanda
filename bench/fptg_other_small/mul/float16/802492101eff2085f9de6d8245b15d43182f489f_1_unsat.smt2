(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1010100010)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b11110 #b0001111111)))
; arg1 = 0.10479736328125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0000011011)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b1 #b01111 #b1111011111)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b1010100111)
                expect
                (fp #b1 #b10100 #b0000011001)))
(assert (fp.leq (fp #b1 #b10100 #b0000011001)
                expect
                (fp #b1 #b01100 #b1111110001)))
; expect = -32.78125

(assert (not (= expect result)))

(check-sat)
(exit)
