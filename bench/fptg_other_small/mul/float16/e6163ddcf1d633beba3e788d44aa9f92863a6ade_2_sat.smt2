(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b0011001000)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b00110 #b1001100010)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01011 #b0101110011)
                arg2
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg2
                (fp #b0 #b11010 #b1110000101)))
; arg2 = 0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1010011100)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01000 #b0101001110)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
