(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1000000001)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11011 #b1101001101)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111011110)
                arg2
                (fp #b1 #b11110 #b1111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111001110)
                arg2
                (fp #b1 #b01101 #b1110100111)))
; arg2 = -63936.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100000000)
                expect
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                expect
                (fp #b0 #b11111 #b0000000000)))
; expect = 65504.0

(assert (= expect result))

(check-sat)
(exit)
