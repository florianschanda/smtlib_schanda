(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b0100010101)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00100 #b0100011010)))
; arg1 = -0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1000011010)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b10101 #b0000011001)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b0000111011)
                expect
                (fp #b1 #b00000 #b0101000111)))
(assert (fp.leq (fp #b1 #b00000 #b0101000111)
                expect
                (fp #b0 #b00010 #b1001101000)))
; expect = -0.000019490718841552734375

(assert (not (= expect result)))

(check-sat)
(exit)
