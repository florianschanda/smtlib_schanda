(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1101001111)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b01001 #b1101010000)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1100110001)
                arg2
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg2
                (fp #b1 #b00011 #b0000111001)))
; arg2 = -0.0078125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100011101)
                expect
                (fp #b0 #b00000 #b0000001000)))
(assert (fp.leq (fp #b0 #b00000 #b0000001000)
                expect
                (fp #b0 #b11100 #b1101001001)))
; expect = 0.000000476837158203125

(assert (not (= expect result)))

(check-sat)
(exit)
