(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1011101011)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b10011 #b1010011100)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01011 #b0001010110)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b11011 #b0011010011)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0001111011)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01100 #b1100010010)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
