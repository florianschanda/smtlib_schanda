(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b1000110110)
                arg1
                (fp #b0 #b11010 #b0010000000)))
(assert (fp.leq (fp #b0 #b11010 #b0010000000)
                arg1
                (fp #b0 #b11101 #b1101100100)))
; arg1 = 2304.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0100111011)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b11101 #b0001010101)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1000110110)
                expect
                (fp #b0 #b01100 #b0001111111)))
(assert (fp.leq (fp #b0 #b01100 #b0001111111)
                expect
                (fp #b0 #b10100 #b0110111000)))
; expect = 0.1405029296875

(assert (not (= expect result)))

(check-sat)
(exit)
