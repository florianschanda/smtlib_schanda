                arg2
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg2
                (fp #b0 #b10110 #b0001101010)))
; arg2 = -0.000244140625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01110 #b0100011001)
                expect
                (fp #b0 #b00000 #b0000001011)))
(assert (fp.leq (fp #b0 #b00000 #b0000001011)
                expect
                (fp #b0 #b10111 #b0110110101)))
; expect = 0.000000655651092529296875

(assert (not (= expect result)))

(check-sat)
(exit)
