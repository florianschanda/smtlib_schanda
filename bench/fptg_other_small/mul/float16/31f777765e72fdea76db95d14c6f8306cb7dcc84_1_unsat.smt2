(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1010111100)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b0 #b01101 #b0101111011)))
; arg1 = -933.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00000 #b1100000000)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11011 #b0001111110)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                expect
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                expect
                (fp #b1 #b10101 #b1001010011)))
; expect = -65504.0

(assert (not (= expect result)))

(check-sat)
(exit)
