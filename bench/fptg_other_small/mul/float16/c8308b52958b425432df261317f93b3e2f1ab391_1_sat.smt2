(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0111101001)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b10001 #b1111001110)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100011110)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b11110 #b0010001100)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b0011100101)
                expect
                (fp #b1 #b00000 #b1101111000)))
(assert (fp.leq (fp #b1 #b00000 #b1101111000)
                expect
                (fp #b0 #b00100 #b0111000111)))
; expect = -0.000052928924560546875

(assert (= expect result))

(check-sat)
(exit)
