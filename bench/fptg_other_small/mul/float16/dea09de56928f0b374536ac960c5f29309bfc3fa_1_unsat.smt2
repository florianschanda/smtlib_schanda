(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b1110011101)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11011 #b1000100010)))
; arg1 = 1671.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0110101011)
                arg2
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg2
                (fp #b0 #b10100 #b1010000100)))
; arg2 = 0.00006103515625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b1010011011)
                expect
                (fp #b0 #b01011 #b1010000111)))
(assert (fp.leq (fp #b0 #b01011 #b1010000111)
                expect
                (fp #b0 #b10110 #b0111011110)))
; expect = 0.10198974609375

(assert (not (= expect result)))

(check-sat)
(exit)
