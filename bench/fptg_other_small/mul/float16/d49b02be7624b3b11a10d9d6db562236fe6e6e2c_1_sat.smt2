(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0110000001)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00111 #b1011011100)))
; arg1 = -0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100000110)
                arg2
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                arg2
                (fp #b0 #b10000 #b1010111111)))
; arg2 = -32416.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b0010010000)
                expect
                (fp #b0 #b01101 #b1111101010)))
(assert (fp.leq (fp #b0 #b01101 #b1111101010)
                expect
                (fp #b0 #b11000 #b0001110001)))
; expect = 0.49462890625

(assert (= expect result))

(check-sat)
(exit)
