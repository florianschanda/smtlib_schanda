(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0011101110)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b0 #b01001 #b0101001000)))
; arg1 = -1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b0011101000)
                arg2
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                arg2
                (fp #b0 #b00010 #b1001100011)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110101110)
                expect
                (fp #b0 #b10011 #b1110100010)))
(assert (fp.leq (fp #b0 #b10011 #b1110100010)
                expect
                (fp #b0 #b11100 #b1101001101)))
; expect = 30.53125

(assert (= expect result))

(check-sat)
(exit)
