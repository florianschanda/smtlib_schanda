(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1110111001)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b1 #b10100 #b0111000111)))
; arg1 = -16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0001101101)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b01110 #b0000110101)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10100 #b0011001010)
                expect
                (fp #b0 #b11010 #b1101010000)))
(assert (fp.leq (fp #b0 #b11010 #b1101010000)
                expect
                (fp #b0 #b11101 #b1001100011)))
; expect = 3744.0

(assert (not (= expect result)))

(check-sat)
(exit)
