(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0010110111)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b1 #b00000 #b1111101111)))
; arg1 = -0.0024929046630859375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1100011101)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b0 #b11001 #b0101100000)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00101 #b0000100101)
                expect
                (fp #b0 #b00110 #b1001100000)))
(assert (fp.leq (fp #b0 #b00110 #b1001100000)
                expect
                (fp #b0 #b10001 #b1111111000)))
; expect = 0.00311279296875

(assert (= expect result))

(check-sat)
(exit)
