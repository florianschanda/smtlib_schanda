(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0011000011)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b0 #b10101 #b1010111101)))
; arg1 = -0.0078125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1100111101)
                arg2
                (fp #b1 #b00000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000 #b0101011111)
                arg2
                (fp #b0 #b10011 #b0100011010)))
; arg2 = -0.000020921230316162109375

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b1001000101)
                expect
                (fp #b0 #b00000 #b0000000010)))
(assert (fp.leq (fp #b0 #b00000 #b0000000010)
                expect
                (fp #b0 #b00010 #b1010110101)))
; expect = 0.00000011920928955078125

(assert (not (= expect result)))

(check-sat)
(exit)
