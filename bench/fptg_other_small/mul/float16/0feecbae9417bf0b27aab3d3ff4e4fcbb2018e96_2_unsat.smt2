; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1010110011)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b0 #b10001 #b0001001110)))
; arg1 = -25296.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0000001011)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b10100 #b1111010101)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1000000001)
                expect
                (fp #b1 #b11101 #b1111100001)))
(assert (fp.leq (fp #b1 #b11101 #b1111100001)
                expect
                (fp #b1 #b00010 #b1100111100)))
; expect = -32272.0

(assert (not (= expect result)))

(check-sat)
(exit)
