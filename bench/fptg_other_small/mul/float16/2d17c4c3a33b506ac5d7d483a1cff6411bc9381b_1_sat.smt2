(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0111101111)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10010 #b1011100000)))
; arg1 = 0.10479736328125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1100010100)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11101 #b0011111111)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1010010001)
                expect
                (fp #b0 #b10110 #b1010110101)))
(assert (fp.leq (fp #b0 #b10110 #b1010110101)
                expect
                (fp #b0 #b11010 #b1000001100)))
; expect = 214.625

(assert (= expect result))

(check-sat)
(exit)
