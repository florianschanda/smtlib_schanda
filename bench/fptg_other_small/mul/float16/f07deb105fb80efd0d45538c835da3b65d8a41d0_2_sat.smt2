(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1011100001)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b01100 #b1010000101)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010010101)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b1 #b01011 #b0001010000)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
