(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1101100000)
                arg1
                (fp #b0 #b11010 #b0010000000)))
(assert (fp.leq (fp #b0 #b11010 #b0010000000)
                arg1
                (fp #b0 #b11100 #b1000000001)))
; arg1 = 2304.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010100011)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b0 #b10111 #b0110101010)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
