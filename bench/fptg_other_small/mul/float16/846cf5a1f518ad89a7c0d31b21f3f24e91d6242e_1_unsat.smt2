(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100001001)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b1 #b00011 #b1000001000)))
; arg1 = -1809.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0000001100)
                arg2
                (fp #b0 #b01011 #b0000100001)))
(assert (fp.leq (fp #b0 #b01011 #b0000100001)
                arg2
                (fp #b0 #b01011 #b1001001011)))
; arg2 = 0.06451416015625

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0011100000)
                expect
                (fp #b1 #b10101 #b1101001011)))
(assert (fp.leq (fp #b1 #b10101 #b1101001011)
                expect
                (fp #b0 #b11001 #b1101001000)))
; expect = -116.6875

(assert (not (= expect result)))

(check-sat)
(exit)
