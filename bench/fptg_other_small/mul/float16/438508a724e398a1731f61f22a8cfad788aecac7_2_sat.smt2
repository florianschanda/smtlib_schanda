(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0101001011)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11100 #b0000011001)))
; arg1 = 1872.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1011001100)
                arg2
                (fp #b0 #b11011 #b0100110010)))
(assert (fp.leq (fp #b0 #b11011 #b0100110010)
                arg2
                (fp #b0 #b11101 #b0100111010)))
; arg2 = 5320.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
