(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1011000001)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b1 #b01000 #b0011011100)))
; arg1 = -1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1010000010)
                arg2
                (fp #b0 #b01111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111 #b0010110101)
                arg2
                (fp #b0 #b10010 #b1100011011)))
; arg2 = 1.1767578125

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0111010001)
                expect
                (fp #b1 #b01111 #b0010110101)))
(assert (fp.leq (fp #b1 #b01111 #b0010110101)
                expect
                (fp #b0 #b01110 #b1110011001)))
; expect = -1.1767578125

(assert (= expect result))

(check-sat)
(exit)
