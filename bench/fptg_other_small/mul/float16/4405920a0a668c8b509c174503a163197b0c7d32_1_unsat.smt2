(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00110 #b1111111110)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11101 #b1101000011)))
; arg1 = 13320.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1010101000)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b1 #b10110 #b0110110011)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                expect
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                expect
                (fp #b1 #b10000 #b1101000100)))
; expect = -65504.0

(assert (not (= expect result)))

(check-sat)
(exit)
