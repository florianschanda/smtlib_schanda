(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00111 #b1001011101)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101010000)
                arg2
                (fp #b1 #b00000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000 #b0101011111)
                arg2
                (fp #b0 #b11001 #b1111010011)))
; arg2 = -0.000020921230316162109375

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1110010010)
                expect
                (fp #b1 #b01111 #b0101111100)))
(assert (fp.leq (fp #b1 #b01111 #b0101111100)
                expect
                (fp #b1 #b00011 #b1010100001)))
; expect = -1.37109375

(assert (not (= expect result)))

(check-sat)
(exit)
