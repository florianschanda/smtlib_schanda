(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b0101001010)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b01101 #b1110000010)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0110110101)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b1000111110)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0101111110)
                expect
                (fp #b0 #b01100 #b1011000010)))
(assert (fp.leq (fp #b0 #b01100 #b1011000010)
                expect
                (fp #b0 #b01101 #b1110101000)))
; expect = 0.211181640625

(assert (= expect result))

(check-sat)
(exit)
