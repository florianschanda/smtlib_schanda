(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b0000101001)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b10110 #b1100000100)))
; arg1 = 14.8359375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10011 #b1000100010)
                arg2
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                arg2
                (fp #b0 #b11000 #b1101011110)))
; arg2 = 439.0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10001 #b1010011011)
                expect
                (fp #b0 #b11011 #b1001011101)))
(assert (fp.leq (fp #b0 #b11011 #b1001011101)
                expect
                (fp #b0 #b11100 #b0110101100)))
; expect = 6516.0

(assert (not (= expect result)))

(check-sat)
(exit)
