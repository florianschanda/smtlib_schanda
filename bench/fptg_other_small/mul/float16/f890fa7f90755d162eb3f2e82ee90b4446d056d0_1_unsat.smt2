(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -ZERO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b0110110100)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11010 #b1101100000)))
; arg1 = 1872.0

(declare-const arg2 Float16)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01010 #b1000010010)
                arg2
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg2
                (fp #b0 #b10110 #b0011000101)))
; arg2 = -0

(declare-const result Float16)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01010 #b1011010111)
                expect
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                expect
                (fp #b0 #b10000 #b0111110001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
