; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000001 #b1000111)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b1 #b01100101 #b1111010)))
; arg1 = -1.3046875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011111 #b0000101)
                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b10101011 #b1100010)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0111101)
                expect
                (fp #b1 #b10010010 #b0011000)))
(assert (fp.leq (fp #b1 #b10010010 #b0011000)
                expect
                (fp #b1 #b01000101 #b1011000)))
; expect = -622592.0

(assert (not (= expect result)))

(check-sat)
(exit)
