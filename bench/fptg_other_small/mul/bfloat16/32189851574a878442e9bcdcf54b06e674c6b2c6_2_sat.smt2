                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b1 #b01101010 #b0101010)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011001 #b0110111)
                expect
                (fp #b0 #b00000000 #b0100100)))
(assert (fp.leq (fp #b0 #b00000000 #b0100100)
                expect
                (fp #b0 #b01100101 #b0011001)))
; expect = 0.00000000000000000000000000000000000000330607786168768361616207151093756596886499687842149615424336417390804854221642017364501953125

(assert (= expect result))

