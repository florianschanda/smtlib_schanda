                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b11000011 #b1111010)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b1111011)
                expect
                (fp #b1 #b11110100 #b1100111)))
(assert (fp.leq (fp #b1 #b11110100 #b1100111)
                expect
                (fp #b1 #b00100000 #b1010001)))
; expect = -299855143580386295547636163012460544.0

(assert (= expect result))

(check-sat)
(exit)
