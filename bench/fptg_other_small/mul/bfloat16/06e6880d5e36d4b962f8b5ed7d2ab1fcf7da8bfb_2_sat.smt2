                arg2
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b10100001 #b1000110)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110010 #b1110010)
                expect
                (fp #b1 #b11101100 #b1110101)))
(assert (fp.leq (fp #b1 #b11101100 #b1110101)
                expect
                (fp #b1 #b01010000 #b1100100)))
; expect = -1242297588223664813466769141268480.0

(assert (= expect result))

(check-sat)
(exit)
