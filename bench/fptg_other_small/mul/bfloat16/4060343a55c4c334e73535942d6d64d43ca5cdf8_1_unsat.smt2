                arg2
                (fp #b0 #b11011001 #b1100010)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b0111010)
                expect
                (fp #b0 #b11011100 #b1011100)))
(assert (fp.leq (fp #b0 #b11011100 #b1011100)
                expect
                (fp #b0 #b11110111 #b1010011)))
; expect = 17021675540173978779862958080.0

(assert (not (= expect result)))

(check-sat)
(exit)
