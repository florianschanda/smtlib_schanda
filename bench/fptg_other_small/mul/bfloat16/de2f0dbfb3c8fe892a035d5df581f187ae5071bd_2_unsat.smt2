                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b1 #b00100001 #b0101000)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10011011 #b1111001)
                expect
                (fp #b0 #b10101111 #b0011101)))
(assert (fp.leq (fp #b0 #b10101111 #b0011101)
                expect
                (fp #b0 #b11110000 #b0000110)))
; expect = 345246651121664.0

(assert (not (= expect result)))

(check-sat)
(exit)
