(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +ZERO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01101001 #b0011000)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b01110100 #b1100011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10101000 #b0010001)
                arg2
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg2
                (fp #b0 #b11010101 #b1001110)))
; arg2 = 18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11100101 #b1000001)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b01010000 #b1010101)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
