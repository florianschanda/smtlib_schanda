; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101111 #b0111110)
                arg1
                (fp #b1 #b01101101 #b1000001)))
(assert (fp.leq (fp #b1 #b01101101 #b1000001)
                arg1
                (fp #b0 #b01100111 #b1100011)))
; arg1 = -0.0000057518482208251953125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101110 #b1101111)
                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11101110 #b0011001)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b0011000)
                expect
                (fp #b1 #b11011001 #b1111100)))
(assert (fp.leq (fp #b1 #b11011001 #b1111100)
                expect
                (fp #b0 #b11111000 #b0011011)))
; expect = -2437194452343092416207650816.0

(assert (= expect result))

(check-sat)
(exit)
