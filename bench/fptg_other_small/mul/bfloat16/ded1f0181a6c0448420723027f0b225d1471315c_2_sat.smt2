(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001101 #b1011001)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b10100110 #b0111100)))
; arg1 = 86.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b0000001)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b10001100 #b0100101)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b0001011)
                expect
                (fp #b1 #b10000110 #b0010010)))
(assert (fp.leq (fp #b1 #b10000110 #b0010010)
                expect
                (fp #b0 #b10000000 #b1011111)))
; expect = -146.0

(assert (= expect result))

(check-sat)
(exit)
