; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000001 #b1001011)
                arg1
                (fp #b0 #b11001001 #b0100010)))
(assert (fp.leq (fp #b0 #b11001001 #b0100010)
                arg1
                (fp #b0 #b11011011 #b0110000)))
; arg1 = 23906980319527578894336.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110000 #b0111100)
                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b1 #b10100100 #b0000001)))
; arg2 = -522272047294030513416641720614912.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
