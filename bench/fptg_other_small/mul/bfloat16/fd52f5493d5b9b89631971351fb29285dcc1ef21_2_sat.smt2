                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b11101101 #b1101000)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010101 #b0101101)
                expect
                (fp #b1 #b00000111 #b1101000)))
(assert (fp.leq (fp #b1 #b00000111 #b1101000)
                expect
                (fp #b0 #b11001100 #b0011001)))
; expect = -0.0000000000000000000000000000000000013635734469538535092437343831778049862696520458556215249501519792829640209674835205078125

(assert (= expect result))

(check-sat)
(exit)
