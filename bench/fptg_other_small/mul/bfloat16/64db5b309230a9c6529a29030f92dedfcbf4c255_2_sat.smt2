                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b0 #b11010110 #b0001010)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11001010 #b0001110)
                expect
                (fp #b0 #b11101101 #b0000110)))
(assert (fp.leq (fp #b0 #b11101101 #b0000110)
                expect
                (fp #b0 #b11111110 #b1101101)))
; expect = 1358921443444661918404465836163072.0

(assert (= expect result))

(check-sat)
(exit)
