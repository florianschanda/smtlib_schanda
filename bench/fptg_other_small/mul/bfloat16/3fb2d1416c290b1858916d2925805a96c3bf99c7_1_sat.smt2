(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b10100111 #b1000001)))
; arg2 = -0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b0111110)
                expect
                (fp #b0 #b01101100 #b1001000)))
(assert (fp.leq (fp #b0 #b01101100 #b1001000)
                expect
                (fp #b0 #b11010111 #b0111110)))
; expect = 0.00000298023223876953125

(assert (= expect result))

(check-sat)
