(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010010 #b0100010)
                expect
                (fp #b0 #b00000000 #b0000010)))
(assert (fp.leq (fp #b0 #b00000000 #b0000010)
                expect
