                arg2
                (fp #b0 #b00111010 #b0001101)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001101 #b0100111)
                expect
                (fp #b1 #b11000110 #b1010010)))
(assert (fp.leq (fp #b1 #b11000110 #b1010010)
                expect
                (fp #b1 #b01111110 #b1010010)))
; expect = -3873816255479005839360.0

(assert (= expect result))

