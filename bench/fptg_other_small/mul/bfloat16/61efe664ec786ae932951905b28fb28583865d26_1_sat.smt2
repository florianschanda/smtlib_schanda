;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000111 #b0001101)
                arg1
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                arg1
                (fp #b1 #b10010111 #b0101110)))
; arg1 = -312261302288384.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010011 #b1111100)
                expect
                (fp #b0 #b11011111 #b0011101)))
(assert (fp.leq (fp #b0 #b11011111 #b0011101)
                expect
                (fp #b0 #b11111000 #b1100011)))
; expect = 97178293083902351579581251584.0

(assert (= expect result))

(check-sat)
(exit)
