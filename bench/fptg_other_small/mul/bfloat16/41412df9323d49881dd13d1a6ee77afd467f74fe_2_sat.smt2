; arg1 = 86.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b0110010)
                arg2
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg2
                (fp #b0 #b10100111 #b0001111)))
; arg2 = -0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100001 #b1011110)
                expect
                (fp #b1 #b00000111 #b0101011)))
(assert (fp.leq (fp #b1 #b00000111 #b0101011)
                expect
                (fp #b0 #b01100011 #b1101010)))
; expect = -0.0000000000000000000000000000000000010050476699530558193132697393250200545349590510401348308899827088680467568337917327880859375

(assert (= expect result))

(check-sat)
(exit)
