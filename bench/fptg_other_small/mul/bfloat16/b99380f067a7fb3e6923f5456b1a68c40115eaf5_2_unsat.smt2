(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101101 #b0110100)
                expect
                (fp #b1 #b01010101 #b0011011)))
(assert (fp.leq (fp #b1 #b01010101 #b0011011)
                expect
                (fp #b0 #b10101101 #b0101101)))
; expect = -0.0000000000002753353101070388220250606536865234375

(assert (not (= expect result)))

(check-sat)
