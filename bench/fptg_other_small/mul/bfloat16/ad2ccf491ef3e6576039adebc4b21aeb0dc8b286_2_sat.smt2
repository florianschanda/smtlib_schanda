                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b11101110 #b0010010)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010100 #b0110110)
                expect
                (fp #b1 #b00000110 #b1110110)))
(assert (fp.leq (fp #b1 #b00000110 #b1110110)
                expect
                (fp #b0 #b11101000 #b1101000)))
; expect = -0.0000000000000000000000000000000000007229290257557068174007729703916810918584793174148338257278822993612266145646572113037109375

