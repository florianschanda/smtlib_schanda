                arg2
                (fp #b1 #b00011111 #b1001011)))
(assert (fp.leq (fp #b1 #b00011111 #b1001011)
                arg2
                (fp #b0 #b11111010 #b1011000)))
; arg2 = -0.0000000000000000000000000000200173454699831745623226123440507005779576132908914587460458278656005859375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b1001110)
                expect
                (fp #b0 #b00100000 #b0001010)))
(assert (fp.leq (fp #b0 #b00100000 #b0001010)
                expect
                (fp #b0 #b00110010 #b0111110)))
; expect = 0.00000000000000000000000000002721570123012490728670463550225612492372562201126129366457462310791015625

(assert (= expect result))

(check-sat)
