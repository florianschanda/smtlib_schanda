; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b0110001)
                arg1
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                arg1
                (fp #b0 #b01011010 #b1001111)))
; arg1 = -312261302288384.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001000 #b1100001)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b10000101 #b0101001)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00001110 #b1011011)
                expect
                (fp #b0 #b10110110 #b1101000)))
(assert (fp.leq (fp #b0 #b10110110 #b1101000)
                expect
                (fp #b0 #b11000110 #b1110111)))
; expect = 65302194596872192.0

(assert (= expect result))

(check-sat)
(exit)
