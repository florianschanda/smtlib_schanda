(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101000 #b1110001)
                arg1
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                arg1
                (fp #b0 #b11100000 #b0110110)))
; arg1 = 3489792.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100100 #b1100000)
                arg2
                (fp #b1 #b00011111 #b1001011)))
(assert (fp.leq (fp #b1 #b00011111 #b1001011)
                arg2
                (fp #b0 #b10000000 #b1100100)))
; arg2 = -0.0000000000000000000000000000200173454699831745623226123440507005779576132908914587460458278656005859375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001001 #b1011100)
                expect
                (fp #b1 #b00110101 #b0101000)))
(assert (fp.leq (fp #b1 #b00110101 #b0101000)
                expect
                (fp #b0 #b11111100 #b1101010)))
; expect = -0.000000000000000000000069483171454454324689198330133876879699528217315673828125

(assert (= expect result))

(check-sat)
(exit)
