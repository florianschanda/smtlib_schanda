                arg2
                (fp #b0 #b10001010 #b1111110)))
; arg2 = -0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101011 #b1110001)
                expect
                (fp #b0 #b00001000 #b0101111)))
(assert (fp.leq (fp #b0 #b00001000 #b0101111)
                expect
                (fp #b0 #b01001010 #b0001011)))
; expect = 0.000000000000000000000000000000000002057115113939003138945288940138929936182664724351153162640315485987230204045772552490234375

(assert (= expect result))

