(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110010 #b0110110)
                arg2
                (fp #b1 #b00000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000 #b1101110)
                arg2
                (fp #b0 #b10111010 #b1111101)))
; arg2 = -0.000000000000000000000000000000000000010101904577379033271606329616753673793754157128510127137965834975830148323439061641693115234375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011100 #b1011101)
                expect
                (fp #b0 #b00000001 #b0001111)))
(assert (fp.leq (fp #b0 #b00000001 #b0001111)
                expect
                (fp #b0 #b10010001 #b0010010)))
; expect = 0.0000000000000000000000000000000000000131324759505927432530882285017797759318804042670631652793555854685791928204707801342010498046875

(assert (= expect result))

