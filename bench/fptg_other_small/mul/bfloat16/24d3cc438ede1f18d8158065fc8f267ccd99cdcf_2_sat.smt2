(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100111 #b1111001)
                expect
                (fp #b0 #b11010010 #b1111001)))
(assert (fp.leq (fp #b0 #b11010010 #b1111001)
                expect
                (fp #b0 #b11111011 #b0000100)))
; expect = 18813908067752666531364864.0

