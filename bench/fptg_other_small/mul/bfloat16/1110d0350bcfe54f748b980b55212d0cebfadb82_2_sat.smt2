                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b10011001 #b0101101)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101100 #b1001110)
                expect
                (fp #b1 #b00000111 #b1110110)))
(assert (fp.leq (fp #b1 #b00000111 #b1110110)
                expect
                (fp #b0 #b10000110 #b0000000)))
; expect = -0.000000000000000000000000000000000001445858051511413634801545940783362183716958634829667651455764598722453229129314422607421875

(assert (= expect result))

(check-sat)
