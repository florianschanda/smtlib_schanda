(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b0 #b00101011 #b1000010)))
; arg1 = -134.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100011 #b1111010)
                arg2
                (fp #b1 #b00000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000 #b1101110)
                arg2
                (fp #b0 #b11010001 #b0000111)))
; arg2 = -0.000000000000000000000000000000000000010101904577379033271606329616753673793754157128510127137965834975830148323439061641693115234375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b1110000)
                expect
                (fp #b0 #b00000111 #b1100111)))
(assert (fp.leq (fp #b0 #b00000111 #b1100111)
                expect
                (fp #b0 #b11100001 #b0010010)))
; expect = 0.0000000000000000000000000000000000013576959751997420717038907004916937578805587180717610873426082207515719346702098846435546875

(assert (= expect result))

(check-sat)
(exit)
