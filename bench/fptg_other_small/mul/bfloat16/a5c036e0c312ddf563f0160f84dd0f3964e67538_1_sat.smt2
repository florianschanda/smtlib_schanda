(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001101 #b0100110)
                arg1
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg1
                (fp #b0 #b01100001 #b1010110)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010110 #b1011100)
                arg2
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b10111100 #b1001101)))
; arg2 = -0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11111011 #b1101111)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b10010101 #b1010000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
