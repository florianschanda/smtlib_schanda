(assert (fp.leq (fp #b0 #b10110000 #b1010100)
                arg2
                (fp #b0 #b11100000 #b0000100)))
; arg2 = 932385860354048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10100000 #b1011111)
                expect
                (fp #b0 #b11000110 #b0110001)))
(assert (fp.leq (fp #b0 #b11000110 #b0110001)
                expect
                (fp #b0 #b11010111 #b0110100)))
; expect = 3265073701046590636032.0

(assert (= expect result))

