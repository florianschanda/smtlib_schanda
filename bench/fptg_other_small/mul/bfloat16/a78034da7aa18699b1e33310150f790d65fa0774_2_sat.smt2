;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0101010)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b10111110 #b1011011)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b0101001)
                arg2
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b00110100 #b0110011)))
; arg2 = -0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101011 #b1111011)
                expect
                (fp #b1 #b01000010 #b0101001)))
(assert (fp.leq (fp #b1 #b01000010 #b0101001)
                expect
                (fp #b0 #b01111111 #b0001100)))
; expect = -0.00000000000000000057259427234390702921018601045943796634674072265625

(assert (= expect result))

(check-sat)
(exit)
