; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011000 #b0001001)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b11101001 #b1001111)))
; arg1 = 86.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111011 #b1110101)
                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b10110110 #b0011100)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101110 #b1110000)
                expect
                (fp #b0 #b10000110 #b0100011)))
(assert (fp.leq (fp #b0 #b10000110 #b0100011)
                expect
                (fp #b0 #b10100110 #b1001100)))
; expect = 163.0

(assert (not (= expect result)))

(check-sat)
(exit)
