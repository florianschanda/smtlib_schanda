                (fp #b0 #b00000100 #b1100000)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b1100001)
                expect
                (fp #b0 #b10001100 #b1010000)))
(assert (fp.leq (fp #b0 #b10001100 #b1010000)
                expect
                (fp #b0 #b11100101 #b1111000)))
; expect = 13312.0

(assert (not (= expect result)))

