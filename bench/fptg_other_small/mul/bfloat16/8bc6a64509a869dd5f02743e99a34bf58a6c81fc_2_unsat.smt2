                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b00000001 #b1111110)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000011 #b1001011)
                expect
                (fp #b0 #b10001100 #b1101011)))
(assert (fp.leq (fp #b0 #b10001100 #b1101011)
                expect
                (fp #b0 #b11011011 #b0000001)))
; expect = 15040.0

(assert (not (= expect result)))

(check-sat)
(exit)
