                expect
                (fp #b1 #b01100000 #b0101100)))
(assert (fp.leq (fp #b1 #b01100000 #b0101100)
                expect
                (fp #b0 #b10011010 #b1011000)))
; expect = -0.000000000625732354819774627685546875

