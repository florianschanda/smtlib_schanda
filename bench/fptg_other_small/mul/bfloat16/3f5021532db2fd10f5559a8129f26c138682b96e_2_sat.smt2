                arg2
                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                arg2
                (fp #b0 #b11111110 #b0111111)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b1100011)
                expect
                (fp #b0 #b11010101 #b0010011)))
(assert (fp.leq (fp #b0 #b11010101 #b0010011)
                expect
                (fp #b0 #b11100001 #b0001011)))
; expect = 88856047741675244340903936.0

(assert (= expect result))

(check-sat)
(exit)
