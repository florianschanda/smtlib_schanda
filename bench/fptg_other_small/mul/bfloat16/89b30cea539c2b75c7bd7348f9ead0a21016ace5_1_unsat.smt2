; Format: BFLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000011 #b1010010)
                arg1
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg1
                (fp #b0 #b11111100 #b1101111)))
; arg1 = 18374686479671623680.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
