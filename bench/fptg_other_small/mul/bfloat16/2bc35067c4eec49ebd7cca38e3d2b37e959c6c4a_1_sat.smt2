(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110101 #b0010111)
                arg1
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                arg1
                (fp #b0 #b11001011 #b0011010)))
; arg1 = 3489792.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100001 #b0100100)
                expect
                (fp #b0 #b10101010 #b0110001)))
(assert (fp.leq (fp #b0 #b10101010 #b0110001)
                expect
                (fp #b0 #b11100011 #b0011001)))
; expect = 12163347382272.0

(assert (= expect result))

(check-sat)
(exit)
