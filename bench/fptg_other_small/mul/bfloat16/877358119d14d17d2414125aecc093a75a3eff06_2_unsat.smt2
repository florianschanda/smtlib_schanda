                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b11110011 #b0001101)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101100 #b0110100)
                expect
                (fp #b1 #b00001000 #b0000000)))
(assert (fp.leq (fp #b1 #b00001000 #b0000000)
                expect
