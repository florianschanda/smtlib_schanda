(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -ZERO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01011100 #b1000000)
                arg1
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg1
                (fp #b0 #b00011100 #b0000111)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100011 #b1001101)
                arg2
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg2
                (fp #b0 #b01010000 #b0000101)))
; arg2 = -0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010000 #b1010011)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b11100010 #b1110000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
