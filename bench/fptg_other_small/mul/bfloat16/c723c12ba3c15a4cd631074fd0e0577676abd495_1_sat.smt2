                (fp #b0 #b10000011 #b1101110)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b0000111)
                expect
                (fp #b1 #b10110000 #b0000111)))
(assert (fp.leq (fp #b1 #b10110000 #b0000111)
                expect
                (fp #b0 #b01111101 #b1111100)))
; expect = -593736278999040.0

