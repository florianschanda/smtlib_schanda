                arg2
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg2
                (fp #b0 #b11001000 #b0000100)))
; arg2 = 0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100100 #b0100101)
                expect
                (fp #b1 #b00000010 #b0000000)))
(assert (fp.leq (fp #b1 #b00000010 #b0000000)
                expect
                (fp #b0 #b01100101 #b0100101)))
; expect = -0.00000000000000000000000000000000000002350988701644575015937473074444491355637331113544175043017503412556834518909454345703125

(assert (not (= expect result)))

(check-sat)
(exit)
