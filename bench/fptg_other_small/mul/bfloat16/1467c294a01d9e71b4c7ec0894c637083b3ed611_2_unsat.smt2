                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b11000101 #b0001010)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010010 #b0001101)
                expect
                (fp #b1 #b10001101 #b0001000)))
(assert (fp.leq (fp #b1 #b10001101 #b0001000)
                expect
                (fp #b1 #b01001001 #b0000101)))
; expect = -17408.0

(assert (not (= expect result)))

(check-sat)
(exit)
