(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011000 #b1110010)
                arg1
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                arg1
                (fp #b0 #b10101110 #b1001010)))
; arg1 = 3489792.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100000 #b0100011)
                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b11100100 #b1000001)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011110 #b1001011)
                expect
                (fp #b0 #b10100111 #b1000010)))
(assert (fp.leq (fp #b0 #b10100111 #b1000010)
                expect
                (fp #b0 #b10101111 #b1110010)))
; expect = 1666447310848.0

(assert (= expect result))

(check-sat)
(exit)
