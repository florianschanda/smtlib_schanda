(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001100 #b1000100)
                expect
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                expect
                (fp #b0 #b10110000 #b0011100)))
; expect = 35734127902720.0

(assert (= expect result))

(check-sat)
