                arg2
                (fp #b0 #b00000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000)
                arg2
                (fp #b0 #b11111101 #b0111101)))
; arg2 = 0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010110 #b1101111)
                expect
                (fp #b1 #b00001000 #b0000101)))
(assert (fp.leq (fp #b1 #b00001000 #b0000101)
                expect
                (fp #b0 #b11000000 #b0110010)))
; expect = -0.000000000000000000000000000000000001563407486593642385598419594505586751498825190506876403606639769350294955074787139892578125

(assert (not (= expect result)))

