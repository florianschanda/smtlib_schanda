; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111000 #b0100001)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b11011010 #b0000110)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00011111 #b0010101)
                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11111000 #b1111000)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111010 #b1110101)
                expect
                (fp #b0 #b11110001 #b0011100)))
(assert (fp.leq (fp #b0 #b11110001 #b0011100)
                expect
                (fp #b0 #b11111110 #b1100111)))
; expect = 25312447185357284689086169604947968.0

(assert (not (= expect result)))

(check-sat)
(exit)
