                arg2
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg2
                (fp #b0 #b00110001 #b0101110)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01001001 #b1111111)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b10010101 #b1000100)))
; expect = -0

(assert (not (= expect result)))

