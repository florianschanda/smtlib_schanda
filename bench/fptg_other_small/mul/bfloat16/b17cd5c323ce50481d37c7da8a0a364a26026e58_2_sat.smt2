(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b1001000)
                expect
                (fp #b0 #b11011001 #b0000101)))
(assert (fp.leq (fp #b0 #b11011001 #b0000101)
                expect
                (fp #b0 #b11100011 #b1011001)))
; expect = 1286297072069965441887371264.0

(assert (= expect result))

(check-sat)
(exit)
