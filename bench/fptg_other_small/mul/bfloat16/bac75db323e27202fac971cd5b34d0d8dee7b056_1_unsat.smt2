(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111110 #b0010101)
                arg1
                (fp #b1 #b01000000 #b0000000)))
