                arg2
                (fp #b0 #b11011010 #b1011101)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                expect
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                expect
                (fp #b1 #b01101100 #b1011110)))
; expect = -338953138925153547590470800371487866880.0

(assert (not (= expect result)))

