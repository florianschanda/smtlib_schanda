                arg2
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b0 #b01111010 #b1101011)))
; arg2 = -10627982632313475302148359673872384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11001100 #b1100000)
                expect
                (fp #b0 #b11110000 #b0110100)))
(assert (fp.leq (fp #b0 #b11110000 #b0110100)
                expect
                (fp #b0 #b11111101 #b0000000)))
; expect = 14603334914629202705242020925931520.0

(assert (= expect result))

(check-sat)
(exit)
