                (fp #b0 #b10010100 #b0100101)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111101 #b0011111)
                expect
                (fp #b0 #b11001001 #b0100100)))
(assert (fp.leq (fp #b0 #b11001001 #b0100100)
                expect
                (fp #b0 #b11100110 #b0001110)))
; expect = 24202128224706931720192.0

