(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100110 #b0011111)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b0 #b01001110 #b0001110)))
; arg1 = -1.3046875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110001 #b1000011)
                arg2
                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                arg2
                (fp #b0 #b11100101 #b0000001)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100011 #b1111100)
                expect
                (fp #b1 #b11010101 #b0001111)))
(assert (fp.leq (fp #b1 #b11010101 #b0001111)
                expect
                (fp #b1 #b01011100 #b0010111)))
; expect = -86438196102445985991491584.0

(assert (= expect result))

(check-sat)
(exit)
