                arg2
                (fp #b0 #b01110000 #b0110110)))
; arg2 = -0.000000000000000000000000000000000000010101904577379033271606329616753673793754157128510127137965834975830148323439061641693115234375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101100 #b1101101)
                expect
                (fp #b1 #b00000111 #b0010100)))
(assert (fp.leq (fp #b1 #b00000111 #b0010100)
                expect
                (fp #b0 #b01110100 #b1110001)))
; expect = -0.00000000000000000000000000000000000086986581960849275589686503754446180158581251201134476591647626264602877199649810791015625

(assert (not (= expect result)))

