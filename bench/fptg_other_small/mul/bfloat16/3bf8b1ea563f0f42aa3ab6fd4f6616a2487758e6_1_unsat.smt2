                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b10000111 #b0111110)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1111101)
                expect
                (fp #b1 #b01111111 #b1110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1110100)
                expect
                (fp #b0 #b00101100 #b0100100)))
; expect = -1.90625

(assert (not (= expect result)))

(check-sat)
(exit)
