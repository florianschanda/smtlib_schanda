; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b0101111)
                arg1
                (fp #b1 #b00000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000 #b1111010)
                arg1
                (fp #b0 #b01101111 #b1111000)))
; arg1 = -0.000000000000000000000000000000000000011203930531274927810327020120399529116709156087983959189380289700466164504177868366241455078125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b0011000)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b11101001 #b0010100)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010101 #b1101001)
                expect
                (fp #b0 #b00001000 #b1001000)))
(assert (fp.leq (fp #b0 #b00001000 #b1001000)
                expect
                (fp #b0 #b00111010 #b0100011)))
; expect = 0.000000000000000000000000000000000002350988701644575015937473074444491355637331113544175043017503412556834518909454345703125

(assert (= expect result))

(check-sat)
(exit)
