(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010101 #b0011110)
                arg1
                (fp #b0 #b11111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000)
                arg1
                (fp #b0 #b11111101 #b1110000)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b0101110)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b0 #b11100100 #b1010101)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                expect
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                expect
                (fp #b0 #b10010100 #b1000111)))
; expect = -338953138925153547590470800371487866880.0

(assert (= expect result))

(check-sat)
(exit)
