(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b1110110)
                arg1
                (fp #b0 #b00000000 #b1100101)))
(assert (fp.leq (fp #b0 #b00000000 #b1100101)
                arg1
                (fp #b0 #b01110010 #b0111010)))
; arg1 = 0.0000000000000000000000000000000000000092753851119571123675658117390192823015379079089047530994049939323531361878849565982818603515625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00001111 #b1100110)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b00001010 #b0010111)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
