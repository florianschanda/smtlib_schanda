; arg2 = 0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001101 #b0011100)
                expect
                (fp #b0 #b00001000 #b1000000)))
(assert (fp.leq (fp #b0 #b00001000 #b1000000)
                expect
                (fp #b0 #b00010110 #b0100000)))
; expect = 0.000000000000000000000000000000000002256949153578792015299974151466711701411837869002408041296803276054561138153076171875

(assert (= expect result))

(check-sat)
