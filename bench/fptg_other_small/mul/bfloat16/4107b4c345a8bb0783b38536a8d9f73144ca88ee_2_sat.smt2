                arg2
                (fp #b1 #b01001110 #b1100110)))
(assert (fp.leq (fp #b1 #b01001110 #b1100110)
                arg2
                (fp #b0 #b10001111 #b1100000)))
; arg2 = -0.0000000000000031918911957973250537179410457611083984375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011110 #b1110100)
                expect
                (fp #b0 #b01010101 #b1110001)))
(assert (fp.leq (fp #b0 #b01010101 #b1110001)
                expect
                (fp #b0 #b10100010 #b0001000)))
; expect = 0.0000000000004281019982954603619873523712158203125

(assert (= expect result))

(check-sat)
(exit)
