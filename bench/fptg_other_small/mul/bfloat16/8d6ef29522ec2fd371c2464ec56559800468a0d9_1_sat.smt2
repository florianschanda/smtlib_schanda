                arg2
                (fp #b0 #b10101100 #b0001100)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111000 #b1001110)
                expect
                (fp #b1 #b10110110 #b0001111)))
(assert (fp.leq (fp #b1 #b10110110 #b0001111)
                expect
                (fp #b1 #b00001001 #b0010101)))
; expect = -40250921669623808.0

(assert (= expect result))

