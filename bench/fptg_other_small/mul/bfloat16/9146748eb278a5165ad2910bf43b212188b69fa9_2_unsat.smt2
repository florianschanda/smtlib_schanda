(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b1101100)
                expect
                (fp #b1 #b11001110 #b0011111)))
(assert (fp.leq (fp #b1 #b11001110 #b0011111)
                expect
                (fp #b0 #b10000110 #b0101111)))
; expect = -750856270776273588977664.0

(assert (not (= expect result)))

