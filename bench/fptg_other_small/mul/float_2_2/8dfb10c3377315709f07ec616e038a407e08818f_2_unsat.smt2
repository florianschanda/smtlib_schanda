(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg2
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                arg2
                (fp #b0 #b10 #b1)))
; arg2 = 0.5

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b0 #b01 #b0)))
(assert (fp.leq (fp #b0 #b01 #b0)
                expect
                (fp #b0 #b10 #b0)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
