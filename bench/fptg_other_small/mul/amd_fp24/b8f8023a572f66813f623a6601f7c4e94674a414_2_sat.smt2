                arg2
                (fp #b0 #b0000000 #b0010100100110000)))
(assert (fp.leq (fp #b0 #b0000000 #b0010100100110000)
                arg2
                (fp #b0 #b0011011 #b1010100000111000)))
; arg2 = 0.00000000000000000003488716951503649521537653299674275331199169158935546875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000000 #b0101001001110010)
                expect
                (fp #b0 #b0111110 #b0100100110000000)))
(assert (fp.leq (fp #b0 #b0111110 #b0100100110000000)
                expect
                (fp #b0 #b1101110 #b1101010101011101)))
; expect = 0.6435546875

(assert (= expect result))

(check-sat)
(exit)
