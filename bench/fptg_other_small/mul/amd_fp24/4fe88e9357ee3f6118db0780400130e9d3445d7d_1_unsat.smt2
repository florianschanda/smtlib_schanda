(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110011 #b1010100001001111)
                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1101000 #b0110110000101100)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0010001111000000)
                expect
                (fp #b1 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b1 #b1000000 #b0101110000100110)
                expect
                (fp #b0 #b0011100 #b1000110000101111)))
; expect = -2.71990966796875

(assert (not (= expect result)))

(check-sat)
(exit)
