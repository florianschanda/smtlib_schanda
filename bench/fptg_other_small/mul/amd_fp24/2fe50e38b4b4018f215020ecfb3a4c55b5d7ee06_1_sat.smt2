(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -INT_BOUNDARY
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b1111110010001101)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b0101101 #b0100110001111011)))
; arg1 = -131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0101100 #b0111011100010100)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b0001110 #b0101000110000111)))
; arg2 = -0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0001001 #b0100101110100100)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1001111 #b0111000010111100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
