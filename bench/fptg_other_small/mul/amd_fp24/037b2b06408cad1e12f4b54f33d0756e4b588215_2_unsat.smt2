; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1100100001110111)
                arg1
                (fp #b1 #b1010101 #b0001001101010100)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010100)
                arg1
                (fp #b1 #b0111001 #b0010110000011010)))
; arg1 = -4510976.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111101 #b1001001111000111)
                expect
                (fp #b0 #b1101011 #b0010100000011110)))
(assert (fp.leq (fp #b0 #b1101011 #b0010100000011110)
                expect
                (fp #b0 #b1101011 #b0111101010001011)))
; expect = 20349018177536.0

(assert (not (= expect result)))

(check-sat)
(exit)
