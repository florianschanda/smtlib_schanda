(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011010 #b1011100000011001)
                arg1
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1100101 #b1100111101000111)))
; arg1 = 4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011011 #b0000110011110000)
                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b0111110 #b0110001000011111)))
; arg2 = 0.00179137289524078369140625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011100 #b0111100110110010)
                expect
                (fp #b0 #b1010101 #b1101010110011000)))
(assert (fp.leq (fp #b0 #b1010101 #b1101010110011000)
                expect
                (fp #b0 #b1100111 #b0100101000101100)))
; expect = 7693824.0

(assert (= expect result))

(check-sat)
(exit)
