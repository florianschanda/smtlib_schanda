; Format: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b0110101101011111)
                arg1
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                arg1
                (fp #b0 #b1111110 #b1110110010010000)))
; arg1 = 4983772676096.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001011 #b1111101110111110)
                arg2
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                arg2
                (fp #b0 #b0100011 #b0011111011001101)))
; arg2 = -0.0003445781767368316650390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b1001100100100101)
                expect
                (fp #b1 #b1011101 #b1001100101101111)))
(assert (fp.leq (fp #b1 #b1011101 #b1001100101101111)
                expect
                (fp #b1 #b0010010 #b1100100010100100)))
; expect = -1717288960.0

(assert (= expect result))

(check-sat)
(exit)
