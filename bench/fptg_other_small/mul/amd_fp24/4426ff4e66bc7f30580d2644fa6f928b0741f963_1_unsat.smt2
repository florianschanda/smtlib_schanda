(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1100010 #b0001101001000001)))
; arg2 = 4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010100 #b0000101101100010)
                expect
                (fp #b0 #b1011111 #b0010000110100111)))
(assert (fp.leq (fp #b0 #b1011111 #b0010000110100111)
                expect
                (fp #b0 #b1101110 #b0110111110100110)))
; expect = 4859559936.0

(assert (not (= expect result)))

(check-sat)
(exit)
