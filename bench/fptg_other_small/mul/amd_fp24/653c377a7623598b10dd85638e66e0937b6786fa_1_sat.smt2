; Format: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0011101110110101)
                arg1
                (fp #b1 #b1111001 #b1011010110111001)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010110111001)
                arg1
                (fp #b1 #b1110101 #b0011111100011111)))
; arg1 = -492831897894780928.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
