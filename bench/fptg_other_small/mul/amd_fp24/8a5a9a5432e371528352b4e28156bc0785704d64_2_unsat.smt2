(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b1101111111100000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
