(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0011011001010011)
                expect
                (fp #b0 #b1000000 #b0000000100111110)))
(assert (fp.leq (fp #b0 #b1000000 #b0000000100111110)
                expect
                (fp #b0 #b1101101 #b0111010001011000)))
; expect = 2.00970458984375

(assert (not (= expect result)))

(check-sat)
(exit)
