(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100000 #b1101110001000110)
                expect
                (fp #b0 #b1011111 #b0001011011001100)))
(assert (fp.leq (fp #b0 #b1011111 #b0001011011001100)
                expect
                (fp #b0 #b1110100 #b1101010111000000)))
; expect = 4677435392.0

(assert (= expect result))

