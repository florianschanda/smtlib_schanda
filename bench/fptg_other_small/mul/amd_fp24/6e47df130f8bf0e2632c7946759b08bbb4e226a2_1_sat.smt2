                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1101011 #b0101000011100000)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0000111001101100)
                expect
                (fp #b1 #b1111000 #b1001111000001110)))
(assert (fp.leq (fp #b1 #b1111000 #b1001111000001110)
                expect
                (fp #b0 #b1010010 #b0101001100010000)))
; expect = -233092067042000896.0

(assert (= expect result))

(check-sat)
(exit)
