                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b1 #b0010111 #b1011010000010100)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b0101100011110011)
                expect
                (fp #b1 #b1001110 #b0110111101100000)))
(assert (fp.leq (fp #b1 #b1001110 #b0110111101100000)
                expect
                (fp #b1 #b1000101 #b0000001100000000)))
; expect = -47024.0

(assert (not (= expect result)))

(check-sat)
(exit)
