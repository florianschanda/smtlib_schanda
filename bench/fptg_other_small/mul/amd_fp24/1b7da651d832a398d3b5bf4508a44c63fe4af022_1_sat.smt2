; arg2 = -0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011110 #b1001100010101001)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1000010 #b1100010001000001)))
; expect = 0.0

(assert (= expect result))

