(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1110010 #b0101000100001100)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011000 #b0101100111100110)
                expect
                (fp #b0 #b1110110 #b0100101111010010)))
(assert (fp.leq (fp #b0 #b1110110 #b0100101111010010)
                expect
                (fp #b0 #b1111010 #b1100001110110110)))
; expect = 46699557366530048.0

(assert (not (= expect result)))

(check-sat)
(exit)
