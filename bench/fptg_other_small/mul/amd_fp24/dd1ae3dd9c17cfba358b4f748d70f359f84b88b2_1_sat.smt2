(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0001010010101101)
                arg2
                (fp #b1 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b1100001 #b0011011011111001)))
; arg2 = -0.000000000000000000204833080725281137073057191599900761502794921398162841796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b1110110101001100)
                expect
                (fp #b1 #b0100000 #b1110001110100101)))
(assert (fp.leq (fp #b1 #b0100000 #b1110001110100101)
                expect
                (fp #b0 #b1101101 #b0000001101011010)))
; expect = -0.00000000087974427742665284313261508941650390625

(assert (= expect result))

(check-sat)
(exit)
