; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1011110100000101)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b0 #b0001011 #b1000011010101111)))
; arg1 = -36787.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100011 #b1010010000100011)
                arg2
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                arg2
                (fp #b0 #b1011010 #b1000110001010111)))
; arg2 = 9884160.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0100000111001110)
                expect
                (fp #b1 #b1100101 #b0101001010100011)))
(assert (fp.leq (fp #b1 #b1100101 #b0101001010100011)
                expect
                (fp #b0 #b1000111 #b0011111011000000)))
; expect = -363608408064.0

(assert (not (= expect result)))

(check-sat)
(exit)
