(assert (fp.leq (fp #b0 #b0111111 #b0000001011100101)
                arg2
                (fp #b0 #b1100111 #b0011111011011001)))
; arg2 = 1.0113067626953125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011110 #b1011101100101001)
                expect
                (fp #b1 #b0111111 #b0000001011100101)))
(assert (fp.leq (fp #b1 #b0111111 #b0000001011100101)
                expect
                (fp #b1 #b0000110 #b1000110111101000)))
; expect = -1.0113067626953125

(assert (not (= expect result)))

(check-sat)
(exit)
