(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1011010011100100)
                arg1
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                arg1
                (fp #b0 #b0101111 #b0100110010101011)))
; arg1 = -129003500263702528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000000 #b1011011010001011)
                arg2
                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1111100 #b0010001101100001)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                expect
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                expect
                (fp #b0 #b0100100 #b1001011101001110)))
; expect = -18446603336221196288.0

(assert (= expect result))

(check-sat)
(exit)
