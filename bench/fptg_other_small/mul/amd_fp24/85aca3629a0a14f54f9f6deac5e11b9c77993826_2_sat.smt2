; Format: AMD_FP24
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0001101010000010)
                arg1
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg1
                (fp #b1 #b0011010 #b1111000111101011)))
; arg1 = -4611686018427387904.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0010100111011100)
                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b0 #b1101000 #b0000101000000100)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
