;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001010 #b1010000110110000)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                arg1
                (fp #b0 #b1111000 #b0101010001101110)))
; arg1 = 1.02752685546875

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010101 #b1010010010011111)
                expect
                (fp #b0 #b0111111 #b0000111001001001)))
(assert (fp.leq (fp #b0 #b0111111 #b0000111001001001)
                expect
                (fp #b0 #b0111111 #b0100110001010100)))
; expect = 1.0558013916015625

(assert (= expect result))

(check-sat)
(exit)
