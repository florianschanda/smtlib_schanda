; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0001000100010111)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1101111 #b1011010010010011)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0100100100011001)
                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b0 #b0101100 #b0111001110110001)))
; arg2 = -717963500751683584.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101101 #b1000111011011110)
                expect
                (fp #b0 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b0 #b1111010 #b0011111011010111)
                expect
                (fp #b0 #b1111100 #b0001100101000111)))
; expect = 717963500751683584.0

(assert (= expect result))

(check-sat)
(exit)
