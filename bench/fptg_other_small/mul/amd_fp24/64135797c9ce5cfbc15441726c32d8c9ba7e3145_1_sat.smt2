                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b0110000 #b1010101100100101)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011000 #b1100011110101100)
                expect
                (fp #b0 #b1010110 #b0000001000111000)))
(assert (fp.leq (fp #b0 #b1010110 #b0000001000111000)
                expect
                (fp #b0 #b1101001 #b0011010100010010)))
; expect = 8461312.0

(assert (= expect result))

(check-sat)
