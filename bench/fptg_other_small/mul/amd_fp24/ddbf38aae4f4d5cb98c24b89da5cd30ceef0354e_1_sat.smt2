                arg2
                (fp #b0 #b0000111 #b1010111110010000)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101100 #b1111011110001110)
                expect
                (fp #b0 #b1011111 #b0100001001110000)))
(assert (fp.leq (fp #b0 #b1011111 #b0100001001110000)
                expect
                (fp #b0 #b1101100 #b0101101100001000)))
; expect = 5409603584.0

(assert (= expect result))

