                arg2
                (fp #b0 #b1000101 #b1110010000101000)))
; arg2 = -1.741668701171875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000100 #b0001101101010111)
                expect
                (fp #b1 #b0111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1011110111011110)
                expect
                (fp #b0 #b0110011 #b1010100011110000)))
; expect = -1.741668701171875

(assert (= expect result))

(check-sat)
