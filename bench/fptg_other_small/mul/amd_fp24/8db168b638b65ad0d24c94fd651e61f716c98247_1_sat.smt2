(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b1101001001101000)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b1 #b0000011 #b1000101100101000)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b0000101001110001)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b0 #b0111011 #b0110110010011000)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101011 #b0110010000101110)
                expect
                (fp #b0 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b0 #b1001110 #b0001100010111110)
                expect
                (fp #b0 #b1100110 #b0010100010101110)))
; expect = 35935.0

(assert (= expect result))

(check-sat)
(exit)
