; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100001 #b0101011111100000)
                arg1
                (fp #b0 #b0100001 #b0110000110111010)))
(assert (fp.leq (fp #b0 #b0100001 #b0110000110111010)
                arg1
                (fp #b0 #b1001000 #b1011111001110010)))
; arg1 = 0.000000001286849737880402244627475738525390625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000001 #b1110100010101110)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1110100 #b0011000101100110)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100100 #b0000101110010100)
                expect
                (fp #b0 #b0101111 #b1111011010000000)))
(assert (fp.leq (fp #b0 #b0101111 #b1111011010000000)
                expect
                (fp #b0 #b0111011 #b1010000010101000)))
; expect = 0.0000299513339996337890625

(assert (= expect result))

(check-sat)
(exit)
