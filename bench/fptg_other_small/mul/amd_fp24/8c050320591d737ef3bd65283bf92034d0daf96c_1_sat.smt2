(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010011 #b1001001000101101)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b0 #b1011100 #b1111001100101011)))
; arg1 = -36787.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b0101111000011100)
                arg2
                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b1011011 #b0100001110101010)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0101010100101011)
                expect
                (fp #b0 #b1001111 #b0000110110001010)))
(assert (fp.leq (fp #b0 #b1001111 #b0000110110001010)
                expect
                (fp #b0 #b1110000 #b1001100111011000)))
; expect = 69002.0

(assert (= expect result))

(check-sat)
(exit)
