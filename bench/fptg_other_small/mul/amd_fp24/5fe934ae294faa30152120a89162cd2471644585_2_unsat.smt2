                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b0 #b0101001 #b0100111110101100)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b1001011000001001)
                expect
                (fp #b0 #b1100111 #b1010001000101101)))
(assert (fp.leq (fp #b0 #b1100111 #b1010001000101101)
                expect
                (fp #b0 #b1101011 #b1111100101011001)))
; expect = 1796051304448.0

(assert (not (= expect result)))

(check-sat)
(exit)
