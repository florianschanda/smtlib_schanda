(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100011 #b1111111001000110)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1011011 #b0000100001010010)))
; arg1 = 1.1314697265625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b1110111000010000)
                arg2
                (fp #b0 #b0111111 #b0000001011100101)))
(assert (fp.leq (fp #b0 #b0111111 #b0000001011100101)
                arg2
                (fp #b0 #b1110100 #b1010100101110110)))
; arg2 = 1.0113067626953125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b1011001011011111)
                expect
                (fp #b0 #b0111111 #b0010010011101110)))
(assert (fp.leq (fp #b0 #b0111111 #b0010010011101110)
                expect
                (fp #b0 #b1101011 #b1011110001100111)))
; expect = 1.144256591796875

(assert (= expect result))

(check-sat)
(exit)
