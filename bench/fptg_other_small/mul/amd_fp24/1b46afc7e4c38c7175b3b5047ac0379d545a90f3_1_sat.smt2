(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011010 #b1100111101010110)
                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1010101 #b0010100101110100)))
; arg1 = 76528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111000 #b1100010110111011)
                arg2
                (fp #b0 #b0111111 #b0000001011100101)))
(assert (fp.leq (fp #b0 #b0111111 #b0000001011100101)
                arg2
                (fp #b0 #b1011011 #b1111011011010101)))
; arg2 = 1.0113067626953125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0100110010100100)
                expect
                (fp #b0 #b1001111 #b0010111001010001)))
(assert (fp.leq (fp #b0 #b1001111 #b0010111001010001)
                expect
                (fp #b0 #b1111101 #b0111001101001100)))
; expect = 77393.0

(assert (= expect result))

(check-sat)
(exit)
