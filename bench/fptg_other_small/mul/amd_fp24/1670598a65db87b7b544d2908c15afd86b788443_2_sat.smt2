(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0011010101010000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b1 #b0010000 #b0011001111110100)))
; arg1 = -1.417633056640625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b1011010101110101)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b1 #b0110010 #b1110110010011110)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b0011100010011101)
                expect
                (fp #b0 #b1001110 #b1000110111111110)))
(assert (fp.leq (fp #b0 #b1001110 #b1000110111111110)
                expect
                (fp #b0 #b1010001 #b1000101000011110)))
; expect = 50943.0

(assert (= expect result))

(check-sat)
(exit)
