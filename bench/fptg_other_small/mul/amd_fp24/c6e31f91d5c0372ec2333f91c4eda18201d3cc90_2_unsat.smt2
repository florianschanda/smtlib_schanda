                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1011011 #b1001010100010000)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101001 #b0110110010000000)
                expect
                (fp #b0 #b1101100 #b0100110000110100)))
(assert (fp.leq (fp #b0 #b1101100 #b0100110000110100)
                expect
                (fp #b0 #b1101111 #b0001000011000000)))
; expect = 45657649840128.0

(assert (not (= expect result)))

(check-sat)
(exit)
