(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001010 #b0001101100100000)
                arg1
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg1
                (fp #b0 #b1011111 #b0001011100001111)))
; arg1 = -1.946075439453125

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b1101110000110010)
                arg2
                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b1110110 #b1011101100111101)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001110 #b1010110100100011)
                expect
                (fp #b0 #b1000000 #b1101001100111101)))
(assert (fp.leq (fp #b0 #b1000000 #b1101001100111101)
                expect
                (fp #b0 #b1010100 #b0101101000010110)))
; expect = 3.650299072265625

(assert (= expect result))

(check-sat)
(exit)
