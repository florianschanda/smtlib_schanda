(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010100 #b0011010100110010)
                expect
                (fp #b0 #b0110000 #b0110110100000001)))
(assert (fp.leq (fp #b0 #b0110000 #b0110110100000001)
                expect
                (fp #b0 #b1001100 #b1000000111011111)))
; expect = 0.0000435118563473224639892578125

(assert (not (= expect result)))

(check-sat)
(exit)
