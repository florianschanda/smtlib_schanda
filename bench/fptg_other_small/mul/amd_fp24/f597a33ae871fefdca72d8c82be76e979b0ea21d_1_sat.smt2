(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b1001000111101101)
                arg1
                (fp #b1 #b0100000 #b0000000000000000)))
