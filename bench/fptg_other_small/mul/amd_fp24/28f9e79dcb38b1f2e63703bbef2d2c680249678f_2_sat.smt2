; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b1111101010110101)
                arg1
                (fp #b1 #b1010101 #b0001001101010100)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010100)
                arg1
                (fp #b1 #b0111010 #b0011010000111101)))
; arg1 = -4510976.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b1100001111100010)
                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b0 #b0001110 #b0010011100110110)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1011000 #b0010001011010010)
                expect
                (fp #b0 #b1100100 #b0101110100110100)))
(assert (fp.leq (fp #b0 #b1100100 #b0101110100110100)
                expect
                (fp #b0 #b1101001 #b0000111001000110)))
; expect = 187477000192.0

(assert (= expect result))

(check-sat)
(exit)
