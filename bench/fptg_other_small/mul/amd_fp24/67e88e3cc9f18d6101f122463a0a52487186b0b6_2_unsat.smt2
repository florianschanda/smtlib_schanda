(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000001 #b1001110110001010)
                expect
                (fp #b0 #b1100110 #b0110000000111100)))
(assert (fp.leq (fp #b0 #b1100110 #b0110000000111100)
