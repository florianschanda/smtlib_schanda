(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001001 #b0100011100111100)
                expect
                (fp #b0 #b1110111 #b1110011011100000)))
(assert (fp.leq (fp #b0 #b1110111 #b1110011011100000)
                expect
                (fp #b0 #b1111000 #b1001001001101100)))
; expect = 137043129286000640.0

(assert (= expect result))

