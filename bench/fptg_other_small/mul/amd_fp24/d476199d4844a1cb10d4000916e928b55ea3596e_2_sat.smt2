                arg2
                (fp #b1 #b0111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1011110111011110)
                arg2
                (fp #b1 #b0110000 #b0110100110011010)))
; arg2 = -1.741668701171875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1000101001111011)
                expect
                (fp #b1 #b1011111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b1011111 #b1011110111011110)
                expect
                (fp #b0 #b0101111 #b0011111110101111)))
; expect = -7480410112.0

(assert (= expect result))

(check-sat)
(exit)
