(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010111 #b0000100111010001)
                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b0 #b0110000 #b0011001011010101)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011010 #b1100111011111001)
                expect
                (fp #b0 #b1001111 #b0110001110001010)))
(assert (fp.leq (fp #b0 #b1001111 #b0110001110001010)
                expect
                (fp #b0 #b1001111 #b1111000001011001)))
; expect = 91018.0

(assert (= expect result))

(check-sat)
(exit)
