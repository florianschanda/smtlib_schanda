(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b1 #b1000110 #b1111101001011010)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b0111101010110100)
                expect
                (fp #b0 #b1110101 #b0001001101010011)))
(assert (fp.leq (fp #b0 #b1110101 #b0001001101010011)
                expect
                (fp #b0 #b1111101 #b0010111011011010)))
; expect = 19374219515133952.0

(assert (not (= expect result)))

(check-sat)
(exit)
