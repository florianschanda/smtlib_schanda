                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1111100 #b1111001010111101)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0010100010011001)
                expect
                (fp #b1 #b1111001 #b0011011110100100)))
(assert (fp.leq (fp #b1 #b1111001 #b0011011110100100)
                expect
                (fp #b0 #b0011110 #b0110000110111011)))
; expect = -350876150655877120.0

(assert (= expect result))

(check-sat)
(exit)
