(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1100010 #b0001011100101010)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110110 #b0101000001010000)
                expect
                (fp #b0 #b1011110 #b1000110100010100)))
(assert (fp.leq (fp #b0 #b1011110 #b1000110100010100)
                expect
                (fp #b0 #b1110100 #b0001100100110001)))
; expect = 3330932736.0

(assert (= expect result))

(check-sat)
(exit)
