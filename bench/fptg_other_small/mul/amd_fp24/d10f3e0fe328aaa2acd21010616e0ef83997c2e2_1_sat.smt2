(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b1110101001111001)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b1011001 #b1000001000010010)))
; arg1 = -130165.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1011111 #b0100100010100110)
                expect
                (fp #b0 #b1100000 #b1111100011110000)))
(assert (fp.leq (fp #b0 #b1100000 #b1111100011110000)
                expect
                (fp #b0 #b1100101 #b0110010100111010)))
; expect = 16942891008.0

(assert (= expect result))

(check-sat)
(exit)
