                expect
                (fp #b0 #b1110111 #b1100010111110010)))
(assert (fp.leq (fp #b0 #b1110111 #b1100010111110010)
                expect
                (fp #b0 #b1111110 #b1000000101001111)))
; expect = 127774246263848960.0

(assert (= expect result))

(check-sat)
