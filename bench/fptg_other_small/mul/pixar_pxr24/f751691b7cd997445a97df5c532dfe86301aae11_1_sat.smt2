(assert (fp.leq (fp #b0 #b00101100 #b100000100010010)
                expect
                (fp #b0 #b10001100 #b101011000100101)))
(assert (fp.leq (fp #b0 #b10001100 #b101011000100101)
                expect
                (fp #b0 #b10111010 #b011011101010100)))
; expect = 13705.25

(assert (= expect result))

