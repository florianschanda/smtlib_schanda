                arg2
                (fp #b1 #b00111100 #b000001011000011)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10010001 #b101111101000001)
                expect
                (fp #b0 #b11111110 #b111111111111111)))
