; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010101 #b101001010111100)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b11001000 #b100101110110000)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000101 #b000111001101110)
                arg2
                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                arg2
                (fp #b0 #b00011110 #b100001100101100)))
; arg2 = -1.317169189453125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010111 #b001100000010010)
                expect
                (fp #b0 #b10001010 #b100010010010110)))
(assert (fp.leq (fp #b0 #b10001010 #b100010010010110)
                expect
                (fp #b0 #b11010011 #b001000000001010)))
; expect = 3145.375

(assert (not (= expect result)))

(check-sat)
(exit)
