;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b001001100001011)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b0 #b11010010 #b101100011111111)))
; arg1 = -48335.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101010 #b100001001110010)
                expect
                (fp #b0 #b10011110 #b000101101000001)))
(assert (fp.leq (fp #b0 #b10011110 #b000101101000001)
                expect
                (fp #b0 #b10011110 #b110110010111110)))
; expect = 2336292864.0

(assert (not (= expect result)))

(check-sat)
(exit)
