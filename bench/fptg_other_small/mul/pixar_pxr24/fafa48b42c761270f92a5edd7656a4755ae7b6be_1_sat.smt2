(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011001 #b110110111011110)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b0 #b01001100 #b111001110011100)))
; arg1 = -48335.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00100000 #b101101000101110)
                arg2
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                arg2
                (fp #b0 #b11111111 #b000000000000000)))
; arg2 = 340277174624079928635746076935438991360.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111111 #b000000000000000)
                expect
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                expect
                (fp #b0 #b00011111 #b110101001010010)))
; expect = -340277174624079928635746076935438991360.0

(assert (= expect result))

(check-sat)
(exit)
