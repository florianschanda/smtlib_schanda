; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b101010011010110)
                arg1
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                arg1
                (fp #b0 #b11001111 #b111000000010001)))
; arg1 = 35973.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101101 #b110000100111010)
                expect
                (fp #b0 #b10011101 #b001101001000100)))
(assert (fp.leq (fp #b0 #b10011101 #b001101001000100)
                expect
                (fp #b0 #b11010010 #b100001100010101)))
; expect = 1294073856.0

(assert (not (= expect result)))

(check-sat)
(exit)
