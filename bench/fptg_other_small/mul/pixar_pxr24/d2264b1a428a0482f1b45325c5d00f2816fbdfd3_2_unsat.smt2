                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b1 #b01111000 #b000101011000101)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00100111 #b110000111100010)
                expect
                (fp #b0 #b10110010 #b000110010111100)))
(assert (fp.leq (fp #b0 #b10110010 #b000110010111100)
                expect
                (fp #b0 #b10110111 #b100000000110110)))
; expect = 2475825307844608.0

(assert (not (= expect result)))

(check-sat)
(exit)
