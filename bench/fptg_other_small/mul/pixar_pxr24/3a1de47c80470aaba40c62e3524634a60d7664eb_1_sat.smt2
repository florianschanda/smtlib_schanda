(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110111 #b100110100011111)
                arg1
                (fp #b1 #b11110110 #b011010110000111)))
(assert (fp.leq (fp #b1 #b11110110 #b011010110000111)
                arg1
                (fp #b1 #b11000000 #b101111001111011)))
; arg1 = -942543856691296776271252714512449536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10010110 #b000100110011011)
                arg2
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b10001101 #b101011110110011)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000010 #b010101011000111)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b01000011 #b100101100000110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
