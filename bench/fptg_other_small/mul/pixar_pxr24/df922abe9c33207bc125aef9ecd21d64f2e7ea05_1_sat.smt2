                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b00100100 #b100001010010110)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100000 #b101000010011111)
                expect
                (fp #b0 #b10011110 #b001010111011000)))
(assert (fp.leq (fp #b0 #b10011110 #b001010111011000)
                expect
                (fp #b0 #b11101111 #b000111101111010)))
; expect = 2513960960.0

(assert (= expect result))

(check-sat)
(exit)
