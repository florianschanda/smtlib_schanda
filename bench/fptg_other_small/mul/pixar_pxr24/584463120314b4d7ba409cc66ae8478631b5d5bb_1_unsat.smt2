(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b11010100 #b010100000111001)))
; arg2 = 65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100111 #b110100111010111)
                expect
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                expect
                (fp #b1 #b01010001 #b110001101101000)))
; expect = -65536.0

(assert (not (= expect result)))

(check-sat)
