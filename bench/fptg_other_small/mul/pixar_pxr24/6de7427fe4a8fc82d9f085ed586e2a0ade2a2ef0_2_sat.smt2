; Format: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b010000100010001)
                arg1
                (fp #b1 #b11110110 #b011010110000111)))
(assert (fp.leq (fp #b1 #b11110110 #b011010110000111)
                arg1
                (fp #b1 #b01000010 #b000010000101000)))
; arg1 = -942543856691296776271252714512449536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111111 #b000000000000000)
                arg2
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                arg2
                (fp #b1 #b01101111 #b111101011101101)))
; arg2 = -340277174624079928635746076935438991360.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
