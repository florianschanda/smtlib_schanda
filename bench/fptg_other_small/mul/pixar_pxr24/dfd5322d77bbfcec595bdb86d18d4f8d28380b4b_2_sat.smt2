                (fp #b0 #b10100111 #b100000111010111)))
; arg2 = -0.000000000000000000000000000000000000010253648385483839062582518445868972231778234133672051277857864386156006020200948114506900310516357421875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011010 #b100111011010000)
                expect
                (fp #b0 #b01111000 #b001111001011000)))
(assert (fp.leq (fp #b0 #b01111000 #b001111001011000)
                expect
                (fp #b0 #b11101010 #b000001001011111)))
; expect = 0.0096645355224609375

(assert (= expect result))

