                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b11000101 #b000110110011111)))
; arg2 = 5679104.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101010 #b011010010111100)
                expect
                (fp #b1 #b10010101 #b111000010100101)))
(assert (fp.leq (fp #b1 #b10010101 #b111000010100101)
                expect
                (fp #b1 #b00111100 #b010110001010010)))
; expect = -7885440.0

(assert (= expect result))

(check-sat)
(exit)
