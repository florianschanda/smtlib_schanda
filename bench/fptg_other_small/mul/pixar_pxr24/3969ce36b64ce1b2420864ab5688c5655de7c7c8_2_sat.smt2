;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010000 #b101100101100110)
                arg1
                (fp #b1 #b01111111 #b011000110111010)))
