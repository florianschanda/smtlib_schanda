(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101001 #b110001100100011)
                expect
                (fp #b1 #b11100001 #b011110110100110)))
(assert (fp.leq (fp #b1 #b11100001 #b011110110100110)
                expect
