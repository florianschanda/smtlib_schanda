                arg2
                (fp #b0 #b11101000 #b010100101110100)))
; arg2 = 8115.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b100001100001101)
                expect
                (fp #b1 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b1 #b10001011 #b111110110011000)
                expect
                (fp #b1 #b00100000 #b011000100000000)))
; expect = -8115.0

(assert (not (= expect result)))

(check-sat)
