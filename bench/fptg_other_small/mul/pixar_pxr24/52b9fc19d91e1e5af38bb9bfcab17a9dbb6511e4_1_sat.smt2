                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b1 #b00000111 #b111010001110001)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b011011100100011)
                expect
                (fp #b1 #b10110001 #b101000101111001)))
(assert (fp.leq (fp #b1 #b10110001 #b101000101111001)
                expect
                (fp #b0 #b01100000 #b011001000011111)))
; expect = -1842540969984000.0

(assert (= expect result))

(check-sat)
(exit)
