(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b101010011010110)
                arg1
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                arg1
                (fp #b0 #b11001111 #b111000000010001)))
; arg1 = 35973.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101101 #b110000000011101)
                expect
                (fp #b0 #b10011101 #b001101001000011)))
(assert (fp.leq (fp #b0 #b10011101 #b001101001000011)
                expect
                (fp #b0 #b11010010 #b100000100101001)))
; expect = 1294041088.0

(assert (= expect result))

(check-sat)
(exit)
