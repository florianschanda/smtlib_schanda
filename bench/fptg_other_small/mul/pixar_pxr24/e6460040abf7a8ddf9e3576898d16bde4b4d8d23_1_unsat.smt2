; Format: PIXAR_PXR24
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001101 #b100101101111110)
                arg1
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b10101001 #b011101101000110)))
; arg1 = -0.000000000000000000000000000000000000000000358732406867153170156474773322218529607747057120388037569809480675786517167580313980579376220703125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00101000 #b010000100100101)
                arg2
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b10110000 #b111110110111101)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00110011 #b011010110011101)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b01010100 #b110001010010111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
