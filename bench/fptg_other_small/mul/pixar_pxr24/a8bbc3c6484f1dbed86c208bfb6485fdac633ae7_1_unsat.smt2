                arg2
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg2
                (fp #b1 #b00000110 #b001010110110001)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b110110101000110)
                expect
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b00111001 #b001000111100001)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
