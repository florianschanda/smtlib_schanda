(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b00001100 #b010101001000100)))
; arg2 = -0.000000000000000000000000000000000000002003520492353050455323911609004590487859267314017367189827385949574267698380936053581535816192626953125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010110 #b100110100001000)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b11101001 #b100000111000111)))
; expect = 0.0

(assert (not (= expect result)))

