(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00101010 #b100100110011011)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11000011 #b110111000100110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110010 #b010110000001011)
                arg2
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01010000 #b001000111100110)))
; arg2 = 0.000000000000000000000000000000000000000000358732406867153170156474773322218529607747057120388037569809480675786517167580313980579376220703125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00101010 #b101101100100110)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10000001 #b101111111001111)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
