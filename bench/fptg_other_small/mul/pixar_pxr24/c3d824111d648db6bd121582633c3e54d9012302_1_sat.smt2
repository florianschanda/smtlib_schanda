; Format: PIXAR_PXR24
; Arg1: +SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011000 #b011001010011000)
                arg1
                (fp #b0 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b000000000000000)
                arg1
                (fp #b0 #b00000111 #b110011110101011)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00011001 #b110110110001100)
                arg2
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b00111011 #b010111000011000)))
; arg2 = 0.000000000000000000000000000000000000000000358732406867153170156474773322218529607747057120388037569809480675786517167580313980579376220703125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11001011 #b100100011010100)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b11000111 #b011111100011000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
