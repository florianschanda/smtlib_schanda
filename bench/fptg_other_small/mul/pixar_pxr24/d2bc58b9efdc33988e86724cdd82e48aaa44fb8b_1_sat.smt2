(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b01110010 #b110000001011110)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101101 #b011100000010001)
                expect
                (fp #b1 #b10011110 #b100100011101100)))
(assert (fp.leq (fp #b1 #b10011110 #b100100011101100)
                expect
                (fp #b1 #b10010010 #b111110111111010)))
; expect = -3370909696.0

(assert (= expect result))

(check-sat)
