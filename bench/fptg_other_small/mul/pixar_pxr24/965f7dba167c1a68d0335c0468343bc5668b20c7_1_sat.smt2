(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10011110 #b110010001001011)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b10011011 #b010000010110101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000000 #b000011101100110)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b11011000 #b110110001100001)))
; arg2 = 5679104.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00111011 #b000000010011001)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b11100110 #b010100000101000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
