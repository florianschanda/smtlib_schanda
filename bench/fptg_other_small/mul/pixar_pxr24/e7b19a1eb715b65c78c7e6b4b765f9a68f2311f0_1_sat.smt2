(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01000010 #b011010100010001)
                arg1
                (fp #b0 #b01111111 #b100001110001010)))
(assert (fp.leq (fp #b0 #b01111111 #b100001110001010)
                arg1
                (fp #b0 #b11110001 #b110111001000100)))
; arg1 = 1.52764892578125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010110 #b101110100001110)
                expect
                (fp #b0 #b10000000 #b001010101011011)))
(assert (fp.leq (fp #b0 #b10000000 #b001010101011011)
                expect
                (fp #b0 #b10001000 #b101010010011110)))
; expect = 2.33367919921875

(assert (= expect result))

(check-sat)
(exit)
