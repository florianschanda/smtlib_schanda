; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011110 #b101111001001010)
                expect
                (fp #b1 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b1 #b10001111 #b010000011101101)
                expect
                (fp #b1 #b01111110 #b101011011110001)))
; expect = -82394.0

(assert (not (= expect result)))

