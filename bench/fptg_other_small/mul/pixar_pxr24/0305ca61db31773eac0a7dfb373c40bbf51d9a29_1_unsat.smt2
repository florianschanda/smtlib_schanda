                arg2
                (fp #b0 #b10011101 #b111010011011100)))
; arg2 = -18446462598732840960.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111100 #b110001100110010)
                expect
                (fp #b0 #b11001010 #b001010100111111)))
(assert (fp.leq (fp #b0 #b11001010 #b001010100111111)
                expect
                (fp #b0 #b11100011 #b110110011010111)))
; expect = 44049671926513802412032.0

(assert (not (= expect result)))

