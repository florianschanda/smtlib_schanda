(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010110 #b111000110010001)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b10010000 #b111100100100010)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b100101100111011)
                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b10011110 #b111011100110100)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101010 #b110111000000010)
                expect
                (fp #b1 #b10010111 #b100001101111000)))
(assert (fp.leq (fp #b1 #b10010111 #b100001101111000)
                expect
                (fp #b0 #b01100011 #b001001001000111)))
; expect = -25620480.0

(assert (not (= expect result)))

(check-sat)
(exit)
