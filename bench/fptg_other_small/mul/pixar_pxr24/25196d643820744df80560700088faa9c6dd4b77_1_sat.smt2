(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b101001001101011)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b1 #b00110110 #b011101100101111)))
; arg1 = -48335.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101111 #b100001000100001)
                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b11011100 #b001011001101101)))
; arg2 = 1.040771484375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101010 #b100010011100110)
                expect
                (fp #b1 #b10001110 #b100010010000001)))
(assert (fp.leq (fp #b1 #b10001110 #b100010010000001)
                expect
                (fp #b1 #b00010100 #b101011001100100)))
; expect = -50305.0

(assert (= expect result))

(check-sat)
(exit)
