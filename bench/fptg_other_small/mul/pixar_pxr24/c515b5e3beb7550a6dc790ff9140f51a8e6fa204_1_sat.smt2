; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00101001 #b010110011110011)
                arg1
                (fp #b0 #b11100011 #b101010011011110)))
(assert (fp.leq (fp #b0 #b11100011 #b101010011011110)
                arg1
                (fp #b0 #b11111000 #b110000010101111)))
; arg1 = 2108134515650547271886027358208.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
