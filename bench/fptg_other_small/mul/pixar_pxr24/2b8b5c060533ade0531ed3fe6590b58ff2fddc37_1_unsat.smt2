(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001010 #b101110011100101)
                expect
                (fp #b0 #b10000000 #b101001010101001)))
(assert (fp.leq (fp #b0 #b10000000 #b101001010101001)
                expect
                (fp #b0 #b11011111 #b010010100111001)))
; expect = 3.29156494140625

(assert (not (= expect result)))

(check-sat)
(exit)
