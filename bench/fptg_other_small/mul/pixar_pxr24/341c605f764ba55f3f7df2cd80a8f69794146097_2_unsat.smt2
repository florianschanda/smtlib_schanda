;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110010 #b011111011110010)
                arg1
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                arg1
                (fp #b0 #b10010101 #b000100110100010)))
; arg1 = -1.38848876953125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101000 #b010110101000110)
                expect
                (fp #b0 #b01111111 #b111011011000110)))
(assert (fp.leq (fp #b0 #b01111111 #b111011011000110)
                expect
                (fp #b0 #b11011000 #b011000000000000)))
; expect = 1.92791748046875

(assert (not (= expect result)))

(check-sat)
(exit)
