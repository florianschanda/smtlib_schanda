; Format: PIXAR_PXR24
; Arg1: +ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011001 #b000111001111011)
                arg1
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b11110111 #b111100011111111)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001011 #b111111000101101)
                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b11100010 #b001001000100010)))
; arg2 = 1536361341386752.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00011011 #b011011000000111)
                expect
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                expect
                (fp #b0 #b10111101 #b010101011011110)))
; expect = 1536361341386752.0

(assert (= expect result))

(check-sat)
(exit)
