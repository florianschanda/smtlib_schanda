; Format: FLOAT_2_2
; Arg1: +SMALLEST_NORMAL

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b01 #b0)))
(assert (fp.leq (fp #b0 #b01 #b0)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 1.0

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (< (/ 1.0 2.0)
           expect
           (/ 3.0 2.0)))

(assert (= expect result))

(check-sat)
(exit)
