; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101100)
                arg1
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                arg1
                (fp #b0 #b10000 #b0000010110)))
; arg1 = -899.0

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (not (< (- (/ 1799.0 2.0))
                expect
                (- (/ 1797.0 2.0)))))

(assert (= expect result))

(check-sat)
