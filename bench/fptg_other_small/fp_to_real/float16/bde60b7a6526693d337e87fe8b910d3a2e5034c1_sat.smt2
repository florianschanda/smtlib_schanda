; Format: FLOAT16
; Arg1: -ONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0100001001)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b0 #b00011 #b0011101110)))
; arg1 = -1.0

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (< (- (/ 1025.0 1024.0))
           expect
           (- (/ 2047.0 2048.0))))

(assert (= expect result))

(check-sat)
(exit)
