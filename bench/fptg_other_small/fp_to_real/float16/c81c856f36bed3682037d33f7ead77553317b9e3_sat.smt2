(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -ZERO

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100 #b1100010001)
                arg1
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0010100110)))
; arg1 = -0

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (< (- (/ 1.0 16777216.0))
           expect
           (/ 1.0 16777216.0)))

(assert (= expect result))

(check-sat)
(exit)
