; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b110 #b0100)))
(assert (fp.leq (fp #b0 #b110 #b0100)
                arg1
                (fp #b0 #b110 #b0111)))
; arg1 = 10.0

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (< (/ 19.0 2.0)
           expect
           (/ 21.0 2.0)))

(assert (= expect result))

(check-sat)
(exit)
