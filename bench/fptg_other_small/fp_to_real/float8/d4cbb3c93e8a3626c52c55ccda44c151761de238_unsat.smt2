; Format: FLOAT8
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = 0.125

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (not (< (/ 7.0 64.0)
                expect
                (/ 9.0 64.0))))

(assert (= expect result))

(check-sat)
(exit)
