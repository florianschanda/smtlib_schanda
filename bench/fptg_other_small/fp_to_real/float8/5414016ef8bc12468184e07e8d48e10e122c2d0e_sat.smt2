; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                arg1
                (fp #b1 #b100 #b1011)))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = -3.375

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (< (- (/ 7.0 2.0))
           expect
           (- (/ 13.0 4.0))))

(assert (= expect result))

(check-sat)
(exit)
