(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1110110000)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b0 #b01011 #b0110010000)))
; arg1 = -16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1011011001)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b00000 #b1000011101)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010111010)
                expect
                (fp #b1 #b11101 #b0000000001)))
(assert (fp.leq (fp #b1 #b11101 #b0000000001)
                expect
                (fp #b1 #b00000 #b0110111010)))
; expect = -16400.0

(assert (not (= expect result)))

(check-sat)
(exit)
