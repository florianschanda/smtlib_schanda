(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b0111100000)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b10010 #b1011110110)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0110000101)
                arg2
                (fp #b0 #b01111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111 #b0010110101)
                arg2
                (fp #b0 #b10110 #b1100000101)))
; arg2 = 1.1767578125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00111 #b0110110100)
                expect
                (fp #b0 #b10000 #b0110001100)))
(assert (fp.leq (fp #b0 #b10000 #b0110001100)
                expect
                (fp #b0 #b10101 #b0101001100)))
; expect = 2.7734375

(assert (not (= expect result)))

(check-sat)
(exit)
