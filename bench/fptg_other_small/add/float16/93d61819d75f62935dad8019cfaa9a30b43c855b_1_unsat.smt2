(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01100 #b1111110110)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11101 #b1101010010)))
; arg1 = 13320.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1100111000)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b01101 #b1100010010)))
; arg2 = 0.000244140625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10011 #b0010001011)
                expect
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                expect
                (fp #b0 #b11101 #b0110000100)))
; expect = 13320.0

(assert (not (= expect result)))

(check-sat)
(exit)
