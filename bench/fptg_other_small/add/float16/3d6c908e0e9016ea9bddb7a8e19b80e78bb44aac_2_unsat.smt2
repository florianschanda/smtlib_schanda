(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -LARGEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b1 #b10011 #b0101010000)))
; arg1 = -65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1111100100)
                arg2
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11000 #b1111011111)))
; arg2 = -255.875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
