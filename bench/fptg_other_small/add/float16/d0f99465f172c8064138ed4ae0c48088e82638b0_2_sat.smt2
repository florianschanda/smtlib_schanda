(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b0100000101)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b1 #b00001 #b1011111110)))
; arg1 = -1.203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0101011001)
                arg2
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg2
                (fp #b0 #b00011 #b1101100010)))
; arg2 = -255.875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0111011001)
                expect
                (fp #b1 #b10111 #b0000000101)))
(assert (fp.leq (fp #b1 #b10111 #b0000000101)
                expect
                (fp #b0 #b00011 #b0000010100)))
; expect = -257.25

(assert (= expect result))

(check-sat)
(exit)
