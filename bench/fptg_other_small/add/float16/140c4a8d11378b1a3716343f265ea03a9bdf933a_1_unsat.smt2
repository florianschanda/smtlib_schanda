; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00011 #b0010000101)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b00100 #b1000100000)))
; arg1 = -0.000055372714996337890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1110000001)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b10110 #b0000001001)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1100000001)
                expect
                (fp #b1 #b00001 #b1110100000)))
(assert (fp.leq (fp #b1 #b00001 #b1110100000)
                expect
                (fp #b0 #b11000 #b0101111110)))
; expect = -0.0001163482666015625

(assert (not (= expect result)))

(check-sat)
(exit)
