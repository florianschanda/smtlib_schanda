(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01110 #b0010100000)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0010001000)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01101 #b0101111000)
                arg2
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11010 #b0110100010)))
; arg2 = 255.875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0101110011)
                expect
                (fp #b0 #b11101 #b0000010000)))
(assert (fp.leq (fp #b0 #b11101 #b0000010000)
                expect
                (fp #b0 #b11110 #b0100101111)))
; expect = 16640.0

(assert (= expect result))

(check-sat)
(exit)
