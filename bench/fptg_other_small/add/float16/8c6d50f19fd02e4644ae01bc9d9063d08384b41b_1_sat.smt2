(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1000010000)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11010 #b0001010000)))
; arg1 = 2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01101 #b0000100100)
                arg2
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg2
                (fp #b1 #b00000 #b0011010101)))
; arg2 = -0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10111 #b1000111110)
                expect
                (fp #b0 #b11001 #b1111111111)))
(assert (fp.leq (fp #b0 #b11001 #b1111111111)
                expect
                (fp #b0 #b11110 #b1101010001)))
; expect = 2047.0

(assert (= expect result))

(check-sat)
(exit)
