; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1101111101)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b10000 #b0101110001)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01101 #b0110010010)
                arg2
                (fp #b1 #b00000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000 #b0101011111)
                arg2
                (fp #b0 #b01110 #b1111001111)))
; arg2 = -0.000020921230316162109375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01100 #b1111110011)
                expect
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                expect
                (fp #b0 #b11010 #b0011001111)))
; expect = 0.054473876953125

(assert (not (= expect result)))

(check-sat)
(exit)
