; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01101 #b1011011001)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b10001 #b0101111011)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01111 #b0100110110)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b11000 #b0111101011)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b0111001101)
                expect
                (fp #b0 #b01010 #b1011111011)))
(assert (fp.leq (fp #b0 #b01010 #b1011111011)
                expect
                (fp #b0 #b10011 #b1111011010)))
; expect = 0.054534912109375

(assert (not (= expect result)))

(check-sat)
(exit)
