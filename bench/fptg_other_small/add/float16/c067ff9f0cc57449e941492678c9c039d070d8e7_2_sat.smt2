(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100101111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b0 #b01010 #b0110011110)))
; arg1 = -2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0000000011)
                arg2
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg2
                (fp #b0 #b10000 #b0001010001)))
; arg2 = -0.00006103515625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0101001011)
                expect
                (fp #b1 #b11010 #b0000000001)))
(assert (fp.leq (fp #b1 #b11010 #b0000000001)
                expect
                (fp #b0 #b00101 #b1010101101)))
; expect = -2050.0

(assert (= expect result))

(check-sat)
(exit)
