                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b01101 #b1001000110)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111010001)
                expect
                (fp #b0 #b00010 #b0010011100)))
(assert (fp.leq (fp #b0 #b00010 #b0010011100)
                expect
                (fp #b0 #b00011 #b0010000111)))
; expect = 0.000140666961669921875

(assert (not (= expect result)))

(check-sat)
(exit)
