(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0111111000)
                arg1
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg1
                (fp #b0 #b11101 #b1001001111)))
; arg1 = -0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0001110111)
                arg2
                (fp #b0 #b11011 #b0100110010)))
(assert (fp.leq (fp #b0 #b11011 #b0100110010)
                arg2
                (fp #b0 #b11011 #b1101000000)))
; arg2 = 5320.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10111 #b0111110111)
                expect
                (fp #b0 #b11011 #b0100110010)))
(assert (fp.leq (fp #b0 #b11011 #b0100110010)
                expect
                (fp #b0 #b11101 #b1100100111)))
; expect = 5320.0

(assert (= expect result))

(check-sat)
(exit)
