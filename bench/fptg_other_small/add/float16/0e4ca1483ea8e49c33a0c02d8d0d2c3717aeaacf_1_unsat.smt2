(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011010010)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b1 #b11000 #b0100110111)))
; arg1 = -1809.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0000100100)
                arg2
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg2
                (fp #b0 #b11100 #b1111010100)))
; arg2 = 1.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100010010)
                expect
                (fp #b1 #b11001 #b1100010000)))
(assert (fp.leq (fp #b1 #b11001 #b1100010000)
                expect
                (fp #b0 #b10011 #b1100001000)))
; expect = -1808.0

(assert (not (= expect result)))

(check-sat)
(exit)
