(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -ZERO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10000 #b0010111000)
                arg1
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg1
                (fp #b0 #b00001 #b1010101001)))
; arg1 = -0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0100101001)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b00101 #b1011100010)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b0100000111)
                expect
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                expect
                (fp #b0 #b10010 #b0111011011)))
; expect = 0.000060975551605224609375

(assert (not (= expect result)))

(check-sat)
(exit)
