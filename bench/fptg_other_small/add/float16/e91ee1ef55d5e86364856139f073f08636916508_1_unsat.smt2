(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b1011011011)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b0 #b10101 #b1100100000)))
; arg1 = -0.0078125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1101100011)
                arg2
                (fp #b1 #b00001 #b1010100010)))
(assert (fp.leq (fp #b1 #b00001 #b1010100010)
                arg2
                (fp #b0 #b10100 #b1001101011)))
; arg2 = -0.00010120868682861328125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b0010111110)
                expect
                (fp #b1 #b01000 #b0000001101)))
(assert (fp.leq (fp #b1 #b01000 #b0000001101)
                expect
                (fp #b0 #b10111 #b0000111100)))
; expect = -0.00791168212890625

(assert (not (= expect result)))

(check-sat)
(exit)
