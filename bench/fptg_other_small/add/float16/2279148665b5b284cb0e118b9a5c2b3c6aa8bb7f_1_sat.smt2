; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0010010101)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b10100 #b0100011110)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000001001)
                arg2
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg2
                (fp #b0 #b11100 #b1110001110)))
; arg2 = -0.000244140625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110001010)
                expect
                (fp #b1 #b00101 #b0110100100)))
(assert (fp.leq (fp #b1 #b00101 #b0110100100)
                expect
                (fp #b0 #b00111 #b1010001011)))
; expect = -0.001377105712890625

(assert (= expect result))

(check-sat)
(exit)
