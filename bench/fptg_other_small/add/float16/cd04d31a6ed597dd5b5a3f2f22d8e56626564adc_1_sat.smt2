(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1110101110)
                arg1
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg1
                (fp #b0 #b10101 #b1110000110)))
; arg1 = 0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0011101110)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b0 #b11001 #b1101000100)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0011111100)
                expect
                (fp #b1 #b11100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11100 #b1111111111)
                expect
                (fp #b1 #b01011 #b0101010110)))
; expect = -16376.0

(assert (= expect result))

(check-sat)
(exit)
