(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SMALLEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1011111110)
                arg1
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg1
                (fp #b0 #b01011 #b1110000011)))
; arg1 = 0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01001 #b0111010001)
                arg2
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg2
                (fp #b0 #b10001 #b1100000001)))
; arg2 = 1.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0110010000)
                expect
                (fp #b0 #b01111 #b0000000001)))
(assert (fp.leq (fp #b0 #b01111 #b0000000001)
                expect
                (fp #b0 #b11101 #b0111101111)))
; expect = 1.0009765625

(assert (= expect result))

(check-sat)
(exit)
