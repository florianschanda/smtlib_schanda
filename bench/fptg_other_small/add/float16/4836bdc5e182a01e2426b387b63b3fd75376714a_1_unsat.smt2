(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1011111100)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b01100 #b0100100111)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1011001110)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b1 #b01101 #b0110111011)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0110011100)
                expect
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                expect
                (fp #b1 #b01111 #b0011001011)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
