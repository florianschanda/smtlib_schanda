(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0010110111)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b1 #b00000 #b1111101111)))
; arg1 = -0.0024929046630859375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1100011101)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b0 #b11001 #b0101100000)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001100001)
                expect
                (fp #b1 #b01111 #b0100000000)))
(assert (fp.leq (fp #b1 #b01111 #b0100000000)
                expect
                (fp #b0 #b11101 #b1101111111)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
