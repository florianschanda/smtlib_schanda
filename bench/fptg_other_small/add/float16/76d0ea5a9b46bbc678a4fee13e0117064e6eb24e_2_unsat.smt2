(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0100110101)
                arg1
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg1
                (fp #b0 #b11001 #b0100001100)))
; arg1 = 0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111110001)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b0 #b10110 #b0001001101)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1011011100)
                expect
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                expect
                (fp #b1 #b01101 #b1100111000)))
; expect = -313.0

(assert (not (= expect result)))

(check-sat)
(exit)
