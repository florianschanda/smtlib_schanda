(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +ONE
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01000 #b0101010011)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b10000 #b0110010010)))
; arg1 = 1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0110000100)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b10001 #b0110101111)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0101110001)
                expect
                (fp #b0 #b01110 #b1111111111)))
(assert (fp.leq (fp #b0 #b01110 #b1111111111)
                expect
                (fp #b0 #b11110 #b1010101101)))
; expect = 0.99951171875

(assert (not (= expect result)))

(check-sat)
(exit)
