(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1001101101)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b11000 #b1001100100)))
; arg1 = 0.10479736328125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001111111)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b10111 #b0111111000)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b1100111000)
                expect
                (fp #b0 #b10010 #b1000111101)))
(assert (fp.leq (fp #b0 #b10010 #b1000111101)
                expect
                (fp #b0 #b11011 #b1011000000)))
; expect = 12.4765625

(assert (not (= expect result)))

(check-sat)
(exit)
