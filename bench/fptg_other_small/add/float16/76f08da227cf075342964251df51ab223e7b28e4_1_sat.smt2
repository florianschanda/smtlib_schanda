(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1101111011)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b10100 #b0010111010)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b0010010011)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11101 #b0111100010)))
; arg2 = 1336.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01100 #b0100011010)
                expect
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                expect
                (fp #b0 #b11010 #b0001010101)))
; expect = 1336.0

(assert (= expect result))

(check-sat)
(exit)
