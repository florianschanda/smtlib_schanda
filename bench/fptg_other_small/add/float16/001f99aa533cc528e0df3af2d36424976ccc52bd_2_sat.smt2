(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1000101110)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b1 #b01100 #b1010001011)))
; arg1 = -25296.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10010 #b0001000110)
                arg2
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11101 #b0101100001)))
; arg2 = 255.875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110100011)
                expect
                (fp #b1 #b11101 #b1000011110)))
(assert (fp.leq (fp #b1 #b11101 #b1000011110)
                expect
                (fp #b1 #b00110 #b1001010101)))
; expect = -25056.0

(assert (= expect result))

(check-sat)
(exit)
