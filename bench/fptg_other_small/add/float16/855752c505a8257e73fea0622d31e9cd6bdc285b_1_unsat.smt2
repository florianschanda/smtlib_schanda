; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100101000)
                arg1
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0101010111)))
; arg1 = 0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1111111110)
                arg2
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b0 #b01001 #b0000110001)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1001110010)
                expect
                (fp #b1 #b01111 #b0000100110)))
(assert (fp.leq (fp #b1 #b01111 #b0000100110)
                expect
                (fp #b0 #b01010 #b0011001010)))
; expect = -1.037109375

(assert (not (= expect result)))

(check-sat)
(exit)
