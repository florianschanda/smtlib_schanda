(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0101110001)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b00001 #b1001100110)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101001010)
                arg2
                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b0 #b01111 #b0111110100)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0111011000)
                expect
                (fp #b1 #b11100 #b0111010100)))
(assert (fp.leq (fp #b1 #b11100 #b0111010100)
                expect
                (fp #b0 #b01000 #b1010101000)))
; expect = -11936.0

(assert (not (= expect result)))

(check-sat)
(exit)
