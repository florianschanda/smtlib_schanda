(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0011100010)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b00111 #b0011111101)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00110 #b1101101000)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b01010 #b0000100110)))
; arg2 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0001010101)
                expect
                (fp #b0 #b00111 #b1011010111)))
(assert (fp.leq (fp #b0 #b00111 #b1011010111)
                expect
                (fp #b0 #b01101 #b0011101100)))
; expect = 0.006679534912109375

(assert (not (= expect result)))

(check-sat)
(exit)
