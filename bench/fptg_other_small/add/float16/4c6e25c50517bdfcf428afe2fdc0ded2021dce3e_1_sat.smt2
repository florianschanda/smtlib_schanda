(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0110011000)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b01010 #b0110011101)))
; arg1 = 0.000060558319091796875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111100001)
                arg2
                (fp #b1 #b11110 #b1111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111001110)
                arg2
                (fp #b1 #b00101 #b0111010001)))
; arg2 = -63936.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111110010)
                expect
                (fp #b1 #b11110 #b1111001101)))
(assert (fp.leq (fp #b1 #b11110 #b1111001101)
                expect
                (fp #b0 #b01101 #b1101100010)))
; expect = -63904.0

(assert (= expect result))

(check-sat)
(exit)
