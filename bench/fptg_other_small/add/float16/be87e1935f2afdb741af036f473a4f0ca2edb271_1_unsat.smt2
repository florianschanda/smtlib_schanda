(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b0000101111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b10100 #b1001101000)))
; arg1 = 0.000060558319091796875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1101001110)
                arg2
                (fp #b1 #b00001 #b1010100010)))
(assert (fp.leq (fp #b1 #b00001 #b1010100010)
                arg2
                (fp #b0 #b01011 #b0011110101)))
; arg2 = -0.00010120868682861328125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000110100)
                expect
                (fp #b1 #b00000 #b1010101010)))
(assert (fp.leq (fp #b1 #b00000 #b1010101010)
                expect
                (fp #b0 #b00111 #b0001100100)))
; expect = -0.00004065036773681640625

(assert (not (= expect result)))

(check-sat)
(exit)
