                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b0 #b01111 #b0010000110)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0011100111)
                expect
                (fp #b1 #b01111 #b0011111111)))
(assert (fp.leq (fp #b1 #b01111 #b0011111111)
                expect
                (fp #b1 #b01011 #b0111100101)))
; expect = -1.2490234375

(assert (not (= expect result)))

(check-sat)
(exit)
