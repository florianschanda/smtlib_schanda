(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0001100111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b0 #b01001 #b1101011001)))
; arg1 = -2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b0010001001)
                arg2
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg2
                (fp #b0 #b01010 #b1001001111)))
; arg2 = 0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1000100001)
                expect
                (fp #b1 #b11001 #b1111111111)))
(assert (fp.leq (fp #b1 #b11001 #b1111111111)
                expect
                (fp #b0 #b01111 #b1001011001)))
; expect = -2047.0

(assert (= expect result))

(check-sat)
(exit)
