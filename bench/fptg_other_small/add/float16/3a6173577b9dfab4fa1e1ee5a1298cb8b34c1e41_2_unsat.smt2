(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0001100010)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b00110 #b0000111011)))
; arg1 = 0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01011 #b1001101100)
                arg2
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                arg2
                (fp #b0 #b11000 #b0110001101)))
; arg2 = 439.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00010 #b1010011100)
                expect
                (fp #b0 #b10111 #b1011011101)))
(assert (fp.leq (fp #b0 #b10111 #b1011011101)
                expect
                (fp #b0 #b11010 #b1111001011)))
; expect = 439.25

(assert (not (= expect result)))

(check-sat)
(exit)
