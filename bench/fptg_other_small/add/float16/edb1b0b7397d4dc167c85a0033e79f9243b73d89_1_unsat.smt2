(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0100111011)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b0 #b00100 #b1010111100)))
; arg1 = -2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01000 #b0000010001)
                arg2
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11001 #b1011001001)))
; arg2 = 255.875

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0010011110)
                expect
                (fp #b1 #b11001 #b1100000000)))
(assert (fp.leq (fp #b1 #b11001 #b1100000000)
                expect
                (fp #b1 #b00001 #b1101011110)))
; expect = -1792.0

(assert (not (= expect result)))

(check-sat)
(exit)
