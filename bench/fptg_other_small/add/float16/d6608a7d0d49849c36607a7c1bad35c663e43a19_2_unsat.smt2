(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010111100)
                arg1
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg1
                (fp #b0 #b00010 #b0111000110)))
; arg1 = -7412.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b11000 #b1000111001)
                arg2
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg2
                (fp #b0 #b11101 #b0111111001)))
; arg2 = 16384.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01111 #b1110001011)
                expect
                (fp #b0 #b11100 #b0001100010)))
(assert (fp.leq (fp #b0 #b11100 #b0001100010)
                expect
                (fp #b0 #b11110 #b0111000111)))
; expect = 8976.0

(assert (not (= expect result)))

(check-sat)
(exit)
