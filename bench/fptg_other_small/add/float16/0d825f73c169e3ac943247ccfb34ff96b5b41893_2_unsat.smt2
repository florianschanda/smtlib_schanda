(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0111001000)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11000 #b0000100111)))
; arg1 = 14.8359375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01001 #b0000001111)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11011 #b0110100001)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01111 #b0111000000)
                expect
                (fp #b0 #b11010 #b0000001001)))
(assert (fp.leq (fp #b0 #b11010 #b0000001001)
                expect
                (fp #b0 #b11011 #b0000010010)))
; expect = 2066.0

(assert (not (= expect result)))

(check-sat)
(exit)
