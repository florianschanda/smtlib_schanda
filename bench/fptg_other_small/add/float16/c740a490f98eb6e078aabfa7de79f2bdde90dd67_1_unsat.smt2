(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1100010100)
                arg1
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg1
                (fp #b0 #b11011 #b1010011001)))
; arg1 = 0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1001101110)
                arg2
                (fp #b0 #b11011 #b0100110010)))
(assert (fp.leq (fp #b0 #b11011 #b0100110010)
                arg2
                (fp #b0 #b11110 #b1100111011)))
; arg2 = 5320.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10100 #b0011101111)
                expect
                (fp #b0 #b11011 #b0100110010)))
(assert (fp.leq (fp #b0 #b11011 #b0100110010)
                expect
                (fp #b0 #b11101 #b0011011001)))
; expect = 5320.0

(assert (not (= expect result)))

(check-sat)
(exit)
