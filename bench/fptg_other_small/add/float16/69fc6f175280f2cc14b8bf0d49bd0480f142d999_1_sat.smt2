(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0011101001)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11001 #b1101000000)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001000100)
                arg2
                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b0 #b11001 #b1010001001)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101011001)
                expect
                (fp #b1 #b11100 #b0111010100)))
(assert (fp.leq (fp #b1 #b11100 #b0111010100)
                expect
                (fp #b0 #b01100 #b1000101011)))
; expect = -11936.0

(assert (= expect result))

(check-sat)
(exit)
