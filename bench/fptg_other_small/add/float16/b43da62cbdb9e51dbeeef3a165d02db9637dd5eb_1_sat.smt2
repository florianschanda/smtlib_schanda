; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110110101)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b0 #b11001 #b1000000110)))
; arg1 = -0.0024929046630859375

(declare-const arg2 Float16)
(assert (= arg2 arg1))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0111001100)
                expect
                (fp #b1 #b00111 #b0100011011)))
(assert (fp.leq (fp #b1 #b00111 #b0100011011)
                expect
                (fp #b0 #b11000 #b1111011011)))
; expect = -0.004985809326171875

(assert (= expect result))

(check-sat)
(exit)
