; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00110 #b1010101100)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b01011 #b0100000100)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0011011100)
                arg2
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg2
                (fp #b0 #b10101 #b0110100011)))
; arg2 = 0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1011101010)
                expect
                (fp #b0 #b00000 #b0001001101)))
(assert (fp.leq (fp #b0 #b00000 #b0001001101)
                expect
                (fp #b0 #b01100 #b1111111111)))
; expect = 0.000004589557647705078125

(assert (not (= expect result)))

(check-sat)
(exit)
