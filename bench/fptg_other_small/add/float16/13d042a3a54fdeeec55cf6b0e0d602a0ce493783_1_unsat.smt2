(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1010010001)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b1 #b00000 #b1010100111)))
; arg1 = -0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0000100010)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b1011000011)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b11100 #b0010100111)
                expect
                (fp #b0 #b11110 #b0110110000)))
(assert (fp.leq (fp #b0 #b11110 #b0110110000)
                expect
                (fp #b0 #b11110 #b1000111010)))
; expect = 46592.0

(assert (not (= expect result)))

(check-sat)
(exit)
