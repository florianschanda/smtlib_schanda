(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111001011)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b1 #b00100 #b1011000100)))
; arg1 = -933.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1011011000)
                arg2
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                arg2
                (fp #b1 #b10111 #b1110000011)))
; arg2 = -646.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0011010010)
                expect
                (fp #b1 #b11001 #b1000101011)))
(assert (fp.leq (fp #b1 #b11001 #b1000101011)
                expect
                (fp #b0 #b11011 #b1111010011)))
; expect = -1579.0

(assert (not (= expect result)))

(check-sat)
(exit)
