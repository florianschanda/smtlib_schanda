(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110101010)
                arg1
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg1
                (fp #b0 #b10100 #b0001111111)))
; arg1 = -7412.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0000000111)
                arg2
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                arg2
                (fp #b0 #b00111 #b1111101001)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000001100)
                expect
                (fp #b1 #b11011 #b1101000100)))
(assert (fp.leq (fp #b1 #b11011 #b1101000100)
                expect
                (fp #b1 #b01001 #b0001110100)))
; expect = -7440.0

(assert (not (= expect result)))

(check-sat)
(exit)
