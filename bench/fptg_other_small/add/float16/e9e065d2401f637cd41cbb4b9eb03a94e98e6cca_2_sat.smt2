(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0000011000)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b11110 #b0110011110)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1100111011)
                arg2
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg2
                (fp #b1 #b00110 #b1000111100)))
; arg2 = -0.0078125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0011001100)
                expect
                (fp #b1 #b01000 #b0010010101)))
(assert (fp.leq (fp #b1 #b01000 #b0010010101)
                expect
                (fp #b0 #b11001 #b0000101100)))
; expect = -0.00894927978515625

(assert (= expect result))

(check-sat)
(exit)
