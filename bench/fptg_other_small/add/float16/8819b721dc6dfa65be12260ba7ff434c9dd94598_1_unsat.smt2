(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0101111010)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b10010 #b1011111101)))
; arg1 = 0.0078125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00100 #b0001110011)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b11010 #b0100000110)))
; arg2 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1000010011)
                expect
                (fp #b0 #b01001 #b0000000000)))
(assert (fp.leq (fp #b0 #b01001 #b0000000000)
                expect
                (fp #b0 #b10101 #b1101100001)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
