(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1110100110)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0111110011)))
; arg1 = -0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10110 #b1010101010)
                arg2
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg2
                (fp #b0 #b00111 #b0011110011)))
; arg2 = -0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b1001111011)
                expect
                (fp #b1 #b00001 #b0000000001)))
(assert (fp.leq (fp #b1 #b00001 #b0000000001)
                expect
                (fp #b0 #b00101 #b1000001110)))
; expect = -0.000061094760894775390625

(assert (= expect result))

(check-sat)
(exit)
