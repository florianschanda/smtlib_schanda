(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0000011010)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b1 #b00110 #b0100100111)))
; arg1 = -264.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0101001101)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b0 #b01110 #b1000111111)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011101100)
                expect
                (fp #b1 #b11000 #b0010000010)))
(assert (fp.leq (fp #b1 #b11000 #b0010000010)
                expect
                (fp #b0 #b10101 #b0000000011)))
; expect = -577.0

(assert (= expect result))

(check-sat)
(exit)
