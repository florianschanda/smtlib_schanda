(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0110001101)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11110 #b0001011001)))
; arg1 = 13320.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0110000101)
                arg2
                (fp #b0 #b01111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111 #b0010110101)
                arg2
                (fp #b0 #b11011 #b0010000101)))
; arg2 = 1.1767578125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1100001001)
                expect
                (fp #b0 #b11100 #b1010000010)))
(assert (fp.leq (fp #b0 #b11100 #b1010000010)
                expect
                (fp #b0 #b11110 #b1011000000)))
; expect = 13328.0

(assert (not (= expect result)))

(check-sat)
(exit)
