; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00110 #b1000001100)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b0 #b10011 #b1000111101)))
; arg1 = -0.0024929046630859375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b0111111110)
                arg2
                (fp #b0 #b01111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111 #b0010110101)
                arg2
                (fp #b0 #b10011 #b1100100101)))
; arg2 = 1.1767578125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1000000110)
                expect
                (fp #b0 #b01111 #b0010110010)))
(assert (fp.leq (fp #b0 #b01111 #b0010110010)
                expect
                (fp #b0 #b11100 #b0100100011)))
; expect = 1.173828125

(assert (not (= expect result)))

(check-sat)
(exit)
