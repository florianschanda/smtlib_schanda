; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0110100011)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b0 #b00000 #b1111111001)))
; arg1 = -3788.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1011011111)
                arg2
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                arg2
                (fp #b0 #b11101 #b0001110011)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110000001)
                expect
                (fp #b1 #b11010 #b1101110101)))
(assert (fp.leq (fp #b1 #b11010 #b1101110101)
                expect
                (fp #b0 #b00100 #b0101001010)))
; expect = -3818.0

(assert (not (= expect result)))

(check-sat)
(exit)
