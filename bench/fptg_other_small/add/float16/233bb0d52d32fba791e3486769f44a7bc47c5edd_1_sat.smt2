                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b00010 #b1010101000)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b1011000100)
                expect
                (fp #b0 #b00000 #b0000000110)))
(assert (fp.leq (fp #b0 #b00000 #b0000000110)
                expect
                (fp #b0 #b11110 #b0110000110)))
; expect = 0.00000035762786865234375

(assert (= expect result))

(check-sat)
(exit)
