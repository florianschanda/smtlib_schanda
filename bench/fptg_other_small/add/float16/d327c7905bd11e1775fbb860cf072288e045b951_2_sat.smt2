(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0100001101)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b11001 #b0010010001)))
; arg1 = 0.000060558319091796875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0011111001)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11011 #b0111010001)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b1100100100)
                expect
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                expect
                (fp #b0 #b11100 #b0100111010)))
; expect = 2050.0

(assert (= expect result))

(check-sat)
(exit)
