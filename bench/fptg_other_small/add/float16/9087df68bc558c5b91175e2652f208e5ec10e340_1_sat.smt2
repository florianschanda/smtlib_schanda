(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0010101010)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b01011 #b1010000111)))
; arg1 = 0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1010111000)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b01101 #b0001101011)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b0111101110)
                expect
                (fp #b1 #b00000 #b1011111111)))
(assert (fp.leq (fp #b1 #b00000 #b1011111111)
                expect
                (fp #b0 #b00111 #b0000110101)))
; expect = -0.000045716762542724609375

(assert (= expect result))

(check-sat)
(exit)
