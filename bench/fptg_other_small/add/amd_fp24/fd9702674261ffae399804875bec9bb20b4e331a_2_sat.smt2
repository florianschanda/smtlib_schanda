                arg2
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1010110 #b0001011111001100)))
; arg2 = 131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100111 #b0000110010010011)
                expect
                (fp #b0 #b1011111 #b0000000000000010)))
(assert (fp.leq (fp #b0 #b1011111 #b0000000000000010)
                expect
                (fp #b0 #b1100001 #b1000011111010001)))
; expect = 4295098368.0

(assert (= expect result))

(check-sat)
(exit)
