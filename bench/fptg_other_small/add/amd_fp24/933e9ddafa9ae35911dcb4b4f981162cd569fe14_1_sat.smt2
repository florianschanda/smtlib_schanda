                arg2
                (fp #b1 #b0000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101111010010)
                arg2
                (fp #b0 #b0100010 #b1010000001010101)))
; arg2 = -0.00000000000000000014553746569502990122757513091755754430778324604034423828125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0001000001101010)
                expect
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                expect
                (fp #b1 #b0011010 #b0010011111010000)))
; expect = -131072.0

(assert (= expect result))

(check-sat)
(exit)
