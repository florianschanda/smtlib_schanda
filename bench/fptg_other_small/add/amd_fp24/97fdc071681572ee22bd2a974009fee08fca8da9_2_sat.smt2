                arg2
                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1011000 #b0101001100011000)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101000 #b0110001000001010)
                expect
                (fp #b0 #b1101100 #b1010100100110100)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110100)
                expect
                (fp #b0 #b1111000 #b0001111001000111)))
; expect = 58439472513024.0

(assert (= expect result))

(check-sat)
(exit)
