                arg2
                (fp #b0 #b1010101 #b0011001010000110)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b1111101000011011)
                expect
                (fp #b0 #b1101001 #b0010001000010111)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000010111)
                expect
                (fp #b0 #b1110000 #b1110010100001100)))
; expect = 4983705567232.0

(assert (= expect result))

