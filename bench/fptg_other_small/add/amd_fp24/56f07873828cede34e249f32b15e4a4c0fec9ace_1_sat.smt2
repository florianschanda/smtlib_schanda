(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                expect
                (fp #b1 #b1111110 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111110)
                expect
                (fp #b0 #b0010011 #b1010010011100100)))
; expect = -18446462598732840960.0

(assert (= expect result))

(check-sat)
