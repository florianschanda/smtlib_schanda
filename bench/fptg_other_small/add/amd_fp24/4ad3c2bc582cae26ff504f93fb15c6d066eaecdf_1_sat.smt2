(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b0001110011001000)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b1 #b1000100 #b0000101000000001)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
