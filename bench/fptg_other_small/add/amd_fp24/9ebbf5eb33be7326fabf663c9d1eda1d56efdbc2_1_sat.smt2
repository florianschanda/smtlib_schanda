; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0011110000010101)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b0 #b0011001 #b1110001011000110)))
; arg1 = -14354451791872.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001001 #b0010101000101100)
                arg2
                (fp #b1 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000000)
                arg2
                (fp #b1 #b0001001 #b0101100001010010)))
; arg2 = -0.000000000001818989403545856475830078125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b1010001011100111)
                expect
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                expect
                (fp #b1 #b0111011 #b1111101001000010)))
; expect = -14354451791872.0

(assert (= expect result))

(check-sat)
(exit)
