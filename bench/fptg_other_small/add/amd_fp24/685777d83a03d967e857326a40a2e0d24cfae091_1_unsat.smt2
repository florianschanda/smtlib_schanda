                expect
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                expect
                (fp #b0 #b0011111 #b1010010111001111)))
; expect = -131072.0

(assert (not (= expect result)))

