;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0111100 #b0110100100010010)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1101100 #b0111110110100110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110001 #b0111000100101001)
                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1101001 #b0110101100111011)))
; arg2 = 0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011000 #b1101000011000100)
                expect
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                expect
                (fp #b0 #b1101001 #b1011010100111011)))
; expect = 0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(assert (= expect result))

(check-sat)
(exit)
