(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b1 #b0001001 #b0101010101101000)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b1010010111111011)
                expect
                (fp #b1 #b1011110 #b1111111111111101)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111101)
                expect
                (fp #b0 #b1110101 #b0001000100001011)))
; expect = -4294868992.0

(assert (not (= expect result)))

(check-sat)
(exit)
