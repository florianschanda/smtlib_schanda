(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110111 #b1100100010000010)
                expect
                (fp #b0 #b1011110 #b1111111111111110)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111110)
                expect
                (fp #b0 #b1111010 #b1010000101000101)))
; expect = 4294901760.0

(assert (not (= expect result)))

