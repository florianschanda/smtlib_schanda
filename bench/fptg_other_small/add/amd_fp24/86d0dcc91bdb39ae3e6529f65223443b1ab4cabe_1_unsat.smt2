(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100000 #b0100100001100101)
                expect
                (fp #b0 #b1010000 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1010000 #b0010101011110000)
                expect
                (fp #b0 #b1011111 #b0101101101010011)))
; expect = 153056.0

(assert (not (= expect result)))

(check-sat)
(exit)
