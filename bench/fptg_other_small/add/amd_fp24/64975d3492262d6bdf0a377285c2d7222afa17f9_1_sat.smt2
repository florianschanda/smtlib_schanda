                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b0 #b1100111 #b0100010101001000)))
; arg2 = -717963500751683584.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0010000111110111)
                expect
                (fp #b1 #b1111010 #b0011111011010110)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010110)
                expect
                (fp #b0 #b1010001 #b0001100100001010)))
; expect = -717954704658661376.0

(assert (= expect result))

(check-sat)
(exit)
