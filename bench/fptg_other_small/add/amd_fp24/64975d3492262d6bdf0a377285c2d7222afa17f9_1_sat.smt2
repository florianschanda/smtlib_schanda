;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b1100000011100001)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
