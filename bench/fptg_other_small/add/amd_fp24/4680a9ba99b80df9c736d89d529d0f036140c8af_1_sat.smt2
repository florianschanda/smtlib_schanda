(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1011110011110010)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1010111 #b1011101101110001)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b1100000010010111)
                arg2
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                arg2
                (fp #b0 #b0101010 #b0000000000001100)))
; arg2 = -0.0003445781767368316650390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101001 #b1000100101010011)
                expect
                (fp #b0 #b0111110 #b1111111111010010)))
(assert (fp.leq (fp #b0 #b0111110 #b1111111111010010)
                expect
                (fp #b0 #b1101010 #b0000011010000101)))
; expect = 0.9996490478515625

(assert (= expect result))

(check-sat)
(exit)
