; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001111 #b1111101101101111)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1011111 #b0001100001101011)))
; arg1 = 26078.0

