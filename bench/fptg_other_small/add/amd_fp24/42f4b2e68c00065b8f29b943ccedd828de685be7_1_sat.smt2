                arg2
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b0 #b0000111 #b1101100111100010)))
; arg2 = -59593208102912.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0100011100110001)
                expect
                (fp #b1 #b1101100 #b1011000110011000)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011000)
                expect
                (fp #b1 #b0000000 #b1110101110100100)))
; expect = -59592671232000.0

(assert (= expect result))

(check-sat)
(exit)
