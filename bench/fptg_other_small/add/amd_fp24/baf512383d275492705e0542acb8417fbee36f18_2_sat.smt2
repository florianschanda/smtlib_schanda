(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b1001001000100100)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b1 #b1011000 #b0001010000010101)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011011 #b0011100010001001)
                arg2
                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1011001 #b1001011001001001)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0011000100010001)
                expect
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                expect
                (fp #b1 #b0111101 #b1000001110011000)))
; expect = -4294934528.0

(assert (= expect result))

(check-sat)
(exit)
