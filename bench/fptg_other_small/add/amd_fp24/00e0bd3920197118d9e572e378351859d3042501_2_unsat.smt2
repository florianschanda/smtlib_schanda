(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111000 #b0111101001110100)
                expect
                (fp #b0 #b1001111 #b0010101011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110001)
                expect
                (fp #b0 #b1011100 #b1001111001011111)))
; expect = 76529.0

(assert (not (= expect result)))

