; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111011 #b1111101011101011)
                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1111101 #b0010110101111111)))
; arg1 = 76528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1000100110010100)
                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b0111010 #b0011001011010101)))
; arg2 = 0.00179137289524078369140625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101011 #b1001000101001011)
                expect
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                expect
                (fp #b0 #b1111110 #b1010011100110111)))
; expect = 76528.0

(assert (not (= expect result)))

(check-sat)
(exit)
