(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1001110 #b0101110010100000)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0110010011011001)
                expect
                (fp #b1 #b1001111 #b1111110001110100)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110100)
                expect
                (fp #b1 #b1001001 #b0010010100001001)))
; expect = -130164.0

(assert (= expect result))

(check-sat)
(exit)
