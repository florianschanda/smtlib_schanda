                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1101101 #b0111010101101000)))
; arg1 = 76528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1011111 #b1001001101001110)
                arg2
                (fp #b0 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000000000000)
                arg2
                (fp #b0 #b1111101 #b1001001001000100)))
; arg2 = 4611686018427387904.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101001 #b0111111010111111)
                expect
                (fp #b0 #b1111101 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000000000001)
                expect
                (fp #b0 #b1111101 #b1010111010111101)))
; expect = 4611756387171565568.0

(assert (= expect result))

(check-sat)
(exit)
