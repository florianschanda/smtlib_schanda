                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1110100 #b1100101110010100)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1000111001110011)
                arg2
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg2
                (fp #b1 #b0000111 #b0111111101000011)))
; arg2 = -4611686018427387904.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0111011101001011)
                expect
                (fp #b1 #b1111101 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000001)
                expect
                (fp #b1 #b1001011 #b1110110001000110)))
; expect = -4611756387171565568.0

(assert (= expect result))

(check-sat)
(exit)
