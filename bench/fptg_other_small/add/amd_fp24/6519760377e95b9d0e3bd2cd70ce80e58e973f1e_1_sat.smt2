(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b0101111000101110)
                expect
                (fp #b0 #b1100010 #b0010111010110110)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110110)
                expect
                (fp #b0 #b1101110 #b1101101000011101)))
; expect = 40629174272.0

(assert (= expect result))

(check-sat)
