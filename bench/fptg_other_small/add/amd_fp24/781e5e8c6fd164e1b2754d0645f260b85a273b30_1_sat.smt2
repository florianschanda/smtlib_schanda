                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1111001 #b1100111011111010)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111000 #b0010100110111101)
                expect
                (fp #b0 #b1010000 #b1000111011110000)))
(assert (fp.leq (fp #b0 #b1010000 #b1000111011110000)
                expect
                (fp #b0 #b1110001 #b0101001101010010)))
; expect = 204256.0

(assert (= expect result))

(check-sat)
(exit)
