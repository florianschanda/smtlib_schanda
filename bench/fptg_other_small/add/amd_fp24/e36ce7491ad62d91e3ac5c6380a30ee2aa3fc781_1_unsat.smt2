;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b0110100010111111)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b0000000 #b0011101010100010)))
; arg1 = -131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b1001010110101101)
                arg2
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b1 #b0100111 #b0010010000101101)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0101001111011101)
                expect
                (fp #b1 #b1011111 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1011111 #b0000000000000001)
                expect
                (fp #b0 #b1011000 #b1100000000010011)))
; expect = -4295032832.0

(assert (not (= expect result)))

(check-sat)
(exit)
