(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101000 #b0111001101101110)
                expect
                (fp #b0 #b1100111 #b1010000011110000)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110000)
                expect
                (fp #b0 #b1101110 #b0011011010011100)))
; expect = 1790732926976.0

(assert (not (= expect result)))

(check-sat)
