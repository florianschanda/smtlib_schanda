                arg2
                (fp #b0 #b0000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b1110001 #b1111100011101111)))
; arg2 = 0.00000000000000000006260764620291355865566718108539134846068918704986572265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000100 #b1000101010111001)
                expect
                (fp #b0 #b1001101 #b1001011101111001)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111001)
                expect
                (fp #b0 #b1010001 #b0111001010111011)))
; expect = 26078.25

(assert (= expect result))

(check-sat)
(exit)
