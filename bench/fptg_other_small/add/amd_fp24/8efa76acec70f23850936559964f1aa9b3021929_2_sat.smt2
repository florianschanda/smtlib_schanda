                arg2
                (fp #b0 #b1111001 #b1000101101001100)))
; arg2 = 40629698560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b1101001011111010)
                expect
                (fp #b0 #b1100010 #b0010111010111000)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010111000)
                expect
                (fp #b0 #b1100110 #b1110001001001000)))
; expect = 40630222848.0

(assert (= expect result))

(check-sat)
(exit)
