                arg2
                (fp #b0 #b1101111 #b0100010111100000)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1100010000000100)
                expect
                (fp #b1 #b1011110 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111110)
                expect
                (fp #b1 #b0011100 #b0001000010110110)))
; expect = -4294901760.0

(assert (not (= expect result)))

(check-sat)
(exit)
