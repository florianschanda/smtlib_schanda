                arg2
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0110011 #b0100011000001100)))
; arg2 = -0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001001 #b1110101001010101)
                expect
                (fp #b0 #b1001111 #b0010101011101111)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011101111)
                expect
                (fp #b0 #b1100110 #b1011110010101000)))
; expect = 76527.0

(assert (= expect result))

(check-sat)
(exit)
