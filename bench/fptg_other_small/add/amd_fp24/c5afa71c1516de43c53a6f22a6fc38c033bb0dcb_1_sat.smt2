; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b1100101001100010)
                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1100000 #b1001001010000111)))
; arg1 = 76528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0110110111101000)
                arg2
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0011011 #b0100101000111101)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010011 #b1110110001011010)
                expect
                (fp #b0 #b1001111 #b0010101011101111)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011101111)
                expect
                (fp #b0 #b1101101 #b0010010000111101)))
; expect = 76527.0

(assert (= expect result))

(check-sat)
(exit)
