(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b1101011000000010)
                expect
                (fp #b1 #b1010101 #b0001010110000101)))
(assert (fp.leq (fp #b1 #b1010101 #b0001010110000101)
                expect
                (fp #b0 #b1101011 #b0010101101000111)))
; expect = -4546880.0

(assert (= expect result))

(check-sat)
(exit)
