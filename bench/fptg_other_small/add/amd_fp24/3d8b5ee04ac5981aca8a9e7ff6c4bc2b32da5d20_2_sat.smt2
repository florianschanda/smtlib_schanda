                arg2
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1110001 #b0000100000111110)))
; arg2 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111110 #b1010000011100100)
                expect
                (fp #b0 #b1001101 #b1001011101111001)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111001)
                expect
                (fp #b0 #b1101111 #b1000111110011110)))
; expect = 26078.25

(assert (= expect result))

(check-sat)
(exit)
