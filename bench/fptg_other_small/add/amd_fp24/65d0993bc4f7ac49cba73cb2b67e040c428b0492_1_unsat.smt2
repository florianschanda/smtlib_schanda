                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1100011 #b0100101101101110)))
; arg2 = 1.63580322265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1101000010010000)
                expect
                (fp #b1 #b1001111 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b1001111 #b1111111111111110)
                expect
                (fp #b1 #b0100100 #b1100001101110011)))
; expect = -131070.0

(assert (not (= expect result)))

(check-sat)
(exit)
