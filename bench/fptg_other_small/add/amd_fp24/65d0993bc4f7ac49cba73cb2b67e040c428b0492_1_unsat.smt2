(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0110001110000000)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
