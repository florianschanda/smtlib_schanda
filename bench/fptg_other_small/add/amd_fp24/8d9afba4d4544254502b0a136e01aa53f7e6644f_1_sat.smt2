                arg2
                (fp #b0 #b0111011 #b1011111110110100)))
; arg2 = 0.000000000001818989403545856475830078125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011111 #b0001000000100000)
                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1010100 #b1001001101000011)))
; expect = 1.0

(assert (= expect result))

(check-sat)
