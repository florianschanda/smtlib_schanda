(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001111 #b0001011100001100)
                expect
                (fp #b0 #b1011110 #b1000001001011011)))
(assert (fp.leq (fp #b0 #b1011110 #b1000001001011011)
                expect
