(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b0110100111110011)
                expect
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                expect
                (fp #b0 #b0111011 #b0010111101011001)))
; expect = -14354451791872.0

(assert (= expect result))

(check-sat)
