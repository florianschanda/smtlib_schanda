                arg2
                (fp #b1 #b1010111 #b0100010010011001)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b1110110010100101)
                expect
                (fp #b1 #b1011100 #b1111011010001111)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001111)
                expect
                (fp #b0 #b1000010 #b0101001001001100)))
; expect = -1053941760.0

(assert (= expect result))

(check-sat)
