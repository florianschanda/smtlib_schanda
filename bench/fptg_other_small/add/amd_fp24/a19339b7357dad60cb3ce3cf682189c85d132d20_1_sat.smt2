(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1000101 #b1011100001101110)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b0000100 #b1100111100110110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0001011100010000)
                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b0 #b0011000 #b1110000010000100)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b0011000101010011)
                expect
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                expect
                (fp #b1 #b0000101 #b0100011100101101)))
; expect = -13798144.0

(assert (= expect result))

(check-sat)
(exit)
