                arg2
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg2
                (fp #b1 #b1010010 #b0100001010101011)))
; arg2 = -4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b0111111101101010)
                expect
                (fp #b1 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1011111 #b0000000000000000)
                expect
                (fp #b1 #b1010101 #b1100100110010110)))
; expect = -4294967296.0

(assert (= expect result))

(check-sat)
(exit)
