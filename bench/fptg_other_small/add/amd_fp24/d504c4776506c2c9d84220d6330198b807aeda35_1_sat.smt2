(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111001 #b1110111001100100)
                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1011111 #b0111011011001011)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0010101100111111)
                expect
                (fp #b0 #b1001111 #b1111001011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110000)
                expect
                (fp #b0 #b1010000 #b0101100110011010)))
; expect = 127728.0

(assert (= expect result))

(check-sat)
(exit)
