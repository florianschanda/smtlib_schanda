; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100100 #b101100100001000)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b00000001 #b100011000010100)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000010 #b111100001111000)
                arg2
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b00010010 #b010000110001010)))
; arg2 = -0.000000000000000000000000000000000000002003520492353050455323911609004590487859267314017367189827385949574267698380936053581535816192626953125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001101 #b111101100010000)
                expect
                (fp #b1 #b10001010 #b001010101000001)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000001)
                expect
                (fp #b1 #b01000110 #b001001100001001)))
; expect = -2388.0625

(assert (= expect result))

(check-sat)
(exit)
