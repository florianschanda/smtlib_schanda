                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b10100001 #b110101100011001)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111011 #b001111011110011)
                expect
                (fp #b0 #b10001100 #b010011110011110)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110011110)
                expect
                (fp #b0 #b10011110 #b101101011100110)))
; expect = 10727.5

(assert (= expect result))

(check-sat)
(exit)
