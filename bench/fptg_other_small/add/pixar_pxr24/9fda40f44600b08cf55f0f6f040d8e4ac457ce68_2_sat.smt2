                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b10100111 #b101110100010110)))
; arg2 = 5679104.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01110011 #b001000110110011)
                expect
                (fp #b0 #b10010101 #b010110101010001)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010001)
                expect
                (fp #b0 #b11111010 #b110110000001001)))
; expect = 5679232.0

(assert (= expect result))

