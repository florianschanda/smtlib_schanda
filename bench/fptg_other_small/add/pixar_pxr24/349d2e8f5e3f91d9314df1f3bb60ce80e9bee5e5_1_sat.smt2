(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110000 #b110000111111001)
                arg1
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg1
                (fp #b1 #b10000010 #b101100010111101)))
; arg1 = -65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111111 #b001000110100010)
                arg2
                (fp #b0 #b00000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b00000000 #b100100100100110)
                arg2
                (fp #b0 #b00000111 #b100101011101001)))
; arg2 = 0.00000000000000000000000000000000000000671762305099431026435014660523186418543467139163638639153225233513477832048010895960032939910888671875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101111 #b000111110010111)
                expect
                (fp #b1 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b10011110 #b111000100011010)))
; expect = -65535.0

(assert (= expect result))

(check-sat)
(exit)
