                arg2
                (fp #b0 #b01110010 #b001010100011100)))
; arg2 = -0.000000000000000000000000000000000000011754584775816007926517208897449134559657047820663754827049947253303496808030104148201644420623779296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011100 #b011111010011110)
                expect
                (fp #b0 #b10001110 #b100100011101011)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101011)
                expect
                (fp #b0 #b10100101 #b100100000111010)))
; expect = 51435.0

(assert (= expect result))

(check-sat)
