(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001011 #b001010110011000)
                expect
                (fp #b0 #b10001111 #b010000011101110)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101110)
                expect
                (fp #b0 #b11011001 #b111111001001101)))
; expect = 82396.0

(assert (= expect result))

(check-sat)
