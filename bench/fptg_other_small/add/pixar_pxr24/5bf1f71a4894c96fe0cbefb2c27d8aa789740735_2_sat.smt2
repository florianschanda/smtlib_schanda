; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100000 #b000001000011000)
                arg1
                (fp #b1 #b00000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b00000000 #b100101111110110)
                arg1
                (fp #b0 #b11001000 #b111110110110000)))
; arg1 = -0.00000000000000000000000000000000000000697591038393866054686280844202386152675224927276306577858251516122134461284076678566634654998779296875

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000110 #b011110111101110)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b0 #b01010110 #b000111001001111)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010000 #b001110010001010)
                expect
                (fp #b1 #b10001110 #b100101100101101)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101101)
                expect
                (fp #b1 #b01011101 #b001101111101111)))
; expect = -52013.0

(assert (= expect result))

(check-sat)
(exit)
