(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg2
                (fp #b1 #b01110110 #b010101100000011)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110011 #b000001110101111)
                expect
                (fp #b1 #b01111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b01111110 #b111111111111111)
                expect
                (fp #b1 #b00111101 #b001010000011010)))
; expect = -0.9999847412109375

(assert (= expect result))

(check-sat)
(exit)
