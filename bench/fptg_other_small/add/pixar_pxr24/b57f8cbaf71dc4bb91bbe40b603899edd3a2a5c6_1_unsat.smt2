(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b10100011 #b110010011110001)))
; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b110010110111111)
                expect
                (fp #b0 #b10010000 #b001000001110110)))
(assert (fp.leq (fp #b0 #b10010000 #b001000001110110)
                expect
                (fp #b0 #b11000000 #b110001000111011)))
; expect = 147928.0

(assert (not (= expect result)))

(check-sat)
(exit)
