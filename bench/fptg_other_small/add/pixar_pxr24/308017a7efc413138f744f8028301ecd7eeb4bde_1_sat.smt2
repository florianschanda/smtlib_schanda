                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b00110110 #b100100011010011)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b001101011011001)
                expect
                (fp #b1 #b10010000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10010000 #b000000000000000)
                expect
                (fp #b1 #b00111101 #b110101101011010)))
; expect = -131072.0

(assert (= expect result))

(check-sat)
(exit)
