; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00111101 #b101001011110100)
                arg1
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                arg1
                (fp #b0 #b11001101 #b110010101110000)))
; arg1 = 35973.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00011011 #b100000101111010)
                arg2
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b11110100 #b000000010010100)))
; arg2 = 0.000000000000000000000000000000000000011754584775816007926517208897449134559657047820663754827049947253303496808030104148201644420623779296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001001 #b111000010110111)
                expect
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                expect
                (fp #b0 #b11100001 #b000011111111101)))
; expect = 35973.0

(assert (= expect result))

(check-sat)
(exit)
