(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001100 #b110011001010011)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b10111110 #b010100111100100)))
; arg1 = 51436.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00000011 #b110010101101101)
                arg2
                (fp #b0 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b10111000 #b110110000011101)))
; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110011 #b110110011110101)
                expect
                (fp #b0 #b10010000 #b000001010110010)))
(assert (fp.leq (fp #b0 #b10010000 #b000001010110010)
                expect
                (fp #b0 #b11110101 #b110010100111100)))
; expect = 133832.0

(assert (= expect result))

(check-sat)
(exit)
