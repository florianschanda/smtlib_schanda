                expect
                (fp #b0 #b10111110 #b111111111111110)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111110)
                expect
                (fp #b0 #b11000111 #b100000111010011)))
; expect = 18446181123756130304.0

(assert (= expect result))

