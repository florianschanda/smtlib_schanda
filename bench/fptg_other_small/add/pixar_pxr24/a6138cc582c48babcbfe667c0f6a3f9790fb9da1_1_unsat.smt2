(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b00010000 #b000001110111011)))
; arg2 = -0.000000000000000000000000000000000000010253648385483839062582518445868972231778234133672051277857864386156006020200948114506900310516357421875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00011011 #b111101001100101)
                expect
                (fp #b0 #b01111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b01111110 #b111111111111111)
                expect
                (fp #b0 #b10010000 #b000110111000110)))
; expect = 0.9999847412109375

(assert (not (= expect result)))

