; arg2 = 0.00000000000000000000059894338697374774189399922186272107182958279736340045928955078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010100 #b110101011100011)
                expect
                (fp #b1 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b11000111 #b110100001101111)))
; expect = -65535.0

(assert (= expect result))

