(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                arg2
                (fp #b0 #b00101000 #b011101011111101)))
; arg2 = -1106900345914654720.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111010 #b110101111000110)
                expect
                (fp #b1 #b10111010 #b111010111001001)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001001)
                expect
                (fp #b0 #b11010110 #b010010000000010)))
; expect = -1106917938100699136.0

(assert (= expect result))

(check-sat)
(exit)
