(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011011 #b010101110000011)
                expect
                (fp #b1 #b10001110 #b011110011001110)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001110)
                expect
                (fp #b0 #b10101000 #b111111111011111)))
; expect = -48334.0

(assert (= expect result))

