(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b1 #b01111101 #b000000111000011)))
; arg2 = -60693.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b110000000101101)
                expect
                (fp #b1 #b10001110 #b110110100010100)))
