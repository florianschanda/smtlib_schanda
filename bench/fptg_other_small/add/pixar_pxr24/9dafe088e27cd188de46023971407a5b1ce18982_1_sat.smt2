(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011101 #b111010011010001)
                arg1
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11100111 #b100000001110101)))
; arg1 = -65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b111000100010001)
                arg2
                (fp #b0 #b00011100 #b101010110010010)))
(assert (fp.leq (fp #b0 #b00011100 #b101010110010010)
                arg2
                (fp #b0 #b00111010 #b001010011111101)))
; arg2 = 0.00000000000000000000000000000263245734448569332574956345082220790534380423786320335466371034272015094757080078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010000 #b110011011101000)
                expect
                (fp #b1 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b10111011 #b100111100000101)))
; expect = -65535.0

(assert (= expect result))

(check-sat)
(exit)
