                arg2
                (fp #b0 #b11100001 #b101010100011000)))
; arg2 = 1.040771484375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011101 #b110001000010100)
                expect
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b11000001 #b111111000101000)))
; expect = 65536.0

(assert (not (= expect result)))

(check-sat)
