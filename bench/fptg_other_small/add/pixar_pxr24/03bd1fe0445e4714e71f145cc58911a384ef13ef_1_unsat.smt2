(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b01111000 #b110011110101011)))
; arg2 = -0.000000000000000000000000000000000000011754584775816007926517208897449134559657047820663754827049947253303496808030104148201644420623779296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111011 #b011001101101101)
                expect
                (fp #b0 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b10011000 #b101101100110010)))
; expect = 65535.0

(assert (not (= expect result)))

(check-sat)
