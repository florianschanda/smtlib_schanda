; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001100 #b011111111010100)
                arg2
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b10011101 #b110010101111000)))
