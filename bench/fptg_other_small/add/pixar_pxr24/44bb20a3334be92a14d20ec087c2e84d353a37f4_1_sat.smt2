(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11111000 #b101010110001110)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b10110011 #b011110101001010)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b001001001100100)
                arg2
                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                arg2
                (fp #b1 #b01110000 #b010101110110100)))
; arg2 = -1106900345914654720.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100101 #b100100011100111)
                expect
                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                expect
                (fp #b0 #b11010111 #b100101000000111)))
; expect = -1106900345914654720.0

(assert (= expect result))

(check-sat)
(exit)
