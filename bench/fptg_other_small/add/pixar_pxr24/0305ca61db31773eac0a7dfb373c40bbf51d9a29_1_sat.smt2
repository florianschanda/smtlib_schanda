(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b000101100011100)
                expect
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                expect
                (fp #b1 #b01000100 #b011111001000100)))
; expect = -18446462598732840960.0

(assert (= expect result))

(check-sat)
(exit)
