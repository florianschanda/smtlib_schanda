                arg2
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                arg2
                (fp #b0 #b11110001 #b100101011001001)))
; arg2 = 8115.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111101 #b000101000010000)
                expect
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                expect
                (fp #b0 #b11101111 #b100111000010010)))
; expect = 8115.0

(assert (= expect result))

(check-sat)
(exit)
