                arg2
                (fp #b0 #b11001000 #b101111011011010)))
; arg2 = -0.00000000000000000018946406494404588287394641810124085168354213237762451171875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110001 #b001000001111010)
                expect
                (fp #b1 #b01000000 #b101111110101110)))
(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                expect
                (fp #b0 #b01011011 #b010000111000000)))
; expect = -0.00000000000000000018946406494404588287394641810124085168354213237762451171875

(assert (= expect result))

(check-sat)
