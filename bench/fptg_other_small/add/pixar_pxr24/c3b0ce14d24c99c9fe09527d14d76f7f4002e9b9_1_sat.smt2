; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
