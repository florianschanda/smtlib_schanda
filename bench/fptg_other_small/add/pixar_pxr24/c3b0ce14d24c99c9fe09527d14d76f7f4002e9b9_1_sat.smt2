                arg2
                (fp #b0 #b01111111 #b001111010011110)))
(assert (fp.leq (fp #b0 #b01111111 #b001111010011110)
                arg2
                (fp #b0 #b10010100 #b111111010001000)))
; arg2 = 1.23919677734375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111010 #b100001010001111)
                expect
                (fp #b1 #b10001010 #b001010100101100)))
(assert (fp.leq (fp #b1 #b10001010 #b001010100101100)
                expect
                (fp #b1 #b10000101 #b100111111001001)))
; expect = -2386.75

(assert (= expect result))

(check-sat)
(exit)
