; Format: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01101111 #b111101000011011)
                arg1
                (fp #b0 #b10100010 #b010100010011111)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011111)
                arg1
                (fp #b0 #b11001101 #b110000110011110)))
; arg1 = 45263880192.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100001 #b100111010000000)
                arg2
                (fp #b0 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b10011100 #b110011011000010)))
; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011110 #b000011101111001)
                expect
                (fp #b0 #b10100010 #b010100010011111)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011111)
                expect
                (fp #b0 #b11101011 #b100010000011111)))
; expect = 45263880192.0

(assert (= expect result))

(check-sat)
(exit)
