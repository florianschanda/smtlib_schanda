                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b01001010 #b000111011111000)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011110 #b111010001010101)
                expect
                (fp #b1 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b11001111 #b010010000001110)))
; expect = -65538.0

(assert (= expect result))

(check-sat)
