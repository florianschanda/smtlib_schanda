                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b11111010 #b101011100110010)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00000000 #b010011001001111)
                expect
                (fp #b0 #b10001100 #b010011110011101)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110011101)
                expect
                (fp #b0 #b11010011 #b011010100000000)))
; expect = 10727.25

(assert (= expect result))

(check-sat)
(exit)
