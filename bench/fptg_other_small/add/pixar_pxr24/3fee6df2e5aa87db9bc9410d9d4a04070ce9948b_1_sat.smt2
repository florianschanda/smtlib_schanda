                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b01010000 #b101101011111000)))
; arg2 = -0.00000000000000000000059894338697374774189399922186272107182958279736340045928955078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100011 #b010101011110001)
                expect
                (fp #b0 #b01111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b01111110 #b111111111111111)
                expect
                (fp #b0 #b11010011 #b011001100000110)))
; expect = 0.9999847412109375

(assert (= expect result))

(check-sat)
(exit)
