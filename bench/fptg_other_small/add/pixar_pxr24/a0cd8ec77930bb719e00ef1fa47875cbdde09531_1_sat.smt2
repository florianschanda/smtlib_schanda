                arg2
                (fp #b1 #b10000110 #b011101001111000)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100010 #b111101111101001)
                expect
                (fp #b1 #b10100010 #b011111011001111)))
