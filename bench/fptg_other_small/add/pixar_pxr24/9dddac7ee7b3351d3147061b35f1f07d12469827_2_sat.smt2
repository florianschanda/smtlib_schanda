(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001010 #b111101000011100)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11100010 #b011011100000010)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000001 #b110000000101111)
                arg2
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b10001110 #b001010111101000)))
; arg2 = 0.00000000000000000000059894338697374774189399922186272107182958279736340045928955078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010000 #b001110111011100)
                expect
                (fp #b0 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b10011111 #b011000101001001)))
; expect = 65538.0

(assert (= expect result))

(check-sat)
(exit)
