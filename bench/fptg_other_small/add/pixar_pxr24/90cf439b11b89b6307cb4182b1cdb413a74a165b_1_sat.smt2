                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b0 #b01101100 #b011100111110111)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110100 #b010101110111111)
                expect
                (fp #b1 #b10100010 #b011111011001111)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011001111)
                expect
                (fp #b0 #b11000110 #b000000011101001)))
; expect = -51219791872.0

(assert (= expect result))

