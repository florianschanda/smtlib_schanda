(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001010 #b000001100000100)
                expect
                (fp #b1 #b01111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b01111110 #b111111111111111)
                expect
                (fp #b0 #b01011110 #b100100000111110)))
; expect = -0.9999847412109375

(assert (= expect result))

