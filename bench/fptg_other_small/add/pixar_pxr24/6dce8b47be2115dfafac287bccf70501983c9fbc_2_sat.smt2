                (fp #b1 #b01000000 #b101111110101110)))
(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                arg2
                (fp #b0 #b00110110 #b010011110011011)))
; arg2 = -0.00000000000000000018946406494404588287394641810124085168354213237762451171875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100011 #b110110101011101)
                expect
                (fp #b1 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b11001000 #b001000100111111)))
; expect = -65538.0

(assert (= expect result))

(check-sat)
(exit)
