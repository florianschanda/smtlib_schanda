                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b0 #b00101001 #b111001101010100)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101110 #b000000111100111)
                expect
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                expect
                (fp #b0 #b00101101 #b000110111010011)))
; expect = -51220840448.0

(assert (= expect result))

(check-sat)
(exit)
