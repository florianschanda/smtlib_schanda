;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001110 #b000010101011001)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
