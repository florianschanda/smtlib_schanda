                arg2
                (fp #b0 #b11010111 #b011001001010101)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10000111 #b000010011000010)
                expect
                (fp #b0 #b10001100 #b010011110100011)))
