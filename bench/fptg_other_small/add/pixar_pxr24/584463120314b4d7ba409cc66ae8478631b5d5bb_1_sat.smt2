;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000110 #b101010000000011)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
