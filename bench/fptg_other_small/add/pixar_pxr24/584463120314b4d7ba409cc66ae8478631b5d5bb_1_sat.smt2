                arg2
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b11010100 #b010100000111001)))
; arg2 = 65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101101 #b110100111010111)
                expect
                (fp #b0 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b10010110 #b001101101001000)))
; expect = 65535.0

(assert (= expect result))

(check-sat)
