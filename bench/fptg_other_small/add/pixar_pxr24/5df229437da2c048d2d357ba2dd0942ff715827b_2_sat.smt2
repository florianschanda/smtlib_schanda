(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg2
                (fp #b0 #b11010100 #b010100101001000)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
