;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b000100011010111)
                arg1
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                arg1
                (fp #b0 #b00001001 #b010100110010001)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000101 #b001011111101100)
                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b10100000 #b101001100011001)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b011111001000100)
                expect
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                expect
                (fp #b1 #b10111001 #b010101110110011)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
