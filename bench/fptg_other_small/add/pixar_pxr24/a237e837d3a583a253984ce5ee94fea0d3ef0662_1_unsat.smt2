                arg2
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b01101101 #b000101010111110)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010101 #b100111011101110)
                expect
                (fp #b0 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                expect
                (fp #b0 #b11001110 #b011001110101011)))
; expect = 18446462598732840960.0

(assert (not (= expect result)))

(check-sat)
(exit)
