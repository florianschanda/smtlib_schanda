; Format: PIXAR_PXR24
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000000 #b110001000100100)
                arg1
                (fp #b0 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000000000000)
                arg1
                (fp #b0 #b11001011 #b101000110111001)))
; arg1 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101100 #b100111110011010)
                arg2
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg2
                (fp #b0 #b10010011 #b111001110011010)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b110010101011011)
                expect
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b11001011 #b011110011100100)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
