; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111110 #b110101110111000)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b00000011 #b000000010101011)))
; arg1 = 0.000000000000000000000000000000000000011443922511469053281161701743752093313016738869197498786514492243038265684162979596294462680816650390625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b11100000 #b101000110011000)
                arg2
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                arg2
                (fp #b0 #b11111111 #b000000000000000)))
; arg2 = 340277174624079928635746076935438991360.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
