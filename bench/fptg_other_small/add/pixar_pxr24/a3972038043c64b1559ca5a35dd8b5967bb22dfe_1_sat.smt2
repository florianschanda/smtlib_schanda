; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00000111 #b111100100011101)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b10101110 #b000111111110100)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111010 #b001100111001111)
                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b00100100 #b101000001010100)))
; arg2 = -0.00000000000000000000059894338697374774189399922186272107182958279736340045928955078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011110 #b001101101000010)
                expect
                (fp #b0 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b11000111 #b000001010101101)))
; expect = 65535.0

(assert (= expect result))

(check-sat)
(exit)
