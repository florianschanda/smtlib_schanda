(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010000 #b001100011001000)
                expect
                (fp #b1 #b11000110 #b011000101111001)))
(assert (fp.leq (fp #b1 #b11000110 #b011000101111001)
                expect
                (fp #b1 #b01101101 #b011011110101100)))
; expect = -3273792669925179916288.0

(assert (= expect result))

(check-sat)
