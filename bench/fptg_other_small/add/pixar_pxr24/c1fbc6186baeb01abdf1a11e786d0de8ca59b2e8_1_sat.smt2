(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11001100 #b011000000101101)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b10001001 #b110111011011000)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101010 #b101111000111001)
                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b11000010 #b111111000100010)))
; arg2 = 1536361341386752.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110010 #b001010011100000)
                expect
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                expect
                (fp #b0 #b11111100 #b000001111011101)))
; expect = 1536361341386752.0

(assert (= expect result))

(check-sat)
(exit)
