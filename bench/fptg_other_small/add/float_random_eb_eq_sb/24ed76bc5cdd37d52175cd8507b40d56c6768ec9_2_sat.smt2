(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b01001)
                arg1
                (fp #b1 #b101110 #b11111)))
(assert (fp.leq (fp #b1 #b101110 #b11111)
                arg1
                (fp #b1 #b011111 #b10010)))
; arg1 = -64512.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010010 #b11001)
                arg2
                (fp #b1 #b000000 #b10110)))
(assert (fp.leq (fp #b1 #b000000 #b10110)
                arg2
                (fp #b0 #b010101 #b01111)))
; arg2 = -0.0000000006402842700481414794921875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b00100)
                expect
                (fp #b1 #b101111 #b00000)))
(assert (fp.leq (fp #b1 #b101111 #b00000)
                expect
                (fp #b1 #b100111 #b01101)))
; expect = -65536.0

(assert (= expect result))

(check-sat)
(exit)
