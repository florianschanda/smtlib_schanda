(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                arg1
                (fp #b1 #b1011 #b111)))
(assert (fp.leq (fp #b1 #b1011 #b111)
                arg1
                (fp #b0 #b0110 #b011)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b011)
                arg2
                (fp #b0 #b0000 #b011)))
(assert (fp.leq (fp #b0 #b0000 #b011)
                arg2
                (fp #b0 #b1011 #b110)))
; arg2 = 0.005859375

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b011)
                expect
                (fp #b1 #b1011 #b110)))
(assert (fp.leq (fp #b1 #b1011 #b110)
                expect
                (fp #b1 #b0010 #b101)))
; expect = -28.0

(assert (= expect result))

(check-sat)
(exit)
