(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100010 #b01001)
                arg1
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                arg1
                (fp #b0 #b011110 #b01110)))
; arg1 = -1.6875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b11101)
                arg2
                (fp #b1 #b010000 #b00000)))
(assert (fp.leq (fp #b1 #b010000 #b00000)
                arg2
                (fp #b1 #b001010 #b00001)))
; arg2 = -0.000030517578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b11100)
                expect
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                expect
                (fp #b1 #b011001 #b11010)))
; expect = -1.6875

(assert (= expect result))

(check-sat)
(exit)
