; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b0011)
                arg1
                (fp #b0 #b10011 #b0110)))
(assert (fp.leq (fp #b0 #b10011 #b0110)
                arg1
                (fp #b0 #b11001 #b0100)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1101)
                arg2
                (fp #b1 #b11110 #b0011)))
(assert (fp.leq (fp #b1 #b11110 #b0011)
                arg2
                (fp #b1 #b01111 #b1011)))
; arg2 = -38912.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0111)
                expect
                (fp #b1 #b11110 #b0010)))
(assert (fp.leq (fp #b1 #b11110 #b0010)
                expect
                (fp #b1 #b11001 #b0001)))
; expect = -36864.0

(assert (= expect result))

(check-sat)
(exit)
