                arg2
                (fp #b0 #b01101 #b0100)))
; arg2 = 0.00054931640625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1000)
                expect
                (fp #b0 #b00100 #b0001)))
(assert (fp.leq (fp #b0 #b00100 #b0001)
                expect
                (fp #b0 #b11101 #b1011)))
; expect = 0.000518798828125

(assert (not (= expect result)))

