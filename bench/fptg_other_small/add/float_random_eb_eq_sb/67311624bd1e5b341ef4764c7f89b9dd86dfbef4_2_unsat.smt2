(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0000 #b111)
                arg1
                (fp #b0 #b1011 #b010)))
(assert (fp.leq (fp #b0 #b1011 #b010)
                arg1
                (fp #b0 #b1101 #b111)))
; arg1 = 20.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b101)
                arg2
                (fp #b1 #b0000 #b111)))
(assert (fp.leq (fp #b1 #b0000 #b111)
                arg2
                (fp #b0 #b1000 #b101)))
; arg2 = -0.013671875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0010 #b001)
                expect
                (fp #b0 #b1011 #b010)))
(assert (fp.leq (fp #b0 #b1011 #b010)
                expect
                (fp #b0 #b1110 #b000)))
; expect = 20.0

(assert (not (= expect result)))

(check-sat)
(exit)
