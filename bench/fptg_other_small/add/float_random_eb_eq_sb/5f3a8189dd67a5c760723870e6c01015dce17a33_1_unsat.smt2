; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001010 #b10000)
                arg1
                (fp #b0 #b100111 #b11001)))
(assert (fp.leq (fp #b0 #b100111 #b11001)
                arg1
                (fp #b0 #b101001 #b01110)))
; arg1 = 456.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b11100)
                arg2
                (fp #b1 #b101111 #b01111)))
(assert (fp.leq (fp #b1 #b101111 #b01111)
                arg2
                (fp #b1 #b100100 #b00100)))
; arg2 = -96256.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b01100)
                expect
                (fp #b1 #b101111 #b01110)))
(assert (fp.leq (fp #b1 #b101111 #b01110)
                expect
                (fp #b0 #b110010 #b10000)))
; expect = -94208.0

(assert (not (= expect result)))

(check-sat)
(exit)
