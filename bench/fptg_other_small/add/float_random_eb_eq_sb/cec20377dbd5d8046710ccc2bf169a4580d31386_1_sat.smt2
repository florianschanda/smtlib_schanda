; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010100 #b10100)
                arg1
                (fp #b0 #b011111 #b00111)))
(assert (fp.leq (fp #b0 #b011111 #b00111)
                arg1
                (fp #b0 #b101100 #b01101)))
; arg1 = 1.21875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000110 #b10011)
                arg2
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                arg2
                (fp #b0 #b111011 #b01110)))
; arg2 = -0.00000000002910383045673370361328125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011010 #b10000)
                expect
                (fp #b0 #b011111 #b00110)))
(assert (fp.leq (fp #b0 #b011111 #b00110)
                expect
                (fp #b0 #b111101 #b00101)))
; expect = 1.1875

(assert (= expect result))

(check-sat)
(exit)
