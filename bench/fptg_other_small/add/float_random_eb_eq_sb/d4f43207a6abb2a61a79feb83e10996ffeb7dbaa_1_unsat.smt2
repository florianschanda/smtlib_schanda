(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0101)
                arg1
                (fp #b1 #b01111 #b1010)))
(assert (fp.leq (fp #b1 #b01111 #b1010)
                arg1
                (fp #b0 #b11110 #b0101)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b1110)
                arg2
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg2
                (fp #b0 #b11101 #b1101)))
; arg2 = 16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b0001)
                expect
                (fp #b0 #b11100 #b1111)))
(assert (fp.leq (fp #b0 #b11100 #b1111)
                expect
                (fp #b0 #b11101 #b0101)))
; expect = 15872.0

(assert (not (= expect result)))

(check-sat)
(exit)
