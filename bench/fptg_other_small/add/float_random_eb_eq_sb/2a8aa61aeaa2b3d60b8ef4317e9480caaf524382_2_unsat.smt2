(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b11011)
                arg1
                (fp #b1 #b111001 #b10100)))
(assert (fp.leq (fp #b1 #b111001 #b10100)
                arg1
                (fp #b0 #b011010 #b10000)))
; arg1 = -109051904.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011100 #b00101)
                arg2
                (fp #b0 #b101010 #b10000)))
(assert (fp.leq (fp #b0 #b101010 #b10000)
                arg2
                (fp #b0 #b110101 #b11100)))
; arg2 = 3072.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b00101)
                expect
                (fp #b1 #b111001 #b10100)))
(assert (fp.leq (fp #b1 #b111001 #b10100)
                expect
                (fp #b0 #b000001 #b01101)))
; expect = -109051904.0

(assert (not (= expect result)))

(check-sat)
(exit)
