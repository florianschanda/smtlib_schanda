; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b1101)
                arg1
                (fp #b1 #b01111 #b1010)))
(assert (fp.leq (fp #b1 #b01111 #b1010)
                arg1
                (fp #b0 #b11110 #b1010)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0101)
                arg2
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                arg2
                (fp #b0 #b11110 #b1011)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b1001)
                expect
                (fp #b1 #b01110 #b0100)))
(assert (fp.leq (fp #b1 #b01110 #b0100)
                expect
                (fp #b0 #b11110 #b1001)))
; expect = -0.625

(assert (not (= expect result)))

(check-sat)
(exit)
