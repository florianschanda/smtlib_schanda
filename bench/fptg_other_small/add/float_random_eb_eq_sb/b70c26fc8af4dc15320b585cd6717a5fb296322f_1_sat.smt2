(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100001 #b00100)
                arg1
                (fp #b1 #b010000 #b11111)))
(assert (fp.leq (fp #b1 #b010000 #b11111)
                arg1
                (fp #b1 #b001110 #b10000)))
; arg1 = -0.00006008148193359375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001110 #b00001)
                arg2
                (fp #b0 #b100011 #b00110)))
(assert (fp.leq (fp #b0 #b100011 #b00110)
                arg2
                (fp #b0 #b110000 #b10011)))
; arg2 = 19.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011100 #b01110)
                expect
                (fp #b0 #b100011 #b00101)))
(assert (fp.leq (fp #b0 #b100011 #b00101)
                expect
                (fp #b0 #b110111 #b10011)))
; expect = 18.5

(assert (= expect result))

(check-sat)
(exit)
