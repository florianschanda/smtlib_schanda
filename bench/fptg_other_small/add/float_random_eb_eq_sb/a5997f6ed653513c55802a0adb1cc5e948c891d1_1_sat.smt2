(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0010)
                arg1
                (fp #b1 #b10010 #b1110)))
(assert (fp.leq (fp #b1 #b10010 #b1110)
                arg1
                (fp #b1 #b01011 #b0010)))
; arg1 = -15.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0000)
                arg2
                (fp #b0 #b00000 #b0111)))
(assert (fp.leq (fp #b0 #b00000 #b0111)
                arg2
                (fp #b0 #b11001 #b0100)))
; arg2 = 0.000026702880859375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1101)
                expect
                (fp #b1 #b10010 #b1101)))
(assert (fp.leq (fp #b1 #b10010 #b1101)
                expect
                (fp #b0 #b10101 #b0011)))
; expect = -14.5

(assert (= expect result))

(check-sat)
(exit)
