(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b100100 #b11000)
                arg1
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg1
                (fp #b0 #b011011 #b00111)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b01111)
                arg2
                (fp #b1 #b101110 #b11111)))
(assert (fp.leq (fp #b1 #b101110 #b11111)
                arg2
                (fp #b0 #b101010 #b11110)))
; arg2 = -64512.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b11001)
                expect
                (fp #b1 #b101110 #b11111)))
(assert (fp.leq (fp #b1 #b101110 #b11111)
                expect
                (fp #b0 #b010100 #b00011)))
; expect = -64512.0

(assert (not (= expect result)))

(check-sat)
(exit)
