(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00100 #b0010)
                arg1
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                arg1
                (fp #b0 #b11101 #b1000)))
; arg1 = 5120.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1010)
                arg2
                (fp #b0 #b00000 #b1111)))
(assert (fp.leq (fp #b0 #b00000 #b1111)
                arg2
                (fp #b0 #b01001 #b0100)))
; arg2 = 0.000057220458984375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0000)
                expect
                (fp #b0 #b11011 #b0101)))
(assert (fp.leq (fp #b0 #b11011 #b0101)
                expect
                (fp #b0 #b11100 #b1011)))
; expect = 5376.0

(assert (= expect result))

(check-sat)
(exit)
