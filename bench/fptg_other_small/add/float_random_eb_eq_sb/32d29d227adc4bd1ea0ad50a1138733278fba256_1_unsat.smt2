(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b010 #b00)
                arg1
                (fp #b0 #b101 #b10)))
(assert (fp.leq (fp #b0 #b101 #b10)
                arg1
                (fp #b0 #b110 #b00)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg2
                (fp #b1 #b000 #b10)))
(assert (fp.leq (fp #b1 #b000 #b10)
                arg2
                (fp #b1 #b000 #b00)))
; arg2 = -0.125

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b000 #b10)
                expect
                (fp #b0 #b101 #b01)))
(assert (fp.leq (fp #b0 #b101 #b01)
                expect
                (fp #b0 #b101 #b11)))
; expect = 5.0

(assert (not (= expect result)))

(check-sat)
(exit)
