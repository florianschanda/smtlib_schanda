                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                arg2
                (fp #b0 #b1101111 #b001010)))
; arg2 = 4261412864.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101010 #b001110)
                expect
                (fp #b0 #b1011110 #b111110)))
(assert (fp.leq (fp #b0 #b1011110 #b111110)
                expect
                (fp #b0 #b1101011 #b101101)))
; expect = 4227858432.0

(assert (= expect result))

