(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101010 #b100000)
                arg1
                (fp #b1 #b0111111 #b111101)))
(assert (fp.leq (fp #b1 #b0111111 #b111101)
                arg1
                (fp #b0 #b1000100 #b001100)))
; arg1 = -1.953125

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0101010 #b011101)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b0100110 #b110111)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
