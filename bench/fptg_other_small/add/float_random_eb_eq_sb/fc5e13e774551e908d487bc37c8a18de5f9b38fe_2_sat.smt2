(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b001 #b11)))
; arg1 = -0.0625

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b00)
                arg2
                (fp #b1 #b011 #b10)))
(assert (fp.leq (fp #b1 #b011 #b10)
                arg2
                (fp #b0 #b100 #b10)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                expect
                (fp #b1 #b011 #b11)))
(assert (fp.leq (fp #b1 #b011 #b11)
                expect
                (fp #b0 #b011 #b00)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
