; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b01000)
                arg1
                (fp #b0 #b101010 #b11011)))
(assert (fp.leq (fp #b0 #b101010 #b11011)
                arg1
                (fp #b0 #b111101 #b10001)))
; arg1 = 3776.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b01111)
                arg2
                (fp #b0 #b101010 #b10000)))
(assert (fp.leq (fp #b0 #b101010 #b10000)
                arg2
                (fp #b0 #b111001 #b11001)))
; arg2 = 3072.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000011 #b10100)
                expect
                (fp #b0 #b101011 #b10101)))
(assert (fp.leq (fp #b0 #b101011 #b10101)
                expect
                (fp #b0 #b110110 #b10001)))
; expect = 6784.0

(assert (not (= expect result)))

(check-sat)
(exit)
