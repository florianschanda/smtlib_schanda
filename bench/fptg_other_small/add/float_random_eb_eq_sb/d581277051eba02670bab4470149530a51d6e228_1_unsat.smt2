(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b010)
                arg1
                (fp #b1 #b1010 #b110)))
(assert (fp.leq (fp #b1 #b1010 #b110)
                arg1
                (fp #b0 #b0011 #b011)))
; arg1 = -14.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b010)
                arg2
                (fp #b1 #b0101 #b001)))
(assert (fp.leq (fp #b1 #b0101 #b001)
                arg2
                (fp #b0 #b0100 #b001)))
; arg2 = -0.28125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b100)
                expect
                (fp #b1 #b1010 #b110)))
(assert (fp.leq (fp #b1 #b1010 #b110)
                expect
                (fp #b0 #b1110 #b110)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
(exit)
