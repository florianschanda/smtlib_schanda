(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1000)
                arg1
                (fp #b1 #b00000 #b1111)))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                arg1
                (fp #b0 #b10100 #b0000)))
; arg1 = -0.000057220458984375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01111 #b1100)
                arg2
                (fp #b1 #b01100 #b1001)))
(assert (fp.leq (fp #b1 #b01100 #b1001)
                arg2
                (fp #b0 #b01011 #b0101)))
; arg2 = -0.1953125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b1101)
                expect
                (fp #b1 #b01100 #b1010)))
(assert (fp.leq (fp #b1 #b01100 #b1010)
                expect
                (fp #b0 #b10101 #b1000)))
; expect = -0.203125

(assert (= expect result))

(check-sat)
(exit)
