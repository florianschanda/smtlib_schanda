(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b0111)
                arg1
                (fp #b0 #b00000 #b0001)))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                arg1
                (fp #b0 #b01101 #b1000)))
; arg1 = 0.000003814697265625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01110 #b0101)
                arg2
                (fp #b1 #b01010 #b1000)))
(assert (fp.leq (fp #b1 #b01010 #b1000)
                arg2
                (fp #b0 #b01000 #b0001)))
; arg2 = -0.046875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b1000)
                expect
                (fp #b1 #b01010 #b1000)))
(assert (fp.leq (fp #b1 #b01010 #b1000)
                expect
                (fp #b0 #b01011 #b0111)))
; expect = -0.046875

(assert (= expect result))

(check-sat)
(exit)
