                arg2
                (fp #b0 #b11100 #b0000)))
; arg2 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b1110)
                expect
                (fp #b0 #b00101 #b1111)))
(assert (fp.leq (fp #b0 #b00101 #b1111)
                expect
                (fp #b0 #b01111 #b1101)))
; expect = 0.00189208984375

(assert (not (= expect result)))

