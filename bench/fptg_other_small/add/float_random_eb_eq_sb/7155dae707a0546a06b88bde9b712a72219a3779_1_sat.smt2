(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000111 #b00110)
                arg1
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg1
                (fp #b0 #b110011 #b10010)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10110)
                arg2
                (fp #b1 #b100010 #b11000)))
(assert (fp.leq (fp #b1 #b100010 #b11000)
                arg2
                (fp #b0 #b011110 #b01001)))
; arg2 = -14.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b10001)
                expect
                (fp #b1 #b100010 #b11000)))
(assert (fp.leq (fp #b1 #b100010 #b11000)
                expect
                (fp #b1 #b011000 #b01000)))
; expect = -14.0

(assert (= expect result))

(check-sat)
(exit)
