(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011101 #b01010)
                arg1
                (fp #b0 #b000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000 #b01000)
                arg1
                (fp #b0 #b000010 #b01011)))
; arg1 = 0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b10110)
                arg2
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg2
                (fp #b1 #b001110 #b00011)))
; arg2 = -64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b01111)
                expect
                (fp #b1 #b100100 #b11111)))
(assert (fp.leq (fp #b1 #b100100 #b11111)
                expect
                (fp #b0 #b101001 #b00011)))
; expect = -63.0

(assert (= expect result))

(check-sat)
(exit)
