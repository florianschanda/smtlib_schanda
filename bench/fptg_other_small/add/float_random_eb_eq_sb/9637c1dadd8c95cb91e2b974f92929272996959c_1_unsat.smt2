                arg2
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg2
                (fp #b0 #b1110 #b100)))
; arg2 = 0.00390625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b011)
                expect
                (fp #b0 #b0001 #b000)))
(assert (fp.leq (fp #b0 #b0001 #b000)
                expect
                (fp #b0 #b0100 #b100)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
