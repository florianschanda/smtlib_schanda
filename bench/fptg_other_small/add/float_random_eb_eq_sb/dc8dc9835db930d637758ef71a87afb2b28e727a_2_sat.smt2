; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01110 #b0110)
                arg1
                (fp #b0 #b10011 #b0110)))
(assert (fp.leq (fp #b0 #b10011 #b0110)
                arg1
                (fp #b0 #b10100 #b0011)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1101)
                arg2
                (fp #b1 #b00110 #b0000)))
(assert (fp.leq (fp #b1 #b00110 #b0000)
                arg2
                (fp #b0 #b10110 #b1001)))
; arg2 = -0.001953125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0111)
                expect
                (fp #b0 #b10011 #b0110)))
(assert (fp.leq (fp #b0 #b10011 #b0110)
                expect
                (fp #b0 #b11010 #b0110)))
; expect = 22.0

(assert (= expect result))

(check-sat)
(exit)
