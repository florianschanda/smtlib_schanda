(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00100 #b1000)
                arg1
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg1
                (fp #b0 #b11110 #b0010)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0010)
                arg2
                (fp #b1 #b10101 #b0101)))
(assert (fp.leq (fp #b1 #b10101 #b0101)
                arg2
                (fp #b0 #b10011 #b0111)))
; arg2 = -84.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1000)
                expect
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                expect
                (fp #b0 #b11101 #b1111)))
; expect = 16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
