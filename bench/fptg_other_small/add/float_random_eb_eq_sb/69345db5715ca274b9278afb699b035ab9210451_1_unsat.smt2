                (fp #b0 #b11010 #b1111)))
; arg2 = -0.000057220458984375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01011 #b1010)
                expect
                (fp #b0 #b01110 #b1111)))
(assert (fp.leq (fp #b0 #b01110 #b1111)
                expect
                (fp #b0 #b10001 #b0000)))
; expect = 0.96875

(assert (not (= expect result)))

