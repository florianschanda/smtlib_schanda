; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01000 #b1101)
                arg1
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                arg1
                (fp #b0 #b11011 #b0111)))
; arg1 = 5120.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg2
                (fp #b1 #b10110 #b1111)))
(assert (fp.leq (fp #b1 #b10110 #b1111)
                arg2
                (fp #b0 #b10011 #b0100)))
; arg2 = -248.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00010 #b1001)
                expect
                (fp #b0 #b11011 #b0011)))
(assert (fp.leq (fp #b0 #b11011 #b0011)
                expect
                (fp #b0 #b11110 #b1001)))
; expect = 4864.0

(assert (not (= expect result)))

(check-sat)
(exit)
