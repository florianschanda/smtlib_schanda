; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001011 #b10101)
                arg1
                (fp #b0 #b100100 #b01100)))
(assert (fp.leq (fp #b0 #b100100 #b01100)
                arg1
                (fp #b0 #b101001 #b11001)))
; arg1 = 44.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101010 #b10011)
                arg2
                (fp #b1 #b001101 #b01101)))
(assert (fp.leq (fp #b1 #b001101 #b01101)
                arg2
                (fp #b0 #b100111 #b10111)))
; arg2 = -0.00000536441802978515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b10000)
                expect
                (fp #b0 #b100100 #b01100)))
(assert (fp.leq (fp #b0 #b100100 #b01100)
                expect
                (fp #b0 #b101110 #b11011)))
; expect = 44.0

(assert (not (= expect result)))

(check-sat)
(exit)
