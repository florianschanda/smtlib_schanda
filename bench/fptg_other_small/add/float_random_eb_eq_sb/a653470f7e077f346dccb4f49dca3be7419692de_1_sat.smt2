(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b11000)
                arg1
                (fp #b1 #b100100 #b10101)))
(assert (fp.leq (fp #b1 #b100100 #b10101)
                arg1
                (fp #b0 #b101000 #b01010)))
; arg1 = -53.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001010 #b10101)
                arg2
                (fp #b0 #b000000 #b10100)))
(assert (fp.leq (fp #b0 #b000000 #b10100)
                arg2
                (fp #b0 #b000100 #b11110)))
; arg2 = 0.000000000582076609134674072265625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b11111)
                expect
                (fp #b1 #b100100 #b10100)))
(assert (fp.leq (fp #b1 #b100100 #b10100)
                expect
                (fp #b0 #b100111 #b11010)))
; expect = -52.0

(assert (= expect result))

(check-sat)
(exit)
