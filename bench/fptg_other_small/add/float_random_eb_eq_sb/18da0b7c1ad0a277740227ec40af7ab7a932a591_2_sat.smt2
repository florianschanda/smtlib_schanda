(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111100 #b000010)
                arg1
                (fp #b1 #b0111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111 #b000000)
                arg1
                (fp #b1 #b0010101 #b001100)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101000 #b110001)
                arg2
                (fp #b1 #b0111111 #b100001)))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg2
                (fp #b0 #b1111100 #b000000)))
; arg2 = -1.515625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110101 #b110100)
                expect
                (fp #b1 #b1000000 #b010001)))
(assert (fp.leq (fp #b1 #b1000000 #b010001)
                expect
                (fp #b0 #b1010111 #b101101)))
; expect = -2.53125

(assert (= expect result))

(check-sat)
(exit)
