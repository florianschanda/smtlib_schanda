(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b011)
                arg1
                (fp #b1 #b0000 #b110)))
(assert (fp.leq (fp #b1 #b0000 #b110)
                arg1
                (fp #b0 #b1110 #b101)))
; arg1 = -0.01171875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                arg2
                (fp #b1 #b1100 #b101)))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg2
                (fp #b0 #b0011 #b010)))
; arg2 = -52.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b111)
                expect
                (fp #b1 #b1100 #b101)))
(assert (fp.leq (fp #b1 #b1100 #b101)
                expect
                (fp #b0 #b1000 #b110)))
; expect = -52.0

(assert (not (= expect result)))

(check-sat)
(exit)
