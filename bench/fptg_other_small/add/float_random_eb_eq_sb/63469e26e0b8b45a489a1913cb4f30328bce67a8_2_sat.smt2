                (fp #b0 #b00000 #b1111)))
(assert (fp.leq (fp #b0 #b00000 #b1111)
                arg2
                (fp #b0 #b01111 #b1001)))
; arg2 = 0.000057220458984375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0110)
                expect
                (fp #b0 #b11101 #b0001)))
(assert (fp.leq (fp #b0 #b11101 #b0001)
                expect
                (fp #b0 #b11110 #b1101)))
; expect = 17408.0

(assert (= expect result))

(check-sat)
