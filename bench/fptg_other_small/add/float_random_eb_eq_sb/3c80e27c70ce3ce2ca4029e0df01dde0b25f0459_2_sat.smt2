                arg2
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                arg2
                (fp #b0 #b1110000 #b010111)))
; arg2 = 4261412864.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0001000 #b010001)
                expect
                (fp #b0 #b1011111 #b000000)))
(assert (fp.leq (fp #b0 #b1011111 #b000000)
                expect
                (fp #b0 #b1101101 #b110000)))
; expect = 4294967296.0

(assert (= expect result))

(check-sat)
(exit)
