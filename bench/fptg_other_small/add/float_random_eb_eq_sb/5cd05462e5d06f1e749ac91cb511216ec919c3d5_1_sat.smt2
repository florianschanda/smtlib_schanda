; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg1
                (fp #b1 #b10010 #b1110)))
(assert (fp.leq (fp #b1 #b10010 #b1110)
                arg1
                (fp #b0 #b00100 #b0000)))
; arg1 = -15.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1110)
                arg2
                (fp #b0 #b11010 #b0111)))
(assert (fp.leq (fp #b0 #b11010 #b0111)
                arg2
                (fp #b0 #b11110 #b0100)))
; arg2 = 2944.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b1101)
                expect
                (fp #b0 #b11010 #b0110)))
(assert (fp.leq (fp #b0 #b11010 #b0110)
                expect
                (fp #b0 #b11100 #b0001)))
; expect = 2816.0

(assert (= expect result))

(check-sat)
(exit)
