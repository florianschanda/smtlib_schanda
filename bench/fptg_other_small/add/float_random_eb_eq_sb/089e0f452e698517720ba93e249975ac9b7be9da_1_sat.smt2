(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg1
                (fp #b0 #b0001 #b000)))
(assert (fp.leq (fp #b0 #b0001 #b000)
                arg1
                (fp #b0 #b1100 #b100)))
; arg1 = 0.015625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b011)
                arg2
                (fp #b0 #b1110 #b111)))
(assert (fp.leq (fp #b0 #b1110 #b111)
                arg2
                (fp #b0 #b1111 #b000)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b100)
                expect
                (fp #b0 #b1110 #b111)))
(assert (fp.leq (fp #b0 #b1110 #b111)
                expect
                (fp #b0 #b1111 #b000)))
; expect = 240.0

(assert (= expect result))

(check-sat)
(exit)
