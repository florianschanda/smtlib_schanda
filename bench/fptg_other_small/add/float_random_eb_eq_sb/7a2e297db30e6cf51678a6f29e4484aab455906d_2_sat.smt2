                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg2
                (fp #b0 #b010011 #b11100)))
; arg2 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b10001)
                expect
                (fp #b1 #b100101 #b00001)))
(assert (fp.leq (fp #b1 #b100101 #b00001)
                expect
                (fp #b0 #b010011 #b11001)))
; expect = -66.0

(assert (= expect result))

(check-sat)
(exit)
