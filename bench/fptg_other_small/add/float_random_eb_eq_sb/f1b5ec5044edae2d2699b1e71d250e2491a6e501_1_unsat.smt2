; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1011)
                arg1
                (fp #b0 #b00001 #b0000)))
(assert (fp.leq (fp #b0 #b00001 #b0000)
                arg1
                (fp #b0 #b10011 #b1000)))
; arg1 = 0.00006103515625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b1100)
                arg2
                (fp #b0 #b11001 #b1101)))
(assert (fp.leq (fp #b0 #b11001 #b1101)
                arg2
                (fp #b0 #b11010 #b0100)))
; arg2 = 1856.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1011)
                expect
                (fp #b0 #b11001 #b1101)))
(assert (fp.leq (fp #b0 #b11001 #b1101)
                expect
                (fp #b0 #b11101 #b0010)))
; expect = 1856.0

(assert (not (= expect result)))

(check-sat)
(exit)
