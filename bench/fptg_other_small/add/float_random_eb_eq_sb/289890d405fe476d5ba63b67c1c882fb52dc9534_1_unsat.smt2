; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011010 #b01100)
                arg1
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                arg1
                (fp #b0 #b100100 #b01011)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010110 #b00111)
                arg2
                (fp #b0 #b011111 #b00011)))
(assert (fp.leq (fp #b0 #b011111 #b00011)
                arg2
                (fp #b0 #b101011 #b11011)))
; arg2 = 1.09375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001101 #b01010)
                expect
                (fp #b0 #b100000 #b00001)))
(assert (fp.leq (fp #b0 #b100000 #b00001)
                expect
                (fp #b0 #b100111 #b11101)))
; expect = 2.0625

(assert (not (= expect result)))

(check-sat)
(exit)
