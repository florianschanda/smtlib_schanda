(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b00111)
                arg1
                (fp #b0 #b101010 #b11011)))
(assert (fp.leq (fp #b0 #b101010 #b11011)
                arg1
                (fp #b0 #b111100 #b10000)))
; arg1 = 3776.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001110 #b11111)
                arg2
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg2
                (fp #b0 #b011001 #b11101)))
; arg2 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010001 #b01000)
                expect
                (fp #b0 #b101010 #b11011)))
(assert (fp.leq (fp #b0 #b101010 #b11011)
                expect
                (fp #b0 #b110001 #b11100)))
; expect = 3776.0

(assert (= expect result))

(check-sat)
(exit)
