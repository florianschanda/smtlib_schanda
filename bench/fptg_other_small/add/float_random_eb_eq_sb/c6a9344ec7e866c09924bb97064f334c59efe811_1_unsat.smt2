                (fp #b1 #b011111 #b01000)))
(assert (fp.leq (fp #b1 #b011111 #b01000)
                arg2
                (fp #b0 #b010011 #b01101)))
; arg2 = -1.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011101 #b10001)
                expect
                (fp #b0 #b011101 #b11100)))
(assert (fp.leq (fp #b0 #b011101 #b11100)
                expect
                (fp #b0 #b011110 #b10010)))
; expect = 0.46875

(assert (not (= expect result)))

(check-sat)
