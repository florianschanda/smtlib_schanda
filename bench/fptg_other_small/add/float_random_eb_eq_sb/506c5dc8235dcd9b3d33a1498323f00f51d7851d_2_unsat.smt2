;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b0101)
                arg1
                (fp #b1 #b10100 #b0000)))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg1
                (fp #b0 #b01000 #b0010)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                arg2
                (fp #b0 #b01111 #b1101)))
(assert (fp.leq (fp #b0 #b01111 #b1101)
                arg2
                (fp #b0 #b11011 #b1010)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0011)
                expect
                (fp #b1 #b10011 #b1111)))
(assert (fp.leq (fp #b1 #b10011 #b1111)
                expect
                (fp #b0 #b00110 #b1010)))
; expect = -31.0

(assert (not (= expect result)))

(check-sat)
(exit)
