(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b0110)
                arg1
                (fp #b0 #b01111 #b0110)))
(assert (fp.leq (fp #b0 #b01111 #b0110)
                arg1
                (fp #b0 #b11010 #b0011)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b1100)
                arg2
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg2
                (fp #b0 #b11110 #b1100)))
; arg2 = 0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01010 #b0100)
                expect
                (fp #b0 #b01111 #b0111)))
(assert (fp.leq (fp #b0 #b01111 #b0111)
                expect
                (fp #b0 #b11100 #b1010)))
; expect = 1.4375

(assert (= expect result))

(check-sat)
(exit)
