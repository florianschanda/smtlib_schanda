                arg2
                (fp #b1 #b001101 #b01101)))
(assert (fp.leq (fp #b1 #b001101 #b01101)
                arg2
                (fp #b0 #b000011 #b10111)))
; arg2 = -0.00000536441802978515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001001 #b10110)
                expect
                (fp #b0 #b101010 #b11010)))
(assert (fp.leq (fp #b0 #b101010 #b11010)
                expect
                (fp #b0 #b111101 #b11111)))
; expect = 3712.0

(assert (= expect result))

(check-sat)
(exit)
