(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011101 #b11111)
                arg1
                (fp #b0 #b100111 #b11001)))
(assert (fp.leq (fp #b0 #b100111 #b11001)
                arg1
                (fp #b0 #b110000 #b11111)))
; arg1 = 456.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b00010)
                arg2
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b0 #b100011 #b10100)))
; arg2 = -320.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011110 #b01011)
                expect
                (fp #b0 #b100110 #b00010)))
(assert (fp.leq (fp #b0 #b100110 #b00010)
                expect
                (fp #b0 #b101010 #b10000)))
; expect = 136.0

(assert (= expect result))

(check-sat)
(exit)
