(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101001 #b10001)
                arg1
                (fp #b0 #b011111 #b10111)))
(assert (fp.leq (fp #b0 #b011111 #b10111)
                arg1
                (fp #b0 #b101010 #b01001)))
; arg1 = 1.71875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b01011)
                arg2
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                arg2
                (fp #b0 #b101111 #b10100)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011000 #b11110)
                expect
                (fp #b0 #b100000 #b01100)))
(assert (fp.leq (fp #b0 #b100000 #b01100)
                expect
                (fp #b0 #b110000 #b11111)))
; expect = 2.75

(assert (= expect result))

(check-sat)
(exit)
