; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001110 #b10110)
                arg1
                (fp #b1 #b000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000 #b11111)
                arg1
                (fp #b1 #b000000 #b11011)))
; arg1 = -0.00000000090221874415874481201171875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000100 #b11000)
                arg2
                (fp #b0 #b100011 #b00110)))
(assert (fp.leq (fp #b0 #b100011 #b00110)
                arg2
                (fp #b0 #b111110 #b01100)))
; arg2 = 19.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000010 #b01111)
                expect
                (fp #b0 #b100011 #b00110)))
(assert (fp.leq (fp #b0 #b100011 #b00110)
                expect
                (fp #b0 #b111011 #b10000)))
; expect = 19.0

(assert (= expect result))

(check-sat)
(exit)
