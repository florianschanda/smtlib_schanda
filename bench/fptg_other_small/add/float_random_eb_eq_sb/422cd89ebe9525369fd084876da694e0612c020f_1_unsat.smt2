(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1101)
                arg1
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                arg1
                (fp #b0 #b11100 #b1101)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01111 #b0101)
                arg2
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg2
                (fp #b0 #b01100 #b0011)))
; arg2 = -0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00001 #b0101)
                expect
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                expect
                (fp #b0 #b10110 #b1000)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
