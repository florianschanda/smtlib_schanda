; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01101 #b1001)
                arg1
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                arg1
                (fp #b0 #b10000 #b0011)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0111)
                arg2
                (fp #b1 #b01100 #b1001)))
(assert (fp.leq (fp #b1 #b01100 #b1001)
                arg2
                (fp #b0 #b01100 #b0101)))
; arg2 = -0.1953125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b1001)
                expect
                (fp #b0 #b01110 #b1010)))
(assert (fp.leq (fp #b0 #b01110 #b1010)
                expect
                (fp #b0 #b01111 #b0000)))
; expect = 0.8125

(assert (not (= expect result)))

(check-sat)
(exit)
