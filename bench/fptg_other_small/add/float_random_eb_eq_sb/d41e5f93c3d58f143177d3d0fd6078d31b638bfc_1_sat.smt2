; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b10101)
                arg1
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                arg1
                (fp #b0 #b100010 #b00010)))
; arg1 = -0.00000000002910383045673370361328125

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001000 #b11001)
                arg2
                (fp #b0 #b011111 #b00011)))
(assert (fp.leq (fp #b0 #b011111 #b00011)
                arg2
                (fp #b0 #b110011 #b01111)))
; arg2 = 1.09375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010101 #b10101)
                expect
                (fp #b0 #b011111 #b00010)))
(assert (fp.leq (fp #b0 #b011111 #b00010)
                expect
                (fp #b0 #b111101 #b00011)))
; expect = 1.0625

(assert (= expect result))

(check-sat)
(exit)
