(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b1000 #b011)
                arg1
                (fp #b0 #b1011 #b000)))
(assert (fp.leq (fp #b0 #b1011 #b000)
                arg1
                (fp #b0 #b1100 #b011)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                arg2
                (fp #b1 #b1001 #b111)))
(assert (fp.leq (fp #b1 #b1001 #b111)
                arg2
                (fp #b1 #b1001 #b011)))
; arg2 = -7.5

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b110)
                expect
                (fp #b0 #b1010 #b000)))
(assert (fp.leq (fp #b0 #b1010 #b000)
                expect
                (fp #b0 #b1101 #b110)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
