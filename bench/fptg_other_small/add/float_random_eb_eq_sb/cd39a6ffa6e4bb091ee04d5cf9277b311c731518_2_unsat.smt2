(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b101)
                arg1
                (fp #b0 #b0100 #b101)))
(assert (fp.leq (fp #b0 #b0100 #b101)
                arg1
                (fp #b0 #b1000 #b000)))
; arg1 = 0.203125

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                arg2
                (fp #b1 #b0010 #b011)))
(assert (fp.leq (fp #b1 #b0010 #b011)
                arg2
                (fp #b0 #b0111 #b011)))
; arg2 = -0.04296875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b000)
                expect
                (fp #b0 #b0100 #b011)))
(assert (fp.leq (fp #b0 #b0100 #b011)
                expect
                (fp #b0 #b1000 #b001)))
; expect = 0.171875

(assert (not (= expect result)))

(check-sat)
(exit)
