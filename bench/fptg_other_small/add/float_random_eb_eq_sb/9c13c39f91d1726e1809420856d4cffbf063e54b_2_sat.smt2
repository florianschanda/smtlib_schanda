(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0010)
                arg1
                (fp #b1 #b01111 #b0111)))
(assert (fp.leq (fp #b1 #b01111 #b0111)
                arg1
                (fp #b0 #b11010 #b0011)))
; arg1 = -1.4375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01100 #b0011)
                arg2
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                arg2
                (fp #b0 #b11101 #b0011)))
; arg2 = -0.000003814697265625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1000)
                expect
                (fp #b1 #b01111 #b1000)))
(assert (fp.leq (fp #b1 #b01111 #b1000)
                expect
                (fp #b1 #b01001 #b0001)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
