                arg2
                (fp #b0 #b01010 #b0111)))
; arg2 = 0.00005340576171875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b0100)
                expect
                (fp #b1 #b01001 #b0000)))
(assert (fp.leq (fp #b1 #b01001 #b0000)
                expect
                (fp #b0 #b01110 #b0011)))
; expect = -0.015625

(assert (not (= expect result)))

