                arg2
                (fp #b0 #b100110 #b11100)))
(assert (fp.leq (fp #b0 #b100110 #b11100)
                arg2
                (fp #b0 #b100111 #b10110)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010010 #b01001)
                expect
                (fp #b0 #b100110 #b11011)))
(assert (fp.leq (fp #b0 #b100110 #b11011)
                expect
                (fp #b0 #b110110 #b11010)))
; expect = 236.0

(assert (= expect result))

(check-sat)
(exit)
