; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b11011)
                arg1
                (fp #b1 #b100011 #b10110)))
(assert (fp.leq (fp #b1 #b100011 #b10110)
                arg1
                (fp #b0 #b000000 #b11101)))
; arg1 = -27.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b00110)
                arg2
                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg2
                (fp #b0 #b000101 #b01001)))
; arg2 = -1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00100)
                expect
                (fp #b1 #b111101 #b00001)))
(assert (fp.leq (fp #b1 #b111101 #b00001)
                expect
                (fp #b1 #b011011 #b11111)))
; expect = -1107296256.0

(assert (not (= expect result)))

(check-sat)
(exit)
