; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100010 #b00110)
                arg1
                (fp #b1 #b000000 #b11011)))
(assert (fp.leq (fp #b1 #b000000 #b11011)
                arg1
                (fp #b0 #b101011 #b01011)))
; arg1 = -0.00000000078580342233180999755859375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b11010)
                arg2
                (fp #b1 #b011111 #b00110)))
(assert (fp.leq (fp #b1 #b011111 #b00110)
                arg2
                (fp #b0 #b000100 #b00001)))
; arg2 = -1.1875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b11111)
                expect
                (fp #b1 #b011111 #b00110)))
(assert (fp.leq (fp #b1 #b011111 #b00110)
                expect
                (fp #b0 #b101000 #b10101)))
; expect = -1.1875

(assert (= expect result))

(check-sat)
(exit)
