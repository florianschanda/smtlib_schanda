; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000011 #b11101)
                arg1
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                arg1
                (fp #b0 #b110010 #b01001)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b01100)
                arg2
                (fp #b1 #b010111 #b01100)))
(assert (fp.leq (fp #b1 #b010111 #b01100)
                arg2
                (fp #b0 #b111100 #b10111)))
; arg2 = -0.00537109375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000001 #b01110)
                expect
                (fp #b0 #b011110 #b11111)))
(assert (fp.leq (fp #b0 #b011110 #b11111)
                expect
                (fp #b0 #b101000 #b00100)))
; expect = 0.984375

(assert (= expect result))

(check-sat)
(exit)
