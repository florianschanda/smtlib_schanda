; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b11101)
                arg1
                (fp #b1 #b111110 #b01110)))
(assert (fp.leq (fp #b1 #b111110 #b01110)
                arg1
                (fp #b0 #b011101 #b01110)))
; arg1 = -3087007744.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b10101)
                arg2
                (fp #b0 #b101010 #b10000)))
(assert (fp.leq (fp #b0 #b101010 #b10000)
                arg2
                (fp #b0 #b101110 #b10101)))
; arg2 = 3072.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10110)
                expect
                (fp #b1 #b111110 #b01101)))
(assert (fp.leq (fp #b1 #b111110 #b01101)
                expect
                (fp #b1 #b110100 #b10000)))
; expect = -3019898880.0

(assert (= expect result))

(check-sat)
(exit)
