; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01010)
                arg1
                (fp #b1 #b111000 #b10110)))
(assert (fp.leq (fp #b1 #b111000 #b10110)
                arg1
                (fp #b1 #b000011 #b11000)))
; arg1 = -56623104.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b11111)
                arg2
                (fp #b0 #b000000 #b11111)))
(assert (fp.leq (fp #b0 #b000000 #b11111)
                arg2
                (fp #b0 #b011001 #b10100)))
; arg2 = 0.00000000090221874415874481201171875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b10000)
                expect
                (fp #b1 #b111000 #b10101)))
(assert (fp.leq (fp #b1 #b111000 #b10101)
                expect
                (fp #b0 #b100111 #b00101)))
; expect = -55574528.0

(assert (not (= expect result)))

(check-sat)
(exit)
