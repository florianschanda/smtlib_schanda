                arg2
                (fp #b0 #b101100 #b00011)))
; arg2 = -0.000030517578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100010 #b10001)
                expect
                (fp #b1 #b010001 #b01111)))
(assert (fp.leq (fp #b1 #b010001 #b01111)
                expect
                (fp #b0 #b001101 #b11111)))
; expect = -0.0000896453857421875

(assert (= expect result))

