(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01110 #b1110)
                arg1
                (fp #b0 #b10110 #b1111)))
(assert (fp.leq (fp #b0 #b10110 #b1111)
                arg1
                (fp #b0 #b11011 #b1110)))
; arg1 = 248.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0011)
                arg2
                (fp #b0 #b00000 #b0111)))
(assert (fp.leq (fp #b0 #b00000 #b0111)
                arg2
                (fp #b0 #b10000 #b0010)))
; arg2 = 0.000026702880859375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b1101)
                expect
                (fp #b0 #b10111 #b0000)))
(assert (fp.leq (fp #b0 #b10111 #b0000)
                expect
                (fp #b0 #b11011 #b1111)))
; expect = 256.0

(assert (= expect result))

(check-sat)
(exit)
