                (fp #b0 #b000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000 #b01000)
                arg2
                (fp #b0 #b000110 #b01001)))
; arg2 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10100)
                expect
                (fp #b1 #b111110 #b01101)))
(assert (fp.leq (fp #b1 #b111110 #b01101)
                expect
                (fp #b1 #b111001 #b11100)))
; expect = -3019898880.0

(assert (= expect result))

(check-sat)
