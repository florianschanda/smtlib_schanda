(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0000000 #b101)
                arg1
                (fp #b0 #b1101000 #b000)))
(assert (fp.leq (fp #b0 #b1101000 #b000)
                arg1
                (fp #b0 #b1110101 #b000)))
; arg1 = 2199023255552.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111001 #b111)
                arg2
                (fp #b0 #b0111110 #b001)))
(assert (fp.leq (fp #b0 #b0111110 #b001)
                arg2
                (fp #b0 #b1010001 #b101)))
; arg2 = 0.5625

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0101101 #b110)
                expect
                (fp #b0 #b1101000 #b001)))
(assert (fp.leq (fp #b0 #b1101000 #b001)
                expect
                (fp #b0 #b1101010 #b001)))
; expect = 2473901162496.0

(assert (= expect result))

(check-sat)
(exit)
