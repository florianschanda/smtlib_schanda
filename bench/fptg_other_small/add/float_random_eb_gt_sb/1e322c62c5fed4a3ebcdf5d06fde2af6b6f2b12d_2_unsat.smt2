; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11001100 #b110)
                arg1
                (fp #b1 #b01111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111 #b000)
                arg1
                (fp #b0 #b00101010 #b000)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11000001 #b110)
                arg2
                (fp #b1 #b10111110 #b111)))
(assert (fp.leq (fp #b1 #b10111110 #b111)
                arg2
                (fp #b1 #b10000110 #b000)))
; arg2 = -17293822569102704640.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010100 #b001)
                expect
                (fp #b1 #b10111111 #b000)))
(assert (fp.leq (fp #b1 #b10111111 #b000)
                expect
                (fp #b1 #b10111101 #b101)))
; expect = -18446744073709551616.0

(assert (not (= expect result)))

(check-sat)
(exit)
