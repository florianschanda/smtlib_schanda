(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10010 #b111)
                arg1
                (fp #b1 #b01111 #b101)))
(assert (fp.leq (fp #b1 #b01111 #b101)
                arg1
                (fp #b0 #b01100 #b101)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b11101 #b110)
                arg2
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                arg2
                (fp #b0 #b11111 #b000)))
; arg2 = 61440.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10000 #b101)
                expect
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                expect
                (fp #b0 #b11111 #b000)))
; expect = 61440.0

(assert (= expect result))

(check-sat)
(exit)
