(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01011000 #b1001)
                arg1
                (fp #b0 #b00000000 #b1110)))
(assert (fp.leq (fp #b0 #b00000000 #b1110)
                arg1
                (fp #b0 #b00110100 #b0000)))
; arg1 = 0.000000000000000000000000000000000000010285575569695015694726444700694649680913323621755765813201577429936151020228862762451171875

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111110 #b0101)
                arg2
                (fp #b1 #b11111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000)
                arg2
                (fp #b1 #b00101111 #b0000)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111101 #b1111)
                expect
                (fp #b1 #b11111100 #b1111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111)
                expect
                (fp #b0 #b11110011 #b0110)))
; expect = -82412135738664784120036037737381363712.0

(assert (= expect result))

(check-sat)
(exit)
