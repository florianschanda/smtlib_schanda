(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10100 #b0)
                arg1
                (fp #b1 #b00000 #b1)))
(assert (fp.leq (fp #b1 #b00000 #b1)
                arg1
                (fp #b0 #b00101 #b0)))
; arg1 = -0.000030517578125

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b01101 #b0)
                arg2
                (fp #b0 #b11001 #b0)))
(assert (fp.leq (fp #b0 #b11001 #b0)
                arg2
                (fp #b0 #b11101 #b0)))
; arg2 = 1024.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b00110 #b0)
                expect
                (fp #b0 #b11000 #b1)))
(assert (fp.leq (fp #b0 #b11000 #b1)
                expect
                (fp #b0 #b11110 #b1)))
; expect = 768.0

(assert (not (= expect result)))

(check-sat)
(exit)
