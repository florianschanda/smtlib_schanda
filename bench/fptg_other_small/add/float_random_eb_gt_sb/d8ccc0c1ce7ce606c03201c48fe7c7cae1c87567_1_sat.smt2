                arg2
                (fp #b1 #b11110000 #b00)))
(assert (fp.leq (fp #b1 #b11110000 #b00)
                arg2
                (fp #b1 #b01001000 #b11)))
; arg2 = -10384593717069655257060992658440192.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11110001 #b10)
                expect
                (fp #b1 #b11110000 #b00)))
(assert (fp.leq (fp #b1 #b11110000 #b00)
                expect
                (fp #b1 #b10110111 #b10)))
; expect = -10384593717069655257060992658440192.0

(assert (= expect result))

(check-sat)
(exit)
