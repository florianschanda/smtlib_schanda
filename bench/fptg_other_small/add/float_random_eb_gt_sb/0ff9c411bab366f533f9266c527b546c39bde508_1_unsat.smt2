(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0100100 #b0110)
                arg1
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg1
                (fp #b0 #b1110101 #b0110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011110 #b1000)
                arg2
                (fp #b1 #b1000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000011 #b0001)
                arg2
                (fp #b1 #b0000111 #b0101)))
; arg2 = -17.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111101 #b1000)
                expect
                (fp #b1 #b1000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000011 #b0001)
                expect
                (fp #b0 #b1010010 #b1010)))
; expect = -17.0

(assert (not (= expect result)))

(check-sat)
(exit)
