;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b11001101 #b0110)
                arg1
                (fp #b0 #b11110001 #b0100)))
(assert (fp.leq (fp #b0 #b11110001 #b0100)
                arg1
                (fp #b0 #b11111011 #b1100)))
; arg1 = 25961484292674138142652481646100480.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11110000 #b1001)
                arg2
                (fp #b0 #b00000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000 #b0100)
                arg2
                (fp #b0 #b11010000 #b1111)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01011011 #b1101)
                expect
                (fp #b0 #b11110001 #b0101)))
(assert (fp.leq (fp #b0 #b11110001 #b0101)
                expect
                (fp #b0 #b11111001 #b0000)))
; expect = 27259558507307845049785105728405504.0

(assert (not (= expect result)))

(check-sat)
(exit)
