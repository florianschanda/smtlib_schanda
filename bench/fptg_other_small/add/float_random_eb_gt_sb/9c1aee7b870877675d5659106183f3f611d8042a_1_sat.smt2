; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0111111 #b1111)
                arg1
                (fp #b1 #b0000000 #b0001)))
(assert (fp.leq (fp #b1 #b0000000 #b0001)
                arg1
                (fp #b0 #b0110010 #b0100)))
; arg1 = -0.000000000000000000013552527156068805425093160010874271392822265625

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0101010 #b0010)
                arg2
                (fp #b0 #b0111111 #b1101)))
(assert (fp.leq (fp #b0 #b0111111 #b1101)
                arg2
                (fp #b0 #b1001110 #b0110)))
; arg2 = 1.8125

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011011 #b0110)
                expect
                (fp #b0 #b0111111 #b1100)))
(assert (fp.leq (fp #b0 #b0111111 #b1100)
                expect
                (fp #b0 #b1100000 #b1100)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
