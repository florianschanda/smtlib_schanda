; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b100)
                arg1
                (fp #b1 #b01010 #b011)))
(assert (fp.leq (fp #b1 #b01010 #b011)
                arg1
                (fp #b0 #b10010 #b010)))
; arg1 = -0.04296875

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00101 #b110)
                arg2
                (fp #b0 #b10110 #b011)))
(assert (fp.leq (fp #b0 #b10110 #b011)
                arg2
                (fp #b0 #b11011 #b010)))
; arg2 = 176.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10000 #b110)
                expect
                (fp #b0 #b10110 #b010)))
(assert (fp.leq (fp #b0 #b10110 #b010)
                expect
                (fp #b0 #b11100 #b000)))
; expect = 160.0

(assert (not (= expect result)))

(check-sat)
(exit)
