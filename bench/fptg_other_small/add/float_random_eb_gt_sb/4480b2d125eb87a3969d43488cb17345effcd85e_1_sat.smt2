(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11100 #b010)
                arg1
                (fp #b1 #b10101 #b110)))
(assert (fp.leq (fp #b1 #b10101 #b110)
                arg1
                (fp #b1 #b01000 #b011)))
; arg1 = -112.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00001 #b011)
                arg2
                (fp #b0 #b10000 #b100)))
(assert (fp.leq (fp #b0 #b10000 #b100)
                arg2
                (fp #b0 #b10100 #b011)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10101 #b111)
                expect
                (fp #b1 #b10101 #b101)))
(assert (fp.leq (fp #b1 #b10101 #b101)
                expect
                (fp #b1 #b00000 #b000)))
; expect = -104.0

(assert (= expect result))

(check-sat)
(exit)
