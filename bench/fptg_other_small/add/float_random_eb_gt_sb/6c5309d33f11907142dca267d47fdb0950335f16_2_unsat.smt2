(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg1
                (fp #b1 #b0000 #b10)))
(assert (fp.leq (fp #b1 #b0000 #b10)
                arg1
                (fp #b0 #b0011 #b00)))
; arg1 = -0.0078125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b11)
                arg2
                (fp #b1 #b0111 #b10)))
(assert (fp.leq (fp #b1 #b0111 #b10)
                arg2
                (fp #b1 #b0101 #b00)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b10)
                expect
                (fp #b1 #b0111 #b11)))
(assert (fp.leq (fp #b1 #b0111 #b11)
                expect
                (fp #b0 #b1110 #b01)))
; expect = -1.75

(assert (not (= expect result)))

(check-sat)
(exit)
