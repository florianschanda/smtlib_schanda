; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b011)
                arg1
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg1
                (fp #b0 #b10001 #b110)))
; arg1 = -0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b111)
                arg2
                (fp #b0 #b10100 #b101)))
(assert (fp.leq (fp #b0 #b10100 #b101)
                arg2
                (fp #b0 #b10110 #b010)))
; arg2 = 52.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10101 #b101)
                expect
                (fp #b0 #b10100 #b101)))
(assert (fp.leq (fp #b0 #b10100 #b101)
                expect
                (fp #b0 #b10111 #b110)))
; expect = 52.0

(assert (not (= expect result)))

(check-sat)
(exit)
