;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011001 #b010)
                arg1
                (fp #b0 #b101110 #b111)))
(assert (fp.leq (fp #b0 #b101110 #b111)
                arg1
