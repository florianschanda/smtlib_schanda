                arg2
                (fp #b0 #b101110 #b111)))
(assert (fp.leq (fp #b0 #b101110 #b111)
                arg2
                (fp #b0 #b110001 #b001)))
; arg2 = 61440.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000111 #b000)
                expect
                (fp #b0 #b101111 #b111)))
(assert (fp.leq (fp #b0 #b101111 #b111)
                expect
                (fp #b0 #b111000 #b001)))
; expect = 122880.0

(assert (= expect result))

(check-sat)
(exit)
