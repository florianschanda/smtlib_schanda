(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b11)
                arg1
                (fp #b1 #b1000 #b10)))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg1
                (fp #b1 #b0100 #b01)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b10)
                arg2
                (fp #b1 #b1100 #b01)))
(assert (fp.leq (fp #b1 #b1100 #b01)
                arg2
                (fp #b1 #b0010 #b01)))
; arg2 = -40.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b11)
                expect
                (fp #b1 #b1100 #b01)))
(assert (fp.leq (fp #b1 #b1100 #b01)
                expect
                (fp #b1 #b0100 #b10)))
; expect = -40.0

(assert (not (= expect result)))

(check-sat)
(exit)
