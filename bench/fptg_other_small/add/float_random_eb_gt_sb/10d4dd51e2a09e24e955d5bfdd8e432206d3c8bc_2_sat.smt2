(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11010110 #b1)
                arg1
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg1
                (fp #b0 #b00010101 #b0)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00011010 #b1)
                arg2
                (fp #b0 #b10000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000 #b1)
                arg2
                (fp #b0 #b10100000 #b0)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11111010 #b0)
                expect
                (fp #b1 #b00000000 #b0)))
(assert (fp.leq (fp #b1 #b00000000 #b0)
                expect
                (fp #b0 #b10101111 #b0)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
