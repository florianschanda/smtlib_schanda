                arg2
                (fp #b0 #b1110000 #b001)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1000011 #b010)
                expect
                (fp #b1 #b1000010 #b100)))
(assert (fp.leq (fp #b1 #b1000010 #b100)
                expect
                (fp #b0 #b1111001 #b101)))
; expect = -12.0

(assert (not (= expect result)))

(check-sat)
