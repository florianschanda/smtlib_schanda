(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011111 #b10)
                arg1
                (fp #b1 #b010000 #b00)))
(assert (fp.leq (fp #b1 #b010000 #b00)
                arg1
                (fp #b1 #b000011 #b10)))
; arg1 = -0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b101011 #b10)
                arg2
                (fp #b0 #b111010 #b10)))
(assert (fp.leq (fp #b0 #b111010 #b10)
                arg2
                (fp #b0 #b111010 #b11)))
; arg2 = 201326592.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000100 #b00)
                expect
                (fp #b0 #b111010 #b10)))
(assert (fp.leq (fp #b0 #b111010 #b10)
                expect
                (fp #b0 #b111110 #b11)))
; expect = 201326592.0

(assert (= expect result))

(check-sat)
(exit)
