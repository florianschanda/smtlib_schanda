(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000101 #b1)
                arg1
                (fp #b0 #b010110 #b0)))
(assert (fp.leq (fp #b0 #b010110 #b0)
                arg1
                (fp #b0 #b100001 #b0)))
; arg1 = 0.001953125

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b111010 #b1)
                arg2
                (fp #b1 #b000000 #b0)))
(assert (fp.leq (fp #b1 #b000000 #b0)
                arg2
                (fp #b0 #b100111 #b1)))
; arg2 = -0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b010010 #b1)
                expect
                (fp #b0 #b010110 #b0)))
(assert (fp.leq (fp #b0 #b010110 #b0)
                expect
                (fp #b0 #b101110 #b1)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
