(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10110 #b100)
                arg1
                (fp #b1 #b01111 #b100)))
(assert (fp.leq (fp #b1 #b01111 #b100)
                arg1
                (fp #b0 #b00001 #b110)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b101)
                arg2
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                arg2
                (fp #b0 #b00100 #b011)))
; arg2 = -16.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b011)
                expect
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                expect
                (fp #b0 #b11101 #b011)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
(exit)
