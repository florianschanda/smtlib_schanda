(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0001 #b10)
                arg1
                (fp #b0 #b1101 #b01)))
(assert (fp.leq (fp #b0 #b1101 #b01)
                arg1
                (fp #b0 #b1111 #b00)))
; arg1 = 80.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0110 #b00)
                arg2
                (fp #b0 #b0111 #b01)))
(assert (fp.leq (fp #b0 #b0111 #b01)
                arg2
                (fp #b0 #b1101 #b11)))
; arg2 = 1.25

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0110 #b00)
                expect
                (fp #b0 #b1101 #b01)))
(assert (fp.leq (fp #b0 #b1101 #b01)
                expect
                (fp #b0 #b1111 #b00)))
; expect = 80.0

(assert (= expect result))

(check-sat)
(exit)
