(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10110101 #b01)
                arg1
                (fp #b1 #b10000001 #b00)))
(assert (fp.leq (fp #b1 #b10000001 #b00)
                arg1
                (fp #b0 #b01011001 #b00)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11101111 #b10)
                arg2
                (fp #b1 #b01100111 #b10)))
(assert (fp.leq (fp #b1 #b01100111 #b10)
                arg2
                (fp #b1 #b01001010 #b11)))
; arg2 = -0.0000000894069671630859375

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10010011 #b01)
                expect
                (fp #b1 #b10000001 #b00)))
(assert (fp.leq (fp #b1 #b10000001 #b00)
                expect
                (fp #b0 #b11111110 #b01)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
