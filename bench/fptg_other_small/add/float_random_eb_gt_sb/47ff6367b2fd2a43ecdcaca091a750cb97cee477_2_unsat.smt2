(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110111 #b100)
                arg1
                (fp #b0 #b011111 #b000)))
(assert (fp.leq (fp #b0 #b011111 #b000)
                arg1
                (fp #b0 #b100010 #b100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011110 #b010)
                arg2
                (fp #b0 #b101011 #b011)))
(assert (fp.leq (fp #b0 #b101011 #b011)
                arg2
                (fp #b0 #b101111 #b111)))
; arg2 = 5632.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b001)
                expect
                (fp #b0 #b101011 #b100)))
(assert (fp.leq (fp #b0 #b101011 #b100)
                expect
                (fp #b0 #b111001 #b000)))
; expect = 6144.0

(assert (not (= expect result)))

(check-sat)
(exit)
