(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010000 #b110)
                arg1
                (fp #b0 #b011111 #b100)))
(assert (fp.leq (fp #b0 #b011111 #b100)
                arg1
                (fp #b0 #b100110 #b110)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b110)
                arg2
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg2
                (fp #b0 #b000100 #b001)))
; arg2 = -1073741824.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b001)
                expect
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                expect
                (fp #b0 #b111001 #b011)))
; expect = -1073741824.0

(assert (not (= expect result)))

(check-sat)
(exit)
