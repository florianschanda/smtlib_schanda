(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b100 #b0)
                arg2
                (fp #b0 #b110 #b1)))
(assert (fp.leq (fp #b0 #b110 #b1)
                arg2
                (fp #b0 #b111 #b0)))
; arg2 = 12.0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
