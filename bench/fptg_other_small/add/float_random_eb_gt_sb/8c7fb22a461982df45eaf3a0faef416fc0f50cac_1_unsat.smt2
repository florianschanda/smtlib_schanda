(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b011001 #b110)
                arg1
                (fp #b0 #b011010 #b000)))
(assert (fp.leq (fp #b0 #b011010 #b000)
                arg1
                (fp #b0 #b101100 #b100)))
; arg1 = 0.03125

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111111 #b000)
                arg2
                (fp #b1 #b111110 #b111)))
(assert (fp.leq (fp #b1 #b111110 #b111)
                arg2
                (fp #b1 #b010011 #b101)))
; arg2 = -4026531840.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b111)
                expect
                (fp #b1 #b111110 #b110)))
(assert (fp.leq (fp #b1 #b111110 #b110)
                expect
                (fp #b0 #b001001 #b011)))
; expect = -3758096384.0

(assert (not (= expect result)))

(check-sat)
(exit)
