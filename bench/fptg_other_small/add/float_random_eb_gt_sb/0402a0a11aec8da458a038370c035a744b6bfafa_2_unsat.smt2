(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111010 #b01)
                arg1
                (fp #b1 #b011111 #b00)))
(assert (fp.leq (fp #b1 #b011111 #b00)
                arg1
                (fp #b0 #b001100 #b00)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b011000 #b11)
                arg2
                (fp #b0 #b110010 #b00)))
(assert (fp.leq (fp #b0 #b110010 #b00)
                arg2
                (fp #b0 #b111010 #b01)))
; arg2 = 524288.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011001 #b01)
                expect
                (fp #b0 #b110010 #b00)))
(assert (fp.leq (fp #b0 #b110010 #b00)
                expect
                (fp #b0 #b111100 #b00)))
; expect = 524288.0

(assert (not (= expect result)))

(check-sat)
(exit)
