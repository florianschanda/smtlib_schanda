(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0101 #b0)
                arg1
                (fp #b1 #b0001 #b0)))
(assert (fp.leq (fp #b1 #b0001 #b0)
                arg1
                (fp #b0 #b0100 #b1)))
; arg1 = -0.015625

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1000 #b0)
                arg2
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                arg2
                (fp #b0 #b0101 #b1)))
; arg2 = -0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1000 #b1)
                expect
                (fp #b1 #b0001 #b1)))
(assert (fp.leq (fp #b1 #b0001 #b1)
                expect
                (fp #b0 #b0111 #b0)))
; expect = -0.0234375

(assert (= expect result))

(check-sat)
(exit)
