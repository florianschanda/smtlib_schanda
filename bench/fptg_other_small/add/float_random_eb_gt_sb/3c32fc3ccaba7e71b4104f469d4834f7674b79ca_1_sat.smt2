; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b10000000 #b1010)
                arg1
                (fp #b0 #b11111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000)
                arg1
                (fp #b0 #b11111111 #b0000)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11011110 #b0100)
                arg2
                (fp #b1 #b11011100 #b0110)))
(assert (fp.leq (fp #b1 #b11011100 #b0110)
                arg2
                (fp #b0 #b11011011 #b1011)))
; arg2 = -13617340432139183023890366464.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b10000110 #b0010)
                expect
                (fp #b0 #b11111100 #b1111)))
(assert (fp.leq (fp #b0 #b11111100 #b1111)
                expect
                (fp #b0 #b11111110 #b1001)))
; expect = 82412135738664784120036037737381363712.0

(assert (= expect result))

(check-sat)
(exit)
