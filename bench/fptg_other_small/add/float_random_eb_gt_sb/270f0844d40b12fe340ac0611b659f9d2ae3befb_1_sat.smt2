; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000111 #b1100)
                arg1
                (fp #b1 #b000001 #b0000)))
(assert (fp.leq (fp #b1 #b000001 #b0000)
                arg1
                (fp #b0 #b100000 #b0111)))
; arg1 = -0.000000000931322574615478515625

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b0100)
                arg2
                (fp #b1 #b100111 #b1101)))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg2
                (fp #b0 #b011101 #b1110)))
; arg2 = -464.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111010 #b0110)
                expect
                (fp #b1 #b100111 #b1101)))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                expect
                (fp #b0 #b101101 #b1101)))
; expect = -464.0

(assert (= expect result))

(check-sat)
(exit)
