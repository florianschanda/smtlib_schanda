(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100100 #b1111)
                arg1
                (fp #b1 #b1000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000100 #b0000)
                arg1
                (fp #b0 #b0110001 #b0111)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0110010 #b1110)
                arg2
                (fp #b0 #b1001101 #b0000)))
(assert (fp.leq (fp #b0 #b1001101 #b0000)
                arg2
                (fp #b0 #b1001110 #b0001)))
; arg2 = 16384.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0111001 #b0110)
                expect
                (fp #b0 #b1001100 #b1111)))
(assert (fp.leq (fp #b0 #b1001100 #b1111)
                expect
                (fp #b0 #b1011111 #b0100)))
; expect = 15872.0

(assert (not (= expect result)))

(check-sat)
(exit)
