(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10000011 #b00)
                arg1
                (fp #b0 #b10000001 #b11)))
(assert (fp.leq (fp #b0 #b10000001 #b11)
                arg1
                (fp #b0 #b10100001 #b00)))
; arg1 = 7.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11100101 #b00)
                arg2
                (fp #b1 #b10110000 #b11)))
(assert (fp.leq (fp #b1 #b10110000 #b11)
                arg2
                (fp #b0 #b10001110 #b01)))
; arg2 = -985162418487296.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11001001 #b11)
                expect
                (fp #b1 #b10110000 #b10)))
(assert (fp.leq (fp #b1 #b10110000 #b10)
                expect
                (fp #b1 #b01010100 #b01)))
; expect = -844424930131968.0

(assert (= expect result))

(check-sat)
(exit)
