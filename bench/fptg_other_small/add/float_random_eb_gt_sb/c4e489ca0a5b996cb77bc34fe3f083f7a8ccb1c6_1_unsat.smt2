(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01001000 #b111)
                arg1
                (fp #b1 #b00000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000 #b000)
                arg1
                (fp #b0 #b11001111 #b100)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11001110 #b010)
                arg2
                (fp #b1 #b10001111 #b000)))
(assert (fp.leq (fp #b1 #b10001111 #b000)
                arg2
                (fp #b0 #b01011001 #b000)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110110 #b110)
                expect
                (fp #b1 #b10001111 #b000)))
(assert (fp.leq (fp #b1 #b10001111 #b000)
                expect
                (fp #b0 #b11010001 #b101)))
; expect = -65536.0

(assert (not (= expect result)))

(check-sat)
(exit)
