(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b100011 #b0001)
                expect
                (fp #b0 #b110010 #b1101)))
(assert (fp.leq (fp #b0 #b110010 #b1101)
                expect
                (fp #b0 #b111010 #b1101)))
; expect = 950272.0

(assert (= expect result))

