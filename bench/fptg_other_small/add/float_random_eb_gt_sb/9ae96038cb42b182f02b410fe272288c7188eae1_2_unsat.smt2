; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1001111 #b1101)
                arg1
                (fp #b0 #b0111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111 #b0110)
                arg1
                (fp #b0 #b0111111 #b0111)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111000 #b1000)
                arg2
                (fp #b1 #b1101101 #b1110)))
(assert (fp.leq (fp #b1 #b1101101 #b1110)
                arg2
                (fp #b0 #b1011000 #b1100)))
; arg2 = -131941395333120.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101110 #b0111)
                expect
                (fp #b1 #b1101101 #b1110)))
(assert (fp.leq (fp #b1 #b1101101 #b1110)
                expect
                (fp #b0 #b0000010 #b1001)))
; expect = -131941395333120.0

(assert (not (= expect result)))

(check-sat)
(exit)
