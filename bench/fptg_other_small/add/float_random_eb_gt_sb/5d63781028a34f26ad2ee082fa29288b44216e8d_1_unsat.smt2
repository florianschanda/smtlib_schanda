(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b100)
                arg1
                (fp #b1 #b011111 #b101)))
(assert (fp.leq (fp #b1 #b011111 #b101)
                arg1
                (fp #b1 #b000011 #b100)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b111010 #b010)
                arg2
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg2
                (fp #b0 #b100110 #b110)))
; arg2 = -0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b111)
                expect
                (fp #b1 #b011111 #b101)))
(assert (fp.leq (fp #b1 #b011111 #b101)
                expect
                (fp #b0 #b100110 #b001)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
