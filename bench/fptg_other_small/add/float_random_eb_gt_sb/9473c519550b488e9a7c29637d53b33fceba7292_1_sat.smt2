                arg2
                (fp #b0 #b10111110 #b1111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111)
                arg2
                (fp #b0 #b11100010 #b1010)))
; arg2 = 17870283321406128128.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11110100 #b0100)
                expect
                (fp #b1 #b11011000 #b0011)))
(assert (fp.leq (fp #b1 #b11011000 #b0011)
                expect
                (fp #b1 #b01010001 #b0110)))
; expect = -735026898325694538221355008.0

(assert (= expect result))

(check-sat)
