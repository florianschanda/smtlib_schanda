(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110010 #b111)
                arg1
                (fp #b1 #b011111 #b100)))
(assert (fp.leq (fp #b1 #b011111 #b100)
                arg1
                (fp #b1 #b000001 #b000)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100000 #b100)
                arg2
                (fp #b0 #b010011 #b000)))
(assert (fp.leq (fp #b0 #b010011 #b000)
                arg2
                (fp #b0 #b100011 #b000)))
; arg2 = 0.000244140625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b110)
                expect
                (fp #b1 #b011111 #b011)))
(assert (fp.leq (fp #b1 #b011111 #b011)
                expect
                (fp #b0 #b100000 #b000)))
; expect = -1.375

(assert (not (= expect result)))

(check-sat)
(exit)
