(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01001 #b10)
                arg1
                (fp #b0 #b10110 #b11)))
(assert (fp.leq (fp #b0 #b10110 #b11)
                arg1
                (fp #b0 #b11111 #b00)))
; arg1 = 224.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00001 #b00)
                arg2
                (fp #b0 #b10001 #b00)))
(assert (fp.leq (fp #b0 #b10001 #b00)
                arg2
                (fp #b0 #b10010 #b01)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11010 #b10)
                expect
                (fp #b0 #b10111 #b00)))
(assert (fp.leq (fp #b0 #b10111 #b00)
                expect
                (fp #b0 #b11010 #b10)))
; expect = 256.0

(assert (not (= expect result)))

(check-sat)
(exit)
