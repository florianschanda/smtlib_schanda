(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100011 #b00)
                arg1
                (fp #b0 #b001111 #b00)))
(assert (fp.leq (fp #b0 #b001111 #b00)
                arg1
                (fp #b0 #b111010 #b00)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg2
                (fp #b0 #b010000 #b00)))
(assert (fp.leq (fp #b0 #b010000 #b00)
                arg2
                (fp #b0 #b111001 #b11)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101111 #b10)
                expect
                (fp #b0 #b010000 #b10)))
(assert (fp.leq (fp #b0 #b010000 #b10)
                expect
                (fp #b0 #b101101 #b01)))
; expect = 0.0000457763671875

(assert (= expect result))

(check-sat)
(exit)
