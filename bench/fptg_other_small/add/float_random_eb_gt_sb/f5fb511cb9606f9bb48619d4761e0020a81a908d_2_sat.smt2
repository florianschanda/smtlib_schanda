;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111001 #b111)
                arg1
                (fp #b1 #b0000000 #b001)))
(assert (fp.leq (fp #b1 #b0000000 #b001)
                arg1
                (fp #b0 #b1001110 #b111)))
; arg1 = -0.00000000000000000002710505431213761085018632002174854278564453125

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0101011 #b011)
                arg2
                (fp #b0 #b1000001 #b000)))
(assert (fp.leq (fp #b0 #b1000001 #b000)
                arg2
                (fp #b0 #b1000011 #b011)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0001010 #b110)
                expect
                (fp #b0 #b1000001 #b000)))
(assert (fp.leq (fp #b0 #b1000001 #b000)
                expect
                (fp #b0 #b1011111 #b001)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
