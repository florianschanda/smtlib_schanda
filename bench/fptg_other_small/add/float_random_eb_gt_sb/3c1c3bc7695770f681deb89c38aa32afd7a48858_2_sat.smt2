(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b10)
                arg1
                (fp #b1 #b01100 #b01)))
(assert (fp.leq (fp #b1 #b01100 #b01)
                arg1
                (fp #b0 #b10111 #b10)))
; arg1 = -0.15625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11000 #b00)
                arg2
                (fp #b0 #b00000 #b10)))
(assert (fp.leq (fp #b0 #b00000 #b10)
                arg2
                (fp #b0 #b10100 #b01)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b10)
                expect
                (fp #b1 #b01100 #b01)))
(assert (fp.leq (fp #b1 #b01100 #b01)
                expect
                (fp #b0 #b01101 #b10)))
; expect = -0.15625

(assert (= expect result))

(check-sat)
(exit)
