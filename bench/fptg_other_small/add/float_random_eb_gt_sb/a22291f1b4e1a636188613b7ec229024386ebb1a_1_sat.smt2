(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11101000 #b0110)
                arg1
                (fp #b1 #b10000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000100 #b0000)
                arg1
                (fp #b1 #b01010111 #b0010)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00101110 #b0100)
                arg2
                (fp #b0 #b00000001 #b0000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000)
                arg2
                (fp #b0 #b10110001 #b1110)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10101111 #b0011)
                expect
                (fp #b1 #b10000011 #b1111)))
(assert (fp.leq (fp #b1 #b10000011 #b1111)
                expect
                (fp #b0 #b00000101 #b1101)))
; expect = -31.0

(assert (= expect result))

(check-sat)
(exit)
