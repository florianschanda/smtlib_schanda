(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110111 #b100)
                arg1
                (fp #b1 #b110110 #b100)))
(assert (fp.leq (fp #b1 #b110110 #b100)
                arg1
                (fp #b0 #b010011 #b011)))
; arg1 = -12582912.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b001100 #b111)
                arg2
                (fp #b0 #b011111 #b101)))
(assert (fp.leq (fp #b0 #b011111 #b101)
                arg2
                (fp #b0 #b111110 #b011)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b101)
                expect
                (fp #b1 #b110110 #b100)))
(assert (fp.leq (fp #b1 #b110110 #b100)
                expect
                (fp #b0 #b110100 #b110)))
; expect = -12582912.0

(assert (= expect result))

(check-sat)
(exit)
