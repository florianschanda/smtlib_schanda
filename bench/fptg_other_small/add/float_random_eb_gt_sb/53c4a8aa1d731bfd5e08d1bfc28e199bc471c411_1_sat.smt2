(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b11)
                arg1
                (fp #b1 #b0111 #b00)))
(assert (fp.leq (fp #b1 #b0111 #b00)
                arg1
                (fp #b0 #b1000 #b01)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg2
                (fp #b1 #b1011 #b11)))
(assert (fp.leq (fp #b1 #b1011 #b11)
                arg2
                (fp #b1 #b1000 #b10)))
; arg2 = -28.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b00)
                expect
                (fp #b1 #b1011 #b11)))
(assert (fp.leq (fp #b1 #b1011 #b11)
                expect
                (fp #b0 #b0011 #b00)))
; expect = -28.0

(assert (= expect result))

(check-sat)
(exit)
