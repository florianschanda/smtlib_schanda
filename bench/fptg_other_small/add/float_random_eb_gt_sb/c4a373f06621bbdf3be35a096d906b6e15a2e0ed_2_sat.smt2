(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111111 #b00000)
                arg1
                (fp #b1 #b1111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111110 #b11111)
                arg1
                (fp #b0 #b1110100 #b00011)))
; arg1 = -18158513697557839872.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111101 #b01101)
                arg2
                (fp #b1 #b1111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111101 #b00000)
                arg2
                (fp #b0 #b1100100 #b11010)))
; arg2 = -4611686018427387904.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
