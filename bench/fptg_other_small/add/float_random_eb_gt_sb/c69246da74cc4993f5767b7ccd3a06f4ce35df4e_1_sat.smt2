(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000110 #b011)
                arg1
                (fp #b1 #b000001 #b000)))
(assert (fp.leq (fp #b1 #b000001 #b000)
                arg1
                (fp #b0 #b111101 #b101)))
; arg1 = -0.000000000931322574615478515625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b000)
                arg2
                (fp #b0 #b100000 #b100)))
(assert (fp.leq (fp #b0 #b100000 #b100)
                arg2
                (fp #b0 #b111101 #b000)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010000 #b110)
                expect
                (fp #b0 #b100000 #b011)))
(assert (fp.leq (fp #b0 #b100000 #b011)
                expect
                (fp #b0 #b101010 #b101)))
; expect = 2.75

(assert (= expect result))

(check-sat)
(exit)
