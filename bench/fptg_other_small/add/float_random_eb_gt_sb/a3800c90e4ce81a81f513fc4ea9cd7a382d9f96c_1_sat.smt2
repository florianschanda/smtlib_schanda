(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01101 #b0)
                arg1
                (fp #b1 #b00000 #b0)))
(assert (fp.leq (fp #b1 #b00000 #b0)
                arg1
                (fp #b0 #b00001 #b0)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b1)
                arg2
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg2
                (fp #b1 #b01001 #b0)))
; arg2 = -192.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11001 #b1)
                expect
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                expect
                (fp #b0 #b10100 #b0)))
; expect = -192.0

(assert (= expect result))

(check-sat)
(exit)
