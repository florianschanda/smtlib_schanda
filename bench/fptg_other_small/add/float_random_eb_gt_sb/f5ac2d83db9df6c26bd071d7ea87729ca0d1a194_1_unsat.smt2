(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01111 #b111)
                arg1
                (fp #b1 #b01111 #b100)))
(assert (fp.leq (fp #b1 #b01111 #b100)
                arg1
                (fp #b0 #b10110 #b010)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00100 #b011)
                arg2
                (fp #b0 #b10110 #b111)))
(assert (fp.leq (fp #b0 #b10110 #b111)
                arg2
                (fp #b0 #b11101 #b111)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00001 #b000)
                expect
                (fp #b0 #b10110 #b110)))
(assert (fp.leq (fp #b0 #b10110 #b110)
                expect
                (fp #b0 #b11011 #b101)))
; expect = 224.0

(assert (not (= expect result)))

(check-sat)
(exit)
