(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b11)
                arg1
                (fp #b1 #b11101 #b00)))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg1
                (fp #b0 #b01010 #b00)))
; arg1 = -16384.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b10)
                arg2
                (fp #b1 #b01111 #b10)))
(assert (fp.leq (fp #b1 #b01111 #b10)
                arg2
                (fp #b0 #b01000 #b11)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b10)
                expect
                (fp #b1 #b11101 #b00)))
(assert (fp.leq (fp #b1 #b11101 #b00)
                expect
                (fp #b0 #b11110 #b10)))
; expect = -16384.0

(assert (= expect result))

(check-sat)
(exit)
