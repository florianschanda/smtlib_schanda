                arg2
                (fp #b1 #b0100000 #b0)))
(assert (fp.leq (fp #b1 #b0100000 #b0)
                arg2
                (fp #b0 #b1100001 #b1)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1001111 #b0)
                expect
                (fp #b1 #b0111111 #b1)))
(assert (fp.leq (fp #b1 #b0111111 #b1)
                expect
                (fp #b1 #b0001000 #b0)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
