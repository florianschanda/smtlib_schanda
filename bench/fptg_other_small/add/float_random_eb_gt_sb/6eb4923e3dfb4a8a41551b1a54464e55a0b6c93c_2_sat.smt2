(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010001 #b01)
                arg1
                (fp #b0 #b111101 #b00)))
(assert (fp.leq (fp #b0 #b111101 #b00)
                arg1
                (fp #b0 #b111110 #b00)))
; arg1 = 1073741824.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b01)
                arg2
                (fp #b0 #b011111 #b11)))
(assert (fp.leq (fp #b0 #b011111 #b11)
                arg2
                (fp #b0 #b101110 #b00)))
; arg2 = 1.75

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010011 #b00)
                expect
                (fp #b0 #b111101 #b01)))
(assert (fp.leq (fp #b0 #b111101 #b01)
                expect
                (fp #b0 #b111101 #b11)))
; expect = 1342177280.0

(assert (= expect result))

(check-sat)
(exit)
