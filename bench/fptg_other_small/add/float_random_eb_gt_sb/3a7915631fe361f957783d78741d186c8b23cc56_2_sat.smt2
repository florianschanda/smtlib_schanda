(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00000 #b01)
                arg1
                (fp #b0 #b01000 #b00)))
(assert (fp.leq (fp #b0 #b01000 #b00)
                arg1
                (fp #b0 #b10000 #b00)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b11100 #b10)
                arg2
                (fp #b0 #b11101 #b01)))
(assert (fp.leq (fp #b0 #b11101 #b01)
                arg2
                (fp #b0 #b11111 #b00)))
; arg2 = 20480.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01110 #b00)
                expect
                (fp #b0 #b11101 #b10)))
(assert (fp.leq (fp #b0 #b11101 #b10)
                expect
                (fp #b0 #b11110 #b00)))
; expect = 24576.0

(assert (= expect result))

(check-sat)
(exit)
