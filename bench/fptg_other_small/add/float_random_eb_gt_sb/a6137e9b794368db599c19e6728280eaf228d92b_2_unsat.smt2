(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b0000 #b0)
                arg1
                (fp #b0 #b0100 #b0)))
(assert (fp.leq (fp #b0 #b0100 #b0)
                arg1
                (fp #b0 #b1011 #b0)))
; arg1 = 0.125

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1101 #b0)
                arg2
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                arg2
                (fp #b0 #b0011 #b0)))
; arg2 = -0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b1)
                expect
                (fp #b0 #b0100 #b0)))
(assert (fp.leq (fp #b0 #b0100 #b0)
                expect
                (fp #b0 #b1010 #b0)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
