(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010010 #b11)
                arg1
                (fp #b0 #b100011 #b10)))
(assert (fp.leq (fp #b0 #b100011 #b10)
                arg1
                (fp #b0 #b111001 #b00)))
; arg1 = 24.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101011 #b11)
                arg2
                (fp #b1 #b100001 #b10)))
(assert (fp.leq (fp #b1 #b100001 #b10)
                arg2
                (fp #b0 #b001111 #b10)))
; arg2 = -6.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110001 #b11)
                expect
                (fp #b0 #b100011 #b00)))
(assert (fp.leq (fp #b0 #b100011 #b00)
                expect
                (fp #b0 #b110101 #b10)))
; expect = 16.0

(assert (not (= expect result)))

(check-sat)
(exit)
