(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01000 #b101)
                arg1
                (fp #b0 #b10010 #b000)))
(assert (fp.leq (fp #b0 #b10010 #b000)
                arg1
                (fp #b0 #b10010 #b100)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b011)
                expect
                (fp #b0 #b10011 #b000)))
(assert (fp.leq (fp #b0 #b10011 #b000)
                expect
                (fp #b0 #b10110 #b110)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
