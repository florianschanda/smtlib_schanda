(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00000010 #b0011)
                arg1
                (fp #b0 #b01111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111 #b0110)
                arg1
                (fp #b0 #b11010011 #b0011)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10010010 #b1011)
                arg2
                (fp #b1 #b01110011 #b0000)))
(assert (fp.leq (fp #b1 #b01110011 #b0000)
                arg2
                (fp #b0 #b01010001 #b0100)))
; arg2 = -0.000244140625

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11001000 #b0110)
                expect
                (fp #b0 #b01111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111 #b0110)
                expect
                (fp #b0 #b11001110 #b0010)))
; expect = 1.375

(assert (not (= expect result)))

(check-sat)
(exit)
