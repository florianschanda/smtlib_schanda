(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11110111 #b1)
                arg1
                (fp #b1 #b10010011 #b1)))
(assert (fp.leq (fp #b1 #b10010011 #b1)
                arg1
                (fp #b0 #b00011101 #b0)))
; arg1 = -1572864.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11110001 #b0)
                arg2
                (fp #b1 #b10110100 #b0)))
(assert (fp.leq (fp #b1 #b10110100 #b0)
                arg2
                (fp #b0 #b00011001 #b1)))
; arg2 = -9007199254740992.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001110 #b0)
                expect
                (fp #b1 #b10110100 #b1)))
(assert (fp.leq (fp #b1 #b10110100 #b1)
                expect
                (fp #b1 #b01100111 #b1)))
; expect = -13510798882111488.0

(assert (= expect result))

(check-sat)
(exit)
