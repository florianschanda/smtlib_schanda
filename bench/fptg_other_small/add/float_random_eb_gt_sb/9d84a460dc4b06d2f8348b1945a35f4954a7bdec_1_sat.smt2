(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b110011 #b1101)
                arg1
                (fp #b0 #b111110 #b0000)))
(assert (fp.leq (fp #b0 #b111110 #b0000)
                arg1
                (fp #b0 #b111110 #b0110)))
; arg1 = 2147483648.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101010 #b1100)
                arg2
                (fp #b1 #b000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000 #b1111)
                arg2
                (fp #b0 #b101010 #b1001)))
; arg2 = -0.0000000008731149137020111083984375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b000110 #b1000)
                expect
                (fp #b0 #b111101 #b1111)))
(assert (fp.leq (fp #b0 #b111101 #b1111)
                expect
                (fp #b0 #b111110 #b0101)))
; expect = 2080374784.0

(assert (= expect result))

(check-sat)
(exit)
