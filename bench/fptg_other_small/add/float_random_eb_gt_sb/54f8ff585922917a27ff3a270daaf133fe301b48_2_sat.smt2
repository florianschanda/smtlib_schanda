; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000111 #b000)
                arg1
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg1
                (fp #b0 #b11010000 #b101)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00101100 #b011)
                arg2
                (fp #b0 #b00010000 #b011)))
(assert (fp.leq (fp #b0 #b00010000 #b011)
                arg2
                (fp #b0 #b10011011 #b010)))
; arg2 = 0.000000000000000000000000000000000529630734706489859590393934210855012597977953259231753690983168780803680419921875

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01011100 #b010)
                expect
                (fp #b0 #b10000011 #b001)))
(assert (fp.leq (fp #b0 #b10000011 #b001)
                expect
                (fp #b0 #b10100000 #b100)))
; expect = 18.0

(assert (= expect result))

(check-sat)
(exit)
