(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101110 #b101)
                arg1
                (fp #b0 #b0000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000 #b010)
                arg1
                (fp #b0 #b0001100 #b011)))
; arg1 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110001 #b101)
                arg2
                (fp #b0 #b0111111 #b101)))
(assert (fp.leq (fp #b0 #b0111111 #b101)
                arg2
                (fp #b0 #b1111110 #b011)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0011100 #b011)
                expect
                (fp #b0 #b0111111 #b101)))
(assert (fp.leq (fp #b0 #b0111111 #b101)
                expect
                (fp #b0 #b1100000 #b011)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
