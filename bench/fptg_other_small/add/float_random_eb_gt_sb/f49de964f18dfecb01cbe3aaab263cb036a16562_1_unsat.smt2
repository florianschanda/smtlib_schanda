; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01010000 #b1000)
                arg1
                (fp #b0 #b01111111 #b0100)))
(assert (fp.leq (fp #b0 #b01111111 #b0100)
                arg1
                (fp #b0 #b10010101 #b0010)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111101 #b1101)
                arg2
                (fp #b1 #b11111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000)
                arg2
                (fp #b0 #b10101000 #b0000)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111111 #b0000)
                expect
                (fp #b1 #b11111100 #b1111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111)
                expect
                (fp #b1 #b10111100 #b1101)))
; expect = -82412135738664784120036037737381363712.0

(assert (not (= expect result)))

(check-sat)
(exit)
