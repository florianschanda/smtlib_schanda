(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01101 #b11)
                arg1
                (fp #b1 #b00000 #b11)))
(assert (fp.leq (fp #b1 #b00000 #b11)
                arg1
                (fp #b0 #b10110 #b10)))
; arg1 = -0.0000457763671875

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b01110 #b00)
                arg2
                (fp #b0 #b11110 #b11)))
(assert (fp.leq (fp #b0 #b11110 #b11)
                arg2
                (fp #b0 #b11111 #b00)))
; arg2 = 57344.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00001 #b10)
                expect
                (fp #b0 #b11110 #b10)))
(assert (fp.leq (fp #b0 #b11110 #b10)
                expect
                (fp #b0 #b11110 #b11)))
; expect = 49152.0

(assert (= expect result))

(check-sat)
(exit)
