(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111010 #b11)
                arg1
                (fp #b1 #b100010 #b00)))
(assert (fp.leq (fp #b1 #b100010 #b00)
                arg1
                (fp #b0 #b101011 #b11)))
; arg1 = -8.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110100 #b10)
                arg2
                (fp #b1 #b011111 #b10)))
(assert (fp.leq (fp #b1 #b011111 #b10)
                arg2
                (fp #b0 #b011001 #b00)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110110 #b11)
                expect
                (fp #b1 #b100010 #b00)))
(assert (fp.leq (fp #b1 #b100010 #b00)
                expect
                (fp #b0 #b100000 #b01)))
; expect = -8.0

(assert (not (= expect result)))

(check-sat)
(exit)
