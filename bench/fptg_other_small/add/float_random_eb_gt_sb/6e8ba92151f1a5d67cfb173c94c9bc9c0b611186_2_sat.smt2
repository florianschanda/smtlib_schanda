(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110010 #b11)
                arg1
                (fp #b1 #b100110 #b01)))
(assert (fp.leq (fp #b1 #b100110 #b01)
                arg1
                (fp #b0 #b001101 #b00)))
; arg1 = -160.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001101 #b11)
                arg2
                (fp #b0 #b010000 #b00)))
(assert (fp.leq (fp #b0 #b010000 #b00)
                arg2
                (fp #b0 #b101001 #b01)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101011 #b10)
                expect
                (fp #b1 #b100110 #b01)))
(assert (fp.leq (fp #b1 #b100110 #b01)
                expect
                (fp #b0 #b001111 #b00)))
; expect = -160.0

(assert (= expect result))

(check-sat)
(exit)
