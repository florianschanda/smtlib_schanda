                (fp #b1 #b10000 #b000)))
(assert (fp.leq (fp #b1 #b10000 #b000)
                arg2
                (fp #b0 #b10100 #b010)))
; arg2 = -2.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10001 #b101)
                expect
                (fp #b1 #b10000 #b001)))
(assert (fp.leq (fp #b1 #b10000 #b001)
                expect
                (fp #b0 #b11101 #b111)))
; expect = -2.25

(assert (not (= expect result)))

