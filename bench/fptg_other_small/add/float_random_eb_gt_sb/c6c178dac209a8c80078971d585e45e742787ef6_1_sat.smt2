                (fp #b0 #b000000 #b0001)))
(assert (fp.leq (fp #b0 #b000000 #b0001)
                arg2
                (fp #b0 #b100101 #b1101)))
; arg2 = 0.0000000000582076609134674072265625

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011111 #b1110)
                expect
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                expect
                (fp #b0 #b111111 #b0000)))
; expect = 4160749568.0

(assert (= expect result))

(check-sat)
(exit)
