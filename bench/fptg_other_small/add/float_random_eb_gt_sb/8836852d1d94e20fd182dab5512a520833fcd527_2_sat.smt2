(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00011010 #b100100)
                arg1
                (fp #b0 #b00000000 #b111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111)
                arg1
                (fp #b0 #b10111010 #b010111)))
; arg1 = 0.000000000000000000000000000000000000011571272515906892656567250288281480891027489074475236539851774608678169897757470607757568359375

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11101111 #b011011)
                arg2
                (fp #b1 #b01111111 #b100001)))
(assert (fp.leq (fp #b1 #b01111111 #b100001)
                arg2
                (fp #b0 #b10100001 #b001101)))
; arg2 = -1.515625

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11001100 #b010011)
                expect
                (fp #b1 #b01111111 #b100001)))
(assert (fp.leq (fp #b1 #b01111111 #b100001)
                expect
                (fp #b0 #b01011011 #b111011)))
; expect = -1.515625

(assert (= expect result))

(check-sat)
(exit)
