; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b101)
                arg1
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg1
                (fp #b0 #b10110 #b010)))
; arg1 = -0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01010 #b110)
                arg2
                (fp #b0 #b01110 #b111)))
(assert (fp.leq (fp #b0 #b01110 #b111)
                arg2
                (fp #b0 #b11011 #b010)))
; arg2 = 0.9375

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00111 #b011)
                expect
                (fp #b0 #b01110 #b110)))
(assert (fp.leq (fp #b0 #b01110 #b110)
                expect
                (fp #b0 #b10011 #b100)))
; expect = 0.875

(assert (= expect result))

(check-sat)
(exit)
