; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111001 #b1000)
                arg1
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                arg1
                (fp #b0 #b111111 #b0000)))
; arg1 = 4160749568.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010011 #b1010)
                arg2
                (fp #b0 #b111101 #b0000)))
(assert (fp.leq (fp #b0 #b111101 #b0000)
                arg2
                (fp #b0 #b111101 #b0011)))
; arg2 = 1073741824.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011101 #b0101)
                expect
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                expect
                (fp #b0 #b111111 #b0000)))
; expect = 4160749568.0

(assert (not (= expect result)))

(check-sat)
(exit)
