(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10001 #b011)
                arg1
                (fp #b0 #b10010 #b000)))
(assert (fp.leq (fp #b0 #b10010 #b000)
                arg1
                (fp #b0 #b11001 #b010)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10111 #b101)
                arg2
                (fp #b0 #b01100 #b011)))
(assert (fp.leq (fp #b0 #b01100 #b011)
                arg2
                (fp #b0 #b10001 #b101)))
; arg2 = 0.171875

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b101)
                expect
                (fp #b0 #b10010 #b001)))
(assert (fp.leq (fp #b0 #b10010 #b001)
                expect
                (fp #b0 #b10110 #b001)))
; expect = 9.0

(assert (= expect result))

(check-sat)
(exit)
