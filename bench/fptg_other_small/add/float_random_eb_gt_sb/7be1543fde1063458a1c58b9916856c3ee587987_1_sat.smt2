(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10010010 #b1)
                arg1
                (fp #b1 #b10010001 #b0)))
(assert (fp.leq (fp #b1 #b10010001 #b0)
                arg1
                (fp #b0 #b00001000 #b1)))
; arg1 = -262144.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10111010 #b0)
                arg2
                (fp #b0 #b10101111 #b1)))
(assert (fp.leq (fp #b0 #b10101111 #b1)
                arg2
                (fp #b0 #b11011011 #b1)))
; arg2 = 422212465065984.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10110000 #b0)
                expect
                (fp #b0 #b10101111 #b0)))
(assert (fp.leq (fp #b0 #b10101111 #b0)
                expect
                (fp #b0 #b11010100 #b1)))
; expect = 281474976710656.0

(assert (= expect result))

(check-sat)
(exit)
