(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0101100 #b00111)
                arg1
                (fp #b0 #b1110100 #b01011)))
(assert (fp.leq (fp #b0 #b1110100 #b01011)
                arg1
                (fp #b0 #b1111100 #b01001)))
; arg1 = 12103423998558208.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0111000 #b10011)
                arg2
                (fp #b0 #b1010101 #b01011)))
(assert (fp.leq (fp #b0 #b1010101 #b01011)
                arg2
                (fp #b0 #b1011111 #b10101)))
; arg2 = 5636096.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0000101 #b10000)
                expect
                (fp #b0 #b1110100 #b01011)))
(assert (fp.leq (fp #b0 #b1110100 #b01011)
                expect
                (fp #b0 #b1111110 #b11110)))
; expect = 12103423998558208.0

(assert (= expect result))

(check-sat)
(exit)
