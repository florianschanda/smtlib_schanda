; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b01110111 #b11000)
                arg1
                (fp #b0 #b01111111 #b00000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000)
                arg1
                (fp #b0 #b11111000 #b11110)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111000 #b01000)
                arg2
                (fp #b1 #b10111110 #b11111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111)
                arg2
                (fp #b0 #b01001110 #b10100)))
; arg2 = -18158513697557839872.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11000100 #b11111)
                expect
                (fp #b1 #b10111110 #b11110)))
(assert (fp.leq (fp #b1 #b10111110 #b11110)
                expect
                (fp #b0 #b01010110 #b01110)))
; expect = -17870283321406128128.0

(assert (= expect result))

(check-sat)
(exit)
