(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11010100 #b10)
                arg1
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg1
                (fp #b0 #b00110110 #b01)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b10011100 #b10)
                arg2
                (fp #b0 #b11001011 #b11)))
(assert (fp.leq (fp #b0 #b11001011 #b11)
                arg2
                (fp #b0 #b11011111 #b00)))
; arg2 = 132226261520350065983488.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b00100011 #b00)
                expect
                (fp #b0 #b11001011 #b10)))
(assert (fp.leq (fp #b0 #b11001011 #b10)
                expect
                (fp #b0 #b11011110 #b01)))
; expect = 113336795588871485128704.0

(assert (= expect result))

(check-sat)
(exit)
