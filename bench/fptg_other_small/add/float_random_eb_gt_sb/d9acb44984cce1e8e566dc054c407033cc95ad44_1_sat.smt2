(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11011 #b011)
                arg1
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                arg1
                (fp #b0 #b11100 #b011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01100 #b100)
                arg2
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                arg2
                (fp #b0 #b11010 #b101)))
; arg2 = -0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01011 #b100)
                expect
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                expect
                (fp #b0 #b01001 #b100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
