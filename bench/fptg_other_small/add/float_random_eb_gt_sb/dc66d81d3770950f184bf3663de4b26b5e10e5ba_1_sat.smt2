;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg1
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                arg1
                (fp #b1 #b110111 #b01)))
; arg1 = -3758096384.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100010 #b10)
                arg2
                (fp #b0 #b001001 #b01)))
(assert (fp.leq (fp #b0 #b001001 #b01)
                arg2
                (fp #b0 #b110111 #b01)))
; arg2 = 0.000000298023223876953125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111110 #b11)
                expect
                (fp #b1 #b111110 #b10)))
(assert (fp.leq (fp #b1 #b111110 #b10)
                expect
                (fp #b1 #b111100 #b00)))
; expect = -3221225472.0

(assert (= expect result))

(check-sat)
(exit)
