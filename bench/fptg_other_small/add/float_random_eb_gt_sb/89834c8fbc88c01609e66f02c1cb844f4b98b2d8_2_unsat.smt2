(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100110 #b0)
                arg1
                (fp #b1 #b001111 #b1)))
(assert (fp.leq (fp #b1 #b001111 #b1)
                arg1
                (fp #b1 #b000011 #b0)))
; arg1 = -0.00002288818359375

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110101 #b1)
                arg2
                (fp #b1 #b011111 #b0)))
(assert (fp.leq (fp #b1 #b011111 #b0)
                arg2
                (fp #b0 #b100011 #b1)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110100 #b0)
                expect
                (fp #b1 #b011111 #b1)))
(assert (fp.leq (fp #b1 #b011111 #b1)
                expect
                (fp #b1 #b010100 #b0)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
