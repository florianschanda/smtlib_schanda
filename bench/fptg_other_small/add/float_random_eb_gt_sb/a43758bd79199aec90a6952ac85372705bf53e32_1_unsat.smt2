(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001100 #b1)
                arg1
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                arg1
                (fp #b0 #b100100 #b1)))
; arg1 = 0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111000 #b0)
                arg2
                (fp #b1 #b101111 #b0)))
(assert (fp.leq (fp #b1 #b101111 #b0)
                arg2
                (fp #b0 #b011000 #b0)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111100 #b0)
                expect
                (fp #b1 #b101110 #b1)))
(assert (fp.leq (fp #b1 #b101110 #b1)
                expect
                (fp #b0 #b001110 #b0)))
; expect = -49152.0

(assert (not (= expect result)))

(check-sat)
(exit)
