(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11011110 #b01100)
                arg1
                (fp #b0 #b11111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000)
                arg1
                (fp #b0 #b11111110 #b10110)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10111010 #b11011)
                arg2
                (fp #b1 #b10000100 #b11110)))
(assert (fp.leq (fp #b1 #b10000100 #b11110)
                arg2
                (fp #b1 #b01000000 #b11101)))
; arg2 = -62.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b01010001 #b00100)
                expect
                (fp #b0 #b11111100 #b11111)))
(assert (fp.leq (fp #b0 #b11111100 #b11111)
                expect
                (fp #b0 #b11111110 #b01010)))
; expect = 83741363734449699992939844797661708288.0

(assert (= expect result))

(check-sat)
(exit)
