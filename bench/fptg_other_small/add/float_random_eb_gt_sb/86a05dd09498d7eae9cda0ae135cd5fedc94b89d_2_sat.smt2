(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00110011 #b01)
                arg1
                (fp #b0 #b01000000 #b00)))
(assert (fp.leq (fp #b0 #b01000000 #b00)
                arg1
                (fp #b0 #b01111111 #b00)))
; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011000 #b10)
                arg2
                (fp #b1 #b10000010 #b01)))
(assert (fp.leq (fp #b1 #b10000010 #b01)
                arg2
                (fp #b0 #b00011101 #b00)))
; arg2 = -10.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11100011 #b11)
                expect
                (fp #b1 #b10000010 #b01)))
(assert (fp.leq (fp #b1 #b10000010 #b01)
                expect
                (fp #b0 #b10111010 #b10)))
; expect = -10.0

(assert (= expect result))

(check-sat)
(exit)
