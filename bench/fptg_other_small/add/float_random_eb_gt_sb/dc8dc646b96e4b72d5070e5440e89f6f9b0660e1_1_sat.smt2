(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1010010 #b00001)
                arg1
                (fp #b1 #b1000100 #b10101)))
(assert (fp.leq (fp #b1 #b1000100 #b10101)
                arg1
                (fp #b0 #b1111110 #b01001)))
; arg1 = -53.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111001 #b10111)
                arg2
                (fp #b0 #b0000000 #b10100)))
(assert (fp.leq (fp #b0 #b0000000 #b10100)
                arg2
                (fp #b0 #b0000010 #b11110)))
; arg2 = 0.00000000000000000013552527156068805425093160010874271392822265625

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1011101 #b11101)
                expect
                (fp #b1 #b1000100 #b10100)))
(assert (fp.leq (fp #b1 #b1000100 #b10100)
                expect
                (fp #b0 #b1001011 #b00110)))
; expect = -52.0

(assert (= expect result))

(check-sat)
(exit)
