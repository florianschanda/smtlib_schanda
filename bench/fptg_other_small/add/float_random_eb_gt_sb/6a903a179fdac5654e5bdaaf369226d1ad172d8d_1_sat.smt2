(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010110 #b11)
                arg1
                (fp #b0 #b101110 #b11)))
(assert (fp.leq (fp #b0 #b101110 #b11)
                arg1
                (fp #b0 #b111010 #b01)))
; arg1 = 57344.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100110 #b10)
                arg2
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg2
                (fp #b0 #b110011 #b10)))
; arg2 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010001 #b11)
                expect
                (fp #b0 #b101110 #b11)))
(assert (fp.leq (fp #b0 #b101110 #b11)
                expect
                (fp #b0 #b110101 #b10)))
; expect = 57344.0

(assert (= expect result))

(check-sat)
(exit)
