(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111010 #b011)
                arg1
                (fp #b1 #b0111111 #b000)))
(assert (fp.leq (fp #b1 #b0111111 #b000)
                arg1
                (fp #b0 #b0001111 #b000)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0100001 #b000)
                arg2
                (fp #b0 #b1111110 #b111)))
(assert (fp.leq (fp #b0 #b1111110 #b111)
                arg2
                (fp #b0 #b1111111 #b000)))
; arg2 = 17293822569102704640.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111101 #b111)
                expect
                (fp #b0 #b1111110 #b110)))
(assert (fp.leq (fp #b0 #b1111110 #b110)
                expect
                (fp #b0 #b1111111 #b000)))
; expect = 16140901064495857664.0

(assert (= expect result))

(check-sat)
(exit)
