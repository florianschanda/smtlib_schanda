                arg2
                (fp #b0 #b1111111 #b00)))
; arg2 = 13835058055282163712.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1001101 #b10)
                expect
                (fp #b0 #b1111110 #b01)))
(assert (fp.leq (fp #b0 #b1111110 #b01)
                expect
                (fp #b0 #b1111110 #b11)))
; expect = 11529215046068469760.0

(assert (not (= expect result)))

