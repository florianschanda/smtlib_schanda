(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b1)
                arg1
                (fp #b1 #b01000 #b0)))
(assert (fp.leq (fp #b1 #b01000 #b0)
                arg1
                (fp #b0 #b01000 #b0)))
; arg1 = -0.0078125

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10011 #b0)
                arg2
                (fp #b1 #b00000 #b1)))
(assert (fp.leq (fp #b1 #b00000 #b1)
                arg2
                (fp #b0 #b10001 #b1)))
; arg2 = -0.000030517578125

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b1)
                expect
                (fp #b1 #b01000 #b1)))
(assert (fp.leq (fp #b1 #b01000 #b1)
                expect
                (fp #b0 #b01111 #b1)))
; expect = -0.01171875

(assert (not (= expect result)))

(check-sat)
(exit)
