                arg2
                (fp #b0 #b1000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000100 #b0000)
                arg2
                (fp #b0 #b1101010 #b1011)))
; arg2 = 32.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0011011 #b0111)
                expect
                (fp #b0 #b1000011 #b1111)))
(assert (fp.leq (fp #b0 #b1000011 #b1111)
                expect
                (fp #b0 #b1000100 #b0101)))
; expect = 31.0

(assert (= expect result))

(check-sat)
(exit)
