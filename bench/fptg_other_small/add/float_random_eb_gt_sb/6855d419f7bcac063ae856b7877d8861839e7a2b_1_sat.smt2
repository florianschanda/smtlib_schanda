;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0100010 #b1011)
                arg1
                (fp #b1 #b0000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000 #b0100)
                arg1
