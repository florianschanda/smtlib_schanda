(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110101 #b110)
                arg1
                (fp #b1 #b011111 #b000)))
(assert (fp.leq (fp #b1 #b011111 #b000)
                arg1
                (fp #b0 #b110001 #b110)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b001001 #b001)
                arg2
                (fp #b0 #b001110 #b011)))
(assert (fp.leq (fp #b0 #b001110 #b011)
                arg2
                (fp #b0 #b101001 #b111)))
; arg2 = 0.00001049041748046875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111010 #b101)
                expect
                (fp #b1 #b011111 #b000)))
(assert (fp.leq (fp #b1 #b011111 #b000)
                expect
                (fp #b0 #b000100 #b101)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
