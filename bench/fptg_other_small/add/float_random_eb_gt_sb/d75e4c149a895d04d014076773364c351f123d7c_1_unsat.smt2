(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01100 #b1)
                arg1
                (fp #b0 #b11101 #b0)))
(assert (fp.leq (fp #b0 #b11101 #b0)
                arg1
                (fp #b0 #b11111 #b0)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11110 #b0)
                arg2
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg2
                (fp #b0 #b00010 #b0)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                expect
                (fp #b0 #b11100 #b1)))
(assert (fp.leq (fp #b0 #b11100 #b1)
                expect
                (fp #b0 #b11110 #b1)))
; expect = 12288.0

(assert (not (= expect result)))

(check-sat)
(exit)
