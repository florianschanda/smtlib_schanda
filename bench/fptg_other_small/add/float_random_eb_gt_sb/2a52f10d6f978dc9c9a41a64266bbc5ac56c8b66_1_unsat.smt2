; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011111 #b001)
                arg1
                (fp #b1 #b001000 #b100)))
(assert (fp.leq (fp #b1 #b001000 #b100)
                arg1
                (fp #b0 #b011110 #b000)))
; arg1 = -0.000000178813934326171875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100011 #b001)
                arg2
                (fp #b1 #b100000 #b000)))
(assert (fp.leq (fp #b1 #b100000 #b000)
                arg2
                (fp #b0 #b110100 #b111)))
; arg2 = -2.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b011)
                expect
                (fp #b1 #b100000 #b000)))
(assert (fp.leq (fp #b1 #b100000 #b000)
                expect
                (fp #b0 #b111101 #b110)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
