(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010100 #b10)
                arg1
                (fp #b1 #b1000010 #b00)))
(assert (fp.leq (fp #b1 #b1000010 #b00)
                arg1
                (fp #b0 #b1001111 #b11)))
; arg1 = -8.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0111011 #b11)
                arg2
                (fp #b0 #b0000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000 #b10)
                arg2
                (fp #b0 #b0011000 #b00)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101100 #b01)
                expect
                (fp #b1 #b1000001 #b11)))
(assert (fp.leq (fp #b1 #b1000001 #b11)
                expect
                (fp #b1 #b0001001 #b10)))
; expect = -7.0

(assert (= expect result))

(check-sat)
(exit)
