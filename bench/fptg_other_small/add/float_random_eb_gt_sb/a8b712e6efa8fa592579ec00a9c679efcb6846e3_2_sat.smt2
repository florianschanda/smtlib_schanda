(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b100001 #b1110)
                arg1
                (fp #b0 #b101110 #b1111)))
(assert (fp.leq (fp #b0 #b101110 #b1111)
                arg1
                (fp #b0 #b110000 #b0101)))
; arg1 = 63488.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011100 #b1001)
                arg2
                (fp #b0 #b000000 #b0111)))
(assert (fp.leq (fp #b0 #b000000 #b0111)
                arg2
                (fp #b0 #b101001 #b0110)))
; arg2 = 0.0000000004074536263942718505859375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100010 #b0101)
                expect
                (fp #b0 #b101111 #b0000)))
(assert (fp.leq (fp #b0 #b101111 #b0000)
                expect
                (fp #b0 #b110001 #b0000)))
; expect = 65536.0

(assert (= expect result))

(check-sat)
(exit)
