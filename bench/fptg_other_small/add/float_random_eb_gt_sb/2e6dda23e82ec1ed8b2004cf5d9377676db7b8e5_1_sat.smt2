; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1000010 #b10)
                arg1
                (fp #b0 #b0000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000 #b00)
                arg1
                (fp #b0 #b1000000 #b01)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111101 #b00)
                arg2
                (fp #b1 #b0000001 #b00)))
(assert (fp.leq (fp #b1 #b0000001 #b00)
                arg2
                (fp #b0 #b0110011 #b11)))
; arg2 = -0.00000000000000000021684043449710088680149056017398834228515625

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1100100 #b10)
                expect
                (fp #b1 #b0000001 #b00)))
(assert (fp.leq (fp #b1 #b0000001 #b00)
                expect
                (fp #b0 #b1000001 #b11)))
; expect = -0.00000000000000000021684043449710088680149056017398834228515625

(assert (= expect result))

(check-sat)
(exit)
