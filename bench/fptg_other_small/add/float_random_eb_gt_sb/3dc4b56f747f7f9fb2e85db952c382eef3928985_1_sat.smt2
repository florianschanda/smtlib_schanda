(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011110 #b0000)
                arg1
                (fp #b0 #b000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000 #b0100)
                arg1
                (fp #b0 #b001101 #b1101)))
; arg1 = 0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010110 #b1000)
                arg2
                (fp #b0 #b100100 #b0100)))
(assert (fp.leq (fp #b0 #b100100 #b0100)
                arg2
                (fp #b0 #b110011 #b0111)))
; arg2 = 40.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010110 #b1001)
                expect
                (fp #b0 #b100100 #b0100)))
(assert (fp.leq (fp #b0 #b100100 #b0100)
                expect
                (fp #b0 #b101111 #b0100)))
; expect = 40.0

(assert (= expect result))

(check-sat)
(exit)
