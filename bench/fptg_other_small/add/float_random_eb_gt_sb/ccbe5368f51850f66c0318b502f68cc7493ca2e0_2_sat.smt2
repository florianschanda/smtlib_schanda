(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101011 #b011)
                arg1
                (fp #b1 #b1011110 #b111)))
(assert (fp.leq (fp #b1 #b1011110 #b111)
                arg1
                (fp #b0 #b0001111 #b001)))
; arg1 = -4026531840.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1001010 #b010)
                arg2
                (fp #b1 #b0111111 #b000)))
(assert (fp.leq (fp #b1 #b0111111 #b000)
                arg2
                (fp #b0 #b1111001 #b100)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111010 #b110)
                expect
                (fp #b1 #b1011111 #b000)))
(assert (fp.leq (fp #b1 #b1011111 #b000)
                expect
                (fp #b0 #b0010001 #b110)))
; expect = -4294967296.0

(assert (= expect result))

(check-sat)
(exit)
