(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b011 #b0)
                arg1
                (fp #b1 #b001 #b1)))
(assert (fp.leq (fp #b1 #b001 #b1)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = -0.375

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg2
                (fp #b1 #b011 #b1)))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg2
                (fp #b0 #b101 #b0)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                expect
                (fp #b1 #b011 #b1)))
(assert (fp.leq (fp #b1 #b011 #b1)
                expect
                (fp #b0 #b001 #b1)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
