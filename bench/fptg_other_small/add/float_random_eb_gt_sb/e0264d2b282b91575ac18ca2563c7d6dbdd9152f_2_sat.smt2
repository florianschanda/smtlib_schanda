                arg2
                (fp #b0 #b01100 #b1)))
; arg2 = -0.005859375

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10010 #b0)
                expect
                (fp #b0 #b11110 #b1)))
(assert (fp.leq (fp #b0 #b11110 #b1)
                expect
                (fp #b0 #b11111 #b0)))
; expect = 49152.0

(assert (= expect result))

(check-sat)
