(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010100 #b101)
                arg1
                (fp #b1 #b10001110 #b011)))
(assert (fp.leq (fp #b1 #b10001110 #b011)
                arg1
                (fp #b0 #b10001000 #b011)))
; arg1 = -45056.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111110 #b100)
                arg2
                (fp #b1 #b11111101 #b000)))
(assert (fp.leq (fp #b1 #b11111101 #b000)
                arg2
                (fp #b0 #b11000101 #b011)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111110 #b011)
                expect
                (fp #b1 #b11111101 #b000)))
(assert (fp.leq (fp #b1 #b11111101 #b000)
                expect
                (fp #b0 #b01110001 #b110)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
