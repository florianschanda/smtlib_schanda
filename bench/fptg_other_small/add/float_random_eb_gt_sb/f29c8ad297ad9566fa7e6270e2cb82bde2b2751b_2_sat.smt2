(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b001)
                arg1
                (fp #b0 #b000000 #b110)))
(assert (fp.leq (fp #b0 #b000000 #b110)
                arg1
                (fp #b0 #b000111 #b100)))
; arg1 = 0.00000000069849193096160888671875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100110 #b111)
                arg2
                (fp #b0 #b100001 #b000)))
(assert (fp.leq (fp #b0 #b100001 #b000)
                arg2
                (fp #b0 #b110101 #b111)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101011 #b101)
                expect
                (fp #b0 #b100001 #b001)))
(assert (fp.leq (fp #b0 #b100001 #b001)
                expect
                (fp #b0 #b111101 #b011)))
; expect = 4.5

(assert (= expect result))

(check-sat)
(exit)
