(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11000 #b100)
                arg1
                (fp #b1 #b10010 #b110)))
(assert (fp.leq (fp #b1 #b10010 #b110)
                arg1
                (fp #b0 #b00001 #b010)))
; arg1 = -14.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10101 #b000)
                arg2
                (fp #b1 #b01111 #b101)))
(assert (fp.leq (fp #b1 #b01111 #b101)
                arg2
                (fp #b1 #b00101 #b001)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b000)
                expect
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                expect
                (fp #b0 #b01101 #b111)))
; expect = -16.0

(assert (= expect result))

(check-sat)
(exit)
