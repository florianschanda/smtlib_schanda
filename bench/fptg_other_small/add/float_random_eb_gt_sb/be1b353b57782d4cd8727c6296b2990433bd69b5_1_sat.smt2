(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0101110 #b10110)
                expect
                (fp #b0 #b1000100 #b01011)))
(assert (fp.leq (fp #b0 #b1000100 #b01011)
                expect
                (fp #b0 #b1010001 #b01110)))
; expect = 43.0

(assert (= expect result))

