                arg2
                (fp #b0 #b010011 #b000)))
(assert (fp.leq (fp #b0 #b010011 #b000)
                arg2
                (fp #b0 #b100110 #b011)))
; arg2 = 0.000244140625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b010)
                expect
                (fp #b0 #b010011 #b000)))
(assert (fp.leq (fp #b0 #b010011 #b000)
                expect
                (fp #b0 #b111101 #b100)))
; expect = 0.000244140625

(assert (not (= expect result)))

(check-sat)
