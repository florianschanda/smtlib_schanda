(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11100 #b10)
                arg1
                (fp #b0 #b01001 #b00)))
(assert (fp.leq (fp #b0 #b01001 #b00)
                arg1
                (fp #b0 #b11101 #b10)))
; arg1 = 0.015625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00111 #b11)
                arg2
                (fp #b1 #b00000 #b01)))
(assert (fp.leq (fp #b1 #b00000 #b01)
                arg2
                (fp #b0 #b00011 #b10)))
; arg2 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01110 #b00)
                expect
                (fp #b0 #b01000 #b11)))
(assert (fp.leq (fp #b0 #b01000 #b11)
                expect
                (fp #b0 #b11000 #b11)))
; expect = 0.013671875

(assert (not (= expect result)))

(check-sat)
(exit)
