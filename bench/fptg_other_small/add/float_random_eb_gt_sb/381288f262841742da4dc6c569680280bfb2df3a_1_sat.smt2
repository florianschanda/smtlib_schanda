(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b110)
                arg1
                (fp #b0 #b01000 #b001)))
(assert (fp.leq (fp #b0 #b01000 #b001)
                arg1
                (fp #b0 #b01011 #b001)))
; arg1 = 0.0087890625

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b100)
                arg2
                (fp #b1 #b10000 #b000)))
(assert (fp.leq (fp #b1 #b10000 #b000)
                arg2
                (fp #b0 #b01111 #b100)))
; arg2 = -2.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b000)
                expect
                (fp #b1 #b01111 #b111)))
(assert (fp.leq (fp #b1 #b01111 #b111)
                expect
                (fp #b1 #b00110 #b000)))
; expect = -1.875

(assert (= expect result))

(check-sat)
(exit)
