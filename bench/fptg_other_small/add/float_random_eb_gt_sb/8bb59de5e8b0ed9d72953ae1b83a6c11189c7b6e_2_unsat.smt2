                arg2
                (fp #b0 #b11110 #b11)))
(assert (fp.leq (fp #b0 #b11110 #b11)
                arg2
                (fp #b0 #b11111 #b00)))
; arg2 = 57344.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
