                (fp #b0 #b0110101 #b00)))
(assert (fp.leq (fp #b0 #b0110101 #b00)
                arg2
                (fp #b0 #b1110111 #b10)))
; arg2 = 0.0009765625

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1001100 #b01)
                expect
                (fp #b0 #b0110101 #b00)))
(assert (fp.leq (fp #b0 #b0110101 #b00)
                expect
                (fp #b0 #b1010010 #b00)))
; expect = 0.0009765625

(assert (= expect result))

(check-sat)
