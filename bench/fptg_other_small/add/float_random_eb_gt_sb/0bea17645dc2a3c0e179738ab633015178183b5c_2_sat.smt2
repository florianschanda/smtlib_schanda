; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001001 #b01111)
                arg1
                (fp #b0 #b0111111 #b00111)))
(assert (fp.leq (fp #b0 #b0111111 #b00111)
                arg1
                (fp #b0 #b1000100 #b00011)))
; arg1 = 1.21875

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b1100011 #b11001)
                arg2
                (fp #b0 #b1111101 #b00010)))
(assert (fp.leq (fp #b0 #b1111101 #b00010)
                arg2
                (fp #b0 #b1111101 #b10101)))
; arg2 = 4899916394579099648.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0110101 #b11111)
                expect
                (fp #b0 #b1111101 #b00011)))
(assert (fp.leq (fp #b0 #b1111101 #b00011)
                expect
                (fp #b0 #b1111110 #b11011)))
; expect = 5044031582654955520.0

(assert (= expect result))

(check-sat)
(exit)
