(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110110 #b1000)
                arg1
                (fp #b0 #b101111 #b1011)))
(assert (fp.leq (fp #b0 #b101111 #b1011)
                arg1
                (fp #b0 #b110111 #b0010)))
; arg1 = 110592.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101010 #b1001)
                arg2
                (fp #b1 #b100111 #b1101)))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg2
                (fp #b1 #b100011 #b0111)))
; arg2 = -464.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011110 #b0110)
                expect
                (fp #b0 #b101111 #b1011)))
(assert (fp.leq (fp #b0 #b101111 #b1011)
                expect
                (fp #b0 #b110100 #b1011)))
; expect = 110592.0

(assert (not (= expect result)))

(check-sat)
(exit)
