; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010111 #b00)
                arg1
                (fp #b0 #b011010 #b00)))
(assert (fp.leq (fp #b0 #b011010 #b00)
                arg1
                (fp #b0 #b011110 #b11)))
; arg1 = 0.03125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011001 #b00)
                arg2
                (fp #b0 #b010000 #b00)))
(assert (fp.leq (fp #b0 #b010000 #b00)
                arg2
                (fp #b0 #b111001 #b10)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101000 #b10)
                expect
                (fp #b0 #b011010 #b01)))
(assert (fp.leq (fp #b0 #b011010 #b01)
                expect
                (fp #b0 #b100101 #b10)))
; expect = 0.0390625

(assert (not (= expect result)))

(check-sat)
(exit)
