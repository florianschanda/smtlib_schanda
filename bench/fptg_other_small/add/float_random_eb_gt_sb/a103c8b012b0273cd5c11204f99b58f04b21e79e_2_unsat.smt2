(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0101 #b11)
                arg1
                (fp #b1 #b0000 #b10)))
(assert (fp.leq (fp #b1 #b0000 #b10)
                arg1
                (fp #b0 #b0110 #b11)))
; arg1 = -0.0078125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b11)
                arg2
                (fp #b0 #b1001 #b10)))
(assert (fp.leq (fp #b0 #b1001 #b10)
                arg2
                (fp #b0 #b1110 #b00)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b01)
                expect
                (fp #b0 #b1001 #b10)))
(assert (fp.leq (fp #b0 #b1001 #b10)
                expect
                (fp #b0 #b1100 #b00)))
; expect = 6.0

(assert (not (= expect result)))

(check-sat)
(exit)
