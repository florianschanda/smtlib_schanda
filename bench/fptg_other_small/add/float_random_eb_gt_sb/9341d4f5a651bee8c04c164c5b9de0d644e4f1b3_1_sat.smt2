(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111110 #b11)
                arg1
                (fp #b1 #b11110110 #b00)))
(assert (fp.leq (fp #b1 #b11110110 #b00)
                arg1
                (fp #b0 #b11100010 #b01)))
; arg1 = -664613997892457936451903530140172288.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111001 #b10)
                arg2
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg2
                (fp #b1 #b01001001 #b00)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111110 #b11)
                expect
                (fp #b1 #b11110110 #b00)))
(assert (fp.leq (fp #b1 #b11110110 #b00)
                expect
                (fp #b0 #b00110010 #b00)))
; expect = -664613997892457936451903530140172288.0

(assert (= expect result))

(check-sat)
(exit)
