; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0001001 #b0011)
                arg1
                (fp #b0 #b1000011 #b0110)))
(assert (fp.leq (fp #b0 #b1000011 #b0110)
                arg1
                (fp #b0 #b1110111 #b0010)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111111 #b0000)
                arg2
                (fp #b1 #b1111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111)
                arg2
                (fp #b0 #b1011111 #b1100)))
; arg2 = -17870283321406128128.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111111 #b0000)
                expect
                (fp #b1 #b1111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111)
                expect
                (fp #b0 #b0100011 #b0010)))
; expect = -17870283321406128128.0

(assert (= expect result))

(check-sat)
(exit)
