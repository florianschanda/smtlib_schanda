; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000101 #b00)
                arg1
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg1
                (fp #b0 #b100011 #b11)))
; arg1 = 0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b01)
                arg2
                (fp #b1 #b111101 #b00)))
(assert (fp.leq (fp #b1 #b111101 #b00)
                arg2
                (fp #b0 #b010001 #b01)))
; arg2 = -1073741824.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111110 #b00)
                expect
                (fp #b1 #b111100 #b11)))
(assert (fp.leq (fp #b1 #b111100 #b11)
                expect
                (fp #b0 #b100010 #b10)))
; expect = -939524096.0

(assert (not (= expect result)))

(check-sat)
(exit)
