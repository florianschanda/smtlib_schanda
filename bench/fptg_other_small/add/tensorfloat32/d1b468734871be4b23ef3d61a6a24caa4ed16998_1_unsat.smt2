                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b01111000 #b1011110010)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011001 #b0111110010)
                expect
                (fp #b1 #b10001010 #b0010000100)))
(assert (fp.leq (fp #b1 #b10001010 #b0010000100)
                expect
                (fp #b0 #b01101011 #b0111001100)))
; expect = -2312.0

(assert (not (= expect result)))

(check-sat)
(exit)
