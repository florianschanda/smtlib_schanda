(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100100 #b1000001000)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11000111 #b1111101010)))
; arg1 = 1.59765625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001000 #b1101001101)
                arg2
                (fp #b1 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b01000000 #b1110100001)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111111 #b0101100011)
                expect
                (fp #b0 #b01111111 #b1001100011)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100011)
                expect
                (fp #b0 #b11000100 #b0011010011)))
; expect = 1.5966796875

(assert (= expect result))

(check-sat)
(exit)
