(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000110 #b1010001100)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b11110001 #b1001011100)))
; arg1 = 1872.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100011 #b0111000011)
                arg2
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b11111101 #b0000011100)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01101110 #b1001110000)
                expect
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                expect
                (fp #b0 #b10001011 #b0011110000)))
; expect = 1872.0

(assert (= expect result))

(check-sat)
(exit)
