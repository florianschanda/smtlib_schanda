; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000100 #b0100100100)
                arg1
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                arg1
                (fp #b0 #b10111110 #b0111010001)))
