                arg2
                (fp #b0 #b00000100 #b0101100010)))
(assert (fp.leq (fp #b0 #b00000100 #b0101100010)
                arg2
                (fp #b0 #b00100101 #b0001001100)))
; arg2 = 0.000000000000000000000000000000000000126549313705711889529759292835332386252665713846245047237426550879035858088172972202301025390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010011 #b1010011001)
                expect
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                expect
                (fp #b0 #b10100010 #b1100010110)))
; expect = 1671.0

(assert (= expect result))

(check-sat)
(exit)
