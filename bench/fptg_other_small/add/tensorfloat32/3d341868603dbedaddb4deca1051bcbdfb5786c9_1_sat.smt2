(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01100000 #b1010011101)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b00100100 #b1010001100)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010100 #b1000011011)
                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b0 #b10111000 #b1010110111)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b1000001101)
                expect
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                expect
                (fp #b1 #b10000110 #b0110100001)))
; expect = -48404256449413863440384.0

(assert (= expect result))

(check-sat)
(exit)
