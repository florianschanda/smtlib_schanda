(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b10001111 #b1110010011)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101011 #b0111010000)
                expect
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                expect
                (fp #b1 #b00100001 #b1011101000)))
; expect = -18437736874454810624.0

(assert (= expect result))

(check-sat)
