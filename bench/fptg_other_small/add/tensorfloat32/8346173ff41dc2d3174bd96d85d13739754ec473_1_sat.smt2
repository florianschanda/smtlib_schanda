                expect
                (fp #b0 #b11000011 #b1111001010)))
(assert (fp.leq (fp #b0 #b11000011 #b1111001010)
                expect
                (fp #b0 #b11010010 #b0000111101)))
; expect = 574731370046513217536.0

(assert (= expect result))

(check-sat)
