                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b10111001 #b0100110011)))
; arg2 = 0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1100011011)
                expect
                (fp #b0 #b01111111 #b0000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000001)
                expect
                (fp #b0 #b11101011 #b1111100001)))
; expect = 1.0009765625

(assert (not (= expect result)))

(check-sat)
(exit)
