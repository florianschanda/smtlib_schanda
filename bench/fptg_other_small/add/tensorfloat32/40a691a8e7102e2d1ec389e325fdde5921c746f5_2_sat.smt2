                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b11011010 #b0100010011)))
; arg1 = 18437736874454810624.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100111 #b0101000111)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11100010 #b0010011100)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0000101110)
                expect
                (fp #b0 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000000)
                expect
                (fp #b0 #b11101111 #b0000001011)))
; expect = 18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
