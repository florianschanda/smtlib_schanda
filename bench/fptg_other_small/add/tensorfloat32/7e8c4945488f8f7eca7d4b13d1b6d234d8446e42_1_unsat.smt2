; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010010 #b1101100100)
                arg1
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                arg1
                (fp #b0 #b11110010 #b1110101101)))
; arg1 = 1671.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b0100101011)
                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b0 #b11011001 #b0110000100)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010011 #b0011110110)
                expect
                (fp #b1 #b11001010 #b0100011111)))
(assert (fp.leq (fp #b1 #b11001010 #b0100011111)
                expect
                (fp #b0 #b11010001 #b0100100000)))
; expect = -48367362961266444337152.0

(assert (not (= expect result)))

(check-sat)
(exit)
