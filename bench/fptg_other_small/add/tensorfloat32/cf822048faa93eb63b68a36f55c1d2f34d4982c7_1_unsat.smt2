                arg2
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b00111000 #b0101011011)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101111 #b0110111010)
                expect
                (fp #b0 #b01111110 #b0011001000)))
(assert (fp.leq (fp #b0 #b01111110 #b0011001000)
                expect
                (fp #b0 #b10011001 #b1011101101)))
; expect = 0.59765625

(assert (not (= expect result)))

(check-sat)
(exit)
