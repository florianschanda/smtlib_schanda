(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001110 #b1101010000)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01100011 #b0000001000)))
; arg1 = -264.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000011 #b1101111111)
                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b10011000 #b0010011100)))
; arg2 = 0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010100 #b1101011101)
                expect
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                expect
                (fp #b0 #b00010010 #b0101110001)))
; expect = -264.0

(assert (= expect result))

(check-sat)
(exit)
