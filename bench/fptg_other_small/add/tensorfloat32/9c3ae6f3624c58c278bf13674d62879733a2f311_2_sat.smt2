                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11000000 #b0101111101)))
; arg1 = 1.59765625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b1011100111)
                arg2
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b11111100 #b0000110101)))
; arg2 = 0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b0000011101)
                expect
                (fp #b0 #b01111111 #b1001100101)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100101)
                expect
                (fp #b0 #b11011000 #b0001100110)))
; expect = 1.5986328125

(assert (= expect result))

(check-sat)
(exit)
