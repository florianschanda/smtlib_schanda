                arg2
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg2
                (fp #b1 #b01111001 #b0101110000)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0000111011)
                expect
                (fp #b1 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000001)
                expect
                (fp #b0 #b10001110 #b0101010010)))
; expect = -85153668479971173107900139799209574400.0

(assert (not (= expect result)))

(check-sat)
(exit)
