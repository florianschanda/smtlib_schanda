(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101101 #b1010100101)
                arg1
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b00111011 #b1001010101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b0101001011)
                arg2
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b1 #b10110010 #b0001001110)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011010 #b1110101100)
                expect
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                expect
                (fp #b0 #b10100111 #b0101111011)))
; expect = -165773953014656025581584384.0

(assert (= expect result))

(check-sat)
(exit)
