(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001111 #b0100101010)
                arg1
                (fp #b0 #b00000000 #b1111111000)))
