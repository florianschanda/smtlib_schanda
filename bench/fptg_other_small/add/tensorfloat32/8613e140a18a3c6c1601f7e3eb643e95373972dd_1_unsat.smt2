(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b10100100 #b1101011101)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101111 #b1111000111)
                expect
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                expect
                (fp #b0 #b10101000 #b0111110111)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
