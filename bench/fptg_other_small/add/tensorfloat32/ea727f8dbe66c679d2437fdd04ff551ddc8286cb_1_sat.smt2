(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg2
                (fp #b1 #b00101011 #b1010101101)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100100 #b1001010001)
                expect
                (fp #b0 #b11000011 #b1111001001)))
(assert (fp.leq (fp #b0 #b11000011 #b1111001001)
                expect
                (fp #b0 #b11011000 #b0101100000)))
; expect = 574443139670361505792.0

(assert (= expect result))

(check-sat)
