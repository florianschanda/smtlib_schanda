(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010000 #b0001001000)
                arg1
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b11111010 #b0000011001)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010111 #b1001110000)
                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b01010011 #b1001000111)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001111 #b0001001011)
                expect
                (fp #b1 #b10000000 #b0000010011)))
(assert (fp.leq (fp #b1 #b10000000 #b0000010011)
                expect
                (fp #b1 #b00010000 #b1100110001)))
; expect = -2.037109375

(assert (= expect result))

(check-sat)
(exit)
