; Format: TENSORFLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: +NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                arg1
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                arg1
                (fp #b1 #b01100000 #b0101010010)))
; arg1 = -340116213421465348979261631549233168384.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
