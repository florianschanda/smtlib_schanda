;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010011 #b1101101000)
                arg1
                (fp #b1 #b00000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000 #b1010010101)
