; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000111 #b1101111101)
                arg1
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                arg1
                (fp #b1 #b01101101 #b0111111011)))
; arg1 = -1.98828125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111010 #b1100001011)
                arg2
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b01110011 #b0000000010)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b0010000110)
                expect
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                expect
                (fp #b0 #b01010001 #b0110110001)))
; expect = -1.98828125

(assert (= expect result))

(check-sat)
(exit)
