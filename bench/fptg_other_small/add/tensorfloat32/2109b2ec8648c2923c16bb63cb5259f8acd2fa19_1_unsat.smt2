(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b1100001011)
                expect
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                expect
                (fp #b0 #b11001100 #b0010111001)))
; expect = -85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
