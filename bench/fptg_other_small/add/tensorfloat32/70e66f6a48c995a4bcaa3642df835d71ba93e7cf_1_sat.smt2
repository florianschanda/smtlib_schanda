(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100010 #b1011100101)
                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b11000111 #b1010011011)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101011 #b0001100001)
                expect
                (fp #b1 #b01111111 #b0011111101)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111101)
                expect
                (fp #b0 #b10111000 #b0010000001)))
; expect = -1.2470703125

(assert (= expect result))

(check-sat)
(exit)
