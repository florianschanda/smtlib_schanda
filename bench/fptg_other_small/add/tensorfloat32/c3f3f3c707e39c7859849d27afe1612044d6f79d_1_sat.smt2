                arg2
                (fp #b0 #b10000010 #b1100010001)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b1100100101)
                expect
                (fp #b1 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111111)
                expect
                (fp #b1 #b10111111 #b1000110101)))
; expect = -85029053355366337244815407887308292096.0

(assert (= expect result))

(check-sat)
(exit)
