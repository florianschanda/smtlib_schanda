                arg2
                (fp #b0 #b11111110 #b0100110010)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10011101 #b1010110001)
                expect
                (fp #b0 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000001)
                expect
                (fp #b0 #b11111110 #b1001000010)))
; expect = 85153668479971173107900139799209574400.0

(assert (= expect result))

(check-sat)
(exit)
