(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001000 #b1100001101)
                arg1
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b00110110 #b0010000000)))
; arg1 = -18437736874454810624.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
