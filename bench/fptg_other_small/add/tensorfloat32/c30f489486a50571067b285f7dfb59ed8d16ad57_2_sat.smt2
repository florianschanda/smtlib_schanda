(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01000101 #b0001001101)
                arg2
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b11110110 #b1001010111)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1010001111)
                expect
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                expect
                (fp #b1 #b01111011 #b0101000011)))
; expect = -218824158806091775576789237298651725824.0

(assert (= expect result))

(check-sat)
(exit)
