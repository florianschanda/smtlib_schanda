(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0100110000)
                arg1
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                arg1
                (fp #b0 #b01011111 #b0011000111)))
