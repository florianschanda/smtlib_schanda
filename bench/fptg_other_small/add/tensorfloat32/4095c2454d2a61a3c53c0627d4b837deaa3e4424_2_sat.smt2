(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010101 #b0011101000)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b11111100 #b0100101110)))
; arg1 = -1.203125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010001 #b1110001110)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b10001110 #b0011101001)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1010100110)
                expect
                (fp #b0 #b10001001 #b0100110111)))
(assert (fp.leq (fp #b0 #b10001001 #b0100110111)
                expect
                (fp #b0 #b10111101 #b1110010110)))
; expect = 1335.0

(assert (= expect result))

(check-sat)
(exit)
