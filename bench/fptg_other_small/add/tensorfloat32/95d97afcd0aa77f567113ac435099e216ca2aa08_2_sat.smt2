                arg2
                (fp #b0 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b11010000 #b0010110110)))
; arg2 = 307090161664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001110 #b0101101100)
                expect
                (fp #b0 #b10100101 #b0001111001)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111001)
                expect
                (fp #b0 #b11101010 #b1001001110)))
; expect = 307358597120.0

(assert (= expect result))

(check-sat)
(exit)
