;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111000 #b0001100110)
                arg1
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b00111001 #b1101100000)))
; arg1 = -0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000110 #b0111000010)
                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b11110101 #b1101110100)))
; arg2 = -18437736874454810624.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010011 #b0110110100)
                expect
                (fp #b1 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b0000000000)
                expect
                (fp #b0 #b01101000 #b0101001001)))
; expect = -18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
