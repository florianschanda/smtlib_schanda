                arg2
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11001111 #b0000100000)))
; arg2 = 2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101111 #b1101101011)
                expect
                (fp #b0 #b10001010 #b1101000100)))
(assert (fp.leq (fp #b0 #b10001010 #b1101000100)
                expect
                (fp #b0 #b10100000 #b0000000000)))
; expect = 3720.0

(assert (not (= expect result)))

(check-sat)
(exit)
