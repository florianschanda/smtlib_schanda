(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11010010 #b1110110101)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011101 #b1100011110)
                expect
                (fp #b0 #b10001001 #b0100111001)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111001)
                expect
                (fp #b0 #b11011011 #b0011100001)))
; expect = 1337.0

(assert (= expect result))

(check-sat)
