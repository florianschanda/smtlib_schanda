                arg2
                (fp #b0 #b10001111 #b1100000100)))
; arg2 = 439.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111010 #b1000101101)
                expect
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                expect
                (fp #b0 #b11000110 #b1111011001)))
; expect = 18437736874454810624.0

(assert (= expect result))

