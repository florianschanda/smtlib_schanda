                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11001111 #b1110011010)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b1101101011)
                expect
                (fp #b0 #b10001001 #b0100110111)))
(assert (fp.leq (fp #b0 #b10001001 #b0100110111)
                expect
                (fp #b0 #b10111011 #b1000110110)))
; expect = 1335.0

(assert (not (= expect result)))

(check-sat)
(exit)
