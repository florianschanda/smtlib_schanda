;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1110110101)
                arg1
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg1
                (fp #b1 #b10000000 #b1111111101)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100011 #b1100111110)
                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11101010 #b0110101101)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0001101000)
                expect
                (fp #b1 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111111)
                expect
                (fp #b1 #b00101100 #b1001110100)))
; expect = -85029053355366337244815407887308292096.0

(assert (= expect result))

(check-sat)
(exit)
