; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01110011 #b0101101110)
                arg1
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                arg1
                (fp #b0 #b11100011 #b1000111100)))
; arg1 = 1737314271232.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b1111010000)
                arg2
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b0 #b01011011 #b0010100010)))
; arg2 = -13052620958651699370655744.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b0001100000)
                expect
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                expect
                (fp #b1 #b10000110 #b1100011000)))
; expect = -13052620958651699370655744.0

(assert (= expect result))

(check-sat)
(exit)
