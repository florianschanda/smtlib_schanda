                expect
                (fp #b1 #b11010010 #b0101100101)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100101)
                expect
                (fp #b0 #b00001101 #b1100000111)))
; expect = -13043176225685960080228352.0

(assert (= expect result))

