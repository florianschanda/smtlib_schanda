(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001101 #b1001110111)
                expect
                (fp #b1 #b01111111 #b0011111101)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111101)
                expect
                (fp #b0 #b10100101 #b0100110101)))
; expect = -1.2470703125

(assert (= expect result))

(check-sat)
