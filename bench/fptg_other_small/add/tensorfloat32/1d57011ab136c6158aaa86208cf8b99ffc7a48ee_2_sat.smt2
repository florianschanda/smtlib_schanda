                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b10001100 #b0100001010)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b0110011001)
                expect
                (fp #b1 #b11110100 #b1110010101)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010101)
                expect
                (fp #b0 #b10000111 #b0001011110)))
; expect = -314945256325503138343052917969256448.0

(assert (= expect result))

(check-sat)
(exit)
