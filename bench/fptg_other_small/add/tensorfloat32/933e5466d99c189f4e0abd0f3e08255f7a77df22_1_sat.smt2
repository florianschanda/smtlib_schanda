(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11110110 #b1010100001)))
; arg2 = 2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b0101110111)
                expect
                (fp #b1 #b11100110 #b0100111011)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111011)
                expect
                (fp #b1 #b10100001 #b0000011101)))
; expect = -13260813700824993504719418687488.0

(assert (= expect result))

(check-sat)
(exit)
