;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100100 #b0101111101)
                arg1
                (fp #b0 #b01111111 #b0000000000)))
