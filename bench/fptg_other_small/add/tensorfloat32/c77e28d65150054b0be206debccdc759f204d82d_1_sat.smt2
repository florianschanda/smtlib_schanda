                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b01111101 #b0111101010)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001111 #b0100010101)
                expect
                (fp #b1 #b01111010 #b0011100000)))
(assert (fp.leq (fp #b1 #b01111010 #b0011100000)
                expect
                (fp #b0 #b01010010 #b1111011111)))
; expect = -0.0380859375

(assert (= expect result))

(check-sat)
