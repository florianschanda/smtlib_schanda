(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b101 #b1011)))
; arg1 = -0.75

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                arg2
                (fp #b1 #b100 #b0010)))
(assert (fp.leq (fp #b1 #b100 #b0010)
                arg2
                (fp #b0 #b110 #b1100)))
; arg2 = -2.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                expect
                (fp #b1 #b100 #b1000)))
(assert (fp.leq (fp #b1 #b100 #b1000)
                expect
                (fp #b0 #b000 #b0101)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
