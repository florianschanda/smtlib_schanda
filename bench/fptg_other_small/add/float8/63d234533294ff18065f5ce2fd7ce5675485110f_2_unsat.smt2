; Format: FLOAT8
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg1
                (fp #b0 #b101 #b1000)))
; arg1 = 3.875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                arg2
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg2
                (fp #b0 #b010 #b1011)))
; arg2 = -3.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011 #b1010)
                expect
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b101 #b1110)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
