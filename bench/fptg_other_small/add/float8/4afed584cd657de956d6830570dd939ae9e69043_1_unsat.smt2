                arg2
                (fp #b0 #b000 #b0111)))
(assert (fp.leq (fp #b0 #b000 #b0111)
                arg2
                (fp #b0 #b001 #b0111)))
; arg2 = 0.109375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1100)
                expect
                (fp #b0 #b000 #b1011)))
(assert (fp.leq (fp #b0 #b000 #b1011)
                expect
                (fp #b0 #b001 #b0111)))
; expect = 0.171875

(assert (not (= expect result)))

(check-sat)
(exit)
