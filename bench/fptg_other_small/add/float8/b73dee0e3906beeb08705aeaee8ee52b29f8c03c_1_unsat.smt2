(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: +ZERO
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010 #b1011)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b001 #b1011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                arg2
                (fp #b1 #b011 #b0000)))
(assert (fp.leq (fp #b1 #b011 #b0000)
                arg2
                (fp #b0 #b101 #b1010)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0110)
                expect
                (fp #b1 #b011 #b0000)))
(assert (fp.leq (fp #b1 #b011 #b0000)
                expect
                (fp #b0 #b110 #b1100)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
