(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +ONE
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1010)
                arg1
                (fp #b0 #b011 #b0000)))
(assert (fp.leq (fp #b0 #b011 #b0000)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0001)
                arg2
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg2
                (fp #b0 #b110 #b1010)))
; arg2 = -0.234375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0110)
                expect
                (fp #b0 #b010 #b1000)))
(assert (fp.leq (fp #b0 #b010 #b1000)
                expect
                (fp #b0 #b110 #b1001)))
; expect = 0.75

(assert (= expect result))

(check-sat)
(exit)
