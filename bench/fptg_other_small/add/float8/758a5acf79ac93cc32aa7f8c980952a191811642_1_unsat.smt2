; Format: FLOAT8
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = 0.015625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                arg2
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg2
                (fp #b0 #b110 #b1110)))
; arg2 = -0.234375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                expect
                (fp #b1 #b000 #b1110)))
(assert (fp.leq (fp #b1 #b000 #b1110)
                expect
                (fp #b0 #b100 #b1110)))
; expect = -0.21875

(assert (not (= expect result)))

(check-sat)
(exit)
