(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1001)
                arg1
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = -0.015625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                arg2
                (fp #b0 #b000 #b0100)))
(assert (fp.leq (fp #b0 #b000 #b0100)
                arg2
                (fp #b0 #b001 #b1000)))
; arg2 = 0.0625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1001)
                expect
                (fp #b0 #b000 #b0011)))
(assert (fp.leq (fp #b0 #b000 #b0011)
                expect
                (fp #b0 #b011 #b1011)))
; expect = 0.046875

(assert (= expect result))

(check-sat)
(exit)
