(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg1
                (fp #b1 #b010 #b1101)))
; arg1 = -9.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1110)
                arg2
                (fp #b0 #b000 #b1110)))
(assert (fp.leq (fp #b0 #b000 #b1110)
                arg2
                (fp #b0 #b101 #b0110)))
; arg2 = 0.21875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                expect
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                expect
                (fp #b1 #b001 #b0011)))
; expect = -9.0

(assert (= expect result))

(check-sat)
(exit)
