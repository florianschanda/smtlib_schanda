(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0011)
                arg1
                (fp #b0 #b100 #b1100)))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 3.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1101)
                arg2
                (fp #b0 #b010 #b1001)))
(assert (fp.leq (fp #b0 #b010 #b1001)
                arg2
                (fp #b0 #b011 #b1011)))
; arg2 = 0.78125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b0011)
                expect
                (fp #b0 #b101 #b0010)))
(assert (fp.leq (fp #b0 #b101 #b0010)
                expect
                (fp #b0 #b110 #b1110)))
; expect = 4.5

(assert (not (= expect result)))

(check-sat)
(exit)
