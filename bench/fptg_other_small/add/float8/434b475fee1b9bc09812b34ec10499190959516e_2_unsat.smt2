(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1000)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b0 #b010 #b0111)))
; arg1 = -0.234375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg2
                (fp #b0 #b010 #b1000)))
(assert (fp.leq (fp #b0 #b010 #b1000)
                arg2
                (fp #b0 #b011 #b0111)))
; arg2 = 0.75

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0110)
                expect
                (fp #b0 #b010 #b0001)))
(assert (fp.leq (fp #b0 #b010 #b0001)
                expect
                (fp #b0 #b100 #b1000)))
; expect = 0.53125

(assert (not (= expect result)))

(check-sat)
(exit)
