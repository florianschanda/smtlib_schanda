(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b1 #b101 #b0100)))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b001 #b1110)))
; arg1 = -5.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg2
                (fp #b1 #b010 #b1011)))
(assert (fp.leq (fp #b1 #b010 #b1011)
                arg2
                (fp #b0 #b000 #b1000)))
; arg2 = -0.84375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1110)
                expect
                (fp #b1 #b101 #b1000)))
(assert (fp.leq (fp #b1 #b101 #b1000)
                expect
                (fp #b0 #b101 #b1001)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
