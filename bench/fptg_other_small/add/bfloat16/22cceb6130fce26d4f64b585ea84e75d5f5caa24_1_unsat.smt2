                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b01100001 #b0111100)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001001 #b0011010)
                expect
                (fp #b0 #b10000100 #b0111000)))
(assert (fp.leq (fp #b0 #b10000100 #b0111000)
                expect
                (fp #b0 #b11101100 #b0110011)))
; expect = 46.0

(assert (not (= expect result)))

(check-sat)
(exit)
