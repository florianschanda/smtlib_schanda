                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b11111010 #b0000001)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010101 #b0100101)
                expect
                (fp #b0 #b10010001 #b1101010)))
(assert (fp.leq (fp #b0 #b10010001 #b1101010)
                expect
                (fp #b0 #b10100111 #b1010100)))
; expect = 479232.0

(assert (= expect result))

(check-sat)
(exit)
