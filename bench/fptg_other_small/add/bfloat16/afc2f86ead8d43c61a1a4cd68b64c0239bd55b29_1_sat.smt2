; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100000 #b1000000)
                arg1
                (fp #b1 #b01111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111 #b0101111)
                arg1
                (fp #b1 #b01011111 #b0000001)))
; arg1 = -1.3671875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111111 #b0011001)
                arg2
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg2
                (fp #b0 #b11001001 #b0100001)))
; arg2 = 18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011100 #b1001110)
                expect
                (fp #b0 #b10111110 #b1111110)))
(assert (fp.leq (fp #b0 #b10111110 #b1111110)
                expect
                (fp #b0 #b11001001 #b0010110)))
; expect = 18302628885633695744.0

(assert (= expect result))

(check-sat)
(exit)
