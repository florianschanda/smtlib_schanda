                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11110000 #b0011000)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111100 #b1001100)
                expect
                (fp #b0 #b11101011 #b0101000)))
(assert (fp.leq (fp #b0 #b11101011 #b0101000)
                expect
                (fp #b0 #b11111101 #b1110101)))
; expect = 425930601676685078902892277006336.0

(assert (= expect result))

(check-sat)
(exit)
