; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b1101000)
                arg1
                (fp #b0 #b01100011 #b1110000)))
(assert (fp.leq (fp #b0 #b01100011 #b1110000)
                arg1
                (fp #b0 #b11011111 #b0001111)))
; arg1 = 0.0000000069849193096160888671875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b0010011)
                arg2
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg2
                (fp #b1 #b00111011 #b1111101)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001011 #b0011011)
                expect
                (fp #b1 #b01111110 #b1111111)))
(assert (fp.leq (fp #b1 #b01111110 #b1111111)
                expect
                (fp #b0 #b11010001 #b0010110)))
; expect = -0.99609375

(assert (not (= expect result)))

(check-sat)
(exit)
