(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b11011101 #b1101101)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0100000)
                expect
                (fp #b0 #b01111111 #b1110101)))
(assert (fp.leq (fp #b0 #b01111111 #b1110101)
                expect
                (fp #b0 #b10001110 #b1010011)))
; expect = 1.9140625

(assert (= expect result))

(check-sat)
(exit)
