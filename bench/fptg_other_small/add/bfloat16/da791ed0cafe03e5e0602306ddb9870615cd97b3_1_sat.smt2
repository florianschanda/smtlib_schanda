; Format: BFLOAT16
; Arg1: +ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011001 #b0011010)
                arg1
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg1
                (fp #b0 #b10010001 #b0101100)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101011 #b1111000)
                arg2
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg2
                (fp #b0 #b10111101 #b1100101)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011100 #b0001100)
                expect
                (fp #b0 #b01111110 #b1111111)))
(assert (fp.leq (fp #b0 #b01111110 #b1111111)
                expect
                (fp #b0 #b11000100 #b1110000)))
; expect = 0.99609375

(assert (= expect result))

(check-sat)
(exit)
