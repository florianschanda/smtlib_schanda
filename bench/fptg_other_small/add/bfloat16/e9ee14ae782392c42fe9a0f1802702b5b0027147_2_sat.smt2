; Format: BFLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0110000)
                arg1
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg1
                (fp #b1 #b01011010 #b0111100)))
