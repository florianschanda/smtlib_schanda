;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000010 #b1011001)
                arg1
                (fp #b0 #b00000000 #b1011100)))
(assert (fp.leq (fp #b0 #b00000000 #b1011100)
                arg1
                (fp #b0 #b00100101 #b0111010)))
; arg1 = 0.00000000000000000000000000000000000000844886564653519146352529386128489080932165868929937906084415288887612405233085155487060546875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110010 #b1111110)
                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b10010000 #b1100001)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b1101010)
                expect
                (fp #b0 #b10000110 #b1110100)))
(assert (fp.leq (fp #b0 #b10000110 #b1110100)
                expect
                (fp #b0 #b11100011 #b0001100)))
; expect = 244.0

(assert (= expect result))

(check-sat)
(exit)
