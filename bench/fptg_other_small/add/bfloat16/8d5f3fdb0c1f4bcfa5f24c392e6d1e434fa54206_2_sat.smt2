; arg1 = -1232156383421838978254795515625472.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11001001 #b1110000)
                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11101100 #b1010110)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101110 #b0011101)
                expect
                (fp #b1 #b11101100 #b0100000)))
(assert (fp.leq (fp #b1 #b11101100 #b0100000)
                expect
                (fp #b1 #b10110010 #b1001100)))
; expect = -811296384146066816957890051440640.0

(assert (= expect result))

(check-sat)
(exit)
