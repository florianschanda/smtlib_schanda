(assert (fp.leq (fp #b1 #b11001000 #b1000010)
                expect
                (fp #b1 #b10111111 #b0000000)))
(assert (fp.leq (fp #b1 #b10111111 #b0000000)
                expect
                (fp #b1 #b10100110 #b1101011)))
; expect = -18446744073709551616.0

(assert (not (= expect result)))

