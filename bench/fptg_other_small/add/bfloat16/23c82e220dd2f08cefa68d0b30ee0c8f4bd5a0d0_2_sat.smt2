(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000101 #b1101110)
                expect
                (fp #b0 #b11010100 #b1011101)))
(assert (fp.leq (fp #b0 #b11010100 #b1011101)
                expect
