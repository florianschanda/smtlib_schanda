                arg2
                (fp #b0 #b11001001 #b1000111)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                expect
                (fp #b1 #b11111110 #b1111110)))
(assert (fp.leq (fp #b1 #b11111110 #b1111110)
                expect
                (fp #b1 #b01010100 #b1110010)))
; expect = -337623910929368631717566993311207522304.0

(assert (= expect result))

