(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b10100101 #b1010010)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010111 #b0110010)
                expect
                (fp #b1 #b10000110 #b1010000)))
(assert (fp.leq (fp #b1 #b10000110 #b1010000)
                expect
                (fp #b0 #b01010111 #b0111010)))
; expect = -208.0

(assert (= expect result))

(check-sat)
