(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0000011)
                arg1
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg1
                (fp #b0 #b10000010 #b1010010)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b0000101)
                arg2
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b10111000 #b0001100)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1010010)
                expect
                (fp #b1 #b11111100 #b1111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111)
                expect
                (fp #b1 #b10000111 #b1001101)))
; expect = -84738284731288386897617700092871966720.0

(assert (= expect result))

(check-sat)
(exit)
