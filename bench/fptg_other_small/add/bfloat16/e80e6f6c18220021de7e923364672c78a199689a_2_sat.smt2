; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b1101110)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b1 #b01111110 #b0010101)))
; arg1 = -134.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101111 #b0010010)
                arg2
                (fp #b1 #b11010010 #b1100000)))
(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b1 #b10011001 #b0100011)))
; arg2 = -16924961474604808445886464.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b0001000)
                expect
                (fp #b1 #b11010010 #b1100001)))
(assert (fp.leq (fp #b1 #b11010010 #b1100001)
                expect
                (fp #b1 #b01100100 #b0000111)))
; expect = -17000519338330722769305600.0

(assert (= expect result))

(check-sat)
(exit)
