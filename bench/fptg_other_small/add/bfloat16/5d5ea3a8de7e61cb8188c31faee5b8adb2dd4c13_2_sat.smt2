                arg2
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg2
                (fp #b0 #b10110100 #b0101111)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0000010)
                expect
                (fp #b1 #b11111101 #b0000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000001)
                expect
                (fp #b1 #b11100111 #b0110111)))
; expect = -85735205728127073802295555388082225152.0

(assert (= expect result))

(check-sat)
(exit)
