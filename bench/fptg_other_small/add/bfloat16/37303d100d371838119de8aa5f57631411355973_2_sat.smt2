(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg2
                (fp #b0 #b10011011 #b0101001)))
; arg2 = 0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010101 #b1010101)
                expect
                (fp #b0 #b10000101 #b0101101)))
(assert (fp.leq (fp #b0 #b10000101 #b0101101)
                expect
                (fp #b0 #b10110001 #b1000100)))
; expect = 86.5

(assert (= expect result))

(check-sat)
