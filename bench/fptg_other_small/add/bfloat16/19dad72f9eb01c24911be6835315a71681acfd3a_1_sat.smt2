; Format: BFLOAT16
; Arg1: -ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b0011010)
                arg1
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg1
                (fp #b1 #b01110111 #b1111101)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111011 #b0110100)
                arg2
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg2
                (fp #b0 #b11111100 #b1000111)))
; arg2 = 18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10111001 #b1000001)
                expect
                (fp #b0 #b10111110 #b1111110)))
(assert (fp.leq (fp #b0 #b10111110 #b1111110)
                expect
                (fp #b0 #b11100000 #b0001000)))
; expect = 18302628885633695744.0

(assert (= expect result))

(check-sat)
(exit)
