                arg1
                (fp #b0 #b11110111 #b1101101)))
; arg1 = 23906980319527578894336.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10110000 #b0100101)
                arg2
                (fp #b0 #b10110000 #b1010100)))
(assert (fp.leq (fp #b0 #b10110000 #b1010100)
                arg2
                (fp #b0 #b11110101 #b0010100)))
; arg2 = 932385860354048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111101 #b1010001)
                expect
                (fp #b0 #b11001001 #b0100011)))
(assert (fp.leq (fp #b0 #b11001001 #b0100011)
                expect
                (fp #b0 #b11101011 #b1001110)))
; expect = 24054554272117255307264.0

(assert (= expect result))

(check-sat)
(exit)
