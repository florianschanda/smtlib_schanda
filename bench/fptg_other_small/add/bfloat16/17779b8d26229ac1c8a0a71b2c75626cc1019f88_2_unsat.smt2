(assert (fp.leq (fp #b1 #b10110000 #b1001100)
                expect
                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                expect
                (fp #b0 #b11110111 #b1100100)))
; expect = 66490920078804604608839680.0

(assert (not (= expect result)))

