                arg2
                (fp #b1 #b01101000 #b1111100)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111011 #b1000110)
                expect
                (fp #b1 #b10000101 #b1100010)))
(assert (fp.leq (fp #b1 #b10000101 #b1100010)
                expect
                (fp #b0 #b10011010 #b1101100)))
; expect = -113.0

(assert (not (= expect result)))

(check-sat)
(exit)
