; Format: BFLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011011 #b0100010)
                arg1
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                arg1
                (fp #b0 #b11111111 #b0000000)))
; arg1 = 338953138925153547590470800371487866880.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b1010100)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b1 #b00110110 #b1010000)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101101 #b1010101)
                expect
                (fp #b0 #b11111110 #b1111110)))
(assert (fp.leq (fp #b0 #b11111110 #b1111110)
                expect
                (fp #b0 #b11111110 #b1111111)))
; expect = 337623910929368631717566993311207522304.0

(assert (= expect result))

(check-sat)
(exit)
