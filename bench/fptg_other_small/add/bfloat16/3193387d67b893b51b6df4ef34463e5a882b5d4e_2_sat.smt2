                arg2
                (fp #b0 #b00000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000)
                arg2
                (fp #b0 #b01001101 #b0110111)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0111110)
                expect
                (fp #b0 #b01111111 #b1011111)))
(assert (fp.leq (fp #b0 #b01111111 #b1011111)
                expect
                (fp #b0 #b10001000 #b0100000)))
; expect = 1.7421875

(assert (= expect result))

(check-sat)
(exit)
