; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000111 #b0110110)
                arg1
                (fp #b1 #b01101101 #b1000001)))
(assert (fp.leq (fp #b1 #b01101101 #b1000001)
                arg1
                (fp #b0 #b00000000 #b1100001)))
; arg1 = -0.0000057518482208251953125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011010 #b1000111)
                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b10100010 #b1110011)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100110 #b0010011)
                expect
                (fp #b0 #b10000110 #b1110010)))
(assert (fp.leq (fp #b0 #b10000110 #b1110010)
                expect
                (fp #b0 #b10100110 #b0000011)))
; expect = 242.0

(assert (= expect result))

(check-sat)
(exit)
