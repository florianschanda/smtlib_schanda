(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1111010)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b1 #b00110010 #b0100011)))
; arg1 = -256.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111010 #b1000001)
                arg2
                (fp #b1 #b01001110 #b1100110)))
(assert (fp.leq (fp #b1 #b01001110 #b1100110)
                arg2
                (fp #b0 #b11100000 #b0110001)))
; arg2 = -0.0000000000000031918911957973250537179410457611083984375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b1000010)
                expect
                (fp #b1 #b10000111 #b0000001)))
(assert (fp.leq (fp #b1 #b10000111 #b0000001)
                expect
                (fp #b0 #b00111111 #b1111110)))
; expect = -258.0

(assert (= expect result))

(check-sat)
(exit)
