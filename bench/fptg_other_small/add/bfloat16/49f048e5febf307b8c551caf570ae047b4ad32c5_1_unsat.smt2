                arg2
                (fp #b0 #b10110100 #b1100111)))
; arg2 = -0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b0001111)
                expect
                (fp #b0 #b10000101 #b0101011)))
(assert (fp.leq (fp #b0 #b10000101 #b0101011)
                expect
                (fp #b0 #b11000011 #b1100101)))
; expect = 85.5

(assert (not (= expect result)))

(check-sat)
