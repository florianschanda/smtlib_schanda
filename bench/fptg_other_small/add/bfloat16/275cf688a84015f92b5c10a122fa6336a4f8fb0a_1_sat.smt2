(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001101 #b1101110)
                arg1
                (fp #b1 #b01101101 #b1000001)))
(assert (fp.leq (fp #b1 #b01101101 #b1000001)
                arg1
                (fp #b1 #b01100001 #b0111111)))
; arg1 = -0.0000057518482208251953125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010011 #b1110101)
                arg2
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg2
                (fp #b0 #b10010110 #b1001001)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010010 #b1101101)
                expect
                (fp #b0 #b01111110 #b1111111)))
(assert (fp.leq (fp #b0 #b01111110 #b1111111)
                expect
                (fp #b0 #b11100110 #b0000100)))
; expect = 0.99609375

(assert (= expect result))

(check-sat)
(exit)
