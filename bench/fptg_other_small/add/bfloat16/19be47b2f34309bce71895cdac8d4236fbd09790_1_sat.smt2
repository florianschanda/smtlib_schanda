(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010110 #b0101110)
                arg1
                (fp #b0 #b00000000 #b1011100)))
(assert (fp.leq (fp #b0 #b00000000 #b1011100)
                arg1
                (fp #b0 #b11100101 #b1000110)))
; arg1 = 0.00000000000000000000000000000000000000844886564653519146352529386128489080932165868929937906084415288887612405233085155487060546875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100111 #b0011110)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b0 #b00001001 #b0010001)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b0101010)
                expect
                (fp #b1 #b10000110 #b1111111)))
(assert (fp.leq (fp #b1 #b10000110 #b1111111)
                expect
                (fp #b1 #b01101010 #b1101100)))
; expect = -255.0

(assert (= expect result))

(check-sat)
(exit)
