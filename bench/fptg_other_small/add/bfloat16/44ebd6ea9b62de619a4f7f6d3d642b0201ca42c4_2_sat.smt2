                arg2
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg2
                (fp #b0 #b10000010 #b0000001)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000000 #b0011101)
                expect
                (fp #b1 #b10101111 #b0001111)))
(assert (fp.leq (fp #b1 #b10101111 #b0001111)
                expect
                (fp #b1 #b00101100 #b0100101)))
; expect = -314460325543936.0

(assert (= expect result))

(check-sat)
(exit)
