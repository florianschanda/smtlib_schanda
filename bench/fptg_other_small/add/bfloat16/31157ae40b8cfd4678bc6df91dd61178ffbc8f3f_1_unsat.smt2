                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b11001010 #b1111000)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101000 #b0101101)
                expect
                (fp #b0 #b11001001 #b0100001)))
(assert (fp.leq (fp #b0 #b11001001 #b0100001)
                expect
                (fp #b0 #b11101001 #b1100101)))
; expect = 23759406366937902481408.0

(assert (not (= expect result)))

(check-sat)
(exit)
