                arg2
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b1 #b01000011 #b0110100)))
; arg2 = -10627982632313475302148359673872384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b0000010)
                expect
                (fp #b1 #b11110000 #b0000010)))
(assert (fp.leq (fp #b1 #b11110000 #b0000010)
                expect
                (fp #b0 #b10111100 #b1001100)))
; expect = -10546852993898868620452570668728320.0

(assert (= expect result))

(check-sat)
(exit)
