; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00100000 #b1010100)
                expect
                (fp #b0 #b10000111 #b0100100)))
(assert (fp.leq (fp #b0 #b10000111 #b0100100)
                expect
                (fp #b0 #b10110011 #b1011111)))
; expect = 328.0

(assert (not (= expect result)))

