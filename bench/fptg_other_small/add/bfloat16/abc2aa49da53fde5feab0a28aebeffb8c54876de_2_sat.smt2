                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b0 #b11000000 #b0011111)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110000 #b1100011)
                expect
                (fp #b1 #b10000110 #b0001000)))
(assert (fp.leq (fp #b1 #b10000110 #b0001000)
                expect
                (fp #b0 #b00110111 #b0011001)))
; expect = -136.0

(assert (= expect result))

(check-sat)
(exit)
