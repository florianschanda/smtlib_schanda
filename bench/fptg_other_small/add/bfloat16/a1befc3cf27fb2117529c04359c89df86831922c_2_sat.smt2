(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101000 #b1101110)
                arg2
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg2
                (fp #b1 #b00110010 #b0110000)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b1111011)
                expect
                (fp #b1 #b01111111 #b0000001)))
(assert (fp.leq (fp #b1 #b01111111 #b0000001)
                expect
                (fp #b0 #b00100011 #b1010001)))
; expect = -1.0078125

(assert (= expect result))

(check-sat)
(exit)
