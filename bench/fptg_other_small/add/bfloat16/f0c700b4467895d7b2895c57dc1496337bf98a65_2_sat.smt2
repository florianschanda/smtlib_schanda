(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010000 #b1110001)
                arg1
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg1
                (fp #b0 #b10000010 #b0010010)))
; arg1 = -0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010010 #b1101001)
                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b0 #b10011111 #b1100100)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000111 #b1010100)
                expect
                (fp #b1 #b01111111 #b0001110)))
(assert (fp.leq (fp #b1 #b01111111 #b0001110)
                expect
                (fp #b0 #b01000011 #b0010100)))
; expect = -1.109375

(assert (= expect result))

(check-sat)
(exit)
