                arg2
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b11011101 #b1000000)))
; arg2 = -0.00000000000000000000958206021581427258571039828893844969570636749267578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010101 #b0011111)
                expect
                (fp #b1 #b00111100 #b0110110)))
(assert (fp.leq (fp #b1 #b00111100 #b0110110)
                expect
                (fp #b1 #b00001000 #b0100011)))
; expect = -0.0000000000000000000096349997750176663569021684452309273183345794677734375

(assert (= expect result))

(check-sat)
