; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100111 #b0001101)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b0 #b01100011 #b1010010)))
; arg1 = -1.3046875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000110 #b0000111)
                arg2
                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg2
                (fp #b0 #b01111101 #b1000100)))
; arg2 = 0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000100 #b0101010)
                expect
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                expect
                (fp #b0 #b11011101 #b0001110)))
; expect = -1.3046875

(assert (= expect result))

(check-sat)
(exit)
