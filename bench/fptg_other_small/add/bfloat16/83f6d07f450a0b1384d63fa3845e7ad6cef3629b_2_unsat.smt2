(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b11101001 #b0010100)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110001 #b1110101)
                expect
                (fp #b1 #b10000110 #b1010011)))
(assert (fp.leq (fp #b1 #b10000110 #b1010011)
                expect
