; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011001 #b1010101)
                arg1
                (fp #b1 #b00000000 #b0111101)))
(assert (fp.leq (fp #b1 #b00000000 #b0111101)
                arg1
                (fp #b0 #b10010000 #b1111100)))
; arg1 = -0.0000000000000000000000000000000000000056019652656374639051635100601997645583545780439919795946901448502330822520889341831207275390625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b0111100)
                arg2
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg2
                (fp #b0 #b11100110 #b0101111)))
; arg2 = 256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000001 #b0101101)
                expect
                (fp #b0 #b10000110 #b1111111)))
(assert (fp.leq (fp #b0 #b10000110 #b1111111)
                expect
                (fp #b0 #b11001001 #b0101101)))
; expect = 255.0

(assert (not (= expect result)))

(check-sat)
(exit)
