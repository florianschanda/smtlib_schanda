                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b00000100 #b1011101)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b0011111)
                expect
                (fp #b1 #b01111111 #b1010111)))
(assert (fp.leq (fp #b1 #b01111111 #b1010111)
                expect
