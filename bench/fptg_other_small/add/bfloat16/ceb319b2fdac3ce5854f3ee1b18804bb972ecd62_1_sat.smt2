(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100011 #b0101001)
                arg1
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                arg1
                (fp #b0 #b11101101 #b0110110)))
; arg1 = 3489792.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101001 #b1001010)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b0 #b01111111 #b0111111)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101001 #b1011001)
                expect
                (fp #b0 #b10010100 #b1010100)))
(assert (fp.leq (fp #b0 #b10010100 #b1010100)
                expect
                (fp #b0 #b11100010 #b0100110)))
; expect = 3473408.0

(assert (= expect result))

(check-sat)
(exit)
