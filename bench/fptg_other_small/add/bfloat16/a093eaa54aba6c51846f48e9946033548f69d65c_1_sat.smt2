; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b0100110)
                arg1
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                arg1
                (fp #b0 #b01111110 #b1100010)))
; arg1 = -8510837770086989389931479040.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000111 #b1011011)
                arg2
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg2
                (fp #b0 #b11111110 #b1001011)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011111 #b1110101)
                expect
                (fp #b1 #b11011011 #b1011011)))
(assert (fp.leq (fp #b1 #b11011011 #b1011011)
                expect
                (fp #b1 #b01100010 #b0001110)))
; expect = -8472152143859321256340881408.0

(assert (= expect result))

(check-sat)
(exit)
