;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b1001101)
                arg1
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                arg1
                (fp #b0 #b11000011 #b1011111)))
; arg1 = -312261302288384.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101101 #b1101101)
                arg2
                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                arg2
                (fp #b0 #b11001110 #b0011010)))
; arg2 = -0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b0110111)
                expect
                (fp #b1 #b10101111 #b0001111)))
(assert (fp.leq (fp #b1 #b10101111 #b0001111)
                expect
                (fp #b0 #b10000111 #b0001000)))
; expect = -314460325543936.0

(assert (= expect result))

(check-sat)
(exit)
