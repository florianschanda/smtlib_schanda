                expect
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                expect
                (fp #b0 #b10010101 #b1111110)))
; expect = -1.0

(assert (not (= expect result)))

