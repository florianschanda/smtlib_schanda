(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b0111101)
                arg1
                (fp #b0 #b00000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000)
                arg1
                (fp #b0 #b00100110 #b0011001)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b0011111)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b0 #b00111011 #b1110010)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b0111011)
                expect
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                expect
                (fp #b1 #b01001010 #b1000000)))
; expect = -256.0

(assert (= expect result))

(check-sat)
(exit)
