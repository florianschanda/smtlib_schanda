(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101010 #b1110110)
                expect
                (fp #b1 #b10000110 #b1111111)))
(assert (fp.leq (fp #b1 #b10000110 #b1111111)
                expect
                (fp #b1 #b01010101 #b0011010)))
; expect = -255.0

(assert (not (= expect result)))

