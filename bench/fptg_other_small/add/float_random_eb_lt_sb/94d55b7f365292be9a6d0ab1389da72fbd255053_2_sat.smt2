(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b110 #b011000001010)
                arg1
                (fp #b1 #b100 #b111111111111)))
(assert (fp.leq (fp #b1 #b100 #b111111111111)
                arg1
                (fp #b0 #b011 #b110100110110)))
; arg1 = -3.99951171875

(declare-const arg2 (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b000 #b011111010010)
                arg2
                (fp #b0 #b110 #b010000000000)))
(assert (fp.leq (fp #b0 #b110 #b010000000000)
                arg2
                (fp #b0 #b110 #b010100110011)))
; arg2 = 10.0

(declare-const result (_ FloatingPoint 3 13))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b0 #b100 #b100000100000)
                expect
                (fp #b0 #b101 #b100000000001)))
(assert (fp.leq (fp #b0 #b101 #b100000000001)
                expect
                (fp #b0 #b101 #b110010111110)))
; expect = 6.0009765625

(assert (= expect result))

(check-sat)
(exit)
