;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 16))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 5 16))
(assert (fp.leq (fp #b1 #b01100 #b001011000110110)
                arg2
                (fp #b0 #b01111 #b001111010011110)))
