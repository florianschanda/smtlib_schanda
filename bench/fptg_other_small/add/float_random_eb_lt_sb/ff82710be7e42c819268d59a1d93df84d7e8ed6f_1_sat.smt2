(declare-const result (_ FloatingPoint 5 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
