(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 18))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10 #b10110111000111100)
                arg1
                (fp #b1 #b00 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b00 #b00000000000000000)
                arg1
                (fp #b0 #b10 #b01101110110101100)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 2 18))
(assert (fp.leq (fp #b1 #b01 #b00111110001111001)
                arg2
                (fp #b0 #b10 #b10000000000000000)))
(assert (fp.leq (fp #b0 #b10 #b10000000000000000)
                arg2
                (fp #b0 #b10 #b11010001110110101)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 2 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 18))
(assert (fp.leq (fp #b1 #b10 #b10011010011110001)
                expect
                (fp #b0 #b10 #b10000000000000000)))
(assert (fp.leq (fp #b0 #b10 #b10000000000000000)
                expect
                (fp #b0 #b10 #b11111000111110010)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
