(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 15))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00 #b01100101011101)
                arg1
                (fp #b1 #b00 #b00000000000000)))
(assert (fp.leq (fp #b1 #b00 #b00000000000000)
                arg1
                (fp #b0 #b10 #b10100001100011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 2 15))
(assert (fp.leq (fp #b0 #b10 #b01001111101001)
                arg2
                (fp #b0 #b10 #b10010111110011)))
(assert (fp.leq (fp #b0 #b10 #b10010111110011)
                arg2
                (fp #b0 #b10 #b11101101101101)))
; arg2 = 3.1859130859375

(declare-const result (_ FloatingPoint 2 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 15))
(assert (fp.leq (fp #b1 #b01 #b01000010000110)
                expect
                (fp #b0 #b10 #b10010111110011)))
(assert (fp.leq (fp #b0 #b10 #b10010111110011)
                expect
                (fp #b0 #b10 #b10100010001000)))
; expect = 3.1859130859375

(assert (= expect result))

(check-sat)
(exit)
