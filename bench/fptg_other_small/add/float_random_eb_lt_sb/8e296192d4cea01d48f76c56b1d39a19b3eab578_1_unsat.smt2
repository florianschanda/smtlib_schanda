                arg2
                (fp #b0 #b10 #b110001)))
; arg2 = 1.09375

(declare-const result (_ FloatingPoint 2 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 7))
(assert (fp.leq (fp #b1 #b10 #b000001)
                expect
                (fp #b0 #b00 #b000110)))
(assert (fp.leq (fp #b0 #b00 #b000110)
                expect
                (fp #b0 #b10 #b110110)))
; expect = 0.09375

(assert (not (= expect result)))

(check-sat)
(exit)
