; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010110 #b110100000000011)
                arg1
                (fp #b0 #b01111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b01111111 #b010001110000010)
                arg1
                (fp #b0 #b11110011 #b110000111111001)))
; arg1 = 1.27740478515625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01000000 #b001001101000001)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b10110111 #b011100000100000)))
; arg2 = 5679104.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b101000011101000)
                expect
                (fp #b1 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b1 #b10010101 #b010110101010000)
                expect
                (fp #b1 #b01011110 #b001010100100111)))
; expect = -5679104.0

(assert (= expect result))

(check-sat)
(exit)
