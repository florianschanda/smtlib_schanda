(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010101 #b101001010111100)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b11001000 #b100101110110000)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000101 #b000111001101110)
                arg2
                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                arg2
                (fp #b0 #b00011110 #b100001100101100)))
; arg2 = -1.317169189453125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b111001011100000)
                expect
                (fp #b1 #b10001010 #b001010100101010)))
(assert (fp.leq (fp #b1 #b10001010 #b001010100101010)
                expect
                (fp #b0 #b00100110 #b000101001010010)))
; expect = -2386.625

(assert (= expect result))

(check-sat)
(exit)
