(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11101100 #b001001010001101)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11010100 #b000110010011001)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001011 #b111010101010010)
                arg2
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                arg2
                (fp #b0 #b11001010 #b000000011001001)))
; arg2 = 8115.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111011 #b101111111111100)
                expect
                (fp #b1 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b1 #b10001011 #b111110110011000)
                expect
                (fp #b0 #b10001010 #b101001011011011)))
; expect = -8115.0

(assert (= expect result))

(check-sat)
(exit)
