                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b01011111 #b100000011010101)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110000 #b111110010001110)
                expect
                (fp #b0 #b10001110 #b100101100101101)))
(assert (fp.leq (fp #b0 #b10001110 #b100101100101101)
                expect
                (fp #b0 #b11010111 #b011101010001000)))
; expect = 52013.0

(assert (= expect result))

(check-sat)
(exit)
