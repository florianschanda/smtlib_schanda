                arg2
                (fp #b0 #b11111000 #b000011000101110)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b001001100001101)
                expect
                (fp #b0 #b11011101 #b010010100010010)))
(assert (fp.leq (fp #b0 #b11011101 #b010010100010010)
                expect
                (fp #b0 #b11110000 #b100111100110001)))
; expect = 25543393642637499832366792704.0

(assert (not (= expect result)))

