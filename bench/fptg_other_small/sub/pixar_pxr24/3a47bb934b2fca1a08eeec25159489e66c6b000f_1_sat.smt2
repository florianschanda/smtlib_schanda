(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01011010 #b001010010111010)
                arg1
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b10100110 #b001010100010110)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01111011 #b100100101100101)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b11000110 #b100000000100000)))
; arg2 = 5679104.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101011 #b011100000010001)
                expect
                (fp #b1 #b10010101 #b010110101001111)))
(assert (fp.leq (fp #b1 #b10010101 #b010110101001111)
                expect
                (fp #b0 #b01101011 #b111101101011101)))
; expect = -5678976.0

(assert (= expect result))

(check-sat)
(exit)
