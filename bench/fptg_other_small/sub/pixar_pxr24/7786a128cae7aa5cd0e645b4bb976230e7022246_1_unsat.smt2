                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b00001011 #b110111010101100)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001010 #b101011100100001)
                expect
                (fp #b0 #b10010000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10010000 #b000000000000000)
                expect
                (fp #b0 #b11111100 #b100111110101101)))
; expect = 131072.0

(assert (not (= expect result)))

(check-sat)
(exit)
