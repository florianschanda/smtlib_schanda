                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b1 #b00000101 #b111001111011110)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001001 #b100101010001001)
                expect
                (fp #b0 #b10100010 #b011111011010001)))
(assert (fp.leq (fp #b0 #b10100010 #b011111011010001)
                expect
                (fp #b0 #b11010100 #b111101111000111)))
; expect = 51221889024.0

(assert (= expect result))

(check-sat)
(exit)
