(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100101 #b010110110111101)
                arg1
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b10100100 #b011101100110111)))
; arg1 = 0.000000000000000000000000000000000000000000358732406867153170156474773322218529607747057120388037569809480675786517167580313980579376220703125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011001 #b000111011100100)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b00101111 #b010111101010110)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001011 #b000100111101001)
                expect
                (fp #b0 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b10110011 #b000011011111111)))
; expect = 65538.0

(assert (= expect result))

(check-sat)
(exit)
