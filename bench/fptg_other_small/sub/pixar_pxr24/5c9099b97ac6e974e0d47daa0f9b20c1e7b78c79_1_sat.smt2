                arg2
                (fp #b1 #b01011111 #b010000001010111)))
(assert (fp.leq (fp #b1 #b01011111 #b010000001010111)
                arg2
                (fp #b1 #b00000001 #b100010110001110)))
; arg2 = -0.00000000029165647674744832329452037811279296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001111 #b110111000011101)
                expect
                (fp #b1 #b10001110 #b011110011001110)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001110)
                expect
                (fp #b0 #b10001111 #b111010101100101)))
; expect = -48334.0

(assert (= expect result))

(check-sat)
(exit)
