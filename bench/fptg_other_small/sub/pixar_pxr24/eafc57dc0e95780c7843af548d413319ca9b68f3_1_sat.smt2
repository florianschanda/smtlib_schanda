(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ONE
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101011 #b010100111101010)
                arg1
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b11000011 #b101001101110010)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01011100 #b011100111001111)
                arg2
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b10010101 #b110001010110000)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100000 #b000011100000101)
                expect
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b11011010 #b011100010011110)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
