                arg2
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b0 #b10011010 #b010001000010010)))
; arg2 = -60693.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001010 #b110111101101101)
                expect
                (fp #b0 #b10001110 #b110110100010110)))
(assert (fp.leq (fp #b0 #b10001110 #b110110100010110)
                expect
                (fp #b0 #b10010010 #b001111001001101)))
; expect = 60694.0

(assert (= expect result))

(check-sat)
(exit)
