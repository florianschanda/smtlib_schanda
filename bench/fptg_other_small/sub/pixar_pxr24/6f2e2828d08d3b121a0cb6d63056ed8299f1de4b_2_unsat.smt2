                arg2
                (fp #b0 #b10011111 #b101111010011001)))
; arg2 = -0.000000000000000000000000000000000000000000358732406867153170156474773322218529607747057120388037569809480675786517167580313980579376220703125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01101010 #b000000111101011)
                expect
                (fp #b0 #b01111111 #b000000000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000001)
                expect
                (fp #b0 #b11011001 #b110101011101010)))
; expect = 1.000030517578125

(assert (not (= expect result)))

(check-sat)
