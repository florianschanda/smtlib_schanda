                arg2
                (fp #b0 #b00010010 #b000011100111000)))
; arg2 = -1106900345914654720.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b001011110111001)
                expect
                (fp #b0 #b10111010 #b111010111001001)))
(assert (fp.leq (fp #b0 #b10111010 #b111010111001001)
                expect
                (fp #b0 #b11110000 #b010101111000100)))
; expect = 1106917938100699136.0

(assert (= expect result))

(check-sat)
(exit)
