; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011111 #b010111100011001)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b01011101 #b011011001111111)))
; arg1 = 0.000000000000000000000000000000000000011443922511469053281161701743752093313016738869197498786514492243038265684162979596294462680816650390625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110000 #b010100100001100)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b00011000 #b111111100101111)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011110 #b011001100111110)
                expect
                (fp #b0 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100101100101100)
                expect
                (fp #b0 #b10011001 #b101011101111001)))
; expect = 52012.0

(assert (not (= expect result)))

(check-sat)
(exit)
