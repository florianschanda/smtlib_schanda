(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001000 #b110111101010110)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11001101 #b010010111011110)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111000 #b101100010011010)
                arg2
                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                arg2
                (fp #b0 #b10110111 #b000110101011010)))
; arg2 = -1106900345914654720.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10100001 #b111110111101101)
                expect
                (fp #b0 #b10111010 #b111010111001001)))
(assert (fp.leq (fp #b0 #b10111010 #b111010111001001)
                expect
                (fp #b0 #b11010010 #b000100011111101)))
; expect = 1106917938100699136.0

(assert (= expect result))

(check-sat)
(exit)
