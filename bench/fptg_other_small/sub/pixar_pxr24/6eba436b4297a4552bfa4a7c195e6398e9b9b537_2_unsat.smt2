                arg2
                (fp #b0 #b11111100 #b001000011100010)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000101 #b010000001010101)
                expect
                (fp #b0 #b10001111 #b100011001000011)))
(assert (fp.leq (fp #b0 #b10001111 #b100011001000011)
                expect
                (fp #b0 #b10111010 #b101110010110001)))
; expect = 101510.0

(assert (not (= expect result)))

