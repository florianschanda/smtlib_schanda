                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b11010010 #b100100111000000)))
; arg2 = 1536361341386752.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b001001111011110)
                expect
                (fp #b1 #b10110001 #b010111010101001)))
(assert (fp.leq (fp #b1 #b10110001 #b010111010101001)
                expect
                (fp #b0 #b00000000 #b111001101011100)))
; expect = -1536326981648384.0

(assert (not (= expect result)))

