                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b11101001 #b110111011100110)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001011 #b011010010011111)
                expect
                (fp #b0 #b10001110 #b101011000010111)))
(assert (fp.leq (fp #b0 #b10001110 #b101011000010111)
                expect
                (fp #b0 #b11010011 #b001001110110110)))
; expect = 54807.0

(assert (not (= expect result)))

(check-sat)
(exit)
