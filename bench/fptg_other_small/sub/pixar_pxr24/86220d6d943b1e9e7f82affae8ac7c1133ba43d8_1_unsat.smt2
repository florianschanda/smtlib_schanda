                arg2
                (fp #b1 #b00100011 #b010110011110100)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01111110 #b111000001011110)
                expect
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b11001010 #b010011000111000)))
; expect = 65536.0

(assert (not (= expect result)))

(check-sat)
(exit)
