; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010001 #b001000100010000)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b11110000 #b111111110101011)))
; arg1 = 51436.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00111010 #b001010100101100)
                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b10111110 #b001000111110001)))
; arg2 = 1536361341386752.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010111 #b011010100010010)
                expect
                (fp #b1 #b10110001 #b010111010101001)))
(assert (fp.leq (fp #b1 #b10110001 #b010111010101001)
                expect
                (fp #b1 #b01110111 #b000100100001010)))
; expect = -1536326981648384.0

(assert (not (= expect result)))

(check-sat)
(exit)
