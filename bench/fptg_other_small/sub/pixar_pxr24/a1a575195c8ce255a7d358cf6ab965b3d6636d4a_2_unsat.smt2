;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101101 #b110101110101110)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b11100110 #b011011101001111)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011011 #b111001111001011)
                arg2
                (fp #b1 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b10001111 #b100100001111110)))
; arg2 = -0.000000000000000000000000000000000000011754584775816007926517208897449134559657047820663754827049947253303496808030104148201644420623779296875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100000 #b000010001100101)
                expect
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                expect
                (fp #b0 #b11111010 #b001011101101000)))
; expect = -2388.0

(assert (not (= expect result)))

(check-sat)
(exit)
