(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01111001 #b010001010110101)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11011111 #b000000101111111)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111010 #b110001110111101)
                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b0 #b01110010 #b001010001110110)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01101101 #b011110010000101)
                expect
                (fp #b0 #b10100010 #b011111011010001)))
(assert (fp.leq (fp #b0 #b10100010 #b011111011010001)
                expect
                (fp #b0 #b11101001 #b111010001100011)))
; expect = 51221889024.0

(assert (= expect result))

(check-sat)
(exit)
