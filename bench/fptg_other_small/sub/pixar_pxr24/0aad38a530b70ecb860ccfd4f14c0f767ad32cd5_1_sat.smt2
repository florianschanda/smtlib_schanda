                arg2
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg2
                (fp #b0 #b10010011 #b111001110011010)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111101 #b110100000000001)
                expect
                (fp #b1 #b01111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b01111110 #b111111111111111)
                expect
                (fp #b0 #b11111101 #b011110011100100)))
; expect = -0.9999847412109375

(assert (= expect result))

(check-sat)
(exit)
