(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011000 #b111001111110011)
                expect
                (fp #b1 #b10001010 #b001010101000001)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000001)
                expect
                (fp #b0 #b10110110 #b101001100000010)))
; expect = -2388.0625

(assert (= expect result))

