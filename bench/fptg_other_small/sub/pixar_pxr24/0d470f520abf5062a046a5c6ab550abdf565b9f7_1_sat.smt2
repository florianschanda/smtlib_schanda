(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100101 #b000101001101000)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b00101101 #b111111111000110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000110 #b001110010101000)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b01010011 #b111010000101000)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010001 #b100111001111111)
                expect
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b10100000 #b110010000111000)))
; expect = 65536.0

(assert (= expect result))

(check-sat)
(exit)
