; Format: PIXAR_PXR24
; Arg1: -ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001110 #b101110110011000)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b0 #b00110100 #b101111110110111)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001101 #b100110100011010)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b00010010 #b110011000001110)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110011 #b101100001111111)
                expect
                (fp #b0 #b10001110 #b100101100101011)))
(assert (fp.leq (fp #b0 #b10001110 #b100101100101011)
                expect
                (fp #b0 #b10110111 #b001011110110010)))
; expect = 52011.0

(assert (not (= expect result)))

(check-sat)
(exit)
