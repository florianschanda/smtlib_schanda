(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -INFINITY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b011000101001001)
                arg2
                (fp #b0 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000000000000)
                arg2
                (fp #b0 #b01011101 #b111010101010101)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
