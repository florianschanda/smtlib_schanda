(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111100 #b001100001100110)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b10101010 #b111100011111000)))
; arg1 = 51436.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011100 #b100011001011010)
                arg2
                (fp #b0 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                arg2
                (fp #b0 #b11011010 #b101100101100010)))
; arg2 = 18446462598732840960.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011010 #b000000010101011)
                expect
                (fp #b1 #b10111110 #b111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111110)
                expect
                (fp #b1 #b10110110 #b101000011100011)))
; expect = -18446181123756130304.0

(assert (= expect result))

(check-sat)
(exit)
