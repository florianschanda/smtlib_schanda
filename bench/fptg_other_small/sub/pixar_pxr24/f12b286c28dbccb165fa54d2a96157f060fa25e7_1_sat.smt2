                arg2
                (fp #b1 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b010000000000000)
                arg2
                (fp #b0 #b11010011 #b100100010101001)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b111000110101000)
                expect
                (fp #b1 #b11110010 #b010000110111101)))
(assert (fp.leq (fp #b1 #b11110010 #b010000110111101)
                expect
                (fp #b1 #b00100111 #b011011111000011)))
; expect = -52487073102449838368970996218593280.0

(assert (= expect result))

(check-sat)
(exit)
