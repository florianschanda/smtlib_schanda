(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00000011 #b001011000100001)
                expect
                (fp #b0 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b0 #b11011101 #b010010100010011)
                expect
                (fp #b0 #b11111100 #b000110110011100)))
; expect = 25543998105547307146954145792.0

(assert (not (= expect result)))

