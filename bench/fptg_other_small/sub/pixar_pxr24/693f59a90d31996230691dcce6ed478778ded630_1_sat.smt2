                arg2
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b10100011 #b100111001100100)))
; arg2 = 14088.75

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011000 #b001001010000010)
                expect
                (fp #b1 #b10001100 #b101110000100010)))
(assert (fp.leq (fp #b1 #b10001100 #b101110000100010)
                expect
                (fp #b1 #b00000101 #b010001110011110)))
; expect = -14088.5

(assert (= expect result))

