(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010000 #b010100111010101)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b1 #b00010100 #b001111101011000)))
; arg1 = -48335.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001000 #b100010110001010)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b01100101 #b011001010000011)))
; arg2 = -0.000000000000000000000000000000000000010253648385483839062582518445868972231778234133672051277857864386156006020200948114506900310516357421875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100010 #b010110111110001)
                expect
                (fp #b1 #b10001110 #b011110011001110)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001110)
                expect
                (fp #b0 #b01000100 #b100100011011101)))
; expect = -48334.0

(assert (= expect result))

(check-sat)
(exit)
