(assert (fp.leq (fp #b1 #b01011010 #b010101001011000)
                arg1
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b10110101 #b110000011001111)))
