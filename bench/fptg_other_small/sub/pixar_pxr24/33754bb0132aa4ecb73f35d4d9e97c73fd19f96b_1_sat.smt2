                arg2
                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                arg2
                (fp #b0 #b01101001 #b100111000010001)))
; arg2 = -1106900345914654720.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011100 #b100110001100000)
                expect
                (fp #b0 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b0 #b10111010 #b111010111001000)
                expect
                (fp #b0 #b11111010 #b111100001011011)))
; expect = 1106900345914654720.0

(assert (= expect result))

(check-sat)
