; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10001101 #b101101001001100)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11110101 #b000101100110111)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110111 #b101100111010000)
                arg2
                (fp #b0 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b11111100 #b010100111011101)))
; arg2 = 82394.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111000 #b011110111001000)
                expect
                (fp #b1 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b1 #b10001111 #b010000011101101)
                expect
                (fp #b0 #b11011110 #b110101110100000)))
; expect = -82394.0

(assert (not (= expect result)))

(check-sat)
(exit)
