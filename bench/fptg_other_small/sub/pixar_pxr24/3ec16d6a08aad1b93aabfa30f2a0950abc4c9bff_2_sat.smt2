                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b11111101 #b001101011010000)))
; arg2 = 10729.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101110 #b110000001010111)
                expect
                (fp #b1 #b10001100 #b010011110011110)))
(assert (fp.leq (fp #b1 #b10001100 #b010011110011110)
                expect
                (fp #b1 #b01000101 #b110001100101000)))
; expect = -10727.5

(assert (= expect result))

(check-sat)
(exit)
