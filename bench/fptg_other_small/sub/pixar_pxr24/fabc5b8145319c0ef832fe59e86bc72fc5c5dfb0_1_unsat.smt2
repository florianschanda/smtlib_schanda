; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001011 #b110011110001010)
                arg1
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                arg1
                (fp #b1 #b01000010 #b101110011111010)))
; arg1 = -1.38848876953125

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b100110000111001)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b10111000 #b001010110101000)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00011000 #b010001010010011)
                expect
                (fp #b0 #b10001110 #b111111111111110)))
(assert (fp.leq (fp #b0 #b10001110 #b111111111111110)
                expect
                (fp #b0 #b11111101 #b000011100010010)))
; expect = 65534.0

(assert (not (= expect result)))

(check-sat)
(exit)
