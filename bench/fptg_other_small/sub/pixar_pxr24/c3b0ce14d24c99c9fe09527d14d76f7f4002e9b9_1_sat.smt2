(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101011 #b101000101110011)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b01000010 #b101011001110001)))
; arg1 = -2388.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110100 #b101010101111010)
                arg2
                (fp #b0 #b01111111 #b001111010011110)))
(assert (fp.leq (fp #b0 #b01111111 #b001111010011110)
                arg2
                (fp #b0 #b10010100 #b111111010001000)))
; arg2 = 1.23919677734375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111001 #b011101011010010)
                expect
                (fp #b1 #b10001010 #b001010101010011)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101010011)
                expect
                (fp #b1 #b10000101 #b111010010000000)))
; expect = -2389.1875

(assert (= expect result))

(check-sat)
(exit)
