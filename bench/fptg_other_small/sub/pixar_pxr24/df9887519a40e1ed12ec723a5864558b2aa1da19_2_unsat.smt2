(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b10000101 #b000100100111011)))
; arg2 = 1.040771484375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b101111111100010)
                expect
                (fp #b1 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b1 #b01111111 #b000010100111000)
                expect
                (fp #b0 #b10110101 #b111001011001110)))
; expect = -1.040771484375

(assert (not (= expect result)))

