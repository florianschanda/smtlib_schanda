                arg2
                (fp #b0 #b00100100 #b111011010001100)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110010 #b010010011011011)
                expect
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                expect
                (fp #b0 #b11000101 #b100101000100111)))
; expect = -48335.0

(assert (= expect result))

