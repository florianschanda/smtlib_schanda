(assert (fp.leq (fp #b1 #b11111101 #b111000001100101)
                arg1
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                arg1
                (fp #b0 #b11001110 #b100110101111010)))
