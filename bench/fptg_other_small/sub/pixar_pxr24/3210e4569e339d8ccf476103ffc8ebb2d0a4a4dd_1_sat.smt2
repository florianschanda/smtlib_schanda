(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10000111 #b111001001000100)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11010010 #b110011001011011)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01011110 #b101010000100011)
                arg2
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11111110 #b110000000100001)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b110111111100111)
                expect
                (fp #b1 #b11111100 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b111111111111111)
                expect
                (fp #b1 #b01111010 #b110011010011001)))
; expect = -85069293656019982158936519233859747840.0

(assert (= expect result))

(check-sat)
(exit)
