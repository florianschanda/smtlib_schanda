(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101011 #b011001011110011)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b01001010 #b110101011000000)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b100110000011101)
                expect
                (fp #b0 #b10001110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10001110 #b111111111111111)
                expect
                (fp #b0 #b11100101 #b001111110100001)))
; expect = 65535.0

(assert (= expect result))

(check-sat)
(exit)
