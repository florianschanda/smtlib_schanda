                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b01001000 #b101000001111101)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111000 #b110100011011010)
                expect
                (fp #b0 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b11101111 #b001101000010000)))
; expect = 65538.0

(assert (not (= expect result)))

(check-sat)
(exit)
