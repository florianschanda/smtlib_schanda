; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000101 #b001101101110100)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11001011 #b001100111100010)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001111 #b000101000100011)
                arg2
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b10010000 #b000011001100000)))
; arg2 = -0.000000000000000000000000000000000000002003520492353050455323911609004590487859267314017367189827385949574267698380936053581535816192626953125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001000 #b010100000011001)
                expect
                (fp #b0 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b0 #b00000000 #b001010111010001)
                expect
                (fp #b0 #b00110111 #b001100111101111)))
; expect = 0.000000000000000000000000000000000000002003520492353050455323911609004590487859267314017367189827385949574267698380936053581535816192626953125

(assert (= expect result))

(check-sat)
(exit)
