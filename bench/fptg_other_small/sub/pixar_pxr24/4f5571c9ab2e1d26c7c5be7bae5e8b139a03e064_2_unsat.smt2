; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011010 #b110001000001101)
                arg1
                (fp #b1 #b00000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b00000000 #b010010100000101)
                arg1
                (fp #b0 #b00010101 #b001101010101111)))
; arg1 = -0.000000000000000000000000000000000000003399707019880010593572911426774665005092618860329917432049084448364428823197158635593950748443603515625

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10101011 #b100011001001111)
                expect
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b00000101 #b011110101000011)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
