                arg2
                (fp #b1 #b01111 #b0110)))
(assert (fp.leq (fp #b1 #b01111 #b0110)
                arg2
                (fp #b0 #b10010 #b1101)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01010 #b0100)
                expect
                (fp #b0 #b01111 #b0111)))
(assert (fp.leq (fp #b0 #b01111 #b0111)
                expect
                (fp #b0 #b10001 #b1001)))
; expect = 1.4375

(assert (not (= expect result)))

(check-sat)
(exit)
