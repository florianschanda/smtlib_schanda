(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1100)
                arg1
                (fp #b1 #b00000 #b0011)))
(assert (fp.leq (fp #b1 #b00000 #b0011)
                arg1
                (fp #b0 #b11001 #b0100)))
; arg1 = -0.000011444091796875

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0011)
                arg2
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                arg2
                (fp #b0 #b10101 #b0010)))
; arg2 = 32.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0111)
                expect
                (fp #b1 #b10100 #b0000)))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                expect
                (fp #b0 #b01101 #b0111)))
; expect = -32.0

(assert (= expect result))

(check-sat)
(exit)
