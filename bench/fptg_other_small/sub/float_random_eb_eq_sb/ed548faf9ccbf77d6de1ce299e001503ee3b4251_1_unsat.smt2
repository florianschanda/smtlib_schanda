; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b0100)
                arg1
                (fp #b1 #b00000 #b1111)))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                arg1
                (fp #b0 #b01001 #b0100)))
; arg1 = -0.000057220458984375

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01001 #b0110)
                arg2
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg2
                (fp #b0 #b00001 #b0101)))
; arg2 = -0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00011 #b0110)
                expect
                (fp #b1 #b00000 #b1111)))
(assert (fp.leq (fp #b1 #b00000 #b1111)
                expect
                (fp #b0 #b10101 #b0011)))
; expect = -0.000057220458984375

(assert (not (= expect result)))

(check-sat)
(exit)
