;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101111 #b000100)
                arg1
                (fp #b0 #b0001000 #b100110)))
(assert (fp.leq (fp #b0 #b0001000 #b100110)
                arg1
                (fp #b0 #b0101101 #b011100)))
; arg1 = 0.000000000000000044235448637408580907504074275493621826171875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000101 #b001000)
                arg2
                (fp #b1 #b0111111 #b100001)))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg2
                (fp #b1 #b0110000 #b111101)))
; arg2 = -1.515625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101100 #b000101)
                expect
                (fp #b0 #b0111111 #b100001)))
(assert (fp.leq (fp #b0 #b0111111 #b100001)
                expect
                (fp #b0 #b1111110 #b001001)))
; expect = 1.515625

(assert (= expect result))

(check-sat)
(exit)
