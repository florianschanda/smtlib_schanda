                arg2
                (fp #b0 #b10000 #b1011)))
; arg2 = 0.000003814697265625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01000 #b1010)
                expect
                (fp #b1 #b00000 #b0100)))
(assert (fp.leq (fp #b1 #b00000 #b0100)
                expect
                (fp #b0 #b10001 #b0001)))
; expect = -0.0000152587890625

(assert (= expect result))

