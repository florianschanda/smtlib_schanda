(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00110 #b1011)
                arg1
                (fp #b0 #b01111 #b0100)))
(assert (fp.leq (fp #b0 #b01111 #b0100)
                arg1
                (fp #b0 #b10111 #b1100)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1001)
                arg2
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                arg2
                (fp #b0 #b10100 #b0101)))
; arg2 = -0.000003814697265625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b0111)
                expect
                (fp #b0 #b01111 #b0100)))
(assert (fp.leq (fp #b0 #b01111 #b0100)
                expect
                (fp #b0 #b10000 #b0000)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
