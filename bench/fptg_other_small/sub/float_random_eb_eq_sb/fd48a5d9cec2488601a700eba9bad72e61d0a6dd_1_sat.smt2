(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111010 #b001011)
                arg1
                (fp #b1 #b1110101 #b010100)))
(assert (fp.leq (fp #b1 #b1110101 #b010100)
                arg1
                (fp #b0 #b1011010 #b101110)))
; arg1 = -23643898043695104.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010100 #b101111)
                arg2
                (fp #b1 #b1000000 #b100000)))
(assert (fp.leq (fp #b1 #b1000000 #b100000)
                arg2
                (fp #b0 #b0110011 #b100110)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110101 #b011000)
                expect
                (fp #b1 #b1110101 #b010011)))
(assert (fp.leq (fp #b1 #b1110101 #b010011)
                expect
                (fp #b1 #b0001001 #b100000)))
; expect = -23362423066984448.0

(assert (= expect result))

(check-sat)
(exit)
