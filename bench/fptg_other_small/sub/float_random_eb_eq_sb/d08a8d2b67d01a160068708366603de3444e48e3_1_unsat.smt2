(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00000)
                arg1
                (fp #b0 #b000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000 #b01000)
                arg1
                (fp #b0 #b000011 #b00111)))
; arg1 = 0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b10011)
                arg2
                (fp #b1 #b100010 #b11000)))
(assert (fp.leq (fp #b1 #b100010 #b11000)
                arg2
                (fp #b1 #b011011 #b11011)))
; arg2 = -14.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001010 #b01100)
                expect
                (fp #b0 #b100010 #b11000)))
(assert (fp.leq (fp #b0 #b100010 #b11000)
                expect
                (fp #b0 #b100111 #b11000)))
; expect = 14.0

(assert (not (= expect result)))

(check-sat)
(exit)
