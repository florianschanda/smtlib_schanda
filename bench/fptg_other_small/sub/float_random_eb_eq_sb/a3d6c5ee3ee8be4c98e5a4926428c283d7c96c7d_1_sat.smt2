(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00110 #b0000)
                arg1
                (fp #b0 #b01000 #b0000)))
(assert (fp.leq (fp #b0 #b01000 #b0000)
                arg1
                (fp #b0 #b11010 #b1000)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1010)
                arg2
                (fp #b1 #b11110 #b0011)))
(assert (fp.leq (fp #b1 #b11110 #b0011)
                arg2
                (fp #b1 #b11000 #b1111)))
; arg2 = -38912.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00110 #b0010)
                expect
                (fp #b0 #b11110 #b0011)))
(assert (fp.leq (fp #b0 #b11110 #b0011)
                expect
                (fp #b0 #b11110 #b1011)))
; expect = 38912.0

(assert (= expect result))

(check-sat)
(exit)
