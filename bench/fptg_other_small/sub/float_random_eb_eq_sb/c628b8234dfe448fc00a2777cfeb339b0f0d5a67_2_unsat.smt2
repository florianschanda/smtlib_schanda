(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b1010 #b000)))
(assert (fp.leq (fp #b0 #b1010 #b000)
                arg1
                (fp #b0 #b1101 #b100)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b100)
                arg2
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg2
                (fp #b0 #b0011 #b111)))
; arg2 = -0.00390625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                expect
                (fp #b0 #b1010 #b001)))
(assert (fp.leq (fp #b0 #b1010 #b001)
                expect
                (fp #b0 #b1101 #b111)))
; expect = 9.0

(assert (not (= expect result)))

(check-sat)
(exit)
