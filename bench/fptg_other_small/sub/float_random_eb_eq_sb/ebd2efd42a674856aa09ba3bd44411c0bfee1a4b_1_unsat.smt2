; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00100 #b0100)
                arg1
                (fp #b0 #b00111 #b0100)))
(assert (fp.leq (fp #b0 #b00111 #b0100)
                arg1
                (fp #b0 #b10110 #b1001)))
; arg1 = 0.0048828125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01011 #b0000)
                arg2
                (fp #b0 #b00000 #b1110)))
(assert (fp.leq (fp #b0 #b00000 #b1110)
                arg2
                (fp #b0 #b00111 #b1110)))
; arg2 = 0.00005340576171875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01011 #b0111)
                expect
                (fp #b0 #b00111 #b0011)))
(assert (fp.leq (fp #b0 #b00111 #b0011)
                expect
                (fp #b0 #b10101 #b0101)))
; expect = 0.004638671875

(assert (not (= expect result)))

(check-sat)
(exit)
