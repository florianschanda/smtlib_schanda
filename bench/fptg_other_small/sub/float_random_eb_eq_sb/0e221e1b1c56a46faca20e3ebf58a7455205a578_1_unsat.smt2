(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b10100)
                arg1
                (fp #b1 #b110110 #b01010)))
(assert (fp.leq (fp #b1 #b110110 #b01010)
                arg1
                (fp #b1 #b000110 #b00001)))
; arg1 = -11010048.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b11110)
                arg2
                (fp #b1 #b101001 #b11110)))
(assert (fp.leq (fp #b1 #b101001 #b11110)
                arg2
                (fp #b0 #b001111 #b10000)))
; arg2 = -1984.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b00111)
                expect
                (fp #b1 #b110110 #b01001)))
(assert (fp.leq (fp #b1 #b110110 #b01001)
                expect
                (fp #b0 #b001110 #b01111)))
; expect = -10747904.0

(assert (not (= expect result)))

(check-sat)
(exit)
