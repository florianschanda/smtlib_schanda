(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b01101)
                arg1
                (fp #b1 #b100011 #b10110)))
(assert (fp.leq (fp #b1 #b100011 #b10110)
                arg1
                (fp #b1 #b001111 #b01000)))
; arg1 = -27.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg2
                (fp #b1 #b010100 #b00110)))
(assert (fp.leq (fp #b1 #b010100 #b00110)
                arg2
                (fp #b0 #b100001 #b11100)))
; arg2 = -0.000579833984375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b11000)
                expect
                (fp #b1 #b100011 #b10101)))
(assert (fp.leq (fp #b1 #b100011 #b10101)
                expect
                (fp #b0 #b101100 #b10000)))
; expect = -26.5

(assert (not (= expect result)))

(check-sat)
(exit)
