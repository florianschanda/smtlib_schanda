(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg1
                (fp #b1 #b0111 #b100)))
(assert (fp.leq (fp #b1 #b0111 #b100)
                arg1
                (fp #b1 #b0000 #b101)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b010)
                arg2
                (fp #b1 #b0000 #b111)))
(assert (fp.leq (fp #b1 #b0000 #b111)
                arg2
                (fp #b0 #b1110 #b000)))
; arg2 = -0.013671875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b110)
                expect
                (fp #b1 #b0111 #b011)))
(assert (fp.leq (fp #b1 #b0111 #b011)
                expect
                (fp #b0 #b0000 #b100)))
; expect = -1.375

(assert (not (= expect result)))

(check-sat)
(exit)
