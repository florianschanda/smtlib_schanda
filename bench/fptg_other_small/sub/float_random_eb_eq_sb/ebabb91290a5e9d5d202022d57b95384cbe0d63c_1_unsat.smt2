                arg2
                (fp #b0 #b0010011 #b100011)))
; arg2 = -0.00000000000000000021345230270808368544521727017126977443695068359375

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010011 #b000011)
                expect
                (fp #b1 #b1000101 #b011100)))
(assert (fp.leq (fp #b1 #b1000101 #b011100)
                expect
                (fp #b0 #b0111001 #b101111)))
; expect = -92.0

(assert (not (= expect result)))

