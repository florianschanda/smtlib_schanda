                arg2
                (fp #b0 #b010000 #b00000)))
(assert (fp.leq (fp #b0 #b010000 #b00000)
                arg2
                (fp #b0 #b101100 #b10001)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011100 #b10011)
                expect
                (fp #b1 #b010000 #b00000)))
(assert (fp.leq (fp #b1 #b010000 #b00000)
                expect
                (fp #b0 #b010100 #b11011)))
; expect = -0.000030517578125

(assert (= expect result))

(check-sat)
(exit)
