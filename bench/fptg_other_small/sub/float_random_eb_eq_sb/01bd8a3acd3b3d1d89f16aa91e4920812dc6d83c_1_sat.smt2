; arg2 = 0.00000000000000000000338813178901720135627329000271856784820556640625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100000 #b110010)
                expect
                (fp #b0 #b1000101 #b000110)))
(assert (fp.leq (fp #b0 #b1000101 #b000110)
                expect
                (fp #b0 #b1001110 #b010101)))
; expect = 70.0

(assert (= expect result))

