; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101000 #b010011)
                arg1
                (fp #b0 #b0001000 #b100110)))
(assert (fp.leq (fp #b0 #b0001000 #b100110)
                arg1
                (fp #b0 #b0001011 #b001101)))
; arg1 = 0.000000000000000044235448637408580907504074275493621826171875

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010111 #b000010)
                arg2
                (fp #b0 #b1011100 #b001010)))
(assert (fp.leq (fp #b0 #b1011100 #b001010)
                arg2
                (fp #b0 #b1100101 #b111011)))
; arg2 = 620756992.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111011 #b100101)
                expect
                (fp #b1 #b1011100 #b001010)))
(assert (fp.leq (fp #b1 #b1011100 #b001010)
                expect
                (fp #b0 #b1010111 #b110000)))
; expect = -620756992.0

(assert (= expect result))

(check-sat)
(exit)
