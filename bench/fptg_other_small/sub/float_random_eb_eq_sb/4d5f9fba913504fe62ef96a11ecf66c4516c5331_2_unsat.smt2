; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101101 #b000100)
                arg1
                (fp #b0 #b1000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000011 #b011000)
                arg1
                (fp #b0 #b1110011 #b110101)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b010011)
                arg2
                (fp #b0 #b0111111 #b111101)))
(assert (fp.leq (fp #b0 #b0111111 #b111101)
                arg2
                (fp #b0 #b1110000 #b000111)))
; arg2 = 1.953125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010001 #b011011)
                expect
                (fp #b0 #b1000011 #b010001)))
(assert (fp.leq (fp #b0 #b1000011 #b010001)
                expect
                (fp #b0 #b1001100 #b011110)))
; expect = 20.25

(assert (not (= expect result)))

(check-sat)
(exit)
