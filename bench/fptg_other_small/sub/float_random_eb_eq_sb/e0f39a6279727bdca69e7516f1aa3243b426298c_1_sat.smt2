(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00011 #b1100)
                arg1
                (fp #b0 #b10010 #b0000)))
(assert (fp.leq (fp #b0 #b10010 #b0000)
                arg1
                (fp #b0 #b11101 #b0000)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10000 #b0100)
                arg2
                (fp #b0 #b00000 #b1110)))
(assert (fp.leq (fp #b0 #b00000 #b1110)
                arg2
                (fp #b0 #b11001 #b0011)))
; arg2 = 0.00005340576171875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00111 #b0110)
                expect
                (fp #b0 #b10001 #b1111)))
(assert (fp.leq (fp #b0 #b10001 #b1111)
                expect
                (fp #b0 #b10110 #b1101)))
; expect = 7.75

(assert (= expect result))

(check-sat)
(exit)
