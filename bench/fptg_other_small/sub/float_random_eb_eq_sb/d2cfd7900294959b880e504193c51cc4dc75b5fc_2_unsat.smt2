(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00011 #b0011)
                arg1
                (fp #b0 #b01111 #b0100)))
(assert (fp.leq (fp #b0 #b01111 #b0100)
                arg1
                (fp #b0 #b11110 #b0011)))
; arg1 = 1.25

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b1101)
                arg2
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg2
                (fp #b0 #b11101 #b0001)))
; arg2 = 16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0001)
                expect
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                expect
                (fp #b1 #b11010 #b1101)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
