; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0011010 #b001011)
                arg1
                (fp #b0 #b1000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000101 #b000111)
                arg1
                (fp #b0 #b1011110 #b011001)))
; arg1 = 71.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010110 #b011010)
                arg2
                (fp #b1 #b0000000 #b111110)))
(assert (fp.leq (fp #b1 #b0000000 #b111110)
                arg2
                (fp #b0 #b1010001 #b111101)))
; arg2 = -0.0000000000000000002100641709190664840889439801685512065887451171875

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0000110 #b011100)
                expect
                (fp #b0 #b1000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000101 #b000111)
                expect
                (fp #b0 #b1111000 #b100010)))
; expect = 71.0

(assert (= expect result))

(check-sat)
(exit)
