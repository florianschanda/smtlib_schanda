(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b00010)
                arg1
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                arg1
                (fp #b0 #b110110 #b01010)))
; arg1 = -1.6875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b01010)
                arg2
                (fp #b0 #b100100 #b00011)))
(assert (fp.leq (fp #b0 #b100100 #b00011)
                arg2
                (fp #b0 #b101011 #b10111)))
; arg2 = 35.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b10101)
                expect
                (fp #b1 #b100100 #b00101)))
(assert (fp.leq (fp #b1 #b100100 #b00101)
                expect
                (fp #b0 #b010010 #b11110)))
; expect = -37.0

(assert (not (= expect result)))

(check-sat)
(exit)
