(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b001101)
                arg1
                (fp #b1 #b1000101 #b110111)))
(assert (fp.leq (fp #b1 #b1000101 #b110111)
                arg1
                (fp #b0 #b0100011 #b111011)))
; arg1 = -119.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0011101 #b101010)
                arg2
                (fp #b0 #b0100000 #b000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000)
                arg2
                (fp #b0 #b1011011 #b011001)))
; arg2 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011110 #b010111)
                expect
                (fp #b1 #b1000101 #b110111)))
(assert (fp.leq (fp #b1 #b1000101 #b110111)
                expect
                (fp #b1 #b0001001 #b001011)))
; expect = -119.0

(assert (= expect result))

(check-sat)
(exit)
