; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b00011)
                arg1
                (fp #b0 #b000001 #b00000)))
(assert (fp.leq (fp #b0 #b000001 #b00000)
                arg1
                (fp #b0 #b001001 #b01100)))
; arg1 = 0.000000000931322574615478515625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000011 #b10110)
                arg2
                (fp #b0 #b010001 #b11001)))
(assert (fp.leq (fp #b0 #b010001 #b11001)
                arg2
                (fp #b0 #b110000 #b00001)))
; arg2 = 0.0001087188720703125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10000)
                expect
                (fp #b1 #b010001 #b11000)))
(assert (fp.leq (fp #b1 #b010001 #b11000)
                expect
                (fp #b1 #b000101 #b10011)))
; expect = -0.0001068115234375

(assert (= expect result))

(check-sat)
(exit)
