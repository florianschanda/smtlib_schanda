(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg1
                (fp #b1 #b101 #b00)))
(assert (fp.leq (fp #b1 #b101 #b00)
                arg1
                (fp #b0 #b001 #b11)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg2
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg2
                (fp #b0 #b000 #b01)))
; arg2 = -0.5

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b00)
                expect
                (fp #b1 #b100 #b11)))
(assert (fp.leq (fp #b1 #b100 #b11)
                expect
                (fp #b1 #b000 #b01)))
; expect = -3.5

(assert (= expect result))

(check-sat)
(exit)
