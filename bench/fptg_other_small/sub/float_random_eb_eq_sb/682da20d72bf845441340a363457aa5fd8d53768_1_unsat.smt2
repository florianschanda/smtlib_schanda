                arg2
                (fp #b0 #b11100 #b0110)))
; arg2 = 0.00048828125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b1011)
                expect
                (fp #b0 #b10011 #b0101)))
(assert (fp.leq (fp #b0 #b10011 #b0101)
                expect
                (fp #b0 #b11000 #b1100)))
; expect = 21.0

(assert (not (= expect result)))

