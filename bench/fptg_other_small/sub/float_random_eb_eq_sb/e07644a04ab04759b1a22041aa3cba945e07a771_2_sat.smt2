; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b001001)
                arg1
                (fp #b0 #b1001110 #b010111)))
(assert (fp.leq (fp #b0 #b1001110 #b010111)
                arg1
                (fp #b0 #b1110111 #b010011)))
; arg1 = 44544.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101100 #b010101)
                arg2
                (fp #b0 #b1100000 #b111100)))
(assert (fp.leq (fp #b0 #b1100000 #b111100)
                arg2
                (fp #b0 #b1110110 #b111000)))
; arg2 = 16642998272.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b011001)
                expect
                (fp #b1 #b1100000 #b111100)))
(assert (fp.leq (fp #b1 #b1100000 #b111100)
                expect
                (fp #b0 #b1110010 #b011011)))
; expect = -16642998272.0

(assert (= expect result))

(check-sat)
(exit)
