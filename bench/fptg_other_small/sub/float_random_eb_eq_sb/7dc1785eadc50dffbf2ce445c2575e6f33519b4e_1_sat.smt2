(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0000010 #b111011)
                arg1
                (fp #b0 #b1000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000101 #b000111)
                arg1
                (fp #b0 #b1010000 #b100001)))
; arg1 = 71.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010110 #b110110)
                arg2
                (fp #b1 #b1000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000110 #b000000)
                arg2
                (fp #b0 #b1001101 #b011011)))
; arg2 = -128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101001 #b111011)
                expect
                (fp #b0 #b1000110 #b100011)))
(assert (fp.leq (fp #b0 #b1000110 #b100011)
                expect
                (fp #b0 #b1101111 #b110010)))
; expect = 198.0

(assert (= expect result))

(check-sat)
(exit)
