; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000101 #b00111)
                arg1
                (fp #b0 #b010000 #b00000)))
(assert (fp.leq (fp #b0 #b010000 #b00000)
                arg1
                (fp #b0 #b011111 #b00111)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b11011)
                arg2
                (fp #b0 #b011111 #b00011)))
(assert (fp.leq (fp #b0 #b011111 #b00011)
                arg2
                (fp #b0 #b100001 #b11111)))
; arg2 = 1.09375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b00000)
                expect
                (fp #b1 #b011111 #b00011)))
(assert (fp.leq (fp #b1 #b011111 #b00011)
                expect
                (fp #b0 #b100010 #b00110)))
; expect = -1.09375

(assert (not (= expect result)))

(check-sat)
(exit)
