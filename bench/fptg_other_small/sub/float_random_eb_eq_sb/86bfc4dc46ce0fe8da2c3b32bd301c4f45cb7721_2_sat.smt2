(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg1
                (fp #b1 #b1010 #b110)))
(assert (fp.leq (fp #b1 #b1010 #b110)
                arg1
                (fp #b0 #b0100 #b101)))
; arg1 = -14.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b010)
                arg2
                (fp #b0 #b1000 #b100)))
(assert (fp.leq (fp #b0 #b1000 #b100)
                arg2
                (fp #b0 #b1000 #b101)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b111)
                expect
                (fp #b1 #b1011 #b001)))
(assert (fp.leq (fp #b1 #b1011 #b001)
                expect
                (fp #b0 #b0111 #b000)))
; expect = -18.0

(assert (= expect result))

(check-sat)
(exit)
