; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0000111 #b110001)
                arg1
                (fp #b0 #b0111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111 #b000100)
                arg1
                (fp #b0 #b1101110 #b100111)))
; arg1 = 1.0625

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101110 #b111000)
                arg2
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                arg2
                (fp #b0 #b1110100 #b101110)))
; arg2 = 4261412864.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111100 #b101100)
                expect
                (fp #b1 #b1011110 #b111111)))
(assert (fp.leq (fp #b1 #b1011110 #b111111)
                expect
                (fp #b1 #b0001010 #b001011)))
; expect = -4261412864.0

(assert (= expect result))

(check-sat)
(exit)
