(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1110)
                arg1
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg1
                (fp #b0 #b01110 #b1100)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1000)
                arg2
                (fp #b0 #b10001 #b1000)))
(assert (fp.leq (fp #b0 #b10001 #b1000)
                arg2
                (fp #b0 #b11010 #b0101)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10100 #b1101)
                expect
                (fp #b1 #b10001 #b1000)))
(assert (fp.leq (fp #b1 #b10001 #b1000)
                expect
                (fp #b0 #b01011 #b1011)))
; expect = -6.0

(assert (= expect result))

(check-sat)
(exit)
