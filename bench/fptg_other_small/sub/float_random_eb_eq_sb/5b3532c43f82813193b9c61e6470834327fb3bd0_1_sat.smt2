(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011111 #b11000)
                arg1
                (fp #b0 #b101110 #b11111)))
(assert (fp.leq (fp #b0 #b101110 #b11111)
                arg1
                (fp #b0 #b101111 #b00101)))
; arg1 = 64512.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10111)
                arg2
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b0 #b110010 #b00000)))
; arg2 = -320.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100000 #b00001)
                expect
                (fp #b0 #b101110 #b11111)))
(assert (fp.leq (fp #b0 #b101110 #b11111)
                expect
                (fp #b0 #b111101 #b01001)))
; expect = 64512.0

(assert (= expect result))

(check-sat)
(exit)
