(assert (fp.leq (fp #b0 #b0111111 #b000000)
                arg2
                (fp #b0 #b1101011 #b011010)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b010100)
                expect
                (fp #b1 #b0111110 #b111111)))
(assert (fp.leq (fp #b1 #b0111110 #b111111)
                expect
                (fp #b1 #b0001000 #b100100)))
; expect = -0.9921875

(assert (not (= expect result)))

