; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b10)
                arg1
                (fp #b0 #b110 #b10)))
(assert (fp.leq (fp #b0 #b110 #b10)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 12.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b011 #b11)
                arg2
                (fp #b0 #b110 #b11)))
(assert (fp.leq (fp #b0 #b110 #b11)
                arg2
                (fp #b0 #b111 #b00)))
; arg2 = 14.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b00)
                expect
                (fp #b1 #b100 #b00)))
(assert (fp.leq (fp #b1 #b100 #b00)
                expect
                (fp #b0 #b000 #b01)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
