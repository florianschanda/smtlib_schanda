                arg2
                (fp #b0 #b00000 #b0001)))
(assert (fp.leq (fp #b0 #b00000 #b0001)
                arg2
                (fp #b0 #b01101 #b0100)))
; arg2 = 0.000003814697265625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1100)
                expect
                (fp #b1 #b00110 #b0000)))
(assert (fp.leq (fp #b1 #b00110 #b0000)
                expect
                (fp #b1 #b00010 #b1001)))
; expect = -0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
