(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg1
                (fp #b0 #b1010 #b111)))
(assert (fp.leq (fp #b0 #b1010 #b111)
                arg1
                (fp #b0 #b1100 #b110)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b011)
                arg2
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                arg2
                (fp #b0 #b0100 #b111)))
; arg2 = 0.001953125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b010)
                expect
                (fp #b0 #b1010 #b111)))
(assert (fp.leq (fp #b0 #b1010 #b111)
                expect
                (fp #b0 #b1101 #b111)))
; expect = 15.0

(assert (not (= expect result)))

(check-sat)
(exit)
