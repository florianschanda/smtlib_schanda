(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100000 #b11101)
                arg1
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                arg1
                (fp #b1 #b000100 #b01111)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b00101)
                arg2
                (fp #b0 #b010000 #b00000)))
(assert (fp.leq (fp #b0 #b010000 #b00000)
                arg2
                (fp #b0 #b110011 #b11100)))
; arg2 = 0.000030517578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b10000)
                expect
                (fp #b1 #b011111 #b00001)))
(assert (fp.leq (fp #b1 #b011111 #b00001)
                expect
                (fp #b0 #b101110 #b01100)))
; expect = -1.03125

(assert (not (= expect result)))

(check-sat)
(exit)
