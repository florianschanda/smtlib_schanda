; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b001 #b10)))
(assert (fp.leq (fp #b0 #b001 #b10)
                arg1
                (fp #b0 #b010 #b00)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg2
                (fp #b0 #b010 #b01)))
(assert (fp.leq (fp #b0 #b010 #b01)
                arg2
                (fp #b0 #b101 #b01)))
; arg2 = 0.625

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b00)
                expect
                (fp #b1 #b001 #b00)))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b0 #b000 #b00)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
