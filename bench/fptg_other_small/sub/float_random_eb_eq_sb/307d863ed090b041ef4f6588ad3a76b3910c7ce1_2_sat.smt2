(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b0101)
                arg1
                (fp #b0 #b00111 #b0100)))
(assert (fp.leq (fp #b0 #b00111 #b0100)
                arg1
                (fp #b0 #b01010 #b1011)))
; arg1 = 0.0048828125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01101 #b0100)
                expect
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                expect
                (fp #b0 #b10010 #b1100)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
