(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0111 #b001)
                arg1
                (fp #b0 #b1010 #b111)))
(assert (fp.leq (fp #b0 #b1010 #b111)
                arg1
                (fp #b0 #b1100 #b110)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b001)
                arg2
                (fp #b1 #b1010 #b100)))
(assert (fp.leq (fp #b1 #b1010 #b100)
                arg2
                (fp #b1 #b0011 #b100)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b011)
                expect
                (fp #b0 #b1011 #b110)))
(assert (fp.leq (fp #b0 #b1011 #b110)
                expect
                (fp #b0 #b1100 #b110)))
; expect = 28.0

(assert (not (= expect result)))

(check-sat)
(exit)
