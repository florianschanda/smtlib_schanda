; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b01100)
                arg1
                (fp #b1 #b100011 #b10110)))
(assert (fp.leq (fp #b1 #b100011 #b10110)
                arg1
                (fp #b0 #b011110 #b11011)))
; arg1 = -27.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011000 #b11010)
                arg2
                (fp #b0 #b000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000 #b01000)
                arg2
                (fp #b0 #b011101 #b10010)))
; arg2 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b11001)
                expect
                (fp #b1 #b100011 #b10111)))
(assert (fp.leq (fp #b1 #b100011 #b10111)
                expect
                (fp #b0 #b011001 #b10110)))
; expect = -27.5

(assert (not (= expect result)))

(check-sat)
(exit)
