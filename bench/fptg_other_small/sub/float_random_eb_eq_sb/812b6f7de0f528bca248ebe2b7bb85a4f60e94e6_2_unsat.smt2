(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010100 #b01110)
                arg1
                (fp #b0 #b011111 #b00111)))
(assert (fp.leq (fp #b0 #b011111 #b00111)
                arg1
                (fp #b0 #b100001 #b11010)))
; arg1 = 1.21875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b00110)
                arg2
                (fp #b1 #b011111 #b01000)))
(assert (fp.leq (fp #b1 #b011111 #b01000)
                arg2
                (fp #b0 #b001100 #b11000)))
; arg2 = -1.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010100 #b11100)
                expect
                (fp #b0 #b100000 #b01000)))
(assert (fp.leq (fp #b0 #b100000 #b01000)
                expect
                (fp #b0 #b100110 #b01010)))
; expect = 2.5

(assert (not (= expect result)))

(check-sat)
(exit)
