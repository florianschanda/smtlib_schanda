(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0110)
                arg1
                (fp #b1 #b10111 #b1001)))
(assert (fp.leq (fp #b1 #b10111 #b1001)
                arg1
                (fp #b0 #b01001 #b0001)))
; arg1 = -400.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1100)
                arg2
                (fp #b1 #b00000 #b0100)))
(assert (fp.leq (fp #b1 #b00000 #b0100)
                arg2
                (fp #b0 #b01000 #b0101)))
; arg2 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0110)
                expect
                (fp #b1 #b10111 #b1000)))
(assert (fp.leq (fp #b1 #b10111 #b1000)
                expect
                (fp #b0 #b10011 #b0010)))
; expect = -384.0

(assert (= expect result))

(check-sat)
(exit)
