(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b10100)
                arg1
                (fp #b0 #b100100 #b01100)))
(assert (fp.leq (fp #b0 #b100100 #b01100)
                arg1
                (fp #b0 #b111110 #b01111)))
; arg1 = 44.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b11001)
                arg2
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                arg2
                (fp #b1 #b001100 #b10011)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010111 #b10000)
                expect
                (fp #b0 #b100100 #b01101)))
(assert (fp.leq (fp #b0 #b100100 #b01101)
                expect
                (fp #b0 #b110001 #b01100)))
; expect = 45.0

(assert (= expect result))

(check-sat)
(exit)
