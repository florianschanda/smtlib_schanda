; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100110 #b01100)
                arg1
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                arg1
                (fp #b1 #b001001 #b01101)))
; arg1 = -1.6875

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b01100)
                arg2
                (fp #b1 #b110001 #b11001)))
(assert (fp.leq (fp #b1 #b110001 #b11001)
                arg2
                (fp #b0 #b111101 #b10011)))
; arg2 = -466944.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011101 #b11101)
                expect
                (fp #b0 #b110001 #b11001)))
(assert (fp.leq (fp #b0 #b110001 #b11001)
                expect
                (fp #b0 #b110101 #b10010)))
; expect = 466944.0

(assert (not (= expect result)))

(check-sat)
(exit)
