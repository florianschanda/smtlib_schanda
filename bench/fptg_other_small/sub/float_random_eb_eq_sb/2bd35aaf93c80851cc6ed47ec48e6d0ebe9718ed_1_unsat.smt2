                arg2
                (fp #b1 #b0001001 #b000010)))
(assert (fp.leq (fp #b1 #b0001001 #b000010)
                arg2
                (fp #b0 #b1101111 #b110101)))
; arg2 = -0.00000000000000005724587470723463411559350788593292236328125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001111 #b011001)
                expect
                (fp #b1 #b1000101 #b011100)))
(assert (fp.leq (fp #b1 #b1000101 #b011100)
                expect
                (fp #b0 #b1110001 #b001011)))
; expect = -92.0

(assert (not (= expect result)))

(check-sat)
(exit)
