(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b1000 #b001)
                arg1
                (fp #b0 #b1010 #b000)))
(assert (fp.leq (fp #b0 #b1010 #b000)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b000)
                arg2
                (fp #b0 #b0010 #b011)))
(assert (fp.leq (fp #b0 #b0010 #b011)
                arg2
                (fp #b0 #b0111 #b100)))
; arg2 = 0.04296875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0000 #b111)
                expect
                (fp #b0 #b1001 #b111)))
(assert (fp.leq (fp #b0 #b1001 #b111)
                expect
                (fp #b0 #b1110 #b101)))
; expect = 7.5

(assert (= expect result))

(check-sat)
(exit)
