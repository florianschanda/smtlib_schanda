(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b100)
                arg1
                (fp #b1 #b0000 #b111)))
(assert (fp.leq (fp #b1 #b0000 #b111)
                arg1
                (fp #b0 #b1000 #b100)))
; arg1 = -0.013671875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b101)
                arg2
                (fp #b0 #b0010 #b011)))
(assert (fp.leq (fp #b0 #b0010 #b011)
                arg2
                (fp #b0 #b1101 #b000)))
; arg2 = 0.04296875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b110)
                expect
                (fp #b1 #b0010 #b111)))
(assert (fp.leq (fp #b1 #b0010 #b111)
                expect
                (fp #b0 #b0001 #b111)))
; expect = -0.05859375

(assert (= expect result))

(check-sat)
(exit)
