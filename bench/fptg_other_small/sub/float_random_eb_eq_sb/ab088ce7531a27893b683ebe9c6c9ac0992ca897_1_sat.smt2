(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b011 #b11)))
(assert (fp.leq (fp #b0 #b011 #b11)
                arg1
                (fp #b0 #b110 #b10)))
; arg1 = 1.75

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b10)
                arg2
                (fp #b1 #b110 #b00)))
(assert (fp.leq (fp #b1 #b110 #b00)
                arg2
                (fp #b1 #b010 #b01)))
; arg2 = -8.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b101 #b01)
                expect
                (fp #b0 #b110 #b00)))
(assert (fp.leq (fp #b0 #b110 #b00)
                expect
                (fp #b0 #b111 #b00)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
