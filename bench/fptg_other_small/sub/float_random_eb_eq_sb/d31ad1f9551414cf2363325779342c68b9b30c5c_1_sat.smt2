(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b000)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b0110 #b011)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b110)
                arg2
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg2
                (fp #b0 #b1001 #b000)))
; arg2 = -1.625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0010 #b000)
                expect
                (fp #b0 #b0111 #b100)))
(assert (fp.leq (fp #b0 #b0111 #b100)
                expect
                (fp #b0 #b1011 #b101)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
