(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                arg1
                (fp #b0 #b0110 #b110)))
; arg1 = 0.001953125

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b000)
                arg2
                (fp #b0 #b0001 #b000)))
(assert (fp.leq (fp #b0 #b0001 #b000)
                arg2
                (fp #b0 #b1001 #b001)))
; arg2 = 0.015625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                expect
                (fp #b1 #b0000 #b111)))
(assert (fp.leq (fp #b1 #b0000 #b111)
                expect
                (fp #b0 #b1010 #b011)))
; expect = -0.013671875

(assert (= expect result))

(check-sat)
(exit)
