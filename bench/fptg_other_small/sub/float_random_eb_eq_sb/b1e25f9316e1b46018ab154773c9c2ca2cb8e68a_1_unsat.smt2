                arg2
                (fp #b0 #b0111111 #b000000)))
(assert (fp.leq (fp #b0 #b0111111 #b000000)
                arg2
                (fp #b0 #b1100000 #b000000)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010101 #b100110)
                expect
                (fp #b1 #b0111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111 #b000000)
                expect
                (fp #b0 #b0101100 #b101001)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
