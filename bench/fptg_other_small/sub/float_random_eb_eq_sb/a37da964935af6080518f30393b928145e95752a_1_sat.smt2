(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1101)
                arg1
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg1
                (fp #b0 #b01101 #b1100)))
; arg1 = -16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0000)
                arg2
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg2
                (fp #b0 #b11010 #b1111)))
; arg2 = 0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1001)
                expect
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                expect
                (fp #b1 #b11010 #b0111)))
; expect = -16384.0

(assert (= expect result))

(check-sat)
(exit)
