(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b10111)
                arg1
                (fp #b0 #b110110 #b10000)))
(assert (fp.leq (fp #b0 #b110110 #b10000)
                arg1
                (fp #b0 #b111001 #b01110)))
; arg1 = 12582912.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b101110 #b11011)
                arg2
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg2
                (fp #b0 #b101000 #b10011)))
; arg2 = -0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b11001)
                expect
                (fp #b0 #b110110 #b10000)))
(assert (fp.leq (fp #b0 #b110110 #b10000)
                expect
                (fp #b0 #b111001 #b01000)))
; expect = 12582912.0

(assert (not (= expect result)))

(check-sat)
(exit)
