(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101001 #b100000)
                arg1
                (fp #b0 #b1000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000101 #b000111)
                arg1
                (fp #b0 #b1010111 #b010001)))
; arg1 = 71.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110010 #b110111)
                arg2
                (fp #b1 #b0111111 #b100001)))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg2
                (fp #b1 #b0001001 #b100001)))
; arg2 = -1.515625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b000010)
                expect
                (fp #b0 #b1000101 #b001000)))
(assert (fp.leq (fp #b0 #b1000101 #b001000)
                expect
                (fp #b0 #b1110001 #b100001)))
; expect = 72.0

(assert (= expect result))

(check-sat)
(exit)
