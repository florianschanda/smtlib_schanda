(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011011 #b10010)
                arg1
                (fp #b0 #b100001 #b00000)))
(assert (fp.leq (fp #b0 #b100001 #b00000)
                arg1
                (fp #b0 #b101101 #b11101)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000000 #b11001)
                arg2
                (fp #b0 #b100110 #b11100)))
(assert (fp.leq (fp #b0 #b100110 #b11100)
                arg2
                (fp #b0 #b101100 #b01100)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b00101)
                expect
                (fp #b1 #b100110 #b11011)))
(assert (fp.leq (fp #b1 #b100110 #b11011)
                expect
                (fp #b0 #b011111 #b01010)))
; expect = -236.0

(assert (= expect result))

(check-sat)
(exit)
