(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010111 #b0000001110101011)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b0 #b1011101 #b0100000111110000)))
; arg1 = -36787.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000001 #b0110001001101011)
                arg2
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1000001 #b1110000000001111)))
; arg2 = -0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b1100110111001111)
                expect
                (fp #b1 #b1001110 #b0001111101100101)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100101)
                expect
                (fp #b0 #b0000001 #b1010111011011110)))
; expect = -36786.5

(assert (= expect result))

(check-sat)
(exit)
