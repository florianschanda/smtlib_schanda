                arg2
                (fp #b0 #b0111111 #b0000001011100101)))
(assert (fp.leq (fp #b0 #b0111111 #b0000001011100101)
                arg2
                (fp #b0 #b1100000 #b0100101110001101)))
; arg2 = 1.0113067626953125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b0000000111110011)
                expect
                (fp #b1 #b1001111 #b1111110001110110)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110110)
                expect
                (fp #b0 #b0010000 #b1100001000110100)))
; expect = -130166.0

(assert (= expect result))

(check-sat)
(exit)
