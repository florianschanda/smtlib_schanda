(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b1110100 #b1000111110000000)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001001 #b0101010000110010)
                expect
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b0010100 #b1001111111010011)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
