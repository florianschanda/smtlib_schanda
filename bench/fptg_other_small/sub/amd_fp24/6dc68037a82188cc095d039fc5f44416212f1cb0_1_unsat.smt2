(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b1 #b0000000 #b1101101010111001)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011110 #b0010110000010001)
                expect
                (fp #b0 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b0 #b1011100 #b1111011010001110)
                expect
                (fp #b0 #b1111101 #b1001110000000011)))
; expect = 1053933568.0

(assert (not (= expect result)))

(check-sat)
(exit)
