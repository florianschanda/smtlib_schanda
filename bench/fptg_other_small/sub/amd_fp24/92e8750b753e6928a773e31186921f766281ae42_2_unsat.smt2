                arg2
                (fp #b0 #b1101001 #b1101111000011101)))
; arg2 = 9884160.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b0010111100111011)
                expect
                (fp #b1 #b1010110 #b0010110011011001)))
(assert (fp.leq (fp #b1 #b1010110 #b0010110011011001)
                expect
                (fp #b1 #b0001000 #b0000101110101101)))
; expect = -9858176.0

(assert (not (= expect result)))

(check-sat)
