; Format: AMD_FP24
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001111 #b1000110011100110)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1100010 #b0001111101111111)))
; arg1 = 0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000011 #b0101100000000010)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1001111 #b1110101011010101)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0101011100110101)
                expect
                (fp #b1 #b1001101 #b0110101110101011)))
(assert (fp.leq (fp #b1 #b1001101 #b0110101110101011)
                expect
                (fp #b1 #b1001011 #b1111000001110100)))
; expect = -23274.75

(assert (= expect result))

(check-sat)
(exit)
