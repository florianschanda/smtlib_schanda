; Format: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b1001000000100011)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1110111 #b1101101100111101)))
; arg1 = 26078.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0010100010101101)
                arg2
                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1110010 #b0101000100001100)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b1010101001000111)
                expect
                (fp #b1 #b1100111 #b1010000011110000)))
(assert (fp.leq (fp #b1 #b1100111 #b1010000011110000)
                expect
                (fp #b1 #b0101001 #b1010100110101000)))
; expect = -1790732926976.0

(assert (not (= expect result)))

(check-sat)
(exit)
