(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1001101001011011)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b1 #b1010011 #b1110010010100001)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101111 #b0010011001111110)
                arg2
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0010010 #b0001110001100110)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1111100011111101)
                expect
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                expect
                (fp #b1 #b0010101 #b1000101101001010)))
; expect = -4294934528.0

(assert (= expect result))

(check-sat)
(exit)
