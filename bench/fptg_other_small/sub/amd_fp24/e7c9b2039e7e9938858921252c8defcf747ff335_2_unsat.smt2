                arg2
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1101000 #b0101011010110011)))
; arg2 = 4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b1010111001100000)
                expect
                (fp #b1 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1011111 #b0000000000000000)
                expect
                (fp #b1 #b0010110 #b1111001001010101)))
; expect = -4294967296.0

(assert (not (= expect result)))

(check-sat)
(exit)
