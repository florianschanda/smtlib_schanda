;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b1000111101000101)
                arg1
                (fp #b1 #b0000001 #b0000000000000000)))
