; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b1111001110110010)
                arg1
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg1
                (fp #b0 #b1011001 #b0111011001011100)))
; arg1 = -1.946075439453125

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b0101101100000001)
                arg2
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg2
                (fp #b1 #b0100100 #b1011101011111100)))
; arg2 = -131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000110 #b0101010010100001)
                expect
                (fp #b0 #b1001111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1001111 #b1111111111111111)
                expect
                (fp #b0 #b1010000 #b1101010001010111)))
; expect = 131071.0

(assert (not (= expect result)))

(check-sat)
(exit)
