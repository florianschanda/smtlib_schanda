; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b1110010101010101)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b1 #b0001001 #b0111110011011100)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b0101001110110011)
                arg2
                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1111100 #b0010101101000011)))
; arg2 = 1790749704192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b0110001110100101)
                expect
                (fp #b1 #b1100111 #b1010000111110001)))
(assert (fp.leq (fp #b1 #b1100111 #b1010000111110001)
                expect
                (fp #b1 #b0101110 #b0000100110001110)))
; expect = -1795044671488.0

(assert (not (= expect result)))

(check-sat)
(exit)
