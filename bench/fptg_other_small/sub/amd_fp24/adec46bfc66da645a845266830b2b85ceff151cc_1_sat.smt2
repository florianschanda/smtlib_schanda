                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b1 #b1000011 #b0101001111001111)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101011 #b1101000101110010)
                expect
                (fp #b0 #b1010110 #b1010010100010101)))
(assert (fp.leq (fp #b0 #b1010110 #b1010010100010101)
                expect
                (fp #b0 #b1111110 #b1110111011100100)))
; expect = 13798016.0

(assert (= expect result))

(check-sat)
(exit)
