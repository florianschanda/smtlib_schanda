;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b0111101010110101)
                arg1
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b0010001 #b1011001000001101)))
; arg1 = -0.00000000000000000021684043449710088680149056017398834228515625

