                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b1 #b0101000 #b1111010000100101)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b1000100100010100)
                expect
                (fp #b0 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b0 #b1011100 #b1111011010001110)
                expect
                (fp #b0 #b1101000 #b0010001101011101)))
; expect = 1053933568.0

(assert (= expect result))

(check-sat)
(exit)
