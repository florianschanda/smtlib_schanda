(assert (fp.leq (fp #b1 #b1001101 #b0110010000011011)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b0010111 #b0111001000101001)))
; arg2 = -0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b1101100101000101)
                expect
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                expect
                (fp #b0 #b1011100 #b1010110001100101)))
; expect = -0.0000000004656612873077392578125

(assert (not (= expect result)))

(check-sat)
(exit)
