                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1010000 #b0110101010111011)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b1010100111101110)
                expect
                (fp #b1 #b1000000 #b0101110000100101)))
(assert (fp.leq (fp #b1 #b1000000 #b0101110000100101)
                expect
                (fp #b1 #b0001110 #b0000111011101110)))
; expect = -2.719879150390625

(assert (not (= expect result)))

(check-sat)
(exit)
