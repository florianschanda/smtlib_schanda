(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b1011000111111011)
                arg1
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg1
                (fp #b1 #b0011001 #b0000000000011100)))
; arg1 = -1.946075439453125

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0110110 #b1101000101011000)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1010100 #b1111100110000100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
