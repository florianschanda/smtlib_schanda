                arg2
                (fp #b1 #b0001101 #b1100001110000011)))
; arg2 = -0.0003445781767368316650390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1011100 #b0010101110001110)
                expect
                (fp #b0 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1011111 #b0000000000000000)
                expect
                (fp #b0 #b1110011 #b0011100001011011)))
; expect = 4294967296.0

(assert (= expect result))

(check-sat)
