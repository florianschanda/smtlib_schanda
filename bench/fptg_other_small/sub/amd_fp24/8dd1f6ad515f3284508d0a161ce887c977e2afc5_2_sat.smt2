; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0100100010010100)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b0110001 #b0000100100111010)))
; arg1 = -1.417633056640625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011111100)
                arg2
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg2
                (fp #b1 #b0001101 #b1100100000101000)))
; arg2 = -131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111011 #b1111110101011010)
                expect
                (fp #b0 #b1001111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1001111 #b1111111111111111)
                expect
                (fp #b0 #b1100110 #b1110000011101101)))
; expect = 131071.0

(assert (= expect result))

(check-sat)
(exit)
