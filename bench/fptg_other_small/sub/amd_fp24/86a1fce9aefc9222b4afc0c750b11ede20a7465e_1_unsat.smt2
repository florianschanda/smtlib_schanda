                expect
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                expect
                (fp #b0 #b1101111 #b0011011010010111)))
; expect = 4294934528.0

(assert (not (= expect result)))

