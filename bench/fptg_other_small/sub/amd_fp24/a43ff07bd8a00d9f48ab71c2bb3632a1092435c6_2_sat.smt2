; Format: AMD_FP24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1101001111010111)
                arg1
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b0001110 #b1011111100100000)))
; arg1 = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b1111110100101100)
                arg2
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1001110 #b0101011010001000)))
; arg2 = -131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001010 #b1110010010101100)
                expect
                (fp #b0 #b1010000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000001)
                expect
                (fp #b0 #b1011001 #b1011111110111011)))
; expect = 131074.0

(assert (= expect result))

(check-sat)
(exit)
