; Format: AMD_FP24
; Arg1: +ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b1000100101111010)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1001111 #b1000010001000010)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010111 #b1010101011100001)
                arg2
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0111110 #b1000011011000111)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101011 #b1011101101100000)
                expect
                (fp #b0 #b0111111 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000001)
                expect
                (fp #b0 #b1011100 #b1110001000110100)))
; expect = 1.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
