(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1100100001110111)
                arg1
                (fp #b1 #b1010101 #b0001001101010100)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010100)
                arg1
                (fp #b1 #b0111001 #b0010110000011010)))
; arg1 = -4510976.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1010001 #b0011101001001100)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1100111 #b0001011011000010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
