                arg2
                (fp #b1 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b0101010 #b1111000000111111)))
; arg2 = -0.000000000000000000204833080725281137073057191599900761502794921398162841796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010101 #b0111100100110001)
                expect
                (fp #b0 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b0 #b0000000 #b1111000111010011)
                expect
                (fp #b0 #b1010001 #b1110001000111101)))
; expect = 0.000000000000000000204833080725281137073057191599900761502794921398162841796875

(assert (not (= expect result)))

(check-sat)
