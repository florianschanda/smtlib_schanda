(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0001001 #b1101111101000011)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1001111 #b0100001001010101)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
