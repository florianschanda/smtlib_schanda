                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b1 #b0011010 #b0011111000110000)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1111100101010011)
                expect
                (fp #b1 #b1010101 #b0001000100100010)))
(assert (fp.leq (fp #b1 #b1010101 #b0001000100100010)
                expect
                (fp #b0 #b1101110 #b0001000010100010)))
; expect = -4475008.0

(assert (not (= expect result)))

(check-sat)
(exit)
