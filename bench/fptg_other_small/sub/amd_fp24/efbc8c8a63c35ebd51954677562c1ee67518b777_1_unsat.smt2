(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg2
                (fp #b1 #b0000100 #b0100101110111011)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110111 #b1000000111001000)
                expect
                (fp #b0 #b1000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b0000000000000000)
                expect
                (fp #b0 #b1001100 #b0100101000111011)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
