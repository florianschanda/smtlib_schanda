(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001000 #b0011111100010101)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1001010 #b1010000111101101)))
; arg1 = 1.1314697265625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0110100001111011)
                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b1 #b0010111 #b1011010000010100)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b0011000010101111)
                expect
                (fp #b0 #b1001110 #b0100010010110011)))
(assert (fp.leq (fp #b0 #b1001110 #b0100010010110011)
                expect
                (fp #b0 #b1100011 #b0001111111001111)))
; expect = 41561.5

(assert (= expect result))

(check-sat)
(exit)
