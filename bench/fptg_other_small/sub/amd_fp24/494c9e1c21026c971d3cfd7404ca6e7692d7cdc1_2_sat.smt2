(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000001 #b0100101001100100)
                arg1
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg1
                (fp #b0 #b1111111 #b0000000000000000)))
; arg1 = 18446603336221196288.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1001001101000110)
                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b1 #b0001101 #b0100110111001111)))
; arg2 = -41560.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
