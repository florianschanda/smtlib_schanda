(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0010001111101010)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b1 #b1000101 #b1001100101010001)))
; arg1 = -14354451791872.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                arg2
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                arg2
                (fp #b1 #b1110101 #b1001101000000011)))
; arg2 = -18446603336221196288.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101100 #b1000001001110011)
                expect
                (fp #b0 #b1111110 #b1111111111111110)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111110)
                expect
                (fp #b0 #b1111110 #b1111111111111111)))
; expect = 18446462598732840960.0

(assert (= expect result))

(check-sat)
(exit)
