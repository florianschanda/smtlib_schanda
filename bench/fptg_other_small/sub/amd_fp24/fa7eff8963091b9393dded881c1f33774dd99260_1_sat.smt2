;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0011111000000110)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b1 #b1100100 #b1000001010010001)))
; arg1 = -14354451791872.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101001 #b0000110111010001)
                arg2
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1101000 #b0101000000110010)))
; arg2 = 131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b0011001100110000)
                expect
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                expect
                (fp #b0 #b1100000 #b1001000110010000)))
; expect = -14354451791872.0

(assert (= expect result))

(check-sat)
(exit)
