;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b0011100011100111)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
