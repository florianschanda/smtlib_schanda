(assert (fp.leq (fp #b0 #b1111101 #b0000000000000000)
                arg2
                (fp #b0 #b1111110 #b0100100101101011)))
; arg2 = 4611686018427387904.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1000111101010011)
                expect
                (fp #b1 #b1111101 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000001)
                expect
                (fp #b0 #b1110010 #b0010111011000011)))
; expect = -4611756387171565568.0

(assert (= expect result))

(check-sat)
(exit)
