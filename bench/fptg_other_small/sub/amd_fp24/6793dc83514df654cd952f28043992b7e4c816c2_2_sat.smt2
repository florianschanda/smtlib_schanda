                arg2
                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b0 #b1101101 #b1001110000101010)))
; arg2 = -1.875732421875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b0100111000010111)
                expect
                (fp #b0 #b0111111 #b1110000000110001)))
(assert (fp.leq (fp #b0 #b0111111 #b1110000000110001)
                expect
                (fp #b0 #b1110001 #b0111010001111001)))
; expect = 1.8757476806640625

(assert (= expect result))

(check-sat)
(exit)
