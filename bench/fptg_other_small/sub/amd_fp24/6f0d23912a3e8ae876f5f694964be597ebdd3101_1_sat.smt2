                arg2
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg2
                (fp #b0 #b1111111 #b0000000000000000)))
; arg2 = 18446603336221196288.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                expect
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                expect
                (fp #b1 #b0010000 #b1010111011100000)))
; expect = -18446603336221196288.0

(assert (= expect result))

(check-sat)
(exit)
