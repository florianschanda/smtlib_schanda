(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0101011010011101)
                expect
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                expect
                (fp #b0 #b1011001 #b1100101111101100)))
; expect = 1.02752685546875

(assert (= expect result))

(check-sat)
