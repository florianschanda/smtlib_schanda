                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b0111100 #b1101010110010011)))
; arg2 = 0.00179137289524078369140625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b0111010011010011)
                expect
                (fp #b1 #b1001111 #b1111110001110110)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110110)
                expect
                (fp #b0 #b1010000 #b1010101011110011)))
; expect = -130166.0

(assert (not (= expect result)))

(check-sat)
(exit)
