                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b0 #b1111100 #b0110010011100001)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011111 #b1010100110010011)
                expect
                (fp #b0 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b0 #b1011100 #b1111011010001110)
                expect
                (fp #b0 #b1100101 #b1101110110110111)))
; expect = 1053933568.0

(assert (= expect result))

(check-sat)
(exit)
