                arg2
                (fp #b1 #b0000101 #b0000100111011001)))
; arg2 = -59593208102912.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1000100111010000)
                expect
                (fp #b0 #b1101100 #b1011000110011010)))
(assert (fp.leq (fp #b0 #b1101100 #b1011000110011010)
                expect
                (fp #b0 #b1111000 #b1010110111010110)))
; expect = 59593744973824.0

(assert (not (= expect result)))

(check-sat)
(exit)
