;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010001 #b0111100110000001)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
