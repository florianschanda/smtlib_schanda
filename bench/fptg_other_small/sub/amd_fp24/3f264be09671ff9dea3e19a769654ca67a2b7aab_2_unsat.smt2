(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1011111 #b1010011011100101)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b0100001000000011)
                expect
                (fp #b0 #b1011110 #b1111111111111100)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111100)
                expect
                (fp #b0 #b1100100 #b1100000100000001)))
; expect = 4294836224.0

(assert (not (= expect result)))

(check-sat)
(exit)
