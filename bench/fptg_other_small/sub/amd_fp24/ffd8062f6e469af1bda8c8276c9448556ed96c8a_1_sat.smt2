                arg2
                (fp #b0 #b1110001 #b0011110110100010)))
; arg2 = -13798144.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110001 #b0111101101111010)
                expect
                (fp #b0 #b1010110 #b1010000100010110)))
(assert (fp.leq (fp #b0 #b1010110 #b1010000100010110)
                expect
                (fp #b0 #b1100100 #b0011111110111010)))
; expect = 13667072.0

(assert (= expect result))

(check-sat)
