; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b0101111101011000)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b1000000 #b1010001111100101)))
; arg1 = -130165.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b1000100011010111)
                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b0 #b1100001 #b1011000011010110)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100111 #b0000011100010100)
                expect
                (fp #b0 #b1011100 #b1111011001111110)))
(assert (fp.leq (fp #b0 #b1011100 #b1111011001111110)
                expect
                (fp #b0 #b1101000 #b0011010100111100)))
; expect = 1053802496.0

(assert (= expect result))

(check-sat)
(exit)
