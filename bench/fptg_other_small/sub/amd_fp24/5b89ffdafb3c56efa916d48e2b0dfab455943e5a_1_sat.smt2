                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b0100001 #b1110000000101001)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                expect
                (fp #b1 #b1111110 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111110)
                expect
                (fp #b1 #b0001110 #b0010100100101000)))
; expect = -18446462598732840960.0

(assert (= expect result))

(check-sat)
(exit)
