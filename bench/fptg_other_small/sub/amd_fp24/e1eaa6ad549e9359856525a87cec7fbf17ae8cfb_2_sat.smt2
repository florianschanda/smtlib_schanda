(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b0101011011101010)
                arg1
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                arg1
                (fp #b0 #b1110011 #b0111010010101010)))
; arg1 = 4983772676096.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b0110010011101001)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b0 #b1101000 #b0100100111011110)))
; arg2 = -35935.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1011100 #b1000001010101110)
                expect
                (fp #b0 #b1101001 #b0010001000011001)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011001)
                expect
                (fp #b0 #b1101101 #b1101111011100101)))
; expect = 4983839784960.0

(assert (= expect result))

(check-sat)
(exit)
