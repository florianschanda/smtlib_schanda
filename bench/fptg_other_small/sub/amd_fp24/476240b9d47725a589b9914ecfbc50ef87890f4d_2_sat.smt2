                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1011011 #b0100110000100110)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0111011010011100)
                expect
                (fp #b1 #b1001101 #b0110101110110010)))
(assert (fp.leq (fp #b1 #b1001101 #b0110101110110010)
                expect
                (fp #b0 #b0001110 #b1001111001001000)))
; expect = -23276.5

(assert (= expect result))

(check-sat)
