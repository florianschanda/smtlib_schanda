                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b1 #b0111010 #b1000110000001100)))
; arg2 = -717963500751683584.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010110 #b0111111011111110)
                expect
                (fp #b0 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b0 #b1111010 #b0011111011010111)
                expect
                (fp #b0 #b1111101 #b0101101110001010)))
; expect = 717963500751683584.0

(assert (= expect result))

(check-sat)
(exit)
