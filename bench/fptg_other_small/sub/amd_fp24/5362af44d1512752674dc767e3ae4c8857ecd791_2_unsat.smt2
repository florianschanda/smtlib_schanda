;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1010011010100110)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
