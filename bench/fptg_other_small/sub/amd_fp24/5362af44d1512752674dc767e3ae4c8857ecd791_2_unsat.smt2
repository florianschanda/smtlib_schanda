                arg2
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b0111101 #b0001101000011101)))
; arg2 = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0010110110000100)
                expect
                (fp #b1 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1011111 #b0000000000000000)
                expect
                (fp #b0 #b0011111 #b1101111011000000)))
; expect = -4294967296.0

(assert (not (= expect result)))

(check-sat)
(exit)
