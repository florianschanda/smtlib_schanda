; Format: AMD_FP24
; Arg1: +ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b0000110010110100)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1110001 #b0111100101100001)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000011 #b0010101000111011)
                arg2
                (fp #b1 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b1001111 #b1000111110010110)))
; arg2 = -0.000000000000000000204833080725281137073057191599900761502794921398162841796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1001100100111000)
                expect
                (fp #b0 #b0111111 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000001)
                expect
                (fp #b0 #b1110010 #b0110000110010001)))
; expect = 1.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
