                arg2
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b1010010 #b1101000110100101)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011011 #b1001011011011000)
                expect
                (fp #b1 #b1000000 #b0111100100011001)))
(assert (fp.leq (fp #b1 #b1000000 #b0111100100011001)
                expect
                (fp #b0 #b1001101 #b0111011001000001)))
; expect = -2.946075439453125

(assert (= expect result))

(check-sat)
(exit)
