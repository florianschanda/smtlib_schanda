                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1100100 #b0001100000011000)))
; arg2 = 127729.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1100001000101111)
                expect
                (fp #b1 #b1001111 #b1111001011110011)))
(assert (fp.leq (fp #b1 #b1001111 #b1111001011110011)
                expect
                (fp #b1 #b0111100 #b1110111011111100)))
; expect = -127731.0

(assert (= expect result))

(check-sat)
(exit)
