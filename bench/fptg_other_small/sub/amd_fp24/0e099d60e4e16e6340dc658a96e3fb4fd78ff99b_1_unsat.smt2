; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b1010101011011000)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b0001010 #b0101001011000010)))
; arg1 = -4294934528.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b1010101111001101)
                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b0 #b1011111 #b0111110101100100)))
; arg2 = -717963500751683584.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000101 #b1100010000010101)
                expect
                (fp #b0 #b1111010 #b0011111011010110)))
(assert (fp.leq (fp #b0 #b1111010 #b0011111011010110)
                expect
                (fp #b0 #b1111100 #b0100111100001100)))
; expect = 717954704658661376.0

(assert (not (= expect result)))

(check-sat)
(exit)
