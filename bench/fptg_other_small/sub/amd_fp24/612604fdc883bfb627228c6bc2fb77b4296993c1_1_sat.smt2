(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b1100001111000011)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b1 #b0111110 #b1001011001001100)))
; arg1 = -131072.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001111 #b0100111000100110)
                arg2
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1110110 #b0100111110011101)))
; arg2 = 4294934528.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b0010000101100010)
                expect
                (fp #b1 #b1011111 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1011111 #b0000000000000001)
                expect
                (fp #b0 #b1010111 #b1100000110100110)))
; expect = -4295032832.0

(assert (= expect result))

(check-sat)
(exit)
