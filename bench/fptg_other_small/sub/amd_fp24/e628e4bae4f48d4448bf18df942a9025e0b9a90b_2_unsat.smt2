(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b1101110001011010)
                expect
                (fp #b1 #b1010000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000001)
                expect
                (fp #b0 #b0011001 #b0110010101101010)))
; expect = -131074.0

(assert (not (= expect result)))

