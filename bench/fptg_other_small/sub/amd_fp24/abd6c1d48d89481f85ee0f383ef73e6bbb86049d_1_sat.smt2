(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000010 #b0111011011001000)
                arg1
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b1101100 #b0001010100011001)))
; arg1 = -0.00000000000000000021684043449710088680149056017398834228515625

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001001 #b1010110100010110)
                arg2
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b0001110 #b1010011101011000)))
; arg2 = -0.00000000000000000021684043449710088680149056017398834228515625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111011 #b1100010101001110)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0110010 #b1110101100111110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
