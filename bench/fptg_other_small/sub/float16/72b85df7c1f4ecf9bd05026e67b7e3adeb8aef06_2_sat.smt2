(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0101000100)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b11000 #b0011001111)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01101 #b1111010110)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b11100 #b0011100101)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0110110110)
                expect
                (fp #b1 #b00101 #b0011111000)))
(assert (fp.leq (fp #b1 #b00101 #b0011111000)
                expect
                (fp #b1 #b00011 #b1000010010)))
; expect = -0.00121307373046875

(assert (= expect result))

(check-sat)
(exit)
