(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1111101111)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10001 #b1011011110)))
; arg1 = 0.10479736328125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0010010100)
                arg2
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                arg2
                (fp #b1 #b01001 #b0100010111)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0011100100)
                expect
                (fp #b0 #b10011 #b1110101001)))
(assert (fp.leq (fp #b0 #b10011 #b1110101001)
                expect
                (fp #b0 #b11001 #b1101101111)))
; expect = 30.640625

(assert (= expect result))

(check-sat)
(exit)
