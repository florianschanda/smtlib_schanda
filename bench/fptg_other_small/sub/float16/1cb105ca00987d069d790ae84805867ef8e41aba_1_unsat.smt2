(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b1000110000)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b01001 #b1011000100)))
; arg1 = -0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0110001011)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b0 #b11011 #b0110001110)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0001011011)
                expect
                (fp #b0 #b01111 #b0011111101)))
(assert (fp.leq (fp #b0 #b01111 #b0011111101)
                expect
                (fp #b0 #b10100 #b1100100010)))
; expect = 1.2470703125

(assert (not (= expect result)))

(check-sat)
(exit)
