(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00000 #b0110101000)
                arg1
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg1
                (fp #b0 #b00000 #b1110010011)))
; arg1 = 0.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0111000110)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b11000 #b0010010100)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1000111000)
                expect
                (fp #b1 #b01111 #b0100011010)))
(assert (fp.leq (fp #b1 #b01111 #b0100011010)
                expect
                (fp #b0 #b10010 #b0100110100)))
; expect = -1.275390625

(assert (= expect result))

(check-sat)
(exit)
