; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010000110)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b00101 #b0110101010)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1001010001)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b0111101100)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1011000000)
                expect
                (fp #b1 #b11110 #b0110110001)))
(assert (fp.leq (fp #b1 #b11110 #b0110110001)
                expect
                (fp #b1 #b11100 #b0001010000)))
; expect = -46624.0

(assert (not (= expect result)))

(check-sat)
(exit)
