(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1001010000)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b01110 #b0000011000)))
; arg1 = -0.000039398670196533203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1001110101)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b11100 #b1100011100)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b0111011000)
                expect
                (fp #b1 #b01111 #b0100011011)))
(assert (fp.leq (fp #b1 #b01111 #b0100011011)
                expect
                (fp #b0 #b01010 #b1000100110)))
; expect = -1.2763671875

(assert (= expect result))

(check-sat)
(exit)
