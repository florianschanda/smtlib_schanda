(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0001111000)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b0 #b00111 #b0011101010)))
; arg1 = -2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00100 #b1101100110)
                arg2
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg2
                (fp #b0 #b11001 #b0010011101)))
; arg2 = -0.000244140625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1000001111)
                expect
                (fp #b1 #b11001 #b1111111111)))
(assert (fp.leq (fp #b1 #b11001 #b1111111111)
                expect
                (fp #b0 #b11001 #b1101011101)))
; expect = -2047.0

(assert (not (= expect result)))

(check-sat)
(exit)
