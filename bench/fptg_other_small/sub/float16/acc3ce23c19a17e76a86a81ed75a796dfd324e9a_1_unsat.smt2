(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b1000010110)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b00110 #b1111000100)))
; arg1 = -0.000055372714996337890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10100 #b1001110010)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11100 #b0111001011)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010100110)
                expect
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                expect
                (fp #b1 #b10101 #b0001111110)))
; expect = -2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
