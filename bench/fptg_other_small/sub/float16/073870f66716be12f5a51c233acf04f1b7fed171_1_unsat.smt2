(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1000010010)
                arg1
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0100111011)))
; arg1 = 0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1010110111)
                arg2
                (fp #b1 #b00000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000 #b0101011111)
                arg2
                (fp #b0 #b00110 #b0111100011)))
; arg2 = -0.000020921230316162109375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0111011011)
                expect
                (fp #b0 #b00011 #b0001010111)))
(assert (fp.leq (fp #b0 #b00011 #b0001010111)
                expect
                (fp #b0 #b00111 #b1111100101)))
; expect = 0.0002648830413818359375

(assert (not (= expect result)))

(check-sat)
(exit)
