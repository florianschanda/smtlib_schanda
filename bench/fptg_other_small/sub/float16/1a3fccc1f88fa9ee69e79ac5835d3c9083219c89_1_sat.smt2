(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10010 #b0101000111)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11110 #b1100111110)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01011 #b0101010101)
                arg2
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg2
                (fp #b0 #b11011 #b0000101001)))
; arg2 = 1.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01010 #b1101101101)
                expect
                (fp #b0 #b11100 #b1111111111)))
(assert (fp.leq (fp #b0 #b11100 #b1111111111)
                expect
                (fp #b0 #b11110 #b0011001011)))
; expect = 16376.0

(assert (= expect result))

(check-sat)
(exit)
