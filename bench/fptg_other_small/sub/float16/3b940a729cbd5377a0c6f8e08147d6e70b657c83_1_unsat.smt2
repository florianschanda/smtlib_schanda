(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1101100000)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b10100 #b0010000100)))
; arg1 = 14.8359375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000101110)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b1 #b00110 #b0110101100)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1010100001)
                expect
                (fp #b0 #b10011 #b0000000101)))
(assert (fp.leq (fp #b0 #b10011 #b0000000101)
                expect
                (fp #b0 #b10101 #b1011101010)))
; expect = 16.078125

(assert (not (= expect result)))

(check-sat)
(exit)
