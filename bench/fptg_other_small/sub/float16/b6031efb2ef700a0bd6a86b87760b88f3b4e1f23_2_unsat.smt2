                arg2
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg2
                (fp #b0 #b11101 #b0111110010)))
; arg2 = 0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101111)
                expect
                (fp #b1 #b11101 #b1000101110)))
(assert (fp.leq (fp #b1 #b11101 #b1000101110)
                expect
                (fp #b0 #b00000 #b1001110000)))
; expect = -25312.0

(assert (not (= expect result)))

(check-sat)
(exit)
