; Format: FLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1110101101)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b00110 #b1110110100)))
; arg1 = 0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0011000101)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b01000 #b0011111000)))
; arg2 = -0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1001010100)
                expect
                (fp #b0 #b00001 #b1111111110)))
(assert (fp.leq (fp #b0 #b00001 #b1111111110)
                expect
                (fp #b0 #b01100 #b0000000001)))
; expect = 0.00012195110321044921875

(assert (= expect result))

(check-sat)
(exit)
