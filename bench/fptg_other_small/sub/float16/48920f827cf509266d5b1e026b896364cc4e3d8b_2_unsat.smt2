(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0001011110)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b1 #b01011 #b1101000101)))
; arg1 = -1.203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0001110111)
                arg2
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                arg2
                (fp #b0 #b11100 #b0110110011)))
; arg2 = 439.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0111010110)
                expect
                (fp #b1 #b10111 #b1011100001)))
(assert (fp.leq (fp #b1 #b10111 #b1011100001)
                expect
                (fp #b1 #b00010 #b1100011000)))
; expect = -440.25

(assert (not (= expect result)))

(check-sat)
(exit)
