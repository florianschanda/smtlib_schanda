(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg2
                (fp #b0 #b10010 #b1100011110)))
; arg2 = 0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100001110)
                expect
                (fp #b1 #b00110 #b0100100011)))
(assert (fp.leq (fp #b1 #b00110 #b0100100011)
                expect
                (fp #b0 #b00001 #b0001110111)))
; expect = -0.0025081634521484375

(assert (not (= expect result)))

