(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0010000101)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b1 #b01010 #b0111010110)))
; arg1 = -933.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0001101010)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11001 #b0111010000)))
; arg2 = 1336.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100110101)
                expect
                (fp #b1 #b11010 #b0001101111)))
(assert (fp.leq (fp #b1 #b11010 #b0001101111)
                expect
                (fp #b1 #b10011 #b1111011010)))
; expect = -2270.0

(assert (not (= expect result)))

(check-sat)
(exit)
