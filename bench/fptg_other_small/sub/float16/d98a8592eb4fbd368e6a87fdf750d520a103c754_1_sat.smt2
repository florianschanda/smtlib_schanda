(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01101 #b1100101001)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b00001 #b0110100100)))
; arg1 = 0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1001110111)
                arg2
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg2
                (fp #b0 #b10100 #b0001010110)))
; arg2 = -0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111010010)
                expect
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                expect
                (fp #b0 #b01101 #b1110110111)))
; expect = 0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
