(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1010111100)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b00010 #b0000111111)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110001101)
                arg2
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg2
                (fp #b0 #b11011 #b0000011000)))
; arg2 = 1.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0101010101)
                expect
                (fp #b1 #b10111 #b0000000100)))
(assert (fp.leq (fp #b1 #b10111 #b0000000100)
                expect
                (fp #b1 #b00010 #b0000000111)))
; expect = -257.0

(assert (not (= expect result)))

(check-sat)
(exit)
