(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1001101001)
                arg1
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg1
                (fp #b0 #b01010 #b0011001000)))
; arg1 = -0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0001001001)
                arg2
                (fp #b0 #b01011 #b0000100001)))
(assert (fp.leq (fp #b0 #b01011 #b0000100001)
                arg2
                (fp #b0 #b11101 #b1100000111)))
; arg2 = 0.06451416015625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0110100100)
                expect
                (fp #b1 #b01011 #b0000100010)))
(assert (fp.leq (fp #b1 #b01011 #b0000100010)
                expect
                (fp #b0 #b00110 #b1111011101)))
; expect = -0.0645751953125

(assert (not (= expect result)))

(check-sat)
(exit)
