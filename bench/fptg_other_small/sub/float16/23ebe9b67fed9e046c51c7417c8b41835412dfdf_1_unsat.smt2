; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1101001101)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b10010 #b1110000100)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0010101110)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b10010 #b1011100000)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0010001101)
                expect
                (fp #b1 #b00000 #b1110110011)))
(assert (fp.leq (fp #b1 #b00000 #b1110110011)
                expect
                (fp #b0 #b00100 #b1100110111)))
; expect = -0.000056445598602294921875

(assert (not (= expect result)))

(check-sat)
(exit)
