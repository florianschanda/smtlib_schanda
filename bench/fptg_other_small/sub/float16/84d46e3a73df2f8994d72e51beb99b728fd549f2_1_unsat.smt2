(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b1100010001)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0000110000)
                arg2
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg2
                (fp #b0 #b10111 #b0100001111)))
; arg2 = 0.00006103515625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b11001 #b0110100100)
                expect
                (fp #b0 #b11110 #b1111111110)))
(assert (fp.leq (fp #b0 #b11110 #b1111111110)
                expect
                (fp #b0 #b11111 #b0000000000)))
; expect = 65472.0

(assert (not (= expect result)))

(check-sat)
(exit)
