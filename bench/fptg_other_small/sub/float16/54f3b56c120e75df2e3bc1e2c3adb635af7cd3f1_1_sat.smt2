(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00100 #b1111111011)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11011 #b0010011000)))
; arg1 = 2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0100001001)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b11100 #b0101000011)))
; arg2 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00100 #b0010011001)
                expect
                (fp #b0 #b11001 #b1111111111)))
(assert (fp.leq (fp #b0 #b11001 #b1111111111)
                expect
                (fp #b0 #b11101 #b1101001111)))
; expect = 2047.0

(assert (= expect result))

(check-sat)
(exit)
