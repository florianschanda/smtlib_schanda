(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00101 #b0110101001)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11011 #b1110010110)))
; arg1 = 14.8359375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1010010101)
                arg2
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg2
                (fp #b0 #b10001 #b0001011111)))
; arg2 = 0.00006103515625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1000101110)
                expect
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                expect
                (fp #b0 #b11001 #b1011100001)))
; expect = 14.8359375

(assert (= expect result))

(check-sat)
(exit)
