(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0110001100)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b10001 #b1110100000)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100110001)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b01100 #b1101101101)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0010100011)
                expect
                (fp #b1 #b10111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111 #b0000000000)
                expect
                (fp #b0 #b11011 #b0010000110)))
; expect = -256.0

(assert (not (= expect result)))

(check-sat)
(exit)
