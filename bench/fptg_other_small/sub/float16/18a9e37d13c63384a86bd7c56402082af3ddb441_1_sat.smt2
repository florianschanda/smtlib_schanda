(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b0101001100)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b01000 #b1001101000)))
; arg1 = -0.000039398670196533203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1010000010)
                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b10100 #b0000011001)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0110100100)
                expect
                (fp #b1 #b00001 #b1000111100)))
(assert (fp.leq (fp #b1 #b00001 #b1000111100)
                expect
                (fp #b0 #b01101 #b0001011001)))
; expect = -0.0000951290130615234375

(assert (= expect result))

(check-sat)
(exit)
