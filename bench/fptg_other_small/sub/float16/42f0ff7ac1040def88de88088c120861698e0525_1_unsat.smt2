(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1110110000)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10101 #b1100111101)))
; arg1 = -0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1011111000)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b10001 #b1010010000)))
; arg2 = 0.000244140625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1001010100)
                expect
                (fp #b1 #b00011 #b0100000000)))
(assert (fp.leq (fp #b1 #b00011 #b0100000000)
                expect
                (fp #b0 #b11000 #b0100000101)))
; expect = -0.00030517578125

(assert (not (= expect result)))

(check-sat)
(exit)
