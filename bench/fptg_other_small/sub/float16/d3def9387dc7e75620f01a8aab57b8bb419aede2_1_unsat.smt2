(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0110001101)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b1101111110)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01000 #b0111110110)
                arg2
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg2
                (fp #b0 #b01111 #b0000101100)))
; arg2 = 0.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01111 #b1010010110)
                expect
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                expect
                (fp #b0 #b11110 #b1101001100)))
; expect = 16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
