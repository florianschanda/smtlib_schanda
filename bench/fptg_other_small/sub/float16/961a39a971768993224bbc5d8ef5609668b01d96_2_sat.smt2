(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111111111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b0 #b00001 #b0111001111)))
; arg1 = -2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100001011)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b00001 #b0010111001)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1001101011)
                expect
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                expect
                (fp #b0 #b00111 #b1010001000)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
