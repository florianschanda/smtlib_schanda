; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b1110110000)
                arg1
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg1
                (fp #b1 #b01011 #b1110000001)))
; arg1 = -1.98828125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0100101001)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b00111 #b0000110101)))
; arg2 = 0.000060975551605224609375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1110110011)
                expect
                (fp #b1 #b01111 #b1111110101)))
(assert (fp.leq (fp #b1 #b01111 #b1111110101)
                expect
                (fp #b0 #b11001 #b1011110000)))
; expect = -1.9892578125

(assert (not (= expect result)))

(check-sat)
(exit)
