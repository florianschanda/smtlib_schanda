(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01011 #b0010101111)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0111110010)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10111 #b0000001000)
                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b11110 #b0000110100)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1000110000)
                expect
                (fp #b0 #b11100 #b1111111111)))
(assert (fp.leq (fp #b0 #b11100 #b1111111111)
                expect
                (fp #b0 #b11110 #b1011101000)))
; expect = 16376.0

(assert (= expect result))

(check-sat)
(exit)
