(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b0 #b10001 #b1110010011)))
; arg1 = -65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1100011001)
                arg2
                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b1 #b10101 #b0011010001)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100110110)
                expect
                (fp #b1 #b11110 #b1010001010)))
(assert (fp.leq (fp #b1 #b11110 #b1010001010)
                expect
                (fp #b0 #b00010 #b0101111101)))
; expect = -53568.0

(assert (not (= expect result)))

(check-sat)
(exit)
