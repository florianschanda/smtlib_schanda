(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101101000)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b0 #b10100 #b0111010000)))
; arg1 = -25296.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010111011)
                arg2
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                arg2
                (fp #b1 #b00110 #b0110001001)))
; arg2 = -32416.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00100 #b0101001101)
                expect
                (fp #b0 #b11011 #b1011110100)))
(assert (fp.leq (fp #b0 #b11011 #b1011110100)
                expect
                (fp #b0 #b11100 #b0001010010)))
; expect = 7120.0

(assert (not (= expect result)))

(check-sat)
(exit)
