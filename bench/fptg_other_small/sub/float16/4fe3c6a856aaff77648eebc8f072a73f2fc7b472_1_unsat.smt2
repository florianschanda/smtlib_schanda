                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg2
                (fp #b0 #b01110 #b1001001011)))
; arg2 = 0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0001011110)
                expect
                (fp #b1 #b00001 #b0010100001)))
(assert (fp.leq (fp #b1 #b00001 #b0010100001)
                expect
                (fp #b1 #b00000 #b1000110110)))
; expect = -0.000070631504058837890625

(assert (not (= expect result)))

(check-sat)
(exit)
