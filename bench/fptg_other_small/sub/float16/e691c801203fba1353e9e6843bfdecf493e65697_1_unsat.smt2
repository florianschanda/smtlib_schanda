(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b1 #b00011 #b1101010111)))
; arg1 = -65504.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1000001001)
                arg2
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                arg2
                (fp #b1 #b10111 #b1111011100)))
; arg2 = -32416.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100100010)
                expect
                (fp #b1 #b11110 #b0000001010)))
(assert (fp.leq (fp #b1 #b11110 #b0000001010)
                expect
                (fp #b0 #b00011 #b0101100100)))
; expect = -33088.0

(assert (not (= expect result)))

(check-sat)
(exit)
