(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01001 #b0101110111)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11011 #b0001001011)))
; arg1 = 2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0011101101)
                arg2
                (fp #b1 #b01100 #b1101010000)))
(assert (fp.leq (fp #b1 #b01100 #b1101010000)
                arg2
                (fp #b0 #b10110 #b1101010110)))
; arg2 = -0.228515625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0011001011)
                expect
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                expect
                (fp #b0 #b11101 #b0101110000)))
; expect = 2050.0

(assert (= expect result))

(check-sat)
(exit)
