(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00111 #b1010000100)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b10110 #b1001100000)))
; arg1 = 1.3701171875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0011011101)
                arg2
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg2
                (fp #b0 #b01000 #b1000001101)))
; arg2 = -0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1010011011)
                expect
                (fp #b0 #b01111 #b0101111100)))
(assert (fp.leq (fp #b0 #b01111 #b0101111100)
                expect
                (fp #b0 #b11001 #b0010101000)))
; expect = 1.37109375

(assert (not (= expect result)))

(check-sat)
(exit)
