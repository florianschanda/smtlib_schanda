(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b0001101110)
                arg1
                (fp #b0 #b11010 #b0010000000)))
(assert (fp.leq (fp #b0 #b11010 #b0010000000)
                arg1
                (fp #b0 #b11100 #b0010100110)))
; arg1 = 2304.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00101 #b1010011101)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11011 #b1000000000)))
; arg2 = 1336.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00010 #b1101100110)
                expect
                (fp #b0 #b11000 #b1110010000)))
(assert (fp.leq (fp #b0 #b11000 #b1110010000)
                expect
                (fp #b0 #b11010 #b1010000110)))
; expect = 968.0

(assert (not (= expect result)))

(check-sat)
(exit)
