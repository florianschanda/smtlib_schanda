(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01110 #b0011111010)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11011 #b0000111000)))
; arg1 = 551.5

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00100 #b0010011110)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11101 #b1101101111)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100100001)
                expect
                (fp #b1 #b11001 #b0111011001)))
(assert (fp.leq (fp #b1 #b11001 #b0111011001)
                expect
                (fp #b0 #b11110 #b1100000011)))
; expect = -1497.0

(assert (= expect result))

(check-sat)
(exit)
