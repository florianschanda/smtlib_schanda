(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101011111)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b0 #b11011 #b1001010000)))
; arg1 = -3788.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0100110001)
                arg2
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg2
                (fp #b1 #b10011 #b1100100100)))
; arg2 = -16384.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01011 #b1001110001)
                expect
                (fp #b0 #b11100 #b1000100111)))
(assert (fp.leq (fp #b0 #b11100 #b1000100111)
                expect
                (fp #b0 #b11110 #b1111011010)))
; expect = 12600.0

(assert (not (= expect result)))

(check-sat)
(exit)
