; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0111111001)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b10100 #b1011000111)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0110001100)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b01100 #b1101010011)))
; arg2 = 0.00007975101470947265625

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b0111100110)
                expect
                (fp #b1 #b00010 #b0010011100)))
(assert (fp.leq (fp #b1 #b00010 #b0010011100)
                expect
                (fp #b0 #b00111 #b1100100010)))
; expect = -0.000140666961669921875

(assert (= expect result))

(check-sat)
(exit)
