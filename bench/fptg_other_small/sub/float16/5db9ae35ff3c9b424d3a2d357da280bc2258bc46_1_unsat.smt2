(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10010 #b1011110001)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11110 #b1001000110)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b10001 #b0010000111)
                arg2
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg2
                (fp #b0 #b11010 #b1011001101)))
; arg2 = 2048.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10010 #b1111001000)
                expect
                (fp #b0 #b11100 #b1100000000)))
(assert (fp.leq (fp #b0 #b11100 #b1100000000)
                expect
                (fp #b0 #b11101 #b0101010000)))
; expect = 14336.0

(assert (not (= expect result)))

(check-sat)
(exit)
