(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0101101011)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00110 #b0111011000)))
; arg1 = 0.0000152587890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000000100)
                arg2
                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b0 #b10001 #b0100101110)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1000111110)
                expect
                (fp #b0 #b11100 #b0111010101)))
(assert (fp.leq (fp #b0 #b11100 #b0111010101)
                expect
                (fp #b0 #b11100 #b1100101111)))
; expect = 11944.0

(assert (not (= expect result)))

(check-sat)
(exit)
