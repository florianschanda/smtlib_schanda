(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0110001010)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11010 #b1110100110)))
; arg1 = 551.5

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1001001101)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b1 #b00111 #b1101100011)))
; arg2 = -1.248046875

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0000110010)
                expect
                (fp #b0 #b11000 #b0001010010)))
(assert (fp.leq (fp #b0 #b11000 #b0001010010)
                expect
                (fp #b0 #b11010 #b0100000001)))
; expect = 553.0

(assert (= expect result))

(check-sat)
(exit)
