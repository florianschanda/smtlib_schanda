(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1111100111)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b01110 #b1100001100)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100011101)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b11001 #b0001011100)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0011000110)
                expect
                (fp #b1 #b10010 #b1000110000)))
(assert (fp.leq (fp #b1 #b10010 #b1000110000)
                expect
                (fp #b0 #b10101 #b1001110000)))
; expect = -12.375

(assert (= expect result))

(check-sat)
(exit)
