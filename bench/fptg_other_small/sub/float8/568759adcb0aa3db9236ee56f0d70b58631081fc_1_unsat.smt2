                arg2
                (fp #b0 #b010 #b1001)))
(assert (fp.leq (fp #b0 #b010 #b1001)
                arg2
                (fp #b0 #b101 #b0110)))
; arg2 = 0.78125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1010)
                expect
                (fp #b0 #b010 #b0011)))
(assert (fp.leq (fp #b0 #b010 #b0011)
                expect
                (fp #b0 #b101 #b0000)))
; expect = 0.59375

(assert (not (= expect result)))

(check-sat)
(exit)
