(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b110 #b0001)))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b001 #b0111)))
; arg1 = -8.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg2
                (fp #b1 #b011 #b0010)))
(assert (fp.leq (fp #b1 #b011 #b0010)
                arg2
                (fp #b0 #b011 #b0101)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0010)
                expect
                (fp #b1 #b101 #b1101)))
(assert (fp.leq (fp #b1 #b101 #b1101)
                expect
                (fp #b0 #b011 #b0000)))
; expect = -7.25

(assert (not (= expect result)))

(check-sat)
(exit)
