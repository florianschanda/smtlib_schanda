(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                arg1
                (fp #b0 #b110 #b0000)))
; arg1 = -0.015625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0100)
                arg2
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg2
                (fp #b0 #b100 #b0100)))
; arg2 = 1.375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                expect
                (fp #b1 #b011 #b0110)))
(assert (fp.leq (fp #b1 #b011 #b0110)
                expect
                (fp #b1 #b000 #b0110)))
; expect = -1.375

(assert (= expect result))

(check-sat)
(exit)
