(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0111)
                arg1
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg1
                (fp #b0 #b101 #b0110)))
; arg1 = 1.375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg2
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg2
                (fp #b0 #b111 #b0000)))
; arg2 = 15.5

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b1 #b110 #b1100)))
(assert (fp.leq (fp #b1 #b110 #b1100)
                expect
                (fp #b0 #b101 #b1100)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
(exit)
