(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b000 #b0100)))
(assert (fp.leq (fp #b0 #b000 #b0100)
                arg1
                (fp #b0 #b011 #b1110)))
; arg1 = 0.0625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1001)
                arg2
                (fp #b0 #b000 #b1110)))
(assert (fp.leq (fp #b0 #b000 #b1110)
                arg2
                (fp #b0 #b010 #b0110)))
; arg2 = 0.21875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                expect
                (fp #b1 #b000 #b1010)))
(assert (fp.leq (fp #b1 #b000 #b1010)
                expect
                (fp #b0 #b011 #b0011)))
; expect = -0.15625

(assert (= expect result))

(check-sat)
(exit)
