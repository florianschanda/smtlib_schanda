(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b0 #b011 #b1011)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1110)
                arg2
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg2
                (fp #b0 #b110 #b0100)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                expect
                (fp #b1 #b101 #b0111)))
(assert (fp.leq (fp #b1 #b101 #b0111)
                expect
                (fp #b0 #b011 #b0011)))
; expect = -5.75

(assert (= expect result))

(check-sat)
(exit)
