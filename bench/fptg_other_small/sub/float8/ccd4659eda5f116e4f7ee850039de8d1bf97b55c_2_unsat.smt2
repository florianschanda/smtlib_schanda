(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1011)
                arg1
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg1
                (fp #b1 #b010 #b1011)))
; arg1 = -9.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0101)
                arg2
                (fp #b0 #b101 #b0011)))
(assert (fp.leq (fp #b0 #b101 #b0011)
                arg2
                (fp #b0 #b110 #b1001)))
; arg2 = 4.75

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                expect
                (fp #b1 #b110 #b1100)))
(assert (fp.leq (fp #b1 #b110 #b1100)
                expect
                (fp #b1 #b011 #b1011)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
(exit)
