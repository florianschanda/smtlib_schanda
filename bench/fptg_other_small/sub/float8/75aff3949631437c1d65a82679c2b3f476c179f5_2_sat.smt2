(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0010)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b000 #b1101)))
; arg1 = 0.125

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg2
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                arg2
                (fp #b0 #b011 #b1001)))
; arg2 = -4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1001)
                expect
                (fp #b0 #b101 #b0001)))
(assert (fp.leq (fp #b0 #b101 #b0001)
                expect
                (fp #b0 #b110 #b0110)))
; expect = 4.25

(assert (= expect result))

(check-sat)
(exit)
