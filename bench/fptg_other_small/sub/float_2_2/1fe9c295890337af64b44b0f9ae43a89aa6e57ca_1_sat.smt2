(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b00 #b0)))
; arg1 = -0.5

(declare-const arg2 (_ FloatingPoint 2 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg2
                (fp #b0 #b00 #b0)))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg2
                (fp #b0 #b10 #b1)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
