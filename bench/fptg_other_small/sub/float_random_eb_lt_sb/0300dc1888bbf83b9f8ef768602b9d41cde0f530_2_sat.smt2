(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b0011 #b01111011)
                arg1
                (fp #b1 #b0000 #b10000000)))
(assert (fp.leq (fp #b1 #b0000 #b10000000)
                arg1
                (fp #b0 #b0110 #b01000111)))
; arg1 = -0.0078125

(declare-const arg2 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1110 #b11111111)
                arg2
                (fp #b1 #b1110 #b11111110)))
(assert (fp.leq (fp #b1 #b1110 #b11111110)
                arg2
                (fp #b0 #b0000 #b01001011)))
; arg2 = -255.0

(declare-const result (_ FloatingPoint 4 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b0010 #b00111100)
                expect
                (fp #b0 #b1110 #b11111110)))
(assert (fp.leq (fp #b0 #b1110 #b11111110)
                expect
                (fp #b0 #b1111 #b00000000)))
; expect = 255.0

(assert (= expect result))

(check-sat)
(exit)
