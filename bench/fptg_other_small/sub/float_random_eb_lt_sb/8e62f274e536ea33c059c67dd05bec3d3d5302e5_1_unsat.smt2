(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b11010 #b0010000)
                arg1
                (fp #b1 #b11000 #b1101101)))
(assert (fp.leq (fp #b1 #b11000 #b1101101)
                arg1
                (fp #b0 #b10011 #b1010010)))
; arg1 = -948.0

(declare-const arg2 (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b10100 #b0111101)
                arg2
                (fp #b1 #b01111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111 #b1011000)
                arg2
                (fp #b0 #b11011 #b1010100)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 5 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b11101 #b0000110)
                expect
                (fp #b1 #b11000 #b1101100)))
(assert (fp.leq (fp #b1 #b11000 #b1101100)
                expect
                (fp #b0 #b00010 #b0010111)))
; expect = -944.0

(assert (not (= expect result)))

(check-sat)
(exit)
