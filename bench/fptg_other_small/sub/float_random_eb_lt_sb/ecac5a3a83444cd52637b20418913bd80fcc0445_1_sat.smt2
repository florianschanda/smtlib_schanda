(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 12))
(assert (fp.leq (fp #b1 #b11111001 #b00010101111)
                arg1
                (fp #b1 #b01111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b01111111 #b01100111111)
                arg1
                (fp #b1 #b01100101 #b01101000111)))
; arg1 = -1.40576171875

(declare-const arg2 (_ FloatingPoint 8 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11100001 #b00011101001)
                expect
                (fp #b0 #b00000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000)
                expect
                (fp #b0 #b11111001 #b01100010110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
