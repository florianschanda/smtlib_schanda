(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 11))
(assert (fp.leq (fp #b1 #b0001 #b1101111111)
                arg1
                (fp #b0 #b0100 #b0000000000)))
(assert (fp.leq (fp #b0 #b0100 #b0000000000)
                arg1
                (fp #b0 #b1100 #b1111100001)))
; arg1 = 0.125

(declare-const arg2 (_ FloatingPoint 4 11))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0011 #b1000100111)
                arg2
                (fp #b1 #b0000 #b0000000000)))
(assert (fp.leq (fp #b1 #b0000 #b0000000000)
                arg2
                (fp #b0 #b0011 #b0110001000)))
; arg2 = -0

(declare-const result (_ FloatingPoint 4 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 11))
(assert (fp.leq (fp #b0 #b0000 #b0110101110)
                expect
                (fp #b0 #b0100 #b0000000000)))
(assert (fp.leq (fp #b0 #b0100 #b0000000000)
                expect
                (fp #b0 #b0110 #b1111000110)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
