(assert (fp.leq (fp #b1 #b0100 #b10101101111011100110)
                arg2
                (fp #b1 #b0000 #b00100110011100101011)))
; arg2 = -0.2099273204803466796875

(declare-const result (_ FloatingPoint 4 21))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b1011 #b11101011110110011001)
                expect
                (fp #b1 #b1000 #b11000110010001011001)))
(assert (fp.leq (fp #b1 #b1000 #b11000110010001011001)
                expect
                (fp #b0 #b0000 #b10010000110000000011)))
; expect = -3.5489978790283203125

(assert (= expect result))

