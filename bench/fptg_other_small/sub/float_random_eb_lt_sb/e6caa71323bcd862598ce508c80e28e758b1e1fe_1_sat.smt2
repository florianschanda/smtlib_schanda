(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 3 20))
(assert (fp.leq (fp #b1 #b001 #b0000010100001010000)
                arg1
                (fp #b0 #b110 #b1110100111100101010)))
(assert (fp.leq (fp #b0 #b110 #b1110100111100101010)
                arg1
                (fp #b0 #b110 #b1111100100100100010)))
; arg1 = 15.309234619140625

(declare-const arg2 (_ FloatingPoint 3 20))
(assert (fp.leq (fp #b1 #b001 #b1101100110011011110)
                arg2
                (fp #b1 #b000 #b0000000000000000001)))
(assert (fp.leq (fp #b1 #b000 #b0000000000000000001)
                arg2
                (fp #b0 #b010 #b0101001111000000001)))
; arg2 = -0.000000476837158203125

(declare-const result (_ FloatingPoint 3 20))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 20))
(assert (fp.leq (fp #b0 #b010 #b1101010111101101100)
                expect
                (fp #b0 #b110 #b1110100111100101010)))
(assert (fp.leq (fp #b0 #b110 #b1110100111100101010)
                expect
                (fp #b0 #b110 #b1111011001110100000)))
; expect = 15.309234619140625

(assert (= expect result))

(check-sat)
(exit)
