; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011001 #b0001100)
                arg1
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                arg1
                (fp #b0 #b10010100 #b1010111)))
; arg1 = 1.734375

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010011 #b1101001)
                arg2
                (fp #b0 #b10110000 #b1010100)))
(assert (fp.leq (fp #b0 #b10110000 #b1010100)
                arg2
                (fp #b0 #b11101110 #b1011011)))
; arg2 = 932385860354048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011111 #b1011100)
                expect
                (fp #b1 #b10110000 #b1010011)))
(assert (fp.leq (fp #b1 #b10110000 #b1010011)
                expect
                (fp #b1 #b00001011 #b0101110)))
; expect = -927987813842944.0

(assert (= expect result))

(check-sat)
(exit)
