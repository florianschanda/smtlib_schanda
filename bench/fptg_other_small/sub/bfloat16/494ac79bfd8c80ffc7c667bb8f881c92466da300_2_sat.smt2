(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111011 #b1010100)
                expect
                (fp #b0 #b11101011 #b1001110)))
(assert (fp.leq (fp #b0 #b11101011 #b1001110)
                expect
