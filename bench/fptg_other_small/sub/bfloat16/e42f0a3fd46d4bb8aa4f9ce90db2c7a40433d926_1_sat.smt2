(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100100 #b1000000)
                arg1
                (fp #b1 #b00000000 #b0111101)))
(assert (fp.leq (fp #b1 #b00000000 #b0111101)
                arg1
                (fp #b0 #b00101101 #b0101100)))
; arg1 = -0.0000000000000000000000000000000000000056019652656374639051635100601997645583545780439919795946901448502330822520889341831207275390625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110010 #b0111111)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b1 #b00011001 #b1111000)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000000 #b0101100)
                expect
                (fp #b0 #b10000101 #b1011111)))
(assert (fp.leq (fp #b0 #b10000101 #b1011111)
                expect
                (fp #b0 #b10001001 #b1010100)))
; expect = 111.5

(assert (= expect result))

(check-sat)
(exit)
