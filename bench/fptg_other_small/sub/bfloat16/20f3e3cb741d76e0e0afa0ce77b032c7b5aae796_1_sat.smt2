(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1000100)
                arg1
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                arg1
                (fp #b0 #b11110001 #b1101111)))
; arg1 = -8510837770086989389931479040.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000110 #b1101010)
                arg2
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg2
                (fp #b0 #b01010101 #b0011111)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b0000111)
                expect
                (fp #b1 #b11011011 #b1011011)))
(assert (fp.leq (fp #b1 #b11011011 #b1011011)
                expect
                (fp #b0 #b00011101 #b1100001)))
; expect = -8472152143859321256340881408.0

(assert (= expect result))

(check-sat)
(exit)
