;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b1111000)
                arg1
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg1
                (fp #b1 #b01001110 #b0101100)))
; arg1 = -18374686479671623680.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b1111110)
                arg2
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b1 #b11011011 #b1101001)))
; arg2 = -10627982632313475302148359673872384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111011 #b1010100)
                expect
                (fp #b0 #b11110000 #b0000010)))
(assert (fp.leq (fp #b0 #b11110000 #b0000010)
                expect
                (fp #b0 #b11111101 #b0011111)))
; expect = 10546852993898868620452570668728320.0

(assert (= expect result))

(check-sat)
(exit)
