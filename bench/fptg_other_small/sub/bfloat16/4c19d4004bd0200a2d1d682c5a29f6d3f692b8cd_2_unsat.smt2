(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101111 #b1101011)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11011100 #b1110010)))
; arg1 = 256.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001110 #b1110011)
                arg2
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg2
                (fp #b1 #b00100001 #b0100101)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000011 #b1111111)
                expect
                (fp #b0 #b10000111 #b0000001)))
(assert (fp.leq (fp #b0 #b10000111 #b0000001)
                expect
                (fp #b0 #b11110110 #b0000100)))
; expect = 258.0

(assert (not (= expect result)))

(check-sat)
(exit)
