(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100001 #b0110011)
                expect
                (fp #b1 #b10000110 #b0110010)))
(assert (fp.leq (fp #b1 #b10000110 #b0110010)
                expect
                (fp #b0 #b11011101 #b1110000)))
; expect = -178.0

(assert (= expect result))

(check-sat)
