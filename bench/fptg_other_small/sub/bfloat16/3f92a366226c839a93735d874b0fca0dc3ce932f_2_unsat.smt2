(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg2
                (fp #b0 #b10011010 #b0101101)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010111 #b0100101)
                expect
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                expect
                (fp #b0 #b10110110 #b1100100)))
; expect = 256.0

(assert (not (= expect result)))

(check-sat)
(exit)
