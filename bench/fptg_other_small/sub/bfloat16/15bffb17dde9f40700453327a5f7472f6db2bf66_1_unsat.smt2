                arg2
                (fp #b0 #b11001101 #b1110100)))
; arg2 = -0.0000000000000000000000000000200173454699831745623226123440507005779576132908914587460458278656005859375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101010 #b0110101)
                expect
                (fp #b0 #b00011111 #b1001011)))
(assert (fp.leq (fp #b0 #b00011111 #b1001011)
                expect
                (fp #b0 #b11101100 #b0000101)))
; expect = 0.0000000000000000000000000000200173454699831745623226123440507005779576132908914587460458278656005859375

(assert (not (= expect result)))

