                arg2
                (fp #b0 #b10010110 #b1001001)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b1101101)
                expect
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                expect
                (fp #b0 #b11010111 #b0000000)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
