(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110010 #b0000111)
                expect
                (fp #b1 #b01111111 #b0110000)))
(assert (fp.leq (fp #b1 #b01111111 #b0110000)
                expect
                (fp #b0 #b01111011 #b1101010)))
; expect = -1.375

(assert (not (= expect result)))

