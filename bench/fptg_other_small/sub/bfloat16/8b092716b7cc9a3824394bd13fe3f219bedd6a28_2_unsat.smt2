; Format: BFLOAT16
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00110001 #b0110111)
                arg1
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg1
