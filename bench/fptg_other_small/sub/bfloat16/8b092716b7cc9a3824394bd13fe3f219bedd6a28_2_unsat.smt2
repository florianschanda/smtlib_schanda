                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b0 #b00000010 #b1101001)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b0001101)
                expect
                (fp #b0 #b10011110 #b0001011)))
(assert (fp.leq (fp #b0 #b10011110 #b0001011)
                expect
                (fp #b0 #b11110100 #b0001101)))
; expect = 2332033024.0

(assert (not (= expect result)))

(check-sat)
(exit)
