; Format: BFLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001010 #b1101100)
                arg1
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg1
                (fp #b0 #b00000110 #b1100100)))
; arg1 = -0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                arg2
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                arg2
                (fp #b0 #b11100010 #b1001001)))
; arg2 = -338953138925153547590470800371487866880.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100100 #b0101011)
                expect
                (fp #b0 #b11111110 #b1111110)))
(assert (fp.leq (fp #b0 #b11111110 #b1111110)
                expect
                (fp #b0 #b11111111 #b0000000)))
; expect = 337623910929368631717566993311207522304.0

(assert (= expect result))

(check-sat)
(exit)
