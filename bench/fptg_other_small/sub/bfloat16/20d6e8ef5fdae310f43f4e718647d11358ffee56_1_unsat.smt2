(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b11010001 #b1000010)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100010 #b1101100)
                expect
                (fp #b1 #b10010001 #b1101000)))
(assert (fp.leq (fp #b1 #b10010001 #b1101000)
                expect
                (fp #b0 #b01111110 #b1010100)))
; expect = -475136.0

(assert (not (= expect result)))

