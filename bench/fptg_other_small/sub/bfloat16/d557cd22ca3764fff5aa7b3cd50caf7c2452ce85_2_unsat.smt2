                (fp #b0 #b01100001 #b0011000)))
; arg2 = -0.0000000000000031918911957973250537179410457611083984375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000111 #b1010100)
                expect
                (fp #b0 #b10000011 #b1110001)))
(assert (fp.leq (fp #b0 #b10000011 #b1110001)
                expect
                (fp #b0 #b11100110 #b1000101)))
; expect = 30.125

(assert (not (= expect result)))

