;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010011 #b0001000)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b11111100 #b1011101)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
