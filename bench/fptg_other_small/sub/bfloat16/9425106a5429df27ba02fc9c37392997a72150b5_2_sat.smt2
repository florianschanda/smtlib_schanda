                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b1 #b00011111 #b0111111)))
; arg2 = -522272047294030513416641720614912.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010011 #b0111000)
                expect
                (fp #b0 #b11101011 #b1001111)))
(assert (fp.leq (fp #b0 #b11101011 #b1001111)
                expect
                (fp #b0 #b11110100 #b1110110)))
; expect = 524807348494486972219635127025664.0

(assert (= expect result))

(check-sat)
(exit)
