                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                arg2
                (fp #b0 #b10010101 #b0010110)))
; arg2 = -0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b1111100)
                expect
                (fp #b1 #b11011011 #b1011011)))
(assert (fp.leq (fp #b1 #b11011011 #b1011011)
                expect
                (fp #b0 #b00110101 #b1110010)))
; expect = -8472152143859321256340881408.0

(assert (= expect result))

