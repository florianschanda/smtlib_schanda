(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b1 #b00000011 #b1101011)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b0001001)
                expect
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                expect
                (fp #b1 #b10100001 #b0010001)))
; expect = -8510837770086989389931479040.0

(assert (not (= expect result)))

