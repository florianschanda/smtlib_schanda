(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000110 #b0110000)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b0 #b00101111 #b0010111)))
; arg1 = -256.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b1011101)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b1 #b00000110 #b1001101)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11010000 #b0110101)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b01111101 #b0001001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
