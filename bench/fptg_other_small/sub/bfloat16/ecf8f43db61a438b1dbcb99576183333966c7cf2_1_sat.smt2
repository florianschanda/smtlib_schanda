                arg2
                (fp #b1 #b11010010 #b1100000)))
(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b0 #b11011110 #b0101010)))
; arg2 = -16924961474604808445886464.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010111 #b1111011)
                expect
                (fp #b0 #b11010010 #b1100000)))
(assert (fp.leq (fp #b0 #b11010010 #b1100000)
                expect
                (fp #b0 #b11101111 #b0110010)))
; expect = 16924961474604808445886464.0

(assert (= expect result))

(check-sat)
(exit)
