(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg2
                (fp #b0 #b10000011 #b0010001)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111011 #b1100111)
                expect
                (fp #b1 #b01101101 #b1000000)))
(assert (fp.leq (fp #b1 #b01101101 #b1000000)
                expect
                (fp #b0 #b00101000 #b1010110)))
; expect = -0.0000057220458984375

(assert (= expect result))

(check-sat)
