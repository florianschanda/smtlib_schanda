                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b0 #b10001100 #b0101010)))
; arg2 = -522272047294030513416641720614912.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100011 #b1100001)
                expect
                (fp #b0 #b11101011 #b1001101)))
(assert (fp.leq (fp #b0 #b11101011 #b1001101)
                expect
                (fp #b0 #b11111110 #b0111111)))
; expect = 519736746093574054613648314204160.0

(assert (= expect result))

(check-sat)
(exit)
