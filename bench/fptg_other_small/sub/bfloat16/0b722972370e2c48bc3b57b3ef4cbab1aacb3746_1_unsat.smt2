; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111011 #b1000001)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b11010001 #b0010111)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010001 #b1100011)
                arg2
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg2
                (fp #b0 #b11111100 #b1101110)))
; arg2 = 18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b0011100)
                expect
                (fp #b1 #b10111110 #b1111110)))
(assert (fp.leq (fp #b1 #b10111110 #b1111110)
                expect
                (fp #b0 #b11110100 #b1110111)))
; expect = -18302628885633695744.0

(assert (not (= expect result)))

(check-sat)
(exit)
