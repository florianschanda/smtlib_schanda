; Format: BFLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011011 #b1011010)
                arg1
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg1
                (fp #b0 #b00010001 #b1000100)))
; arg1 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010111 #b0000011)
                arg2
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg2
                (fp #b0 #b11110011 #b1111100)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b0001100)
                expect
                (fp #b0 #b01111110 #b1111111)))
(assert (fp.leq (fp #b0 #b01111110 #b1111111)
                expect
                (fp #b0 #b11100000 #b1010110)))
; expect = 0.99609375

(assert (= expect result))

(check-sat)
(exit)
