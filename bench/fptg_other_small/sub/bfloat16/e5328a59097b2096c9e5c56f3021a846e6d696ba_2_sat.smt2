                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11111001 #b0110100)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b0000111)
                expect
                (fp #b1 #b11101011 #b0100111)))
(assert (fp.leq (fp #b1 #b11101011 #b0100111)
                expect
                (fp #b1 #b11001101 #b0011111)))
; expect = -423395300476228620099898870595584.0

(assert (= expect result))

