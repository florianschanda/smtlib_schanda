                expect
                (fp #b0 #b01111110 #b1111111)))
(assert (fp.leq (fp #b0 #b01111110 #b1111111)
                expect
                (fp #b0 #b10000001 #b1010111)))
; expect = 0.99609375

(assert (not (= expect result)))

