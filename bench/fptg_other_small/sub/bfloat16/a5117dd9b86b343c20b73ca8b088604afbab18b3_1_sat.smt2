; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010001 #b1101011)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b11000101 #b1100000)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000000 #b0010111)
                arg2
                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                arg2
                (fp #b0 #b11110101 #b0111111)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b1100001)
                expect
                (fp #b1 #b11010100 #b1011011)))
(assert (fp.leq (fp #b1 #b11010100 #b1011011)
                expect
                (fp #b0 #b10101001 #b0100001)))
; expect = -66188688623900947315163136.0

(assert (= expect result))

(check-sat)
(exit)
