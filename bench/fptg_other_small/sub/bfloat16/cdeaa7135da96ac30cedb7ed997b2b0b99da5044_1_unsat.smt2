; Format: BFLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b1100000)
                arg1
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg1
                (fp #b0 #b00011100 #b1110111)))
; arg1 = 0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011100 #b1000000)
                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b10010000 #b1100000)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b1000001)
                expect
                (fp #b1 #b10000110 #b0000000)))
(assert (fp.leq (fp #b1 #b10000110 #b0000000)
                expect
                (fp #b1 #b01110100 #b1000101)))
; expect = -128.0

(assert (not (= expect result)))

(check-sat)
(exit)
