(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1000110)
                arg1
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg1
                (fp #b0 #b11101110 #b1101000)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1111110)
                arg2
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg2
                (fp #b0 #b01000111 #b0011000)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100010 #b0001010)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b10100010 #b0011111)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
