(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010011 #b1001100)
                expect
                (fp #b0 #b11111101 #b0000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000001)
                expect
                (fp #b0 #b11111101 #b1110011)))
; expect = 85735205728127073802295555388082225152.0

(assert (= expect result))

(check-sat)
