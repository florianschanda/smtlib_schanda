(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b11100011 #b1010110)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111100 #b0110101)
                expect
                (fp #b0 #b10000101 #b1011110)))
(assert (fp.leq (fp #b0 #b10000101 #b1011110)
                expect
                (fp #b0 #b11001110 #b1001100)))
; expect = 111.0

(assert (not (= expect result)))

(check-sat)
