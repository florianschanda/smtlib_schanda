                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b1 #b00111111 #b1010001)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100110 #b1111010)
                expect
                (fp #b0 #b10011110 #b0001001)))
(assert (fp.leq (fp #b0 #b10011110 #b0001001)
                expect
                (fp #b0 #b11110000 #b1011101)))
; expect = 2298478592.0

(assert (= expect result))

(check-sat)
(exit)
