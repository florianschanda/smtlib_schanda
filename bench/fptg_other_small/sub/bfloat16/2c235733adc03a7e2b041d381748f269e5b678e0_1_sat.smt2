;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100100 #b0101000)
                arg1
                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                arg1
