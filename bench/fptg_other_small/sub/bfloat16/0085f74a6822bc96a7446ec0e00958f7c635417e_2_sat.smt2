                arg2
                (fp #b0 #b10110000 #b1010100)))
(assert (fp.leq (fp #b0 #b10110000 #b1010100)
                arg2
                (fp #b0 #b11111001 #b1010010)))
; arg2 = 932385860354048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b1101010)
                expect
                (fp #b1 #b10110000 #b1010100)))
(assert (fp.leq (fp #b1 #b10110000 #b1010100)
                expect
                (fp #b0 #b01001100 #b0001100)))
; expect = -932385860354048.0

(assert (= expect result))

(check-sat)
