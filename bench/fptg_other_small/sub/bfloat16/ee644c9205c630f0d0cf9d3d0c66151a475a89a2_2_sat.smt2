(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111011 #b0101111)
                arg1
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg1
                (fp #b0 #b11010000 #b0011100)))
; arg1 = -18374686479671623680.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000010 #b0101100)
                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b0 #b00101101 #b1100011)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000000 #b1010100)
                expect
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                expect
                (fp #b1 #b10010001 #b0001111)))
; expect = -18374686479671623680.0

(assert (= expect result))

(check-sat)
(exit)
