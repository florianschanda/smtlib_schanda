; Format: BFLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001010 #b0001001)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11011101 #b1110000)))
; arg1 = 256.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000100 #b0000111)
                arg2
                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg2
                (fp #b0 #b11001111 #b1111011)))
; arg2 = 0.0000000000000000000000000000000000000116631080120648838681273078302519688346070723210980558774696458357311712461523711681365966796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000110 #b1111001)
                expect
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                expect
                (fp #b0 #b10100001 #b1100100)))
; expect = 256.0

(assert (not (= expect result)))

(check-sat)
(exit)
