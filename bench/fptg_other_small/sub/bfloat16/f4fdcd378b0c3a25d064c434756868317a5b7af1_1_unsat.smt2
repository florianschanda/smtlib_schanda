; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001110 #b1111101)
                arg1
                (fp #b1 #b00000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000 #b1111010)
                arg1
                (fp #b0 #b11011101 #b1101010)))
; arg1 = -0.000000000000000000000000000000000000011203930531274927810327020120399529116709156087983959189380289700466164504177868366241455078125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b0101011)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b11101000 #b1111001)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b1101001)
                expect
                (fp #b0 #b01111111 #b1010111)))
(assert (fp.leq (fp #b0 #b01111111 #b1010111)
                expect
                (fp #b0 #b11110011 #b0000010)))
; expect = 1.6796875

(assert (not (= expect result)))

(check-sat)
(exit)
