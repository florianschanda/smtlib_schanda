; Format: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011000 #b0110111)
                arg1
                (fp #b0 #b00000000 #b1100101)))
(assert (fp.leq (fp #b0 #b00000000 #b1100101)
                arg1
                (fp #b0 #b00111111 #b0011011)))
; arg1 = 0.0000000000000000000000000000000000000092753851119571123675658117390192823015379079089047530994049939323531361878849565982818603515625

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b1000011)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b1 #b00000110 #b1000101)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00011000 #b0110111)
                expect
                (fp #b0 #b10000111 #b0000001)))
(assert (fp.leq (fp #b0 #b10000111 #b0000001)
                expect
                (fp #b0 #b10110100 #b0100111)))
; expect = 258.0

(assert (not (= expect result)))

(check-sat)
(exit)
