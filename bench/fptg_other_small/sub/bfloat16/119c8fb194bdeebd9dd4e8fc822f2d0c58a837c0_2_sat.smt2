(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111101 #b1010100)
                arg1
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg1
                (fp #b0 #b10011100 #b1100010)))
; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b0001001)
                arg2
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b0 #b00010010 #b0010101)))
; arg2 = -256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010100 #b1001000)
                expect
                (fp #b0 #b10000111 #b0000001)))
(assert (fp.leq (fp #b0 #b10000111 #b0000001)
                expect
                (fp #b0 #b10100111 #b1111100)))
; expect = 258.0

(assert (= expect result))

(check-sat)
(exit)
