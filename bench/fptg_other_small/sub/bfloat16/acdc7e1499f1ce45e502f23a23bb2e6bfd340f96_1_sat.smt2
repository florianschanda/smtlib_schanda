                arg2
                (fp #b0 #b10101010 #b0111001)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000010 #b0110011)
                expect
                (fp #b0 #b01111111 #b0101010)))
(assert (fp.leq (fp #b0 #b01111111 #b0101010)
                expect
                (fp #b0 #b11101101 #b1000011)))
; expect = 1.328125

(assert (= expect result))

(check-sat)
