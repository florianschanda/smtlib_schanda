(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg2
                (fp #b0 #b10001100 #b0101000)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101010 #b0100110)
                expect
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                expect
                (fp #b0 #b01111111 #b0100100)))
; expect = -0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

(check-sat)
