                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b10010110 #b1011011)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001011 #b0101001)
                expect
                (fp #b1 #b10000110 #b1110011)))
(assert (fp.leq (fp #b1 #b10000110 #b1110011)
                expect
                (fp #b1 #b00011100 #b0011101)))
; expect = -243.0

(assert (= expect result))

(check-sat)
(exit)
