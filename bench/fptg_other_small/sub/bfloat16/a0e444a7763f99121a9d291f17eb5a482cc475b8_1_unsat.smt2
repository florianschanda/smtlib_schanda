(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110000 #b1010001)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b0 #b11001110 #b0101010)))
; arg1 = -134.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b0110110)
                arg2
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                arg2
                (fp #b0 #b10100011 #b0010000)))
; arg2 = 1.90625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b1001011)
                expect
                (fp #b1 #b10000110 #b0000111)))
(assert (fp.leq (fp #b1 #b10000110 #b0000111)
                expect
                (fp #b0 #b01111010 #b1001010)))
; expect = -135.0

(assert (not (= expect result)))

(check-sat)
(exit)
