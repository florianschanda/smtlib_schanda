; Format: BFLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110011 #b0101111)
                arg1
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg1
                (fp #b1 #b00100100 #b1110001)))
; arg1 = -18374686479671623680.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b0110100)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b10011111 #b1011110)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100010 #b0111000)
                expect
                (fp #b1 #b10111110 #b1111110)))
(assert (fp.leq (fp #b1 #b10111110 #b1111110)
                expect
                (fp #b0 #b00110011 #b0001000)))
; expect = -18302628885633695744.0

(assert (not (= expect result)))

(check-sat)
(exit)
