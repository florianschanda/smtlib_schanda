                arg2
                (fp #b1 #b01010100 #b0100110)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000110 #b1100100)
                expect
                (fp #b0 #b10000111 #b0111000)))
(assert (fp.leq (fp #b0 #b10000111 #b0111000)
                expect
                (fp #b0 #b11111110 #b0011001)))
; expect = 368.0

(assert (not (= expect result)))

(check-sat)
