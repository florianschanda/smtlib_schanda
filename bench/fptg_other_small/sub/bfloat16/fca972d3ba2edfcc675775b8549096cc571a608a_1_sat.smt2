(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b1110011)
                expect
                (fp #b0 #b10000011 #b1101111)))
(assert (fp.leq (fp #b0 #b10000011 #b1101111)
                expect
                (fp #b0 #b11100010 #b1111101)))
; expect = 29.875

(assert (= expect result))

(check-sat)
