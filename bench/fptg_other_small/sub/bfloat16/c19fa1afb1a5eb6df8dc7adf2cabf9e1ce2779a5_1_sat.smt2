                arg2
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg2
                (fp #b0 #b11001001 #b1100110)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1011100)
                expect
                (fp #b1 #b11111100 #b1010010)))
(assert (fp.leq (fp #b1 #b11111100 #b1010010)
                expect
                (fp #b0 #b01101111 #b0110101)))
; expect = -69784469778708083327449870664718090240.0

(assert (= expect result))

(check-sat)
