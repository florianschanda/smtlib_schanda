                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b01110001 #b0111110)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101101 #b1011100)
                expect
                (fp #b0 #b10010100 #b1010110)))
(assert (fp.leq (fp #b0 #b10010100 #b1010110)
                expect
                (fp #b0 #b11010001 #b0001111)))
; expect = 3506176.0

(assert (= expect result))

(check-sat)
