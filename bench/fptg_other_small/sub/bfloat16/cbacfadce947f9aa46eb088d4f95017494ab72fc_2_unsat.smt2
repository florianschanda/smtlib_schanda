(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01110111 #b1100010)
                expect
                (fp #b0 #b10111111 #b0000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000)
