(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110110 #b0011000)
                expect
                (fp #b0 #b01111111 #b0001110)))
(assert (fp.leq (fp #b0 #b01111111 #b0001110)
                expect
