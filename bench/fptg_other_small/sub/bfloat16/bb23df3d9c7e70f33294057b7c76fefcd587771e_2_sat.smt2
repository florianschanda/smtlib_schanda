; Format: BFLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111000 #b1011111)
                arg1
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg1
                (fp #b0 #b10010000 #b0000010)))
; arg1 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010000 #b0111101)
                arg2
                (fp #b1 #b01111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001101)
                arg2
                (fp #b0 #b00000010 #b0100000)))
; arg2 = -1.1015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001011 #b1001001)
                expect
                (fp #b0 #b01111111 #b0001101)))
(assert (fp.leq (fp #b0 #b01111111 #b0001101)
                expect
                (fp #b0 #b10100111 #b0110101)))
; expect = 1.1015625

(assert (= expect result))

(check-sat)
(exit)
