(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010010 #b1000011)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b10101000 #b0101111)))
; arg1 = 30.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10101011 #b1111111)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b11110010 #b0110011)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
