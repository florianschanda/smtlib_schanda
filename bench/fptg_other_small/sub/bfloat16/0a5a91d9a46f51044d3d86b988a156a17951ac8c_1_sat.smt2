                arg2
                (fp #b0 #b11111101 #b1100000)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1111101)
                expect
                (fp #b1 #b11111100 #b1111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111)
                expect
                (fp #b0 #b01000111 #b1101101)))
; expect = -84738284731288386897617700092871966720.0

(assert (= expect result))

(check-sat)
