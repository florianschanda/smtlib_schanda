                arg2
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b0 #b10010011 #b0000110)))
; arg2 = -10627982632313475302148359673872384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010111 #b1101110)
                expect
                (fp #b0 #b11110000 #b0000100)))
(assert (fp.leq (fp #b0 #b11110000 #b0000100)
                expect
                (fp #b0 #b11111110 #b1101000)))
; expect = 10709112270728081983844148679016448.0

(assert (= expect result))

(check-sat)
(exit)
