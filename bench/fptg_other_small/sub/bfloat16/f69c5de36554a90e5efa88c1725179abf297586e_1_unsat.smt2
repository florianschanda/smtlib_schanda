; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101000 #b0111011)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b11001111 #b1100110)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b0010101)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b0 #b10010111 #b0101010)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010101 #b1101011)
                expect
                (fp #b0 #b10000100 #b1110101)))
(assert (fp.leq (fp #b0 #b10000100 #b1110101)
                expect
                (fp #b0 #b11011011 #b1010000)))
; expect = 61.25

(assert (not (= expect result)))

(check-sat)
(exit)
