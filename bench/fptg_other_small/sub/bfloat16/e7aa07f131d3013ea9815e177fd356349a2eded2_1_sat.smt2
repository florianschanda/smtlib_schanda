; Format: BFLOAT16
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111011 #b1111001)
                arg1
                (fp #b1 #b01111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000)
                arg1
                (fp #b0 #b10011011 #b1100010)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b0001111)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b1 #b00110101 #b0000101)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000010 #b0000100)
                expect
                (fp #b0 #b01111110 #b0110000)))
(assert (fp.leq (fp #b0 #b01111110 #b0110000)
                expect
                (fp #b0 #b10011100 #b0111000)))
; expect = 0.6875

(assert (= expect result))

(check-sat)
(exit)
