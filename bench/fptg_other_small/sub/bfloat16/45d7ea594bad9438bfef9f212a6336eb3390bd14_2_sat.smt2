                expect
                (fp #b1 #b11111101 #b0000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000001)
                expect
                (fp #b1 #b01100110 #b0011001)))
; expect = -85735205728127073802295555388082225152.0

(assert (= expect result))

