                (fp #b0 #b11111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000)
                arg2
                (fp #b0 #b11111110 #b0100001)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1100101)
                expect
                (fp #b1 #b11111101 #b0000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000001)
                expect
                (fp #b0 #b00111001 #b1000101)))
; expect = -85735205728127073802295555388082225152.0

(assert (= expect result))

(check-sat)
(exit)
