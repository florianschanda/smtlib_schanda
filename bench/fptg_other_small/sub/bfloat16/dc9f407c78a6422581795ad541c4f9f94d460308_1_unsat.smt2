(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b1100000)
                arg1
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                arg1
                (fp #b0 #b11110101 #b1110010)))
; arg1 = -312261302288384.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b0110001)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b1 #b00010101 #b0000001)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b1100111)
                expect
                (fp #b1 #b10101111 #b0001101)))
(assert (fp.leq (fp #b1 #b10101111 #b0001101)
                expect
                (fp #b1 #b01011010 #b0110000)))
; expect = -310062279032832.0

(assert (not (= expect result)))

(check-sat)
(exit)
