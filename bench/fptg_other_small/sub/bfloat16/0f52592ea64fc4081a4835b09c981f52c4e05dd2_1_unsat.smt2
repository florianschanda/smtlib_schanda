; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101100 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b0 #b10101100 #b1000111)))
; arg1 = -134.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011101 #b1100101)
                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b11111001 #b1011110)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100001 #b0000001)
                expect
                (fp #b1 #b10000111 #b0111100)))
(assert (fp.leq (fp #b1 #b10000111 #b0111100)
                expect
                (fp #b0 #b00110110 #b0101010)))
; expect = -376.0

(assert (not (= expect result)))

(check-sat)
(exit)
