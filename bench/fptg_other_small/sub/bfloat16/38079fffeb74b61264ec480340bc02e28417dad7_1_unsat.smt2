(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg2
                (fp #b0 #b11011000 #b0001111)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110001 #b0011000)
                expect
                (fp #b1 #b01111110 #b1111111)))
(assert (fp.leq (fp #b1 #b01111110 #b1111111)
                expect
                (fp #b1 #b00000100 #b1111001)))
; expect = -0.99609375

(assert (not (= expect result)))

(check-sat)
