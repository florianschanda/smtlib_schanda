(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001101 #b1011001)
                arg1
                (fp #b1 #b01111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111 #b0101111)
                arg1
                (fp #b0 #b00010011 #b0110101)))
; arg1 = -1.3671875

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100100 #b0110100)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b1 #b01101000 #b1111100)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100111 #b0010101)
                expect
                (fp #b0 #b10000101 #b1011110)))
(assert (fp.leq (fp #b0 #b10000101 #b1011110)
                expect
                (fp #b0 #b11101100 #b0000010)))
; expect = 111.0

(assert (= expect result))

(check-sat)
(exit)
