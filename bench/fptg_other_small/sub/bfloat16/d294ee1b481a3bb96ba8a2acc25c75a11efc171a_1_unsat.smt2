                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b10111101 #b0000001)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b1001000)
                expect
                (fp #b1 #b10000110 #b1110100)))
(assert (fp.leq (fp #b1 #b10000110 #b1110100)
                expect
                (fp #b0 #b00010101 #b1000001)))
; expect = -244.0

(assert (not (= expect result)))

(check-sat)
(exit)
