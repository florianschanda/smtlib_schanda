(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b10110001 #b1010110)))
; arg2 = 243.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100010 #b0101010)
                expect
                (fp #b1 #b11011011 #b1011101)))
(assert (fp.leq (fp #b1 #b11011011 #b1011101)
                expect
                (fp #b1 #b01011111 #b1110001)))
; expect = -8549523396314657523522076672.0

(assert (not (= expect result)))

