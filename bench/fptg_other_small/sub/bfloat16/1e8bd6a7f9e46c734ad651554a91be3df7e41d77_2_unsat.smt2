; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100001 #b1111110)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b10011000 #b1101110)))
; arg1 = 59.75

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011000 #b0110001)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b11000100 #b1011100)))
; arg2 = -112.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111101 #b0000111)
                expect
                (fp #b0 #b10000110 #b0101100)))
(assert (fp.leq (fp #b0 #b10000110 #b0101100)
                expect
                (fp #b0 #b11100000 #b1010010)))
; expect = 172.0

(assert (not (= expect result)))

(check-sat)
(exit)
