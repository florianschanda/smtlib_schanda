                arg2
                (fp #b0 #b01111010 #b1000100)))
; arg2 = -18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101001 #b1111110)
                expect
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                expect
                (fp #b0 #b11011010 #b1000011)))
; expect = 18374686479671623680.0

(assert (= expect result))

(check-sat)
