                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                arg2
                (fp #b0 #b11011111 #b1000101)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b0010010)
                expect
                (fp #b1 #b11010100 #b1011101)))
(assert (fp.leq (fp #b1 #b11010100 #b1011101)
                expect
                (fp #b1 #b10110111 #b0000110)))
; expect = -66793151533708261902516224.0

(assert (not (= expect result)))

(check-sat)
