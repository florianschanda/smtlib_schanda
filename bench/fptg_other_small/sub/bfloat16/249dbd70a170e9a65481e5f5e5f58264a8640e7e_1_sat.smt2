                arg2
                (fp #b0 #b11110000 #b0011000)))
; arg2 = 423395300476228620099898870595584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101100 #b1011001)
                expect
                (fp #b1 #b11101011 #b0100110)))
(assert (fp.leq (fp #b1 #b11101011 #b0100110)
                expect
                (fp #b1 #b11010010 #b1010001)))
; expect = -420859999275772161296905464184832.0

(assert (= expect result))

(check-sat)
(exit)
