                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b10111010 #b0000001101)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010111 #b1011001101)
                expect
                (fp #b1 #b10001001 #b0100110111)))
(assert (fp.leq (fp #b1 #b10001001 #b0100110111)
                expect
                (fp #b0 #b11010001 #b0110000111)))
; expect = -1335.0

(assert (not (= expect result)))

(check-sat)
