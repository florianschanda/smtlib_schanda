                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b00100000 #b1100010010)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b1010010011)
                expect
                (fp #b1 #b11100110 #b1110111010)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111010)
                expect
                (fp #b0 #b10110010 #b0111101110)))
; expect = -19589163181651857470003741720576.0

(assert (= expect result))

(check-sat)
(exit)
