; Format: TENSORFLOAT32
; Arg1: +ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101101 #b0011110001)
                arg1
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b11111011 #b1001100000)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000110 #b1010101101)
                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b01100011 #b1101000001)))
; arg2 = -18437736874454810624.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110010 #b0000011011)
                expect
                (fp #b0 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000000)
                expect
                (fp #b0 #b11101010 #b1101010010)))
; expect = 18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
