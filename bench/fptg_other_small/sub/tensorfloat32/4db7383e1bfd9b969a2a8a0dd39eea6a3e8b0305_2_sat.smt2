                (fp #b1 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001100)
                arg2
                (fp #b0 #b01011010 #b0100111111)))
; arg2 = -646.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111000 #b1010011011)
                expect
                (fp #b0 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b0 #b10001000 #b0100001100)
                expect
                (fp #b0 #b11101000 #b0011000110)))
; expect = 646.0

(assert (= expect result))

(check-sat)
