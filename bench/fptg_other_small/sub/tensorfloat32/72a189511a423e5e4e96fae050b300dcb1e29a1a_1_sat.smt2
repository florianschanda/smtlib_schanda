(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00011000 #b0001101011)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b10010111 #b1011101111)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011011 #b0101100110)
                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b00011100 #b1001101100)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110001 #b0000011001)
                expect
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                expect
                (fp #b0 #b10110111 #b1011001000)))
; expect = 2048.0

(assert (= expect result))

(check-sat)
(exit)
