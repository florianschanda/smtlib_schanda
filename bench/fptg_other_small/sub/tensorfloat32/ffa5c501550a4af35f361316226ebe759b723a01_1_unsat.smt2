(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111100 #b0000010011)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01010100 #b0111101100)))
; arg1 = -264.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10010011 #b0100110100)
                arg2
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b11110011 #b0000101101)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101100 #b1111101000)
                expect
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                expect
                (fp #b0 #b00111101 #b0110100010)))
; expect = -264.0

(assert (not (= expect result)))

(check-sat)
(exit)
