                expect
                (fp #b0 #b10001001 #b1101001111)))
(assert (fp.leq (fp #b0 #b10001001 #b1101001111)
                expect
                (fp #b0 #b11000100 #b0010000110)))
; expect = 1871.0

(assert (not (= expect result)))

