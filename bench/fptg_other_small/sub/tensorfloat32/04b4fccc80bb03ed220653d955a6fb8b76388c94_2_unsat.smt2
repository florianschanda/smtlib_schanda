;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001111 #b1000101011)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11001010 #b0011100011)))
