                arg2
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b11001010 #b1111111011)))
; arg2 = -0.00000000000000000000338813178901720135627329000271856784820556640625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1010100100)
                expect
                (fp #b0 #b01111111 #b1001100101)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100101)
                expect
                (fp #b0 #b10101101 #b1001110100)))
; expect = 1.5986328125

(assert (not (= expect result)))

(check-sat)
(exit)
