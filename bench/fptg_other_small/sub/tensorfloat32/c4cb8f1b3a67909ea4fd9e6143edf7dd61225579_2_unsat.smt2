                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b10110111 #b1001100110)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010100 #b1101000110)
                expect
                (fp #b1 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b1 #b10001001 #b0100111000)
                expect
                (fp #b1 #b00100001 #b0011000010)))
; expect = -1336.0

(assert (not (= expect result)))

(check-sat)
(exit)
