; Format: TENSORFLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101110 #b1101101001)
                arg1
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b00000101 #b1010111110)))
; arg1 = 0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000100 #b1011010100)
                arg2
                (fp #b0 #b01111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b10010000 #b1101010100)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b1100101011)
                expect
                (fp #b1 #b01111111 #b0010110100)))
(assert (fp.leq (fp #b1 #b01111111 #b0010110100)
                expect
                (fp #b0 #b00011110 #b0101110100)))
; expect = -1.17578125

(assert (= expect result))

(check-sat)
(exit)
