                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b0 #b11110011 #b1000001010)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b11100000 #b1010101110)
                expect
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                expect
                (fp #b0 #b11111111 #b0000000000)))
; expect = 340116213421465348979261631549233168384.0

(assert (= expect result))

(check-sat)
(exit)
