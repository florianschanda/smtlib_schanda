; Format: TENSORFLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010011 #b0101011011)
                arg1
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                arg1
                (fp #b0 #b10100110 #b1101101110)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110101 #b1001001111)
                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11110011 #b1101101100)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011110 #b0100010010)
                expect
                (fp #b1 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b1 #b11000101 #b0000100010)
                expect
                (fp #b0 #b01000110 #b1010110110)))
; expect = -1219790951874044100608.0

(assert (= expect result))

(check-sat)
(exit)
