; Format: TENSORFLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01101000 #b0101100011)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b11100100 #b1001100011)))
; arg1 = 2048.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010100 #b1000001111)
                arg2
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b00010111 #b0101101001)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011011 #b0101100111)
                expect
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                expect
                (fp #b0 #b11010000 #b1111100000)))
; expect = 2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
