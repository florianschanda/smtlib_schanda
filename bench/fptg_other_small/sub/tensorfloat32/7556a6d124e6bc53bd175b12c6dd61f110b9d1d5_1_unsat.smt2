(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010100 #b1011101111)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b11011001 #b0010111100)))
; arg1 = -933.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b0110101000)
                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b10101100 #b0000000001)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001010 #b0101100110)
                expect
                (fp #b0 #b10001001 #b0001011011)))
(assert (fp.leq (fp #b0 #b10001001 #b0001011011)
                expect
                (fp #b0 #b11111100 #b1010110111)))
; expect = 1115.0

(assert (not (= expect result)))

(check-sat)
(exit)
