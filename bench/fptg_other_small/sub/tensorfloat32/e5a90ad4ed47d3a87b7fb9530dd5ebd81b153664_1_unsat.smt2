(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111011 #b1111010010)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b00011010 #b0111010011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11111001 #b0101011110)
                arg2
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b01101001 #b1110111010)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11111100 #b0000101011)
                expect
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00101101 #b1110000111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
