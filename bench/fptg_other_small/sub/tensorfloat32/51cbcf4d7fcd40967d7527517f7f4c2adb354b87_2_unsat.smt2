(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0011111111)
                expect
                (fp #b1 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000001)
                expect
                (fp #b0 #b01011000 #b1101111111)))
; expect = -85153668479971173107900139799209574400.0

(assert (not (= expect result)))

