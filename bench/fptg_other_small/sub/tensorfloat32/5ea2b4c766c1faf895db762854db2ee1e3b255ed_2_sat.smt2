(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b11011100 #b1001001001)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000001 #b1110000001)
                expect
                (fp #b1 #b10011100 #b0001111100)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111100)
                expect
                (fp #b0 #b11011111 #b1110010110)))
; expect = -601882624.0

(assert (= expect result))

(check-sat)
(exit)
