(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b10000111 #b0010000010)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b0000101001)
                expect
                (fp #b1 #b01111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b01111110 #b1111111111)
                expect
                (fp #b0 #b10101110 #b1000000110)))
; expect = -0.99951171875

(assert (= expect result))

