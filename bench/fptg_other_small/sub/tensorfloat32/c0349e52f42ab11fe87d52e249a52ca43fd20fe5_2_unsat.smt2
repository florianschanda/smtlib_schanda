(assert (fp.leq (fp #b1 #b10011000 #b0010011001)
                expect
                (fp #b1 #b10001010 #b0000000001)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000001)
                expect
                (fp #b0 #b10101101 #b0101100100)))
; expect = -2050.0

(assert (not (= expect result)))

