                arg2
                (fp #b0 #b00101111 #b0100110101)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011101 #b0011001000)
                expect
                (fp #b0 #b11110100 #b1110010011)))
(assert (fp.leq (fp #b0 #b11110100 #b1110010011)
                expect
                (fp #b0 #b11110110 #b1000011010)))
; expect = 314620737771844711616269761948680192.0

(assert (not (= expect result)))

