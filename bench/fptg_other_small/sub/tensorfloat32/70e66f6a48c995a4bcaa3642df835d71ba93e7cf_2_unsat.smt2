                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b11000111 #b1010011011)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000000 #b1011100111)
                expect
                (fp #b0 #b01111111 #b0011111111)))
(assert (fp.leq (fp #b0 #b01111111 #b0011111111)
                expect
                (fp #b0 #b11010000 #b1110001101)))
; expect = 1.2490234375

(assert (not (= expect result)))

(check-sat)
