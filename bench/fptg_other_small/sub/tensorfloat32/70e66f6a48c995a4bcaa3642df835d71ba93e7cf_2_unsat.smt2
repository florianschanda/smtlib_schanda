(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000110 #b1110110010)
                arg1
                (fp #b0 #b00000000 #b1111111111)))
