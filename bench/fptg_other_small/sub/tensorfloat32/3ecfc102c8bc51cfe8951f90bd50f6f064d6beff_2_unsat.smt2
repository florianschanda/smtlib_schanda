; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100101 #b1111100100)
                arg1
                (fp #b0 #b00000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000 #b0001001100)
                arg1
                (fp #b0 #b00110111 #b0011101001)))
; arg1 = 0.00000000000000000000000000000000000000087243721350091650982054664871963546400604084291678370736977665700351280975155532360076904296875

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100011 #b1000100010)
                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11001010 #b0110001001)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000101 #b0101001000)
                expect
                (fp #b0 #b10001010 #b0000000001)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000001)
                expect
                (fp #b0 #b11101101 #b1101000011)))
; expect = 2050.0

(assert (not (= expect result)))

(check-sat)
(exit)
