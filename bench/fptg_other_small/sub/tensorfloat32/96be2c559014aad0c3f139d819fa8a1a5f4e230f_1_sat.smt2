(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b0001110011)
                arg1
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                arg1
                (fp #b0 #b11011101 #b1110110111)))
; arg1 = 1671.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101100 #b0111111011)
                arg2
                (fp #b0 #b00000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000 #b0001110101)
                arg2
                (fp #b0 #b10000001 #b0101010111)))
; arg2 = 0.0000000000000000000000000000000000000013430941313106214690658415513183861748514049818587328126613666956501447202754206955432891845703125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10000001 #b0100010010)
                expect
                (fp #b0 #b10001001 #b1010000110)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000110)
                expect
                (fp #b0 #b11111110 #b0010111110)))
; expect = 1670.0

(assert (= expect result))

(check-sat)
(exit)
