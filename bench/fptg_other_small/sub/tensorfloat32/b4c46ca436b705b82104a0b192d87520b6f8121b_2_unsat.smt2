(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01001010 #b1111110110)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11111110 #b1101010001)))
; arg1 = 1.59765625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01010000 #b1110110000)
                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11011100 #b0000111001)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101001 #b1101101110)
                expect
                (fp #b1 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b1 #b11000101 #b0000100010)
                expect
                (fp #b0 #b01100100 #b0110100010)))
; expect = -1219790951874044100608.0

(assert (not (= expect result)))

(check-sat)
(exit)
