                arg2
                (fp #b0 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b11101110 #b1000010000)))
; arg2 = 307090161664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100010 #b0110110110)
                expect
                (fp #b1 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b1 #b10100101 #b0001111000)
                expect
                (fp #b0 #b00001110 #b0011100001)))
; expect = -307090161664.0

(assert (= expect result))

(check-sat)
(exit)
