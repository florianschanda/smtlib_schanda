                arg2
                (fp #b0 #b11100100 #b0001100010)))
; arg2 = -13052620958651699370655744.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10100101 #b0001000001)
                expect
                (fp #b0 #b11010010 #b0101100101)))
(assert (fp.leq (fp #b0 #b11010010 #b0101100101)
                expect
                (fp #b0 #b11011111 #b1110111010)))
; expect = 13043176225685960080228352.0

(assert (not (= expect result)))

(check-sat)
(exit)
