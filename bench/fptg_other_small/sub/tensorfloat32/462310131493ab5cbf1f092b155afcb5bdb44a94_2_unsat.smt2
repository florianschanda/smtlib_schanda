; Format: TENSORFLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101010 #b0000110111)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b11011000 #b1110000110)))
; arg1 = 2048.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110010 #b0000011110)
                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b11101010 #b0101110000)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01110101 #b1110100100)
                expect
                (fp #b0 #b10001010 #b0000000001)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000001)
                expect
                (fp #b0 #b10011100 #b0000010111)))
; expect = 2050.0

(assert (not (= expect result)))

(check-sat)
(exit)
