; Format: TENSORFLOAT32
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000001 #b1100001101)
                arg1
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg1
                (fp #b0 #b11111101 #b1101110001)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010100 #b0011010011)
                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11010100 #b0100001100)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111111 #b1101101110)
                expect
                (fp #b0 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000001)
                expect
                (fp #b0 #b11111101 #b0011000011)))
; expect = 85153668479971173107900139799209574400.0

(assert (not (= expect result)))

(check-sat)
(exit)
