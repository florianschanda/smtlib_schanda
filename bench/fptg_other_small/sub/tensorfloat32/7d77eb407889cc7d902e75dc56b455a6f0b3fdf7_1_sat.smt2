; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10101110 #b0110000111)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b01000100 #b1001101011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001111 #b0111000111)
                arg2
                (fp #b1 #b00000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000 #b0101011111)
                arg2
                (fp #b0 #b11110001 #b0010011001)))
; arg2 = -0.0000000000000000000000000000000000000040292823939318644071975246539551585245542149455761984379841000869504341608262620866298675537109375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010111 #b0111110101)
                expect
                (fp #b0 #b00000000 #b0101011111)))
(assert (fp.leq (fp #b0 #b00000000 #b0101011111)
                expect
                (fp #b0 #b01100101 #b0100110101)))
; expect = 0.0000000000000000000000000000000000000040292823939318644071975246539551585245542149455761984379841000869504341608262620866298675537109375

(assert (= expect result))

(check-sat)
(exit)
