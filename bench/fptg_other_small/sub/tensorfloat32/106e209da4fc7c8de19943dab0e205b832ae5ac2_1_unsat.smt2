(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11001111 #b1011011111)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101000 #b0110000110)
                expect
                (fp #b1 #b10001010 #b0001101110)))
(assert (fp.leq (fp #b1 #b10001010 #b0001101110)
                expect
                (fp #b1 #b10000110 #b1101001011)))
; expect = -2268.0

(assert (not (= expect result)))

(check-sat)
