                arg2
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b10111111 #b1000110011)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b1000110010)
                expect
                (fp #b0 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000000)
                expect
                (fp #b0 #b11001011 #b0101101001)))
; expect = 18446744073709551616.0

(assert (not (= expect result)))

(check-sat)
(exit)
