(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100100 #b0010111000)
                arg2
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b11100100 #b1110110101)))
; arg2 = 1.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000010 #b1110001000)
                expect
                (fp #b1 #b10000000 #b0001101000)))
(assert (fp.leq (fp #b1 #b10000000 #b0001101000)
                expect
                (fp #b0 #b10010111 #b0001111110)))
; expect = -2.203125

(assert (not (= expect result)))

(check-sat)
(exit)
