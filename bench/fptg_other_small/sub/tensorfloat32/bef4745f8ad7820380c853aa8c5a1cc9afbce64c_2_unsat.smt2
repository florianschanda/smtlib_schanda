(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b11001100 #b0111110101)))
; arg2 = 307090161664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101001 #b1111110010)
                expect
                (fp #b1 #b10100101 #b0001111001)))
(assert (fp.leq (fp #b1 #b10100101 #b0001111001)
                expect
                (fp #b1 #b00011001 #b0011011110)))
; expect = -307358597120.0

(assert (not (= expect result)))

(check-sat)
