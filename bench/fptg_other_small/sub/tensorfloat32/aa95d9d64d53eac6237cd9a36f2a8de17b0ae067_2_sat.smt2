(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b0101110000)
                expect
                (fp #b0 #b10001001 #b1101010001)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010001)
                expect
                (fp #b0 #b11110010 #b0110011101)))
; expect = 1873.0

(assert (= expect result))

