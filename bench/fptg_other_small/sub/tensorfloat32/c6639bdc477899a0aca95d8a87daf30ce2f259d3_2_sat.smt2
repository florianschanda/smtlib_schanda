; Format: TENSORFLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101101 #b0000000011)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00100000 #b1110111111)))
; arg1 = -2048.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00111101 #b1010110110)
                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b01100100 #b0000101110)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011011 #b0000001000)
                expect
                (fp #b1 #b10001010 #b0000000001)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000001)
                expect
                (fp #b0 #b01100001 #b0100100011)))
; expect = -2050.0

(assert (= expect result))

(check-sat)
(exit)
