                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11010111 #b1001001001)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b1011010101)
                expect
                (fp #b1 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b1 #b11000101 #b0000100010)
                expect
                (fp #b0 #b10001111 #b0111111110)))
; expect = -1219790951874044100608.0

(assert (not (= expect result)))

(check-sat)
(exit)
