                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b10101010 #b1011001010)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010010 #b0111111111)
                expect
                (fp #b1 #b10001001 #b0100111001)))
(assert (fp.leq (fp #b1 #b10001001 #b0100111001)
                expect
                (fp #b1 #b01011110 #b1110011100)))
; expect = -1337.0

(assert (= expect result))

(check-sat)
(exit)
