; Format: TENSORFLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101010 #b1101100011)
                arg1
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b01001110 #b1100100111)))
; arg1 = 0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011010 #b1111111000)
                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b0 #b11101111 #b0011111011)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001011 #b1011101101)
                expect
                (fp #b0 #b10000111 #b0011100101)))
(assert (fp.leq (fp #b0 #b10000111 #b0011100101)
                expect
                (fp #b0 #b11010000 #b1101110001)))
; expect = 313.25

(assert (not (= expect result)))

(check-sat)
(exit)
