;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001000 #b1100100011)
                arg1
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b10001101 #b0111001001)))
; arg1 = -0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1010011110)
                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b01111100 #b1011011000)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000011 #b1111100000)
                expect
                (fp #b0 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b0 #b11110100 #b1110010100)
                expect
                (fp #b0 #b11110111 #b0001100001)))
; expect = 314782997048673924979661339958968320.0

(assert (= expect result))

(check-sat)
(exit)
