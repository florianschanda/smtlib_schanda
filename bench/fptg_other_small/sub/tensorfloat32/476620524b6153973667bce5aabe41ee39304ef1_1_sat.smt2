(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b11110011 #b1010011101)))
; arg2 = -1.248046875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011110 #b1011101100)
                expect
                (fp #b0 #b10000000 #b0001111111)))
(assert (fp.leq (fp #b0 #b10000000 #b0001111111)
                expect
                (fp #b0 #b11100100 #b1100110111)))
; expect = 2.248046875

(assert (= expect result))

(check-sat)
