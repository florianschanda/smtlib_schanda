; Format: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011000 #b1100100111)
                arg1
                (fp #b0 #b11000011 #b1111001010)))
(assert (fp.leq (fp #b0 #b11000011 #b1111001010)
                arg1
                (fp #b0 #b11101101 #b1011101111)))
; arg1 = 574731370046513217536.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011110 #b1100111010)
                arg2
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg2
                (fp #b0 #b11111101 #b0000111010)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0000001101)
                expect
                (fp #b1 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111111)
                expect
                (fp #b1 #b10010010 #b1101001001)))
; expect = -85029053355366337244815407887308292096.0

(assert (= expect result))

(check-sat)
(exit)
