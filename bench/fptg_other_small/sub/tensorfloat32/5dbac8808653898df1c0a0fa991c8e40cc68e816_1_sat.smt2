(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b0101101100)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b1 #b00001100 #b0010010100)))
; arg1 = -1.203125

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b1110100111)
                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b0 #b10001111 #b1111101001)))
; arg2 = -48404256449413863440384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001111 #b1101100110)
                expect
                (fp #b0 #b11001010 #b0100011111)))
(assert (fp.leq (fp #b0 #b11001010 #b0100011111)
                expect
                (fp #b0 #b11111110 #b1010101010)))
; expect = 48367362961266444337152.0

(assert (= expect result))

(check-sat)
(exit)
