                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b01111101 #b0111101010)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011100 #b1101010001)
                expect
                (fp #b0 #b10000000 #b0000010011)))
(assert (fp.leq (fp #b0 #b10000000 #b0000010011)
                expect
                (fp #b0 #b11000101 #b1000001000)))
; expect = 2.037109375

(assert (not (= expect result)))

(check-sat)
(exit)
