(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010100 #b0111011100)
                arg1
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                arg1
                (fp #b0 #b11110100 #b1101000001)))
; arg1 = 1737314271232.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10001010 #b0011100000)
                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11111110 #b0101010001)))
; arg2 = 1219790951874044100608.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100000 #b1001011110)
                expect
                (fp #b1 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b1 #b11000101 #b0000100010)
                expect
                (fp #b1 #b10100010 #b1011001100)))
; expect = -1219790951874044100608.0

(assert (= expect result))

(check-sat)
(exit)
