                arg2
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg2
                (fp #b1 #b11010011 #b1111111001)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101101 #b0111111100)
                expect
                (fp #b0 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b1111111111)
                expect
                (fp #b0 #b11111110 #b0001001101)))
; expect = 85029053355366337244815407887308292096.0

(assert (not (= expect result)))

(check-sat)
(exit)
