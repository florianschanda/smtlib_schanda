(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg2
                (fp #b1 #b00000110 #b0011110000)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00100111 #b1100011110)
                expect
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                expect
                (fp #b0 #b10111001 #b1001101010)))
; expect = 2048.0

(assert (= expect result))

(check-sat)
(exit)
