                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b1 #b10000011 #b0111010101)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01001110 #b0100001011)
                expect
                (fp #b0 #b10000111 #b0011100101)))
(assert (fp.leq (fp #b0 #b10000111 #b0011100101)
                expect
                (fp #b0 #b11011000 #b0110110110)))
; expect = 313.25

(assert (not (= expect result)))

(check-sat)
(exit)
