                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111100 #b1000010010)))
; arg2 = 60812180807159901185349173007825764352.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b1110100101)
                expect
                (fp #b1 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b1 #b11111100 #b0110111000)
                expect
                (fp #b1 #b00000011 #b0101101110)))
; expect = -60812180807159901185349173007825764352.0

(assert (not (= expect result)))

(check-sat)
(exit)
