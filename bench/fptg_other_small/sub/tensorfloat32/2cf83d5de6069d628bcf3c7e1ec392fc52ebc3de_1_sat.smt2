(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b1010100101)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11000100 #b0010010000)))
; arg1 = 1.59765625

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1010011011)
                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b11010001 #b1010000010)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011011 #b1001011011)
                expect
                (fp #b0 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b0 #b11110100 #b1110010100)
                expect
                (fp #b0 #b11111000 #b0110100110)))
; expect = 314782997048673924979661339958968320.0

(assert (= expect result))

(check-sat)
(exit)
