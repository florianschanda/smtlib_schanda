(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101011 #b1110111110)
                arg1
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg1
                (fp #b1 #b00011001 #b0001101011)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000001 #b0011101001)
                arg2
                (fp #b0 #b01111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111 #b0010110101)
                arg2
                (fp #b0 #b10010000 #b1001010011)))
; arg2 = 1.1767578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b0010100001)
                expect
                (fp #b1 #b10000000 #b0001011010)))
(assert (fp.leq (fp #b1 #b10000000 #b0001011010)
                expect
                (fp #b1 #b01101000 #b1000110011)))
; expect = -2.17578125

(assert (= expect result))

(check-sat)
(exit)
