(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b00000101 #b0010100111)))
; arg2 = -314782997048673924979661339958968320.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1111000111)
                expect
                (fp #b1 #b11111100 #b1111111000)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111000)
                expect
                (fp #b0 #b11001000 #b1111010111)))
; expect = -84738284731288386897617700092871966720.0

(assert (= expect result))

(check-sat)
