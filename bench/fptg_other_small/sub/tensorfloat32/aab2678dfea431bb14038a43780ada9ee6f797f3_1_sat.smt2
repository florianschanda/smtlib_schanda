                arg2
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b01100100 #b0100110101)))
; arg2 = 0.00000000000000000000338813178901720135627329000271856784820556640625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0101110110)
                expect
                (fp #b0 #b10001001 #b1010000110)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000110)
                expect
                (fp #b0 #b10101010 #b1001000110)))
; expect = 1670.0

(assert (= expect result))

(check-sat)
(exit)
