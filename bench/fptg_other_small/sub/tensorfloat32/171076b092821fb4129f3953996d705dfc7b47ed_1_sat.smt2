(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b1101101001)
                expect
                (fp #b1 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111111)
                expect
                (fp #b0 #b10011001 #b0001110000)))
; expect = -85029053355366337244815407887308292096.0

(assert (= expect result))

