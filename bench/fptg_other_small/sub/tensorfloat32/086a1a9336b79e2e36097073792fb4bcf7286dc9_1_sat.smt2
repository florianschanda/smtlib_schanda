                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b00000011 #b1011110001)))
; arg2 = -0.0000000000000000000000000000000018567168370108195645867787352732814930281386202326476819735034951008856296539306640625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010111 #b0001111011)
                expect
                (fp #b1 #b01111111 #b1111110011)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110011)
                expect
                (fp #b0 #b11100101 #b1011110101)))
; expect = -1.9873046875

(assert (= expect result))

(check-sat)
(exit)
