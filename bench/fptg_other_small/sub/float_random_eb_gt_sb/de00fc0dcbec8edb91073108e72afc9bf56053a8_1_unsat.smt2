(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011010 #b11)
                arg1
                (fp #b0 #b001111 #b00)))
(assert (fp.leq (fp #b0 #b001111 #b00)
                arg1
                (fp #b0 #b010000 #b00)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110011 #b01)
                arg2
                (fp #b1 #b100110 #b00)))
(assert (fp.leq (fp #b1 #b100110 #b00)
                arg2
                (fp #b0 #b101001 #b01)))
; arg2 = -128.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010010 #b00)
                expect
                (fp #b0 #b100110 #b00)))
(assert (fp.leq (fp #b0 #b100110 #b00)
                expect
                (fp #b0 #b110100 #b01)))
; expect = 128.0

(assert (not (= expect result)))

(check-sat)
(exit)
