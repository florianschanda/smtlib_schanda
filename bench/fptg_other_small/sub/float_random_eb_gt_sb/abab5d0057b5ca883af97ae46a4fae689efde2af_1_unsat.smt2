(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b01001 #b01)
                arg1
                (fp #b0 #b10111 #b00)))
(assert (fp.leq (fp #b0 #b10111 #b00)
                arg1
                (fp #b0 #b11011 #b11)))
; arg1 = 256.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b10)
                arg2
                (fp #b1 #b10100 #b00)))
(assert (fp.leq (fp #b1 #b10100 #b00)
                arg2
                (fp #b0 #b10011 #b00)))
; arg2 = -32.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00111 #b10)
                expect
                (fp #b0 #b10111 #b00)))
(assert (fp.leq (fp #b0 #b10111 #b00)
                expect
                (fp #b0 #b11001 #b01)))
; expect = 256.0

(assert (not (= expect result)))

(check-sat)
(exit)
