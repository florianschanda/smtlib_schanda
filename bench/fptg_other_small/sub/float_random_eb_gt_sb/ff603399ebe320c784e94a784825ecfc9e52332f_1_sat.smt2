(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101000 #b001)
                arg1
                (fp #b1 #b100010 #b110)))
(assert (fp.leq (fp #b1 #b100010 #b110)
                arg1
                (fp #b0 #b011111 #b000)))
; arg1 = -14.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010000 #b100)
                arg2
                (fp #b0 #b100001 #b000)))
(assert (fp.leq (fp #b0 #b100001 #b000)
                arg2
                (fp #b0 #b111011 #b011)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100100 #b100)
                expect
                (fp #b1 #b100011 #b001)))
(assert (fp.leq (fp #b1 #b100011 #b001)
                expect
                (fp #b1 #b010110 #b101)))
; expect = -18.0

(assert (= expect result))

(check-sat)
(exit)
