(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b10001111 #b10)
                arg1
                (fp #b0 #b11001110 #b11)))
(assert (fp.leq (fp #b0 #b11001110 #b11)
                arg1
                (fp #b0 #b11111011 #b10)))
; arg1 = 1057810092162800527867904.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10011000 #b10)
                arg2
                (fp #b1 #b01111111 #b00)))
(assert (fp.leq (fp #b1 #b01111111 #b00)
                arg2
                (fp #b0 #b10100010 #b01)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00110000 #b01)
                expect
                (fp #b0 #b11001110 #b11)))
(assert (fp.leq (fp #b0 #b11001110 #b11)
                expect
                (fp #b0 #b11100100 #b00)))
; expect = 1057810092162800527867904.0

(assert (not (= expect result)))

(check-sat)
(exit)
