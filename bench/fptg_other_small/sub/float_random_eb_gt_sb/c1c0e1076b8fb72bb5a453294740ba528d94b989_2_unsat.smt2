(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000010 #b00)
                arg1
                (fp #b0 #b011111 #b00)))
(assert (fp.leq (fp #b0 #b011111 #b00)
                arg1
                (fp #b0 #b100100 #b10)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001010 #b10)
                arg2
                (fp #b1 #b000000 #b11)))
(assert (fp.leq (fp #b1 #b000000 #b11)
                arg2
                (fp #b0 #b001111 #b11)))
; arg2 = -0.00000000069849193096160888671875

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100000 #b11)
                expect
                (fp #b0 #b011111 #b01)))
(assert (fp.leq (fp #b0 #b011111 #b01)
                expect
                (fp #b0 #b100110 #b11)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
