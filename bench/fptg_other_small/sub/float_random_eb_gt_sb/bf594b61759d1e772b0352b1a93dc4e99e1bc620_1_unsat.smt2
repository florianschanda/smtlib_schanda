(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101001 #b100)
                arg1
                (fp #b1 #b10101001 #b100)))
(assert (fp.leq (fp #b1 #b10101001 #b100)
                arg1
                (fp #b0 #b00011010 #b000)))
; arg1 = -6597069766656.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101101 #b111)
                arg2
                (fp #b1 #b11011100 #b110)))
(assert (fp.leq (fp #b1 #b11011100 #b110)
                arg2
                (fp #b0 #b10000001 #b001)))
; arg2 = -17331160549995323848587739136.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00001011 #b111)
                expect
                (fp #b0 #b11011100 #b101)))
(assert (fp.leq (fp #b0 #b11011100 #b101)
                expect
                (fp #b0 #b11101011 #b000)))
; expect = 16093220510709943573688614912.0

(assert (not (= expect result)))

(check-sat)
(exit)
