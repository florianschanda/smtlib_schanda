(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11110110 #b101110)
                arg1
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg1
                (fp #b0 #b10010010 #b111001)))
; arg1 = 128.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00010100 #b000000)
                arg2
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg2
                (fp #b0 #b11111110 #b101010)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111101 #b000100)
                expect
                (fp #b1 #b11111101 #b000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000)
                expect
                (fp #b0 #b10000001 #b011110)))
; expect = -85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
