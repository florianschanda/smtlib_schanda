(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b100)
                arg1
                (fp #b0 #b101110 #b111)))
(assert (fp.leq (fp #b0 #b101110 #b111)
                arg1
                (fp #b0 #b110100 #b011)))
; arg1 = 61440.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011111 #b101)
                arg2
                (fp #b1 #b000101 #b101)))
(assert (fp.leq (fp #b1 #b000101 #b101)
                arg2
                (fp #b0 #b000000 #b010)))
; arg2 = -0.00000002421438694000244140625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010010 #b111)
                expect
                (fp #b0 #b101110 #b111)))
(assert (fp.leq (fp #b0 #b101110 #b111)
                expect
                (fp #b0 #b110101 #b110)))
; expect = 61440.0

(assert (not (= expect result)))

(check-sat)
(exit)
