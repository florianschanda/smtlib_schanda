(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01011111 #b0111)
                arg1
                (fp #b0 #b00000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000)
                arg1
                (fp #b0 #b11001111 #b0110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10100011 #b0101)
                arg2
                (fp #b1 #b00000000 #b1111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111)
                arg2
                (fp #b0 #b00111000 #b0001)))
; arg2 = -0.0000000000000000000000000000000000000110202595389589453872069050364585532295499895947383205141445472463601618073880672454833984375

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10011011 #b0010)
                expect
                (fp #b0 #b00000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111)
                expect
                (fp #b0 #b11010100 #b0111)))
; expect = 0.0000000000000000000000000000000000000110202595389589453872069050364585532295499895947383205141445472463601618073880672454833984375

(assert (= expect result))

(check-sat)
(exit)
