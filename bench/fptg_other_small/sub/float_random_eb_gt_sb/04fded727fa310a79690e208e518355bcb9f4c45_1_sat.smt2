                arg2
                (fp #b0 #b01000000 #b00)))
(assert (fp.leq (fp #b0 #b01000000 #b00)
                arg2
                (fp #b0 #b10111011 #b00)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11100100 #b10)
                expect
                (fp #b1 #b00111111 #b11)))
(assert (fp.leq (fp #b1 #b00111111 #b11)
                expect
                (fp #b1 #b00001101 #b10)))
; expect = -0.000000000000000000094867690092481637975652120076119899749755859375

(assert (= expect result))

(check-sat)
(exit)
