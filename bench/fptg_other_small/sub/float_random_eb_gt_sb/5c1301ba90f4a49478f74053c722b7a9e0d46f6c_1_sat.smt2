(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101001 #b11)
                arg1
                (fp #b1 #b0100000 #b00)))
(assert (fp.leq (fp #b1 #b0100000 #b00)
                arg1
                (fp #b0 #b1101001 #b00)))
; arg1 = -0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0101010 #b00)
                arg2
                (fp #b0 #b0110101 #b00)))
(assert (fp.leq (fp #b0 #b0110101 #b00)
                arg2
                (fp #b0 #b1010110 #b01)))
; arg2 = 0.0009765625

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0110110 #b00)
                expect
                (fp #b1 #b0110101 #b00)))
(assert (fp.leq (fp #b1 #b0110101 #b00)
                expect
                (fp #b0 #b1010001 #b01)))
; expect = -0.0009765625

(assert (= expect result))

(check-sat)
(exit)
