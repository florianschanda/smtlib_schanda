(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b00011 #b0)
                arg1
                (fp #b0 #b01111 #b1)))
(assert (fp.leq (fp #b0 #b01111 #b1)
                arg1
                (fp #b0 #b11100 #b1)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b01111 #b0)
                arg2
                (fp #b0 #b10001 #b0)))
(assert (fp.leq (fp #b0 #b10001 #b0)
                arg2
                (fp #b0 #b10001 #b1)))
; arg2 = 4.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b0)
                expect
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                expect
                (fp #b0 #b10101 #b1)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
