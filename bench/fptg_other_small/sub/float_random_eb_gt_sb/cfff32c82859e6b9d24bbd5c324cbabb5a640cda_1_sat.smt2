; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01101101 #b11111)
                arg1
                (fp #b1 #b00000001 #b00000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000)
                arg1
                (fp #b0 #b11110001 #b10001)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10001100 #b01010)
                arg2
                (fp #b1 #b10000110 #b11000)))
(assert (fp.leq (fp #b1 #b10000110 #b11000)
                arg2
                (fp #b1 #b00001001 #b01001)))
; arg2 = -224.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11100000 #b10011)
                expect
                (fp #b0 #b10000110 #b10111)))
(assert (fp.leq (fp #b0 #b10000110 #b10111)
                expect
                (fp #b0 #b11110110 #b01001)))
; expect = 220.0

(assert (= expect result))

(check-sat)
(exit)
