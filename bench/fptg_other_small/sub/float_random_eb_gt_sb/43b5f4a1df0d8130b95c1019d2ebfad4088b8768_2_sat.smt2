(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b1)
                arg1
                (fp #b1 #b00000 #b1)))
(assert (fp.leq (fp #b1 #b00000 #b1)
                arg1
                (fp #b0 #b10101 #b0)))
; arg1 = -0.000030517578125

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01110 #b0)
                arg2
                (fp #b0 #b00111 #b1)))
(assert (fp.leq (fp #b0 #b00111 #b1)
                arg2
                (fp #b0 #b11100 #b1)))
; arg2 = 0.005859375

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                expect
                (fp #b1 #b01000 #b0)))
(assert (fp.leq (fp #b1 #b01000 #b0)
                expect
                (fp #b1 #b00011 #b0)))
; expect = -0.0078125

(assert (= expect result))

(check-sat)
(exit)
