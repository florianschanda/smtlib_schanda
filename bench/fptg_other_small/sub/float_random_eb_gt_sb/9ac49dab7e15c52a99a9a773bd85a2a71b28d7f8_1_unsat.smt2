(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b111)
                arg1
                (fp #b1 #b011111 #b101)))
(assert (fp.leq (fp #b1 #b011111 #b101)
                arg1
                (fp #b0 #b011000 #b111)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011101 #b100)
                arg2
                (fp #b0 #b000000 #b110)))
(assert (fp.leq (fp #b0 #b000000 #b110)
                arg2
                (fp #b0 #b011111 #b101)))
; arg2 = 0.00000000069849193096160888671875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100001 #b100)
                expect
                (fp #b1 #b011111 #b101)))
(assert (fp.leq (fp #b1 #b011111 #b101)
                expect
                (fp #b0 #b111011 #b111)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
