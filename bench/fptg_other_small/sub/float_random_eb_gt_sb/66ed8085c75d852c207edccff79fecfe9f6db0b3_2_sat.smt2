; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b1010111 #b0011)
                arg1
                (fp #b0 #b1101100 #b0010)))
(assert (fp.leq (fp #b0 #b1101100 #b0010)
                arg1
                (fp #b0 #b1101111 #b1100)))
; arg1 = 39582418599936.0

(declare-const arg2 (_ FloatingPoint 7 5))
