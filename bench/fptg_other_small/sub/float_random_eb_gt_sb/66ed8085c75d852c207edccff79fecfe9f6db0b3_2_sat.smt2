                arg2
                (fp #b1 #b1011110 #b1111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111)
                arg2
                (fp #b1 #b1011100 #b0110)))
; arg2 = -4160749568.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111011 #b0010)
                expect
                (fp #b0 #b1101100 #b0011)))
(assert (fp.leq (fp #b0 #b1101100 #b0011)
                expect
                (fp #b0 #b1111101 #b0101)))
; expect = 41781441855488.0

(assert (= expect result))

(check-sat)
(exit)
