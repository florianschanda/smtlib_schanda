(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0110 #b11)
                arg1
                (fp #b1 #b0100 #b00)))
(assert (fp.leq (fp #b1 #b0100 #b00)
                arg1
                (fp #b0 #b0110 #b10)))
; arg1 = -0.125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0011 #b00)
                arg2
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                arg2
                (fp #b0 #b1101 #b01)))
; arg2 = 0.0078125

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b01)
                expect
                (fp #b1 #b0100 #b01)))
(assert (fp.leq (fp #b1 #b0100 #b01)
                expect
                (fp #b0 #b1111 #b00)))
; expect = -0.15625

(assert (not (= expect result)))

(check-sat)
(exit)
