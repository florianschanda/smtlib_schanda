(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111011 #b1111)
                arg1
                (fp #b1 #b011111 #b0111)))
(assert (fp.leq (fp #b1 #b011111 #b0111)
                arg1
                (fp #b1 #b001010 #b0110)))
; arg1 = -1.4375

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011100 #b1110)
                arg2
                (fp #b1 #b001101 #b1100)))
(assert (fp.leq (fp #b1 #b001101 #b1100)
                arg2
                (fp #b0 #b110010 #b0010)))
; arg2 = -0.00000667572021484375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111000 #b0000)
                expect
                (fp #b1 #b011111 #b0110)))
(assert (fp.leq (fp #b1 #b011111 #b0110)
                expect
                (fp #b1 #b011001 #b1101)))
; expect = -1.375

(assert (not (= expect result)))

(check-sat)
(exit)
