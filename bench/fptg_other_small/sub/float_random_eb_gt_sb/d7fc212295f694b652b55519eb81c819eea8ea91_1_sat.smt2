(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00011100 #b01000)
                arg1
                (fp #b0 #b10000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000101 #b00000)
                arg1
                (fp #b0 #b10010010 #b10110)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10011001 #b10111)
                arg2
                (fp #b0 #b01111111 #b00011)))
(assert (fp.leq (fp #b0 #b01111111 #b00011)
                arg2
                (fp #b0 #b11011010 #b00101)))
; arg2 = 1.09375

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00000010 #b00000)
                expect
                (fp #b0 #b10000100 #b11110)))
(assert (fp.leq (fp #b0 #b10000100 #b11110)
                expect
                (fp #b0 #b11000110 #b01100)))
; expect = 62.0

(assert (= expect result))

(check-sat)
(exit)
