                (fp #b0 #b01111111 #b000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000)
                arg1
                (fp #b0 #b11011101 #b110101)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11100001 #b010110)
                arg2
                (fp #b0 #b10111001 #b000000)))
(assert (fp.leq (fp #b0 #b10111001 #b000000)
                arg2
                (fp #b0 #b11100100 #b101111)))
; arg2 = 288230376151711744.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11010011 #b001101)
                expect
                (fp #b1 #b10111001 #b000000)))
(assert (fp.leq (fp #b1 #b10111001 #b000000)
                expect
                (fp #b1 #b01110100 #b001010)))
; expect = -288230376151711744.0

(assert (not (= expect result)))

(check-sat)
(exit)
