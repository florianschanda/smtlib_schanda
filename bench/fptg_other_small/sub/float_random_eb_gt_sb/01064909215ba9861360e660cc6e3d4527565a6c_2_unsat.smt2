(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111010 #b0011)
                arg1
                (fp #b1 #b10000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000011 #b1110)
                arg1
                (fp #b0 #b10111101 #b1000)))
; arg1 = -30.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11000011 #b0010)
                arg2
                (fp #b1 #b10000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000011 #b1110)
                arg2
                (fp #b0 #b00101010 #b1101)))
; arg2 = -30.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10010001 #b1100)
                expect
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                expect
                (fp #b0 #b11000101 #b1001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
