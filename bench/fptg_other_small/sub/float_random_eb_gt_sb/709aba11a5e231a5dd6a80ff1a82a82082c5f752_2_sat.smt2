; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg1
                (fp #b1 #b000101 #b1110)))
(assert (fp.leq (fp #b1 #b000101 #b1110)
                arg1
                (fp #b0 #b010001 #b0001)))
; arg1 = -0.00000002793967723846435546875

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b1101)
                arg2
                (fp #b1 #b000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000 #b1110)
                arg2
                (fp #b0 #b101010 #b0101)))
; arg2 = -0.000000000814907252788543701171875

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100110 #b0110)
                expect
                (fp #b1 #b000101 #b1110)))
(assert (fp.leq (fp #b1 #b000101 #b1110)
                expect
                (fp #b0 #b010010 #b0110)))
; expect = -0.00000002793967723846435546875

(assert (= expect result))

(check-sat)
(exit)
