(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000000 #b0)
                arg1
                (fp #b0 #b111101 #b0)))
(assert (fp.leq (fp #b0 #b111101 #b0)
                arg1
                (fp #b0 #b111111 #b0)))
; arg1 = 1073741824.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111101 #b1)
                arg2
                (fp #b1 #b011111 #b1)))
(assert (fp.leq (fp #b1 #b011111 #b1)
                arg2
                (fp #b1 #b001000 #b1)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b000011 #b1)
                expect
                (fp #b0 #b111101 #b1)))
(assert (fp.leq (fp #b0 #b111101 #b1)
                expect
                (fp #b0 #b111110 #b1)))
; expect = 1610612736.0

(assert (not (= expect result)))

(check-sat)
(exit)
