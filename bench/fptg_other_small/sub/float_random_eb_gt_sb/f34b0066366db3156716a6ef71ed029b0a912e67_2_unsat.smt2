(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b001)
                arg1
                (fp #b1 #b00000 #b110)))
(assert (fp.leq (fp #b1 #b00000 #b110)
                arg1
                (fp #b0 #b01001 #b100)))
; arg1 = -0.0000457763671875

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11000 #b111)
                arg2
                (fp #b1 #b11000 #b000)))
(assert (fp.leq (fp #b1 #b11000 #b000)
                arg2
                (fp #b1 #b10111 #b101)))
; arg2 = -512.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b110)
                expect
                (fp #b0 #b11000 #b000)))
(assert (fp.leq (fp #b0 #b11000 #b000)
                expect
                (fp #b0 #b11011 #b111)))
; expect = 512.0

(assert (not (= expect result)))

(check-sat)
(exit)
