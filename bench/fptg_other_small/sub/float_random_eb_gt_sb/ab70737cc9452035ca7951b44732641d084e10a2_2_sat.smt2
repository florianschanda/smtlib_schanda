; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10001111 #b01011)
                arg1
                (fp #b0 #b01101101 #b11001)))
(assert (fp.leq (fp #b0 #b01101101 #b11001)
                arg1
                (fp #b0 #b11110100 #b11010)))
; arg1 = 0.00000679492950439453125

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11101000 #b01111)
                arg2
                (fp #b1 #b00000000 #b01000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000)
                arg2
                (fp #b0 #b00011111 #b01101)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00100010 #b11101)
                expect
                (fp #b0 #b01101101 #b11010)))
(assert (fp.leq (fp #b0 #b01101101 #b11010)
                expect
                (fp #b0 #b10101001 #b00010)))
; expect = 0.0000069141387939453125

(assert (= expect result))

(check-sat)
(exit)
