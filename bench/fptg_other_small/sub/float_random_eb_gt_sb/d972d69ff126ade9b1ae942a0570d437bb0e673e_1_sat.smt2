; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111101 #b100)
                arg1
                (fp #b1 #b1101101 #b000)))
(assert (fp.leq (fp #b1 #b1101101 #b000)
                arg1
                (fp #b0 #b0100001 #b011)))
; arg1 = -70368744177664.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0011010 #b011)
                arg2
                (fp #b0 #b1111110 #b111)))
(assert (fp.leq (fp #b0 #b1111110 #b111)
                arg2
                (fp #b0 #b1111111 #b000)))
; arg2 = 17293822569102704640.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111111 #b000)
                expect
                (fp #b1 #b1111110 #b111)))
(assert (fp.leq (fp #b1 #b1111110 #b111)
                expect
                (fp #b1 #b1011010 #b010)))
; expect = -17293822569102704640.0

(assert (= expect result))

(check-sat)
(exit)
