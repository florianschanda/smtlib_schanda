; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10000101 #b1110)
                arg1
                (fp #b1 #b00000000 #b1111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111)
                arg1
                (fp #b0 #b00101101 #b1001)))
; arg1 = -0.0000000000000000000000000000000000000110202595389589453872069050364585532295499895947383205141445472463601618073880672454833984375

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
