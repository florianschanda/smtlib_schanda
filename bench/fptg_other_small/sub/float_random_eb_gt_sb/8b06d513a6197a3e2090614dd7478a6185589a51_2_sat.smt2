(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b110)
                arg1
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg1
                (fp #b0 #b110000 #b011)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110011 #b010)
                arg2
                (fp #b0 #b000000 #b111)))
(assert (fp.leq (fp #b0 #b000000 #b111)
                arg2
                (fp #b0 #b001110 #b100)))
; arg2 = 0.000000000814907252788543701171875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b011)
                expect
                (fp #b1 #b111101 #b001)))
(assert (fp.leq (fp #b1 #b111101 #b001)
                expect
                (fp #b0 #b000100 #b101)))
; expect = -1207959552.0

(assert (= expect result))

(check-sat)
(exit)
