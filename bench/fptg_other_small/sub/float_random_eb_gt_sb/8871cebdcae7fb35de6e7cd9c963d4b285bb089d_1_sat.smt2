(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010110 #b11)
                arg1
                (fp #b0 #b011111 #b11)))
(assert (fp.leq (fp #b0 #b011111 #b11)
                arg1
                (fp #b0 #b101111 #b10)))
; arg1 = 1.75

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001110 #b10)
                arg2
                (fp #b1 #b000000 #b01)))
(assert (fp.leq (fp #b1 #b000000 #b01)
                arg2
                (fp #b0 #b101001 #b11)))
; arg2 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000100 #b01)
                expect
                (fp #b0 #b011111 #b11)))
(assert (fp.leq (fp #b0 #b011111 #b11)
                expect
                (fp #b0 #b111000 #b00)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
