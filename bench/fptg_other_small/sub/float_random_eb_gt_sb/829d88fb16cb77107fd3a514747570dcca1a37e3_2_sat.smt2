(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000001 #b010)
                arg1
                (fp #b0 #b01111111 #b100)))
(assert (fp.leq (fp #b0 #b01111111 #b100)
                arg1
                (fp #b0 #b10000011 #b010)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00101001 #b111)
                arg2
                (fp #b0 #b11111101 #b000)))
(assert (fp.leq (fp #b0 #b11111101 #b000)
                arg2
                (fp #b0 #b11111110 #b111)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111110 #b101)
                expect
                (fp #b1 #b11111101 #b000)))
(assert (fp.leq (fp #b1 #b11111101 #b000)
                expect
                (fp #b0 #b11011010 #b111)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
