(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111000 #b1000)
                arg1
                (fp #b0 #b10000010 #b0000)))
(assert (fp.leq (fp #b0 #b10000010 #b0000)
                arg1
                (fp #b0 #b10011110 #b0110)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10001011 #b0100)
                arg2
                (fp #b1 #b00000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000 #b0001)
                arg2
                (fp #b0 #b10000100 #b1111)))
; arg2 = -0.0000000000000000000000000000000000000007346839692639296924804603357639035486366659729825547009429698164240107871592044830322265625

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11101000 #b0010)
                expect
                (fp #b0 #b10000010 #b0001)))
(assert (fp.leq (fp #b0 #b10000010 #b0001)
                expect
                (fp #b0 #b11001011 #b1000)))
; expect = 8.5

(assert (= expect result))

(check-sat)
(exit)
