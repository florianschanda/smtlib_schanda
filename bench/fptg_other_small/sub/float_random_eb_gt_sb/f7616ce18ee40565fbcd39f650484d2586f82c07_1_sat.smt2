(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10011011 #b00000)
                arg1
                (fp #b1 #b10000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000101 #b00000)
                arg1
                (fp #b0 #b00110110 #b00100)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111010 #b11011)
                arg2
                (fp #b1 #b10000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000101 #b00000)
                arg2
                (fp #b0 #b00001101 #b10001)))
; arg2 = -64.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00110100 #b10011)
                expect
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                expect
                (fp #b0 #b01100011 #b01100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
