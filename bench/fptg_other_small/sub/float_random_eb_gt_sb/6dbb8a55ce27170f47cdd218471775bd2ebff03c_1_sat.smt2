(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011001 #b01)
                arg1
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg1
                (fp #b0 #b100000 #b01)))
; arg1 = 0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111110 #b10)
                arg2
                (fp #b1 #b111101 #b11)))
(assert (fp.leq (fp #b1 #b111101 #b11)
                arg2
                (fp #b0 #b010101 #b10)))
; arg2 = -1879048192.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b100110 #b10)
                expect
                (fp #b0 #b111101 #b11)))
(assert (fp.leq (fp #b0 #b111101 #b11)
                expect
                (fp #b0 #b111110 #b10)))
; expect = 1879048192.0

(assert (= expect result))

(check-sat)
(exit)
