(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111011 #b10111)
                arg1
                (fp #b1 #b1000100 #b10101)))
(assert (fp.leq (fp #b1 #b1000100 #b10101)
                arg1
                (fp #b1 #b0011011 #b11000)))
; arg1 = -53.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0110001 #b01111)
                arg2
                (fp #b0 #b1100001 #b00010)))
(assert (fp.leq (fp #b0 #b1100001 #b00010)
                arg2
                (fp #b0 #b1101000 #b00100)))
; arg2 = 18253611008.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110111 #b01001)
                expect
                (fp #b1 #b1100001 #b00010)))
(assert (fp.leq (fp #b1 #b1100001 #b00010)
                expect
                (fp #b0 #b1011000 #b10010)))
; expect = -18253611008.0

(assert (= expect result))

(check-sat)
(exit)
