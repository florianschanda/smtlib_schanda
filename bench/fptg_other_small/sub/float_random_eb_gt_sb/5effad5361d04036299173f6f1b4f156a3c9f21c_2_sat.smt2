(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111000 #b01010)
                arg1
                (fp #b1 #b10000011 #b10110)))
(assert (fp.leq (fp #b1 #b10000011 #b10110)
                arg1
                (fp #b0 #b10001101 #b00101)))
; arg1 = -27.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00011001 #b11001)
                arg2
                (fp #b0 #b00000000 #b11111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111)
                arg2
                (fp #b0 #b10110101 #b10001)))
; arg2 = 0.00000000000000000000000000000000000001138760152359091023344713520434050500386832258122959786461603215457216720096766948699951171875

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10100110 #b01111)
                expect
                (fp #b1 #b10000011 #b10111)))
(assert (fp.leq (fp #b1 #b10000011 #b10111)
                expect
                (fp #b1 #b00101010 #b10011)))
; expect = -27.5

(assert (= expect result))

(check-sat)
(exit)
