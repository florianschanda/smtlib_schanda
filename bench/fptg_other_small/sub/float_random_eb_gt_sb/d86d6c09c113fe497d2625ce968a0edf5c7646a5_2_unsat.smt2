(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00100 #b110)
                arg1
                (fp #b0 #b10110 #b111)))
(assert (fp.leq (fp #b0 #b10110 #b111)
                arg1
                (fp #b0 #b11001 #b001)))
; arg1 = 240.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10011 #b011)
                arg2
                (fp #b1 #b10010 #b100)))
(assert (fp.leq (fp #b1 #b10010 #b100)
                arg2
                (fp #b0 #b00011 #b110)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01011 #b100)
                expect
                (fp #b0 #b10111 #b000)))
(assert (fp.leq (fp #b0 #b10111 #b000)
                expect
                (fp #b0 #b11001 #b001)))
; expect = 256.0

(assert (not (= expect result)))

(check-sat)
(exit)
