                arg2
                (fp #b0 #b1111000 #b1)))
(assert (fp.leq (fp #b0 #b1111000 #b1)
                arg2
                (fp #b0 #b1111101 #b0)))
; arg2 = 216172782113783808.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1111000 #b1)
                expect
                (fp #b1 #b1111000 #b0)))
(assert (fp.leq (fp #b1 #b1111000 #b0)
                expect
                (fp #b0 #b1111010 #b1)))
; expect = -144115188075855872.0

(assert (not (= expect result)))

(check-sat)
(exit)
