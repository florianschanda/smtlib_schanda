;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b0 #b0111011 #b1)
                arg1
                (fp #b0 #b1011010 #b1)))
