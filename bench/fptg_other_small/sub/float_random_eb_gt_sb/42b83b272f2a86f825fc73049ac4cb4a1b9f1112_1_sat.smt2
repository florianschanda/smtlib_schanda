(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0111101 #b1110)
                arg1
                (fp #b0 #b1100101 #b0100)))
(assert (fp.leq (fp #b0 #b1100101 #b0100)
                arg1
                (fp #b0 #b1110101 #b0100)))
; arg1 = 343597383680.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100001 #b1111)
                expect
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                expect
                (fp #b0 #b1000010 #b1101)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
