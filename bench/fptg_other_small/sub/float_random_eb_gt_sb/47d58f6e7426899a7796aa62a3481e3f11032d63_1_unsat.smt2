(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b010100 #b1)
                arg1
                (fp #b0 #b100001 #b0)))
(assert (fp.leq (fp #b0 #b100001 #b0)
                arg1
                (fp #b0 #b110110 #b0)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b000000 #b0)
                arg2
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                arg2
                (fp #b0 #b011011 #b1)))
; arg2 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b001000 #b0)
                expect
                (fp #b0 #b100000 #b1)))
(assert (fp.leq (fp #b0 #b100000 #b1)
                expect
                (fp #b0 #b111110 #b1)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
