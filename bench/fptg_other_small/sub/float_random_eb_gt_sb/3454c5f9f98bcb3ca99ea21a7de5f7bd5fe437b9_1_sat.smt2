(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg1
                (fp #b1 #b01111 #b1)))
(assert (fp.leq (fp #b1 #b01111 #b1)
                arg1
                (fp #b0 #b00101 #b0)))
; arg1 = -1.5

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01000 #b1)
                arg2
                (fp #b0 #b10011 #b1)))
(assert (fp.leq (fp #b0 #b10011 #b1)
                arg2
                (fp #b0 #b10110 #b1)))
; arg2 = 24.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                expect
                (fp #b1 #b10011 #b1)))
(assert (fp.leq (fp #b1 #b10011 #b1)
                expect
                (fp #b1 #b01100 #b1)))
; expect = -24.0

(assert (= expect result))

(check-sat)
(exit)
