(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110110 #b1001)
                arg1
                (fp #b0 #b010000 #b0000)))
(assert (fp.leq (fp #b0 #b010000 #b0000)
                arg1
                (fp #b0 #b100000 #b1110)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b0100)
                arg2
                (fp #b1 #b011111 #b0000)))
(assert (fp.leq (fp #b1 #b011111 #b0000)
                arg2
                (fp #b0 #b000100 #b0110)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100110 #b1001)
                expect
                (fp #b0 #b011111 #b0001)))
(assert (fp.leq (fp #b0 #b011111 #b0001)
                expect
                (fp #b0 #b101110 #b0111)))
; expect = 1.0625

(assert (= expect result))

(check-sat)
(exit)
