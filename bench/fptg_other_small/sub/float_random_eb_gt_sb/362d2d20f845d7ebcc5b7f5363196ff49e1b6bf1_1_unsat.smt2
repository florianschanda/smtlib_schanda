(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0001011 #b11010)
                arg1
                (fp #b0 #b0110000 #b01100)))
(assert (fp.leq (fp #b0 #b0110000 #b01100)
                arg1
                (fp #b0 #b1100011 #b11101)))
; arg1 = 0.000041961669921875

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110001 #b11000)
                arg2
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg2
                (fp #b0 #b1110100 #b00001)))
; arg2 = -64.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001000 #b11111)
                expect
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                expect
                (fp #b0 #b1111001 #b01111)))
; expect = 64.0

(assert (not (= expect result)))

(check-sat)
(exit)
