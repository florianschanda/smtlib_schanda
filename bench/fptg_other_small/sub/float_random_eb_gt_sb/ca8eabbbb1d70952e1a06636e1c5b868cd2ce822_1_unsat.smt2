(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg1
                (fp #b0 #b0001 #b11)))
(assert (fp.leq (fp #b0 #b0001 #b11)
                arg1
                (fp #b0 #b1001 #b00)))
; arg1 = 0.02734375

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1000 #b11)
                arg2
                (fp #b1 #b1000 #b10)))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg2
                (fp #b0 #b0111 #b11)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                expect
                (fp #b0 #b1000 #b10)))
(assert (fp.leq (fp #b0 #b1000 #b10)
                expect
                (fp #b0 #b1001 #b00)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
