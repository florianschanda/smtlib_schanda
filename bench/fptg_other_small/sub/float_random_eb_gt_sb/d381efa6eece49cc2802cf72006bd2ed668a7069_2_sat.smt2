(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00110 #b01)
                arg1
                (fp #b0 #b01111 #b11)))
(assert (fp.leq (fp #b0 #b01111 #b11)
                arg1
                (fp #b0 #b11011 #b10)))
; arg1 = 1.75

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00110 #b01)
                arg2
                (fp #b0 #b01001 #b01)))
(assert (fp.leq (fp #b0 #b01001 #b01)
                arg2
                (fp #b0 #b11101 #b01)))
; arg2 = 0.01953125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b10)
                expect
                (fp #b0 #b01111 #b11)))
(assert (fp.leq (fp #b0 #b01111 #b11)
                expect
                (fp #b0 #b10000 #b10)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
