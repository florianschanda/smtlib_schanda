; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0110011 #b0010)
                arg1
                (fp #b0 #b0000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000 #b0100)
                arg1
                (fp #b0 #b1011101 #b1100)))
; arg1 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011101 #b1111)
                arg2
                (fp #b0 #b1000011 #b0001)))
(assert (fp.leq (fp #b0 #b1000011 #b0001)
                arg2
                (fp #b0 #b1101100 #b0010)))
; arg2 = 17.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011100 #b1100)
                expect
                (fp #b1 #b1000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000011 #b0001)
                expect
                (fp #b1 #b0101110 #b0010)))
; expect = -17.0

(assert (= expect result))

(check-sat)
(exit)
