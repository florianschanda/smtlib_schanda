(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b01111111 #b1)
                arg1
                (fp #b0 #b10110100 #b0)))
(assert (fp.leq (fp #b0 #b10110100 #b0)
                arg1
                (fp #b0 #b11000101 #b0)))
; arg1 = 9007199254740992.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00011010 #b1)
                arg2
                (fp #b1 #b00000001 #b0)))
(assert (fp.leq (fp #b1 #b00000001 #b0)
                arg2
                (fp #b0 #b10011100 #b0)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11101010 #b0)
                expect
                (fp #b0 #b10110100 #b0)))
(assert (fp.leq (fp #b0 #b10110100 #b0)
                expect
                (fp #b0 #b11110110 #b1)))
; expect = 9007199254740992.0

(assert (not (= expect result)))

(check-sat)
(exit)
