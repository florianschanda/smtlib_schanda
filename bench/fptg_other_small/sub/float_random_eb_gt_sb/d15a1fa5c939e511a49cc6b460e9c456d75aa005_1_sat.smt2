; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0010110 #b01)
                arg1
                (fp #b1 #b0000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000 #b01)
                arg1
                (fp #b0 #b1000110 #b10)))
; arg1 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010101 #b10)
                arg2
                (fp #b1 #b1000001 #b10)))
(assert (fp.leq (fp #b1 #b1000001 #b10)
                arg2
                (fp #b1 #b0011111 #b01)))
; arg2 = -6.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0010011 #b00)
                expect
                (fp #b0 #b1000001 #b01)))
(assert (fp.leq (fp #b0 #b1000001 #b01)
                expect
                (fp #b0 #b1011000 #b11)))
; expect = 5.0

(assert (= expect result))

(check-sat)
(exit)
