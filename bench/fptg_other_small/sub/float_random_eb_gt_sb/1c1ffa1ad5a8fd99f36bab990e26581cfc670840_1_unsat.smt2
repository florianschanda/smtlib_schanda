(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10101111 #b000)
                arg1
                (fp #b1 #b01111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111 #b000)
                arg1
                (fp #b0 #b11111011 #b100)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110100 #b011)
                arg2
                (fp #b1 #b00000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000 #b010)
                arg2
                (fp #b0 #b11011011 #b110)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10001101 #b110)
                expect
                (fp #b1 #b01111110 #b111)))
(assert (fp.leq (fp #b1 #b01111110 #b111)
                expect
                (fp #b0 #b00011111 #b111)))
; expect = -0.9375

(assert (not (= expect result)))

(check-sat)
(exit)
