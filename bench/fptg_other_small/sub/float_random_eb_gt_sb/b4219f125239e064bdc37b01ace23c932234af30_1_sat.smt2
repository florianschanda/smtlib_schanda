(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11001001 #b0011)
                arg1
                (fp #b0 #b00000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111)
                arg1
                (fp #b0 #b11110100 #b1101)))
; arg1 = 0.0000000000000000000000000000000000000110202595389589453872069050364585532295499895947383205141445472463601618073880672454833984375

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10101010 #b0010)
                arg2
                (fp #b1 #b10001000 #b0100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100)
                arg2
                (fp #b0 #b00011111 #b1001)))
; arg2 = -640.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00101111 #b1110)
                expect
                (fp #b0 #b10001000 #b0100)))
(assert (fp.leq (fp #b0 #b10001000 #b0100)
                expect
                (fp #b0 #b11110100 #b0110)))
; expect = 640.0

(assert (= expect result))

(check-sat)
(exit)
