; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00001011 #b100011)
                arg1
                (fp #b0 #b10000111 #b101110)))
(assert (fp.leq (fp #b0 #b10000111 #b101110)
                arg1
                (fp #b0 #b10101011 #b000010)))
; arg1 = 440.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10001110 #b110101)
                arg2
                (fp #b0 #b10100101 #b111111)))
(assert (fp.leq (fp #b0 #b10100101 #b111111)
                arg2
                (fp #b0 #b11000101 #b111101)))
; arg2 = 545460846592.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11100001 #b100101)
                expect
                (fp #b1 #b10100101 #b111111)))
(assert (fp.leq (fp #b1 #b10100101 #b111111)
                expect
                (fp #b0 #b01100011 #b110100)))
; expect = -545460846592.0

(assert (not (= expect result)))

(check-sat)
(exit)
