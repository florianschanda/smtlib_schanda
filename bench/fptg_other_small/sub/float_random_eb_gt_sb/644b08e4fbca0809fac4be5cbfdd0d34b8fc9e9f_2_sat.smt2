(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b100000 #b0001)
                arg1
                (fp #b0 #b111010 #b0111)))
(assert (fp.leq (fp #b0 #b111010 #b0111)
                arg1
                (fp #b0 #b111100 #b0001)))
; arg1 = 192937984.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b1001)
                arg2
                (fp #b1 #b000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000 #b1111)
                arg2
                (fp #b0 #b001000 #b0001)))
; arg2 = -0.0000000008731149137020111083984375

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111001 #b1001)
                expect
                (fp #b0 #b111010 #b1000)))
(assert (fp.leq (fp #b0 #b111010 #b1000)
                expect
                (fp #b0 #b111101 #b1011)))
; expect = 201326592.0

(assert (= expect result))

(check-sat)
(exit)
