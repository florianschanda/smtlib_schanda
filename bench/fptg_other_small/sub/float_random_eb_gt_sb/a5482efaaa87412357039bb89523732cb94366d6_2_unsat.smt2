(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010011 #b011)
                arg1
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg1
                (fp #b0 #b100111 #b111)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010101 #b111)
                arg2
                (fp #b1 #b010000 #b000)))
(assert (fp.leq (fp #b1 #b010000 #b000)
                arg2
                (fp #b1 #b000111 #b100)))
; arg2 = -0.000030517578125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010011 #b111)
                expect
                (fp #b0 #b100011 #b001)))
(assert (fp.leq (fp #b0 #b100011 #b001)
                expect
                (fp #b0 #b101000 #b011)))
; expect = 18.0

(assert (not (= expect result)))

(check-sat)
(exit)
