                expect
                (fp #b1 #b0111110 #b1111)))
(assert (fp.leq (fp #b1 #b0111110 #b1111)
                expect
                (fp #b0 #b1000000 #b1011)))
; expect = -0.96875

(assert (not (= expect result)))

