(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111010 #b0101)
                arg1
                (fp #b0 #b0100000 #b0000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000)
                arg1
                (fp #b0 #b1001010 #b0011)))
; arg1 = 0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111111 #b0000)
                arg2
                (fp #b1 #b1111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111)
                arg2
                (fp #b0 #b1101100 #b1111)))
; arg2 = -17870283321406128128.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
