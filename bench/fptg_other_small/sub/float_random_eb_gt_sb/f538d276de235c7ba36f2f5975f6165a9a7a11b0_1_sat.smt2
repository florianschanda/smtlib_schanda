(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b010110 #b0)
                arg1
                (fp #b0 #b010000 #b0)))
(assert (fp.leq (fp #b0 #b010000 #b0)
                arg1
                (fp #b0 #b111110 #b0)))
; arg1 = 0.000030517578125

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111001 #b0)
                arg2
                (fp #b1 #b100011 #b1)))
(assert (fp.leq (fp #b1 #b100011 #b1)
                arg2
                (fp #b1 #b000011 #b1)))
; arg2 = -24.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b011001 #b0)
                expect
                (fp #b0 #b100011 #b1)))
(assert (fp.leq (fp #b0 #b100011 #b1)
                expect
                (fp #b0 #b100111 #b0)))
; expect = 24.0

(assert (= expect result))

(check-sat)
(exit)
