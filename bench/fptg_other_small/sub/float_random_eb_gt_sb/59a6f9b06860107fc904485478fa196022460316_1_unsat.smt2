(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01111110 #b010110)
                arg1
                (fp #b0 #b00000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000)
                arg1
                (fp #b0 #b11110100 #b111001)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01011100 #b101000)
                arg2
                (fp #b0 #b10000001 #b100000)))
(assert (fp.leq (fp #b0 #b10000001 #b100000)
                arg2
                (fp #b0 #b10111110 #b111011)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11000101 #b110010)
                expect
                (fp #b1 #b10000001 #b100000)))
(assert (fp.leq (fp #b1 #b10000001 #b100000)
                expect
                (fp #b0 #b11010100 #b011111)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
