(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10100100 #b010)
                arg1
                (fp #b1 #b10001110 #b011)))
(assert (fp.leq (fp #b1 #b10001110 #b011)
                arg1
                (fp #b1 #b01000011 #b001)))
; arg1 = -45056.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010111 #b011)
                arg2
                (fp #b1 #b01000000 #b000)))
(assert (fp.leq (fp #b1 #b01000000 #b000)
                arg2
                (fp #b0 #b11010001 #b001)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10010000 #b000)
                expect
                (fp #b1 #b10001110 #b010)))
(assert (fp.leq (fp #b1 #b10001110 #b010)
                expect
                (fp #b0 #b01001010 #b011)))
; expect = -40960.0

(assert (= expect result))

(check-sat)
(exit)
