(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110101 #b110)
                arg1
                (fp #b0 #b001110 #b011)))
(assert (fp.leq (fp #b0 #b001110 #b011)
                arg1
                (fp #b0 #b101000 #b000)))
; arg1 = 0.00001049041748046875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b010011 #b110)
                arg2
                (fp #b0 #b111101 #b000)))
(assert (fp.leq (fp #b0 #b111101 #b000)
                arg2
                (fp #b0 #b111111 #b000)))
; arg2 = 1073741824.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b101)
                expect
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                expect
                (fp #b1 #b111001 #b000)))
; expect = -1073741824.0

(assert (= expect result))

(check-sat)
(exit)
