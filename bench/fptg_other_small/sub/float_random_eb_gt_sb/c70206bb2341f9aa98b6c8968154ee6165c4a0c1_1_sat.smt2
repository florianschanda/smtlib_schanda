(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00000010 #b001)
                arg1
                (fp #b0 #b11001011 #b000)))
(assert (fp.leq (fp #b0 #b11001011 #b000)
                arg1
                (fp #b0 #b11111110 #b011)))
; arg1 = 75557863725914323419136.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00010110 #b011)
                arg2
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg2
                (fp #b0 #b11000010 #b001)))
; arg2 = 16.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00101001 #b100)
                expect
                (fp #b0 #b11001010 #b111)))
(assert (fp.leq (fp #b0 #b11001010 #b111)
                expect
                (fp #b0 #b11001111 #b001)))
; expect = 70835497243044678205440.0

(assert (= expect result))

(check-sat)
(exit)
