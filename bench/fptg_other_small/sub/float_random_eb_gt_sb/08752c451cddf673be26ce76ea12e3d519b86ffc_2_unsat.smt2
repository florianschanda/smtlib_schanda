; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00001 #b010)
                arg1
                (fp #b1 #b00000 #b110)))
(assert (fp.leq (fp #b1 #b00000 #b110)
                arg1
                (fp #b0 #b10000 #b100)))
; arg1 = -0.0000457763671875

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b111)
                arg2
                (fp #b0 #b01111 #b101)))
(assert (fp.leq (fp #b0 #b01111 #b101)
                arg2
                (fp #b0 #b11011 #b000)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10011 #b011)
                expect
                (fp #b1 #b01111 #b110)))
(assert (fp.leq (fp #b1 #b01111 #b110)
                expect
                (fp #b0 #b10000 #b100)))
; expect = -1.75

(assert (not (= expect result)))

(check-sat)
(exit)
