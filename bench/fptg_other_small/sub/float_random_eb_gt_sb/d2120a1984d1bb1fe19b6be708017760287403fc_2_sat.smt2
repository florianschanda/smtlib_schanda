(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00100101 #b11)
                expect
                (fp #b0 #b11001010 #b10)))
(assert (fp.leq (fp #b0 #b11001010 #b10)
                expect
