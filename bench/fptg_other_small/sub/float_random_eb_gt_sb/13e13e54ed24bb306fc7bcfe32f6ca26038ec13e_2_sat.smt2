(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00110001 #b1)
                arg1
                (fp #b0 #b10000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000 #b1)
                arg1
                (fp #b0 #b11001110 #b0)))
; arg1 = 3.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00100101 #b0)
                arg2
                (fp #b0 #b00000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000 #b1)
                arg2
                (fp #b0 #b01101001 #b0)))
; arg2 = 0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00000011 #b1)
                expect
                (fp #b0 #b10000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000 #b1)
                expect
                (fp #b0 #b11000111 #b1)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
