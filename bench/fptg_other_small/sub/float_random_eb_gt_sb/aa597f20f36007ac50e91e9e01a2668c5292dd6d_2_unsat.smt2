(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11110001 #b1010)
                arg1
                (fp #b1 #b10011110 #b1000)))
(assert (fp.leq (fp #b1 #b10011110 #b1000)
                arg1
                (fp #b0 #b11110000 #b1000)))
; arg1 = -3221225472.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00000101 #b0001)
                arg2
                (fp #b1 #b00000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000 #b0100)
                arg2
                (fp #b0 #b00000110 #b1010)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11100000 #b1110)
                expect
                (fp #b1 #b10011110 #b1000)))
(assert (fp.leq (fp #b1 #b10011110 #b1000)
                expect
                (fp #b1 #b10010100 #b1011)))
; expect = -3221225472.0

(assert (not (= expect result)))

(check-sat)
(exit)
