(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11011 #b10)
                arg1
                (fp #b0 #b00111 #b00)))
(assert (fp.leq (fp #b0 #b00111 #b00)
                arg1
                (fp #b0 #b01111 #b00)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b01011 #b10)
                arg2
                (fp #b0 #b11101 #b10)))
(assert (fp.leq (fp #b0 #b11101 #b10)
                arg2
                (fp #b0 #b11110 #b11)))
; arg2 = 24576.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b01)
                expect
                (fp #b1 #b11101 #b10)))
(assert (fp.leq (fp #b1 #b11101 #b10)
                expect
                (fp #b1 #b10111 #b01)))
; expect = -24576.0

(assert (not (= expect result)))

(check-sat)
(exit)
