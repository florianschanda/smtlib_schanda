(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg1
                (fp #b1 #b11011 #b10)))
(assert (fp.leq (fp #b1 #b11011 #b10)
                arg1
                (fp #b0 #b00111 #b11)))
; arg1 = -6144.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00010 #b01)
                arg2
                (fp #b1 #b00000 #b01)))
(assert (fp.leq (fp #b1 #b00000 #b01)
                arg2
                (fp #b0 #b11010 #b01)))
; arg2 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11100 #b00)
                expect
                (fp #b1 #b11011 #b01)))
(assert (fp.leq (fp #b1 #b11011 #b01)
                expect
                (fp #b0 #b10010 #b10)))
; expect = -5120.0

(assert (= expect result))

(check-sat)
(exit)
