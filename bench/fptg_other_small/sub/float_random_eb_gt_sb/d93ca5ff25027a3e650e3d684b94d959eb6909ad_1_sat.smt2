(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b0 #b0100011 #b0)
                arg1
                (fp #b0 #b0111101 #b1)))
(assert (fp.leq (fp #b0 #b0111101 #b1)
                arg1
                (fp #b0 #b1110110 #b1)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1111101 #b1)
                arg2
                (fp #b1 #b1111101 #b0)))
(assert (fp.leq (fp #b1 #b1111101 #b0)
                arg2
                (fp #b0 #b1000101 #b1)))
; arg2 = -4611686018427387904.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1100011 #b1)
                expect
                (fp #b0 #b1111101 #b0)))
(assert (fp.leq (fp #b0 #b1111101 #b0)
                expect
                (fp #b0 #b1111110 #b0)))
; expect = 4611686018427387904.0

(assert (= expect result))

(check-sat)
(exit)
