; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11110000 #b011101)
                arg1
                (fp #b1 #b10101011 #b101011)))
(assert (fp.leq (fp #b1 #b10101011 #b101011)
                arg1
                (fp #b1 #b10010001 #b001000)))
; arg1 = -29411936043008.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111111 #b000000)
                arg2
                (fp #b1 #b11111110 #b111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111)
                arg2
                (fp #b1 #b11000001 #b111101)))
; arg2 = -337623910929368631717566993311207522304.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b11100011 #b011000)
                expect
                (fp #b0 #b11111110 #b111110)))
(assert (fp.leq (fp #b0 #b11111110 #b111110)
                expect
                (fp #b0 #b11111110 #b111111)))
; expect = 334965454937798799971759379190646833152.0

(assert (= expect result))

(check-sat)
(exit)
