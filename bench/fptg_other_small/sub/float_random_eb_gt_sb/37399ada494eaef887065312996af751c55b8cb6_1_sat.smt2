; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00000011 #b001111)
                arg1
                (fp #b0 #b00000011 #b111010)))
(assert (fp.leq (fp #b0 #b00000011 #b111010)
                arg1
                (fp #b0 #b10101101 #b011010)))
; arg1 = 0.000000000000000000000000000000000000089631444250199422482616160963196232933673248703871673515042317603729316033422946929931640625

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11001011 #b001001)
                arg2
                (fp #b0 #b10100101 #b111111)))
(assert (fp.leq (fp #b0 #b10100101 #b111111)
                arg2
                (fp #b0 #b11000010 #b110111)))
; arg2 = 545460846592.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11001000 #b011100)
                expect
                (fp #b1 #b10100101 #b111110)))
(assert (fp.leq (fp #b1 #b10100101 #b111110)
                expect
                (fp #b0 #b10111010 #b000010)))
; expect = -541165879296.0

(assert (= expect result))

(check-sat)
(exit)
