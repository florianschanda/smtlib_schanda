; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001111 #b01)
                arg1
                (fp #b1 #b001111 #b00)))
(assert (fp.leq (fp #b1 #b001111 #b00)
                arg1
                (fp #b0 #b100010 #b00)))
; arg1 = -0.0000152587890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111000 #b10)
                arg2
                (fp #b0 #b000000 #b11)))
(assert (fp.leq (fp #b0 #b000000 #b11)
                arg2
                (fp #b0 #b011110 #b00)))
; arg2 = 0.00000000069849193096160888671875

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011000 #b10)
                expect
                (fp #b1 #b001111 #b01)))
(assert (fp.leq (fp #b1 #b001111 #b01)
                expect
                (fp #b0 #b101011 #b11)))
; expect = -0.000019073486328125

(assert (= expect result))

(check-sat)
(exit)
