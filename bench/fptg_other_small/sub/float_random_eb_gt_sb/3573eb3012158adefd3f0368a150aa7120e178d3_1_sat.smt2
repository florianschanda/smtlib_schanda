; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001100 #b11001)
                arg1
                (fp #b0 #b0111111 #b10111)))
(assert (fp.leq (fp #b0 #b0111111 #b10111)
                arg1
                (fp #b0 #b1111100 #b01111)))
; arg1 = 1.71875

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001101 #b01110)
                arg2
                (fp #b0 #b0000000 #b10101)))
(assert (fp.leq (fp #b0 #b0000000 #b10101)
                arg2
                (fp #b0 #b1010000 #b01111)))
; arg2 = 0.0000000000000000001423015351387224569634781801141798496246337890625

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001000 #b00110)
                expect
                (fp #b0 #b0111111 #b10110)))
(assert (fp.leq (fp #b0 #b0111111 #b10110)
                expect
                (fp #b0 #b1011110 #b11001)))
; expect = 1.6875

(assert (= expect result))

(check-sat)
(exit)
