(assert (fp.leq (fp #b1 #b0111110 #b001)
                arg2
                (fp #b0 #b0000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000 #b001)
                arg2
                (fp #b0 #b1000011 #b101)))
; arg2 = 0.00000000000000000002710505431213761085018632002174854278564453125

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0110010 #b101)
                expect
                (fp #b0 #b0111111 #b011)))
(assert (fp.leq (fp #b0 #b0111111 #b011)
                expect
                (fp #b0 #b1101101 #b101)))
; expect = 1.375

(assert (not (= expect result)))

(check-sat)
(exit)
