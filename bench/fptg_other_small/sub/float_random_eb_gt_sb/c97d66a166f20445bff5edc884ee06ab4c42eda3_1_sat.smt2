(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0111 #b10)
                arg1
                (fp #b1 #b0100 #b00)))
(assert (fp.leq (fp #b1 #b0100 #b00)
                arg1
                (fp #b0 #b0110 #b11)))
; arg1 = -0.125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0001 #b10)
                arg2
                (fp #b1 #b0000 #b10)))
(assert (fp.leq (fp #b1 #b0000 #b10)
                arg2
                (fp #b0 #b0111 #b10)))
; arg2 = -0.0078125

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0111 #b01)
                expect
                (fp #b1 #b0011 #b11)))
(assert (fp.leq (fp #b1 #b0011 #b11)
                expect
                (fp #b0 #b1101 #b11)))
; expect = -0.109375

(assert (= expect result))

(check-sat)
(exit)
