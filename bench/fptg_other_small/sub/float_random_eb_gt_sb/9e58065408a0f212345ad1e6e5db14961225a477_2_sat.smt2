; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101101 #b0010)
                arg1
                (fp #b1 #b1100011 #b0100)))
(assert (fp.leq (fp #b1 #b1100011 #b0100)
                arg1
                (fp #b1 #b1000111 #b0100)))
; arg1 = -85899345920.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0110000 #b0101)
                arg2
                (fp #b0 #b1000110 #b1110)))
(assert (fp.leq (fp #b0 #b1000110 #b1110)
                arg2
                (fp #b0 #b1101110 #b0101)))
; arg2 = 240.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110100 #b1000)
                expect
                (fp #b1 #b1100011 #b0101)))
(assert (fp.leq (fp #b1 #b1100011 #b0101)
                expect
                (fp #b1 #b0010000 #b0110)))
; expect = -90194313216.0

(assert (= expect result))

(check-sat)
(exit)
