(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b011001 #b101)
                arg1
                (fp #b0 #b100010 #b000)))
(assert (fp.leq (fp #b0 #b100010 #b000)
                arg1
                (fp #b0 #b110010 #b110)))
; arg1 = 8.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b010000 #b011)
                arg2
                (fp #b0 #b000000 #b000)))
(assert (fp.leq (fp #b0 #b000000 #b000)
                arg2
                (fp #b0 #b010101 #b110)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b101)
                expect
                (fp #b0 #b100010 #b000)))
(assert (fp.leq (fp #b0 #b100010 #b000)
                expect
                (fp #b0 #b100110 #b111)))
; expect = 8.0

(assert (not (= expect result)))

(check-sat)
(exit)
