(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg1
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b0)))
; arg1 = -2.0

(declare-const arg2 (_ FloatingPoint 2 2))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg3
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg3
                (fp #b0 #b01 #b1)))
; arg3 = -0.5

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
