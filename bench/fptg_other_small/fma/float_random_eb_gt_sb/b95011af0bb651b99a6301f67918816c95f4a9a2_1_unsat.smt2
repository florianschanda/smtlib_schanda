(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111001 #b0100)
                arg1
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg1
                (fp #b0 #b011001 #b0010)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101000 #b0001)
                arg2
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg2
                (fp #b0 #b100101 #b1011)))
; arg2 = -32.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100110 #b1000)
                arg3
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                arg3
                (fp #b0 #b001011 #b1010)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b101000 #b1100)
                expect
                (fp #b0 #b101001 #b0000)))
(assert (fp.leq (fp #b0 #b101001 #b0000)
                expect
                (fp #b0 #b110010 #b0101)))
; expect = 1024.0

(assert (not (= expect result)))

(check-sat)
(exit)
