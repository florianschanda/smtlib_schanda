;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b000010 #b1)
                arg1
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                arg1
                (fp #b0 #b011111 #b0)))
