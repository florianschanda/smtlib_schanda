                arg2
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                arg2
                (fp #b0 #b100010 #b0)))
; arg2 = 0.0000000004656612873077392578125

(declare-const arg3 (_ FloatingPoint 6 2))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b000010 #b1)
                arg3
                (fp #b0 #b000000 #b0)))
(assert (fp.leq (fp #b0 #b000000 #b0)
                arg3
                (fp #b0 #b001011 #b0)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000000 #b0)
                expect
                (fp #b0 #b000000 #b0)))
(assert (fp.leq (fp #b0 #b000000 #b0)
                expect
                (fp #b0 #b001000 #b1)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
