(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00000001 #b000)
                arg1
                (fp #b0 #b00000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000 #b000)
                arg1
                (fp #b0 #b00111010 #b101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110011 #b011)
                arg2
                (fp #b1 #b10000011 #b000)))
(assert (fp.leq (fp #b1 #b10000011 #b000)
                arg2
                (fp #b0 #b01100100 #b000)))
; arg2 = -16.0

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
