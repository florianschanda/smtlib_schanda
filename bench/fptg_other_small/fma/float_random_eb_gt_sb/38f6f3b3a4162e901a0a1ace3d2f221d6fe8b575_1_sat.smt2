(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0100101 #b0100)
                arg1
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg1
                (fp #b0 #b0101000 #b1011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0101111 #b0000)
                arg2
                (fp #b0 #b1111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000)
                arg2
                (fp #b0 #b1111110 #b0100)))
; arg2 = 4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0101000 #b0001)
                arg3
                (fp #b0 #b0111110 #b1000)))
(assert (fp.leq (fp #b0 #b0111110 #b1000)
                arg3
                (fp #b0 #b1001001 #b1111)))
; arg3 = 0.75

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101110 #b0001)
                expect
                (fp #b0 #b0111110 #b1000)))
(assert (fp.leq (fp #b0 #b0111110 #b1000)
                expect
                (fp #b0 #b1110010 #b1001)))
; expect = 0.75

(assert (= expect result))

(check-sat)
(exit)
