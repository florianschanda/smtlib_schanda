; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101100 #b01111)
                arg1
                (fp #b1 #b1001110 #b01011)))
(assert (fp.leq (fp #b1 #b1001110 #b01011)
                arg1
                (fp #b1 #b0111001 #b00100)))
; arg1 = -44032.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1011101 #b11110)
                arg3
                (fp #b1 #b0110101 #b10000)))
(assert (fp.leq (fp #b1 #b0110101 #b10000)
                arg3
                (fp #b0 #b1010010 #b00110)))
; arg3 = -0.00146484375

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111010 #b01010)
                expect
                (fp #b1 #b1011101 #b11010)))
(assert (fp.leq (fp #b1 #b1011101 #b11010)
                expect
                (fp #b1 #b0001101 #b10110)))
; expect = -1946157056.0

(assert (= expect result))

(check-sat)
(exit)
