(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110001 #b01)
                arg1
                (fp #b0 #b100001 #b10)))
(assert (fp.leq (fp #b0 #b100001 #b10)
                arg1
                (fp #b0 #b110100 #b11)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b101110 #b10)
                arg3
                (fp #b0 #b110101 #b01)))
(assert (fp.leq (fp #b0 #b110101 #b01)
                arg3
                (fp #b0 #b111000 #b00)))
; arg3 = 5242880.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b011011 #b00)
                expect
                (fp #b0 #b110101 #b01)))
(assert (fp.leq (fp #b0 #b110101 #b01)
                expect
                (fp #b0 #b110111 #b10)))
; expect = 5242880.0

(assert (not (= expect result)))

(check-sat)
(exit)
