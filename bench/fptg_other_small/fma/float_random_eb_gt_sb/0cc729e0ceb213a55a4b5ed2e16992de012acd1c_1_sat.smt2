(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011101 #b00)
                arg1
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                arg1
                (fp #b0 #b100011 #b00)))
; arg1 = -0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b00)
                arg2
                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg2
                (fp #b0 #b110110 #b11)))
; arg2 = 0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110110 #b10)
                arg3
                (fp #b0 #b100010 #b00)))
(assert (fp.leq (fp #b0 #b100010 #b00)
                arg3
                (fp #b0 #b111100 #b11)))
; arg3 = 8.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000000 #b11)
                expect
                (fp #b0 #b100001 #b11)))
(assert (fp.leq (fp #b0 #b100001 #b11)
                expect
                (fp #b0 #b100101 #b00)))
; expect = 7.0

(assert (= expect result))

(check-sat)
(exit)
