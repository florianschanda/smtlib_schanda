(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10010 #b010)
                arg1
                (fp #b0 #b01101 #b001)))
(assert (fp.leq (fp #b0 #b01101 #b001)
                arg1
                (fp #b0 #b10101 #b110)))
; arg1 = 0.28125

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10011 #b111)
                arg2
                (fp #b0 #b10011 #b000)))
(assert (fp.leq (fp #b0 #b10011 #b000)
                arg2
                (fp #b0 #b10101 #b111)))
; arg2 = 16.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b111)
                arg3
                (fp #b0 #b00000 #b101)))
(assert (fp.leq (fp #b0 #b00000 #b101)
                arg3
                (fp #b0 #b11100 #b011)))
; arg3 = 0.00003814697265625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00010 #b111)
                expect
                (fp #b0 #b10001 #b001)))
(assert (fp.leq (fp #b0 #b10001 #b001)
                expect
                (fp #b0 #b11110 #b111)))
; expect = 4.5

(assert (= expect result))

(check-sat)
(exit)
