(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0000011 #b00101)
                arg1
                (fp #b1 #b0000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000 #b00000)
                arg1
                (fp #b0 #b1111010 #b11001)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b1001011 #b00000)
                arg2
                (fp #b0 #b1111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111101 #b00000)
                arg2
                (fp #b0 #b1111110 #b00100)))
; arg2 = 4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001101 #b01110)
                arg3
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                arg3
                (fp #b0 #b1010111 #b00111)))
; arg3 = 64.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0111000 #b11100)
                expect
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                expect
                (fp #b0 #b1110110 #b01001)))
; expect = 64.0

(assert (not (= expect result)))

(check-sat)
(exit)
