(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010101 #b10)
                arg1
                (fp #b1 #b001111 #b10)))
(assert (fp.leq (fp #b1 #b001111 #b10)
                arg1
                (fp #b0 #b001000 #b01)))
; arg1 = -0.00002288818359375

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111110 #b10)
                arg2
                (fp #b1 #b111010 #b11)))
(assert (fp.leq (fp #b1 #b111010 #b11)
                arg2
                (fp #b0 #b110001 #b11)))
; arg2 = -234881024.0

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001000 #b01)
                arg3
                (fp #b0 #b110101 #b01)))
(assert (fp.leq (fp #b0 #b110101 #b01)
                arg3
                (fp #b0 #b111010 #b11)))
; arg3 = 5242880.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011100 #b11)
                expect
                (fp #b0 #b110101 #b10)))
(assert (fp.leq (fp #b0 #b110101 #b10)
                expect
                (fp #b0 #b110111 #b11)))
; expect = 6291456.0

(assert (= expect result))

(check-sat)
(exit)
