(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01110111 #b00010)
                arg1
                (fp #b0 #b11000010 #b01111)))
(assert (fp.leq (fp #b0 #b11000010 #b01111)
                arg1
                (fp #b0 #b11111101 #b00011)))
; arg1 = 216749242866087231488.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111110 #b11000)
                arg2
                (fp #b1 #b11111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000)
                arg2
                (fp #b1 #b01101100 #b01111)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01101100 #b01110)
                arg3
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                arg3
                (fp #b0 #b00111011 #b10110)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
