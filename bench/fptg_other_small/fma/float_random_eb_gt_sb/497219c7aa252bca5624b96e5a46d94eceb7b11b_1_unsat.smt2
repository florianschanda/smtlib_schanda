(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111111 #b00000)
                arg2
                (fp #b1 #b11111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111)
                arg2
                (fp #b1 #b01001100 #b00011)))
; arg2 = -334965454937798799971759379190646833152.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111111 #b00000)
                arg3
                (fp #b1 #b11111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111)
                arg3
                (fp #b1 #b11001011 #b11101)))
; arg3 = -334965454937798799971759379190646833152.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
