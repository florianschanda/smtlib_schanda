(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10111 #b1)
                arg1
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg1
                (fp #b1 #b00001 #b1)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10101 #b0)
                arg2
                (fp #b1 #b10010 #b0)))
(assert (fp.leq (fp #b1 #b10010 #b0)
                arg2
                (fp #b1 #b00111 #b0)))
; arg2 = -8.0

(declare-const arg3 (_ FloatingPoint 5 2))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b01000 #b1)
                expect
                (fp #b0 #b10100 #b1)))
(assert (fp.leq (fp #b0 #b10100 #b1)
                expect
                (fp #b0 #b10110 #b1)))
; expect = 48.0

(assert (= expect result))

(check-sat)
(exit)
