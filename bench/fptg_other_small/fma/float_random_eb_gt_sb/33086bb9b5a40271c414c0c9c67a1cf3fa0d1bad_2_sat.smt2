(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg1
                (fp #b1 #b0000 #b01)))
(assert (fp.leq (fp #b1 #b0000 #b01)
                arg1
                (fp #b0 #b1101 #b10)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b01)
                arg2
                (fp #b1 #b1010 #b00)))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg2
                (fp #b0 #b0100 #b10)))
; arg2 = -8.0

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b00)
                arg3
                (fp #b0 #b1101 #b10)))
(assert (fp.leq (fp #b0 #b1101 #b10)
                arg3
                (fp #b0 #b1110 #b10)))
; arg3 = 96.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0110 #b10)
                expect
                (fp #b0 #b1101 #b11)))
(assert (fp.leq (fp #b0 #b1101 #b11)
                expect
                (fp #b0 #b1110 #b01)))
; expect = 112.0

(assert (= expect result))

(check-sat)
(exit)
