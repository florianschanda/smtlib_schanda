(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1111101 #b11110)
                arg1
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg1
                (fp #b0 #b1111110 #b11011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111101 #b01010)
                arg2
                (fp #b1 #b1111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111101 #b00000)
                arg2
                (fp #b0 #b0101101 #b10000)))
; arg2 = -4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1011101 #b01110)
                arg3
                (fp #b1 #b1001000 #b10000)))
(assert (fp.leq (fp #b1 #b1001000 #b10000)
                arg3
                (fp #b0 #b0001000 #b10100)))
; arg3 = -768.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110011 #b10011)
                expect
                (fp #b1 #b1001000 #b10000)))
(assert (fp.leq (fp #b1 #b1001000 #b10000)
                expect
                (fp #b0 #b0000000 #b10110)))
; expect = -768.0

(assert (= expect result))

(check-sat)
(exit)
