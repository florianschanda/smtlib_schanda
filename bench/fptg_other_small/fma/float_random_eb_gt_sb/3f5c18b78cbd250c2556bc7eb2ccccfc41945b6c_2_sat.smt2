(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00000 #b001)
                arg1
                (fp #b0 #b10011 #b000)))
(assert (fp.leq (fp #b0 #b10011 #b000)
                arg1
                (fp #b0 #b11100 #b010)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b101)
                arg2
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                arg2
                (fp #b0 #b01011 #b010)))
; arg2 = -16.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg3
                (fp #b1 #b11110 #b111)))
(assert (fp.leq (fp #b1 #b11110 #b111)
                arg3
                (fp #b1 #b11001 #b001)))
; arg3 = -61440.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
