(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0010011 #b10011)
                arg1
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                arg1
                (fp #b0 #b1111001 #b01011)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111110 #b11010)
                arg2
                (fp #b1 #b1111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111101 #b00000)
                arg2
                (fp #b1 #b1000100 #b01010)))
; arg2 = -4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0100000 #b00100)
                arg3
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                arg3
                (fp #b0 #b1010110 #b10011)))
; arg3 = 64.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
