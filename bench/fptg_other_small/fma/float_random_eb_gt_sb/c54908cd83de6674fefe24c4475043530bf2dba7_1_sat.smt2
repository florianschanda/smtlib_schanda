; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111110 #b000)
                arg1
                (fp #b1 #b11111101 #b000)))
(assert (fp.leq (fp #b1 #b11111101 #b000)
                arg1
                (fp #b0 #b10010010 #b111)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01001011 #b110)
                arg2
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg2
                (fp #b0 #b11001000 #b100)))
; arg2 = 16.0

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                arg3
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                arg3
                (fp #b0 #b00101110 #b001)))
; arg3 = -319014718988379809496913694467282698240.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                expect
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                expect
                (fp #b0 #b01101010 #b011)))
; expect = -319014718988379809496913694467282698240.0

(assert (= expect result))

(check-sat)
(exit)
