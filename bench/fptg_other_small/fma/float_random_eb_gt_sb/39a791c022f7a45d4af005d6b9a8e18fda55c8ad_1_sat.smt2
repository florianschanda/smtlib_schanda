                arg2
                (fp #b0 #b0000000 #b10101)))
(assert (fp.leq (fp #b0 #b0000000 #b10101)
                arg2
                (fp #b0 #b1010000 #b01101)))
; arg2 = 0.0000000000000000001423015351387224569634781801141798496246337890625

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1010000 #b01110)
                arg3
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg3
                (fp #b0 #b1011111 #b00100)))
; arg3 = -64.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1100100 #b11000)
                expect
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                expect
                (fp #b0 #b0100001 #b01111)))
; expect = -64.0

(assert (= expect result))

(check-sat)
(exit)
