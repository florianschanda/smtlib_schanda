; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0101010 #b11101)
                arg1
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg1
