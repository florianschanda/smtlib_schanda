(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b011110 #b000)
                arg1
                (fp #b0 #b101100 #b010)))
(assert (fp.leq (fp #b0 #b101100 #b010)
                arg1
                (fp #b0 #b110101 #b111)))
; arg1 = 10240.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000110 #b001)
                arg2
                (fp #b1 #b000101 #b101)))
(assert (fp.leq (fp #b1 #b000101 #b101)
                arg2
                (fp #b1 #b000010 #b100)))
; arg2 = -0.00000002421438694000244140625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000101 #b100)
                arg3
                (fp #b0 #b000000 #b101)))
(assert (fp.leq (fp #b0 #b000000 #b101)
                arg3
                (fp #b0 #b101110 #b011)))
; arg3 = 0.000000000582076609134674072265625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101000 #b101)
                expect
                (fp #b1 #b010011 #b000)))
(assert (fp.leq (fp #b1 #b010011 #b000)
                expect
                (fp #b0 #b010110 #b100)))
; expect = -0.000244140625

(assert (= expect result))

(check-sat)
(exit)
