                (fp #b0 #b0110101 #b010)))
(assert (fp.leq (fp #b0 #b0110101 #b010)
                arg2
                (fp #b0 #b1000001 #b100)))
; arg2 = 0.001220703125

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0111000 #b010)
                arg3
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                arg3
                (fp #b0 #b1110011 #b001)))
; arg3 = 16.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0101001 #b110)
                expect
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                expect
                (fp #b0 #b1111000 #b011)))
; expect = 16.0

(assert (not (= expect result)))

(check-sat)
(exit)
