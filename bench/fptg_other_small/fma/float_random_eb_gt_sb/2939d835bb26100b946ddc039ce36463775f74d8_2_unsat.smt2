; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01011100 #b100100)
                arg1
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg1
                (fp #b0 #b10110000 #b001011)))
; arg1 = 128.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00011111 #b000000)
                arg2
                (fp #b0 #b00110110 #b000111)))
(assert (fp.leq (fp #b0 #b00110110 #b000111)
                arg2
                (fp #b0 #b10110100 #b001000)))
; arg2 = 0.0000000000000000000001174596469825299298317400342739347252063453197479248046875

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01110110 #b110001)
                arg3
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg3
                (fp #b0 #b11111101 #b010111)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b01010111 #b010110)
                expect
                (fp #b0 #b11111101 #b000001)))
(assert (fp.leq (fp #b0 #b11111101 #b000001)
                expect
                (fp #b0 #b11111101 #b001000)))
; expect = 86399819726019531738747458918222397440.0

(assert (not (= expect result)))

(check-sat)
(exit)
