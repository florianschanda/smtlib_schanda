                (fp #b0 #b1111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111110 #b11111)
                arg2
                (fp #b0 #b1111111 #b00000)))
; arg2 = 18158513697557839872.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0010100 #b01010)
                arg3
                (fp #b1 #b0000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000 #b00000)
                arg3
                (fp #b0 #b0011100 #b01000)))
; arg3 = -0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b1010100 #b01110)
                expect
                (fp #b0 #b1111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111110 #b11111)
                expect
                (fp #b0 #b1111111 #b00000)))
; expect = 18158513697557839872.0

(assert (not (= expect result)))

(check-sat)
(exit)
