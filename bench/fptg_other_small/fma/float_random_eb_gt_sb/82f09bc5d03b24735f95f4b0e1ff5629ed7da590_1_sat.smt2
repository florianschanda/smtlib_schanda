; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110100 #b1101)
                arg1
                (fp #b1 #b110000 #b0011)))
(assert (fp.leq (fp #b1 #b110000 #b0011)
                arg1
                (fp #b0 #b001101 #b1101)))
; arg1 = -155648.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111100 #b1001)
                arg2
                (fp #b1 #b100111 #b1101)))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg2
                (fp #b0 #b100111 #b1011)))
; arg2 = -464.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
