(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -NAN
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010001 #b00)
                arg1
                (fp #b0 #b100001 #b10)))
(assert (fp.leq (fp #b0 #b100001 #b10)
                arg1
                (fp #b0 #b100111 #b10)))
; arg1 = 6.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111110 #b01)
                arg3
                (fp #b1 #b111101 #b00)))
(assert (fp.leq (fp #b1 #b111101 #b00)
                arg3
                (fp #b1 #b001000 #b00)))
; arg3 = -1073741824.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
