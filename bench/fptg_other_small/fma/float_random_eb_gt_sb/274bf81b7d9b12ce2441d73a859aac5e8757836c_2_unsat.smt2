; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b11110001 #b000110)
                arg1
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg1
                (fp #b0 #b11111110 #b101001)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01001010 #b110100)
                arg2
                (fp #b0 #b10100101 #b111111)))
(assert (fp.leq (fp #b0 #b10100101 #b111111)
                arg2
                (fp #b0 #b10111111 #b001000)))
; arg2 = 545460846592.0

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
