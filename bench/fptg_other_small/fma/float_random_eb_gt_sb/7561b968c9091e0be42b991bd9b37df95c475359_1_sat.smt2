                arg2
                (fp #b0 #b0000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000 #b110)
                arg2
                (fp #b0 #b1001100 #b010)))
; arg2 = 0.0000000000000000001626303258728256651011179201304912567138671875

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0010011 #b011)
                arg3
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg3
                (fp #b0 #b0111111 #b100)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111000 #b000)
                expect
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                expect
                (fp #b0 #b0101000 #b000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
