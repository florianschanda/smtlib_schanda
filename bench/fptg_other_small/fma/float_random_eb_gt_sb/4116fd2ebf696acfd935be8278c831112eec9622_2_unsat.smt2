; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00111111 #b000)
                arg1
                (fp #b0 #b11111101 #b000)))
(assert (fp.leq (fp #b0 #b11111101 #b000)
                arg1
                (fp #b0 #b11111101 #b001)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11000001 #b010)
                arg2
                (fp #b1 #b10000011 #b000)))
(assert (fp.leq (fp #b1 #b10000011 #b000)
                arg2
                (fp #b0 #b10000011 #b111)))
; arg2 = -16.0

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101100 #b110)
                arg3
                (fp #b1 #b00000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000 #b100)
                arg3
                (fp #b0 #b11110101 #b110)))
; arg3 = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
