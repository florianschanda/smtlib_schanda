; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111001 #b00)
                arg1
                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg1
                (fp #b0 #b010110 #b00)))
; arg1 = 0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111100 #b01)
                arg2
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                arg2
                (fp #b0 #b101011 #b11)))
; arg2 = -0.0000000004656612873077392578125

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg3
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                arg3
                (fp #b1 #b101001 #b00)))
; arg3 = -3758096384.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
