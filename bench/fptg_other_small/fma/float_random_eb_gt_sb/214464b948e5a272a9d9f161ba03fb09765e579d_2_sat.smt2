                arg3
                (fp #b1 #b11101 #b00)))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg3
                (fp #b0 #b01110 #b01)))
; arg3 = -16384.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11111 #b00)
                expect
                (fp #b1 #b11101 #b01)))
(assert (fp.leq (fp #b1 #b11101 #b01)
                expect
                (fp #b1 #b10001 #b10)))
; expect = -20480.0

(assert (= expect result))

(check-sat)
