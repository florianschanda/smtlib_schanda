(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b110111 #b1001)
                arg1
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                arg1
                (fp #b0 #b010110 #b1110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011000 #b1100)
                arg2
                (fp #b0 #b000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000 #b0100)
                arg2
                (fp #b0 #b010110 #b0001)))
; arg2 = 0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011011 #b0101)
                arg3
                (fp #b0 #b100100 #b0000)))
(assert (fp.leq (fp #b0 #b100100 #b0000)
                arg3
                (fp #b0 #b100111 #b1000)))
; arg3 = 32.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010001 #b0010)
                expect
                (fp #b0 #b100100 #b0000)))
(assert (fp.leq (fp #b0 #b100100 #b0000)
                expect
                (fp #b0 #b101010 #b0011)))
; expect = 32.0

(assert (not (= expect result)))

(check-sat)
(exit)
