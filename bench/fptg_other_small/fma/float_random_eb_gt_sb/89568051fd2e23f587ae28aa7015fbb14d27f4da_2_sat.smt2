(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +ZERO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001011 #b01101)
                arg1
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg1
                (fp #b0 #b1100110 #b00111)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0101111 #b01010)
                arg2
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg2
                (fp #b0 #b1001000 #b00000)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1110110 #b01010)
                arg3
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg3
                (fp #b0 #b0000001 #b11011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001100 #b11000)
                expect
                (fp #b1 #b0000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000 #b00000)
                expect
                (fp #b0 #b0111101 #b10000)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
