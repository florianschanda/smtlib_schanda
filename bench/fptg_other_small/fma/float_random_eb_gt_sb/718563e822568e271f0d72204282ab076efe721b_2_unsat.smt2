; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11001 #b1)
                arg1
                (fp #b0 #b11110 #b0)))
(assert (fp.leq (fp #b0 #b11110 #b0)
                arg1
                (fp #b0 #b11110 #b1)))
; arg1 = 32768.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01000 #b1)
                arg2
                (fp #b1 #b00111 #b0)))
(assert (fp.leq (fp #b1 #b00111 #b0)
                arg2
                (fp #b0 #b01100 #b1)))
; arg2 = -0.00390625

(declare-const arg3 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b00001 #b0)
                arg3
                (fp #b0 #b11101 #b0)))
(assert (fp.leq (fp #b0 #b11101 #b0)
                arg3
                (fp #b0 #b11111 #b0)))
; arg3 = 16384.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10011 #b1)
                expect
                (fp #b0 #b11101 #b0)))
(assert (fp.leq (fp #b0 #b11101 #b0)
                expect
                (fp #b0 #b11101 #b1)))
; expect = 16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
