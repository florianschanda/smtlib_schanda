(assert (fp.leq (fp #b1 #b11111101 #b0)
                arg2
                (fp #b1 #b00111010 #b0)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11100011 #b1)
                arg3
                (fp #b1 #b11000011 #b0)))
(assert (fp.leq (fp #b1 #b11000011 #b0)
                arg3
                (fp #b1 #b10110101 #b0)))
; arg3 = -295147905179352825856.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

