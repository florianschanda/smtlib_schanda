(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11001101 #b0010)
                arg1
                (fp #b1 #b10000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000100 #b0000)
                arg1
                (fp #b0 #b10011101 #b0111)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01110001 #b1010)
                arg2
                (fp #b0 #b11111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000)
                arg2
                (fp #b0 #b11111101 #b0100)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
