                arg2
                (fp #b1 #b00000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000 #b1)
                arg2
                (fp #b0 #b11101100 #b1)))
; arg2 = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001100 #b1)
                arg3
                (fp #b0 #b00000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000 #b1)
                arg3
                (fp #b0 #b11110110 #b1)))
; arg3 = 0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00001001 #b1)
                expect
                (fp #b0 #b00000010 #b0)))
(assert (fp.leq (fp #b0 #b00000010 #b0)
                expect
                (fp #b0 #b01111001 #b1)))
; expect = 0.00000000000000000000000000000000000002350988701644575015937473074444491355637331113544175043017503412556834518909454345703125

(assert (= expect result))

(check-sat)
(exit)
