(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b001111 #b1)
                arg2
                (fp #b0 #b100001 #b0)))
(assert (fp.leq (fp #b0 #b100001 #b0)
                arg2
                (fp #b0 #b110011 #b0)))
; arg2 = 4.0

(declare-const arg3 (_ FloatingPoint 6 2))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b000011 #b1)
                arg3
                (fp #b0 #b000000 #b0)))
(assert (fp.leq (fp #b0 #b000000 #b0)
                arg3
                (fp #b0 #b000100 #b1)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
