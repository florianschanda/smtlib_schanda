(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11000 #b111)
                arg1
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                arg1
                (fp #b0 #b01100 #b101)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b110)
                arg2
                (fp #b0 #b10011 #b000)))
(assert (fp.leq (fp #b0 #b10011 #b000)
                arg2
                (fp #b0 #b11110 #b110)))
; arg2 = 16.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10000 #b101)
                arg3
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                arg3
                (fp #b0 #b00000 #b001)))
; arg3 = -0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10111 #b001)
                expect
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                expect
                (fp #b0 #b10100 #b101)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
