                arg3
                (fp #b1 #b111101 #b00)))
(assert (fp.leq (fp #b1 #b111101 #b00)
                arg3
                (fp #b1 #b000011 #b00)))
; arg3 = -1073741824.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
