; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +ZERO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg1
                (fp #b1 #b101001 #b01)))
(assert (fp.leq (fp #b1 #b101001 #b01)
                arg1
                (fp #b1 #b001100 #b10)))
; arg1 = -1280.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b110000 #b10)
                arg2
                (fp #b0 #b000000 #b00)))
(assert (fp.leq (fp #b0 #b000000 #b00)
                arg2
                (fp #b0 #b100011 #b11)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010000 #b10)
                arg3
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                arg3
                (fp #b0 #b100100 #b01)))
; arg3 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100101 #b00)
                expect
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                expect
                (fp #b0 #b010111 #b11)))
; expect = -0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
(exit)
