(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100110 #b000)
                arg1
                (fp #b0 #b101100 #b010)))
(assert (fp.leq (fp #b0 #b101100 #b010)
                arg1
                (fp #b0 #b110011 #b110)))
; arg1 = 10240.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100101 #b011)
                arg2
                (fp #b0 #b111110 #b111)))
(assert (fp.leq (fp #b0 #b111110 #b111)
                arg2
                (fp #b0 #b111111 #b000)))
; arg2 = 4026531840.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111000 #b110)
                arg3
                (fp #b0 #b000000 #b101)))
(assert (fp.leq (fp #b0 #b000000 #b101)
                arg3
                (fp #b0 #b101111 #b100)))
; arg3 = 0.000000000582076609134674072265625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000001 #b010)
                expect
                (fp #b0 #b111110 #b111)))
(assert (fp.leq (fp #b0 #b111110 #b111)
                expect
                (fp #b0 #b111111 #b000)))
; expect = 4026531840.0

(assert (= expect result))

(check-sat)
(exit)
