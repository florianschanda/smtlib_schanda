(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11000111 #b000)
                arg1
                (fp #b1 #b10000011 #b000)))
(assert (fp.leq (fp #b1 #b10000011 #b000)
                arg1
                (fp #b0 #b01101011 #b110)))
; arg1 = -16.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11000111 #b110)
                arg2
                (fp #b0 #b00000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000 #b010)
                arg2
                (fp #b0 #b11011001 #b000)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110010 #b010)
                arg3
                (fp #b1 #b10011100 #b011)))
(assert (fp.leq (fp #b1 #b10011100 #b011)
                arg3
                (fp #b0 #b01111001 #b001)))
; arg3 = -738197504.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11011010 #b100)
                expect
                (fp #b1 #b10011100 #b100)))
(assert (fp.leq (fp #b1 #b10011100 #b100)
                expect
                (fp #b0 #b11101100 #b010)))
; expect = -805306368.0

(assert (= expect result))

(check-sat)
(exit)
