(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg1
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                arg1
                (fp #b1 #b110010 #b01)))
; arg1 = -3758096384.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b00)
                arg2
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg2
                (fp #b0 #b110001 #b10)))
; arg2 = 0.0000000004656612873077392578125

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110011 #b10)
                arg3
                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg3
                (fp #b0 #b111011 #b01)))
; arg3 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b11)
                expect
                (fp #b1 #b011111 #b11)))
(assert (fp.leq (fp #b1 #b011111 #b11)
                expect
                (fp #b0 #b001110 #b00)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
