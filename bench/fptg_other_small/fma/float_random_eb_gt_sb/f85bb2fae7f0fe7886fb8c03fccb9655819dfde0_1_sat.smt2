(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10110100 #b0000)
                arg1
                (fp #b0 #b11000101 #b1100)))
(assert (fp.leq (fp #b0 #b11000101 #b1100)
                arg1
                (fp #b0 #b11001100 #b1011)))
; arg1 = 2066035336255469780992.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111010 #b0000)
                arg2
                (fp #b1 #b10000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000100 #b0000)
                arg2
                (fp #b0 #b00001011 #b0110)))
; arg2 = -32.0

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111110 #b1011)
                arg3
                (fp #b1 #b11111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000)
                arg3
                (fp #b0 #b01001101 #b0100)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111101 #b0110)
                expect
                (fp #b1 #b11111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000)
                expect
                (fp #b0 #b01001010 #b0111)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
