; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b1110)
                arg1
                (fp #b1 #b111101 #b0000)))
(assert (fp.leq (fp #b1 #b111101 #b0000)
                arg1
                (fp #b0 #b010001 #b1101)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000101 #b0100)
                arg2
                (fp #b0 #b001110 #b0111)))
(assert (fp.leq (fp #b0 #b001110 #b0111)
                arg2
                (fp #b0 #b101011 #b0010)))
; arg2 = 0.000010967254638671875

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001010 #b0010)
                arg3
                (fp #b0 #b000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000 #b0100)
                arg3
                (fp #b0 #b111101 #b0000)))
; arg3 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b0001)
                expect
                (fp #b1 #b101100 #b0111)))
(assert (fp.leq (fp #b1 #b101100 #b0111)
                expect
                (fp #b0 #b011101 #b1000)))
; expect = -11776.0

(assert (not (= expect result)))

(check-sat)
(exit)
