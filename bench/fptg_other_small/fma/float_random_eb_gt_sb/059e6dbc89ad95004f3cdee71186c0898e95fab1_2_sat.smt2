(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b011010 #b110)
                arg1
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg1
                (fp #b0 #b101101 #b111)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111000 #b011)
                arg2
                (fp #b1 #b000000 #b010)))
(assert (fp.leq (fp #b1 #b000000 #b010)
                arg2
                (fp #b0 #b101001 #b011)))
; arg2 = -0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001011 #b111)
                arg3
                (fp #b0 #b000000 #b101)))
(assert (fp.leq (fp #b0 #b000000 #b101)
                arg3
                (fp #b0 #b000100 #b111)))
; arg3 = 0.000000000582076609134674072265625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b100)
                expect
                (fp #b1 #b000010 #b110)))
(assert (fp.leq (fp #b1 #b000010 #b110)
                expect
                (fp #b0 #b101010 #b001)))
; expect = -0.0000000032596290111541748046875

(assert (= expect result))

(check-sat)
(exit)
