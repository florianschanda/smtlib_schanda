(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b00110 #b1)
                arg1
                (fp #b0 #b10111 #b1)))
(assert (fp.leq (fp #b0 #b10111 #b1)
                arg1
                (fp #b0 #b11000 #b1)))
; arg1 = 384.0

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11110 #b1)
                arg2
                (fp #b1 #b11101 #b0)))
(assert (fp.leq (fp #b1 #b11101 #b0)
                arg2
                (fp #b1 #b10010 #b1)))
; arg2 = -16384.0

(declare-const arg3 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg3
                (fp #b1 #b11110 #b1)))
(assert (fp.leq (fp #b1 #b11110 #b1)
                arg3
                (fp #b1 #b00011 #b1)))
; arg3 = -49152.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
