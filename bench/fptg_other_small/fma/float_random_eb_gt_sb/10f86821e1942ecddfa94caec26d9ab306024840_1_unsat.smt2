(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1111 #b00)
                arg1
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                arg1
                (fp #b0 #b0010 #b10)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b00)
                arg2
                (fp #b1 #b1101 #b00)))
(assert (fp.leq (fp #b1 #b1101 #b00)
                arg2
                (fp #b0 #b1101 #b01)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b01)
                arg3
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                arg3
                (fp #b0 #b0011 #b01)))
; arg3 = 0.00390625

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1000 #b00)
                expect
                (fp #b1 #b0100 #b11)))
(assert (fp.leq (fp #b1 #b0100 #b11)
                expect
                (fp #b1 #b0000 #b11)))
; expect = -0.21875

(assert (not (= expect result)))

(check-sat)
(exit)
