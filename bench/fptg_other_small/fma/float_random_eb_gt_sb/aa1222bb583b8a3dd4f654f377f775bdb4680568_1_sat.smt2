; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101000 #b111)
                arg1
                (fp #b1 #b0000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000 #b010)
                arg1
                (fp #b0 #b1001100 #b111)))
; arg1 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1100111 #b001)
                arg2
                (fp #b1 #b1000100 #b110)))
(assert (fp.leq (fp #b1 #b1000100 #b110)
                arg2
                (fp #b1 #b0101101 #b101)))
; arg2 = -56.0

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0010010 #b100)
                arg3
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                arg3
                (fp #b0 #b1100000 #b110)))
; arg3 = 16.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0011111 #b100)
                expect
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                expect
                (fp #b0 #b1010110 #b100)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
