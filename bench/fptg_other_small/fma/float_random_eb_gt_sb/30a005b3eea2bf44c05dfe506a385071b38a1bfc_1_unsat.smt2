(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000011 #b011)
                arg1
                (fp #b0 #b101100 #b010)))
(assert (fp.leq (fp #b0 #b101100 #b010)
                arg1
                (fp #b0 #b110101 #b011)))
; arg1 = 10240.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011000 #b011)
                arg3
                (fp #b1 #b000000 #b100)))
(assert (fp.leq (fp #b1 #b000000 #b100)
                arg3
                (fp #b0 #b011010 #b101)))
; arg3 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b011)
                expect
                (fp #b1 #b111001 #b100)))
(assert (fp.leq (fp #b1 #b111001 #b100)
                expect
                (fp #b1 #b000010 #b101)))
; expect = -100663296.0

(assert (not (= expect result)))

(check-sat)
(exit)
