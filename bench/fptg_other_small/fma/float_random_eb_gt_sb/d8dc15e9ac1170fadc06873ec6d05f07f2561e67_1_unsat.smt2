(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011000 #b0110)
                arg1
                (fp #b1 #b000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000 #b0000)
                arg1
                (fp #b0 #b001100 #b0011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b100111 #b0000)
                arg2
                (fp #b0 #b111000 #b0100)))
(assert (fp.leq (fp #b0 #b111000 #b0100)
                arg2
                (fp #b0 #b111110 #b0000)))
; arg2 = 41943040.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b010001 #b0010)
                arg3
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                arg3
                (fp #b0 #b010101 #b1011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110110 #b0100)
                expect
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                expect
                (fp #b0 #b000101 #b0000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
