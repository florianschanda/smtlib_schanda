; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00011000 #b1110)
                arg1
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                arg1
                (fp #b0 #b00100110 #b1100)))
