                (fp #b0 #b00111010 #b1011)))
(assert (fp.leq (fp #b0 #b00111010 #b1011)
                arg2
                (fp #b0 #b01110101 #b1101)))
; arg2 = 0.0000000000000000000028587361969832636443555884397937916219234466552734375

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00101111 #b0110)
                arg3
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                arg3
                (fp #b0 #b00000100 #b1101)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000010 #b0001)
                expect
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                expect
                (fp #b0 #b11101101 #b0000)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
