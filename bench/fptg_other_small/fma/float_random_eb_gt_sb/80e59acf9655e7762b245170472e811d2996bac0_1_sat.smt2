(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b10)
                arg1
                (fp #b1 #b11101 #b00)))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg1
                (fp #b1 #b00100 #b10)))
; arg1 = -16384.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b10100 #b11)
                arg2
                (fp #b0 #b10101 #b01)))
(assert (fp.leq (fp #b0 #b10101 #b01)
                arg2
                (fp #b0 #b11100 #b10)))
; arg2 = 80.0

(declare-const arg3 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10010 #b11)
                arg3
                (fp #b0 #b00000 #b10)))
(assert (fp.leq (fp #b0 #b00000 #b10)
                arg3
                (fp #b0 #b11010 #b00)))
; arg3 = 0.000030517578125

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11111 #b00)
                expect
                (fp #b1 #b11110 #b11)))
(assert (fp.leq (fp #b1 #b11110 #b11)
                expect
                (fp #b0 #b01000 #b00)))
; expect = -57344.0

(assert (= expect result))

(check-sat)
(exit)
