(assert (fp.leq (fp #b1 #b11111000 #b1110)
                arg3
                (fp #b0 #b00000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000)
                arg3
                (fp #b0 #b10001011 #b0100)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

