(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111001 #b01111)
                arg1
                (fp #b0 #b01101101 #b11001)))
(assert (fp.leq (fp #b0 #b01101101 #b11001)
                arg1
                (fp #b0 #b10010000 #b00000)))
; arg1 = 0.00000679492950439453125

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01101101 #b00111)
                arg2
                (fp #b0 #b10000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000101 #b00000)
                arg2
                (fp #b0 #b10101111 #b00010)))
; arg2 = 64.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
