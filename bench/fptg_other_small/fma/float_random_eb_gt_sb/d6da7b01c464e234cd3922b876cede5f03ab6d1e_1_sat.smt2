(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b11)
                arg1
                (fp #b1 #b0000 #b01)))
(assert (fp.leq (fp #b1 #b0000 #b01)
                arg1
                (fp #b0 #b0001 #b01)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b00)
                arg2
                (fp #b1 #b1100 #b01)))
(assert (fp.leq (fp #b1 #b1100 #b01)
                arg2
                (fp #b1 #b1011 #b10)))
; arg2 = -40.0

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b11)
                arg3
                (fp #b1 #b0110 #b00)))
(assert (fp.leq (fp #b1 #b0110 #b00)
                arg3
                (fp #b1 #b0010 #b10)))
; arg3 = -0.5

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0110 #b01)
                expect
                (fp #b1 #b0101 #b01)))
(assert (fp.leq (fp #b1 #b0101 #b01)
                expect
                (fp #b0 #b0111 #b01)))
; expect = -0.3125

(assert (= expect result))

(check-sat)
(exit)
