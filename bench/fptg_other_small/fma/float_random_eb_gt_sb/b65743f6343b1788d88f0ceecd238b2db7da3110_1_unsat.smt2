(assert (fp.leq (fp #b0 #b100100 #b0000)
                arg2
                (fp #b0 #b110011 #b0101)))
; arg2 = 32.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110011 #b1111)
                arg3
                (fp #b1 #b000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg3
                (fp #b0 #b001111 #b1110)))
; arg3 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110011 #b1011)
                expect
                (fp #b1 #b101001 #b0000)))
(assert (fp.leq (fp #b1 #b101001 #b0000)
                expect
                (fp #b0 #b110110 #b0000)))
; expect = -1024.0

(assert (not (= expect result)))

(check-sat)
(exit)
