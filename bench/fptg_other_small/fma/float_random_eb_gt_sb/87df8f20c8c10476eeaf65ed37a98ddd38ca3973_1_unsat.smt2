                arg3
                (fp #b1 #b1000011 #b000)))
(assert (fp.leq (fp #b1 #b1000011 #b000)
                arg3
                (fp #b0 #b0100010 #b000)))
; arg3 = -16.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101111 #b101)
                expect
                (fp #b1 #b1000011 #b000)))
(assert (fp.leq (fp #b1 #b1000011 #b000)
                expect
                (fp #b1 #b0100001 #b001)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
