; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +ZERO
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111001 #b001100)
                arg1
                (fp #b1 #b11111000 #b001101)))
(assert (fp.leq (fp #b1 #b11111000 #b001101)
                arg1
                (fp #b1 #b11110001 #b011110)))
; arg1 = -3198454864857453819174785738799579136.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01101010 #b011000)
                arg2
                (fp #b0 #b00000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000)
                arg2
                (fp #b0 #b01000000 #b101000)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
