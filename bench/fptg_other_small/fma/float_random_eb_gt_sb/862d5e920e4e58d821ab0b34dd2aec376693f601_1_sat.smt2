; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100000 #b0100)
                arg1
                (fp #b1 #b000101 #b1110)))
(assert (fp.leq (fp #b1 #b000101 #b1110)
                arg1
                (fp #b0 #b111001 #b0111)))
; arg1 = -0.00000002793967723846435546875

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b000101 #b0001)
                arg3
                (fp #b0 #b001111 #b0000)))
(assert (fp.leq (fp #b0 #b001111 #b0000)
                arg3
                (fp #b0 #b100101 #b0010)))
; arg3 = 0.0000152587890625

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b0111)
                expect
                (fp #b0 #b001110 #b1111)))
(assert (fp.leq (fp #b0 #b001110 #b1111)
                expect
                (fp #b0 #b011001 #b1111)))
; expect = 0.000014781951904296875

(assert (= expect result))

(check-sat)
(exit)
