; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0010101 #b10000)
                arg1
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                arg1
                (fp #b0 #b1001011 #b11001)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111111 #b00000)
                arg3
                (fp #b1 #b1111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111110 #b11111)
                arg3
                (fp #b1 #b0100011 #b10101)))
; arg3 = -18158513697557839872.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
