;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110111 #b1100)
                arg1
                (fp #b1 #b0000000 #b0011)))
(assert (fp.leq (fp #b1 #b0000000 #b0011)
                arg1
