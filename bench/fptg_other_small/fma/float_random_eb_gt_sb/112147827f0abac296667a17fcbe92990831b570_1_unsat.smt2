(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1001101 #b0011)
                arg3
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg3
                (fp #b0 #b1111101 #b1101)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011110 #b1110)
                expect
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                expect
                (fp #b0 #b1011110 #b1100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
