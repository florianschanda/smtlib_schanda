(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1000000 #b11)
                arg1
                (fp #b1 #b0000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000 #b00)
                arg1
                (fp #b0 #b0011111 #b01)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0111100 #b10)
                arg2
                (fp #b0 #b1111110 #b11)))
(assert (fp.leq (fp #b0 #b1111110 #b11)
                arg2
                (fp #b0 #b1111111 #b00)))
; arg2 = 16140901064495857664.0

(declare-const arg3 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0110111 #b10)
                arg3
                (fp #b0 #b1000010 #b00)))
(assert (fp.leq (fp #b0 #b1000010 #b00)
                arg3
                (fp #b0 #b1000010 #b11)))
; arg3 = 8.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1011111 #b00)
                expect
                (fp #b0 #b1000010 #b00)))
(assert (fp.leq (fp #b0 #b1000010 #b00)
                expect
                (fp #b0 #b1100111 #b01)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
