(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111111 #b0)
                arg1
                (fp #b1 #b111101 #b0)))
(assert (fp.leq (fp #b1 #b111101 #b0)
                arg1
                (fp #b0 #b101001 #b1)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000100 #b0)
                arg2
                (fp #b0 #b111101 #b0)))
(assert (fp.leq (fp #b0 #b111101 #b0)
                arg2
                (fp #b0 #b111110 #b0)))
; arg2 = 1073741824.0

(declare-const arg3 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b101011 #b0)
                arg3
                (fp #b1 #b000000 #b1)))
(assert (fp.leq (fp #b1 #b000000 #b1)
                arg3
                (fp #b0 #b011111 #b0)))
; arg3 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
