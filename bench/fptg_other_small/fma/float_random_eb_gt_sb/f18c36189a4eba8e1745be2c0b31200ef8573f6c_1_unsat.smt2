; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b1101)
                arg1
                (fp #b1 #b111101 #b0000)))
(assert (fp.leq (fp #b1 #b111101 #b0000)
                arg1
                (fp #b0 #b001101 #b0100)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011000 #b0001)
                arg2
                (fp #b0 #b000000 #b0111)))
(assert (fp.leq (fp #b0 #b000000 #b0111)
                arg2
                (fp #b0 #b011010 #b1111)))
; arg2 = 0.0000000004074536263942718505859375

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001001 #b1011)
                arg3
                (fp #b1 #b000000 #b1011)))
(assert (fp.leq (fp #b1 #b000000 #b1011)
                arg3
                (fp #b0 #b000100 #b1000)))
; arg3 = -0.0000000006402842700481414794921875

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100010 #b0100)
                expect
                (fp #b1 #b011101 #b1100)))
(assert (fp.leq (fp #b1 #b011101 #b1100)
                expect
                (fp #b0 #b011000 #b1001)))
; expect = -0.4375

(assert (not (= expect result)))

(check-sat)
(exit)
