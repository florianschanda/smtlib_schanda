(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010 #b1)
                arg1
                (fp #b1 #b0000 #b0)))
(assert (fp.leq (fp #b1 #b0000 #b0)
                arg1
                (fp #b0 #b1010 #b1)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1100 #b0)
                arg2
                (fp #b0 #b1110 #b0)))
(assert (fp.leq (fp #b0 #b1110 #b0)
                arg2
                (fp #b0 #b1111 #b0)))
; arg2 = 128.0

(declare-const arg3 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0111 #b0)
                arg3
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                arg3
                (fp #b0 #b0110 #b1)))
; arg3 = -0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0100 #b0)
                expect
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                expect
                (fp #b0 #b1010 #b0)))
; expect = -0.0078125

(assert (= expect result))

(check-sat)
(exit)
