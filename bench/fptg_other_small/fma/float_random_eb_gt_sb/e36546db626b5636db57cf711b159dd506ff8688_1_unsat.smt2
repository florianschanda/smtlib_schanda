                arg3
                (fp #b1 #b100011 #b000)))
(assert (fp.leq (fp #b1 #b100011 #b000)
                arg3
                (fp #b0 #b010100 #b100)))
; arg3 = -16.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011110 #b100)
                expect
                (fp #b0 #b100010 #b010)))
(assert (fp.leq (fp #b0 #b100010 #b010)
                expect
                (fp #b0 #b110011 #b100)))
; expect = 10.0

(assert (not (= expect result)))

(check-sat)
