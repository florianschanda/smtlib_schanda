; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +INFINITY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111001 #b1001)
                arg1
                (fp #b1 #b01101010 #b0000)))
(assert (fp.leq (fp #b1 #b01101010 #b0000)
                arg1
                (fp #b0 #b11100110 #b1000)))
; arg1 = -0.000000476837158203125

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00001101 #b0011)
                arg3
                (fp #b0 #b10000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000100 #b0000)
                arg3
                (fp #b0 #b10101100 #b0011)))
; arg3 = 32.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
