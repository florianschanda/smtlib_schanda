                arg3
                (fp #b0 #b000110 #b101)))
(assert (fp.leq (fp #b0 #b000110 #b101)
                arg3
                (fp #b0 #b111110 #b011)))
; arg3 = 0.0000000484287738800048828125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
