(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b00011111 #b00101)
                arg1
                (fp #b0 #b11111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000)
                arg1
                (fp #b0 #b11111101 #b10000)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111101 #b10100)
                arg2
                (fp #b1 #b11111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000)
                arg2
                (fp #b1 #b01001110 #b11110)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111111 #b00000)
                arg3
                (fp #b1 #b11111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111)
                arg3
                (fp #b1 #b11011001 #b01000)))
; arg3 = -334965454937798799971759379190646833152.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
