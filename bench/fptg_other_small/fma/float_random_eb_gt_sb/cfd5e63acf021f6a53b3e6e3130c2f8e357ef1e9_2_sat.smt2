(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b00111101 #b00001)
                arg1
                (fp #b0 #b01101101 #b11001)))
(assert (fp.leq (fp #b0 #b01101101 #b11001)
                arg1
                (fp #b0 #b01111101 #b11000)))
; arg1 = 0.00000679492950439453125

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11100001 #b01111)
                arg2
                (fp #b0 #b11011101 #b10111)))
(assert (fp.leq (fp #b0 #b11011101 #b10111)
                arg2
                (fp #b0 #b11100000 #b01110)))
; arg2 = 34043351080347957559725916160.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11110110 #b01001)
                arg3
                (fp #b1 #b10000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000101 #b00000)
                arg3
                (fp #b0 #b11011110 #b00001)))
; arg3 = -64.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10011001 #b11100)
                expect
                (fp #b0 #b11001100 #b10001)))
(assert (fp.leq (fp #b0 #b11001100 #b10001)
                expect
                (fp #b0 #b11010111 #b11011)))
; expect = 231395957660612615471104.0

(assert (= expect result))

(check-sat)
(exit)
