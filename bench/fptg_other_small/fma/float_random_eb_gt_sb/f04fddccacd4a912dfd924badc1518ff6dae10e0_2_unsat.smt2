(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b001100 #b0110)
                arg1
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                arg1
                (fp #b0 #b111111 #b0000)))
; arg1 = 4160749568.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b0111)
                arg2
                (fp #b1 #b111101 #b0000)))
(assert (fp.leq (fp #b1 #b111101 #b0000)
                arg2
                (fp #b0 #b100001 #b0010)))
; arg2 = -1073741824.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110100 #b1010)
                arg3
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg3
                (fp #b0 #b100111 #b1011)))
; arg3 = -32.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
