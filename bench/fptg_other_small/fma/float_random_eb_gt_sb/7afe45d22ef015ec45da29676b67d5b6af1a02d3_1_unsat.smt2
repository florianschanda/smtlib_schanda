(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg3
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                arg3
                (fp #b1 #b110111 #b10)))
; arg3 = -3758096384.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                expect
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                expect
                (fp #b0 #b010000 #b00)))
; expect = -3758096384.0

(assert (not (= expect result)))

