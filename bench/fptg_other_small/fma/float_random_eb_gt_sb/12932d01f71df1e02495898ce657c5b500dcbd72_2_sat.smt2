(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10011 #b100)
                arg1
                (fp #b1 #b10010 #b101)))
(assert (fp.leq (fp #b1 #b10010 #b101)
                arg1
                (fp #b0 #b01101 #b111)))
; arg1 = -13.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11000 #b011)
                arg2
                (fp #b1 #b00000 #b101)))
(assert (fp.leq (fp #b1 #b00000 #b101)
                arg2
                (fp #b0 #b01100 #b101)))
; arg2 = -0.00003814697265625

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00110 #b000)
                arg3
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                arg3
                (fp #b0 #b11110 #b101)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10000 #b100)
                expect
                (fp #b0 #b00100 #b001)))
(assert (fp.leq (fp #b0 #b00100 #b001)
                expect
                (fp #b0 #b11001 #b001)))
; expect = 0.00054931640625

(assert (= expect result))

(check-sat)
(exit)
