(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101001 #b01110)
                arg1
                (fp #b1 #b1001110 #b01011)))
(assert (fp.leq (fp #b1 #b1001110 #b01011)
                arg1
                (fp #b1 #b0010000 #b11011)))
; arg1 = -44032.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0110010 #b01110)
                arg2
                (fp #b1 #b0110001 #b01100)))
(assert (fp.leq (fp #b1 #b0110001 #b01100)
                arg2
                (fp #b1 #b0010111 #b11101)))
; arg2 = -0.00008392333984375

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0101001 #b01110)
                expect
                (fp #b0 #b1000000 #b11100)))
(assert (fp.leq (fp #b0 #b1000000 #b11100)
                expect
                (fp #b0 #b1101010 #b00100)))
; expect = 3.75

(assert (not (= expect result)))

(check-sat)
(exit)
