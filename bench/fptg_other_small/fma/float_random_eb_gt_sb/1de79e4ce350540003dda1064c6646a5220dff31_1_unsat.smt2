(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01011011 #b101011)
                arg3
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg3
                (fp #b0 #b10100110 #b000111)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
