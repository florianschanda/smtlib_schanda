(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -ZERO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110010 #b010)
                arg1
                (fp #b1 #b100011 #b000)))
(assert (fp.leq (fp #b1 #b100011 #b000)
                arg1
                (fp #b0 #b000000 #b011)))
; arg1 = -16.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b110101 #b111)
                arg2
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg2
                (fp #b0 #b101101 #b000)))
; arg2 = -0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b111100 #b001)
                arg3
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg3
                (fp #b0 #b101011 #b110)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101000 #b000)
                expect
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                expect
                (fp #b0 #b010100 #b111)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
