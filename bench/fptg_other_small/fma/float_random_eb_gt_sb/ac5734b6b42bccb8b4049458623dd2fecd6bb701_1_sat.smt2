                (fp #b0 #b0011100 #b1110)))
(assert (fp.leq (fp #b0 #b0011100 #b1110)
                arg2
                (fp #b0 #b1111000 #b1111)))
; arg2 = 0.00000000005456968210637569427490234375

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b1001010 #b1100)
                expect
                (fp #b0 #b1011100 #b1101)))
(assert (fp.leq (fp #b0 #b1011100 #b1101)
                expect
                (fp #b0 #b1110000 #b0001)))
; expect = 973078528.0

(assert (= expect result))

(check-sat)
(exit)
