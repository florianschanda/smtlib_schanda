(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b1111010 #b0011)
                arg1
                (fp #b0 #b1111110 #b1111)))
