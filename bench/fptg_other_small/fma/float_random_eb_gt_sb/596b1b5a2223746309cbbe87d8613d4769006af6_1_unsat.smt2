; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1011010 #b00101)
                arg1
                (fp #b0 #b1000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000101 #b00000)
                arg1
