                arg2
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg2
                (fp #b1 #b0000001 #b01101)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0100100 #b10001)
                arg3
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg3
                (fp #b0 #b0100101 #b00010)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1010101 #b00101)
                expect
                (fp #b1 #b1001011 #b00000)))
(assert (fp.leq (fp #b1 #b1001011 #b00000)
                expect
                (fp #b0 #b0000111 #b10010)))
; expect = -4096.0

(assert (not (= expect result)))

(check-sat)
(exit)
