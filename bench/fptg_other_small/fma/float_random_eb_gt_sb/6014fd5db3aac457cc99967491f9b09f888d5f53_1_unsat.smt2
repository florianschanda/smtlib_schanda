                arg3
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg3
                (fp #b0 #b100011 #b111)))
; arg3 = 16.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000000 #b101)
                expect
                (fp #b0 #b111110 #b111)))
(assert (fp.leq (fp #b0 #b111110 #b111)
                expect
                (fp #b0 #b111111 #b000)))
; expect = 4026531840.0

(assert (not (= expect result)))

