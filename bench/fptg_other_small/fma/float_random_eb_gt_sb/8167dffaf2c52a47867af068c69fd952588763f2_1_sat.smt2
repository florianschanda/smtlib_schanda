; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111111 #b00000)
                arg2
                (fp #b1 #b11111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111)
                arg2
                (fp #b1 #b01101100 #b00100)))
; arg2 = -334965454937798799971759379190646833152.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10010110 #b01110)
                arg3
                (fp #b1 #b01110111 #b01100)))
(assert (fp.leq (fp #b1 #b01110111 #b01100)
                arg3
                (fp #b0 #b01001110 #b10111)))
; arg3 = -0.00537109375

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
