(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10011 #b001)
                arg1
                (fp #b0 #b11101 #b000)))
(assert (fp.leq (fp #b0 #b11101 #b000)
                arg1
                (fp #b0 #b11101 #b011)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01101 #b110)
                arg2
                (fp #b0 #b00000 #b010)))
(assert (fp.leq (fp #b0 #b00000 #b010)
                arg2
                (fp #b0 #b10000 #b100)))
; arg2 = 0.0000152587890625

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01001 #b110)
                arg3
                (fp #b0 #b00110 #b110)))
(assert (fp.leq (fp #b0 #b00110 #b110)
                arg3
                (fp #b0 #b01110 #b000)))
; arg3 = 0.00341796875

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01100 #b001)
                expect
                (fp #b0 #b01101 #b000)))
(assert (fp.leq (fp #b0 #b01101 #b000)
                expect
                (fp #b0 #b11000 #b011)))
; expect = 0.25

(assert (not (= expect result)))

(check-sat)
(exit)
