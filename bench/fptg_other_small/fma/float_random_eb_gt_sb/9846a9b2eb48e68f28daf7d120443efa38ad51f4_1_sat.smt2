; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1010010 #b0)
                arg1
                (fp #b0 #b0111101 #b1)))
(assert (fp.leq (fp #b0 #b0111101 #b1)
                arg1
                (fp #b0 #b1101110 #b1)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1111001 #b1)
                arg2
                (fp #b1 #b1101101 #b0)))
(assert (fp.leq (fp #b1 #b1101101 #b0)
                arg2
                (fp #b0 #b0101100 #b1)))
; arg2 = -70368744177664.0

(declare-const arg3 (_ FloatingPoint 7 2))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1110000 #b1)
                arg3
                (fp #b0 #b0000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000 #b0)
                arg3
                (fp #b0 #b1110000 #b0)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1111100 #b0)
                expect
                (fp #b1 #b1101011 #b1)))
(assert (fp.leq (fp #b1 #b1101011 #b1)
                expect
                (fp #b0 #b0100001 #b0)))
; expect = -26388279066624.0

(assert (= expect result))

(check-sat)
(exit)
