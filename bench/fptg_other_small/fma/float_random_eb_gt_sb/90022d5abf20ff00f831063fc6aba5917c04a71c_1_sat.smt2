(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11010001 #b1000)
                arg2
                (fp #b1 #b00000000 #b1110)))
(assert (fp.leq (fp #b1 #b00000000 #b1110)
                arg2
                (fp #b0 #b11000000 #b0101)))
; arg2 = -0.000000000000000000000000000000000000010285575569695015694726444700694649680913323621755765813201577429936151020228862762451171875

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01101100 #b1101)
                arg3
                (fp #b1 #b00000000 #b1011)))
(assert (fp.leq (fp #b1 #b00000000 #b1011)
                arg3
                (fp #b0 #b10100001 #b0101)))
; arg3 = -0.0000000000000000000000000000000000000080815236619032266172850636934029390350033257028081017103726679806641186587512493133544921875

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
