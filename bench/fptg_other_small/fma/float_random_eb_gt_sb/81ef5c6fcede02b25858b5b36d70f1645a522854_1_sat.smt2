(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100100 #b010)
                arg1
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg1
                (fp #b0 #b101101 #b101)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110110 #b110)
                arg2
                (fp #b1 #b000000 #b101)))
(assert (fp.leq (fp #b1 #b000000 #b101)
                arg2
                (fp #b0 #b011100 #b100)))
; arg2 = -0.000000000582076609134674072265625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000011 #b010)
                arg3
                (fp #b0 #b111110 #b111)))
(assert (fp.leq (fp #b0 #b111110 #b111)
                arg3
                (fp #b0 #b111111 #b000)))
; arg3 = 4026531840.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b101110 #b001)
                expect
                (fp #b0 #b111110 #b110)))
(assert (fp.leq (fp #b0 #b111110 #b110)
                expect
                (fp #b0 #b111110 #b111)))
; expect = 3758096384.0

(assert (= expect result))

(check-sat)
(exit)
