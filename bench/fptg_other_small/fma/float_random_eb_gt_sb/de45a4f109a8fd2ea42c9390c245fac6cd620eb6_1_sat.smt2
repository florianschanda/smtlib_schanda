(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +ZERO
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01101110 #b01100)
                arg2
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                arg2
                (fp #b0 #b01010011 #b11110)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
