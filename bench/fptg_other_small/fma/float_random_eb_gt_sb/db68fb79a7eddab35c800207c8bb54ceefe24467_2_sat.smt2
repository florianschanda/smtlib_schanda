(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b1100 #b01)
                arg1
                (fp #b0 #b1110 #b11)))
(assert (fp.leq (fp #b0 #b1110 #b11)
                arg1
                (fp #b0 #b1111 #b00)))
; arg1 = 224.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b11)
                arg2
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                arg2
                (fp #b0 #b1000 #b11)))
; arg2 = 0.0078125

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0001 #b11)
                expect
                (fp #b0 #b0111 #b11)))
(assert (fp.leq (fp #b0 #b0111 #b11)
                expect
                (fp #b0 #b1111 #b00)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
