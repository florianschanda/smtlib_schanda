(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010010 #b011)
                arg1
                (fp #b0 #b000000 #b000)))
(assert (fp.leq (fp #b0 #b000000 #b000)
                arg1
                (fp #b0 #b001011 #b100)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010000 #b000)
                arg2
                (fp #b0 #b000000 #b010)))
(assert (fp.leq (fp #b0 #b000000 #b010)
                arg2
                (fp #b0 #b110100 #b101)))
; arg2 = 0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
