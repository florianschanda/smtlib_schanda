(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -INFINITY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111111 #b00)
                arg1
                (fp #b1 #b111110 #b11)))
(assert (fp.leq (fp #b1 #b111110 #b11)
                arg1
                (fp #b1 #b010011 #b10)))
; arg1 = -3758096384.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b01)
                arg3
                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg3
                (fp #b0 #b011101 #b01)))
; arg3 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
