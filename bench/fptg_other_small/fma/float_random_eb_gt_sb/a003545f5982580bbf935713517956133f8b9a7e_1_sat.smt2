(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10001 #b101)
                arg1
                (fp #b0 #b01101 #b001)))
(assert (fp.leq (fp #b0 #b01101 #b001)
                arg1
                (fp #b0 #b11010 #b011)))
; arg1 = 0.28125

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b100)
                arg2
                (fp #b1 #b11000 #b000)))
(assert (fp.leq (fp #b1 #b11000 #b000)
                arg2
                (fp #b0 #b11101 #b000)))
; arg2 = -512.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01111 #b001)
                arg3
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                arg3
                (fp #b0 #b11111 #b000)))
; arg3 = 61440.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b110)
                expect
                (fp #b0 #b11110 #b110)))
(assert (fp.leq (fp #b0 #b11110 #b110)
                expect
                (fp #b0 #b11111 #b000)))
; expect = 57344.0

(assert (= expect result))

(check-sat)
(exit)
