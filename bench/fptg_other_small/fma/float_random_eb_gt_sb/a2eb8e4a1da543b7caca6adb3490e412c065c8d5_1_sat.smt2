(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010010 #b1010)
                arg1
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                arg1
                (fp #b0 #b011011 #b0001)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001011 #b0110)
                arg2
                (fp #b0 #b100100 #b0000)))
(assert (fp.leq (fp #b0 #b100100 #b0000)
                arg2
                (fp #b0 #b101110 #b1000)))
; arg2 = 32.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b0111)
                arg3
                (fp #b1 #b111101 #b0000)))
(assert (fp.leq (fp #b1 #b111101 #b0000)
                arg3
                (fp #b0 #b101110 #b0100)))
; arg3 = -1073741824.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b0001)
                expect
                (fp #b1 #b111101 #b0000)))
(assert (fp.leq (fp #b1 #b111101 #b0000)
                expect
                (fp #b0 #b010111 #b0101)))
; expect = -1073741824.0

(assert (= expect result))

(check-sat)
(exit)
