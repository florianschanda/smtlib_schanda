(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10011010 #b01)
                arg1
                (fp #b0 #b11111101 #b00)))
(assert (fp.leq (fp #b0 #b11111101 #b00)
                arg1
                (fp #b0 #b11111101 #b10)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111101 #b01)
                arg2
                (fp #b0 #b00000000 #b10)))
(assert (fp.leq (fp #b0 #b00000000 #b10)
                arg2
                (fp #b0 #b10001010 #b01)))
; arg2 = 0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b00010010 #b11)
                arg3
                (fp #b0 #b10000010 #b00)))
(assert (fp.leq (fp #b0 #b10000010 #b00)
                arg3
                (fp #b0 #b11000011 #b10)))
; arg3 = 8.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111000 #b00)
                expect
                (fp #b0 #b10000010 #b01)))
(assert (fp.leq (fp #b0 #b10000010 #b01)
                expect
                (fp #b0 #b11110100 #b11)))
; expect = 10.0

(assert (= expect result))

(check-sat)
(exit)
