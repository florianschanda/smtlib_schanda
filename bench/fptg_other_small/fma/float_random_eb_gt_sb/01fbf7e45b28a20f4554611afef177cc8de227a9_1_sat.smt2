                arg3
                (fp #b0 #b00000000 #b0010)))
(assert (fp.leq (fp #b0 #b00000000 #b0010)
                arg3
                (fp #b0 #b10010100 #b1001)))
; arg3 = 0.000000000000000000000000000000000000001469367938527859384960920671527807097273331945965109401885939632848021574318408966064453125

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10110110 #b1000)
                expect
                (fp #b0 #b00000000 #b0010)))
(assert (fp.leq (fp #b0 #b00000000 #b0010)
                expect
                (fp #b0 #b11000110 #b1000)))
; expect = 0.000000000000000000000000000000000000001469367938527859384960920671527807097273331945965109401885939632848021574318408966064453125

(assert (= expect result))

(check-sat)
