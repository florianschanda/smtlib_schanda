; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1001001 #b1101)
                arg1
                (fp #b1 #b0000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000)
                arg1
                (fp #b0 #b1110111 #b1010)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0010110 #b0111)
                arg2
                (fp #b0 #b1111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111)
                arg2
                (fp #b0 #b1111111 #b0000)))
; arg2 = 17870283321406128128.0

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0110110 #b1011)
                arg3
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg3
                (fp #b0 #b0011000 #b1011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1001011 #b1000)
                expect
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                expect
                (fp #b0 #b0001000 #b1010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
