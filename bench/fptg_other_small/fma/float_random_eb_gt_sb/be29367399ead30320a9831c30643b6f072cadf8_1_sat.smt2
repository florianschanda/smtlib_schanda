(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -ZERO
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11000 #b10)
                arg1
                (fp #b0 #b01001 #b00)))
(assert (fp.leq (fp #b0 #b01001 #b00)
                arg1
                (fp #b0 #b11000 #b10)))
; arg1 = 0.015625

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01011 #b00)
                arg2
                (fp #b1 #b00000 #b00)))
(assert (fp.leq (fp #b1 #b00000 #b00)
                arg2
                (fp #b0 #b10000 #b10)))
; arg2 = -0

(declare-const arg3 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11111 #b00)
                arg3
                (fp #b1 #b11110 #b11)))
(assert (fp.leq (fp #b1 #b11110 #b11)
                arg3
                (fp #b0 #b00010 #b01)))
; arg3 = -57344.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11111 #b00)
                expect
                (fp #b1 #b11110 #b11)))
(assert (fp.leq (fp #b1 #b11110 #b11)
                expect
                (fp #b1 #b01010 #b11)))
; expect = -57344.0

(assert (= expect result))

(check-sat)
(exit)
