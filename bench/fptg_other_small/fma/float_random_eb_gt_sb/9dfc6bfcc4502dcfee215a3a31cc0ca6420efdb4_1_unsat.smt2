;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101110 #b000)
                arg1
                (fp #b0 #b010011 #b100)))
(assert (fp.leq (fp #b0 #b010011 #b100)
                arg1
                (fp #b0 #b111000 #b000)))
; arg1 = 0.0003662109375

(declare-const arg2 (_ FloatingPoint 6 4))
