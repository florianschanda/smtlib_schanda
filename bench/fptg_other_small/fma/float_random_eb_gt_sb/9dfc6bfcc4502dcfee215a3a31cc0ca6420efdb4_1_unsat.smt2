(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b110010 #b011)
                arg3
                (fp #b0 #b000000 #b000)))
(assert (fp.leq (fp #b0 #b000000 #b000)
                arg3
                (fp #b0 #b111101 #b011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110010 #b011)
                expect
                (fp #b0 #b001000 #b001)))
(assert (fp.leq (fp #b0 #b001000 #b001)
                expect
                (fp #b0 #b110001 #b101)))
; expect = 0.00000013411045074462890625

(assert (not (= expect result)))

(check-sat)
(exit)
