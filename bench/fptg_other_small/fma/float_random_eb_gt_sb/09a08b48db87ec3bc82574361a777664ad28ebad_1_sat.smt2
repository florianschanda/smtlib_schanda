; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b1011)
                arg1
                (fp #b1 #b110000 #b0011)))
(assert (fp.leq (fp #b1 #b110000 #b0011)
                arg1
                (fp #b0 #b001011 #b0000)))
; arg1 = -155648.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110101 #b1001)
                arg2
                (fp #b1 #b100111 #b1101)))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg2
                (fp #b1 #b000000 #b1011)))
; arg2 = -464.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100101 #b1100)
                arg3
                (fp #b1 #b000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg3
                (fp #b0 #b100000 #b0001)))
; arg3 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b011100 #b0111)
                expect
                (fp #b0 #b111001 #b0001)))
(assert (fp.leq (fp #b0 #b111001 #b0001)
                expect
                (fp #b0 #b111110 #b0000)))
; expect = 71303168.0

(assert (= expect result))

(check-sat)
(exit)
