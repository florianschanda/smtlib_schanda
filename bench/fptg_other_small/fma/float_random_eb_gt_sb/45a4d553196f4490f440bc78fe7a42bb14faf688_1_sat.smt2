(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0000110 #b0000)
                arg1
                (fp #b1 #b0000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000)
                arg1
                (fp #b0 #b0110101 #b1101)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111001 #b1000)
                arg2
                (fp #b1 #b1000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000100 #b0000)
                arg2
                (fp #b1 #b0011110 #b0010)))
; arg2 = -32.0

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0010110 #b0000)
                arg3
                (fp #b0 #b0111110 #b1000)))
(assert (fp.leq (fp #b0 #b0111110 #b1000)
                arg3
                (fp #b0 #b1010011 #b0101)))
; arg3 = 0.75

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0101111 #b1101)
                expect
                (fp #b0 #b0111110 #b1000)))
(assert (fp.leq (fp #b0 #b0111110 #b1000)
                expect
                (fp #b0 #b1011111 #b0000)))
; expect = 0.75

(assert (= expect result))

(check-sat)
(exit)
