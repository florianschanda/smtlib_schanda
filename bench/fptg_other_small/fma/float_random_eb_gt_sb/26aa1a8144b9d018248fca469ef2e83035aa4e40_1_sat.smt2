(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                arg1
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                arg1
                (fp #b1 #b01100010 #b011)))
; arg1 = -319014718988379809496913694467282698240.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01100111 #b011)
                arg2
                (fp #b1 #b00000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000 #b101)
                arg2
                (fp #b0 #b00111101 #b001)))
; arg2 = -0.000000000000000000000000000000000000007346839692639296924804603357639035486366659729825547009429698164240107871592044830322265625

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01010110 #b100)
                expect
                (fp #b0 #b10000000 #b001)))
(assert (fp.leq (fp #b0 #b10000000 #b001)
                expect
                (fp #b0 #b11000100 #b001)))
; expect = 2.25

(assert (= expect result))

(check-sat)
(exit)
