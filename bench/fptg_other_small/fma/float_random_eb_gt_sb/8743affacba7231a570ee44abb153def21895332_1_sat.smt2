(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b01001011 #b0)
                arg1
                (fp #b1 #b00000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000 #b1)
                arg1
                (fp #b0 #b00101101 #b0)))
; arg1 = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11111110 #b1)
                arg2
                (fp #b0 #b11111101 #b0)))
(assert (fp.leq (fp #b0 #b11111101 #b0)
                arg2
                (fp #b0 #b11111111 #b0)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001001 #b0)
                arg3
                (fp #b0 #b10000001 #b0)))
(assert (fp.leq (fp #b0 #b10000001 #b0)
                arg3
                (fp #b0 #b11100100 #b1)))
; arg3 = 4.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b00010010 #b1)
                expect
                (fp #b0 #b10000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000 #b1)
                expect
                (fp #b0 #b11110100 #b0)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
