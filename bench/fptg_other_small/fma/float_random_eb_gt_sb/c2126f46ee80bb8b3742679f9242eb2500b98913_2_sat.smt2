                arg2
                (fp #b1 #b01100011 #b01)))
(assert (fp.leq (fp #b1 #b01100011 #b01)
                arg2
                (fp #b0 #b11001010 #b00)))
; arg2 = -0.000000004656612873077392578125

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b10011000 #b00)
                expect
                (fp #b0 #b11100001 #b01)))
(assert (fp.leq (fp #b0 #b11100001 #b01)
                expect
                (fp #b0 #b11110111 #b10)))
; expect = 396140812571321687967719751680.0

(assert (= expect result))

(check-sat)
(exit)
