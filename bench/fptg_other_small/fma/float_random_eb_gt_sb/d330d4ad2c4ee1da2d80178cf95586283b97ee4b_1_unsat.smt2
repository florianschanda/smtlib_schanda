(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +ZERO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1101111 #b0)
                arg2
                (fp #b0 #b0000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000 #b0)
                arg2
                (fp #b0 #b0111111 #b1)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 7 2))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0100101 #b1)
                arg3
                (fp #b0 #b0000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000 #b0)
                arg3
                (fp #b0 #b1100001 #b1)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
