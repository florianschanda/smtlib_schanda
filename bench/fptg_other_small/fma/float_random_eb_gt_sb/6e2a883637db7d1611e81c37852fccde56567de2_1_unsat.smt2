(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b100 #b1)
                arg1
                (fp #b0 #b000 #b0)))
(assert (fp.leq (fp #b0 #b000 #b0)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg2
                (fp #b1 #b101 #b0)))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg2
                (fp #b0 #b001 #b0)))
; arg2 = -4.0

(declare-const arg3 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b1)
                arg3
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                arg3
                (fp #b0 #b110 #b0)))
; arg3 = 4.0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b000 #b0)
                expect
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                expect
                (fp #b0 #b110 #b1)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
