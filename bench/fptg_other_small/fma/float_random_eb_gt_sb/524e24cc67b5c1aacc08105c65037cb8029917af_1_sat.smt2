(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000110 #b1)
                arg1
                (fp #b1 #b000000 #b0)))
(assert (fp.leq (fp #b1 #b000000 #b0)
                arg1
                (fp #b0 #b011111 #b0)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111110 #b1)
                arg2
                (fp #b1 #b111101 #b0)))
(assert (fp.leq (fp #b1 #b111101 #b0)
                arg2
                (fp #b0 #b111010 #b1)))
; arg2 = -1073741824.0

(declare-const arg3 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111111 #b0)
                arg3
                (fp #b1 #b111110 #b0)))
(assert (fp.leq (fp #b1 #b111110 #b0)
                arg3
                (fp #b0 #b000010 #b1)))
; arg3 = -2147483648.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111111 #b0)
                expect
                (fp #b1 #b111110 #b0)))
(assert (fp.leq (fp #b1 #b111110 #b0)
                expect
                (fp #b1 #b100111 #b0)))
; expect = -2147483648.0

(assert (= expect result))

(check-sat)
(exit)
