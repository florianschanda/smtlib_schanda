(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100010 #b1010)
                arg1
                (fp #b1 #b000101 #b1110)))
(assert (fp.leq (fp #b1 #b000101 #b1110)
                arg1
