(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010111 #b1100)
                arg3
                (fp #b0 #b100100 #b0000)))
(assert (fp.leq (fp #b0 #b100100 #b0000)
                arg3
                (fp #b0 #b100111 #b0011)))
; arg3 = 32.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
