(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111011 #b11)
                arg1
                (fp #b1 #b00000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000 #b00)
                arg1
                (fp #b0 #b11010011 #b11)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01001011 #b11)
                arg2
                (fp #b0 #b10010000 #b00)))
(assert (fp.leq (fp #b0 #b10010000 #b00)
                arg2
                (fp #b0 #b11010011 #b10)))
; arg2 = 131072.0

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b00001010 #b01)
                arg3
                (fp #b1 #b00000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000 #b10)
                arg3
                (fp #b0 #b00000101 #b10)))
; arg3 = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01101101 #b01)
                expect
                (fp #b1 #b00000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000 #b10)
                expect
                (fp #b0 #b10111111 #b00)))
; expect = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(assert (= expect result))

(check-sat)
(exit)
