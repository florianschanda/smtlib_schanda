(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg1
                (fp #b1 #b11011 #b10)))
(assert (fp.leq (fp #b1 #b11011 #b10)
                arg1
                (fp #b1 #b10111 #b11)))
; arg1 = -6144.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11010 #b01)
                arg3
                (fp #b1 #b10001 #b11)))
(assert (fp.leq (fp #b1 #b10001 #b11)
                arg3
                (fp #b0 #b00110 #b11)))
; arg3 = -7.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11111 #b00)
                expect
                (fp #b1 #b11110 #b11)))
(assert (fp.leq (fp #b1 #b11110 #b11)
                expect
                (fp #b1 #b00111 #b00)))
; expect = -57344.0

(assert (not (= expect result)))

(check-sat)
(exit)
