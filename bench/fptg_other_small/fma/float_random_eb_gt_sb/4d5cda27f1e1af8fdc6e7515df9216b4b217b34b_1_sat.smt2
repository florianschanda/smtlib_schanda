(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg1
                (fp #b1 #b1110 #b01)))
(assert (fp.leq (fp #b1 #b1110 #b01)
                arg1
                (fp #b0 #b1001 #b00)))
; arg1 = -160.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0010 #b00)
                arg2
                (fp #b0 #b0001 #b11)))
(assert (fp.leq (fp #b0 #b0001 #b11)
                arg2
                (fp #b0 #b0101 #b11)))
; arg2 = 0.02734375

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b01)
                arg3
                (fp #b0 #b1110 #b11)))
(assert (fp.leq (fp #b0 #b1110 #b11)
                arg3
                (fp #b0 #b1111 #b00)))
; arg3 = 224.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0001 #b11)
                expect
                (fp #b0 #b1110 #b10)))
(assert (fp.leq (fp #b0 #b1110 #b10)
                expect
                (fp #b0 #b1111 #b00)))
; expect = 192.0

(assert (= expect result))

(check-sat)
(exit)
