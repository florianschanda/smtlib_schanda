                arg2
                (fp #b0 #b00000 #b110)))
(assert (fp.leq (fp #b0 #b00000 #b110)
                arg2
                (fp #b0 #b00111 #b001)))
; arg2 = 0.0000457763671875

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
