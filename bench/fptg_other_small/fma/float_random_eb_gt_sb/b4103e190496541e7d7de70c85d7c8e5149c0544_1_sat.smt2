(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10001111 #b010)
                arg1
                (fp #b1 #b01110010 #b110)))
(assert (fp.leq (fp #b1 #b01110010 #b110)
                arg1
                (fp #b0 #b10010011 #b110)))
; arg1 = -0.000213623046875

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010011 #b111)
                arg2
                (fp #b1 #b10001111 #b000)))
(assert (fp.leq (fp #b1 #b10001111 #b000)
                arg2
                (fp #b0 #b11100100 #b110)))
; arg2 = -65536.0

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110111 #b011)
                expect
                (fp #b1 #b10001110 #b111)))
(assert (fp.leq (fp #b1 #b10001110 #b111)
                expect
                (fp #b1 #b10000101 #b101)))
; expect = -61440.0

(assert (= expect result))

(check-sat)
(exit)
