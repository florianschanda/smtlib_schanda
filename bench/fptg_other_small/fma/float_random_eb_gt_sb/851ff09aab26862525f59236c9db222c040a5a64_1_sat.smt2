(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001010 #b111)
                arg1
                (fp #b0 #b000000 #b110)))
(assert (fp.leq (fp #b0 #b000000 #b110)
                arg1
                (fp #b0 #b100101 #b000)))
; arg1 = 0.00000000069849193096160888671875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b100)
                arg2
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg2
                (fp #b1 #b011100 #b101)))
; arg2 = -1073741824.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b111)
                arg3
                (fp #b0 #b000000 #b010)))
(assert (fp.leq (fp #b0 #b000000 #b010)
                arg3
                (fp #b0 #b010111 #b111)))
; arg3 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100101 #b010)
                expect
                (fp #b1 #b011110 #b011)))
(assert (fp.leq (fp #b1 #b011110 #b011)
                expect
                (fp #b1 #b001000 #b100)))
; expect = -0.6875

(assert (= expect result))

(check-sat)
(exit)
