; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b001001 #b101)
                arg1
                (fp #b0 #b010011 #b100)))
(assert (fp.leq (fp #b0 #b010011 #b100)
                arg1
                (fp #b0 #b111100 #b001)))
; arg1 = 0.0003662109375

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b110)
                arg2
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg2
                (fp #b0 #b010100 #b101)))
; arg2 = -1073741824.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000101 #b111)
                arg3
                (fp #b0 #b111110 #b111)))
(assert (fp.leq (fp #b0 #b111110 #b111)
                arg3
                (fp #b0 #b111111 #b000)))
; arg3 = 4026531840.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b110000 #b001)
                expect
                (fp #b0 #b111110 #b110)))
(assert (fp.leq (fp #b0 #b111110 #b110)
                expect
                (fp #b0 #b111110 #b111)))
; expect = 3758096384.0

(assert (= expect result))

(check-sat)
(exit)
