(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b011 #b0)
                arg2
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                arg2
                (fp #b0 #b101 #b1)))
; arg2 = 4.0

(declare-const arg3 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b010 #b1)
                arg3
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                arg3
                (fp #b0 #b110 #b1)))
; arg3 = 4.0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
