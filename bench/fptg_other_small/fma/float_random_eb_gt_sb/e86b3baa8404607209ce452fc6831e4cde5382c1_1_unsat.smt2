(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b111)
                arg1
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg1
                (fp #b0 #b11101 #b111)))
; arg1 = -16384.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b11010 #b001)
                arg2
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                arg2
                (fp #b0 #b11111 #b000)))
; arg2 = 61440.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11010 #b110)
                arg3
                (fp #b1 #b00000 #b100)))
(assert (fp.leq (fp #b1 #b00000 #b100)
                arg3
                (fp #b0 #b00000 #b111)))
; arg3 = -0.000030517578125

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                expect
                (fp #b1 #b11110 #b111)))
(assert (fp.leq (fp #b1 #b11110 #b111)
                expect
                (fp #b1 #b00111 #b111)))
; expect = -61440.0

(assert (not (= expect result)))

(check-sat)
(exit)
