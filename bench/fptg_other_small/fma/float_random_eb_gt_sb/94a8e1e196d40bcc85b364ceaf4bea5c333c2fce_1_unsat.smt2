; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010101 #b101)
                arg2
                (fp #b1 #b000000 #b101)))
(assert (fp.leq (fp #b1 #b000000 #b101)
                arg2
                (fp #b0 #b000110 #b010)))
; arg2 = -0.000000000582076609134674072265625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b101001 #b011)
                arg3
                (fp #b0 #b111101 #b000)))
(assert (fp.leq (fp #b0 #b111101 #b000)
                arg3
                (fp #b0 #b111110 #b001)))
; arg3 = 1073741824.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
