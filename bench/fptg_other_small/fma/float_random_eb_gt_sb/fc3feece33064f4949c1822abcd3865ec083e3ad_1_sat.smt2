(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11100011 #b111011)
                arg3
                (fp #b1 #b00100110 #b011111)))
(assert (fp.leq (fp #b1 #b00100110 #b011111)
                arg3
                (fp #b0 #b10010101 #b000110)))
; arg3 = -0.00000000000000000000000000239813715187187588845165483845967013820654756273142993450164794921875

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
