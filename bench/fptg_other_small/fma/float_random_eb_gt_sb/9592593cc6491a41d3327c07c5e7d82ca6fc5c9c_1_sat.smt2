                arg3
                (fp #b1 #b0010110 #b0100)))
(assert (fp.leq (fp #b1 #b0010110 #b0100)
                arg3
                (fp #b0 #b1011011 #b1100)))
; arg3 = -0.0000000000005684341886080801486968994140625

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101000 #b0001)
                expect
                (fp #b1 #b1001001 #b0000)))
(assert (fp.leq (fp #b1 #b1001001 #b0000)
                expect
                (fp #b1 #b0000011 #b1011)))
; expect = -1024.0

(assert (= expect result))

(check-sat)
(exit)
