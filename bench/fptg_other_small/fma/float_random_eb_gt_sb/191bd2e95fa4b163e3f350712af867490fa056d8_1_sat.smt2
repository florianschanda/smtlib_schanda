(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101110 #b011)
                arg1
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg1
                (fp #b0 #b010001 #b110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111100 #b101)
                arg2
                (fp #b1 #b110110 #b010)))
(assert (fp.leq (fp #b1 #b110110 #b010)
                arg2
                (fp #b0 #b001010 #b101)))
; arg2 = -10485760.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111001 #b001)
                expect
                (fp #b1 #b110110 #b010)))
(assert (fp.leq (fp #b1 #b110110 #b010)
                expect
                (fp #b1 #b100110 #b101)))
; expect = -10485760.0

(assert (= expect result))

(check-sat)
(exit)
