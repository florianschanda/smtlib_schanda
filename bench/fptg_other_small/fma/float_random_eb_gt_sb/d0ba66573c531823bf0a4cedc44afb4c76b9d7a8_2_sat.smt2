(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                arg1
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                arg1
                (fp #b0 #b01010111 #b110)))
; arg1 = -319014718988379809496913694467282698240.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10010111 #b101)
                arg2
                (fp #b0 #b00000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000 #b110)
                arg2
                (fp #b0 #b10010111 #b001)))
; arg2 = 0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11001001 #b110)
                expect
                (fp #b1 #b10000000 #b100)))
(assert (fp.leq (fp #b1 #b10000000 #b100)
                expect
                (fp #b0 #b10010111 #b010)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
