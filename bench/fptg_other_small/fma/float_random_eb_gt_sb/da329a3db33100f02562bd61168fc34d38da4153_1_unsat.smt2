(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01001110 #b0111)
                arg2
                (fp #b0 #b10000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000100 #b0000)
                arg2
                (fp #b0 #b10011000 #b0101)))
; arg2 = 32.0

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00011000 #b0111)
                arg3
                (fp #b0 #b10000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000100 #b0000)
                arg3
                (fp #b0 #b10100000 #b1100)))
; arg3 = 32.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
