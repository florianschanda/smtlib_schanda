(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01001 #b1)
                arg1
                (fp #b0 #b00011 #b0)))
(assert (fp.leq (fp #b0 #b00011 #b0)
                arg1
                (fp #b0 #b10011 #b0)))
; arg1 = 0.000244140625

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b1)
                arg2
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg2
                (fp #b0 #b10001 #b0)))
; arg2 = -4.0

(declare-const arg3 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg3
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg3
                (fp #b0 #b10010 #b0)))
; arg3 = -4.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b0)
                expect
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                expect
                (fp #b0 #b10001 #b1)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
