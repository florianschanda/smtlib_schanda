(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b10)
                arg1
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                arg1
                (fp #b0 #b0001 #b10)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0010 #b11)
                arg2
                (fp #b1 #b0000 #b10)))
(assert (fp.leq (fp #b1 #b0000 #b10)
                arg2
                (fp #b0 #b1110 #b10)))
; arg2 = -0.0078125

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0011 #b00)
                arg3
                (fp #b0 #b0100 #b01)))
(assert (fp.leq (fp #b0 #b0100 #b01)
                arg3
                (fp #b0 #b1001 #b10)))
; arg3 = 0.15625

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0100 #b00)
                expect
                (fp #b0 #b0100 #b00)))
(assert (fp.leq (fp #b0 #b0100 #b00)
                expect
                (fp #b0 #b1101 #b00)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
