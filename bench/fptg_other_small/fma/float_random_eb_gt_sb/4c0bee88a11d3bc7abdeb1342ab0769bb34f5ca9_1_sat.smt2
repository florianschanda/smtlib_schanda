(assert (fp.leq (fp #b0 #b00000000 #b0)
                arg3
                (fp #b0 #b01000110 #b0)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
