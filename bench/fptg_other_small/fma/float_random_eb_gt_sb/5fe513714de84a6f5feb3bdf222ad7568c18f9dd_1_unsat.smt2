                arg3
                (fp #b1 #b110101 #b000)))
(assert (fp.leq (fp #b1 #b110101 #b000)
                arg3
                (fp #b0 #b001011 #b111)))
; arg3 = -4194304.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b000)
                expect
                (fp #b1 #b110101 #b000)))
(assert (fp.leq (fp #b1 #b110101 #b000)
                expect
                (fp #b0 #b011010 #b110)))
; expect = -4194304.0

(assert (not (= expect result)))

