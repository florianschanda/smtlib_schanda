(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1011001 #b0)
                arg1
                (fp #b0 #b0111101 #b1)))
(assert (fp.leq (fp #b0 #b0111101 #b1)
                arg1
                (fp #b0 #b1111100 #b1)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 7 2))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0000100 #b0)
                arg3
                (fp #b1 #b0000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000 #b0)
                arg3
                (fp #b0 #b0101110 #b0)))
; arg3 = -0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0011101 #b0)
                expect
                (fp #b0 #b0111100 #b1)))
(assert (fp.leq (fp #b0 #b0111100 #b1)
                expect
                (fp #b0 #b1000111 #b1)))
; expect = 0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
