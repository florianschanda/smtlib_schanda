; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01000001 #b1111)
                arg2
                (fp #b0 #b10000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000100 #b0000)
                arg2
                (fp #b0 #b11101110 #b0100)))
; arg2 = 32.0

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11000111 #b1010)
                arg3
                (fp #b0 #b11110011 #b0011)))
(assert (fp.leq (fp #b0 #b11110011 #b0011)
                arg3
                (fp #b0 #b11110101 #b0100)))
; arg3 = 98653640312161724942079430255181824.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
