                (fp #b0 #b111101 #b0000)))
(assert (fp.leq (fp #b0 #b111101 #b0000)
                arg2
                (fp #b0 #b111110 #b0110)))
; arg2 = 1073741824.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111001 #b1010)
                arg3
                (fp #b1 #b000000 #b1011)))
(assert (fp.leq (fp #b1 #b000000 #b1011)
                arg3
                (fp #b0 #b011101 #b0101)))
; arg3 = -0.0000000006402842700481414794921875

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010110 #b0111)
                expect
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                expect
                (fp #b0 #b111111 #b0000)))
; expect = 4160749568.0

(assert (not (= expect result)))

(check-sat)
(exit)
