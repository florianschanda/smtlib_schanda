(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110011 #b011)
                arg1
                (fp #b0 #b101100 #b010)))
(assert (fp.leq (fp #b0 #b101100 #b010)
                arg1
                (fp #b0 #b110100 #b101)))
; arg1 = 10240.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010010 #b000)
                arg2
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg2
                (fp #b0 #b110100 #b111)))
; arg2 = 16.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100100 #b110)
                arg3
                (fp #b0 #b111011 #b101)))
(assert (fp.leq (fp #b0 #b111011 #b101)
                arg3
                (fp #b0 #b111101 #b101)))
; arg3 = 436207616.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b110)
                expect
                (fp #b0 #b111011 #b101)))
(assert (fp.leq (fp #b0 #b111011 #b101)
                expect
                (fp #b0 #b111110 #b010)))
; expect = 436207616.0

(assert (= expect result))

(check-sat)
(exit)
