(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111111 #b00)
                arg1
                (fp #b1 #b1111110 #b11)))
(assert (fp.leq (fp #b1 #b1111110 #b11)
                arg1
                (fp #b1 #b0100111 #b01)))
; arg1 = -16140901064495857664.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010011 #b11)
                arg2
                (fp #b0 #b0000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000 #b01)
                arg2
                (fp #b0 #b1111101 #b11)))
; arg2 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg3 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1100011 #b11)
                arg3
                (fp #b0 #b1000001 #b10)))
(assert (fp.leq (fp #b0 #b1000001 #b10)
                arg3
                (fp #b0 #b1110011 #b10)))
; arg3 = 6.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1110100 #b00)
                expect
                (fp #b0 #b1000001 #b01)))
(assert (fp.leq (fp #b0 #b1000001 #b01)
                expect
                (fp #b0 #b1000001 #b11)))
; expect = 5.0

(assert (= expect result))

(check-sat)
(exit)
