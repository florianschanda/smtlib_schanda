; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b001)
                arg1
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg1
                (fp #b1 #b100010 #b101)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111001 #b001)
                arg2
                (fp #b1 #b000000 #b010)))
(assert (fp.leq (fp #b1 #b000000 #b010)
                arg2
                (fp #b0 #b110011 #b010)))
; arg2 = -0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111111 #b000)
                arg3
                (fp #b1 #b111110 #b111)))
(assert (fp.leq (fp #b1 #b111110 #b111)
                arg3
                (fp #b1 #b011001 #b010)))
; arg3 = -4026531840.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111111 #b000)
                expect
                (fp #b1 #b111110 #b111)))
(assert (fp.leq (fp #b1 #b111110 #b111)
                expect
                (fp #b1 #b101001 #b101)))
; expect = -4026531840.0

(assert (not (= expect result)))

(check-sat)
(exit)
