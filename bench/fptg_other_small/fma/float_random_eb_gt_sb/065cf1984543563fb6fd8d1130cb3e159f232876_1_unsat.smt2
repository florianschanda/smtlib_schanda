(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110111 #b1)
                arg1
                (fp #b1 #b100110 #b1)))
(assert (fp.leq (fp #b1 #b100110 #b1)
                arg1
                (fp #b1 #b010111 #b0)))
; arg1 = -192.0

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111011 #b1)
                arg2
                (fp #b1 #b100001 #b0)))
(assert (fp.leq (fp #b1 #b100001 #b0)
                arg2
                (fp #b0 #b011001 #b1)))
; arg2 = -4.0

(declare-const arg3 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001000 #b0)
                arg3
                (fp #b0 #b010011 #b0)))
(assert (fp.leq (fp #b0 #b010011 #b0)
                arg3
                (fp #b0 #b110100 #b1)))
; arg3 = 0.000244140625

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b011001 #b1)
                expect
                (fp #b0 #b101000 #b1)))
(assert (fp.leq (fp #b0 #b101000 #b1)
                expect
                (fp #b0 #b101011 #b0)))
; expect = 768.0

(assert (not (= expect result)))

(check-sat)
(exit)
