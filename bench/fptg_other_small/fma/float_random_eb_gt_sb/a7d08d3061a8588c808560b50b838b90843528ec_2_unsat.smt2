(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111000 #b10)
                arg1
                (fp #b1 #b11110110 #b00)))
(assert (fp.leq (fp #b1 #b11110110 #b00)
                arg1
                (fp #b0 #b01101100 #b00)))
; arg1 = -664613997892457936451903530140172288.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11110111 #b00)
                arg2
                (fp #b1 #b11101010 #b01)))
(assert (fp.leq (fp #b1 #b11101010 #b01)
                arg2
                (fp #b0 #b11010000 #b00)))
; arg2 = -202824096036516704239472512860160.0

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
