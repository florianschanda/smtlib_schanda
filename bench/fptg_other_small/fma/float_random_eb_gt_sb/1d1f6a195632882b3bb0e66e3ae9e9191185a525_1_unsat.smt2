(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1110 #b1)
                arg1
                (fp #b1 #b1001 #b0)))
(assert (fp.leq (fp #b1 #b1001 #b0)
                arg1
                (fp #b0 #b1000 #b1)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0101 #b0)
                arg2
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg2
                (fp #b0 #b1011 #b0)))
; arg2 = 0.0078125

(declare-const arg3 (_ FloatingPoint 4 2))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
