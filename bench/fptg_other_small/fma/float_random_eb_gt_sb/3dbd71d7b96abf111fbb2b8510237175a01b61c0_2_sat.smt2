(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b011011 #b11)
                arg1
                (fp #b0 #b010110 #b10)))
(assert (fp.leq (fp #b0 #b010110 #b10)
                arg1
                (fp #b0 #b100110 #b01)))
; arg1 = 0.0029296875

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110110 #b00)
                arg2
                (fp #b1 #b001110 #b10)))
(assert (fp.leq (fp #b1 #b001110 #b10)
                arg2
                (fp #b0 #b010010 #b00)))
; arg2 = -0.000011444091796875

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100100 #b11)
                expect
                (fp #b1 #b001110 #b11)))
(assert (fp.leq (fp #b1 #b001110 #b11)
                expect
                (fp #b0 #b111011 #b00)))
; expect = -0.0000133514404296875

(assert (= expect result))

(check-sat)
(exit)
