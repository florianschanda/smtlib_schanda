(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01111110 #b001010)
                arg2
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg2
                (fp #b0 #b11111001 #b011101)))
; arg2 = 128.0

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00101101 #b101111)
                arg3
                (fp #b1 #b00000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000)
                arg3
                (fp #b0 #b01011100 #b010010)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
