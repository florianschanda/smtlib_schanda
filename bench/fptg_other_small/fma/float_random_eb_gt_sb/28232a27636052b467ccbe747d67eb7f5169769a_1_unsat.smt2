; arg2 = -16384.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg3
                (fp #b1 #b11110 #b111)))
(assert (fp.leq (fp #b1 #b11110 #b111)
                arg3
                (fp #b1 #b01100 #b101)))
; arg3 = -61440.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10111 #b110)
                expect
                (fp #b0 #b11110 #b111)))
(assert (fp.leq (fp #b0 #b11110 #b111)
                expect
                (fp #b0 #b11111 #b000)))
; expect = 61440.0

(assert (not (= expect result)))

(check-sat)
(exit)
