(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00101010 #b111101)
                arg1
                (fp #b1 #b00000000 #b011011)))
(assert (fp.leq (fp #b1 #b00000000 #b011011)
                arg1
                (fp #b0 #b00101001 #b111111)))
; arg1 = -0.000000000000000000000000000000000000004959116792531525424243107266406348953297495317632244231365046260862072813324630260467529296875

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11011100 #b100111)
                arg3
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg3
                (fp #b0 #b10011101 #b110100)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11101111 #b001100)
                expect
                (fp #b0 #b10000101 #b111111)))
(assert (fp.leq (fp #b0 #b10000101 #b111111)
                expect
                (fp #b0 #b11100101 #b010101)))
; expect = 127.0

(assert (= expect result))

(check-sat)
(exit)
