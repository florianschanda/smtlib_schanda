                arg3
                (fp #b0 #b00000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000 #b0100)
                arg3
                (fp #b0 #b01000000 #b1001)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b11001000 #b1011)
                expect
                (fp #b0 #b11111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111)
                expect
                (fp #b0 #b11111111 #b0000)))
; expect = 329648542954659136480144150949525454848.0

(assert (= expect result))

