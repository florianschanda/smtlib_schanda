; arg1 = -128.0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01101111 #b010101)
                arg2
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg2
                (fp #b0 #b11111110 #b100100)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
