(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10000111 #b111100)
                arg2
                (fp #b0 #b10100101 #b111111)))
(assert (fp.leq (fp #b0 #b10100101 #b111111)
                arg2
                (fp #b0 #b11100100 #b010110)))
; arg2 = 545460846592.0

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
