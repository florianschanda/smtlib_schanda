(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10001011 #b101)
                arg1
                (fp #b0 #b00111000 #b111)))
(assert (fp.leq (fp #b0 #b00111000 #b111)
                arg1
                (fp #b0 #b01011100 #b000)))
; arg1 = 0.00000000000000000000079409338805090656787655234438716433942317962646484375

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00111010 #b110)
                arg3
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg3
                (fp #b0 #b10111101 #b000)))
; arg3 = 16.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111101 #b000)
                expect
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                expect
                (fp #b0 #b11001111 #b111)))
; expect = 16.0

(assert (not (= expect result)))

(check-sat)
(exit)
