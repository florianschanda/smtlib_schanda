; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b101)
                arg1
                (fp #b0 #b11101 #b000)))
(assert (fp.leq (fp #b0 #b11101 #b000)
                arg1
                (fp #b0 #b11101 #b110)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10110 #b011)
                arg2
                (fp #b0 #b00000 #b010)))
(assert (fp.leq (fp #b0 #b00000 #b010)
                arg2
                (fp #b0 #b01001 #b100)))
; arg2 = 0.0000152587890625

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01110 #b000)
                arg3
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                arg3
                (fp #b0 #b11110 #b110)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00001 #b011)
                expect
                (fp #b0 #b01101 #b000)))
(assert (fp.leq (fp #b0 #b01101 #b000)
                expect
                (fp #b0 #b10000 #b000)))
; expect = 0.25

(assert (not (= expect result)))

(check-sat)
(exit)
