(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0111111 #b10)
                arg1
                (fp #b0 #b1111010 #b01)))
(assert (fp.leq (fp #b0 #b1111010 #b01)
                arg1
                (fp #b0 #b1111011 #b00)))
; arg1 = 720575940379279360.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111111 #b00)
                arg2
                (fp #b1 #b1111110 #b11)))
(assert (fp.leq (fp #b1 #b1111110 #b11)
                arg2
                (fp #b0 #b0011010 #b00)))
; arg2 = -16140901064495857664.0

(declare-const arg3 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101110 #b10)
                arg3
                (fp #b0 #b1111101 #b00)))
(assert (fp.leq (fp #b0 #b1111101 #b00)
                arg3
                (fp #b0 #b1111101 #b01)))
; arg3 = 4611686018427387904.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
