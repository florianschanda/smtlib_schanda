                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg2
                (fp #b0 #b011111 #b10)))
; arg2 = 0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101001 #b10)
                arg3
                (fp #b1 #b100010 #b00)))
(assert (fp.leq (fp #b1 #b100010 #b00)
                arg3
                (fp #b1 #b011100 #b11)))
; arg3 = -8.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100100 #b11)
                expect
                (fp #b1 #b100010 #b01)))
(assert (fp.leq (fp #b1 #b100010 #b01)
                expect
                (fp #b0 #b000100 #b11)))
; expect = -10.0

(assert (not (= expect result)))

(check-sat)
