(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100110 #b0011)
                arg1
                (fp #b1 #b1100000 #b1101)))
(assert (fp.leq (fp #b1 #b1100000 #b1101)
                arg1
                (fp #b0 #b0001101 #b1011)))
; arg1 = -15569256448.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100011 #b0000)
                arg2
                (fp #b0 #b1111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000)
                arg2
                (fp #b0 #b1111110 #b0101)))
; arg2 = 4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1111100 #b0011)
                arg3
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg3
                (fp #b0 #b0000111 #b1011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
