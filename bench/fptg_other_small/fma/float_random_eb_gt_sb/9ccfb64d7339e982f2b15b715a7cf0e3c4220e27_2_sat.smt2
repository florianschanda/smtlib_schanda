(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b011001 #b1010)
                arg1
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                arg1
                (fp #b0 #b111111 #b0000)))
; arg1 = 4160749568.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110101 #b0011)
                arg2
                (fp #b1 #b100111 #b1101)))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg2
                (fp #b1 #b001110 #b1111)))
; arg2 = -464.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111100 #b1110)
                arg3
                (fp #b1 #b001001 #b1110)))
(assert (fp.leq (fp #b1 #b001001 #b1110)
                arg3
                (fp #b0 #b001000 #b1010)))
; arg3 = -0.0000004470348358154296875

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
