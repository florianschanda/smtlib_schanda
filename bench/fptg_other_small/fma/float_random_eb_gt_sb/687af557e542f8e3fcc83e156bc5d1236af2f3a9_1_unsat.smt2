(assert (fp.leq (fp #b1 #b01101101 #b101100)
                arg3
                (fp #b1 #b00000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000)
                arg3
                (fp #b0 #b11111011 #b000010)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10000000 #b110101)
                expect
