(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10110 #b10)
                arg1
                (fp #b1 #b10010 #b00)))
(assert (fp.leq (fp #b1 #b10010 #b00)
                arg1
                (fp #b0 #b01100 #b01)))
; arg1 = -8.0

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b11)
                arg2
                (fp #b1 #b10100 #b11)))
(assert (fp.leq (fp #b1 #b10100 #b11)
                arg2
                (fp #b1 #b01111 #b11)))
; arg2 = -56.0

(declare-const arg3 (_ FloatingPoint 5 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00011 #b00)
                expect
                (fp #b0 #b10111 #b11)))
(assert (fp.leq (fp #b0 #b10111 #b11)
                expect
                (fp #b0 #b11110 #b10)))
; expect = 448.0

(assert (not (= expect result)))

(check-sat)
(exit)
