(declare-const arg3 (_ FloatingPoint 7 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110101 #b1101)
                expect
                (fp #b1 #b0111110 #b1100)))
(assert (fp.leq (fp #b1 #b0111110 #b1100)
                expect
                (fp #b0 #b0110000 #b1111)))
; expect = -0.875

(assert (= expect result))

(check-sat)
