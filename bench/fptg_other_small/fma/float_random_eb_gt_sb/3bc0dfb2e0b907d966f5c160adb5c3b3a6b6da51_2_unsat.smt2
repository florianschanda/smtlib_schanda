(assert (fp.leq (fp #b1 #b0000100 #b0)
                arg3
                (fp #b0 #b0000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000 #b0)
                arg3
                (fp #b0 #b0111001 #b0)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111111 #b0)
                expect
                (fp #b1 #b0000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000 #b0)
                expect
                (fp #b0 #b1010000 #b1)))
; expect = -0

