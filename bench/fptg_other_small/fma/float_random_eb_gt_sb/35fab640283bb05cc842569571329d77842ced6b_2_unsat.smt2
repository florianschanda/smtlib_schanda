; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b100)
                arg1
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg1
                (fp #b1 #b110100 #b010)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111001 #b100)
                arg2
                (fp #b0 #b000000 #b010)))
(assert (fp.leq (fp #b0 #b000000 #b010)
                arg2
                (fp #b0 #b010011 #b001)))
; arg2 = 0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg3
                (fp #b1 #b110101 #b000)))
(assert (fp.leq (fp #b1 #b110101 #b000)
                arg3
                (fp #b1 #b010010 #b001)))
; arg3 = -4194304.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b010)
                expect
                (fp #b1 #b110101 #b001)))
(assert (fp.leq (fp #b1 #b110101 #b001)
                expect
                (fp #b0 #b001001 #b001)))
; expect = -4718592.0

(assert (not (= expect result)))

(check-sat)
(exit)
