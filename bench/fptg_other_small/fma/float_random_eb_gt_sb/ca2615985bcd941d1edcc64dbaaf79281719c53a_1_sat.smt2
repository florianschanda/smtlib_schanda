                arg2
                (fp #b1 #b110110 #b010)))
(assert (fp.leq (fp #b1 #b110110 #b010)
                arg2
                (fp #b0 #b110111 #b101)))
; arg2 = -10485760.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110101 #b001)
                arg3
                (fp #b1 #b110101 #b000)))
(assert (fp.leq (fp #b1 #b110101 #b000)
                arg3
                (fp #b0 #b101011 #b010)))
; arg3 = -4194304.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110111 #b100)
                expect
                (fp #b1 #b110100 #b111)))
(assert (fp.leq (fp #b1 #b110100 #b111)
                expect
                (fp #b0 #b100110 #b111)))
; expect = -3932160.0

(assert (= expect result))

(check-sat)
(exit)
