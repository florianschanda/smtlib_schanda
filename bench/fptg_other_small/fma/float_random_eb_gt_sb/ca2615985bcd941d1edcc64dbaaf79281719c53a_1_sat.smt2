(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011010 #b011)
                arg1
                (fp #b1 #b001000 #b100)))
(assert (fp.leq (fp #b1 #b001000 #b100)
                arg1
                (fp #b0 #b001101 #b001)))
; arg1 = -0.000000178813934326171875

(declare-const arg2 (_ FloatingPoint 6 4))
