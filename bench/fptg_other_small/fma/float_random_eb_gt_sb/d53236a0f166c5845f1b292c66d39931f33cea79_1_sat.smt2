(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00100 #b110)
                arg1
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                arg1
                (fp #b0 #b11000 #b110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b101)
                arg2
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg2
                (fp #b1 #b10111 #b000)))
; arg2 = -16384.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg3
                (fp #b0 #b00110 #b110)))
(assert (fp.leq (fp #b0 #b00110 #b110)
                arg3
                (fp #b0 #b11010 #b111)))
; arg3 = 0.00341796875

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b000)
                expect
                (fp #b0 #b00110 #b110)))
(assert (fp.leq (fp #b0 #b00110 #b110)
                expect
                (fp #b0 #b10101 #b011)))
; expect = 0.00341796875

(assert (= expect result))

(check-sat)
(exit)
