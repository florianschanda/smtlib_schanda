(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1110100 #b00000)
                arg1
                (fp #b1 #b0000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000 #b00000)
                arg1
                (fp #b0 #b1010100 #b10011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001010 #b10001)
                arg2
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg2
                (fp #b1 #b0001100 #b11101)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0110010 #b00010)
                arg3
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                arg3
                (fp #b0 #b0001110 #b10111)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1000110 #b11100)
                expect
                (fp #b0 #b0000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000 #b00000)
                expect
                (fp #b0 #b1100110 #b00000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
