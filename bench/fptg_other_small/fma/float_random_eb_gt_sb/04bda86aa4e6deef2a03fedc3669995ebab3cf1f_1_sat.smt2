(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00101110 #b11110)
                arg2
                (fp #b0 #b10000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000101 #b00000)
                arg2
                (fp #b0 #b11111100 #b00101)))
; arg2 = 64.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b01010100 #b00111)
                arg3
                (fp #b0 #b11111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000)
                arg3
                (fp #b0 #b11111101 #b11110)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
