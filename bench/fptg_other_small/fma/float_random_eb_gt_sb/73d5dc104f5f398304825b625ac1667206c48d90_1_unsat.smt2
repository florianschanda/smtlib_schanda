(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100111 #b011)
                arg2
                (fp #b1 #b100011 #b000)))
(assert (fp.leq (fp #b1 #b100011 #b000)
                arg2
                (fp #b1 #b000101 #b111)))
; arg2 = -16.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111010 #b011)
                arg3
                (fp #b1 #b000000 #b010)))
(assert (fp.leq (fp #b1 #b000000 #b010)
                arg3
                (fp #b0 #b110111 #b100)))
; arg3 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
