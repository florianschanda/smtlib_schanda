(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10010100 #b11101)
                arg1
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                arg1
                (fp #b0 #b01001111 #b00001)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b00010000 #b10111)
                arg2
                (fp #b0 #b11111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000)
                arg2
                (fp #b0 #b11111110 #b00010)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b11001010 #b00110)
                arg3
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                arg3
                (fp #b0 #b01111000 #b10111)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01011101 #b11101)
                expect
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                expect
                (fp #b0 #b01011110 #b01000)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
