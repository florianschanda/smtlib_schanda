(declare-const arg2 (_ FloatingPoint 7 4))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0001010 #b100)
                expect
                (fp #b1 #b0000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000 #b010)
                expect
                (fp #b0 #b0101011 #b011)))
; expect = -0.0000000000000000000542101086242752217003726400434970855712890625

(assert (not (= expect result)))

(check-sat)
(exit)
