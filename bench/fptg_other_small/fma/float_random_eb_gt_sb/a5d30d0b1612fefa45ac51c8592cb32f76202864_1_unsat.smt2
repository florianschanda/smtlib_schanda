                arg2
                (fp #b1 #b01110011 #b0000)))
(assert (fp.leq (fp #b1 #b01110011 #b0000)
                arg2
                (fp #b1 #b00100100 #b0101)))
; arg2 = -0.000244140625

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11000110 #b0101)
                arg3
                (fp #b0 #b11110011 #b0011)))
(assert (fp.leq (fp #b0 #b11110011 #b0011)
                arg3
                (fp #b0 #b11110100 #b0110)))
; arg3 = 98653640312161724942079430255181824.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
