(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10001 #b000)
                arg1
                (fp #b1 #b00000 #b000)))
(assert (fp.leq (fp #b1 #b00000 #b000)
                arg1
                (fp #b0 #b01001 #b101)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg2
                (fp #b1 #b11110 #b111)))
(assert (fp.leq (fp #b1 #b11110 #b111)
                arg2
                (fp #b1 #b10101 #b011)))
; arg2 = -61440.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10101 #b110)
                arg3
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                arg3
                (fp #b0 #b01001 #b000)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00001 #b101)
                expect
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                expect
                (fp #b0 #b10000 #b110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
