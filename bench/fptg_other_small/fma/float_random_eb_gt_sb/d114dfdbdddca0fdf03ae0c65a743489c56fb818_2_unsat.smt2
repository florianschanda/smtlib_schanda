(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01010111 #b00)
                arg1
                (fp #b0 #b11111101 #b00)))
(assert (fp.leq (fp #b0 #b11111101 #b00)
                arg1
                (fp #b0 #b11111101 #b11)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10011010 #b00)
                arg2
                (fp #b0 #b10000010 #b00)))
(assert (fp.leq (fp #b0 #b10000010 #b00)
                arg2
                (fp #b0 #b10101110 #b01)))
; arg2 = 8.0

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00111100 #b00)
                arg3
                (fp #b1 #b00000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000 #b00)
                arg3
                (fp #b0 #b10001011 #b01)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
