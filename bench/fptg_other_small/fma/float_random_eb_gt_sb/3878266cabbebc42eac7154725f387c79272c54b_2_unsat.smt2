                arg2
                (fp #b0 #b10000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000101 #b00000)
                arg2
                (fp #b0 #b10010111 #b11110)))
; arg2 = 64.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11100100 #b11001)
                arg3
                (fp #b1 #b10010010 #b00011)))
(assert (fp.leq (fp #b1 #b10010010 #b00011)
                arg3
                (fp #b0 #b10101011 #b00101)))
; arg3 = -573440.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11011110 #b10100)
                expect
                (fp #b1 #b10010010 #b00100)))
(assert (fp.leq (fp #b1 #b10010010 #b00100)
                expect
                (fp #b0 #b01010001 #b10011)))
; expect = -589824.0

(assert (not (= expect result)))

(check-sat)
(exit)
