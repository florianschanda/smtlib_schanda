; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111111 #b00000)
                arg1
                (fp #b1 #b11111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111)
                arg1
                (fp #b0 #b01110100 #b11101)))
; arg1 = -334965454937798799971759379190646833152.0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10111111 #b01101)
                arg2
                (fp #b1 #b10111011 #b01100)))
(assert (fp.leq (fp #b1 #b10111011 #b01100)
                arg2
                (fp #b0 #b11010000 #b11100)))
; arg2 = -1585267068834414592.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
