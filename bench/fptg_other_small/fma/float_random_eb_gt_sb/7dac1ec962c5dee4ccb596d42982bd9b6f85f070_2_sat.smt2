; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111010 #b0110)
                arg1
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg1
                (fp #b1 #b010110 #b1001)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111001 #b1011)
                arg2
                (fp #b0 #b100100 #b0000)))
(assert (fp.leq (fp #b0 #b100100 #b0000)
                arg2
                (fp #b0 #b111001 #b0001)))
; arg2 = 32.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110101 #b1001)
                arg3
                (fp #b0 #b000000 #b0010)))
(assert (fp.leq (fp #b0 #b000000 #b0010)
                arg3
                (fp #b0 #b101111 #b1000)))
; arg3 = 0.000000000116415321826934814453125

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101011 #b0010)
                expect
                (fp #b1 #b101001 #b0000)))
(assert (fp.leq (fp #b1 #b101001 #b0000)
                expect
                (fp #b0 #b000100 #b0010)))
; expect = -1024.0

(assert (= expect result))

(check-sat)
(exit)
