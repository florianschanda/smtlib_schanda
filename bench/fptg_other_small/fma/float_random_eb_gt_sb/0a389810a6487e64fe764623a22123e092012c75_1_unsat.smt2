                arg2
                (fp #b0 #b0011100 #b1110)))
(assert (fp.leq (fp #b0 #b0011100 #b1110)
                arg2
                (fp #b0 #b1100110 #b0101)))
; arg2 = 0.00000000005456968210637569427490234375

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
