(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0000110 #b00)
                arg2
                (fp #b0 #b1111101 #b00)))
(assert (fp.leq (fp #b0 #b1111101 #b00)
                arg2
                (fp #b0 #b1111101 #b10)))
; arg2 = 4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 3))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0011011 #b11)
                arg3
                (fp #b0 #b0000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000 #b00)
                arg3
                (fp #b0 #b1111000 #b11)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
