(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b000 #b0)
                arg2
                (fp #b0 #b001 #b1)))
(assert (fp.leq (fp #b0 #b001 #b1)
                arg2
                (fp #b0 #b101 #b1)))
; arg2 = 0.375

(declare-const arg3 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b111 #b0)
                arg3
                (fp #b1 #b101 #b0)))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg3
                (fp #b0 #b001 #b0)))
; arg3 = -4.0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
