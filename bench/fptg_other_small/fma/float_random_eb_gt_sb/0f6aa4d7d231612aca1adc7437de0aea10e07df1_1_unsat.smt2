; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg1
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg1
                (fp #b0 #b110101 #b100)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101100 #b000)
                arg2
                (fp #b0 #b010011 #b000)))
(assert (fp.leq (fp #b0 #b010011 #b000)
                arg2
                (fp #b0 #b101101 #b010)))
; arg2 = 0.000244140625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101100 #b110)
                arg3
                (fp #b0 #b000000 #b000)))
(assert (fp.leq (fp #b0 #b000000 #b000)
                arg3
                (fp #b0 #b010111 #b010)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010010 #b111)
                expect
                (fp #b0 #b010111 #b000)))
(assert (fp.leq (fp #b0 #b010111 #b000)
                expect
                (fp #b0 #b011000 #b011)))
; expect = 0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
