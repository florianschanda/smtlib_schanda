; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001111 #b00)
                arg1
                (fp #b1 #b000000 #b01)))
(assert (fp.leq (fp #b1 #b000000 #b01)
                arg1
                (fp #b0 #b001101 #b10)))
; arg1 = -0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100110 #b00)
                arg3
                (fp #b1 #b011100 #b01)))
(assert (fp.leq (fp #b1 #b011100 #b01)
                arg3
                (fp #b0 #b110111 #b10)))
; arg3 = -0.15625

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
