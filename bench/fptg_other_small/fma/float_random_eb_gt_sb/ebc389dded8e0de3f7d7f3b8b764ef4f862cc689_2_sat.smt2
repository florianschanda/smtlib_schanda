; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0110110 #b10)
                arg1
                (fp #b0 #b1111101 #b00)))
(assert (fp.leq (fp #b0 #b1111101 #b00)
                arg1
                (fp #b0 #b1111101 #b11)))
; arg1 = 4611686018427387904.0

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010010 #b10)
                arg2
                (fp #b1 #b0000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000 #b10)
                arg2
                (fp #b0 #b0010101 #b10)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg3 (_ FloatingPoint 7 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101011 #b00)
                expect
                (fp #b1 #b0111110 #b01)))
(assert (fp.leq (fp #b1 #b0111110 #b01)
                expect
                (fp #b1 #b0011011 #b01)))
; expect = -0.625

(assert (= expect result))

(check-sat)
(exit)
