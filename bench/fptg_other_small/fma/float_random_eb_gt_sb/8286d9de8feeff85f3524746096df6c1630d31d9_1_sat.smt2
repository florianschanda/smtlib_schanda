(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11010010 #b110001)
                arg1
                (fp #b1 #b00000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000)
                arg1
                (fp #b0 #b01101010 #b101011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b01110100 #b111110)
                arg2
                (fp #b1 #b00000000 #b101100)))
(assert (fp.leq (fp #b1 #b00000000 #b101100)
                arg2
                (fp #b0 #b01101000 #b001011)))
; arg2 = -0.0000000000000000000000000000000000000080815236619032266172850636934029390350033257028081017103726679806641186587512493133544921875

(declare-const arg3 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00011001 #b011111)
                arg3
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg3
                (fp #b0 #b11011000 #b001111)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00010100 #b010110)
                expect
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                expect
                (fp #b0 #b11100000 #b101000)))
; expect = 128.0

(assert (= expect result))

(check-sat)
(exit)
