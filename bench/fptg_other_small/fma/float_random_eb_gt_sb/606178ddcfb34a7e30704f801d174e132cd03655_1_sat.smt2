(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1111000 #b0011)
                arg1
                (fp #b0 #b0000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000)
                arg1
                (fp #b0 #b1101000 #b1101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0000111 #b0000)
                arg2
                (fp #b0 #b0011100 #b1110)))
(assert (fp.leq (fp #b0 #b0011100 #b1110)
                arg2
                (fp #b0 #b1001010 #b0100)))
; arg2 = 0.00000000005456968210637569427490234375

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111010 #b0111)
                expect
                (fp #b0 #b0011100 #b1110)))
(assert (fp.leq (fp #b0 #b0011100 #b1110)
                expect
                (fp #b0 #b0100000 #b0101)))
; expect = 0.00000000005456968210637569427490234375

(assert (= expect result))

(check-sat)
(exit)
