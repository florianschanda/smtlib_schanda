                arg3
                (fp #b1 #b11111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000)
                arg3
                (fp #b1 #b10110000 #b1000)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111110 #b1110)
                expect
                (fp #b1 #b11111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000)
                expect
                (fp #b1 #b10011011 #b0010)))
; expect = -85070591730234615865843651857942052864.0

(assert (not (= expect result)))

