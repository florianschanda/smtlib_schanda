; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b01011111 #b1)
                arg1
                (fp #b0 #b10000010 #b1)))
(assert (fp.leq (fp #b0 #b10000010 #b1)
                arg1
                (fp #b0 #b10100000 #b1)))
; arg1 = 12.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10000100 #b0)
                arg3
                (fp #b0 #b11011110 #b0)))
(assert (fp.leq (fp #b0 #b11011110 #b0)
                arg3
                (fp #b0 #b11110111 #b1)))
; arg3 = 39614081257132168796771975168.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
