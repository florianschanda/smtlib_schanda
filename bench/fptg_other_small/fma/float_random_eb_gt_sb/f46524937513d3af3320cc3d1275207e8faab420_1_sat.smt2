(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b11)
                arg2
                (fp #b1 #b1100 #b01)))
(assert (fp.leq (fp #b1 #b1100 #b01)
                arg2
                (fp #b0 #b1100 #b11)))
; arg2 = -40.0

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b1011 #b11)
                arg3
                (fp #b0 #b1110 #b11)))
(assert (fp.leq (fp #b0 #b1110 #b11)
                arg3
                (fp #b0 #b1111 #b00)))
; arg3 = 224.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
