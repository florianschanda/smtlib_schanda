(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10001010 #b10110)
                arg1
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                arg1
                (fp #b0 #b00111011 #b10010)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111101 #b01111)
                arg2
                (fp #b1 #b11111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000)
                arg2
                (fp #b0 #b01101001 #b11111)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00001111 #b10000)
                arg3
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                arg3
                (fp #b0 #b01000101 #b01101)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00011101 #b01010)
                expect
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                expect
                (fp #b0 #b11100101 #b11000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
