; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b010010 #b0101)
                arg1
                (fp #b1 #b000101 #b1110)))
(assert (fp.leq (fp #b1 #b000101 #b1110)
                arg1
                (fp #b0 #b011110 #b0001)))
; arg1 = -0.00000002793967723846435546875

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100100 #b1010)
                arg2
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg2
                (fp #b0 #b011101 #b1001)))
; arg2 = -32.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b1011)
                arg3
                (fp #b1 #b100000 #b0010)))
(assert (fp.leq (fp #b1 #b100000 #b0010)
                arg3
                (fp #b0 #b010001 #b0010)))
; arg3 = -2.25

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110101 #b0110)
                expect
                (fp #b1 #b100000 #b0001)))
(assert (fp.leq (fp #b1 #b100000 #b0001)
                expect
                (fp #b1 #b001011 #b1001)))
; expect = -2.125

(assert (not (= expect result)))

(check-sat)
(exit)
