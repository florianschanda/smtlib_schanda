(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0100 #b1)
                arg1
                (fp #b0 #b1001 #b0)))
(assert (fp.leq (fp #b0 #b1001 #b0)
                arg1
                (fp #b0 #b1010 #b1)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b0)
                arg2
                (fp #b1 #b1001 #b0)))
(assert (fp.leq (fp #b1 #b1001 #b0)
                arg2
                (fp #b0 #b0001 #b0)))
; arg2 = -4.0

(declare-const arg3 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1000 #b0)
                arg3
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg3
                (fp #b0 #b1110 #b1)))
; arg3 = 0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1111 #b0)
                expect
                (fp #b1 #b1011 #b0)))
(assert (fp.leq (fp #b1 #b1011 #b0)
                expect
                (fp #b0 #b1110 #b0)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
(exit)
