; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10010100 #b110)
                arg1
                (fp #b0 #b00111000 #b111)))
(assert (fp.leq (fp #b0 #b00111000 #b111)
                arg1
                (fp #b0 #b10000000 #b110)))
; arg1 = 0.00000000000000000000079409338805090656787655234438716433942317962646484375

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00110110 #b001)
                arg2
                (fp #b0 #b01100111 #b000)))
(assert (fp.leq (fp #b0 #b01100111 #b000)
                arg2
                (fp #b0 #b01101001 #b010)))
; arg2 = 0.000000059604644775390625

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110010 #b010)
                expect
                (fp #b1 #b01100111 #b000)))
(assert (fp.leq (fp #b1 #b01100111 #b000)
                expect
                (fp #b0 #b11010110 #b111)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
