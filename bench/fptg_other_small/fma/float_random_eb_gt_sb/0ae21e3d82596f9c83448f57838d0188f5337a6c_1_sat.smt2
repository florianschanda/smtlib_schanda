(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b100)
                arg1
                (fp #b1 #b01010 #b011)))
(assert (fp.leq (fp #b1 #b01010 #b011)
                arg1
                (fp #b1 #b00111 #b100)))
; arg1 = -0.04296875

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10000 #b101)
                arg2
                (fp #b0 #b01100 #b011)))
(assert (fp.leq (fp #b0 #b01100 #b011)
                arg2
                (fp #b0 #b11101 #b101)))
; arg2 = 0.171875

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b010)
                arg3
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                arg3
                (fp #b1 #b00010 #b010)))
; arg3 = -16.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10111 #b010)
                expect
                (fp #b1 #b10011 #b000)))
(assert (fp.leq (fp #b1 #b10011 #b000)
                expect
                (fp #b0 #b01111 #b110)))
; expect = -16.0

(assert (= expect result))

(check-sat)
(exit)
