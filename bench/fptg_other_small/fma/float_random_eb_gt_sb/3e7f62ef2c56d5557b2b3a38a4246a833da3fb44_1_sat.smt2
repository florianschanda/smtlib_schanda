; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111010 #b101)
                arg1
                (fp #b1 #b101000 #b101)))
(assert (fp.leq (fp #b1 #b101000 #b101)
                arg1
                (fp #b0 #b000101 #b110)))
; arg1 = -832.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000011 #b110)
                arg2
                (fp #b0 #b000000 #b110)))
(assert (fp.leq (fp #b0 #b000000 #b110)
                arg2
                (fp #b0 #b110111 #b011)))
; arg2 = 0.00000000069849193096160888671875

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110110 #b010)
                arg3
                (fp #b1 #b110101 #b000)))
(assert (fp.leq (fp #b1 #b110101 #b000)
                arg3
                (fp #b0 #b100010 #b110)))
; arg3 = -4194304.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b001)
                expect
                (fp #b1 #b110101 #b000)))
(assert (fp.leq (fp #b1 #b110101 #b000)
                expect
                (fp #b1 #b100111 #b101)))
; expect = -4194304.0

(assert (= expect result))

(check-sat)
(exit)
