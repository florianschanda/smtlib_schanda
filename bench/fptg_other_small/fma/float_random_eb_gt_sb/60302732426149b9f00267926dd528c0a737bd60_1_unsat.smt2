; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b00011001 #b11)
                arg1
                (fp #b1 #b00000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000 #b10)
                arg1
                (fp #b0 #b00010001 #b00)))
; arg1 = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111110 #b00)
                arg2
                (fp #b1 #b11111101 #b00)))
(assert (fp.leq (fp #b1 #b11111101 #b00)
                arg2
                (fp #b1 #b01001011 #b11)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11100111 #b10)
                arg3
                (fp #b1 #b10000010 #b00)))
(assert (fp.leq (fp #b1 #b10000010 #b00)
                arg3
                (fp #b0 #b01001100 #b10)))
; arg3 = -8.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10001010 #b00)
                expect
                (fp #b1 #b10000001 #b11)))
(assert (fp.leq (fp #b1 #b10000001 #b11)
                expect
                (fp #b0 #b10010110 #b11)))
; expect = -7.0

(assert (not (= expect result)))

(check-sat)
(exit)
