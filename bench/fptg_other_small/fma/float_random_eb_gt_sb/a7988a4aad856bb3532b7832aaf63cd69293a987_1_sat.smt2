(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1110001 #b010)
                arg1
                (fp #b1 #b1110000 #b101)))
(assert (fp.leq (fp #b1 #b1110000 #b101)
                arg1
                (fp #b0 #b0100101 #b111)))
; arg1 = -914793674309632.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1000100 #b111)
                arg3
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg3
                (fp #b0 #b1101011 #b100)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
