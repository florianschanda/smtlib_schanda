(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001001 #b00110)
                arg1
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg1
                (fp #b0 #b1011010 #b01010)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0000110 #b01010)
                arg2
                (fp #b1 #b0000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000 #b01000)
                arg2
                (fp #b0 #b0000101 #b00110)))
; arg2 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0110010 #b10000)
                arg3
                (fp #b0 #b1111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111110 #b11111)
                arg3
                (fp #b0 #b1111111 #b00000)))
; arg3 = 18158513697557839872.0

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
