(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0011001 #b0010)
                arg1
                (fp #b0 #b1000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000100 #b0000)
                arg1
                (fp #b0 #b1100100 #b1011)))
; arg1 = 32.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111111 #b0000)
                arg2
                (fp #b1 #b1111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111)
                arg2
                (fp #b1 #b0110100 #b1000)))
; arg2 = -17870283321406128128.0

(declare-const arg3 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0001001 #b0000)
                arg3
                (fp #b1 #b0000000 #b1011)))
(assert (fp.leq (fp #b1 #b0000000 #b1011)
                arg3
                (fp #b0 #b1001111 #b1101)))
; arg3 = -0.000000000000000000149077798716756859676024760119616985321044921875

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
