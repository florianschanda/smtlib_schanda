; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11010 #b100)
                arg1
                (fp #b0 #b01101 #b001)))
(assert (fp.leq (fp #b0 #b01101 #b001)
                arg1
                (fp #b0 #b01101 #b110)))
; arg1 = 0.28125

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10100 #b100)
                arg2
                (fp #b0 #b10111 #b010)))
(assert (fp.leq (fp #b0 #b10111 #b010)
                arg2
                (fp #b0 #b11100 #b011)))
; arg2 = 320.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01111 #b111)
                arg3
                (fp #b1 #b00000 #b100)))
(assert (fp.leq (fp #b1 #b00000 #b100)
                arg3
                (fp #b0 #b10011 #b101)))
; arg3 = -0.000030517578125

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00101 #b011)
                expect
                (fp #b0 #b10101 #b011)))
(assert (fp.leq (fp #b0 #b10101 #b011)
                expect
                (fp #b0 #b10111 #b001)))
; expect = 88.0

(assert (not (= expect result)))

(check-sat)
(exit)
