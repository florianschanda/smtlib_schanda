(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b00101000 #b1)
                arg1
                (fp #b0 #b10000010 #b1)))
(assert (fp.leq (fp #b0 #b10000010 #b1)
                arg1
                (fp #b0 #b11011010 #b0)))
; arg1 = 12.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001100 #b1)
                arg2
                (fp #b1 #b10000001 #b0)))
(assert (fp.leq (fp #b1 #b10000001 #b0)
                arg2
                (fp #b0 #b10111011 #b0)))
; arg2 = -4.0

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10110111 #b1)
                arg3
                (fp #b0 #b00001100 #b0)))
(assert (fp.leq (fp #b0 #b00001100 #b0)
                arg3
                (fp #b0 #b01000010 #b1)))
; arg3 = 0.0000000000000000000000000000000000240741243048404481631997242823115914817262706026923524404992349445819854736328125

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11111110 #b0)
                expect
                (fp #b1 #b10000100 #b1)))
(assert (fp.leq (fp #b1 #b10000100 #b1)
                expect
                (fp #b0 #b10000001 #b0)))
; expect = -48.0

(assert (not (= expect result)))

(check-sat)
(exit)
