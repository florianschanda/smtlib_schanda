; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0100000 #b0)
                arg1
                (fp #b1 #b0011101 #b1)))
(assert (fp.leq (fp #b1 #b0011101 #b1)
                arg1
                (fp #b0 #b1101000 #b1)))
; arg1 = -0.00000000008731149137020111083984375

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 7 2))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0100011 #b0)
                arg3
                (fp #b1 #b0000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000 #b0)
                arg3
                (fp #b0 #b0001010 #b0)))
; arg3 = -0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1101101 #b1)
                expect
                (fp #b0 #b0000000 #b1)))
(assert (fp.leq (fp #b0 #b0000000 #b1)
                expect
                (fp #b0 #b1111101 #b0)))
; expect = 0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

(check-sat)
(exit)
