(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10101101 #b11101)
                arg1
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                arg1
                (fp #b0 #b01111110 #b01110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10100010 #b11100)
                arg2
                (fp #b1 #b10000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000101 #b00000)
                arg2
                (fp #b1 #b00010000 #b11101)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10011010 #b01111)
                arg3
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                arg3
                (fp #b0 #b11010001 #b00001)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000011 #b01110)
                expect
                (fp #b0 #b00000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000)
                expect
                (fp #b0 #b00100010 #b11101)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
