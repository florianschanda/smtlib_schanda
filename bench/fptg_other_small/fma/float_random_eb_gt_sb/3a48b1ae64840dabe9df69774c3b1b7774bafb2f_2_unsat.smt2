; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b11001011 #b1)
                arg1
                (fp #b0 #b11111110 #b1)))
(assert (fp.leq (fp #b0 #b11111110 #b1)
                arg1
                (fp #b0 #b11111111 #b0)))
; arg1 = 255211775190703847597530955573826158592.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b01100100 #b0)
                arg2
                (fp #b0 #b11111110 #b0)))
(assert (fp.leq (fp #b0 #b11111110 #b0)
                arg2
                (fp #b0 #b11111111 #b0)))
; arg2 = 170141183460469231731687303715884105728.0

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10111011 #b1)
                arg3
                (fp #b0 #b00000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000 #b0)
                arg3
                (fp #b0 #b11110000 #b0)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
