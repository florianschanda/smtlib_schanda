(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b01)
                arg1
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                arg1
                (fp #b0 #b0100 #b10)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg2
                (fp #b1 #b0000 #b01)))
(assert (fp.leq (fp #b1 #b0000 #b01)
                arg2
                (fp #b0 #b1110 #b01)))
; arg2 = -0.00390625

(declare-const arg3 (_ FloatingPoint 4 3))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
