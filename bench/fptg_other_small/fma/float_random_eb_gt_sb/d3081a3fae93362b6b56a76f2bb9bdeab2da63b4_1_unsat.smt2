                arg3
                (fp #b0 #b11110 #b00)))
(assert (fp.leq (fp #b0 #b11110 #b00)
                arg3
                (fp #b0 #b11110 #b11)))
; arg3 = 32768.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b01001 #b11)
                expect
                (fp #b0 #b11101 #b11)))
(assert (fp.leq (fp #b0 #b11101 #b11)
                expect
                (fp #b0 #b11110 #b10)))
; expect = 28672.0

(assert (not (= expect result)))

(check-sat)
