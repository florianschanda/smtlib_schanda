(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010001 #b100)
                arg1
                (fp #b1 #b10111111 #b000)))
(assert (fp.leq (fp #b1 #b10111111 #b000)
                arg1
                (fp #b0 #b00011101 #b101)))
; arg1 = -18446744073709551616.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00011100 #b101)
                arg2
                (fp #b0 #b11111110 #b111)))
(assert (fp.leq (fp #b0 #b11111110 #b111)
                arg2
                (fp #b0 #b11111111 #b000)))
; arg2 = 319014718988379809496913694467282698240.0

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10111101 #b101)
                arg3
                (fp #b0 #b00000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000 #b010)
                arg3
                (fp #b0 #b00000111 #b111)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111111 #b000)
                expect
                (fp #b1 #b11111110 #b111)))
(assert (fp.leq (fp #b1 #b11111110 #b111)
                expect
                (fp #b1 #b10111101 #b101)))
; expect = -319014718988379809496913694467282698240.0

(assert (= expect result))

(check-sat)
(exit)
