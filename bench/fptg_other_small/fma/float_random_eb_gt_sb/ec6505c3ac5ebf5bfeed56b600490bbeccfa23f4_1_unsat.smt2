;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111110 #b100)
                arg1
                (fp #b1 #b11111101 #b000)))
(assert (fp.leq (fp #b1 #b11111101 #b000)
                arg1
                (fp #b0 #b00000011 #b011)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10101111 #b110)
                arg2
                (fp #b1 #b10000011 #b000)))
(assert (fp.leq (fp #b1 #b10000011 #b000)
                arg2
                (fp #b0 #b00110101 #b000)))
; arg2 = -16.0

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
