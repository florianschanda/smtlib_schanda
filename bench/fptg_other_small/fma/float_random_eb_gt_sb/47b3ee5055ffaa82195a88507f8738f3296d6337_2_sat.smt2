                arg2
                (fp #b0 #b10100111 #b000)))
; arg2 = -0.0000000000000000000000000000000123259516440783094595582588325435348386438505485784844495356082916259765625

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10011111 #b001)
                expect
                (fp #b1 #b00010101 #b000)))
(assert (fp.leq (fp #b1 #b00010101 #b000)
                expect
