; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110100 #b0110)
                arg1
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg1
                (fp #b0 #b001101 #b1000)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100100 #b1111)
                arg2
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg2
                (fp #b1 #b001111 #b0001)))
; arg2 = -32.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000110 #b0101)
                arg3
                (fp #b0 #b101010 #b0110)))
(assert (fp.leq (fp #b0 #b101010 #b0110)
                arg3
                (fp #b0 #b110100 #b1100)))
; arg3 = 2816.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b101010 #b0011)
                expect
                (fp #b0 #b101010 #b1110)))
(assert (fp.leq (fp #b0 #b101010 #b1110)
                expect
                (fp #b0 #b110000 #b0000)))
; expect = 3840.0

(assert (= expect result))

(check-sat)
(exit)
