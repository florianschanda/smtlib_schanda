(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100101 #b1)
                arg1
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                arg1
                (fp #b0 #b101110 #b0)))
; arg1 = 0.0000000004656612873077392578125

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b100011 #b1)
                arg2
                (fp #b0 #b011100 #b0)))
(assert (fp.leq (fp #b0 #b011100 #b0)
                arg2
                (fp #b0 #b111100 #b0)))
; arg2 = 0.125

(declare-const arg3 (_ FloatingPoint 6 2))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b101100 #b1)
                expect
                (fp #b1 #b011100 #b0)))
(assert (fp.leq (fp #b1 #b011100 #b0)
                expect
                (fp #b1 #b000110 #b1)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
