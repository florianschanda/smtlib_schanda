                arg2
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg2
                (fp #b1 #b0011011 #b11110)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1000101 #b10000)
                arg3
                (fp #b1 #b0110101 #b10000)))
(assert (fp.leq (fp #b1 #b0110101 #b10000)
                arg3
                (fp #b0 #b0100011 #b01101)))
; arg3 = -0.00146484375

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0011010 #b00110)
                expect
                (fp #b0 #b1010100 #b01011)))
(assert (fp.leq (fp #b0 #b1010100 #b01011)
                expect
                (fp #b0 #b1101101 #b11000)))
; expect = 2818048.0

(assert (= expect result))

(check-sat)
(exit)
