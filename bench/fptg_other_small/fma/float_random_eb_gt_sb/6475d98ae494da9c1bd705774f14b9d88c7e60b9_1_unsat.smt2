                arg3
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                arg3
                (fp #b0 #b1110010 #b011)))
; arg3 = 16.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111001 #b000)
                expect
                (fp #b1 #b1110011 #b001)))
(assert (fp.leq (fp #b1 #b1110011 #b001)
                expect
                (fp #b1 #b0100000 #b000)))
; expect = -5066549580791808.0

(assert (not (= expect result)))

