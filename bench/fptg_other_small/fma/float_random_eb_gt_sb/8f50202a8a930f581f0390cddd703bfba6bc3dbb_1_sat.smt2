(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1001000 #b001)
                arg1
                (fp #b1 #b1000011 #b000)))
(assert (fp.leq (fp #b1 #b1000011 #b000)
                arg1
                (fp #b0 #b0011011 #b010)))
; arg1 = -16.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110110 #b011)
                arg2
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                arg2
                (fp #b0 #b1110001 #b100)))
; arg2 = 16.0

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111111 #b110)
                arg3
                (fp #b0 #b0110011 #b000)))
(assert (fp.leq (fp #b0 #b0110011 #b000)
                arg3
                (fp #b0 #b1010111 #b001)))
; arg3 = 0.000244140625

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1100101 #b111)
                expect
                (fp #b1 #b1000110 #b111)))
(assert (fp.leq (fp #b1 #b1000110 #b111)
                expect
                (fp #b0 #b0001111 #b010)))
; expect = -240.0

(assert (= expect result))

(check-sat)
(exit)
