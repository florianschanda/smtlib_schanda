(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg1
                (fp #b1 #b111101 #b0000)))
(assert (fp.leq (fp #b1 #b111101 #b0000)
                arg1
                (fp #b0 #b101110 #b0010)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111111 #b0000)
                arg2
                (fp #b1 #b111110 #b1111)))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg2
                (fp #b0 #b101010 #b1001)))
; arg2 = -4160749568.0

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b000101 #b0011)
                arg3
                (fp #b0 #b000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000 #b0000)
                arg3
                (fp #b0 #b100010 #b0000)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000101 #b0101)
                expect
                (fp #b0 #b111110 #b1111)))
(assert (fp.leq (fp #b0 #b111110 #b1111)
                expect
                (fp #b0 #b111111 #b0000)))
; expect = 4160749568.0

(assert (not (= expect result)))

(check-sat)
(exit)
