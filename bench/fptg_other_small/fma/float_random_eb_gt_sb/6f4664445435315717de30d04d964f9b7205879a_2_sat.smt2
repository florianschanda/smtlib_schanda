(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10100111 #b1000)
                arg1
                (fp #b1 #b00000000 #b0011)))
(assert (fp.leq (fp #b1 #b00000000 #b0011)
                arg1
                (fp #b0 #b01010001 #b0001)))
; arg1 = -0.0000000000000000000000000000000000000022040519077917890774413810072917106459099979189476641028289094492720323614776134490966796875

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00100011 #b0100)
                arg3
                (fp #b0 #b11111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000)
                arg3
                (fp #b0 #b11111111 #b0000)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10001100 #b1100)
                expect
                (fp #b0 #b11111101 #b0001)))
(assert (fp.leq (fp #b0 #b11111101 #b0001)
                expect
                (fp #b0 #b11111101 #b1111)))
; expect = 90387503713374279357458880099063431168.0

(assert (= expect result))

(check-sat)
(exit)
