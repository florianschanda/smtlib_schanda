                arg3
                (fp #b0 #b00000 #b01)))
(assert (fp.leq (fp #b0 #b00000 #b01)
                arg3
                (fp #b0 #b10101 #b11)))
; arg3 = 0.0000152587890625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10000 #b01)
                expect
                (fp #b1 #b00101 #b00)))
(assert (fp.leq (fp #b1 #b00101 #b00)
                expect
                (fp #b0 #b00110 #b11)))
; expect = -0.0009765625

(assert (not (= expect result)))

(check-sat)
