(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11100 #b111)
                arg1
                (fp #b1 #b10010 #b101)))
(assert (fp.leq (fp #b1 #b10010 #b101)
                arg1
                (fp #b0 #b00001 #b001)))
; arg1 = -13.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00100 #b100)
                arg2
                (fp #b0 #b10111 #b010)))
(assert (fp.leq (fp #b0 #b10111 #b010)
                arg2
                (fp #b0 #b11011 #b111)))
; arg2 = 320.0

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11100 #b011)
                expect
                (fp #b1 #b11011 #b001)))
(assert (fp.leq (fp #b1 #b11011 #b001)
                expect
                (fp #b1 #b01110 #b100)))
; expect = -4608.0

(assert (= expect result))

(check-sat)
(exit)
