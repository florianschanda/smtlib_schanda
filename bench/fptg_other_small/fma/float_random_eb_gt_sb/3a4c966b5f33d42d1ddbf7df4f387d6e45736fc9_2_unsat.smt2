(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10101 #b001)
                arg1
                (fp #b0 #b11101 #b000)))
(assert (fp.leq (fp #b0 #b11101 #b000)
                arg1
                (fp #b0 #b11101 #b101)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00110 #b001)
                arg2
                (fp #b1 #b00000 #b101)))
(assert (fp.leq (fp #b1 #b00000 #b101)
                arg2
                (fp #b0 #b01010 #b001)))
; arg2 = -0.00003814697265625

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b011)
                arg3
                (fp #b0 #b00000 #b101)))
(assert (fp.leq (fp #b0 #b00000 #b101)
                arg3
                (fp #b0 #b11001 #b001)))
; arg3 = 0.00003814697265625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10110 #b010)
                expect
                (fp #b1 #b01110 #b010)))
(assert (fp.leq (fp #b1 #b01110 #b010)
                expect
                (fp #b1 #b00101 #b100)))
; expect = -0.625

(assert (not (= expect result)))

(check-sat)
(exit)
