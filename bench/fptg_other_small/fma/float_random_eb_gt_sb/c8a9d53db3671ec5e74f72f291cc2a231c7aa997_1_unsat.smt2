; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101010 #b011)
                arg1
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg1
                (fp #b0 #b110001 #b110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b110010 #b111)
                arg2
                (fp #b0 #b111101 #b000)))
(assert (fp.leq (fp #b0 #b111101 #b000)
                arg2
                (fp #b0 #b111110 #b000)))
; arg2 = 1073741824.0

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b101001 #b000)
                arg3
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                arg3
                (fp #b0 #b010011 #b100)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111001 #b110)
                expect
                (fp #b1 #b000000 #b000)))
(assert (fp.leq (fp #b1 #b000000 #b000)
                expect
                (fp #b0 #b001101 #b010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
