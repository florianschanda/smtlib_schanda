                arg2
                (fp #b1 #b00000 #b101)))
(assert (fp.leq (fp #b1 #b00000 #b101)
                arg2
                (fp #b0 #b11100 #b000)))
; arg2 = -0.00003814697265625

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11000 #b010)
                arg3
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg3
                (fp #b0 #b11100 #b001)))
; arg3 = -0.0000152587890625

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00001 #b101)
                expect
                (fp #b0 #b00011 #b111)))
(assert (fp.leq (fp #b0 #b00011 #b111)
                expect
                (fp #b0 #b11100 #b110)))
; expect = 0.000457763671875

(assert (= expect result))

(check-sat)
(exit)
