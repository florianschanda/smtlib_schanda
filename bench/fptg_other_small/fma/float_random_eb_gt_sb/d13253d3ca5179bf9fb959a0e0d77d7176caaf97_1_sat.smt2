(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b101)
                arg1
                (fp #b1 #b10010 #b101)))
(assert (fp.leq (fp #b1 #b10010 #b101)
                arg1
