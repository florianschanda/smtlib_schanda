                arg2
                (fp #b1 #b11011100 #b0110)))
(assert (fp.leq (fp #b1 #b11011100 #b0110)
                arg2
                (fp #b1 #b10001110 #b0010)))
; arg2 = -13617340432139183023890366464.0

(declare-const arg3 (_ FloatingPoint 8 5))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10001111 #b0010)
                arg3
                (fp #b1 #b00000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000)
                arg3
                (fp #b0 #b10101111 #b1011)))
; arg3 = -0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11110000 #b1001)
                expect
                (fp #b1 #b11100001 #b0110)))
(assert (fp.leq (fp #b1 #b11100001 #b0110)
                expect
                (fp #b1 #b00101111 #b1100)))
; expect = -435754893828453856764491726848.0

(assert (not (= expect result)))

(check-sat)
(exit)
