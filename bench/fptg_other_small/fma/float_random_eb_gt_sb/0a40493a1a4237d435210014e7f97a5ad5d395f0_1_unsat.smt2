; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b01011010 #b1)
                arg2
                (fp #b0 #b11011111 #b0)))
(assert (fp.leq (fp #b0 #b11011111 #b0)
                arg2
                (fp #b0 #b11100001 #b0)))
; arg2 = 79228162514264337593543950336.0

(declare-const arg3 (_ FloatingPoint 8 2))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
