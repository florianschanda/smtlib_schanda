(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10101101 #b11)
                arg1
                (fp #b1 #b10000010 #b00)))
(assert (fp.leq (fp #b1 #b10000010 #b00)
                arg1
                (fp #b1 #b00010101 #b11)))
; arg1 = -8.0

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01101100 #b00)
                arg2
                (fp #b1 #b00000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000 #b10)
                arg2
                (fp #b0 #b11111000 #b00)))
; arg2 = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(declare-const arg3 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10011001 #b10)
                arg3
                (fp #b1 #b01110100 #b00)))
(assert (fp.leq (fp #b1 #b01110100 #b00)
                arg3
                (fp #b0 #b10011000 #b01)))
; arg3 = -0.00048828125

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10111111 #b11)
                expect
                (fp #b1 #b01110100 #b00)))
(assert (fp.leq (fp #b1 #b01110100 #b00)
                expect
                (fp #b0 #b10101110 #b11)))
; expect = -0.00048828125

(assert (not (= expect result)))

(check-sat)
(exit)
