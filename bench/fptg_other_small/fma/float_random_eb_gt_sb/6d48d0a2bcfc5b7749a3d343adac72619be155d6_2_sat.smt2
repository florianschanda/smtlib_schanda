(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b11)
                arg1
                (fp #b1 #b001111 #b10)))
(assert (fp.leq (fp #b1 #b001111 #b10)
                arg1
                (fp #b1 #b000110 #b00)))
; arg1 = -0.00002288818359375

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b110101 #b10)
                arg2
                (fp #b0 #b111101 #b00)))
(assert (fp.leq (fp #b0 #b111101 #b00)
                arg2
                (fp #b0 #b111110 #b01)))
; arg2 = 1073741824.0

(declare-const arg3 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001100 #b01)
                arg3
                (fp #b0 #b100010 #b00)))
(assert (fp.leq (fp #b0 #b100010 #b00)
                arg3
                (fp #b0 #b101111 #b01)))
; arg3 = 8.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110001 #b10)
                expect
                (fp #b1 #b101101 #b10)))
(assert (fp.leq (fp #b1 #b101101 #b10)
                expect
                (fp #b1 #b010000 #b10)))
; expect = -24576.0

(assert (= expect result))

(check-sat)
(exit)
