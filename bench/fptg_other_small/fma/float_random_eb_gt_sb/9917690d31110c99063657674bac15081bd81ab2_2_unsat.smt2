(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +ZERO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011000 #b010)
                arg1
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg1
                (fp #b0 #b0101110 #b010)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1010100 #b000)
                arg2
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg2
                (fp #b0 #b1000110 #b010)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1111001 #b001)
                arg3
                (fp #b1 #b0000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000 #b000)
                arg3
                (fp #b0 #b1111010 #b000)))
; arg3 = -0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101101 #b011)
                expect
                (fp #b1 #b0000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000 #b000)
                expect
                (fp #b0 #b0001100 #b011)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
