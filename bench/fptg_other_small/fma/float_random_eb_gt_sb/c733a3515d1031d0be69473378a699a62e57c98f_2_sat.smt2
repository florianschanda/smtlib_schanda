                arg2
                (fp #b1 #b01001000 #b01010)))
(assert (fp.leq (fp #b1 #b01001000 #b01010)
                arg2
                (fp #b0 #b11011011 #b11110)))
; arg2 = -0.00000000000000003642919299551294898265041410923004150390625

(declare-const arg3 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11001001 #b00000)
                arg3
                (fp #b1 #b10010010 #b00011)))
(assert (fp.leq (fp #b1 #b10010010 #b00011)
                arg3
                (fp #b0 #b10110010 #b01011)))
; arg3 = -573440.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11100100 #b10000)
                expect
                (fp #b1 #b10010010 #b00100)))
(assert (fp.leq (fp #b1 #b10010010 #b00100)
                expect
                (fp #b1 #b01101100 #b01101)))
; expect = -589824.0

(assert (= expect result))

(check-sat)
(exit)
