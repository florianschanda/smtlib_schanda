(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1001110 #b011)
                arg1
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg1
                (fp #b0 #b0000011 #b000)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010100 #b100)
                arg2
                (fp #b1 #b1000100 #b110)))
(assert (fp.leq (fp #b1 #b1000100 #b110)
                arg2
                (fp #b1 #b1000011 #b011)))
; arg2 = -56.0

(declare-const arg3 (_ FloatingPoint 7 4))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
