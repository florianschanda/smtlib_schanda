(declare-const arg3 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b100111 #b010)
                arg3
                (fp #b0 #b111101 #b000)))
(assert (fp.leq (fp #b0 #b111101 #b000)
                arg3
                (fp #b0 #b111110 #b001)))
; arg3 = 1073741824.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
