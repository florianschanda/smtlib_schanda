(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010010 #b110)
                arg1
                (fp #b0 #b010011 #b100)))
(assert (fp.leq (fp #b0 #b010011 #b100)
                arg1
