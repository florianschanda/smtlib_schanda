(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000111 #b111)
                arg1
                (fp #b1 #b000000 #b010)))
(assert (fp.leq (fp #b1 #b000000 #b010)
                arg1
                (fp #b0 #b001011 #b100)))
; arg1 = -0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011100 #b110)
                arg2
                (fp #b1 #b000000 #b101)))
(assert (fp.leq (fp #b1 #b000000 #b101)
                arg2
                (fp #b0 #b001001 #b101)))
; arg2 = -0.000000000582076609134674072265625

(declare-const arg3 (_ FloatingPoint 6 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001110 #b001)
                expect
                (fp #b1 #b000000 #b101)))
(assert (fp.leq (fp #b1 #b000000 #b101)
                expect
                (fp #b0 #b011101 #b110)))
; expect = -0.000000000582076609134674072265625

(assert (= expect result))

(check-sat)
(exit)
