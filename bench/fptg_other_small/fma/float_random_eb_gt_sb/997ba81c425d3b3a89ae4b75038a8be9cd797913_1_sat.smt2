(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +NAN
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111111 #b0000)
                arg1
                (fp #b1 #b111110 #b1111)))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg1
                (fp #b0 #b011011 #b1001)))
; arg1 = -4160749568.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const arg3 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b1010)
                arg3
                (fp #b1 #b100000 #b0010)))
(assert (fp.leq (fp #b1 #b100000 #b0010)
                arg3
                (fp #b0 #b011110 #b1111)))
; arg3 = -2.25

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
