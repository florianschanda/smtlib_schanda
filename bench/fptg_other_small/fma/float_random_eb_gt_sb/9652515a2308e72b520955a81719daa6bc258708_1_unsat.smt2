; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +NAN
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b010)
                arg1
                (fp #b1 #b10010 #b101)))
(assert (fp.leq (fp #b1 #b10010 #b101)
                arg1
                (fp #b0 #b10011 #b110)))
; arg1 = -13.0

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const arg3 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg3
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg3
                (fp #b0 #b10110 #b101)))
; arg3 = -16384.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
