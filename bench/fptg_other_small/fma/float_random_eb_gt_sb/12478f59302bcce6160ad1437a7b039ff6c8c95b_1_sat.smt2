(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111110 #b100)
                arg1
                (fp #b1 #b01110010 #b110)))
(assert (fp.leq (fp #b1 #b01110010 #b110)
                arg1
                (fp #b1 #b01011101 #b101)))
; arg1 = -0.000213623046875

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110111 #b111)
                arg3
                (fp #b1 #b10000011 #b000)))
(assert (fp.leq (fp #b1 #b10000011 #b000)
                arg3
                (fp #b1 #b00100101 #b011)))
; arg3 = -16.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10010011 #b110)
                expect
                (fp #b1 #b10000011 #b000)))
(assert (fp.leq (fp #b1 #b10000011 #b000)
                expect
                (fp #b0 #b11111011 #b101)))
; expect = -16.0

(assert (= expect result))

(check-sat)
(exit)
