(declare-const arg2 (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b1100 #b11011111101111010011)
                arg2
                (fp #b1 #b0100 #b00100001111100111010)))
(assert (fp.leq (fp #b1 #b0100 #b00100001111100111010)
                arg2
                (fp #b0 #b0000 #b01011100000110100001)))
; arg2 = -0.1415779590606689453125

(declare-const arg3 (_ FloatingPoint 4 21))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 4 21))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b0001 #b01000000000100000010)
                expect
                (fp #b0 #b0100 #b00100000110100011011)))
(assert (fp.leq (fp #b0 #b0100 #b00100000110100011011)
                expect
                (fp #b0 #b1010 #b11100101110101000111)))
; expect = 0.14102494716644287109375

(assert (= expect result))

(check-sat)
(exit)
