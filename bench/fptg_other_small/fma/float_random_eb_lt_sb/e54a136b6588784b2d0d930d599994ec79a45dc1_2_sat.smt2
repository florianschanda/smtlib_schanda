;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b1001 #b00110111110010111110)
                arg1
                (fp #b0 #b0000 #b01000000000000000000)))
(assert (fp.leq (fp #b0 #b0000 #b01000000000000000000)
                arg1
                (fp #b0 #b1010 #b00110111100110100010)))
