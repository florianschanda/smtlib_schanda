; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b0111 #b01110111000001010011)
                arg1
                (fp #b0 #b0000 #b10100111001000001100)))
(assert (fp.leq (fp #b0 #b0000 #b10100111001000001100)
                arg1
                (fp #b0 #b1000 #b00101000000110110001)))
; arg1 = 0.010200679302215576171875

(declare-const arg2 (_ FloatingPoint 4 21))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b1000 #b10010011111110111101)
                arg3
                (fp #b1 #b0000 #b01000000000000000000)))
(assert (fp.leq (fp #b1 #b0000 #b01000000000000000000)
                arg3
                (fp #b0 #b1011 #b11101100110010001110)))
; arg3 = -0.00390625

(declare-const result (_ FloatingPoint 4 21))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 21))
(assert (fp.leq (fp #b1 #b0001 #b00100000110000001101)
                expect
                (fp #b1 #b0000 #b01000001101101000111)))
(assert (fp.leq (fp #b1 #b0000 #b01000001101101000111)
                expect
                (fp #b0 #b0110 #b10001011110100010000)))
; expect = -0.00401030480861663818359375

(assert (= expect result))

(check-sat)
(exit)
