(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b110 #b11101010)
                arg1
                (fp #b1 #b110 #b11100000)))
(assert (fp.leq (fp #b1 #b110 #b11100000)
                arg1
                (fp #b0 #b101 #b11110100)))
; arg1 = -15.0

(declare-const arg2 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b0 #b100 #b11010001)
                arg2
                (fp #b0 #b101 #b11101101)))
(assert (fp.leq (fp #b0 #b101 #b11101101)
                arg2
                (fp #b0 #b111 #b00000000)))
; arg2 = 7.703125

(declare-const arg3 (_ FloatingPoint 3 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b011 #b01010001)
                arg3
                (fp #b1 #b000 #b00000000)))
(assert (fp.leq (fp #b1 #b000 #b00000000)
                arg3
                (fp #b0 #b010 #b01111000)))
; arg3 = -0

(declare-const result (_ FloatingPoint 3 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b111 #b00000000)
                expect
                (fp #b1 #b110 #b11111111)))
(assert (fp.leq (fp #b1 #b110 #b11111111)
                expect
                (fp #b0 #b110 #b10010001)))
; expect = -15.96875

(assert (not (= expect result)))

(check-sat)
(exit)
