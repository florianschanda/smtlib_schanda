; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 22))
(assert (fp.leq (fp #b1 #b101 #b101101001011111011001)
                arg1
                (fp #b0 #b000 #b010100110011110001111)))
(assert (fp.leq (fp #b0 #b000 #b010100110011110001111)
                arg1
                (fp #b0 #b011 #b111110101010100010110)))
; arg1 = 0.08128535747528076171875

(declare-const arg2 (_ FloatingPoint 3 22))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 3 22))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 3 22))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 22))
(assert (fp.leq (fp #b1 #b000 #b001011000000000100101)
                expect
                (fp #b0 #b000 #b010011000111100001101)))
(assert (fp.leq (fp #b0 #b000 #b010011000111100001101)
                expect
                (fp #b0 #b010 #b110000001100000001000)))
; expect = 0.07467806339263916015625

(assert (= expect result))

(check-sat)
(exit)
