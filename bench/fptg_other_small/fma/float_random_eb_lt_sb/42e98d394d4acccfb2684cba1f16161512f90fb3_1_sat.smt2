(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 7))
(assert (fp.leq (fp #b1 #b100 #b000010)
                arg1
                (fp #b0 #b101 #b000000)))
(assert (fp.leq (fp #b0 #b101 #b000000)
                arg1
                (fp #b0 #b101 #b101000)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 3 7))
(assert (fp.leq (fp #b1 #b011 #b100111)
                arg2
                (fp #b0 #b000 #b011111)))
(assert (fp.leq (fp #b0 #b000 #b011111)
                arg2
                (fp #b0 #b110 #b001101)))
; arg2 = 0.12109375

(declare-const arg3 (_ FloatingPoint 3 7))
(assert (fp.leq (fp #b1 #b111 #b000000)
                arg3
                (fp #b1 #b110 #b111111)))
(assert (fp.leq (fp #b1 #b110 #b111111)
                arg3
                (fp #b1 #b101 #b001110)))
; arg3 = -15.875

(declare-const result (_ FloatingPoint 3 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 7))
(assert (fp.leq (fp #b1 #b110 #b111111)
                expect
                (fp #b1 #b110 #b111011)))
(assert (fp.leq (fp #b1 #b110 #b111011)
                expect
                (fp #b1 #b000 #b010000)))
; expect = -15.375

(assert (= expect result))

(check-sat)
(exit)
