; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 12))
(assert (fp.leq (fp #b1 #b00001010 #b01110110100)
                arg2
                (fp #b0 #b00000000 #b10100101001)))
(assert (fp.leq (fp #b0 #b00000000 #b10100101001)
                arg2
                (fp #b0 #b00010001 #b10010100010)))
; arg2 = 0.00000000000000000000000000000000000000758216815154414940442725080893841084178934179929652156207549318356342382685397751629352569580078125

(declare-const arg3 (_ FloatingPoint 8 12))
(assert (fp.leq (fp #b1 #b11111101 #b10011100001)
                arg3
                (fp #b1 #b11111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000)
                arg3
                (fp #b0 #b10011011 #b00101010100)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
