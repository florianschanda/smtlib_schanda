(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 24))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 2 24))
(assert (fp.leq (fp #b1 #b10 #b10001111101111110100011)
                arg2
                (fp #b1 #b10 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10 #b10000000000000000000000)
                arg2
                (fp #b0 #b01 #b10101111011010101100011)))
; arg2 = -3.0

(declare-const arg3 (_ FloatingPoint 2 24))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00 #b11001010000000011001001)
                arg3
                (fp #b1 #b00 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00 #b00000000000000000000000)
                arg3
                (fp #b0 #b10 #b00111110000101010011000)))
; arg3 = -0

(declare-const result (_ FloatingPoint 2 24))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 24))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
