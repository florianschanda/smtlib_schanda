(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 7 12))
(assert (fp.leq (fp #b1 #b1111001 #b11001101111)
                arg2
                (fp #b1 #b1100100 #b10101110100)))
(assert (fp.leq (fp #b1 #b1100100 #b10101110100)
                arg2
                (fp #b1 #b0101010 #b10110010110)))
; arg2 = -231122927616.0

(declare-const arg3 (_ FloatingPoint 7 12))
(assert (fp.leq (fp #b1 #b1110101 #b00101100000)
                arg3
                (fp #b1 #b1001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b1001011 #b00000000000)
                arg3
                (fp #b0 #b1110010 #b11010010010)))
; arg3 = -4096.0

(declare-const result (_ FloatingPoint 7 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
