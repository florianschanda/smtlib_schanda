                arg3
                (fp #b1 #b0100 #b0011011101000100)))
; arg3 = -0.442768096923828125

(declare-const result (_ FloatingPoint 4 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

