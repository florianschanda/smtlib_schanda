; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INFINITY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 7))
(assert (fp.leq (fp #b1 #b00 #b100010)
                arg1
                (fp #b0 #b10 #b100000)))
(assert (fp.leq (fp #b0 #b10 #b100000)
                arg1
                (fp #b0 #b10 #b101011)))
; arg1 = 3.0

(declare-const arg2 (_ FloatingPoint 2 7))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 (_ FloatingPoint 2 7))
(assert (fp.leq (fp #b1 #b00 #b110011)
                arg3
                (fp #b0 #b10 #b110001)))
(assert (fp.leq (fp #b0 #b10 #b110001)
                arg3
                (fp #b0 #b10 #b110101)))
; arg3 = 3.53125

(declare-const result (_ FloatingPoint 2 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
