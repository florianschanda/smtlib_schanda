(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 18))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b010111 #b10011001000000000)
                arg1
                (fp #b1 #b000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000 #b00000000000000000)
                arg1
                (fp #b0 #b000111 #b10000101011001100)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 18))
(assert (fp.leq (fp #b1 #b111111 #b00000000000000000)
                arg2
                (fp #b1 #b111110 #b11111111111111111)))
(assert (fp.leq (fp #b1 #b111110 #b11111111111111111)
                arg2
                (fp #b0 #b000000 #b10000000010011011)))
; arg2 = -4294950912.0

(declare-const arg3 (_ FloatingPoint 6 18))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 6 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 18))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
