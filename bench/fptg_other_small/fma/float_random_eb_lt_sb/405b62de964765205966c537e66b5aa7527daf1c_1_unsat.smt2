(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b1 #b10111011 #b110110111)
                arg1
                (fp #b1 #b10001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10001001 #b000000000)
                arg1
                (fp #b0 #b00001111 #b100100000)))
; arg1 = -1024.0

(declare-const arg2 (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b1 #b01111000 #b101001010)
                arg2
                (fp #b1 #b00000000 #b010000100)))
(assert (fp.leq (fp #b1 #b00000000 #b010000100)
                arg2
                (fp #b0 #b01010001 #b101011100)))
; arg2 = -0.0000000000000000000000000000000000000030305713732137099814818988850261021381262471385530381413897504927490444970317184925079345703125

(declare-const arg3 (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b1 #b10100000 #b101011010)
                arg3
                (fp #b1 #b10001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10001001 #b000000000)
                arg3
                (fp #b0 #b10100010 #b100001111)))
; arg3 = -1024.0

(declare-const result (_ FloatingPoint 8 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b1 #b10010001 #b101100000)
                expect
                (fp #b1 #b10001000 #b111111111)))
(assert (fp.leq (fp #b1 #b10001000 #b111111111)
                expect
                (fp #b1 #b00000110 #b100000110)))
; expect = -1023.0

(assert (not (= expect result)))

(check-sat)
(exit)
