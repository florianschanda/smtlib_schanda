(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 2 6))
(assert (fp.leq (fp #b1 #b11 #b00000)
                arg1
                (fp #b1 #b00 #b00111)))
(assert (fp.leq (fp #b1 #b00 #b00111)
                arg1
                (fp #b0 #b01 #b10101)))
; arg1 = -0.21875

(declare-const arg2 (_ FloatingPoint 2 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 2 6))
(assert (fp.leq (fp #b1 #b00 #b10100)
                arg3
                (fp #b0 #b10 #b10000)))
(assert (fp.leq (fp #b0 #b10 #b10000)
                arg3
                (fp #b0 #b10 #b10100)))
; arg3 = 3.0

(declare-const result (_ FloatingPoint 2 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 6))
(assert (fp.leq (fp #b0 #b01 #b00100)
                expect
                (fp #b0 #b10 #b10000)))
(assert (fp.leq (fp #b0 #b10 #b10000)
                expect
                (fp #b0 #b10 #b11101)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
