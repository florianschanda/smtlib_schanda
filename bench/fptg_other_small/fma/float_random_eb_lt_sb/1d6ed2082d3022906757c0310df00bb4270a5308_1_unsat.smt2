(assert (fp.leq (fp #b1 #b01100 #b101100)
                arg3
                (fp #b0 #b00011 #b001100)))
(assert (fp.leq (fp #b0 #b00011 #b001100)
                arg3
                (fp #b0 #b10110 #b010100)))
; arg3 = 0.0002899169921875

(declare-const result (_ FloatingPoint 5 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 7))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
