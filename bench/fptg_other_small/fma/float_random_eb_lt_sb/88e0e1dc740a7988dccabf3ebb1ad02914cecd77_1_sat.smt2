(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 3 14))
(assert (fp.leq (fp #b1 #b000 #b1101010101110)
                arg2
                (fp #b0 #b000 #b0010100010010)))
(assert (fp.leq (fp #b0 #b000 #b0010100010010)
                arg2
                (fp #b0 #b100 #b1110011110101)))
; arg2 = 0.03961181640625

(declare-const arg3 (_ FloatingPoint 3 14))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b101 #b0100110110110)
                arg3
                (fp #b1 #b000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000 #b0000000000000)
                arg3
                (fp #b0 #b001 #b0111000011111)))
; arg3 = -0

(declare-const result (_ FloatingPoint 3 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
