(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b0100 #b00001101)
                arg1
                (fp #b0 #b1110 #b11111111)))
(assert (fp.leq (fp #b0 #b1110 #b11111111)
                arg1
                (fp #b0 #b1111 #b00000000)))
; arg1 = 255.5

(declare-const arg2 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b0111 #b00110100)
                arg2
                (fp #b0 #b0100 #b11000011)))
(assert (fp.leq (fp #b0 #b0100 #b11000011)
                arg2
                (fp #b0 #b1100 #b10100111)))
; arg2 = 0.22021484375

(declare-const arg3 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1110 #b11111111)
                arg3
                (fp #b1 #b1110 #b11101111)))
(assert (fp.leq (fp #b1 #b1110 #b11101111)
                arg3
                (fp #b1 #b1000 #b00110110)))
; arg3 = -247.5

(declare-const result (_ FloatingPoint 4 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1110 #b11111100)
                expect
                (fp #b1 #b1110 #b01111110)))
(assert (fp.leq (fp #b1 #b1110 #b01111110)
                expect
                (fp #b0 #b1101 #b00001000)))
; expect = -191.0

(assert (= expect result))

(check-sat)
(exit)
