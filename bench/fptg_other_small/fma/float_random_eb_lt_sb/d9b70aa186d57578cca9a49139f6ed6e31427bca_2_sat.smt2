(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1101 #b11100000)
                arg1
                (fp #b1 #b0000 #b00010010)))
(assert (fp.leq (fp #b1 #b0000 #b00010010)
                arg1
                (fp #b0 #b1110 #b01110010)))
; arg1 = -0.0010986328125

(declare-const arg2 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b0 #b0100 #b10110000)
                arg2
                (fp #b0 #b1110 #b11111110)))
(assert (fp.leq (fp #b0 #b1110 #b11111110)
                arg2
                (fp #b0 #b1110 #b11111111)))
; arg2 = 255.0

(declare-const arg3 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1110 #b01110001)
                arg3
                (fp #b1 #b1101 #b00000000)))
(assert (fp.leq (fp #b1 #b1101 #b00000000)
                arg3
                (fp #b1 #b1001 #b11111010)))
; arg3 = -64.0

(declare-const result (_ FloatingPoint 4 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1101 #b01000110)
                expect
                (fp #b1 #b1101 #b00000010)))
(assert (fp.leq (fp #b1 #b1101 #b00000010)
                expect
                (fp #b0 #b1110 #b10010110)))
; expect = -64.5

(assert (= expect result))

(check-sat)
(exit)
