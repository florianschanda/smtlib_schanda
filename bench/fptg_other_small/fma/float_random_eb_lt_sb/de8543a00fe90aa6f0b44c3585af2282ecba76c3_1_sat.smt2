(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0001 #b101011100101001)
                arg1
                (fp #b0 #b0000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000 #b000000000000000)
                arg1
                (fp #b0 #b0001 #b100010101001110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 4 16))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 4 16))
(assert (fp.leq (fp #b1 #b1110 #b000101011010100)
                arg3
                (fp #b1 #b0000 #b010110100100010)))
(assert (fp.leq (fp #b1 #b0000 #b010110100100010)
                arg3
                (fp #b0 #b1000 #b111010000110100)))
; arg3 = -0.00550937652587890625

(declare-const result (_ FloatingPoint 4 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
