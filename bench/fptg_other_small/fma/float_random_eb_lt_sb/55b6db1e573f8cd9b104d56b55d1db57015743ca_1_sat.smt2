(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b100 #b00000011)
                arg1
                (fp #b0 #b101 #b00000000)))
(assert (fp.leq (fp #b0 #b101 #b00000000)
                arg1
                (fp #b0 #b110 #b11100110)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b001 #b01110011)
                arg2
                (fp #b0 #b000 #b01000011)))
(assert (fp.leq (fp #b0 #b000 #b01000011)
                arg2
                (fp #b0 #b101 #b11110011)))
; arg2 = 0.0654296875

(declare-const arg3 (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b110 #b11101011)
                arg3
                (fp #b0 #b110 #b11100000)))
(assert (fp.leq (fp #b0 #b110 #b11100000)
                arg3
                (fp #b0 #b110 #b11111011)))
; arg3 = 15.0

(declare-const result (_ FloatingPoint 3 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 9))
(assert (fp.leq (fp #b1 #b110 #b01000100)
                expect
                (fp #b0 #b110 #b11101000)))
(assert (fp.leq (fp #b0 #b110 #b11101000)
                expect
                (fp #b0 #b110 #b11111101)))
; expect = 15.25

(assert (= expect result))

(check-sat)
(exit)
