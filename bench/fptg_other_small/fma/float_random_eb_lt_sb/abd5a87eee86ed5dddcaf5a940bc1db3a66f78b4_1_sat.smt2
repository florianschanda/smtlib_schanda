(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b110111100)
                arg1
                (fp #b0 #b000 #b000000000)))
(assert (fp.leq (fp #b0 #b000 #b000000000)
                arg1
                (fp #b0 #b001 #b000100101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 10))
(assert (fp.leq (fp #b1 #b110 #b001100100)
                arg2
                (fp #b0 #b100 #b111001010)))
(assert (fp.leq (fp #b0 #b100 #b111001010)
                arg2
                (fp #b0 #b101 #b100100010)))
; arg2 = 3.7890625

(declare-const arg3 (_ FloatingPoint 3 10))
(assert (fp.leq (fp #b1 #b110 #b111011110)
                arg3
                (fp #b1 #b110 #b111000000)))
(assert (fp.leq (fp #b1 #b110 #b111000000)
                arg3
                (fp #b1 #b000 #b101010100)))
; arg3 = -15.0

(declare-const result (_ FloatingPoint 3 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 10))
(assert (fp.leq (fp #b1 #b110 #b111000111)
                expect
                (fp #b1 #b110 #b111000000)))
(assert (fp.leq (fp #b1 #b110 #b111000000)
                expect
                (fp #b1 #b101 #b000000101)))
; expect = -15.0

(assert (= expect result))

(check-sat)
(exit)
