(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b100 #b0110001)
                arg1
                (fp #b0 #b000 #b0000000)))
(assert (fp.leq (fp #b0 #b000 #b0000000)
                arg1
                (fp #b0 #b001 #b0111101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b111 #b0000000)
                arg2
                (fp #b1 #b110 #b1111111)))
(assert (fp.leq (fp #b1 #b110 #b1111111)
                arg2
                (fp #b1 #b101 #b0101101)))
; arg2 = -15.9375

(declare-const arg3 (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b0 #b011 #b0011010)
                arg3
                (fp #b0 #b110 #b0000101)))
(assert (fp.leq (fp #b0 #b110 #b0000101)
                arg3
                (fp #b0 #b110 #b0110011)))
; arg3 = 8.3125

(declare-const result (_ FloatingPoint 3 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b001 #b0011100)
                expect
                (fp #b0 #b110 #b0000101)))
(assert (fp.leq (fp #b0 #b110 #b0000101)
                expect
                (fp #b0 #b110 #b0001101)))
; expect = 8.3125

(assert (= expect result))

(check-sat)
(exit)
