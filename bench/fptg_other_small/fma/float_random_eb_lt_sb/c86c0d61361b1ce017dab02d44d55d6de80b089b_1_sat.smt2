(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 6 16))
(assert (fp.leq (fp #b1 #b100011 #b010001001101011)
                arg2
                (fp #b1 #b011101 #b010101010110110)))
(assert (fp.leq (fp #b1 #b011101 #b010101010110110)
                arg2
                (fp #b0 #b010100 #b001001001110011)))
; arg2 = -0.3334197998046875

(declare-const arg3 (_ FloatingPoint 6 16))
(assert (fp.leq (fp #b1 #b000101 #b000000001000011)
                arg3
                (fp #b1 #b000000 #b010110100100010)))
(assert (fp.leq (fp #b1 #b000000 #b010110100100010)
                arg3
                (fp #b0 #b100001 #b010110110001000)))
; arg3 = -0.00000000032838443075888790190219879150390625

(declare-const result (_ FloatingPoint 6 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
