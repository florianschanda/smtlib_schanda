(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b100 #b1111010100010000)
                arg1
                (fp #b1 #b000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b000 #b0000000000000000)
                arg1
                (fp #b0 #b100 #b1100100101000011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 3 17))
(assert (fp.leq (fp #b1 #b101 #b0111001011010010)
                arg2
                (fp #b1 #b000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b000 #b0100000000000000)
                arg2
                (fp #b0 #b011 #b1010001111001111)))
; arg2 = -0.0625

(declare-const arg3 (_ FloatingPoint 3 17))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 3 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
