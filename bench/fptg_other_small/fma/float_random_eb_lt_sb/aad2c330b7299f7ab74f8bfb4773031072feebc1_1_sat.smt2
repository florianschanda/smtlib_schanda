                arg2
                (fp #b0 #b1101 #b0000000000000000000)))
(assert (fp.leq (fp #b0 #b1101 #b0000000000000000000)
                arg2
                (fp #b0 #b1101 #b1101011011110010011)))
; arg2 = 64.0

(declare-const arg3 (_ FloatingPoint 4 20))
(assert (fp.leq (fp #b1 #b1001 #b0100101111000010101)
                arg3
                (fp #b1 #b0110 #b0001011101011011000)))
(assert (fp.leq (fp #b1 #b0110 #b0001011101011011000)
                arg3
                (fp #b0 #b0100 #b0111110011001010111)))
; arg3 = -0.54561614990234375

(declare-const result (_ FloatingPoint 4 20))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 20))
(assert (fp.leq (fp #b1 #b1111 #b0000000000000000000)
                expect
                (fp #b1 #b1110 #b1111111111111111111)))
(assert (fp.leq (fp #b1 #b1110 #b1111111111111111111)
                expect
                (fp #b1 #b0100 #b1110110000010101011)))
; expect = -255.999755859375

(assert (= expect result))

(check-sat)
(exit)
