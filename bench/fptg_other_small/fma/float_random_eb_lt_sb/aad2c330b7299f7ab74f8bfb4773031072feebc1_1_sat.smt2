(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 20))
(assert (fp.leq (fp #b1 #b1011 #b1010101010001111111)
                arg1
                (fp #b1 #b1001 #b1100001001110100001)))
(assert (fp.leq (fp #b1 #b1001 #b1100001001110100001)
                arg1
                (fp #b1 #b1000 #b0110100110000001101)))
