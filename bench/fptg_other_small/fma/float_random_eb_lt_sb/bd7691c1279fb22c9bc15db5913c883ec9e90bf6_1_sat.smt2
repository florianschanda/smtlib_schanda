(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: +LARGEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 8))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 2 8))
(assert (fp.leq (fp #b1 #b01 #b1101011)
                arg2
                (fp #b0 #b10 #b1111111)))
(assert (fp.leq (fp #b0 #b10 #b1111111)
                arg2
                (fp #b0 #b11 #b0000000)))
; arg2 = 3.984375

(declare-const arg3 (_ FloatingPoint 2 8))
(assert (fp.leq (fp #b1 #b11 #b0000000)
                arg3
                (fp #b1 #b10 #b1111111)))
(assert (fp.leq (fp #b1 #b10 #b1111111)
                arg3
                (fp #b1 #b00 #b1101010)))
; arg3 = -3.984375

(declare-const result (_ FloatingPoint 2 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 8))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
