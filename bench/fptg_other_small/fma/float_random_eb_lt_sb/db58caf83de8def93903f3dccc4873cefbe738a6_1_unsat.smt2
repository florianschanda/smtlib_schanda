(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 4 6))
(assert (fp.leq (fp #b1 #b1101 #b00111)
                arg2
                (fp #b1 #b1011 #b01010)))
(assert (fp.leq (fp #b1 #b1011 #b01010)
                arg2
                (fp #b1 #b0001 #b11101)))
; arg2 = -21.0

(declare-const arg3 (_ FloatingPoint 4 6))
(assert (fp.leq (fp #b1 #b1101 #b01001)
                arg3
                (fp #b1 #b1101 #b00000)))
(assert (fp.leq (fp #b1 #b1101 #b00000)
                arg3
                (fp #b1 #b0101 #b01100)))
; arg3 = -64.0

(declare-const result (_ FloatingPoint 4 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
