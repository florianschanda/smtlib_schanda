(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 9))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 6 9))
(assert (fp.leq (fp #b0 #b000011 #b10011001)
                arg2
                (fp #b0 #b101000 #b00000000)))
(assert (fp.leq (fp #b0 #b101000 #b00000000)
                arg2
                (fp #b0 #b110111 #b11110101)))
; arg2 = 512.0

(declare-const arg3 (_ FloatingPoint 6 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010011 #b10001110)
                arg3
                (fp #b1 #b000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000 #b00000000)
                arg3
                (fp #b0 #b111001 #b01000010)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
