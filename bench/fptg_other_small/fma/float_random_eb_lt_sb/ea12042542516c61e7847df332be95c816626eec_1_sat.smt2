(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 15))
(assert (fp.leq (fp #b1 #b1001 #b10001000100010)
                arg1
                (fp #b0 #b1101 #b00000000000000)))
(assert (fp.leq (fp #b0 #b1101 #b00000000000000)
                arg1
                (fp #b0 #b1110 #b00110001100001)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 4 15))
(assert (fp.leq (fp #b0 #b0110 #b00110010001000)
                arg2
                (fp #b0 #b1010 #b00111010011001)))
(assert (fp.leq (fp #b0 #b1010 #b00111010011001)
                arg2
                (fp #b0 #b1101 #b00010111011101)))
; arg2 = 9.82470703125

(declare-const arg3 (_ FloatingPoint 4 15))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1100 #b11110101010010)
                arg3
                (fp #b0 #b0000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0000 #b00000000000000)
                arg3
                (fp #b0 #b1100 #b01110001001001)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 4 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 15))
(assert (fp.leq (fp #b1 #b1100 #b10110110100110)
                expect
                (fp #b0 #b1110 #b11111111111111)))
(assert (fp.leq (fp #b0 #b1110 #b11111111111111)
                expect
                (fp #b0 #b1111 #b00000000000000)))
; expect = 255.9921875

(assert (= expect result))

(check-sat)
(exit)
