(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 20))
(assert (fp.leq (fp #b1 #b001 #b1111110110100101001)
                arg1
                (fp #b0 #b001 #b1000110001101010100)))
(assert (fp.leq (fp #b0 #b001 #b1000110001101010100)
                arg1
                (fp #b0 #b100 #b0010110111010000101)))
; arg1 = 0.3871250152587890625

(declare-const arg2 (_ FloatingPoint 3 20))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 3 20))
(assert (fp.leq (fp #b1 #b110 #b1101001000101011110)
                arg3
                (fp #b1 #b100 #b0011011000011010010)))
(assert (fp.leq (fp #b1 #b100 #b0011011000011010010)
                arg3
                (fp #b1 #b010 #b1010110110011110101)))
; arg3 = -2.42267608642578125

(declare-const result (_ FloatingPoint 3 20))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 20))
(assert (fp.leq (fp #b1 #b110 #b1011000110001111000)
                expect
                (fp #b1 #b100 #b0010001011101011011)))
(assert (fp.leq (fp #b1 #b100 #b0010001011101011011)
                expect
                (fp #b0 #b011 #b0100001000001101010)))
; expect = -2.272808074951171875

(assert (= expect result))

(check-sat)
(exit)
