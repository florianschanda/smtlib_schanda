                arg2
                (fp #b1 #b1101 #b0000)))
(assert (fp.leq (fp #b1 #b1101 #b0000)
                arg2
                (fp #b1 #b0000 #b1100)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b1000 #b0110)
                arg3
                (fp #b1 #b0010 #b0001)))
(assert (fp.leq (fp #b1 #b0010 #b0001)
                arg3
                (fp #b0 #b0001 #b1100)))
; arg3 = -0.033203125

(declare-const result (_ FloatingPoint 4 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b0011 #b0001)
                expect
                (fp #b0 #b1110 #b1111)))
(assert (fp.leq (fp #b0 #b1110 #b1111)
                expect
                (fp #b0 #b1111 #b0000)))
; expect = 248.0

(assert (not (= expect result)))

(check-sat)
(exit)
