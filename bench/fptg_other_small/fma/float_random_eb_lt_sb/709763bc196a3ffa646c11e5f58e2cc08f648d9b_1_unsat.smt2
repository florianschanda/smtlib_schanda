(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b1111 #b0000)
                arg1
                (fp #b1 #b1110 #b1111)))
(assert (fp.leq (fp #b1 #b1110 #b1111)
                arg1
                (fp #b1 #b0011 #b0011)))
; arg1 = -248.0

(declare-const arg2 (_ FloatingPoint 4 5))
