; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b1 #b10011 #b1100100001000)
                arg1
                (fp #b1 #b00001 #b0000001001110)))
(assert (fp.leq (fp #b1 #b00001 #b0000001001110)
                arg1
                (fp #b0 #b01001 #b1111010111110)))
; arg1 = -0.00006161630153656005859375

(declare-const arg2 (_ FloatingPoint 5 14))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b0 #b10010 #b0011100011111)
                arg3
                (fp #b0 #b11101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000000)
                arg3
                (fp #b0 #b11101 #b0101001101111)))
; arg3 = 16384.0

(declare-const result (_ FloatingPoint 5 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b0 #b01101 #b0101110010101)
                expect
                (fp #b0 #b11101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000000)
                expect
                (fp #b0 #b11101 #b0001110011000)))
; expect = 16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
