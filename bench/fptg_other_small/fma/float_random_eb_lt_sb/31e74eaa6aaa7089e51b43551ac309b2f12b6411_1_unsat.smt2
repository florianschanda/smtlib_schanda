                (fp #b0 #b10110111 #b01101101010110111000)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 8 21))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 21))
