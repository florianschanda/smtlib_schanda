; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
