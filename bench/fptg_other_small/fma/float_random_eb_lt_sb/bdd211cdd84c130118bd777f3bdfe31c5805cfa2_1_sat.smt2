                arg2
                (fp #b1 #b000000 #b110111011011011001)))
(assert (fp.leq (fp #b1 #b000000 #b110111011011011001)
                arg2
                (fp #b0 #b111101 #b110011111111011101)))
; arg2 = -0.000000000806583244639114127494394779205322265625

(declare-const arg3 (_ FloatingPoint 6 19))
(assert (fp.leq (fp #b0 #b110111 #b110001100000010110)
                arg3
                (fp #b0 #b111110 #b111111111111111111)))
(assert (fp.leq (fp #b0 #b111110 #b111111111111111111)
                arg3
                (fp #b0 #b111111 #b000000000000000000)))
; arg3 = 4294959104.0

(declare-const result (_ FloatingPoint 6 19))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 19))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
