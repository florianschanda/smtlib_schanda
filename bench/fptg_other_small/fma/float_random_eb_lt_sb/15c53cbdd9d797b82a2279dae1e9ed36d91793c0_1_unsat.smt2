(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 3 16))
(assert (fp.leq (fp #b1 #b001 #b101011110001010)
                arg2
                (fp #b0 #b101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b101 #b000000000000000)
                arg2
                (fp #b0 #b101 #b110101011011110)))
; arg2 = 4.0

(declare-const arg3 (_ FloatingPoint 3 16))
(assert (fp.leq (fp #b1 #b100 #b011111101010110)
                arg3
                (fp #b1 #b000 #b010110100100010)))
(assert (fp.leq (fp #b1 #b000 #b010110100100010)
                arg3
                (fp #b0 #b010 #b100101001101001)))
; arg3 = -0.0881500244140625

(declare-const result (_ FloatingPoint 3 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
