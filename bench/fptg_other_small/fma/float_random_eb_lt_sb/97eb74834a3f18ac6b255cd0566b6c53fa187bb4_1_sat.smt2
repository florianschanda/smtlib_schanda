; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -NAN
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 23))
(assert (fp.leq (fp #b1 #b110 #b1111110101110001100011)
                arg1
                (fp #b1 #b000 #b0100000000000000000000)))
(assert (fp.leq (fp #b1 #b000 #b0100000000000000000000)
                arg1
                (fp #b0 #b010 #b1111111110100011001010)))
; arg1 = -0.0625

(declare-const arg2 (_ FloatingPoint 3 23))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const arg3 (_ FloatingPoint 3 23))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 3 23))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 23))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
