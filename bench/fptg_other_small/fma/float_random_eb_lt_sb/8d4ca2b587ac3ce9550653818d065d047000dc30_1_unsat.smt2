; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1110 #b0111011)
                arg1
                (fp #b1 #b0000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000 #b0000000)
                arg1
                (fp #b0 #b0110 #b1100111)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 4 8))
(assert (fp.leq (fp #b1 #b1101 #b1110001)
                arg2
                (fp #b1 #b1101 #b0000000)))
(assert (fp.leq (fp #b1 #b1101 #b0000000)
                arg2
                (fp #b0 #b0111 #b1001110)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 4 8))
(assert (fp.leq (fp #b1 #b1110 #b0000011)
                arg3
                (fp #b1 #b0000 #b0111011)))
(assert (fp.leq (fp #b1 #b0000 #b0111011)
                arg3
                (fp #b0 #b1100 #b0110011)))
; arg3 = -0.0072021484375

(declare-const result (_ FloatingPoint 4 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 8))
(assert (fp.leq (fp #b1 #b0011 #b1100100)
                expect
                (fp #b1 #b0000 #b0111011)))
(assert (fp.leq (fp #b1 #b0000 #b0111011)
                expect
                (fp #b0 #b1011 #b0001101)))
; expect = -0.0072021484375

(assert (not (= expect result)))

(check-sat)
(exit)
