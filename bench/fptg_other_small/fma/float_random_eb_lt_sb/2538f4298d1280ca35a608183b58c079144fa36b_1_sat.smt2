(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +ZERO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 20))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 5 20))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11010 #b0101000000101100011)
                arg2
                (fp #b0 #b00000 #b0000000000000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000000000000)
                arg2
                (fp #b0 #b10011 #b1001011011011100111)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 5 20))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00000 #b1111110101100110010)
                arg3
                (fp #b1 #b00000 #b0000000000000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000000000000)
                arg3
                (fp #b0 #b10010 #b0110110111100010110)))
; arg3 = -0

(declare-const result (_ FloatingPoint 5 20))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 20))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
