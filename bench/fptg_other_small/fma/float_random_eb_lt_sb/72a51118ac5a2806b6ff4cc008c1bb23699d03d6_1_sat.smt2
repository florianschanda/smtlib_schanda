; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 7))
(assert (fp.leq (fp #b1 #b111101 #b011110)
                arg1
                (fp #b1 #b111101 #b000000)))
(assert (fp.leq (fp #b1 #b111101 #b000000)
                arg1
                (fp #b1 #b101001 #b111000)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 7))
(assert (fp.leq (fp #b1 #b011111 #b111010)
                arg2
                (fp #b0 #b111110 #b111111)))
(assert (fp.leq (fp #b0 #b111110 #b111111)
                arg2
                (fp #b0 #b111111 #b000000)))
; arg2 = 4261412864.0

(declare-const arg3 (_ FloatingPoint 6 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 6 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
