(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b11110 #b1010000)
                arg1
                (fp #b0 #b10111 #b0000000)))
(assert (fp.leq (fp #b0 #b10111 #b0000000)
                arg1
                (fp #b0 #b11010 #b1101000)))
; arg1 = 256.0

(declare-const arg2 (_ FloatingPoint 5 8))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b10000 #b0100100)
                arg3
                (fp #b0 #b00000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000 #b1000110)
                arg3
                (fp #b0 #b01110 #b0011000)))
; arg3 = 0.00003337860107421875

(declare-const result (_ FloatingPoint 5 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
