(assert (fp.leq (fp #b0 #b0000 #b010001)
                arg3
                (fp #b0 #b1010 #b011001)))
; arg3 = 0.004150390625

(declare-const result (_ FloatingPoint 4 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 7))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
