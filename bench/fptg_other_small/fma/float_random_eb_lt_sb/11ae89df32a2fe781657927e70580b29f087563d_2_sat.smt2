(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 16))
(assert (fp.leq (fp #b0 #b11001 #b011000010100100)
                arg1
                (fp #b0 #b11110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11110 #b111111111111111)
                arg1
                (fp #b0 #b11111 #b000000000000000)))
; arg1 = 65535.0

(declare-const arg2 (_ FloatingPoint 5 16))
(assert (fp.leq (fp #b1 #b01010 #b011101000001110)
                arg2
                (fp #b0 #b01110 #b110010001011011)))
(assert (fp.leq (fp #b0 #b01110 #b110010001011011)
                arg2
                (fp #b0 #b11010 #b111001001110000)))
; arg2 = 0.8920135498046875

(declare-const arg3 (_ FloatingPoint 5 16))
(assert (fp.leq (fp #b1 #b11110 #b011111011011100)
                arg3
                (fp #b1 #b11101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11101 #b000000000000000)
                arg3
                (fp #b1 #b01110 #b100000111011100)))
; arg3 = -16384.0

(declare-const result (_ FloatingPoint 5 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 16))
(assert (fp.leq (fp #b0 #b00110 #b001000100101101)
                expect
                (fp #b0 #b11110 #b010010001011011)))
(assert (fp.leq (fp #b0 #b11110 #b010010001011011)
                expect
                (fp #b0 #b11110 #b100100101111011)))
; expect = 42075.0

(assert (= expect result))

(check-sat)
(exit)
