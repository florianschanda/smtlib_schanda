; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b0 #b10011 #b1010011010101)
                arg1
                (fp #b0 #b11101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000000)
                arg1
                (fp #b0 #b11110 #b0001010001010)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b1 #b10000 #b0100110111100)
                arg2
                (fp #b1 #b00000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000 #b0111000000111)
                arg2
                (fp #b0 #b00101 #b0011011010000)))
; arg2 = -0.000026755034923553466796875

(declare-const arg3 (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b1 #b01101 #b0000100000110)
                arg3
                (fp #b0 #b11000 #b1000001111110)))
(assert (fp.leq (fp #b0 #b11000 #b1000001111110)
                arg3
                (fp #b0 #b11100 #b1001110111011)))
; arg3 = 775.875

(declare-const result (_ FloatingPoint 5 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b0 #b10101 #b0011111001111)
                expect
                (fp #b0 #b11000 #b1000001110111)))
(assert (fp.leq (fp #b0 #b11000 #b1000001110111)
                expect
                (fp #b0 #b11100 #b0000110101110)))
; expect = 775.4375

(assert (= expect result))

(check-sat)
(exit)
