(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1110 #b010010001001000)
                arg1
                (fp #b0 #b0000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000 #b000000000000000)
                arg1
                (fp #b0 #b1000 #b010001000110101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 4 16))
(assert (fp.leq (fp #b1 #b1111 #b000000000000000)
                arg2
                (fp #b1 #b1110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1110 #b111111111111111)
                arg2
                (fp #b1 #b1000 #b110011101101000)))
; arg2 = -255.99609375

(declare-const arg3 (_ FloatingPoint 4 16))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 4 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
