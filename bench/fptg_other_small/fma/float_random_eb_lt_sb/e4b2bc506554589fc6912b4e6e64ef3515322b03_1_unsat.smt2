(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b01110 #b0001101)
                arg1
                (fp #b0 #b10111 #b0000000)))
(assert (fp.leq (fp #b0 #b10111 #b0000000)
                arg1
                (fp #b0 #b11101 #b0101001)))
; arg1 = 256.0

(declare-const arg2 (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b00101 #b0111100)
                arg2
                (fp #b1 #b00000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000 #b1101110)
                arg2
                (fp #b0 #b00000 #b1110101)))
; arg2 = -0.00005245208740234375

(declare-const arg3 (_ FloatingPoint 5 8))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 5 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b01101 #b1000000)
                expect
                (fp #b1 #b01000 #b1011011)))
(assert (fp.leq (fp #b1 #b01000 #b1011011)
                expect
                (fp #b0 #b11010 #b1010111)))
; expect = -0.01336669921875

(assert (not (= expect result)))

(check-sat)
(exit)
