(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +ZERO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 5 15))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00111 #b01101111001111)
                arg2
                (fp #b0 #b00000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b00000 #b00000000000000)
                arg2
                (fp #b0 #b00001 #b11100111101000)))
; arg2 = 0.0

(declare-const arg3 (_ FloatingPoint 5 15))
(assert (fp.leq (fp #b1 #b01111 #b10000000110001)
                arg3
                (fp #b1 #b00000 #b11111100110100)))
(assert (fp.leq (fp #b1 #b00000 #b11111100110100)
                arg3
                (fp #b0 #b00011 #b01101000000000)))
; arg3 = -0.00006027519702911376953125

(declare-const result (_ FloatingPoint 5 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 15))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
