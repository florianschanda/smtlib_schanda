(declare-const arg3 (_ FloatingPoint 2 11))
(assert (fp.leq (fp #b1 #b11 #b0000000000)
                arg3
                (fp #b1 #b10 #b1111111111)))
(assert (fp.leq (fp #b1 #b10 #b1111111111)
                arg3
                (fp #b0 #b00 #b1011101110)))
; arg3 = -3.998046875

(declare-const result (_ FloatingPoint 2 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 11))
(assert (fp.leq (fp #b1 #b11 #b0000000000)
                expect
                (fp #b1 #b10 #b1111111111)))
(assert (fp.leq (fp #b1 #b10 #b1111111111)
                expect
                (fp #b1 #b00 #b0111010011)))
; expect = -3.998046875

(assert (not (= expect result)))

