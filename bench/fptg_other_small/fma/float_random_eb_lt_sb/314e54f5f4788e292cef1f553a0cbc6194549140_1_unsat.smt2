; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 2 16))
(assert (fp.leq (fp #b1 #b01 #b100101010101111)
                arg2
                (fp #b0 #b10 #b001000001010101)))
(assert (fp.leq (fp #b0 #b10 #b001000001010101)
                arg2
                (fp #b0 #b10 #b100010011011111)))
; arg2 = 2.25518798828125

(declare-const arg3 (_ FloatingPoint 2 16))
(assert (fp.leq (fp #b1 #b00 #b111101010001110)
                arg3
                (fp #b1 #b00 #b010110100100010)))
(assert (fp.leq (fp #b1 #b00 #b010110100100010)
                arg3
                (fp #b0 #b01 #b010110000100010)))
; arg3 = -0.35260009765625

(declare-const result (_ FloatingPoint 2 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
