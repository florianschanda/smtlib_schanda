(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 17))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 2 17))
(assert (fp.leq (fp #b1 #b11 #b0000000000000000)
                arg2
                (fp #b1 #b10 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b10 #b1111111111111111)
                arg2
                (fp #b0 #b00 #b0100001100000101)))
; arg2 = -3.999969482421875

(declare-const arg3 (_ FloatingPoint 2 17))
(assert (fp.leq (fp #b1 #b10 #b1000100010101000)
                arg3
                (fp #b1 #b10 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b10 #b1000000000000000)
                arg3
                (fp #b0 #b01 #b0101101111011110)))
; arg3 = -3.0

(declare-const result (_ FloatingPoint 2 17))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
