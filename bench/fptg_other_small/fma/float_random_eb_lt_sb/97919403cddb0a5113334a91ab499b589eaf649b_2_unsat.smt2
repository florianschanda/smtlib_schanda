;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 12))
(assert (fp.leq (fp #b1 #b1110 #b11111011001)
                arg1
                (fp #b1 #b1100 #b10100111001)))
(assert (fp.leq (fp #b1 #b1100 #b10100111001)
                arg1
                (fp #b0 #b0010 #b10101110000)))
; arg1 = -52.890625

(declare-const arg2 (_ FloatingPoint 4 12))
(assert (fp.leq (fp #b1 #b1110 #b11000011001)
                arg2
                (fp #b1 #b1101 #b00000000000)))
(assert (fp.leq (fp #b1 #b1101 #b00000000000)
                arg2
                (fp #b0 #b0001 #b10111101101)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 4 12))
(assert (fp.leq (fp #b1 #b0011 #b10010100101)
                arg3
                (fp #b0 #b0000 #b11010010000)))
(assert (fp.leq (fp #b0 #b0000 #b11010010000)
                arg3
                (fp #b0 #b1000 #b11110111000)))
; arg3 = 0.0128173828125

(declare-const result (_ FloatingPoint 4 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
