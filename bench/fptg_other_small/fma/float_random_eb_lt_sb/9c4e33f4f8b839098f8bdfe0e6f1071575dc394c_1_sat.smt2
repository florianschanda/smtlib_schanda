(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 14))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 3 14))
(assert (fp.leq (fp #b1 #b110 #b1110011011011)
                arg2
                (fp #b1 #b110 #b1110000000000)))
(assert (fp.leq (fp #b1 #b110 #b1110000000000)
                arg2
                (fp #b0 #b101 #b0110110110001)))
; arg2 = -15.0

(declare-const arg3 (_ FloatingPoint 3 14))
(assert (fp.leq (fp #b1 #b101 #b1011111010010)
                arg3
                (fp #b1 #b101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b101 #b0000000000000)
                arg3
                (fp #b1 #b001 #b1000111100011)))
; arg3 = -4.0

(declare-const result (_ FloatingPoint 3 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 14))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
