; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b011 #b1010010)
                arg1
                (fp #b1 #b000 #b0100000)))
(assert (fp.leq (fp #b1 #b000 #b0100000)
                arg1
                (fp #b0 #b001 #b1100100)))
; arg1 = -0.0625

(declare-const arg2 (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b110 #b1001111)
                arg2
                (fp #b1 #b100 #b1101111)))
(assert (fp.leq (fp #b1 #b100 #b1101111)
                arg2
                (fp #b0 #b000 #b1001100)))
; arg2 = -3.734375

(declare-const arg3 (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b101 #b1010101)
                arg3
                (fp #b1 #b000 #b0111011)))
(assert (fp.leq (fp #b1 #b000 #b0111011)
                arg3
                (fp #b0 #b101 #b0010101)))
; arg3 = -0.115234375

(declare-const result (_ FloatingPoint 3 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b011 #b0110001)
                expect
                (fp #b0 #b000 #b0111101)))
(assert (fp.leq (fp #b0 #b000 #b0111101)
                expect
                (fp #b0 #b101 #b1101100)))
; expect = 0.119140625

(assert (not (= expect result)))

(check-sat)
(exit)
