(assert (fp.leq (fp #b0 #b11000 #b1000001111110)
                arg3
                (fp #b0 #b11110 #b0101111100101)))
; arg3 = 775.875

(declare-const result (_ FloatingPoint 5 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 14))
(assert (fp.leq (fp #b1 #b11111 #b0000000000000)
                expect
