; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111100 #b100011)
                arg1
                (fp #b1 #b1000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000110 #b000000)
                arg1
                (fp #b0 #b0000000 #b110100)))
; arg1 = -128.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0001001 #b000111)
                arg2
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg2
                (fp #b0 #b1110011 #b010100)))
; arg2 = 128.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
