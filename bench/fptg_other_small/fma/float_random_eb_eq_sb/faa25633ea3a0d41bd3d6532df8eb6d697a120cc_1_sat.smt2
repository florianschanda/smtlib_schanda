                arg2
                (fp #b0 #b0000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000 #b010000)
                arg2
                (fp #b0 #b0111101 #b110101)))
; arg2 = 0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110011 #b100000)
                arg3
                (fp #b1 #b1000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000110 #b000000)
                arg3
                (fp #b0 #b0001101 #b100000)))
; arg3 = -128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010010 #b000110)
                expect
                (fp #b1 #b1000101 #b111111)))
(assert (fp.leq (fp #b1 #b1000101 #b111111)
                expect
                (fp #b0 #b0010101 #b010101)))
; expect = -127.0

(assert (= expect result))

(check-sat)
(exit)
