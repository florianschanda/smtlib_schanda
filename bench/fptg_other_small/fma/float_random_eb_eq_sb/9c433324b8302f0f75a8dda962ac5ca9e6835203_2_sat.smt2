(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b11010 #b1100)
                arg1
                (fp #b0 #b11101 #b0111)))
(assert (fp.leq (fp #b0 #b11101 #b0111)
                arg1
                (fp #b0 #b11101 #b1111)))
; arg1 = 23552.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00110 #b0010)
                arg2
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg2
                (fp #b0 #b11101 #b0110)))
; arg2 = 16384.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0000)
                arg3
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg3
                (fp #b1 #b10101 #b1010)))
; arg3 = -16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
