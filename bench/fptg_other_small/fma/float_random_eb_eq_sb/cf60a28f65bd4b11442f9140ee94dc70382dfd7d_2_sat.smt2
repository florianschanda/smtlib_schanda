                arg2
                (fp #b0 #b10110 #b1000)))
; arg2 = 0.000026702880859375

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b0110)
                arg3
                (fp #b1 #b10110 #b0101)))
(assert (fp.leq (fp #b1 #b10110 #b0101)
                arg3
                (fp #b1 #b01010 #b1101)))
; arg3 = -168.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0000)
                expect
                (fp #b1 #b10110 #b0110)))
(assert (fp.leq (fp #b1 #b10110 #b0110)
                expect
                (fp #b0 #b10000 #b1101)))
; expect = -176.0

(assert (= expect result))

(check-sat)
(exit)
