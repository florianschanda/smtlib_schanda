(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101010 #b001000)
                arg1
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg1
                (fp #b0 #b1001011 #b000001)))
; arg1 = 128.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101111 #b011110)
                arg2
                (fp #b1 #b1101010 #b001101)))
(assert (fp.leq (fp #b1 #b1101010 #b001101)
                arg2
                (fp #b0 #b0111001 #b001010)))
; arg2 = -10582799417344.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b101010)
                expect
                (fp #b1 #b1110001 #b001101)))
(assert (fp.leq (fp #b1 #b1110001 #b001101)
                expect
                (fp #b0 #b1000010 #b100100)))
; expect = -1354598325420032.0

(assert (= expect result))

(check-sat)
(exit)
