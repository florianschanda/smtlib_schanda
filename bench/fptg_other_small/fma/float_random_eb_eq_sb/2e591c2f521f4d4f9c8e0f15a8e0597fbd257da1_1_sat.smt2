(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b11110)
                arg1
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg1
                (fp #b0 #b010100 #b10110)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010110 #b01110)
                arg2
                (fp #b1 #b010100 #b00110)))
(assert (fp.leq (fp #b1 #b010100 #b00110)
                arg2
                (fp #b1 #b000001 #b01100)))
; arg2 = -0.000579833984375

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
