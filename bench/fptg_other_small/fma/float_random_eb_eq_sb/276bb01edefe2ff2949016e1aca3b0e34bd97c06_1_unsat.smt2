(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000011 #b01111)
                arg1
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg1
                (fp #b0 #b011100 #b10100)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b11010)
                arg2
                (fp #b0 #b000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000 #b10101)
                arg2
                (fp #b0 #b000110 #b11000)))
; arg2 = 0.00000000061118043959140777587890625

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))
; arg3 = -Infinity

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
