                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg3
                (fp #b0 #b1001001 #b011001)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0000001 #b000010)
                expect
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                expect
                (fp #b0 #b1010010 #b100011)))
; expect = 128.0

(assert (= expect result))

(check-sat)
