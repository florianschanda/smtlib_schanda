; arg2 = 0.000026702880859375

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00100 #b1011)
                arg3
                (fp #b1 #b00000 #b1011)))
(assert (fp.leq (fp #b1 #b00000 #b1011)
                arg3
                (fp #b0 #b10101 #b1011)))
; arg3 = -0.000041961669921875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00001 #b1000)
                expect
                (fp #b0 #b01110 #b0100)))
(assert (fp.leq (fp #b0 #b01110 #b0100)
                expect
                (fp #b0 #b10111 #b0101)))
; expect = 0.625

(assert (= expect result))

(check-sat)
