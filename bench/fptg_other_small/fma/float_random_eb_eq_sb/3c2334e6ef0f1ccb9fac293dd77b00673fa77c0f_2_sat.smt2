(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg1
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                arg1
                (fp #b0 #b11111 #b0000)))
; arg1 = 63488.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00010 #b0000)
                arg2
                (fp #b0 #b00100 #b0000)))
(assert (fp.leq (fp #b0 #b00100 #b0000)
                arg2
                (fp #b0 #b01110 #b0110)))
; arg2 = 0.00048828125

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b10001 #b0010)
                expect
                (fp #b0 #b10011 #b1111)))
(assert (fp.leq (fp #b0 #b10011 #b1111)
                expect
                (fp #b0 #b10100 #b0001)))
; expect = 31.0

(assert (= expect result))

(check-sat)
(exit)
