; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +NAN
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1001)
                arg1
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg1
                (fp #b0 #b11110 #b1010)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b10000 #b0011)
                arg3
                (fp #b0 #b11110 #b0011)))
(assert (fp.leq (fp #b0 #b11110 #b0011)
                arg3
                (fp #b0 #b11111 #b0000)))
; arg3 = 38912.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
