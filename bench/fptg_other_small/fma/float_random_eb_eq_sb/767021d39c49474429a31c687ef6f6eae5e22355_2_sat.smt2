(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b1000)
                arg1
                (fp #b0 #b00101 #b1101)))
(assert (fp.leq (fp #b0 #b00101 #b1101)
                arg1
                (fp #b0 #b00111 #b1100)))
; arg1 = 0.00177001953125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00110 #b1011)
                arg2
                (fp #b0 #b11000 #b0011)))
(assert (fp.leq (fp #b0 #b11000 #b0011)
                arg2
                (fp #b0 #b11110 #b1101)))
; arg2 = 608.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0010)
                arg3
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg3
                (fp #b0 #b10010 #b1111)))
; arg3 = -16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0101)
                expect
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                expect
                (fp #b1 #b11000 #b1000)))
; expect = -16384.0

(assert (= expect result))

(check-sat)
(exit)
