(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100101 #b10100)
                arg3
                (fp #b1 #b100010 #b10101)))
(assert (fp.leq (fp #b1 #b100010 #b10101)
                arg3
                (fp #b1 #b010001 #b11100)))
; arg3 = -13.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
