; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000110 #b00011)
                arg2
                (fp #b0 #b010001 #b11001)))
(assert (fp.leq (fp #b0 #b010001 #b11001)
                arg2
                (fp #b0 #b010011 #b11001)))
; arg2 = 0.0001087188720703125

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b10001)
                arg3
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg3
                (fp #b0 #b101101 #b00111)))
; arg3 = -64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
