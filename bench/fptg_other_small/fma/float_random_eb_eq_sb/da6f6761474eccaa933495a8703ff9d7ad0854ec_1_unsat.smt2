(assert (fp.leq (fp #b1 #b0011110 #b010111)
                arg3
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg3
                (fp #b0 #b0010001 #b011011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1000000 #b110110)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b1000101 #b101110)))
; expect = 0.0

(assert (not (= expect result)))

