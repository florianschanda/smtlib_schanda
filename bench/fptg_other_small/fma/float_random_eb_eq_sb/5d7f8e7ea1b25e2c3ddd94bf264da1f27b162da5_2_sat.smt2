(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b10001)
                arg1
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg1
                (fp #b0 #b100110 #b10111)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10111)
                arg2
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg2
                (fp #b1 #b011001 #b11101)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01110)
                arg3
                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg3
                (fp #b1 #b111000 #b11010)))
; arg3 = -1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b11001)
                expect
                (fp #b1 #b111101 #b00001)))
(assert (fp.leq (fp #b1 #b111101 #b00001)
                expect
                (fp #b1 #b010111 #b00001)))
; expect = -1107296256.0

(assert (= expect result))

(check-sat)
(exit)
