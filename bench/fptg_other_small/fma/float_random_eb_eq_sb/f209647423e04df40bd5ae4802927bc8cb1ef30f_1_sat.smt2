                arg2
                (fp #b1 #b11110 #b0011)))
(assert (fp.leq (fp #b1 #b11110 #b0011)
                arg2
                (fp #b0 #b01111 #b0100)))
; arg2 = -38912.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0101)
                arg3
                (fp #b1 #b10100 #b0000)))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg3
                (fp #b1 #b01110 #b1010)))
; arg3 = -32.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0010)
                expect
                (fp #b1 #b10011 #b1111)))
(assert (fp.leq (fp #b1 #b10011 #b1111)
                expect
                (fp #b1 #b10001 #b1010)))
; expect = -31.0

(assert (= expect result))

(check-sat)
(exit)
