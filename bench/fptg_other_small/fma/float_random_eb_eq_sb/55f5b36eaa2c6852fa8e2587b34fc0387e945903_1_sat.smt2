(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b000)
                arg1
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg1
                (fp #b0 #b0100 #b110)))
; arg1 = 0.01171875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                arg2
                (fp #b0 #b1000 #b011)))
(assert (fp.leq (fp #b0 #b1000 #b011)
                arg2
                (fp #b0 #b1100 #b110)))
; arg2 = 2.75

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b010)
                arg3
                (fp #b1 #b0000 #b100)))
(assert (fp.leq (fp #b1 #b0000 #b100)
                arg3
                (fp #b1 #b0000 #b000)))
; arg3 = -0.0078125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b100)
                expect
                (fp #b0 #b0001 #b100)))
(assert (fp.leq (fp #b0 #b0001 #b100)
                expect
                (fp #b0 #b1010 #b001)))
; expect = 0.0234375

(assert (= expect result))

(check-sat)
(exit)
