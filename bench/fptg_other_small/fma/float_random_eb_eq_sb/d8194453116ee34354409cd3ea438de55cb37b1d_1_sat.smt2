(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b111)
                arg1
                (fp #b0 #b1101 #b000)))
(assert (fp.leq (fp #b0 #b1101 #b000)
                arg1
                (fp #b0 #b1110 #b101)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b101)
                arg2
                (fp #b0 #b1000 #b011)))
(assert (fp.leq (fp #b0 #b1000 #b011)
                arg2
                (fp #b0 #b1010 #b011)))
; arg2 = 2.75

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0011 #b000)
                arg3
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg3
                (fp #b0 #b0011 #b001)))
; arg3 = -0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b110)
                expect
                (fp #b0 #b1110 #b011)))
(assert (fp.leq (fp #b0 #b1110 #b011)
                expect
                (fp #b0 #b1110 #b100)))
; expect = 176.0

(assert (= expect result))

(check-sat)
(exit)
