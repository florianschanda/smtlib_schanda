(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b1100 #b111)))
(assert (fp.leq (fp #b1 #b1100 #b111)
                arg1
                (fp #b0 #b1101 #b100)))
; arg1 = -60.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b111)
                arg2
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg2
                (fp #b0 #b1110 #b000)))
; arg2 = 0.01171875

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1010 #b011)
                arg3
                (fp #b0 #b0000 #b000)))
(assert (fp.leq (fp #b0 #b0000 #b000)
                arg3
                (fp #b0 #b0101 #b111)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b100)
                expect
                (fp #b1 #b0110 #b011)))
(assert (fp.leq (fp #b1 #b0110 #b011)
                expect
                (fp #b0 #b0111 #b011)))
; expect = -0.6875

(assert (= expect result))

(check-sat)
(exit)
