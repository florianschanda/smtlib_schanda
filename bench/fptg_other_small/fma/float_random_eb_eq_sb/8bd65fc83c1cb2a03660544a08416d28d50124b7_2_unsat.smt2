(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b100)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b0101 #b010)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b101)
                arg2
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg2
                (fp #b0 #b0100 #b100)))
; arg2 = -0.00390625

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b011)
                arg3
                (fp #b1 #b0010 #b101)))
(assert (fp.leq (fp #b1 #b0010 #b101)
                arg3
                (fp #b0 #b1100 #b111)))
; arg3 = -0.05078125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b101)
                expect
                (fp #b1 #b0010 #b101)))
(assert (fp.leq (fp #b1 #b0010 #b101)
                expect
                (fp #b0 #b0100 #b100)))
; expect = -0.05078125

(assert (not (= expect result)))

(check-sat)
(exit)
