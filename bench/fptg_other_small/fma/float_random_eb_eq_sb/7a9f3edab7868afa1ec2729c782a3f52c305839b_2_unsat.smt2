(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b11)
                arg1
                (fp #b1 #b101 #b00)))
(assert (fp.leq (fp #b1 #b101 #b00)
                arg1
                (fp #b0 #b000 #b10)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b10)
                arg2
                (fp #b1 #b110 #b00)))
(assert (fp.leq (fp #b1 #b110 #b00)
                arg2
                (fp #b0 #b111 #b00)))
; arg2 = -8.0

(declare-const arg3 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg3
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg3
                (fp #b0 #b010 #b01)))
; arg3 = 0.0625

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
