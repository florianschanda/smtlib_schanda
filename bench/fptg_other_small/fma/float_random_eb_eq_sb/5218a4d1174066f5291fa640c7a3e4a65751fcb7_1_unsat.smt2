; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b111)
                arg1
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg1
                (fp #b0 #b1011 #b001)))
; arg1 = 0.01171875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b000)
                arg2
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg2
                (fp #b0 #b0101 #b011)))
; arg2 = 0.01171875

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b010)
                arg3
                (fp #b1 #b1101 #b000)))
(assert (fp.leq (fp #b1 #b1101 #b000)
                arg3
                (fp #b0 #b0101 #b000)))
; arg3 = -64.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b000)
                expect
                (fp #b1 #b1100 #b111)))
(assert (fp.leq (fp #b1 #b1100 #b111)
                expect
                (fp #b0 #b1001 #b110)))
; expect = -60.0

(assert (not (= expect result)))

(check-sat)
(exit)
