(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000101 #b00010)
                arg2
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg2
                (fp #b0 #b111101 #b00101)))
; arg2 = 1073741824.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011100 #b01110)
                arg3
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg3
                (fp #b0 #b111000 #b10111)))
; arg3 = 64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
