(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b000)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b0001 #b011)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b101)
                arg3
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg3
                (fp #b0 #b0000 #b100)))
; arg3 = -0.00390625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
