(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b11)))
(assert (fp.leq (fp #b0 #b110 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 14.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg2
                (fp #b1 #b110 #b11)))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg2
                (fp #b0 #b001 #b01)))
; arg2 = -14.0

(declare-const arg3 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg3
                (fp #b0 #b001 #b01)))
(assert (fp.leq (fp #b0 #b001 #b01)
                arg3
                (fp #b0 #b110 #b01)))
; arg3 = 0.3125

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
