                arg2
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg2
                (fp #b0 #b010001 #b01011)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100011 #b00001)
                arg3
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg3
                (fp #b0 #b101100 #b11010)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111111 #b00000)
                expect
                (fp #b1 #b111110 #b11111)))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                expect
                (fp #b1 #b000010 #b01111)))
; expect = -4227858432.0

(assert (not (= expect result)))

(check-sat)
(exit)
