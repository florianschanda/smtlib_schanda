(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                arg1
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                arg1
                (fp #b1 #b1010011 #b010011)))
; arg1 = -18302628885633695744.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111100 #b110011)
                arg2
                (fp #b1 #b0101000 #b111001)))
(assert (fp.leq (fp #b1 #b0101000 #b111001)
                arg2
                (fp #b0 #b0101111 #b010101)))
; arg2 = -0.00000022538006305694580078125

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000111 #b000011)
                expect
                (fp #b0 #b1101000 #b111000)))
(assert (fp.leq (fp #b0 #b1101000 #b111000)
                expect
                (fp #b0 #b1110011 #b110001)))
; expect = 4123168604160.0

(assert (= expect result))

(check-sat)
(exit)
