(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001110 #b00001)
                arg1
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg1
                (fp #b0 #b111110 #b11111)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b10111)
                arg2
                (fp #b0 #b010001 #b11001)))
(assert (fp.leq (fp #b0 #b010001 #b11001)
                arg2
                (fp #b0 #b101011 #b00101)))
; arg2 = 0.0001087188720703125

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100010 #b10011)
                arg3
                (fp #b0 #b111101 #b00010)))
(assert (fp.leq (fp #b0 #b111101 #b00010)
                arg3
                (fp #b0 #b111110 #b11010)))
; arg3 = 1140850688.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b110100 #b11001)
                expect
                (fp #b0 #b111101 #b00010)))
(assert (fp.leq (fp #b0 #b111101 #b00010)
                expect
                (fp #b0 #b111110 #b00100)))
; expect = 1140850688.0

(assert (= expect result))

(check-sat)
(exit)
