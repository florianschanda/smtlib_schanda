(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b111)
                arg1
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg1
                (fp #b0 #b1100 #b111)))
; arg1 = 56.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg2
                (fp #b1 #b0000 #b101)))
(assert (fp.leq (fp #b1 #b0000 #b101)
                arg2
                (fp #b1 #b0000 #b001)))
; arg2 = -0.009765625

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b011)
                arg3
                (fp #b1 #b0000 #b100)))
(assert (fp.leq (fp #b1 #b0000 #b100)
                arg3
                (fp #b0 #b0011 #b101)))
; arg3 = -0.0078125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b110)
                expect
                (fp #b1 #b0110 #b000)))
(assert (fp.leq (fp #b1 #b0110 #b000)
                expect
                (fp #b0 #b1010 #b100)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
