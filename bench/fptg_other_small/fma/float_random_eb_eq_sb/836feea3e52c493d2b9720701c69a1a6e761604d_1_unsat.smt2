(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010001 #b10110)
                arg2
                (fp #b0 #b111110 #b11111)))
(assert (fp.leq (fp #b0 #b111110 #b11111)
                arg2
                (fp #b0 #b111111 #b00000)))
; arg2 = 4227858432.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b111100 #b01100)
                arg3
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg3
                (fp #b0 #b010000 #b11000)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
