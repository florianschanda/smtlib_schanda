(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b011)
                arg1
                (fp #b0 #b1011 #b000)))
(assert (fp.leq (fp #b0 #b1011 #b000)
                arg1
                (fp #b0 #b1110 #b110)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b110)
                arg2
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg2
                (fp #b0 #b1110 #b010)))
; arg2 = 0.01171875

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b101)
                arg3
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg3
                (fp #b0 #b1101 #b010)))
; arg3 = 0.00390625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b101)
                expect
                (fp #b0 #b0100 #b101)))
(assert (fp.leq (fp #b0 #b0100 #b101)
                expect
                (fp #b0 #b1100 #b000)))
; expect = 0.203125

(assert (not (= expect result)))

(check-sat)
(exit)
