                arg2
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                arg2
                (fp #b0 #b11111 #b0000)))
; arg2 = 63488.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01010 #b0001)
                arg3
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg3
                (fp #b0 #b11110 #b0111)))
; arg3 = 16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b0110)
                expect
                (fp #b0 #b11100 #b1101)))
(assert (fp.leq (fp #b0 #b11100 #b1101)
                expect
                (fp #b0 #b11101 #b1110)))
; expect = 14848.0

(assert (= expect result))

(check-sat)
(exit)
