(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1011)
                arg1
                (fp #b1 #b01001 #b0001)))
(assert (fp.leq (fp #b1 #b01001 #b0001)
                arg1
