(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b0010)
                arg1
                (fp #b1 #b00000 #b0011)))
(assert (fp.leq (fp #b1 #b00000 #b0011)
                arg1
                (fp #b0 #b00111 #b0010)))
; arg1 = -0.000011444091796875

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b10111 #b1111)
                arg2
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                arg2
                (fp #b0 #b11111 #b0000)))
; arg2 = 63488.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0110)
                arg3
                (fp #b0 #b01101 #b0011)))
(assert (fp.leq (fp #b0 #b01101 #b0011)
                arg3
                (fp #b0 #b10100 #b0111)))
; arg3 = 0.296875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0110)
                expect
                (fp #b1 #b01101 #b1100)))
(assert (fp.leq (fp #b1 #b01101 #b1100)
                expect
                (fp #b0 #b10011 #b0100)))
; expect = -0.4375

(assert (= expect result))

(check-sat)
(exit)
