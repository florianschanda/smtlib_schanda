(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010001 #b010111)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b0001101 #b010101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1010111 #b100010)
                arg2
                (fp #b0 #b1111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111101 #b000000)
                arg2
                (fp #b0 #b1111110 #b100010)))
; arg2 = 4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100100 #b010001)
                arg3
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg3
                (fp #b0 #b1010110 #b011110)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010100 #b011101)
                expect
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                expect
                (fp #b0 #b1111011 #b100001)))
; expect = 128.0

(assert (= expect result))

(check-sat)
(exit)
