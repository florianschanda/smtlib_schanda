(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b0001 #b100)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b000)
                arg2
                (fp #b1 #b0011 #b000)))
(assert (fp.leq (fp #b1 #b0011 #b000)
                arg2
                (fp #b0 #b1001 #b010)))
; arg2 = -0.0625

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0010 #b001)
                arg3
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg3
                (fp #b0 #b1111 #b000)))
; arg3 = -0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0110 #b010)
                expect
                (fp #b0 #b0000 #b000)))
(assert (fp.leq (fp #b0 #b0000 #b000)
                expect
                (fp #b0 #b0011 #b111)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
