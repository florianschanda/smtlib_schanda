; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001011 #b101110)
                arg1
                (fp #b1 #b0101001 #b011010)))
(assert (fp.leq (fp #b1 #b0101001 #b011010)
                arg1
                (fp #b0 #b1000000 #b101001)))
; arg1 = -0.000000335276126861572265625

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011111 #b010110)
                arg2
                (fp #b0 #b1011111 #b011000)))
(assert (fp.leq (fp #b0 #b1011111 #b011000)
                arg2
                (fp #b0 #b1100101 #b110110)))
; arg2 = 5905580032.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101111 #b111110)
                arg3
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg3
                (fp #b0 #b1001111 #b001101)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b001110)
                expect
                (fp #b1 #b1001001 #b110100)))
(assert (fp.leq (fp #b1 #b1001001 #b110100)
                expect
                (fp #b0 #b1111010 #b100011)))
; expect = -1856.0

(assert (= expect result))

(check-sat)
(exit)
