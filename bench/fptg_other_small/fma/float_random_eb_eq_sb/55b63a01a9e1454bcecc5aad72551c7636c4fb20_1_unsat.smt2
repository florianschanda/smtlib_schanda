                arg3
                (fp #b1 #b0000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000 #b010000)
                arg3
                (fp #b0 #b1000000 #b100000)))
; arg3 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
