(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1111011 #b011110)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b1000101 #b100110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b011000)
                arg2
                (fp #b1 #b1111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111101 #b000000)
                arg2
                (fp #b1 #b1101001 #b010111)))
; arg2 = -4611686018427387904.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101111 #b101111)
                arg3
                (fp #b1 #b1000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000110 #b000000)
                arg3
                (fp #b0 #b0001100 #b101000)))
; arg3 = -128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b101011)
                expect
                (fp #b1 #b1000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000110 #b000000)
                expect
                (fp #b0 #b0011000 #b001101)))
; expect = -128.0

(assert (= expect result))

(check-sat)
(exit)
