; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -ZERO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b1000)
                arg1
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg1
                (fp #b0 #b11001 #b0011)))
; arg1 = 0.0000152587890625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01011 #b0101)
                arg2
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg2
                (fp #b0 #b00111 #b0100)))
; arg2 = -0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10100 #b0110)
                arg3
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                arg3
                (fp #b0 #b10101 #b0101)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01101 #b1011)
                expect
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                expect
                (fp #b0 #b10110 #b0101)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
