(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101000 #b101101)
                expect
                (fp #b1 #b0000110 #b111101)))
(assert (fp.leq (fp #b1 #b0000110 #b111101)
                expect
