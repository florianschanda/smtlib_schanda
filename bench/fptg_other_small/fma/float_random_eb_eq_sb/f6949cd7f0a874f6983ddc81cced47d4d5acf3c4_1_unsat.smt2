(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b00011)
                arg1
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg1
                (fp #b0 #b110000 #b00011)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b11110)
                arg2
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b0 #b010001 #b01101)))
; arg2 = -320.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000101 #b00000)
                arg3
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg3
                (fp #b0 #b110011 #b00001)))
; arg3 = 64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b11100)
                expect
                (fp #b0 #b101101 #b01000)))
(assert (fp.leq (fp #b0 #b101101 #b01000)
                expect
                (fp #b0 #b101101 #b11011)))
; expect = 20480.0

(assert (not (= expect result)))

(check-sat)
(exit)
