; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b11000)
                arg1
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg1
                (fp #b0 #b000000 #b11111)))
; arg1 = -0.00000000023283064365386962890625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010100 #b10100)
                arg2
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg2
                (fp #b0 #b111101 #b01011)))
; arg2 = 1073741824.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b10000)
                arg3
                (fp #b0 #b000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000 #b01000)
                arg3
                (fp #b0 #b010100 #b11010)))
; arg3 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b10100)
                expect
                (fp #b1 #b011101 #b00000)))
(assert (fp.leq (fp #b1 #b011101 #b00000)
                expect
                (fp #b0 #b011111 #b10100)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
