(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg1
                (fp #b0 #b001 #b10)))
; arg1 = 0.0625

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b00)
                arg2
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg2
                (fp #b0 #b011 #b11)))
; arg2 = -0.0625

(declare-const arg3 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b11)
                arg3
                (fp #b0 #b001 #b01)))
(assert (fp.leq (fp #b0 #b001 #b01)
                arg3
                (fp #b0 #b011 #b00)))
; arg3 = 0.3125

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b011 #b00)
                expect
                (fp #b0 #b001 #b00)))
(assert (fp.leq (fp #b0 #b001 #b00)
                expect
                (fp #b0 #b110 #b00)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
