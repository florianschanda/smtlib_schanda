(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101010 #b110000)
                arg2
                (fp #b1 #b0101000 #b111001)))
(assert (fp.leq (fp #b1 #b0101000 #b111001)
                arg2
                (fp #b1 #b0010110 #b100000)))
; arg2 = -0.00000022538006305694580078125

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1100110 #b100001)
                arg3
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                arg3
                (fp #b0 #b0011110 #b110001)))
; arg3 = -0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
