(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b11110)
                arg1
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg1
                (fp #b0 #b000011 #b01001)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010100 #b01000)
                arg2
                (fp #b0 #b111110 #b11111)))
(assert (fp.leq (fp #b0 #b111110 #b11111)
                arg2
                (fp #b0 #b111111 #b00000)))
; arg2 = 4227858432.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b111101 #b00110)
                arg3
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg3
                (fp #b0 #b100100 #b00111)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111111 #b00000)
                expect
                (fp #b1 #b111110 #b11111)))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                expect
                (fp #b1 #b111011 #b10101)))
; expect = -4227858432.0

(assert (not (= expect result)))

(check-sat)
(exit)
