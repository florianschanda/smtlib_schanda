                arg2
                (fp #b0 #b011000 #b00001)))
; arg2 = -0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b00011)
                arg3
                (fp #b0 #b000000 #b10111)))
(assert (fp.leq (fp #b0 #b000000 #b10111)
                arg3
                (fp #b0 #b110011 #b01010)))
; arg3 = 0.00000000066938810050487518310546875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b11101)
                expect
                (fp #b0 #b000101 #b00010)))
(assert (fp.leq (fp #b0 #b000101 #b00010)
                expect
                (fp #b0 #b110000 #b01110)))
; expect = 0.000000015832483768463134765625

(assert (= expect result))

(check-sat)
(exit)
