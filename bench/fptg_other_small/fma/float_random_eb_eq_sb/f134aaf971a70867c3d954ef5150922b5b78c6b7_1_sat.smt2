; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b1001)
                arg1
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg1
                (fp #b0 #b11110 #b0111)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b1110)
                arg2
                (fp #b1 #b00000 #b1110)))
(assert (fp.leq (fp #b1 #b00000 #b1110)
                arg2
                (fp #b0 #b11000 #b1110)))
; arg2 = -0.00005340576171875

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg3
                (fp #b0 #b01101 #b0011)))
(assert (fp.leq (fp #b0 #b01101 #b0011)
                arg3
                (fp #b0 #b10010 #b0011)))
; arg3 = 0.296875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b1011)
                expect
                (fp #b1 #b01110 #b0010)))
(assert (fp.leq (fp #b1 #b01110 #b0010)
                expect
                (fp #b0 #b00000 #b0111)))
; expect = -0.5625

(assert (= expect result))

(check-sat)
(exit)
