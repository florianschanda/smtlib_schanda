(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b100)
                arg1
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg1
                (fp #b0 #b0101 #b100)))
; arg1 = 0.01171875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                arg2
                (fp #b1 #b1110 #b111)))
(assert (fp.leq (fp #b1 #b1110 #b111)
                arg2
                (fp #b0 #b1100 #b010)))
; arg2 = -240.0

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg3
                (fp #b1 #b1000 #b010)))
(assert (fp.leq (fp #b1 #b1000 #b010)
                arg3
                (fp #b0 #b1101 #b111)))
; arg3 = -2.5

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b101)
                expect
                (fp #b1 #b1001 #b010)))
(assert (fp.leq (fp #b1 #b1001 #b010)
                expect
                (fp #b0 #b0000 #b110)))
; expect = -5.0

(assert (not (= expect result)))

(check-sat)
(exit)
