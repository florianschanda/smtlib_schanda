;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1001)
                arg1
                (fp #b1 #b10010 #b1001)))
(assert (fp.leq (fp #b1 #b10010 #b1001)
                arg1
                (fp #b0 #b00111 #b1000)))
; arg1 = -12.5

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b0110)
                arg2
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg2
                (fp #b0 #b10100 #b0110)))
; arg2 = 0.0000152587890625

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01111 #b0001)
                arg3
                (fp #b1 #b00000 #b1011)))
(assert (fp.leq (fp #b1 #b00000 #b1011)
                arg3
                (fp #b0 #b01100 #b1010)))
; arg3 = -0.000041961669921875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0100)
                expect
                (fp #b1 #b00010 #b1110)))
(assert (fp.leq (fp #b1 #b00010 #b1110)
                expect
                (fp #b0 #b00110 #b1001)))
; expect = -0.0002288818359375

(assert (= expect result))

(check-sat)
(exit)
