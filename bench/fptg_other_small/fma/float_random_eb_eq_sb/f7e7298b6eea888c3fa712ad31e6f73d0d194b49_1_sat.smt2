(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b010)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b1000 #b011)))
; arg1 = 0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                arg2
                (fp #b1 #b1110 #b111)))
(assert (fp.leq (fp #b1 #b1110 #b111)
                arg2
                (fp #b0 #b1101 #b001)))
; arg2 = -240.0

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b000)
                arg3
                (fp #b0 #b1000 #b001)))
(assert (fp.leq (fp #b0 #b1000 #b001)
                arg3
                (fp #b0 #b1100 #b001)))
; arg3 = 2.25

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b111)
                expect
                (fp #b0 #b0111 #b010)))
(assert (fp.leq (fp #b0 #b0111 #b010)
                expect
                (fp #b0 #b1010 #b000)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
