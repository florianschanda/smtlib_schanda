                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg2
                (fp #b0 #b111000 #b00001)))
; arg2 = -1073741824.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b100001 #b01001)
                arg3
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg3
                (fp #b0 #b111101 #b11100)))
; arg3 = 64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b11101)
                expect
                (fp #b0 #b111110 #b11111)))
(assert (fp.leq (fp #b0 #b111110 #b11111)
                expect
                (fp #b0 #b111111 #b00000)))
; expect = 4227858432.0

(assert (= expect result))

(check-sat)
(exit)
