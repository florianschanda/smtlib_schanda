(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b1001 #b001)
                arg1
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg1
                (fp #b0 #b1101 #b000)))
; arg1 = 56.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b000)
                arg2
                (fp #b1 #b1001 #b111)))
(assert (fp.leq (fp #b1 #b1001 #b111)
                arg2
                (fp #b0 #b0110 #b110)))
; arg2 = -7.5

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b110)
                arg3
                (fp #b0 #b0011 #b010)))
(assert (fp.leq (fp #b0 #b0011 #b010)
                arg3
                (fp #b0 #b1011 #b100)))
; arg3 = 0.078125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                expect
                (fp #b1 #b1110 #b111)))
(assert (fp.leq (fp #b1 #b1110 #b111)
                expect
                (fp #b1 #b1010 #b100)))
; expect = -240.0

(assert (= expect result))

(check-sat)
(exit)
