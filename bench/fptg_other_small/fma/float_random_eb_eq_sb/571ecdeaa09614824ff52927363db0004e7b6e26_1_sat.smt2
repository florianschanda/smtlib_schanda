(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000100 #b10001)
                arg1
                (fp #b0 #b110111 #b01110)))
(assert (fp.leq (fp #b0 #b110111 #b01110)
                arg1
                (fp #b0 #b110111 #b11111)))
; arg1 = 24117248.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b00010)
                arg2
                (fp #b1 #b010100 #b00110)))
(assert (fp.leq (fp #b1 #b010100 #b00110)
                arg2
                (fp #b0 #b101011 #b01011)))
; arg2 = -0.000579833984375

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b10000)
                expect
                (fp #b1 #b101100 #b10110)))
(assert (fp.leq (fp #b1 #b101100 #b10110)
                expect
                (fp #b0 #b010010 #b10101)))
; expect = -13824.0

(assert (= expect result))

(check-sat)
(exit)
