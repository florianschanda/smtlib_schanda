(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00011 #b1000)
                arg1
                (fp #b0 #b11101 #b0000)))
(assert (fp.leq (fp #b0 #b11101 #b0000)
                arg1
                (fp #b0 #b11101 #b0010)))
; arg1 = 16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10000 #b0101)
                arg2
                (fp #b1 #b00000 #b1110)))
(assert (fp.leq (fp #b1 #b00000 #b1110)
                arg2
                (fp #b0 #b10001 #b1100)))
; arg2 = -0.00005340576171875

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b0011)
                arg3
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg3
                (fp #b0 #b10001 #b0011)))
; arg3 = 0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b0010)
                expect
                (fp #b1 #b01110 #b1100)))
(assert (fp.leq (fp #b1 #b01110 #b1100)
                expect
                (fp #b0 #b10110 #b0100)))
; expect = -0.875

(assert (= expect result))

(check-sat)
(exit)
