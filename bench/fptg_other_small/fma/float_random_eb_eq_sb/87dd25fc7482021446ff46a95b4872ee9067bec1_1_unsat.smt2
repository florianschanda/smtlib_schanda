(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b010)
                arg1
                (fp #b0 #b1110 #b111)))
(assert (fp.leq (fp #b0 #b1110 #b111)
                arg1
                (fp #b0 #b1111 #b000)))
; arg1 = 240.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b101)
                arg2
                (fp #b1 #b0000 #b101)))
(assert (fp.leq (fp #b1 #b0000 #b101)
                arg2
                (fp #b0 #b0011 #b101)))
; arg2 = -0.009765625

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                arg3
                (fp #b0 #b0011 #b010)))
(assert (fp.leq (fp #b0 #b0011 #b010)
                arg3
                (fp #b0 #b1101 #b010)))
; arg3 = 0.078125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b001)
                expect
                (fp #b1 #b1000 #b001)))
(assert (fp.leq (fp #b1 #b1000 #b001)
                expect
                (fp #b0 #b1011 #b100)))
; expect = -2.25

(assert (not (= expect result)))

(check-sat)
(exit)
