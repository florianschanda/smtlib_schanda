(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111011 #b010000)
                arg1
                (fp #b1 #b1101101 #b011111)))
(assert (fp.leq (fp #b1 #b1101101 #b011111)
                arg1
                (fp #b1 #b1001010 #b010010)))
; arg1 = -104453604638720.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0110101 #b101000)
                arg3
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg3
                (fp #b0 #b0101100 #b011001)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                expect
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                expect
                (fp #b0 #b1100011 #b011011)))
; expect = -18302628885633695744.0

(assert (not (= expect result)))

(check-sat)
(exit)
