                arg3
                (fp #b0 #b00000 #b0010)))
(assert (fp.leq (fp #b0 #b00000 #b0010)
                arg3
                (fp #b0 #b01011 #b1111)))
; arg3 = 0.00000762939453125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b10001 #b0010)
                expect
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                expect
                (fp #b0 #b11111 #b0000)))
; expect = 63488.0

(assert (= expect result))

(check-sat)
