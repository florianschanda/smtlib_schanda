(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b101 #b01)))
(assert (fp.leq (fp #b0 #b101 #b01)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 5.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg2
                (fp #b1 #b010 #b01)))
(assert (fp.leq (fp #b1 #b010 #b01)
                arg2
                (fp #b0 #b100 #b11)))
; arg2 = -0.625

(declare-const arg3 (_ FloatingPoint 3 3))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b010 #b01)
                arg3
                (fp #b0 #b000 #b00)))
(assert (fp.leq (fp #b0 #b000 #b00)
                arg3
                (fp #b0 #b010 #b00)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                expect
                (fp #b1 #b100 #b10)))
(assert (fp.leq (fp #b1 #b100 #b10)
                expect
                (fp #b0 #b110 #b01)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
