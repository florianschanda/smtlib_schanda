; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1011)
                arg1
                (fp #b1 #b01001 #b0001)))
(assert (fp.leq (fp #b1 #b01001 #b0001)
                arg1
                (fp #b0 #b01111 #b1011)))
; arg1 = -0.0166015625

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01000 #b0001)
                arg2
                (fp #b0 #b11000 #b0011)))
(assert (fp.leq (fp #b0 #b11000 #b0011)
                arg2
                (fp #b0 #b11100 #b0110)))
; arg2 = 608.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1011)
                arg3
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg3
                (fp #b0 #b10100 #b0011)))
; arg3 = -16384.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1110)
                expect
                (fp #b1 #b11101 #b0001)))
(assert (fp.leq (fp #b1 #b11101 #b0001)
                expect
                (fp #b1 #b00111 #b0010)))
; expect = -17408.0

(assert (= expect result))

(check-sat)
(exit)
