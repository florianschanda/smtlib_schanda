                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b0 #b101100 #b11001)))
; arg2 = -320.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b01001)
                arg3
                (fp #b1 #b100010 #b10101)))
(assert (fp.leq (fp #b1 #b100010 #b10101)
                arg3
                (fp #b0 #b010110 #b00000)))
; arg3 = -13.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b10000)
                expect
                (fp #b1 #b100010 #b10101)))
(assert (fp.leq (fp #b1 #b100010 #b10101)
                expect
                (fp #b1 #b001001 #b00101)))
; expect = -13.25

(assert (not (= expect result)))

(check-sat)
(exit)
