(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b000)
                arg1
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg1
                (fp #b0 #b0000 #b001)))
; arg1 = -0.21875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b1011 #b111)
                arg2
                (fp #b0 #b1101 #b000)))
(assert (fp.leq (fp #b0 #b1101 #b000)
                arg2
                (fp #b0 #b1101 #b001)))
; arg2 = 64.0

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0100 #b001)
                arg3
                (fp #b0 #b0000 #b000)))
(assert (fp.leq (fp #b0 #b0000 #b000)
                arg3
                (fp #b0 #b0001 #b001)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                expect
                (fp #b1 #b1010 #b110)))
(assert (fp.leq (fp #b1 #b1010 #b110)
                expect
                (fp #b0 #b1101 #b110)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
(exit)
