(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                arg1
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                arg1
                (fp #b0 #b1010111 #b011111)))
; arg1 = -18302628885633695744.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001010 #b101011)
                arg2
                (fp #b1 #b0000000 #b101100)))
(assert (fp.leq (fp #b1 #b0000000 #b101100)
                arg2
                (fp #b0 #b0001100 #b111110)))
; arg2 = -0.000000000000000000149077798716756859676024760119616985321044921875

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0011001 #b000010)
                arg3
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg3
                (fp #b0 #b0010000 #b111101)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0111000 #b011011)
                expect
                (fp #b0 #b1000000 #b011000)))
(assert (fp.leq (fp #b0 #b1000000 #b011000)
                expect
                (fp #b0 #b1011111 #b001100)))
; expect = 2.75

(assert (= expect result))

(check-sat)
(exit)
