(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -ZERO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b011)
                arg1
                (fp #b1 #b1011 #b000)))
(assert (fp.leq (fp #b1 #b1011 #b000)
                arg1
                (fp #b1 #b0110 #b100)))
; arg1 = -16.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0100 #b011)
                arg2
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg2
                (fp #b0 #b0000 #b010)))
; arg2 = -0

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b011)
                arg3
                (fp #b0 #b1000 #b001)))
(assert (fp.leq (fp #b0 #b1000 #b001)
                arg3
                (fp #b0 #b1101 #b111)))
; arg3 = 2.25

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b001)
                expect
                (fp #b0 #b1000 #b001)))
(assert (fp.leq (fp #b0 #b1000 #b001)
                expect
                (fp #b0 #b1100 #b000)))
; expect = 2.25

(assert (not (= expect result)))

(check-sat)
(exit)
