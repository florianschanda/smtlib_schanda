                (fp #b1 #b001111 #b11001)))
(assert (fp.leq (fp #b1 #b001111 #b11001)
                arg3
                (fp #b0 #b011000 #b11010)))
; arg3 = -0.000027179718017578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01101)
                expect
                (fp #b1 #b010111 #b10111)))
(assert (fp.leq (fp #b1 #b010111 #b10111)
                expect
                (fp #b0 #b101100 #b11010)))
; expect = -0.0067138671875

(assert (= expect result))

