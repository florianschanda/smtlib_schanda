(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b11011)
                arg1
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg1
                (fp #b1 #b010110 #b01010)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b10100)
                arg2
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b0 #b111010 #b10001)))
; arg2 = -320.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100110 #b11010)
                arg3
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg3
                (fp #b0 #b111010 #b10100)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101010 #b11011)
                expect
                (fp #b0 #b101101 #b01000)))
(assert (fp.leq (fp #b0 #b101101 #b01000)
                expect
                (fp #b0 #b111101 #b10000)))
; expect = 20480.0

(assert (= expect result))

(check-sat)
(exit)
