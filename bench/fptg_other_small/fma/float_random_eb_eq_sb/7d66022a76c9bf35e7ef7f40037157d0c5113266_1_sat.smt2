(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0001)
                arg1
                (fp #b0 #b00101 #b1101)))
(assert (fp.leq (fp #b0 #b00101 #b1101)
                arg1
                (fp #b0 #b11111 #b0000)))
; arg1 = 0.00177001953125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00110 #b1001)
                arg3
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                arg3
                (fp #b0 #b11100 #b1011)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01011 #b1000)
                expect
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                expect
                (fp #b0 #b01100 #b0001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
