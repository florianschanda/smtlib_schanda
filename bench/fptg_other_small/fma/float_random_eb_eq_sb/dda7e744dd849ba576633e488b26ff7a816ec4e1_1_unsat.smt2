                arg3
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg3
                (fp #b0 #b111110 #b10000)))
; arg3 = 1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011111 #b10000)
                expect
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                expect
                (fp #b0 #b111110 #b10000)))
; expect = 1073741824.0

(assert (not (= expect result)))

