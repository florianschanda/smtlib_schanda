; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b11101)
                arg1
                (fp #b1 #b110110 #b01010)))
(assert (fp.leq (fp #b1 #b110110 #b01010)
                arg1
                (fp #b0 #b010011 #b10100)))
; arg1 = -11010048.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b10000)
                arg2
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b1 #b001001 #b00111)))
; arg2 = -320.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b101100 #b10010)
                arg3
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg3
                (fp #b0 #b011100 #b10001)))
; arg3 = -0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000111 #b01100)
                expect
                (fp #b0 #b111110 #b10100)))
(assert (fp.leq (fp #b0 #b111110 #b10100)
                expect
                (fp #b0 #b111110 #b11110)))
; expect = 3489660928.0

(assert (= expect result))

(check-sat)
(exit)
