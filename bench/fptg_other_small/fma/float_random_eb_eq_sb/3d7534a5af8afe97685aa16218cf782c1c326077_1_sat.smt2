(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b11011)
                arg1
                (fp #b1 #b000011 #b11101)))
(assert (fp.leq (fp #b1 #b000011 #b11101)
                arg1
                (fp #b0 #b100100 #b01100)))
; arg1 = -0.000000007101334631443023681640625

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010001 #b10011)
                arg2
                (fp #b1 #b000000 #b10001)))
(assert (fp.leq (fp #b1 #b000000 #b10001)
                arg2
                (fp #b0 #b100000 #b00111)))
; arg2 = -0.00000000049476511776447296142578125

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b110100 #b00001)
                arg3
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg3
                (fp #b0 #b110101 #b11100)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010000 #b00011)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b001011 #b00011)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
