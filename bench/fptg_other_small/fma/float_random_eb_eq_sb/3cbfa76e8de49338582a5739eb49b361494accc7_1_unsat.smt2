(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011110 #b01101)
                arg2
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg2
                (fp #b0 #b101001 #b10000)))
; arg2 = 64.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110101 #b10010)
                arg3
                (fp #b1 #b001111 #b11001)))
(assert (fp.leq (fp #b1 #b001111 #b11001)
                arg3
                (fp #b0 #b001100 #b00000)))
; arg3 = -0.000027179718017578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
