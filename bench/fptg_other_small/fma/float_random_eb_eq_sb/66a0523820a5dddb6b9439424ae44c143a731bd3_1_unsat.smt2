; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b110)
                arg1
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg1
                (fp #b1 #b0011 #b100)))
; arg1 = -0.21875

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0110 #b011)
                arg2
                (fp #b0 #b1000 #b011)))
(assert (fp.leq (fp #b0 #b1000 #b011)
                arg2
                (fp #b0 #b1100 #b100)))
; arg2 = 2.75

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
