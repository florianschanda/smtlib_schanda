                arg2
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg2
                (fp #b0 #b100001 #b11100)))
; arg2 = -0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010110 #b11110)
                arg3
                (fp #b1 #b000000 #b10000)))
(assert (fp.leq (fp #b1 #b000000 #b10000)
                arg3
                (fp #b0 #b010100 #b11111)))
; arg3 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b11010)
                expect
                (fp #b1 #b011101 #b00000)))
(assert (fp.leq (fp #b1 #b011101 #b00000)
                expect
                (fp #b0 #b010010 #b10011)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
