;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b11001)
                arg1
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg1
                (fp #b0 #b111111 #b00000)))
; arg1 = 1073741824.0

(declare-const arg2 (_ FloatingPoint 6 6))
