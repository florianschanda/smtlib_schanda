(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b100)
                arg1
                (fp #b1 #b1011 #b000)))
(assert (fp.leq (fp #b1 #b1011 #b000)
                arg1
                (fp #b0 #b0101 #b010)))
; arg1 = -16.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b110)
                arg2
                (fp #b0 #b1011 #b000)))
(assert (fp.leq (fp #b0 #b1011 #b000)
                arg2
                (fp #b0 #b1101 #b001)))
; arg2 = 16.0

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1101 #b000)
                arg3
                (fp #b0 #b0000 #b000)))
(assert (fp.leq (fp #b0 #b0000 #b000)
                arg3
                (fp #b0 #b1101 #b101)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                expect
                (fp #b1 #b1110 #b111)))
(assert (fp.leq (fp #b1 #b1110 #b111)
                expect
                (fp #b1 #b0001 #b000)))
; expect = -240.0

(assert (= expect result))

(check-sat)
(exit)
