                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg3
                (fp #b0 #b001111 #b10010)))
; arg3 = -1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00111)
                expect
                (fp #b1 #b111100 #b11111)))
(assert (fp.leq (fp #b1 #b111100 #b11111)
                expect
                (fp #b1 #b111001 #b01110)))
; expect = -1056964608.0

