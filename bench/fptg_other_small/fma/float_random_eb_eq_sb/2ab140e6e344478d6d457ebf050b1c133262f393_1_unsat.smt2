                arg2
                (fp #b0 #b110100 #b00011)))
; arg2 = -0.00000000049476511776447296142578125

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b11000)
                expect
                (fp #b0 #b000110 #b00010)))
(assert (fp.leq (fp #b0 #b000110 #b00010)
                expect
                (fp #b0 #b010001 #b01011)))
; expect = 0.00000003166496753692626953125

(assert (not (= expect result)))

