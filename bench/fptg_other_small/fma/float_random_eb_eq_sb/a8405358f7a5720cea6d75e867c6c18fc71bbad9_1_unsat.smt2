(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b010)
                arg1
                (fp #b0 #b1101 #b000)))
(assert (fp.leq (fp #b0 #b1101 #b000)
                arg1
                (fp #b0 #b1110 #b001)))
; arg1 = 64.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b011)
                arg2
                (fp #b1 #b0011 #b000)))
(assert (fp.leq (fp #b1 #b0011 #b000)
                arg2
                (fp #b0 #b0001 #b100)))
; arg2 = -0.0625

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b101)
                expect
                (fp #b1 #b1000 #b111)))
(assert (fp.leq (fp #b1 #b1000 #b111)
                expect
                (fp #b0 #b1110 #b000)))
; expect = -3.75

(assert (not (= expect result)))

(check-sat)
(exit)
