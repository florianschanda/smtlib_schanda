(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b01101)
                arg1
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg1
                (fp #b0 #b001011 #b11101)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011011 #b01000)
                arg2
                (fp #b0 #b111110 #b10011)))
(assert (fp.leq (fp #b0 #b111110 #b10011)
                arg2
                (fp #b0 #b111110 #b11101)))
; arg2 = 3422552064.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000001 #b01001)
                arg3
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg3
                (fp #b0 #b110110 #b00101)))
; arg3 = 64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
