(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b01111)
                arg1
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg1
                (fp #b0 #b000111 #b00000)))
; arg1 = -64.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011100 #b10100)
                arg2
                (fp #b1 #b000000 #b10001)))
(assert (fp.leq (fp #b1 #b000000 #b10001)
                arg2
                (fp #b0 #b110100 #b00011)))
; arg2 = -0.00000000049476511776447296142578125

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b11101)
                expect
                (fp #b0 #b000110 #b00011)))
(assert (fp.leq (fp #b0 #b000110 #b00011)
                expect
                (fp #b0 #b111100 #b11100)))
; expect = 0.000000032596290111541748046875

(assert (= expect result))

(check-sat)
(exit)
