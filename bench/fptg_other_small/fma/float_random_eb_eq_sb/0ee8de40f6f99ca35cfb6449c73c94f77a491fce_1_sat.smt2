                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg2
                (fp #b0 #b000101 #b00111)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000011 #b10001)
                arg3
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg3
                (fp #b0 #b111110 #b10001)))
; arg3 = 1073741824.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001110 #b11101)
                expect
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                expect
                (fp #b0 #b111110 #b11011)))
; expect = 1073741824.0

(assert (= expect result))

(check-sat)
