(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1110)
                arg1
                (fp #b1 #b11101 #b0000)))
(assert (fp.leq (fp #b1 #b11101 #b0000)
                arg1
                (fp #b1 #b11001 #b0000)))
; arg1 = -16384.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b0010)
                arg2
                (fp #b1 #b00000 #b1110)))
(assert (fp.leq (fp #b1 #b00000 #b1110)
                arg2
                (fp #b0 #b11001 #b1011)))
; arg2 = -0.00005340576171875

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00001 #b0011)
                arg3
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                arg3
                (fp #b0 #b10101 #b1010)))
; arg3 = 32.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b0001)
                expect
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                expect
                (fp #b0 #b10110 #b1100)))
; expect = 32.0

(assert (= expect result))

(check-sat)
(exit)
