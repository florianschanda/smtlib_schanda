; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b01011)
                arg1
                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg1
                (fp #b1 #b110000 #b10110)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b01110)
                arg2
                (fp #b0 #b000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000 #b10101)
                arg2
                (fp #b0 #b101011 #b10100)))
; arg2 = 0.00000000061118043959140777587890625

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b00110)
                arg3
                (fp #b1 #b000000 #b10000)))
(assert (fp.leq (fp #b1 #b000000 #b10000)
                arg3
                (fp #b0 #b101111 #b10111)))
; arg3 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101100 #b00101)
                expect
                (fp #b1 #b011110 #b01010)))
(assert (fp.leq (fp #b1 #b011110 #b01010)
                expect
                (fp #b0 #b011011 #b10101)))
; expect = -0.65625

(assert (not (= expect result)))

(check-sat)
(exit)
