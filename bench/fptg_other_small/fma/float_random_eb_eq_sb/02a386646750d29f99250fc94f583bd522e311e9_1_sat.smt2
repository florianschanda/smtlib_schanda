(assert (fp.leq (fp #b1 #b0000000 #b101100)
                arg2
                (fp #b0 #b1010101 #b011001)))
; arg2 = -0.000000000000000000149077798716756859676024760119616985321044921875

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000010 #b101000)
                expect
                (fp #b1 #b1000000 #b010111)))
(assert (fp.leq (fp #b1 #b1000000 #b010111)
                expect
                (fp #b0 #b0110101 #b101010)))
; expect = -2.71875

(assert (= expect result))

(check-sat)
