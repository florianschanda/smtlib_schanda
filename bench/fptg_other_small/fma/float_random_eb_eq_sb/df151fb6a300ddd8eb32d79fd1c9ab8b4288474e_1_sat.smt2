(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b1010)
                arg1
                (fp #b1 #b10010 #b1001)))
(assert (fp.leq (fp #b1 #b10010 #b1001)
                arg1
                (fp #b0 #b11100 #b1001)))
; arg1 = -12.5

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b10011 #b0101)
                arg2
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                arg2
                (fp #b0 #b10110 #b1111)))
; arg2 = 32.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11010 #b0001)
                arg3
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                arg3
                (fp #b0 #b10100 #b1000)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1001)
                expect
                (fp #b1 #b10111 #b1001)))
(assert (fp.leq (fp #b1 #b10111 #b1001)
                expect
                (fp #b1 #b00111 #b1111)))
; expect = -400.0

(assert (= expect result))

(check-sat)
(exit)
