(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b000 #b00)))
(assert (fp.leq (fp #b0 #b000 #b00)
                arg1
                (fp #b0 #b001 #b01)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg2
                (fp #b1 #b101 #b00)))
(assert (fp.leq (fp #b1 #b101 #b00)
                arg2
                (fp #b0 #b011 #b11)))
; arg2 = -4.0

(declare-const arg3 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b10)
                arg3
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg3
                (fp #b0 #b010 #b00)))
; arg3 = -0.0625

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b10)
                expect
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b001 #b11)))
; expect = -0.0625

(assert (= expect result))

(check-sat)
(exit)
