                arg2
                (fp #b1 #b1101010 #b001101)))
(assert (fp.leq (fp #b1 #b1101010 #b001101)
                arg2
                (fp #b1 #b1011011 #b001110)))
; arg2 = -10582799417344.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110110 #b011001)
                arg3
                (fp #b1 #b1110110 #b010011)))
(assert (fp.leq (fp #b1 #b1110110 #b010011)
                arg3
                (fp #b1 #b1010000 #b000010)))
; arg3 = -46724846133968896.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
