(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b101)
                arg2
                (fp #b1 #b1101 #b000)))
(assert (fp.leq (fp #b1 #b1101 #b000)
                arg2
                (fp #b0 #b0111 #b001)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 4 4))
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
