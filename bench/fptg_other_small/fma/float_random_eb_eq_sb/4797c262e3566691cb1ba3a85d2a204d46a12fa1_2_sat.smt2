; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b000001)
                arg1
                (fp #b1 #b1111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111101 #b000000)
                arg1
                (fp #b0 #b0111101 #b000001)))
; arg1 = -4611686018427387904.0

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101000 #b000110)
                arg2
                (fp #b1 #b1000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000110 #b000000)
                arg2
                (fp #b0 #b1111101 #b010111)))
; arg2 = -128.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b110110)
                arg3
                (fp #b1 #b0110001 #b000110)))
(assert (fp.leq (fp #b1 #b0110001 #b000110)
                arg3
                (fp #b0 #b1101101 #b100000)))
; arg3 = -0.0000667572021484375

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
