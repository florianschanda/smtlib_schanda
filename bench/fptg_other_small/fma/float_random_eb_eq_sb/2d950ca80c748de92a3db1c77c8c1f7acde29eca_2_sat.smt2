(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0100)
                arg1
                (fp #b1 #b10100 #b0000)))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg1
                (fp #b0 #b10110 #b0001)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11111 #b0000)
                arg2
                (fp #b1 #b11110 #b1111)))
(assert (fp.leq (fp #b1 #b11110 #b1111)
                arg2
                (fp #b1 #b00010 #b0010)))
; arg2 = -63488.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01001 #b0000)
                arg3
                (fp #b0 #b11110 #b0011)))
(assert (fp.leq (fp #b0 #b11110 #b0011)
                arg3
                (fp #b0 #b11110 #b1100)))
; arg3 = 38912.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
