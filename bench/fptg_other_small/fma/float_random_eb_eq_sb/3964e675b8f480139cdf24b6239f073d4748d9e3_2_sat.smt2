(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01010 #b0101)
                arg1
                (fp #b0 #b00101 #b1101)))
(assert (fp.leq (fp #b0 #b00101 #b1101)
                arg1
                (fp #b0 #b00111 #b1010)))
; arg1 = 0.00177001953125

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b11011 #b0000)
                arg2
                (fp #b0 #b11110 #b1111)))
(assert (fp.leq (fp #b0 #b11110 #b1111)
                arg2
                (fp #b0 #b11111 #b0000)))
; arg2 = 63488.0

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0010)
                arg3
                (fp #b1 #b10100 #b0000)))
(assert (fp.leq (fp #b1 #b10100 #b0000)
                arg3
                (fp #b1 #b01101 #b0001)))
; arg3 = -32.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01100 #b1110)
                expect
                (fp #b0 #b10101 #b0101)))
(assert (fp.leq (fp #b0 #b10101 #b0101)
                expect
                (fp #b0 #b11001 #b0010)))
; expect = 84.0

(assert (= expect result))

(check-sat)
(exit)
