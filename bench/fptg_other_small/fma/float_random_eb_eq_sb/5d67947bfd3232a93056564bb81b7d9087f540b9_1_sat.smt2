; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b10011)
                arg2
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg2
                (fp #b0 #b011000 #b00000)))
; arg2 = -0.00000000023283064365386962890625

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg3
                (fp #b1 #b000000 #b10000)))
(assert (fp.leq (fp #b1 #b000000 #b10000)
                arg3
                (fp #b0 #b010011 #b01011)))
; arg3 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
