; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INFINITY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b00101)
                arg1
                (fp #b1 #b110110 #b01010)))
(assert (fp.leq (fp #b1 #b110110 #b01010)
                arg1
                (fp #b1 #b010000 #b10010)))
; arg1 = -11010048.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100011 #b00010)
                arg3
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg3
                (fp #b0 #b100001 #b10101)))
; arg3 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
