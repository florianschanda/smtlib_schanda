                arg3
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg3
                (fp #b0 #b000000 #b10001)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100101 #b01111)
                expect
                (fp #b0 #b011101 #b00000)))
(assert (fp.leq (fp #b0 #b011101 #b00000)
                expect
                (fp #b0 #b111110 #b10111)))
; expect = 0.25

(assert (= expect result))

