                arg3
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg3
                (fp #b0 #b1100010 #b000111)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0111010 #b100100)
                expect
                (fp #b0 #b1111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111110 #b111111)
                expect
                (fp #b0 #b1111111 #b000000)))
; expect = 18302628885633695744.0

(assert (= expect result))

