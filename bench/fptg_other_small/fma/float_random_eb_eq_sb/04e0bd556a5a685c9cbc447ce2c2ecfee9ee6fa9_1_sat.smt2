; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000010 #b00001)
                arg1
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg1
                (fp #b0 #b001101 #b11001)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001010 #b00110)
                arg2
                (fp #b0 #b010001 #b11001)))
(assert (fp.leq (fp #b0 #b010001 #b11001)
                arg2
                (fp #b0 #b110001 #b00100)))
; arg2 = 0.0001087188720703125

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011111 #b00111)
                arg3
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                arg3
                (fp #b0 #b101101 #b00011)))
; arg3 = -0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b11010)
                expect
                (fp #b1 #b000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000 #b01000)
                expect
                (fp #b0 #b101000 #b11110)))
; expect = -0.00000000023283064365386962890625

(assert (= expect result))

(check-sat)
(exit)
