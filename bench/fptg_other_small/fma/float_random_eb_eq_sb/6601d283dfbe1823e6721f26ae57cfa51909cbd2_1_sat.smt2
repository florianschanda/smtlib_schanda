                (fp #b1 #b01010 #b1000)))
(assert (fp.leq (fp #b1 #b01010 #b1000)
                arg2
                (fp #b0 #b00111 #b0110)))
; arg2 = -0.046875

(declare-const arg3 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b1101)
                arg3
                (fp #b0 #b01101 #b0011)))
(assert (fp.leq (fp #b0 #b01101 #b0011)
                arg3
                (fp #b0 #b11101 #b0111)))
; arg3 = 0.296875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01011 #b0010)
                expect
                (fp #b0 #b01101 #b0011)))
(assert (fp.leq (fp #b0 #b01101 #b0011)
                expect
                (fp #b0 #b10010 #b1111)))
; expect = 0.296875

(assert (= expect result))

(check-sat)
(exit)
