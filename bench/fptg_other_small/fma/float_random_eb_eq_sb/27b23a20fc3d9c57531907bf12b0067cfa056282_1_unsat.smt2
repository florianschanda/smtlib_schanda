                arg2
                (fp #b0 #b1011111 #b011000)))
(assert (fp.leq (fp #b0 #b1011111 #b011000)
                arg2
                (fp #b0 #b1100111 #b010010)))
; arg2 = 5905580032.0

(declare-const arg3 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0111110 #b111100)
                arg3
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg3
                (fp #b0 #b1010100 #b110001)))
; arg3 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
