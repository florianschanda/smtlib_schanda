(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b101000 #b01011)
                arg1
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg1
                (fp #b0 #b010111 #b00011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b00100)
                arg2
                (fp #b1 #b100101 #b00000)))
(assert (fp.leq (fp #b1 #b100101 #b00000)
                arg2
                (fp #b0 #b111100 #b10100)))
; arg2 = -64.0

(declare-const arg3 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b000100 #b10010)
                arg3
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg3
                (fp #b0 #b100001 #b01001)))
; arg3 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000000 #b11001)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b101110 #b01100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
