(assert (fp.leq (fp #b1 #b001 #b1011)
                arg2
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg2
                (fp #b0 #b110 #b0001)))
; arg2 = 3.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1110)
                expect
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                expect
                (fp #b0 #b101 #b0011)))
; expect = 3.875

(assert (= expect result))

(check-sat)
(exit)
