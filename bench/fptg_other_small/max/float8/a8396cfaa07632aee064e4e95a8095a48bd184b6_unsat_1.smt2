(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                arg1
                (fp #b0 #b110 #b0011)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1001)
                arg2
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                arg2
                (fp #b0 #b110 #b1100)))
; arg2 = -0.0625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                expect
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                expect
                (fp #b0 #b101 #b0100)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
