(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg2
                (fp #b0 #b010 #b1001)))
(assert (fp.leq (fp #b0 #b010 #b1001)
                arg2
                (fp #b0 #b011 #b0111)))
; arg2 = 0.78125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                expect
                (fp #b0 #b010 #b1001)))
(assert (fp.leq (fp #b0 #b010 #b1001)
                expect
                (fp #b0 #b100 #b1011)))
; expect = 0.78125

(assert (not (= expect result)))

(check-sat)
(exit)
