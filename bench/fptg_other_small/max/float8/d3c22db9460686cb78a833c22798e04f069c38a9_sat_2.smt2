(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -LARGEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b011 #b1111)))
; arg1 = -15.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg2
                (fp #b0 #b001 #b0000)))
(assert (fp.leq (fp #b0 #b001 #b0000)
                arg2
                (fp #b0 #b010 #b0010)))
; arg2 = 0.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0000)
                expect
                (fp #b0 #b001 #b0000)))
(assert (fp.leq (fp #b0 #b001 #b0000)
                expect
                (fp #b0 #b001 #b1011)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
