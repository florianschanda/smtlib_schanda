(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg1
                (fp #b1 #b101 #b0100)))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b100 #b0000)))
; arg1 = -5.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0110)
                arg2
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg2
                (fp #b1 #b001 #b0010)))
; arg2 = -3.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1100)
                expect
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                expect
                (fp #b0 #b011 #b1011)))
; expect = -3.875

(assert (not (= expect result)))

(check-sat)
(exit)
