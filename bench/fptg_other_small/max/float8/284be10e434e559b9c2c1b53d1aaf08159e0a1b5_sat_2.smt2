                (fp #b1 #b011 #b0010)))
(assert (fp.leq (fp #b1 #b011 #b0010)
                arg2
                (fp #b0 #b011 #b0101)))
; arg2 = -1.125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1011)
                expect
                (fp #b1 #b011 #b0010)))
(assert (fp.leq (fp #b1 #b011 #b0010)
                expect
                (fp #b1 #b010 #b0010)))
; expect = -1.125

(assert (= expect result))

(check-sat)
(exit)
