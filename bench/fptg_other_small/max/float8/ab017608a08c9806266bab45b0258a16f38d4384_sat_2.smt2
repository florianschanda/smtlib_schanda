(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1010)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b0 #b100 #b0101)))
; arg1 = -3.875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1101)
                arg2
                (fp #b0 #b010 #b1000)))
(assert (fp.leq (fp #b0 #b010 #b1000)
                arg2
                (fp #b0 #b010 #b1011)))
; arg2 = 0.75

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0000)
                expect
                (fp #b0 #b010 #b1000)))
(assert (fp.leq (fp #b0 #b010 #b1000)
                expect
                (fp #b0 #b010 #b1011)))
; expect = 0.75

(assert (= expect result))

(check-sat)
(exit)
