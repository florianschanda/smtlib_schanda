                arg2
                (fp #b0 #b010 #b0000)))
(assert (fp.leq (fp #b0 #b010 #b0000)
                arg2
                (fp #b0 #b011 #b0001)))
; arg2 = 0.5

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0000)
                expect
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 15.5

(assert (not (= expect result)))

(check-sat)
(exit)
