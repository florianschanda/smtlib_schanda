; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b11)
                arg1
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b101 #b11)))
; arg1 = -0.0625

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg2
                (fp #b0 #b000 #b00)))
(assert (fp.leq (fp #b0 #b000 #b00)
                arg2
                (fp #b0 #b110 #b10)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011 #b11)
                expect
                (fp #b0 #b000 #b00)))
(assert (fp.leq (fp #b0 #b000 #b00)
                expect
                (fp #b0 #b011 #b00)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
