(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01010 #b0010)
                expect
                (fp #b0 #b11100 #b0111)))
(assert (fp.leq (fp #b0 #b11100 #b0111)
                expect
                (fp #b0 #b11100 #b1010)))
; expect = 11776.0

(assert (= expect result))

(check-sat)
(exit)
