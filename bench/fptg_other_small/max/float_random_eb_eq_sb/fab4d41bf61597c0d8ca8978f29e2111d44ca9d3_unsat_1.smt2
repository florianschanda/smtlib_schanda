(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010010 #b111011)
                arg2
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg2
                (fp #b0 #b1100110 #b000110)))
; arg2 = 128.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101110 #b011111)
                expect
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                expect
                (fp #b0 #b1100111 #b011110)))
; expect = 128.0

(assert (not (= expect result)))

(check-sat)
(exit)
