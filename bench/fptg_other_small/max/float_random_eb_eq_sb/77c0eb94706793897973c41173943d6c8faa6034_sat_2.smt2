(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1000)
                arg1
                (fp #b1 #b10111 #b1001)))
(assert (fp.leq (fp #b1 #b10111 #b1001)
                arg1
                (fp #b1 #b00010 #b1001)))
; arg1 = -400.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1000)
                expect
                (fp #b1 #b10111 #b1001)))
(assert (fp.leq (fp #b1 #b10111 #b1001)
                expect
                (fp #b0 #b01110 #b1111)))
; expect = -400.0

(assert (= expect result))

(check-sat)
(exit)
