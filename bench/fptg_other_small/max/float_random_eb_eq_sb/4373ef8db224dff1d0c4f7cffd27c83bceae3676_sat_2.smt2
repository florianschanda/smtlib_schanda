; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b101)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b1101 #b010)))
; arg1 = -0.00390625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0001 #b100)
                arg2
                (fp #b0 #b1110 #b001)))
(assert (fp.leq (fp #b0 #b1110 #b001)
                arg2
                (fp #b0 #b1110 #b100)))
; arg2 = 144.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b100)
                expect
                (fp #b0 #b1110 #b001)))
(assert (fp.leq (fp #b0 #b1110 #b001)
                expect
                (fp #b0 #b1110 #b111)))
; expect = 144.0

(assert (= expect result))

(check-sat)
(exit)
