; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b11)
                arg1
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg1
                (fp #b0 #b000 #b11)))
; arg1 = 0.0625

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg2
                (fp #b1 #b011 #b00)))
(assert (fp.leq (fp #b1 #b011 #b00)
                arg2
                (fp #b1 #b001 #b10)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b10)
                expect
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                expect
                (fp #b0 #b000 #b10)))
; expect = 0.0625

(assert (= expect result))

(check-sat)
(exit)
