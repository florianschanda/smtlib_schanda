; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011011 #b10111)
                arg1
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                arg1
                (fp #b0 #b110000 #b00000)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b011011 #b10000)
                arg2
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg2
                (fp #b0 #b110000 #b10100)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011011 #b01010)
                expect
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                expect
                (fp #b0 #b111100 #b00110)))
; expect = 0.375

(assert (not (= expect result)))

(check-sat)
(exit)
