                arg2
                (fp #b0 #b1101 #b101)))
; arg2 = 15.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0001 #b011)
                expect
                (fp #b0 #b1010 #b111)))
(assert (fp.leq (fp #b0 #b1010 #b111)
                expect
                (fp #b0 #b1011 #b101)))
; expect = 15.0

(assert (not (= expect result)))

(check-sat)
(exit)
