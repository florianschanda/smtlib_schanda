(assert (fp.leq (fp #b1 #b110001 #b11000)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b100100 #b00100)))
; expect = 0.0

(assert (= expect result))

