(assert (fp.leq (fp #b1 #b111 #b00)
                expect
                (fp #b1 #b000 #b11)))
(assert (fp.leq (fp #b1 #b000 #b11)
                expect
                (fp #b0 #b000 #b00)))
; expect = -0.1875

(assert (not (= expect result)))

