; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b010)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b1 #b0101 #b101)))
; arg1 = -1.625

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                expect
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                expect
                (fp #b0 #b1101 #b010)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
