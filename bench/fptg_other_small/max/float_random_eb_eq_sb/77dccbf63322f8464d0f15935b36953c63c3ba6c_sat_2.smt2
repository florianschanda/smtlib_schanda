(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0011)
                arg2
                (fp #b1 #b10101 #b0101)))
(assert (fp.leq (fp #b1 #b10101 #b0101)
                arg2
                (fp #b1 #b00111 #b1010)))
; arg2 = -84.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b1100)
                expect
                (fp #b1 #b10101 #b0101)))
(assert (fp.leq (fp #b1 #b10101 #b0101)
                expect
                (fp #b1 #b10101 #b0100)))
; expect = -84.0

(assert (= expect result))

(check-sat)
(exit)
