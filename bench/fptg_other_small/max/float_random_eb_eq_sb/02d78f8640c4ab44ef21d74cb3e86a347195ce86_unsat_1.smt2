(assert (fp.leq (fp #b1 #b010 #b00)
                expect
                (fp #b1 #b001 #b00)))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b1 #b000 #b01)))
; expect = -0.25

(assert (not (= expect result)))

