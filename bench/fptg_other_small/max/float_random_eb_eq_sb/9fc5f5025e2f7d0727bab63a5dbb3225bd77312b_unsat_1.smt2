(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0001 #b101)
                arg1
                (fp #b0 #b0111 #b100)))
(assert (fp.leq (fp #b0 #b0111 #b100)
                arg1
                (fp #b0 #b1001 #b010)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0001 #b110)
                expect
                (fp #b0 #b0111 #b100)))
(assert (fp.leq (fp #b0 #b0111 #b100)
                expect
                (fp #b0 #b1101 #b001)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
