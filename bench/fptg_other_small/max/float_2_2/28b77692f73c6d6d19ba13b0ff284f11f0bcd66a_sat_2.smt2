(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg1
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg2
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg2
                (fp #b0 #b00 #b0)))
; arg2 = -2.0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
