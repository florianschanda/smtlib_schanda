                arg2
                (fp #b1 #b00111110 #b0110100)))
; arg2 = -210.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101010 #b0000011)
                expect
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                expect
                (fp #b1 #b01000111 #b0010000)))
; expect = -210.0

(assert (= expect result))

(check-sat)
