                expect
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                expect
                (fp #b0 #b10011011 #b0110011)))
; expect = 243.0

(assert (not (= expect result)))

(check-sat)
