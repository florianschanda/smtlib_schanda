(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01010000 #b0010011)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b10101110 #b0110010)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011001 #b0001101)
                arg2
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b10110101 #b1110010)))
; arg2 = 1.0078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100010 #b1111000)
                expect
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                expect
                (fp #b0 #b10100110 #b0110011)))
; expect = 1.0078125

(assert (= expect result))

(check-sat)
(exit)
