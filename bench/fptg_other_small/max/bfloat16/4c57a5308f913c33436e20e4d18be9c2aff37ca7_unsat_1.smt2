(assert (fp.leq (fp #b1 #b10010001 #b1101011)
                expect
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                expect
                (fp #b0 #b10001000 #b0100000)))
; expect = 256.0

(assert (not (= expect result)))

