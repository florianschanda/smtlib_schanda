(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111000 #b1111010)
                expect
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                expect
                (fp #b0 #b11001111 #b1101110)))
; expect = 1.3359375

(assert (= expect result))

(check-sat)
(exit)
