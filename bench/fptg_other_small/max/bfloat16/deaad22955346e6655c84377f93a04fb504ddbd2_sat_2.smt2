(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001100 #b0101001)
                expect
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                expect
                (fp #b0 #b11100111 #b0110101)))
; expect = 1.0

(assert (= expect result))

(check-sat)
