                arg2
                (fp #b0 #b01111000 #b0001011)))
; arg2 = -1.6875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b1001001)
                expect
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                expect
                (fp #b0 #b10101001 #b1110100)))
; expect = -1.6875

(assert (= expect result))

(check-sat)
