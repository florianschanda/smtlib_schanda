(assert (fp.leq (fp #b1 #b10011100 #b1110111)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b01001101 #b1000101)))
; expect = -0

(assert (= expect result))

