(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10000010 #b0110011)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b11001001 #b0010110)))
; arg1 = 30.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000111 #b1110000)
                expect
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                expect
                (fp #b0 #b10010011 #b1110011)))
; expect = 30.0

(assert (= expect result))

(check-sat)
(exit)
