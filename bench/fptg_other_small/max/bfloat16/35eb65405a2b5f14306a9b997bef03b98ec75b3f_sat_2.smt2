;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110011 #b1000000)
                arg1
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                arg1
                (fp #b0 #b11000101 #b0000100)))
