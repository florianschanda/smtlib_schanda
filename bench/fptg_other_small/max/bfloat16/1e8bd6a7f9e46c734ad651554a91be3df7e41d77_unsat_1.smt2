(assert (fp.leq (fp #b1 #b10000011 #b0101000)
                expect
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                expect
                (fp #b0 #b11011001 #b0111100)))
; expect = 59.75

(assert (not (= expect result)))

