(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110011 #b0100011)
                arg1
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg1
                (fp #b0 #b00011111 #b0110011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111011 #b1101110)
                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b11011000 #b1110110)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011110 #b0111001)
                expect
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                expect
                (fp #b0 #b10110011 #b1010111)))
; expect = 129.0

(assert (not (= expect result)))

(check-sat)
(exit)
