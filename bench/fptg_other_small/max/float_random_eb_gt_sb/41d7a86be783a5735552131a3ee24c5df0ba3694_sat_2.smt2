; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b010000 #b0)
                arg1
                (fp #b0 #b010110 #b0)))
(assert (fp.leq (fp #b0 #b010110 #b0)
                arg1
                (fp #b0 #b011011 #b0)))
; arg1 = 0.001953125

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111111 #b0)
                arg2
                (fp #b1 #b111110 #b0)))
(assert (fp.leq (fp #b1 #b111110 #b0)
                arg2
                (fp #b0 #b110010 #b1)))
; arg2 = -2147483648.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b101010 #b0)
                expect
                (fp #b0 #b010110 #b0)))
(assert (fp.leq (fp #b0 #b010110 #b0)
                expect
                (fp #b0 #b100001 #b1)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
