(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11100010 #b111)
                arg1
                (fp #b0 #b00000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000 #b000)
                arg1
                (fp #b0 #b11011010 #b000)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00110111 #b001)
                arg2
                (fp #b0 #b11100000 #b001)))
(assert (fp.leq (fp #b0 #b11100000 #b001)
                arg2
                (fp #b0 #b11110111 #b110)))
; arg2 = 178263365657094759585473888256.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b11010110 #b111)
                expect
                (fp #b0 #b11100000 #b001)))
(assert (fp.leq (fp #b0 #b11100000 #b001)
                expect
                (fp #b0 #b11111011 #b111)))
; expect = 178263365657094759585473888256.0

(assert (= expect result))

(check-sat)
(exit)
