(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00010 #b1)
                arg2
                (fp #b0 #b00000 #b0)))
(assert (fp.leq (fp #b0 #b00000 #b0)
                arg2
                (fp #b0 #b01101 #b0)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11100 #b0)
                expect
                (fp #b0 #b00000 #b0)))
(assert (fp.leq (fp #b0 #b00000 #b0)
                expect
                (fp #b0 #b00011 #b0)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
