(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b001010 #b110)
                arg2
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg2
                (fp #b0 #b101100 #b011)))
; arg2 = 16.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011111 #b110)
                expect
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                expect
                (fp #b0 #b100111 #b101)))
; expect = 16.0

(assert (not (= expect result)))

(check-sat)
(exit)
