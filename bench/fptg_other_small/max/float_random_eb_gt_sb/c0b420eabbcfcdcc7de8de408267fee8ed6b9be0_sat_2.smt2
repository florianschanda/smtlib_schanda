; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b011)
                arg1
                (fp #b1 #b100010 #b110)))
(assert (fp.leq (fp #b1 #b100010 #b110)
                arg1
                (fp #b0 #b101011 #b011)))
; arg1 = -14.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110010 #b011)
                arg2
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg2
                (fp #b0 #b100111 #b001)))
; arg2 = 16.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101011 #b011)
                expect
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                expect
                (fp #b0 #b111110 #b111)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
