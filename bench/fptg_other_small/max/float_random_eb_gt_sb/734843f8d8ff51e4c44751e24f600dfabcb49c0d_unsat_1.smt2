(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b11)
                arg1
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                arg1
                (fp #b0 #b0101 #b00)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b00)
                expect
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                expect
                (fp #b0 #b0011 #b10)))
; expect = 0.0078125

(assert (not (= expect result)))

(check-sat)
(exit)
