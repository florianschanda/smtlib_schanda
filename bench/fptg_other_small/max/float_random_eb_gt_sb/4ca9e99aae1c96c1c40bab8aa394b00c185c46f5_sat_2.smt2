                expect
                (fp #b1 #b000000 #b1000)))
(assert (fp.leq (fp #b1 #b000000 #b1000)
                expect
                (fp #b0 #b111011 #b1101)))
; expect = -0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
