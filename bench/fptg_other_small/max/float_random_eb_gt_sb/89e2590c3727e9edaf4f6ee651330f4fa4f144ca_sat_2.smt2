(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001010 #b100)
                arg1
                (fp #b1 #b000000 #b001)))
(assert (fp.leq (fp #b1 #b000000 #b001)
                arg1
