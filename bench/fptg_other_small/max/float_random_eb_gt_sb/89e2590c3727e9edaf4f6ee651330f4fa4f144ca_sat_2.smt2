(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b000)
                expect
                (fp #b1 #b000000 #b001)))
(assert (fp.leq (fp #b1 #b000000 #b001)
                expect
                (fp #b0 #b010100 #b010)))
; expect = -0.000000000116415321826934814453125

(assert (= expect result))

