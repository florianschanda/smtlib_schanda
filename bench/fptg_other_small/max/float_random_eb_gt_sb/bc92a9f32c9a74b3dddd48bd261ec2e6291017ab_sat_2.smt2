(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b101000 #b001)
                arg1
                (fp #b0 #b101100 #b110)))
(assert (fp.leq (fp #b0 #b101100 #b110)
                arg1
                (fp #b0 #b110101 #b110)))
; arg1 = 14336.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b011100 #b010)
                expect
                (fp #b0 #b101100 #b110)))
(assert (fp.leq (fp #b0 #b101100 #b110)
                expect
                (fp #b0 #b110100 #b001)))
; expect = 14336.0

(assert (= expect result))

(check-sat)
(exit)
