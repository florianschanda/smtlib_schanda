(assert (fp.leq (fp #b1 #b1110 #b11)
                expect
                (fp #b1 #b1001 #b10)))
(assert (fp.leq (fp #b1 #b1001 #b10)
                expect
                (fp #b1 #b0010 #b00)))
; expect = -6.0

(assert (= expect result))

