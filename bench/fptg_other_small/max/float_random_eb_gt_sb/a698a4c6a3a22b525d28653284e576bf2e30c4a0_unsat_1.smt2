(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b1)
                arg2
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                arg2
                (fp #b0 #b100 #b0)))
; arg2 = 1.5

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
