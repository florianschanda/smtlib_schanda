(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010111 #b010)
                arg2
                (fp #b1 #b1000010 #b100)))
(assert (fp.leq (fp #b1 #b1000010 #b100)
                arg2
                (fp #b0 #b0111000 #b001)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1000101 #b010)
                expect
                (fp #b1 #b1000010 #b100)))
(assert (fp.leq (fp #b1 #b1000010 #b100)
                expect
                (fp #b0 #b1111100 #b111)))
; expect = -12.0

(assert (not (= expect result)))

(check-sat)
(exit)
