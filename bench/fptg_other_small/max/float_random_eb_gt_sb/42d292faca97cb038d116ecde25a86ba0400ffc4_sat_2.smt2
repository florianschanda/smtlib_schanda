; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b0 #b0100000 #b1)
                arg1
                (fp #b0 #b0111101 #b1)))
(assert (fp.leq (fp #b0 #b0111101 #b1)
                arg1
                (fp #b0 #b1011000 #b1)))
; arg1 = 0.375

(declare-const arg2 (_ FloatingPoint 7 2))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0000011 #b0)
                expect
                (fp #b0 #b0111101 #b1)))
(assert (fp.leq (fp #b0 #b0111101 #b1)
                expect
                (fp #b0 #b1100100 #b1)))
; expect = 0.375

(assert (= expect result))

(check-sat)
(exit)
