; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010101 #b100)
                arg1
                (fp #b1 #b000000 #b110)))
(assert (fp.leq (fp #b1 #b000000 #b110)
                arg1
                (fp #b0 #b010011 #b010)))
; arg1 = -0.00000000069849193096160888671875

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011011 #b101)
                expect
                (fp #b0 #b000000 #b110)))
(assert (fp.leq (fp #b0 #b000000 #b110)
                expect
                (fp #b0 #b111011 #b111)))
; expect = 0.00000000069849193096160888671875

(assert (= expect result))

(check-sat)
(exit)
