; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b010)
                arg2
                (fp #b0 #b000000 #b010)))
(assert (fp.leq (fp #b0 #b000000 #b010)
                arg2
                (fp #b0 #b010100 #b111)))
; arg2 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
