(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1000 #b11)
                arg1
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                arg1
                (fp #b0 #b0100 #b11)))
; arg1 = 0.0078125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b01)
                arg2
                (fp #b1 #b0111 #b00)))
(assert (fp.leq (fp #b1 #b0111 #b00)
                arg2
                (fp #b0 #b0100 #b01)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b10)
                expect
                (fp #b0 #b0000 #b10)))
(assert (fp.leq (fp #b0 #b0000 #b10)
                expect
                (fp #b0 #b0001 #b10)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
