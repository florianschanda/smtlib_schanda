; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b01)
                arg1
                (fp #b1 #b1000 #b10)))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg1
                (fp #b1 #b0010 #b01)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0111 #b11)
                arg2
                (fp #b1 #b0111 #b10)))
(assert (fp.leq (fp #b1 #b0111 #b10)
                arg2
                (fp #b1 #b0110 #b10)))
; arg2 = -1.5

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1111 #b00)
                expect
                (fp #b1 #b0111 #b10)))
(assert (fp.leq (fp #b1 #b0111 #b10)
                expect
                (fp #b1 #b0000 #b11)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
