                arg2
                (fp #b1 #b1011 #b11)))
(assert (fp.leq (fp #b1 #b1011 #b11)
                arg2
                (fp #b1 #b0110 #b10)))
; arg2 = -28.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0011 #b01)
                expect
                (fp #b0 #b0111 #b11)))
(assert (fp.leq (fp #b0 #b0111 #b11)
                expect
                (fp #b0 #b1001 #b11)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
