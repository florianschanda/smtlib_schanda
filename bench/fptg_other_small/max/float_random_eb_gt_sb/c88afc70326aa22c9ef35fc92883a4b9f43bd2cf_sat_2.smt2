;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b01)
                arg1
                (fp #b0 #b0111 #b11)))
(assert (fp.leq (fp #b0 #b0111 #b11)
                arg1
                (fp #b0 #b1110 #b01)))
; arg1 = 1.75

