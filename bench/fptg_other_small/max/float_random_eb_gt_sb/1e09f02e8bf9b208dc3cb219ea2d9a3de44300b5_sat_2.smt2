(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000010 #b11)
                arg1
                (fp #b0 #b011010 #b00)))
(assert (fp.leq (fp #b0 #b011010 #b00)
                arg1
                (fp #b0 #b110101 #b10)))
; arg1 = 0.03125

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111100 #b10)
                expect
                (fp #b0 #b011010 #b00)))
(assert (fp.leq (fp #b0 #b011010 #b00)
                expect
                (fp #b0 #b101000 #b01)))
; expect = 0.03125

(assert (= expect result))

(check-sat)
(exit)
