(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00101 #b10)
                arg2
                (fp #b1 #b00000 #b11)))
(assert (fp.leq (fp #b1 #b00000 #b11)
                arg2
                (fp #b0 #b10100 #b00)))
; arg2 = -0.0000457763671875

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
