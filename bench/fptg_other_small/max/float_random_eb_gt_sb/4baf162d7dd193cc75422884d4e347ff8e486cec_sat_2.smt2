(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101110 #b010)
                arg1
                (fp #b0 #b1000010 #b111)))
(assert (fp.leq (fp #b0 #b1000010 #b111)
                arg1
                (fp #b0 #b1001001 #b111)))
; arg1 = 15.0

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0011110 #b011)
                expect
                (fp #b0 #b1000010 #b111)))
(assert (fp.leq (fp #b0 #b1000010 #b111)
                expect
                (fp #b0 #b1000011 #b101)))
; expect = 15.0

(assert (= expect result))

(check-sat)
(exit)
