; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b010000 #b1000)
                arg1
                (fp #b0 #b111110 #b0000)))
(assert (fp.leq (fp #b0 #b111110 #b0000)
                arg1
                (fp #b0 #b111110 #b0101)))
; arg1 = 2147483648.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
