(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000111 #b0100)
                arg1
                (fp #b1 #b1000001 #b1000)))
(assert (fp.leq (fp #b1 #b1000001 #b1000)
                arg1
                (fp #b1 #b0110001 #b1001)))
; arg1 = -6.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111011 #b1110)
                expect
                (fp #b1 #b1000001 #b1000)))
(assert (fp.leq (fp #b1 #b1000001 #b1000)
                expect
                (fp #b0 #b0010100 #b0110)))
; expect = -6.0

(assert (= expect result))

(check-sat)
(exit)
