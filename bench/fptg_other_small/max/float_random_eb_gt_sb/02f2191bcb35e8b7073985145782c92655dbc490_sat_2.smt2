(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10100101 #b011)
                arg1
                (fp #b0 #b10100000 #b000)))
(assert (fp.leq (fp #b0 #b10100000 #b000)
                arg1
                (fp #b0 #b10101000 #b101)))
; arg1 = 8589934592.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01110101 #b111)
                arg2
                (fp #b0 #b00000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000 #b000)
                arg2
                (fp #b0 #b10100110 #b100)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10010101 #b010)
                expect
                (fp #b0 #b10100000 #b000)))
(assert (fp.leq (fp #b0 #b10100000 #b000)
                expect
                (fp #b0 #b11011010 #b110)))
; expect = 8589934592.0

(assert (= expect result))

(check-sat)
(exit)
