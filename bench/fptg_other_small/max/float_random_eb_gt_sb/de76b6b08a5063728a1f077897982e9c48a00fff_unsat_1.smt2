(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110011 #b1100)
                arg1
                (fp #b1 #b1000001 #b1000)))
(assert (fp.leq (fp #b1 #b1000001 #b1000)
                arg1
                (fp #b0 #b0010011 #b0111)))
; arg1 = -6.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100011 #b0010)
                expect
                (fp #b1 #b1000001 #b1000)))
(assert (fp.leq (fp #b1 #b1000001 #b1000)
                expect
                (fp #b1 #b0000100 #b0001)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
