(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100111 #b011)
                arg1
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg1
                (fp #b0 #b000001 #b101)))
; arg1 = -9.0

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100111 #b001)
                expect
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                expect
                (fp #b1 #b010100 #b101)))
; expect = -9.0

(assert (not (= expect result)))

(check-sat)
(exit)
