(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b1000010010)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b10001 #b0001011111)))
; arg1 = 0.0078125

(declare-const arg2 Float16)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b1101001011)
                expect
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                expect
                (fp #b0 #b11001 #b1010011101)))
; expect = 0.0078125

(assert (not (= expect result)))

(check-sat)
(exit)
