; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0001000101)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b0 #b11100 #b1101011001)))
; arg1 = -0.0024929046630859375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1010110000)
                arg2
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg2
                (fp #b0 #b11110 #b0011101101)))
; arg2 = 16384.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01000 #b0101110100)
                expect
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                expect
                (fp #b0 #b11110 #b0111100110)))
; expect = 16384.0

(assert (= expect result))

(check-sat)
(exit)
