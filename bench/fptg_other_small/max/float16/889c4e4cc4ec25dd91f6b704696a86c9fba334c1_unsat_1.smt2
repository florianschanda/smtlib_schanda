(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010011111)
                arg1
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg1
                (fp #b0 #b01011 #b0010100100)))
; arg1 = -0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1001111011)
                arg2
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg2
                (fp #b0 #b00111 #b0000001001)))
; arg2 = -0.000000059604644775390625

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b0001001101)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01111 #b0011010001)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
