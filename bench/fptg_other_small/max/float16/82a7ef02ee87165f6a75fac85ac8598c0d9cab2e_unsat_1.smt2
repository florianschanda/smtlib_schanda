(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -INFINITY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b1010101010)
                arg2
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                arg2
                (fp #b0 #b11101 #b0111100111)))
; arg2 = 439.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01011 #b1010011000)
                expect
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                expect
                (fp #b0 #b11010 #b1100010110)))
; expect = 439.0

(assert (not (= expect result)))

(check-sat)
(exit)
