(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0010010111)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11110 #b0101001101)))
; arg1 = 1.59765625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1001101000)
                arg2
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg2
                (fp #b0 #b00101 #b1111110011)))
; arg2 = -0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101100110)
                expect
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                expect
                (fp #b0 #b10011 #b1101110110)))
; expect = 1.59765625

(assert (= expect result))

(check-sat)
(exit)
