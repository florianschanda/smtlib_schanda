; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b1111100010)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b1 #b00000 #b1101001101)))
; arg1 = -0.000055372714996337890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg2
                (fp #b1 #b11110 #b1111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111001110)
                arg2
                (fp #b0 #b10101 #b1000110101)))
; arg2 = -63936.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1101101001)
                expect
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                expect
                (fp #b0 #b10110 #b1100110110)))
; expect = -0.000055372714996337890625

(assert (= expect result))

(check-sat)
(exit)
