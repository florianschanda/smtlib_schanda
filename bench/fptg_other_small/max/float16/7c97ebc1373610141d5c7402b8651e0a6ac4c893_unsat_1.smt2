(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1011010011)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0110000100)))
; arg1 = 16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0100001111)
                arg2
                (fp #b1 #b11100 #b0111010101)))
(assert (fp.leq (fp #b1 #b11100 #b0111010101)
                arg2
                (fp #b1 #b10000 #b1101000010)))
; arg2 = -11944.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10101 #b0011011111)
                expect
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                expect
                (fp #b0 #b11110 #b1000011101)))
; expect = 16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
