                arg2
                (fp #b0 #b00000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                arg2
                (fp #b0 #b00110 #b0110111010)))
; arg2 = 0.000006973743438720703125

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0110001111)
                expect
                (fp #b0 #b00000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                expect
                (fp #b0 #b00101 #b1100101001)))
; expect = 0.000006973743438720703125

(assert (not (= expect result)))

(check-sat)
(exit)
