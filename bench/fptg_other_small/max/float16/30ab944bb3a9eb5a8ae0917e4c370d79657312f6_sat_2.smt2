(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010101000)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b1 #b10011 #b0111110111)))
; arg1 = -933.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011111011)
                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b11001 #b1100111101)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b1101110100)
                expect
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                expect
                (fp #b0 #b01010 #b1101010000)))
; expect = 0.000055730342864990234375

(assert (= expect result))

(check-sat)
(exit)
