(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +ONE
; Arg2: -ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0000010001)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b10011 #b1001110001)))
; arg1 = 1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1001011001)
                arg2
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg2
                (fp #b1 #b01101 #b1000011111)))
; arg2 = -1.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0101011110)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b10100 #b1001000001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
