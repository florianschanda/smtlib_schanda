(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1010111001)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b0 #b11001 #b0011100111)))
; arg1 = -933.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1110000111)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11100 #b0011011011)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b0111011010)
                expect
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                expect
                (fp #b0 #b11010 #b1110111101)))
; expect = 2050.0

(assert (= expect result))

(check-sat)
(exit)
