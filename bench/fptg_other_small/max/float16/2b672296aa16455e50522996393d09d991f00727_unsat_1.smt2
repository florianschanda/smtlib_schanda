                arg2
                (fp #b1 #b01101 #b1011111000)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0101101110)
                expect
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                expect
                (fp #b0 #b01001 #b0111010011)))
; expect = -0.000055372714996337890625

(assert (not (= expect result)))

(check-sat)
