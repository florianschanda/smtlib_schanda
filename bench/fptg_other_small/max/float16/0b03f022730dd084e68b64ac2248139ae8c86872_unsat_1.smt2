(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b1001110010)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b10010 #b0010100100)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1010010100)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11011 #b0100001100)))
; arg2 = 1336.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1001110111)
                expect
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                expect
                (fp #b0 #b11110 #b0110011001)))
; expect = 1336.0

(assert (not (= expect result)))

(check-sat)
(exit)
