(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1111010110)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b11011 #b0100101111)))
; arg1 = -0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1001000101)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b11001 #b1110100011)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b0110001111)
                expect
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                expect
                (fp #b0 #b10111 #b1000110000)))
; expect = 12.375

(assert (= expect result))

(check-sat)
(exit)
