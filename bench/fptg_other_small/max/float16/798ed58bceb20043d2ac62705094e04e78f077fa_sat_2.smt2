(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00101 #b0011111010)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b10010 #b1101001101)))
; arg1 = -0.000039398670196533203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1000110111)
                arg2
                (fp #b1 #b10111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10111 #b0011100100)
                arg2
                (fp #b0 #b10110 #b0110110101)))
; arg2 = -313.0

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1111111001)
                expect
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                expect
                (fp #b0 #b10101 #b0010011101)))
; expect = -0.000039398670196533203125

(assert (= expect result))

(check-sat)
(exit)
