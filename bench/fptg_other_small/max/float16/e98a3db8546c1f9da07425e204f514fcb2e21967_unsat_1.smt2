; Format: FLOAT16
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1100001100)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b00011 #b0000100111)))
; arg2 = -0.0000331401824951171875

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0100011000)
                expect
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                expect
                (fp #b0 #b01100 #b0101101001)))
; expect = -0.0000331401824951171875

(assert (not (= expect result)))

(check-sat)
(exit)
