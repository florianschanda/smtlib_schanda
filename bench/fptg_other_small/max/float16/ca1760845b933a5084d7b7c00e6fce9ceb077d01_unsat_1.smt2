(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00100 #b1111100001)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0100011110)))
; arg1 = 2048.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0100000001)
                arg2
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg2
                (fp #b0 #b01101 #b1111111010)))
; arg2 = 0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000101101)
                expect
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                expect
                (fp #b0 #b11010 #b1111110011)))
; expect = 2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
