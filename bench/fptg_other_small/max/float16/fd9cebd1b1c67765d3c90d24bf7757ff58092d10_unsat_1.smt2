(assert (fp.leq (fp #b1 #b10111 #b1101101111)
                expect
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                expect
                (fp #b0 #b10100 #b1111011101)))
; expect = 14.8359375

(assert (not (= expect result)))

