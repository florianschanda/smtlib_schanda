(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1001101100)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b10110 #b1011101010)))
; arg1 = 0.054473876953125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0110111101)
                arg2
                (fp #b1 #b00001 #b1010100010)))
(assert (fp.leq (fp #b1 #b00001 #b1010100010)
                arg2
                (fp #b0 #b11001 #b1010000010)))
; arg2 = -0.00010120868682861328125

(declare-const result Float16)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00011 #b0011110010)
                expect
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                expect
                (fp #b0 #b11011 #b0000100100)))
; expect = 0.054473876953125

(assert (= expect result))

(check-sat)
(exit)
