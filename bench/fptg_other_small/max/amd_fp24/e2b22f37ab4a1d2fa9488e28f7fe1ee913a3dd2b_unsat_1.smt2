(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0100001 #b1011100101011000)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1000110 #b0100010110000110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111100 #b1110001011100010)
                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1101001 #b1000011101010110)))
; arg2 = 2.71990966796875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101101 #b1010101110111001)
                expect
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                expect
                (fp #b0 #b1111100 #b1011110011001110)))
; expect = 2.71990966796875

(assert (not (= expect result)))

(check-sat)
(exit)
