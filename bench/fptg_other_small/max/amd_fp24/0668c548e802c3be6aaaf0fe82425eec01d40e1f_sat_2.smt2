(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0110001 #b1010111100100011)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b0111110 #b1010000011011110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000011 #b1001101011100001)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1101011 #b1010011010101100)))
; arg2 = 23275.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110110 #b1111010110011000)
                expect
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                expect
                (fp #b0 #b1100100 #b1111011000111001)))
; expect = 23275.0

(assert (= expect result))

(check-sat)
(exit)
