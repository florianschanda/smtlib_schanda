(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011100 #b0001110010101011)
                arg1
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                arg1
                (fp #b0 #b1110101 #b0110100101110110)))
; arg1 = 4983772676096.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
