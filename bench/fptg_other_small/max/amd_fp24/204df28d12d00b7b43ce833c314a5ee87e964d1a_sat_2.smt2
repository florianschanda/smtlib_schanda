(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0011111 #b1101001110011000)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1001111 #b1001010010100000)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1000001001010100)
                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b1 #b0010010 #b0001110110001001)))
; arg2 = -1053933568.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101010 #b0100001001110100)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1101000 #b0011010100110111)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
