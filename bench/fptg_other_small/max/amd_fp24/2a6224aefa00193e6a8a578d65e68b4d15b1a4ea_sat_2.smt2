(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1100111100100110)
                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b1 #b0110110 #b0001101010110011)))
; arg2 = -717963500751683584.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1001000101100101)
                expect
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                expect
                (fp #b1 #b1101111 #b0101100011001010)))
; expect = -717963500751683584.0

(assert (= expect result))

(check-sat)
(exit)
