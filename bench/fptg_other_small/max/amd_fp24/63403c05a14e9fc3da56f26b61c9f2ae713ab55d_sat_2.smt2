(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000110 #b1000100100111110)
                expect
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                expect
                (fp #b0 #b1011101 #b1001010011000010)))
; expect = 131072.0

(assert (= expect result))

(check-sat)
(exit)
