                expect
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                expect
                (fp #b0 #b1010000 #b1100100000011110)))
; expect = 76528.0

(assert (not (= expect result)))

