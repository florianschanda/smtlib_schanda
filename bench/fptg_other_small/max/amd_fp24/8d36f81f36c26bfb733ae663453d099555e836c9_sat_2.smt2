(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b1000001101100010)
                arg2
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                arg2
                (fp #b1 #b0001100 #b0100010010010100)))
; arg2 = -0.0003445781767368316650390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000010 #b0011101110011101)
                expect
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                expect
                (fp #b0 #b1100000 #b1011110111110101)))
; expect = -0.0003445781767368316650390625

(assert (= expect result))

(check-sat)
(exit)
