(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000111 #b1110110001001000)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1011010 #b1011110001010011)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b1101111111010001)
                expect
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b0100101 #b1100100110000011)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
