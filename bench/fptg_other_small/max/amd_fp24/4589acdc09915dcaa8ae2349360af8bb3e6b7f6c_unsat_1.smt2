(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -NAN
; Arg2: +ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0001000 #b1000010000111000)
                arg2
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b0101111 #b1011000001010110)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0001010 #b1110111010010011)
                expect
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1001111 #b0001100011010000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
