(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111110 #b1101011101111100)
                expect
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                expect
                (fp #b0 #b1011110 #b0101001000101011)))
; expect = 9884160.0

(assert (not (= expect result)))

(check-sat)
(exit)
