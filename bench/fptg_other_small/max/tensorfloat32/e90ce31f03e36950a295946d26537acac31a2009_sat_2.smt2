; Format: TENSORFLOAT32
; Arg1: +ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100001 #b0100110111)
                arg1
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b10110110 #b0100101010)))
