                expect
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                expect
                (fp #b1 #b10000111 #b0010000001)))
; expect = -2048.0

(assert (not (= expect result)))

(check-sat)
