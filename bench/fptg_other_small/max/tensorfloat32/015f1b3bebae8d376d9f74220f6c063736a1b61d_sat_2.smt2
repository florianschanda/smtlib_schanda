; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01101011 #b0100010101)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b01000101 #b1101001111)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010111 #b1000001101)
                arg2
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b11011010 #b0101111110)))
; arg2 = -0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100101 #b1010100011)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b10011000 #b0011011110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
