(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101011 #b1011110001)
                arg2
                (fp #b1 #b11001010 #b0100100000)))
