(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101100 #b0010001110)
                arg2
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b1 #b01000111 #b0011110000)))
; arg2 = -313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b1101101011)
                expect
                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                expect
                (fp #b0 #b11001110 #b1100111111)))
; expect = -313.0

(assert (not (= expect result)))

(check-sat)
(exit)
