(assert (fp.leq (fp #b1 #b00010000 #b0101000110)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b11010111 #b0001001010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
