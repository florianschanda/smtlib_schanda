(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001101 #b001011101001110)
                expect
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                expect
                (fp #b0 #b10100011 #b101000111110111)))
; expect = 8115.0

(assert (not (= expect result)))

(check-sat)
(exit)
