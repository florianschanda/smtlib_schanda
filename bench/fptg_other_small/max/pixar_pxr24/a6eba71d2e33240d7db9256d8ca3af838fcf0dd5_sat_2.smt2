; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00110100 #b000110010000100)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b10001111 #b100011110110101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011101 #b010110100100111)
                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b1 #b00000111 #b010100001101000)))
; arg2 = -0.00000000000000000000059894338697374774189399922186272107182958279736340045928955078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10111001 #b111101101100100)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10001111 #b011011010000000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
