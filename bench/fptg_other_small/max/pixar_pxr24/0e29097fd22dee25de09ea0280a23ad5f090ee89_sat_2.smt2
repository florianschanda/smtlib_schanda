(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100100 #b011110011111101)
                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b11101111 #b110001101001100)))
; arg2 = 1.040771484375

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100101 #b000101110110110)
                expect
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                expect
                (fp #b0 #b11011110 #b010110001110000)))
; expect = 1.040771484375

(assert (= expect result))

(check-sat)
(exit)
