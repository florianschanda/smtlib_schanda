; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100101 #b001000101100010)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b01101110 #b000100110011011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000011 #b001101101111000)
                arg2
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b10110101 #b110011010110101)))
; arg2 = 0.000000000000000000000000000000000000002989317146423987366913904286094047007221356226984193517069222402471329047557446756400167942047119140625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011010 #b100111001010010)
                expect
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                expect
                (fp #b0 #b01011000 #b011011100110010)))
; expect = 0.000000000000000000000000000000000000002989317146423987366913904286094047007221356226984193517069222402471329047557446756400167942047119140625

(assert (= expect result))

(check-sat)
(exit)
