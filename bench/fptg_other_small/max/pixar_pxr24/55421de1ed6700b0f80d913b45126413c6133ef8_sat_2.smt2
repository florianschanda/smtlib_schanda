(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00100011 #b100000110100110)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b11111000 #b001000010010011)))
; arg2 = -0.000000000000000000000000000000000000010253648385483839062582518445868972231778234133672051277857864386156006020200948114506900310516357421875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
