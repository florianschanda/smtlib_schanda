; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01100001 #b111110111100111)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11111101 #b111111000111010)))
; arg1 = 65536.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b101000001101111)
                expect
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b10010011 #b110000100011000)))
; expect = 65536.0

(assert (not (= expect result)))

(check-sat)
(exit)
