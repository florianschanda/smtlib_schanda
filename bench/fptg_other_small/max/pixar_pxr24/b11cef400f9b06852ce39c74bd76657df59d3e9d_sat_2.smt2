(assert (fp.leq (fp #b1 #b10100100 #b100011111011000)
                expect
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b11100011 #b011111001000010)))
; expect = -65536.0

(assert (= expect result))

