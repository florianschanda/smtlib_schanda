; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 5 12))
(assert (fp.leq (fp #b1 #b11101 #b01111000001)
                arg2
                (fp #b1 #b11101 #b00101010010)))
(assert (fp.leq (fp #b1 #b11101 #b00101010010)
                arg2
                (fp #b0 #b11000 #b00110010011)))
; arg2 = -19088.0

(declare-const result (_ FloatingPoint 5 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 12))
(assert (fp.leq (fp #b1 #b11101 #b10101110011)
                expect
                (fp #b1 #b11101 #b00101010010)))
(assert (fp.leq (fp #b1 #b11101 #b00101010010)
                expect
                (fp #b0 #b00110 #b11101111111)))
; expect = -19088.0

(assert (= expect result))

(check-sat)
(exit)
