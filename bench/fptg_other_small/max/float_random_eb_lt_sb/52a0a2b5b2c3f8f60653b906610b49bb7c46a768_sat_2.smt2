(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110 #b0010000111)
                arg1
                (fp #b1 #b000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000 #b0000000000)
                arg1
                (fp #b0 #b100 #b0001110110)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 3 11))
(assert (fp.leq (fp #b1 #b110 #b1111101010)
                arg2
                (fp #b1 #b110 #b1110000000)))
(assert (fp.leq (fp #b1 #b110 #b1110000000)
                arg2
                (fp #b1 #b001 #b1010000011)))
; arg2 = -15.0

(declare-const result (_ FloatingPoint 3 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011 #b0101000001)
                expect
                (fp #b1 #b000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000 #b0000000000)
                expect
                (fp #b0 #b000 #b0000101001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
