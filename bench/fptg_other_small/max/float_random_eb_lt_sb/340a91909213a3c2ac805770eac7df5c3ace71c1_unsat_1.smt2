                expect
                (fp #b0 #b00 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b00 #b0100000000000000)
                expect
                (fp #b0 #b01 #b1000110011001110)))
; expect = 0.25

(assert (not (= expect result)))

(check-sat)
