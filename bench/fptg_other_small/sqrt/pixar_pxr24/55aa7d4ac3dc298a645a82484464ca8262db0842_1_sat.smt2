; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010010 #b110110011011100)
                arg1
                (fp #b1 #b10001110 #b101011111100110)))
(assert (fp.leq (fp #b1 #b10001110 #b101011111100110)
                arg1
                (fp #b1 #b01101100 #b100000110011110)))
; arg1 = -55270.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
