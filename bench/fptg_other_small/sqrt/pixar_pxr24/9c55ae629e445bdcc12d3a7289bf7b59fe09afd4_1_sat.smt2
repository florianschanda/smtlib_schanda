(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100110 #b011111101001010)
                expect
                (fp #b0 #b10000110 #b011110110101010)))
(assert (fp.leq (fp #b0 #b10000110 #b011110110101010)
                expect
                (fp #b0 #b11111100 #b000010110000010)))
; expect = 189.6640625

(assert (= expect result))

(check-sat)
(exit)
