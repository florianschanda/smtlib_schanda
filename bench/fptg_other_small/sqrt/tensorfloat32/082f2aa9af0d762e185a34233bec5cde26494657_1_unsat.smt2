; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1111010100)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01100000 #b0001100000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
