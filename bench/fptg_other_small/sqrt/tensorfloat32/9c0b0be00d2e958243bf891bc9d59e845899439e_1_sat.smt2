(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0000010011)
                arg1
                (fp #b0 #b10000101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10000101 #b1011010000)
                arg1
                (fp #b0 #b11000011 #b0110001000)))
; arg1 = 109.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011101 #b0110000100)
                expect
                (fp #b0 #b10000010 #b0100111000)))
(assert (fp.leq (fp #b0 #b10000010 #b0100111000)
                expect
                (fp #b0 #b10100001 #b1010001001)))
; expect = 10.4375

(assert (= expect result))

(check-sat)
(exit)
