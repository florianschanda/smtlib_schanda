(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010001 #b1010000010)
                expect
                (fp #b0 #b10000100 #b0100011100)))
(assert (fp.leq (fp #b0 #b10000100 #b0100011100)
                expect
                (fp #b0 #b10101010 #b0111111000)))
; expect = 40.875

(assert (= expect result))

(check-sat)
