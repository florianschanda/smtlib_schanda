(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000111 #b1010101001)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b10111010 #b1010011010)))
; arg1 = 2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110100 #b0011101101)
                expect
                (fp #b0 #b10000100 #b0110101001)))
(assert (fp.leq (fp #b0 #b10000100 #b0110101001)
                expect
                (fp #b0 #b11000010 #b0010101011)))
; expect = 45.28125

(assert (= expect result))

(check-sat)
(exit)
