; Format: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
