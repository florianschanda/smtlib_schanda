;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010100 #b1011001111)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b10011001 #b1010010001)))
; arg1 = 1872.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000101 #b1100010110)
                expect
                (fp #b0 #b10000100 #b0101101000)))
(assert (fp.leq (fp #b0 #b10000100 #b0101101000)
                expect
                (fp #b0 #b11100011 #b0111001101)))
; expect = 43.25

(assert (= expect result))

(check-sat)
(exit)
