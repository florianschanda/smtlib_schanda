(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 15))
(assert (fp.leq (fp #b1 #b1101 #b00110001100100)
                arg1
                (fp #b1 #b0000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b0000 #b00111010110000)
                arg1
