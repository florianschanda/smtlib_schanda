; arg1 = -0.0035858154296875

(declare-const result (_ FloatingPoint 4 15))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 15))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
