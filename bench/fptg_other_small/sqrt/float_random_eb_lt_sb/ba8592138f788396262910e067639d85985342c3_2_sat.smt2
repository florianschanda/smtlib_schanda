(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 17))
(assert (fp.leq (fp #b1 #b1001 #b1111011010001100)
                expect
                (fp #b0 #b1010 #b1111111100000000)))
(assert (fp.leq (fp #b0 #b1010 #b1111111100000000)
                expect
                (fp #b0 #b1011 #b1010110010101100)))
; expect = 15.96875

(assert (= expect result))

(check-sat)
(exit)
