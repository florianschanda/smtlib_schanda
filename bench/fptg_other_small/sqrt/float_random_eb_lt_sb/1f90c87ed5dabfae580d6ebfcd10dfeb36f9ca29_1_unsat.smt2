;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b1 #b0001 #b000000110)
                arg1
                (fp #b0 #b0101 #b011000110)))
(assert (fp.leq (fp #b0 #b0101 #b011000110)
                arg1
                (fp #b0 #b1100 #b011001010)))
; arg1 = 0.3466796875

(declare-const result (_ FloatingPoint 4 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b0 #b0110 #b001010000)
                expect
                (fp #b0 #b0110 #b001011010)))
(assert (fp.leq (fp #b0 #b0110 #b001011010)
                expect
                (fp #b0 #b1000 #b111110011)))
; expect = 0.587890625

(assert (not (= expect result)))

(check-sat)
(exit)
