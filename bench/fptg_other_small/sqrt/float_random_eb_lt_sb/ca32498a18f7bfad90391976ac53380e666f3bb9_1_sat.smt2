; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b010 #b11100110010)
                arg1
                (fp #b0 #b110 #b01010011000)))
(assert (fp.leq (fp #b0 #b110 #b01010011000)
                arg1
                (fp #b0 #b110 #b01100010110)))
; arg1 = 10.59375

(declare-const result (_ FloatingPoint 3 12))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b0 #b011 #b10110100011)
                expect
                (fp #b0 #b100 #b10100000100)))
(assert (fp.leq (fp #b0 #b100 #b10100000100)
                expect
                (fp #b0 #b110 #b00101111111)))
; expect = 3.25390625

(assert (= expect result))

(check-sat)
(exit)
