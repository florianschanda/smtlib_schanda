(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000001 #b1001101)
                arg1
                (fp #b0 #b10000110 #b0101000)))
(assert (fp.leq (fp #b0 #b10000110 #b0101000)
                arg1
                (fp #b0 #b11010010 #b0101001)))
; arg1 = 168.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111011 #b0111010)
                expect
                (fp #b0 #b10000010 #b1010000)))
(assert (fp.leq (fp #b0 #b10000010 #b1010000)
                expect
                (fp #b0 #b10111010 #b0101001)))
; expect = 13.0

(assert (= expect result))

(check-sat)
(exit)
