; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0011011)
                arg1
                (fp #b1 #b01111111 #b0000010)))
(assert (fp.leq (fp #b1 #b01111111 #b0000010)
                arg1
                (fp #b1 #b00000100 #b1000000)))
; arg1 = -1.015625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
