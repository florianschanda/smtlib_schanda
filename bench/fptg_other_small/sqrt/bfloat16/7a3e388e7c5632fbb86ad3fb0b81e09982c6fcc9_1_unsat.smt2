; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010101 #b0110111)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b11011011 #b1101001)))
; arg1 = 30.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011100 #b0000000)
                expect
                (fp #b0 #b10000001 #b0101111)))
(assert (fp.leq (fp #b0 #b10000001 #b0101111)
                expect
                (fp #b0 #b10000100 #b1110011)))
; expect = 5.46875

(assert (not (= expect result)))

(check-sat)
(exit)
