;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b1001110)
                arg1
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg1
                (fp #b0 #b00001001 #b1001111)))
; arg1 = -18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
