; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111010 #b1001010)
                arg1
                (fp #b0 #b01111111 #b0111100)))
(assert (fp.leq (fp #b0 #b01111111 #b0111100)
                arg1
                (fp #b0 #b11001000 #b1110101)))
; arg1 = 1.46875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001000 #b0001011)
                expect
                (fp #b0 #b01111111 #b0011011)))
(assert (fp.leq (fp #b0 #b01111111 #b0011011)
                expect
                (fp #b0 #b10100111 #b1011001)))
; expect = 1.2109375

(assert (= expect result))

(check-sat)
(exit)
