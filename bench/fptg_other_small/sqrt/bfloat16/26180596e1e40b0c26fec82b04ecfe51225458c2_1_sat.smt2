(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b1110000)
                arg1
                (fp #b0 #b10000110 #b1001000)))
(assert (fp.leq (fp #b0 #b10000110 #b1001000)
                arg1
                (fp #b0 #b11101001 #b0100000)))
; arg1 = 200.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101101 #b1111111)
                expect
                (fp #b0 #b10000010 #b1100010)))
(assert (fp.leq (fp #b0 #b10000010 #b1100010)
                expect
                (fp #b0 #b11011010 #b0100001)))
; expect = 14.125

(assert (= expect result))

(check-sat)
(exit)
