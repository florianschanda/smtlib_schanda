                expect
                (fp #b0 #b1000110 #b0100001011111001)))
(assert (fp.leq (fp #b0 #b1000110 #b0100001011111001)
                expect
                (fp #b0 #b1001001 #b1111001100010001)))
; expect = 161.486328125

(assert (= expect result))

(check-sat)
