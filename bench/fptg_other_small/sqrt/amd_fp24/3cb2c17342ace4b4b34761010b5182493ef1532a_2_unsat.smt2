                expect
                (fp #b0 #b0111111 #b0001000001010000)))
(assert (fp.leq (fp #b0 #b0111111 #b0001000001010000)
                expect
                (fp #b0 #b1000001 #b0011110100101000)))
; expect = 1.063720703125

(assert (not (= expect result)))

