; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1111110101100100)
                arg1
                (fp #b1 #b1001111 #b1011111011110010)))
(assert (fp.leq (fp #b1 #b1001111 #b1011111011110010)
                arg1
                (fp #b1 #b0110101 #b0010000110000101)))
; arg1 = -114418.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
