(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1110001101011000)
                arg1
                (fp #b0 #b1000110 #b1011110001110100)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110001110100)
                arg1
                (fp #b0 #b1110101 #b1001001101100100)))
; arg1 = 222.2265625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001100 #b0111100000110000)
                expect
                (fp #b0 #b1000010 #b1101110100001001)))
(assert (fp.leq (fp #b0 #b1000010 #b1101110100001001)
                expect
                (fp #b0 #b1011000 #b1011101000110000)))
; expect = 14.9073486328125

(assert (= expect result))

(check-sat)
(exit)
