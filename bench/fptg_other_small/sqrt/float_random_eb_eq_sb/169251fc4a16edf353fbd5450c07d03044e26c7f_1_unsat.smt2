(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b11001)
                arg1
                (fp #b0 #b100010 #b11000)))
(assert (fp.leq (fp #b0 #b100010 #b11000)
                arg1
                (fp #b0 #b110000 #b00111)))
; arg1 = 14.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011101 #b11000)
                expect
                (fp #b0 #b100000 #b11011)))
(assert (fp.leq (fp #b0 #b100000 #b11011)
                expect
                (fp #b0 #b100011 #b00011)))
; expect = 3.6875

(assert (not (= expect result)))

(check-sat)
(exit)
