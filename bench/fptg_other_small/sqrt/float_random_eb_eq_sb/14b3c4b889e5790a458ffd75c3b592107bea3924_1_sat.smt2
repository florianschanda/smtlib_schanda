; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001010 #b00101)
                arg1
                (fp #b0 #b010011 #b10010)))
(assert (fp.leq (fp #b0 #b010011 #b10010)
                arg1
                (fp #b0 #b011111 #b01111)))
; arg1 = 0.0003814697265625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010001 #b00111)
                expect
                (fp #b0 #b011001 #b01000)))
(assert (fp.leq (fp #b0 #b011001 #b01000)
                expect
                (fp #b0 #b011110 #b10101)))
; expect = 0.01953125

(assert (= expect result))

(check-sat)
(exit)
