; arg1 = 12582912.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010011 #b10100)
                expect
                (fp #b0 #b101010 #b10111)))
(assert (fp.leq (fp #b0 #b101010 #b10111)
                expect
                (fp #b0 #b111001 #b10101)))
; expect = 3520.0

(assert (not (= expect result)))

(check-sat)
(exit)
