(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000000 #b00111)
                arg1
                (fp #b0 #b110110 #b10000)))
(assert (fp.leq (fp #b0 #b110110 #b10000)
                arg1
