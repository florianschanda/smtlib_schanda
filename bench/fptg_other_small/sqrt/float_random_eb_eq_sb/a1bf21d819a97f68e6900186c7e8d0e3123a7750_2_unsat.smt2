; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b0 #b001 #b10)))
(assert (fp.leq (fp #b0 #b001 #b10)
                arg1
                (fp #b0 #b100 #b00)))
; arg1 = 0.375

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                expect
                (fp #b0 #b010 #b01)))
(assert (fp.leq (fp #b0 #b010 #b01)
                expect
                (fp #b0 #b100 #b01)))
; expect = 0.625

(assert (not (= expect result)))

(check-sat)
(exit)
