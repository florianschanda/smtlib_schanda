(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b11)
                arg1
                (fp #b0 #b110 #b10)))
(assert (fp.leq (fp #b0 #b110 #b10)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 12.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b000 #b10)
                expect
                (fp #b0 #b100 #b10)))
(assert (fp.leq (fp #b0 #b100 #b10)
                expect
                (fp #b0 #b111 #b00)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
