(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg1
                (fp #b0 #b1000 #b101)))
(assert (fp.leq (fp #b0 #b1000 #b101)
                arg1
                (fp #b0 #b1110 #b000)))
; arg1 = 3.25

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b001)
                expect
                (fp #b0 #b0111 #b110)))
(assert (fp.leq (fp #b0 #b0111 #b110)
                expect
                (fp #b0 #b1000 #b100)))
; expect = 1.75

(assert (not (= expect result)))

(check-sat)
(exit)
