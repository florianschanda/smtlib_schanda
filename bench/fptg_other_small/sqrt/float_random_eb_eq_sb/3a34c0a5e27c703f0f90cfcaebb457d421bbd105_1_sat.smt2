; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b1101)
                arg1
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                arg1
                (fp #b0 #b11011 #b1101)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01010 #b0011)
                expect
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                expect
                (fp #b0 #b10111 #b0001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
