; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b1011)
                arg1
                (fp #b0 #b01000 #b0000)))
(assert (fp.leq (fp #b0 #b01000 #b0000)
                arg1
                (fp #b0 #b10011 #b1001)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b0001)
                expect
                (fp #b0 #b01011 #b0111)))
(assert (fp.leq (fp #b0 #b01011 #b0111)
                expect
                (fp #b0 #b10111 #b1000)))
; expect = 0.08984375

(assert (= expect result))

(check-sat)
(exit)
