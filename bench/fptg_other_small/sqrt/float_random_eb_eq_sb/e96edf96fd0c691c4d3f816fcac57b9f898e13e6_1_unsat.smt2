(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b011)
                arg1
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg1
                (fp #b0 #b1101 #b000)))
; arg1 = 56.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b110)
                expect
                (fp #b0 #b1001 #b110)))
(assert (fp.leq (fp #b0 #b1001 #b110)
                expect
                (fp #b0 #b1101 #b101)))
; expect = 7.0

(assert (not (= expect result)))

(check-sat)
(exit)
