                expect
                (fp #b0 #b101011 #b00111)))
(assert (fp.leq (fp #b0 #b101011 #b00111)
                expect
                (fp #b0 #b111011 #b01101)))
; expect = 4992.0

(assert (not (= expect result)))

(check-sat)
