(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b010 #b10)
                expect
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                expect
                (fp #b0 #b011 #b10)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
