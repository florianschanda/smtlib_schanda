(assert (fp.leq (fp #b1 #b001011 #b01011)
                expect
                (fp #b0 #b010111 #b01101)))
(assert (fp.leq (fp #b0 #b010111 #b01101)
                expect
                (fp #b0 #b100110 #b11101)))
; expect = 0.0054931640625

(assert (not (= expect result)))

(check-sat)
(exit)
