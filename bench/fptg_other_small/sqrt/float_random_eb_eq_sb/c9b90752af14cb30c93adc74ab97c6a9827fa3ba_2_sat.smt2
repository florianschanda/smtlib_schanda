(assert (fp.leq (fp #b1 #b10011 #b0011)
                expect
                (fp #b0 #b00111 #b1111)))
(assert (fp.leq (fp #b0 #b00111 #b1111)
                expect
                (fp #b0 #b10001 #b0001)))
; expect = 0.007568359375

(assert (= expect result))

(check-sat)
