; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0011)
                arg1
                (fp #b0 #b01111 #b0111)))
(assert (fp.leq (fp #b0 #b01111 #b0111)
                arg1
                (fp #b0 #b11100 #b1110)))
; arg1 = 1.4375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b0010)
                expect
                (fp #b0 #b01111 #b0011)))
(assert (fp.leq (fp #b0 #b01111 #b0011)
                expect
                (fp #b0 #b10001 #b1110)))
; expect = 1.1875

(assert (not (= expect result)))

(check-sat)
(exit)
