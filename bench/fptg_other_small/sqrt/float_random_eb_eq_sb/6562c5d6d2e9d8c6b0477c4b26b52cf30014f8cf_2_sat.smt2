(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1010)
                arg1
                (fp #b0 #b10011 #b0110)))
(assert (fp.leq (fp #b0 #b10011 #b0110)
                arg1
                (fp #b0 #b11010 #b1010)))
; arg1 = 22.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01011 #b0100)
                expect
                (fp #b0 #b10001 #b0011)))
(assert (fp.leq (fp #b0 #b10001 #b0011)
                expect
                (fp #b0 #b10001 #b1011)))
; expect = 4.75

(assert (= expect result))

(check-sat)
(exit)
