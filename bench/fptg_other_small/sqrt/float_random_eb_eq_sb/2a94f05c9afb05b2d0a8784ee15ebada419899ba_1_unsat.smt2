; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010111 #b10101)
                arg1
                (fp #b0 #b011111 #b10100)))
(assert (fp.leq (fp #b0 #b011111 #b10100)
                arg1
                (fp #b0 #b110110 #b00111)))
; arg1 = 1.625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b10011)
                expect
                (fp #b0 #b011111 #b01000)))
(assert (fp.leq (fp #b0 #b011111 #b01000)
                expect
                (fp #b0 #b110101 #b10000)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
