(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b00000)
                arg1
                (fp #b1 #b101010 #b10100)))
(assert (fp.leq (fp #b1 #b101010 #b10100)
                arg1
                (fp #b0 #b100111 #b00101)))
; arg1 = -3328.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
