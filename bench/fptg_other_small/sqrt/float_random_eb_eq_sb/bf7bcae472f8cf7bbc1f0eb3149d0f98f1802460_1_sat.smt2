(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0101)
                arg1
                (fp #b0 #b10111 #b0000)))
(assert (fp.leq (fp #b0 #b10111 #b0000)
                arg1
                (fp #b0 #b11101 #b1110)))
; arg1 = 256.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b1101)
                expect
                (fp #b0 #b10011 #b0000)))
(assert (fp.leq (fp #b0 #b10011 #b0000)
                expect
                (fp #b0 #b11110 #b0100)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
