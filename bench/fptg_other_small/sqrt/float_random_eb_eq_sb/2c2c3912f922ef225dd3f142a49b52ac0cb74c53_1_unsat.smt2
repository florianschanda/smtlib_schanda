(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00101)
                arg1
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                arg1
                (fp #b0 #b100110 #b00111)))
; arg1 = 0.375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011000 #b10100)
                expect
                (fp #b0 #b011110 #b00111)))
(assert (fp.leq (fp #b0 #b011110 #b00111)
                expect
                (fp #b0 #b100010 #b00001)))
; expect = 0.609375

(assert (not (= expect result)))

(check-sat)
(exit)
