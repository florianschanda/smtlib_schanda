(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1010)
                arg1
                (fp #b0 #b10011 #b0110)))
(assert (fp.leq (fp #b0 #b10011 #b0110)
                arg1
                (fp #b0 #b11010 #b1010)))
; arg1 = 22.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00110 #b0011)
                expect
                (fp #b0 #b10001 #b0010)))
(assert (fp.leq (fp #b0 #b10001 #b0010)
                expect
                (fp #b0 #b11010 #b0000)))
; expect = 4.5

(assert (not (= expect result)))

(check-sat)
(exit)
