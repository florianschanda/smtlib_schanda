(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1010)
                arg1
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                arg1
                (fp #b0 #b110 #b0000)))
; arg1 = -0.0625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
