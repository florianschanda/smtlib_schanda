(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b011 #b0100)))
(assert (fp.leq (fp #b0 #b011 #b0100)
                arg1
                (fp #b0 #b100 #b0111)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b0000)
                expect
                (fp #b0 #b011 #b0001)))
(assert (fp.leq (fp #b0 #b011 #b0001)
                expect
                (fp #b0 #b110 #b1011)))
; expect = 1.0625

(assert (= expect result))

(check-sat)
(exit)
