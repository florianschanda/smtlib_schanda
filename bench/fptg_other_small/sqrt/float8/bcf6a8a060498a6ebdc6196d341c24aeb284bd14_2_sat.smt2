(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1000)
                arg1
                (fp #b0 #b001 #b0111)))
(assert (fp.leq (fp #b0 #b001 #b0111)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.359375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b001 #b1010)
                expect
                (fp #b0 #b010 #b0100)))
(assert (fp.leq (fp #b0 #b010 #b0100)
                expect
                (fp #b0 #b010 #b1111)))
; expect = 0.625

(assert (= expect result))

(check-sat)
(exit)
