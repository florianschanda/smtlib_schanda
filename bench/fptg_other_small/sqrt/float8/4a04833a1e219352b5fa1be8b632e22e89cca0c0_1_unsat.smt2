; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg1
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 0.8125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                expect
                (fp #b0 #b010 #b1100)))
(assert (fp.leq (fp #b0 #b010 #b1100)
                expect
                (fp #b0 #b100 #b1011)))
; expect = 0.875

(assert (not (= expect result)))

(check-sat)
(exit)
