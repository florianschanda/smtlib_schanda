; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b0 #b100 #b0010)))
(assert (fp.leq (fp #b0 #b100 #b0010)
                arg1
                (fp #b0 #b101 #b0001)))
; arg1 = 2.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0010)
                expect
                (fp #b0 #b011 #b1000)))
(assert (fp.leq (fp #b0 #b011 #b1000)
                expect
                (fp #b0 #b110 #b1110)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
