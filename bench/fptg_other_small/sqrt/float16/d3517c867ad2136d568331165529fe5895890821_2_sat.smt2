(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1010110010)
                arg1
                (fp #b0 #b00000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000 #b1011110010)
                arg1
                (fp #b0 #b01111 #b0101001010)))
; arg1 = 0.00004494190216064453125

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0111010101)
                expect
                (fp #b0 #b00111 #b1011011110)))
(assert (fp.leq (fp #b0 #b00111 #b1011011110)
                expect
                (fp #b0 #b10111 #b1100111100)))
; expect = 0.00670623779296875

(assert (= expect result))

(check-sat)
(exit)
