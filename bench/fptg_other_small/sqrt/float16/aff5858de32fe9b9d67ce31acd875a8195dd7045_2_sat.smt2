(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0000011110)
                arg1
                (fp #b0 #b11100 #b1001010011)))
(assert (fp.leq (fp #b0 #b11100 #b1001010011)
                arg1
                (fp #b0 #b11100 #b1010000001)))
; arg1 = 12952.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b1010000100)
                expect
                (fp #b0 #b10101 #b1100011101)))
(assert (fp.leq (fp #b0 #b10101 #b1100011101)
                expect
                (fp #b0 #b11110 #b1100111101)))
; expect = 113.8125

(assert (= expect result))

(check-sat)
(exit)
