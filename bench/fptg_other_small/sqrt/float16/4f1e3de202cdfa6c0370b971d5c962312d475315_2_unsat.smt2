                expect
                (fp #b0 #b01111 #b0011100110)))
(assert (fp.leq (fp #b0 #b01111 #b0011100110)
                expect
                (fp #b0 #b10001 #b1010110011)))
; expect = 1.224609375

(assert (not (= expect result)))

