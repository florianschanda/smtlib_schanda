                expect
                (fp #b0 #b10101 #b1100110110)))
(assert (fp.leq (fp #b0 #b10101 #b1100110110)
                expect
                (fp #b0 #b11001 #b0100110110)))
; expect = 115.375

(assert (not (= expect result)))

(check-sat)
