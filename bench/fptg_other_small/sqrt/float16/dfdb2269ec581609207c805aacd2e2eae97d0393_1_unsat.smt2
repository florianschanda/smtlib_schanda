; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110000011)
                arg1
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                arg1
                (fp #b0 #b11110 #b1011101000)))
; arg1 = 1.98828125

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0001001010)
                expect
                (fp #b0 #b01111 #b0110100011)))
(assert (fp.leq (fp #b0 #b01111 #b0110100011)
                expect
                (fp #b0 #b10100 #b0101001101)))
; expect = 1.4091796875

(assert (not (= expect result)))

(check-sat)
(exit)
