(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0111100101)
                arg1
                (fp #b0 #b11101 #b0000001101)))
(assert (fp.leq (fp #b0 #b11101 #b0000001101)
                arg1
                (fp #b0 #b11110 #b1101011010)))
; arg1 = 16592.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01010 #b1010001011)
                expect
                (fp #b0 #b10110 #b0000000110)))
(assert (fp.leq (fp #b0 #b10110 #b0000000110)
                expect
                (fp #b0 #b10111 #b1010010000)))
; expect = 128.75

(assert (= expect result))

(check-sat)
(exit)
