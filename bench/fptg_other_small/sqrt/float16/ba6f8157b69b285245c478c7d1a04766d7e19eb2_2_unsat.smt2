                expect
                (fp #b0 #b10000 #b1110110101)))
(assert (fp.leq (fp #b0 #b10000 #b1110110101)
                expect
                (fp #b0 #b10101 #b0111011001)))
; expect = 3.853515625

(assert (not (= expect result)))

