(assert (fp.leq (fp #b1 #b11001 #b1011111000)
                expect
                (fp #b0 #b00111 #b1011011101)))
(assert (fp.leq (fp #b0 #b00111 #b1011011101)
                expect
                (fp #b0 #b10010 #b1100001001)))
; expect = 0.006702423095703125

(assert (not (= expect result)))

(check-sat)
