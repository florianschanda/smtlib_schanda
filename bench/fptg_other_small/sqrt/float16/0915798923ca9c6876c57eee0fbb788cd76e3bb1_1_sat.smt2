(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0010101111)
                arg1
                (fp #b0 #b11011 #b0101101000)))
(assert (fp.leq (fp #b0 #b11011 #b0101101000)
                arg1
                (fp #b0 #b11011 #b1110111100)))
; arg1 = 5536.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01000 #b0101111011)
                expect
                (fp #b0 #b10101 #b0010100110)))
(assert (fp.leq (fp #b0 #b10101 #b0010100110)
                expect
                (fp #b0 #b11000 #b0001000111)))
; expect = 74.375

(assert (= expect result))

(check-sat)
(exit)
