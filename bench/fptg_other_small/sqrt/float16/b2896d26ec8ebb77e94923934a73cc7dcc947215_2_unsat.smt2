; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0111100101)
                arg1
                (fp #b0 #b11101 #b0000001101)))
(assert (fp.leq (fp #b0 #b11101 #b0000001101)
                arg1
                (fp #b0 #b11110 #b1101011010)))
; arg1 = 16592.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00011 #b1000100100)
                expect
                (fp #b0 #b10110 #b0000000111)))
(assert (fp.leq (fp #b0 #b10110 #b0000000111)
                expect
                (fp #b0 #b11000 #b0010000100)))
; expect = 128.875

(assert (not (= expect result)))

(check-sat)
(exit)
