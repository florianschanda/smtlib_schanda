(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1001011000)
                arg1
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                arg1
                (fp #b0 #b11100 #b1101010101)))
; arg1 = 14904.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10101 #b1100001100)
                expect
                (fp #b0 #b10101 #b1110100010)))
(assert (fp.leq (fp #b0 #b10101 #b1110100010)
                expect
                (fp #b0 #b11010 #b0000111101)))
; expect = 122.125

(assert (= expect result))

(check-sat)
(exit)
