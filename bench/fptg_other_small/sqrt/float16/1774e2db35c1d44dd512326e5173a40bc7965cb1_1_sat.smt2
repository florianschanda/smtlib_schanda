(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100100010)
                arg1
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                arg1
                (fp #b0 #b11110 #b1010101010)))
; arg1 = 24864.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b1100100000)
                expect
                (fp #b0 #b10110 #b0011101101)))
(assert (fp.leq (fp #b0 #b10110 #b0011101101)
                expect
                (fp #b0 #b11011 #b0100101111)))
; expect = 157.625

(assert (= expect result))

(check-sat)
(exit)
