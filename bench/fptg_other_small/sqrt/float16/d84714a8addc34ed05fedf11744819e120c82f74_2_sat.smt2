(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1000001100)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b11100 #b1101010001)))
; arg1 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0110000001)
                expect
                (fp #b0 #b01011 #b0110101001)))
(assert (fp.leq (fp #b0 #b01011 #b0110101001)
                expect
                (fp #b0 #b01110 #b0100101010)))
; expect = 0.08843994140625

(assert (= expect result))

(check-sat)
(exit)
