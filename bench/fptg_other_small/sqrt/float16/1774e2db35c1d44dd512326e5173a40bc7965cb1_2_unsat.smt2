(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100100010)
                arg1
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                arg1
                (fp #b0 #b11110 #b1010101010)))
; arg1 = 24864.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1010110110)
                expect
                (fp #b0 #b10110 #b0011101110)))
(assert (fp.leq (fp #b0 #b10110 #b0011101110)
                expect
                (fp #b0 #b11110 #b0000111010)))
; expect = 157.75

(assert (not (= expect result)))

(check-sat)
(exit)
