; arg1 = 0.00001800060272216796875

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1101101000)
                expect
                (fp #b0 #b00111 #b0001011001)))
(assert (fp.leq (fp #b0 #b00111 #b0001011001)
                expect
                (fp #b0 #b10101 #b0010000111)))
; expect = 0.004245758056640625

(assert (= expect result))

(check-sat)
(exit)
