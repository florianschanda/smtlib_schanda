; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
