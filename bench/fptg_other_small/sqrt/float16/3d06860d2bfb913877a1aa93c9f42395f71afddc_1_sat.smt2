(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1000011111)
                arg1
                (fp #b0 #b01111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111 #b1101111000)
                arg1
                (fp #b0 #b10011 #b1101000111)))
; arg1 = 1.8671875

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b1000001001)
                expect
                (fp #b0 #b01111 #b0101110111)))
(assert (fp.leq (fp #b0 #b01111 #b0101110111)
                expect
                (fp #b0 #b11101 #b0000111001)))
; expect = 1.3662109375

(assert (= expect result))

(check-sat)
(exit)
