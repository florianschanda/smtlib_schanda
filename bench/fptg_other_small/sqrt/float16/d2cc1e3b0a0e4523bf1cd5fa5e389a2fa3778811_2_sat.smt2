(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111110111)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11110 #b1010100111)))
; arg1 = 1.59765625

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1111100011)
                expect
                (fp #b0 #b01111 #b0100001111)))
(assert (fp.leq (fp #b0 #b01111 #b0100001111)
                expect
                (fp #b0 #b10000 #b1100000110)))
; expect = 1.2646484375

(assert (= expect result))

(check-sat)
(exit)
