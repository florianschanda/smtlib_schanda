; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100100)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10110 #b0110111010)))
; arg1 = 0.10479736328125

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1110001110)
                expect
                (fp #b0 #b01101 #b0100101101)))
(assert (fp.leq (fp #b0 #b01101 #b0100101101)
                expect
                (fp #b0 #b11000 #b0101001110)))
; expect = 0.323486328125

(assert (= expect result))

(check-sat)
(exit)
