(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1111100101)
                arg1
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                arg1
                (fp #b0 #b11010 #b1111100111)))
; arg1 = 2035.0

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b1010010111)
                expect
                (fp #b0 #b10100 #b0110100100)))
(assert (fp.leq (fp #b0 #b10100 #b0110100100)
                expect
                (fp #b0 #b11010 #b1110010001)))
; expect = 45.125

(assert (= expect result))

(check-sat)
(exit)
