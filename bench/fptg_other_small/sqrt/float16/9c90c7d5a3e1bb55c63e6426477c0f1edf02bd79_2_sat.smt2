(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000000)
                expect
                (fp #b0 #b00111 #b0110100111)))
(assert (fp.leq (fp #b0 #b00111 #b0110100111)
                expect
                (fp #b0 #b11110 #b0010001010)))
; expect = 0.005519866943359375

(assert (= expect result))

(check-sat)
(exit)
