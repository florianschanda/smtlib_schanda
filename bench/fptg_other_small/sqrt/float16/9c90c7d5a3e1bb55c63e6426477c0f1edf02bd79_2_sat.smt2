(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                arg1
                (fp #b0 #b00000 #b0111111111)))
