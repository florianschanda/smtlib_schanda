; arg1 = 1.98828125

(declare-const result Float16)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0011100111)
                expect
                (fp #b0 #b01111 #b0110100100)))
(assert (fp.leq (fp #b0 #b01111 #b0110100100)
                expect
                (fp #b0 #b11000 #b0000000101)))
; expect = 1.41015625

(assert (not (= expect result)))

(check-sat)
(exit)
