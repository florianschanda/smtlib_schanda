(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11110001 #b11)
                arg1
                (fp #b1 #b01010000 #b01)))
(assert (fp.leq (fp #b1 #b01010000 #b01)
                arg1
                (fp #b0 #b00000100 #b00)))
; arg1 = -0.0000000000000088817841970012523233890533447265625

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
