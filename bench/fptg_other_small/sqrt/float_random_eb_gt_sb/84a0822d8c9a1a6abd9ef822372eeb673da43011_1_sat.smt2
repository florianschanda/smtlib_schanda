; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0001110 #b0101)
                arg1
                (fp #b0 #b0110100 #b1111)))
(assert (fp.leq (fp #b0 #b0110100 #b1111)
                arg1
                (fp #b0 #b1111101 #b1101)))
; arg1 = 0.000946044921875

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0000100 #b1110)
                expect
                (fp #b0 #b0111001 #b1111)))
(assert (fp.leq (fp #b0 #b0111001 #b1111)
                expect
                (fp #b0 #b1010000 #b0010)))
; expect = 0.0302734375

(assert (= expect result))

(check-sat)
(exit)
