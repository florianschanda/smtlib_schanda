(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001001 #b0)
                arg1
                (fp #b0 #b011011 #b1)))
(assert (fp.leq (fp #b0 #b011011 #b1)
                arg1
                (fp #b0 #b100100 #b0)))
; arg1 = 0.09375

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001101 #b0)
                expect
                (fp #b0 #b011101 #b0)))
(assert (fp.leq (fp #b0 #b011101 #b0)
                expect
                (fp #b0 #b110100 #b0)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
