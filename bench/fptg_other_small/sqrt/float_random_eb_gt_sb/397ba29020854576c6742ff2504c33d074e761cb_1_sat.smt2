; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111111 #b0000)
                arg1
                (fp #b1 #b111110 #b1111)))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg1
                (fp #b0 #b111100 #b0100)))
; arg1 = -4160749568.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
