; arg1 = 14336.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00111 #b010)
                expect
                (fp #b0 #b10101 #b111)))
(assert (fp.leq (fp #b0 #b10101 #b111)
                expect
                (fp #b0 #b11011 #b001)))
; expect = 120.0

(assert (not (= expect result)))

(check-sat)
(exit)
