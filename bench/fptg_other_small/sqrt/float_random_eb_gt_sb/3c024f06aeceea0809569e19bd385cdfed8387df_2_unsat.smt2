(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b11100 #b100)
                arg1
                (fp #b0 #b11100 #b110)))
(assert (fp.leq (fp #b0 #b11100 #b110)
                arg1
