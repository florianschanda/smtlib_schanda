(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00101 #b101)
                arg1
                (fp #b0 #b01111 #b100)))
(assert (fp.leq (fp #b0 #b01111 #b100)
                arg1
                (fp #b0 #b10011 #b001)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b000)
                expect
                (fp #b0 #b01111 #b001)))
(assert (fp.leq (fp #b0 #b01111 #b001)
                expect
                (fp #b0 #b11011 #b000)))
; expect = 1.125

(assert (not (= expect result)))

(check-sat)
(exit)
