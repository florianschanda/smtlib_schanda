(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1000101 #b1)
                arg1
                (fp #b0 #b1001100 #b1)))
(assert (fp.leq (fp #b0 #b1001100 #b1)
                arg1
                (fp #b0 #b1110110 #b0)))
; arg1 = 12288.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0110001 #b1)
                expect
                (fp #b0 #b1000101 #b1)))
(assert (fp.leq (fp #b0 #b1000101 #b1)
                expect
                (fp #b0 #b1101001 #b0)))
; expect = 96.0

(assert (= expect result))

(check-sat)
(exit)
