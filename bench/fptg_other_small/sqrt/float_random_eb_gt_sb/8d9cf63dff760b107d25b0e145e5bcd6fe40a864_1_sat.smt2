(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg1
                (fp #b0 #b1001 #b01)))
(assert (fp.leq (fp #b0 #b1001 #b01)
                arg1
                (fp #b0 #b1100 #b10)))
; arg1 = 5.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0001 #b10)
                expect
                (fp #b0 #b1000 #b00)))
(assert (fp.leq (fp #b0 #b1000 #b00)
                expect
                (fp #b0 #b1000 #b11)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
