(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b01)
                arg1
                (fp #b0 #b1010 #b00)))
(assert (fp.leq (fp #b0 #b1010 #b00)
                arg1
                (fp #b0 #b1010 #b01)))
; arg1 = 8.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0010 #b00)
                expect
                (fp #b0 #b1000 #b10)))
(assert (fp.leq (fp #b0 #b1000 #b10)
                expect
                (fp #b0 #b1010 #b10)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
