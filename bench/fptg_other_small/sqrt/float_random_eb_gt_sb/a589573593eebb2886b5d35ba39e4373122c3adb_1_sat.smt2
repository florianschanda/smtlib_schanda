; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000010 #b111)
                arg1
                (fp #b0 #b000000 #b010)))
(assert (fp.leq (fp #b0 #b000000 #b010)
                arg1
                (fp #b0 #b100001 #b010)))
; arg1 = 0.00000000023283064365386962890625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001001 #b101)
                expect
                (fp #b0 #b001111 #b000)))
(assert (fp.leq (fp #b0 #b001111 #b000)
                expect
                (fp #b0 #b011110 #b101)))
; expect = 0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
