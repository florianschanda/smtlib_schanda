(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010011 #b000)
                arg1
                (fp #b0 #b100010 #b101)))
(assert (fp.leq (fp #b0 #b100010 #b101)
                arg1
                (fp #b0 #b111101 #b110)))
; arg1 = 13.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000111 #b111)
                expect
                (fp #b0 #b100000 #b110)))
(assert (fp.leq (fp #b0 #b100000 #b110)
                expect
                (fp #b0 #b101110 #b001)))
; expect = 3.5

(assert (= expect result))

(check-sat)
(exit)
