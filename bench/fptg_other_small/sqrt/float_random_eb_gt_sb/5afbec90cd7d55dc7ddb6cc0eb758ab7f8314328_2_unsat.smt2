; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b00)
                arg1
                (fp #b0 #b10111 #b10)))
(assert (fp.leq (fp #b0 #b10111 #b10)
                arg1
                (fp #b0 #b11000 #b00)))
; arg1 = 384.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b10001 #b00)
                expect
                (fp #b0 #b10011 #b01)))
(assert (fp.leq (fp #b0 #b10011 #b01)
                expect
                (fp #b0 #b10101 #b01)))
; expect = 20.0

(assert (not (= expect result)))

(check-sat)
(exit)
