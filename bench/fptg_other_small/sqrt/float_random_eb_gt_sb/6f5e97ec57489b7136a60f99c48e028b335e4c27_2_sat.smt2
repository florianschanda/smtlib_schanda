(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10110000 #b0)
                arg1
                (fp #b0 #b10111110 #b1)))
(assert (fp.leq (fp #b0 #b10111110 #b1)
                arg1
                (fp #b0 #b11110001 #b0)))
; arg1 = 13835058055282163712.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00011000 #b0)
                expect
                (fp #b0 #b10011111 #b0)))
(assert (fp.leq (fp #b0 #b10011111 #b0)
                expect
                (fp #b0 #b11010100 #b1)))
; expect = 4294967296.0

(assert (= expect result))

(check-sat)
(exit)
