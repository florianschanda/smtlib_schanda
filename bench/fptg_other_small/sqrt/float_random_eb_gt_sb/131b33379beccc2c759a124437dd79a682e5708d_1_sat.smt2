(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00000 #b001)
                arg1
                (fp #b0 #b10010 #b111)))
(assert (fp.leq (fp #b0 #b10010 #b111)
                arg1
                (fp #b0 #b11000 #b011)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10000 #b101)
                expect
                (fp #b0 #b10000 #b111)))
(assert (fp.leq (fp #b0 #b10000 #b111)
                expect
                (fp #b0 #b10110 #b000)))
; expect = 3.75

(assert (= expect result))

(check-sat)
(exit)
