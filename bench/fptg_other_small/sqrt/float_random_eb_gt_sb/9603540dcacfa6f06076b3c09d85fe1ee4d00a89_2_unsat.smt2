(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                arg1
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                expect
                (fp #b0 #b0011 #b1)))
(assert (fp.leq (fp #b0 #b0011 #b1)
                expect
                (fp #b0 #b0101 #b1)))
; expect = 0.09375

(assert (not (= expect result)))

(check-sat)
(exit)
