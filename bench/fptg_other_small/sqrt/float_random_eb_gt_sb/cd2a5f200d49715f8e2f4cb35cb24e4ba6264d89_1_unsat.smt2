; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b10)
                arg1
                (fp #b0 #b00111 #b00)))
(assert (fp.leq (fp #b0 #b00111 #b00)
                arg1
                (fp #b0 #b10001 #b01)))
; arg1 = 0.00390625

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b00101 #b11)
                expect
                (fp #b0 #b01011 #b00)))
(assert (fp.leq (fp #b0 #b01011 #b00)
                expect
                (fp #b0 #b01100 #b01)))
; expect = 0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
