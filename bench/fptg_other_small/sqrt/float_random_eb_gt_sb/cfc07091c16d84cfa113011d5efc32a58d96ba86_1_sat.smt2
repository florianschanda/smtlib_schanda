; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b100)
                arg1
                (fp #b1 #b00000 #b011)))
(assert (fp.leq (fp #b1 #b00000 #b011)
                arg1
                (fp #b0 #b11000 #b001)))
; arg1 = -0.00002288818359375

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
