; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01011 #b00)
                arg1
                (fp #b0 #b00000 #b11)))
(assert (fp.leq (fp #b0 #b00000 #b11)
                arg1
                (fp #b0 #b01001 #b01)))
; arg1 = 0.0000457763671875

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01111 #b00)
                expect
                (fp #b0 #b00111 #b11)))
(assert (fp.leq (fp #b0 #b00111 #b11)
                expect
                (fp #b0 #b10100 #b00)))
; expect = 0.0068359375

(assert (= expect result))

(check-sat)
(exit)
