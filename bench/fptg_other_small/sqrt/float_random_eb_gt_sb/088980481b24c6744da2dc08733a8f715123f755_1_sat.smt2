(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10101 #b001)
                arg1
                (fp #b0 #b10011 #b000)))
(assert (fp.leq (fp #b0 #b10011 #b000)
                arg1
                (fp #b0 #b11010 #b011)))
; arg1 = 16.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01010 #b110)
                expect
                (fp #b0 #b10001 #b000)))
(assert (fp.leq (fp #b0 #b10001 #b000)
                expect
                (fp #b0 #b10010 #b010)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
