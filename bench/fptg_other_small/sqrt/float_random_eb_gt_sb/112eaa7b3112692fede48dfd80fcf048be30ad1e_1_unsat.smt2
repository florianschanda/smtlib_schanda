(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0110110 #b10)
                expect
                (fp #b0 #b1010110 #b01)))
(assert (fp.leq (fp #b0 #b1010110 #b01)
                expect
                (fp #b0 #b1100000 #b11)))
; expect = 10485760.0

(assert (not (= expect result)))

(check-sat)
(exit)
