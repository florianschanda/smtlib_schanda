(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b0 #b0011100 #b0)
                arg1
                (fp #b0 #b1100110 #b0)))
(assert (fp.leq (fp #b0 #b1100110 #b0)
                arg1
                (fp #b0 #b1101010 #b0)))
; arg1 = 549755813888.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0001010 #b0)
                expect
                (fp #b0 #b1010010 #b0)))
(assert (fp.leq (fp #b0 #b1010010 #b0)
                expect
                (fp #b0 #b1011001 #b1)))
; expect = 524288.0

(assert (= expect result))

(check-sat)
(exit)
