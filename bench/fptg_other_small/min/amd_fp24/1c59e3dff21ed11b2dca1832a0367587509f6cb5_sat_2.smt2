; arg2 = -0.00000000000000000021684043449710088680149056017398834228515625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b1001111111100100)
                expect
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                expect
                (fp #b0 #b0100101 #b1011101110111101)))
; expect = -0.00000000000000000021684043449710088680149056017398834228515625

(assert (= expect result))

(check-sat)
(exit)
