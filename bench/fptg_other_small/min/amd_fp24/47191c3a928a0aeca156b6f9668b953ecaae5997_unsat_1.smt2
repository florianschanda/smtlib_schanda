(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000011 #b1100010111001000)
                arg2
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1110100 #b1010111110100110)))
; arg2 = 131072.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111010 #b0101011011001000)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0110111 #b0010001100000000)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
