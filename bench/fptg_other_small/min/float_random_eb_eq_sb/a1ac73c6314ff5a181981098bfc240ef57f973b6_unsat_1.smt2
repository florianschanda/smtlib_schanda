; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b010)
                arg1
                (fp #b0 #b1011 #b101)))
(assert (fp.leq (fp #b0 #b1011 #b101)
                arg1
                (fp #b0 #b1110 #b011)))
; arg1 = 26.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg2
                (fp #b0 #b1000 #b011)))
(assert (fp.leq (fp #b0 #b1000 #b011)
                arg2
                (fp #b0 #b1101 #b000)))
; arg2 = 2.75

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b100)
                expect
                (fp #b0 #b1000 #b011)))
(assert (fp.leq (fp #b0 #b1000 #b011)
                expect
                (fp #b0 #b1001 #b011)))
; expect = 2.75

(assert (not (= expect result)))

(check-sat)
(exit)
