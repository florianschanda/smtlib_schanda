(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b0010)
                arg1
                (fp #b1 #b10010 #b1001)))
(assert (fp.leq (fp #b1 #b10010 #b1001)
                arg1
                (fp #b0 #b01111 #b0010)))
; arg1 = -12.5

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1001)
                expect
                (fp #b1 #b10010 #b1001)))
(assert (fp.leq (fp #b1 #b10010 #b1001)
                expect
                (fp #b0 #b00101 #b1010)))
; expect = -12.5

(assert (= expect result))

(check-sat)
(exit)
