                (fp #b1 #b000110 #b10010)))
; arg2 = -1.25

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b10101)
                expect
                (fp #b1 #b011111 #b01000)))
(assert (fp.leq (fp #b1 #b011111 #b01000)
                expect
                (fp #b0 #b110111 #b01110)))
; expect = -1.25

(assert (not (= expect result)))

