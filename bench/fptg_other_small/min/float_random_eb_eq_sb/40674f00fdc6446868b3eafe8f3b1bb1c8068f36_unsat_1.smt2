; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00000 #b1011)
                arg1
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                arg1
                (fp #b0 #b10100 #b1011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11111 #b0000)
                arg2
                (fp #b1 #b11110 #b1111)))
(assert (fp.leq (fp #b1 #b11110 #b1111)
                arg2
                (fp #b0 #b01000 #b1100)))
; arg2 = -63488.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11111 #b0000)
                expect
                (fp #b1 #b11110 #b1111)))
(assert (fp.leq (fp #b1 #b11110 #b1111)
                expect
                (fp #b0 #b11101 #b0000)))
; expect = -63488.0

(assert (not (= expect result)))

(check-sat)
(exit)
