(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b1 #b101 #b00)))
(assert (fp.leq (fp #b1 #b101 #b00)
                arg1
                (fp #b1 #b001 #b10)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg2
                (fp #b1 #b110 #b10)))
(assert (fp.leq (fp #b1 #b110 #b10)
                arg2
                (fp #b1 #b000 #b11)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                expect
                (fp #b1 #b110 #b10)))
(assert (fp.leq (fp #b1 #b110 #b10)
                expect
                (fp #b1 #b110 #b01)))
; expect = -12.0

(assert (= expect result))

(check-sat)
(exit)
