(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b101 #b11)))
(assert (fp.leq (fp #b0 #b101 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 7.0

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b100 #b10)
                expect
                (fp #b0 #b101 #b11)))
(assert (fp.leq (fp #b0 #b101 #b11)
                expect
                (fp #b0 #b110 #b10)))
; expect = 7.0

(assert (= expect result))

(check-sat)
(exit)
