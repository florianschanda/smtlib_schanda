;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101010 #b100000)
                arg1
                (fp #b0 #b0111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111 #b000100)
                arg1
                (fp #b0 #b1010110 #b010000)))
; arg1 = 1.0625

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000011 #b000000)
                expect
                (fp #b0 #b0111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111 #b000100)
                expect
                (fp #b0 #b1000000 #b111100)))
; expect = 1.0625

(assert (= expect result))

(check-sat)
(exit)
