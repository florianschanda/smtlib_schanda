; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b100)
                arg1
                (fp #b0 #b0111 #b000)))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg1
                (fp #b0 #b0111 #b101)))
; arg1 = 1.0

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0011 #b000)
                arg2
                (fp #b0 #b0101 #b000)))
(assert (fp.leq (fp #b0 #b0101 #b000)
                arg2
                (fp #b0 #b0111 #b100)))
; arg2 = 0.25

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b001)
                expect
                (fp #b0 #b0101 #b000)))
(assert (fp.leq (fp #b0 #b0101 #b000)
                expect
                (fp #b0 #b0111 #b001)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
