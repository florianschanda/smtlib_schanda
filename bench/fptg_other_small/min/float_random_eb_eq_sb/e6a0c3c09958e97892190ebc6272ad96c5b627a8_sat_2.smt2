(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b100101)
                arg2
                (fp #b1 #b1000000 #b100000)))
(assert (fp.leq (fp #b1 #b1000000 #b100000)
                arg2
                (fp #b0 #b0100110 #b110110)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000000 #b111110)
                expect
                (fp #b1 #b1000000 #b100000)))
(assert (fp.leq (fp #b1 #b1000000 #b100000)
                expect
                (fp #b1 #b0110111 #b111000)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
