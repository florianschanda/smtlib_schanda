                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg2
                (fp #b0 #b111100 #b00000)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000011 #b01000)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b100100 #b00111)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
