; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0000)
                arg1
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                arg1
                (fp #b0 #b11101 #b1001)))
; arg1 = 5120.0

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b0111)
                expect
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                expect
                (fp #b0 #b11011 #b1111)))
; expect = 5120.0

(assert (= expect result))

(check-sat)
(exit)
