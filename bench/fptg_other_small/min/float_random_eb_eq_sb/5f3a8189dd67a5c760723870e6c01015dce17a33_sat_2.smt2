; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001010 #b10000)
                arg1
                (fp #b0 #b100111 #b11001)))
(assert (fp.leq (fp #b0 #b100111 #b11001)
                arg1
                (fp #b0 #b101001 #b01110)))
; arg1 = 456.0

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b11100)
                arg2
                (fp #b1 #b101111 #b01111)))
(assert (fp.leq (fp #b1 #b101111 #b01111)
                arg2
                (fp #b1 #b100100 #b00100)))
; arg2 = -96256.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b10111)
                expect
                (fp #b1 #b101111 #b01111)))
(assert (fp.leq (fp #b1 #b101111 #b01111)
                expect
                (fp #b0 #b001010 #b11110)))
; expect = -96256.0

(assert (= expect result))

(check-sat)
(exit)
