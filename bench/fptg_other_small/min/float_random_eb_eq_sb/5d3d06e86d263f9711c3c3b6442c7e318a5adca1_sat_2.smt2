(assert (fp.leq (fp #b1 #b0110010 #b010101)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b0101010 #b001111)))
; expect = 0.0

(assert (= expect result))

