(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110100 #b000001)
                arg2
                (fp #b1 #b1000101 #b010001)))
(assert (fp.leq (fp #b1 #b1000101 #b010001)
                arg2
                (fp #b0 #b0001101 #b101111)))
; arg2 = -81.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101100 #b010101)
                expect
                (fp #b1 #b1000101 #b010001)))
(assert (fp.leq (fp #b1 #b1000101 #b010001)
                expect
                (fp #b0 #b0001011 #b100001)))
; expect = -81.0

(assert (not (= expect result)))

(check-sat)
(exit)
