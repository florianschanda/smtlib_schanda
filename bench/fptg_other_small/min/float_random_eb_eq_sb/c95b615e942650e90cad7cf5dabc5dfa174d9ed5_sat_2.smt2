(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b010)
                arg1
                (fp #b0 #b0100 #b000)))
(assert (fp.leq (fp #b0 #b0100 #b000)
                arg1
                (fp #b0 #b0101 #b110)))
; arg1 = 0.125

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                arg2
                (fp #b1 #b1101 #b000)))
(assert (fp.leq (fp #b1 #b1101 #b000)
                arg2
                (fp #b0 #b1001 #b000)))
; arg2 = -64.0

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b101)
                expect
                (fp #b1 #b1101 #b000)))
(assert (fp.leq (fp #b1 #b1101 #b000)
                expect
                (fp #b0 #b0010 #b101)))
; expect = -64.0

(assert (= expect result))

(check-sat)
(exit)
