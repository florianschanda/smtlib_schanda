(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000111 #b10)
                arg2
                (fp #b0 #b011111 #b01)))
(assert (fp.leq (fp #b0 #b011111 #b01)
                arg2
                (fp #b0 #b111011 #b00)))
; arg2 = 1.25

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b001011 #b10)
                expect
                (fp #b0 #b011111 #b01)))
(assert (fp.leq (fp #b0 #b011111 #b01)
                expect
                (fp #b0 #b100010 #b00)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
