                arg2
                (fp #b0 #b1000 #b1)))
; arg2 = -0.0078125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1000 #b1)
                expect
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                expect
                (fp #b0 #b1110 #b0)))
; expect = -0.0078125

(assert (not (= expect result)))

(check-sat)
