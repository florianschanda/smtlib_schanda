                arg2
                (fp #b1 #b10111 #b100)))
(assert (fp.leq (fp #b1 #b10111 #b100)
                arg2
                (fp #b0 #b11001 #b100)))
; arg2 = -384.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b010)
                expect
                (fp #b1 #b10111 #b100)))
(assert (fp.leq (fp #b1 #b10111 #b100)
                expect
                (fp #b0 #b10000 #b111)))
; expect = -384.0

(assert (= expect result))

(check-sat)
(exit)
