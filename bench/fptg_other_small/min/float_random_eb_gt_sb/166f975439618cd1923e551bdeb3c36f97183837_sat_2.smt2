(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b010000 #b10)
                arg1
                (fp #b1 #b000000 #b00)))
(assert (fp.leq (fp #b1 #b000000 #b00)
                arg1
                (fp #b0 #b000000 #b00)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101111 #b11)
                arg2
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                arg2
                (fp #b0 #b011010 #b00)))
; arg2 = -0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111100 #b01)
                expect
                (fp #b1 #b000000 #b10)))
(assert (fp.leq (fp #b1 #b000000 #b10)
                expect
                (fp #b0 #b001100 #b01)))
; expect = -0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
(exit)
