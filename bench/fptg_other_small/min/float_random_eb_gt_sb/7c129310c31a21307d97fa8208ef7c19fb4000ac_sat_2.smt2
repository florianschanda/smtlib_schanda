(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110100 #b1100)
                arg1
                (fp #b0 #b1011001 #b1111)))
(assert (fp.leq (fp #b0 #b1011001 #b1111)
                arg1
                (fp #b0 #b1100101 #b1001)))
; arg1 = 130023424.0

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0101011 #b1100)
                expect
                (fp #b0 #b1011001 #b1111)))
(assert (fp.leq (fp #b0 #b1011001 #b1111)
                expect
                (fp #b0 #b1101111 #b0101)))
; expect = 130023424.0

(assert (= expect result))

(check-sat)
(exit)
