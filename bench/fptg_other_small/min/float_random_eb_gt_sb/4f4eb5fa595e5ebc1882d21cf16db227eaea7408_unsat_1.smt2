; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b11)
                arg1
                (fp #b1 #b011111 #b00)))
(assert (fp.leq (fp #b1 #b011111 #b00)
                arg1
                (fp #b0 #b000000 #b01)))
; arg1 = -1.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001100 #b10)
                arg2
                (fp #b0 #b100001 #b10)))
(assert (fp.leq (fp #b0 #b100001 #b10)
                arg2
                (fp #b0 #b100011 #b10)))
; arg2 = 6.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110011 #b01)
                expect
                (fp #b1 #b011111 #b00)))
(assert (fp.leq (fp #b1 #b011111 #b00)
                expect
                (fp #b0 #b101100 #b11)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
