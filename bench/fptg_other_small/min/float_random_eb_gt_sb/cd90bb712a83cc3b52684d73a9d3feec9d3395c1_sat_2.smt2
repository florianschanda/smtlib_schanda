(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110001 #b0010)
                arg1
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                arg1
                (fp #b1 #b011111 #b0000)))
; arg1 = -32.0

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110110 #b1001)
                expect
                (fp #b1 #b100100 #b0000)))
(assert (fp.leq (fp #b1 #b100100 #b0000)
                expect
                (fp #b1 #b011101 #b0110)))
; expect = -32.0

(assert (= expect result))

(check-sat)
(exit)
