                arg2
                (fp #b0 #b1000010 #b011)))
; arg2 = -0.00000000000000000002710505431213761085018632002174854278564453125

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101001 #b010)
                expect
                (fp #b1 #b0000000 #b001)))
(assert (fp.leq (fp #b1 #b0000000 #b001)
                expect
                (fp #b0 #b1111110 #b011)))
; expect = -0.00000000000000000002710505431213761085018632002174854278564453125

(assert (= expect result))

(check-sat)
(exit)
