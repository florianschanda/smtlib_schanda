; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1100 #b00)
                arg1
                (fp #b1 #b0100 #b00)))
(assert (fp.leq (fp #b1 #b0100 #b00)
                arg1
                (fp #b0 #b1001 #b01)))
; arg1 = -0.125

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b11)
                arg2
                (fp #b1 #b1001 #b10)))
(assert (fp.leq (fp #b1 #b1001 #b10)
                arg2
                (fp #b1 #b1000 #b01)))
; arg2 = -6.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                expect
                (fp #b1 #b1001 #b10)))
(assert (fp.leq (fp #b1 #b1001 #b10)
                expect
                (fp #b0 #b1101 #b00)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
