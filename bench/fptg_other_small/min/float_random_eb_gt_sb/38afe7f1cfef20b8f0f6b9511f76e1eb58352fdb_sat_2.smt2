(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11100 #b10)
                arg2
                (fp #b1 #b01110 #b10)))
(assert (fp.leq (fp #b1 #b01110 #b10)
                arg2
                (fp #b0 #b11110 #b10)))
; arg2 = -0.75

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01110 #b11)
                expect
                (fp #b1 #b01110 #b10)))
(assert (fp.leq (fp #b1 #b01110 #b10)
                expect
                (fp #b0 #b11000 #b01)))
; expect = -0.75

(assert (= expect result))

(check-sat)
(exit)
