(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b000)
                arg2
                (fp #b0 #b000001 #b000)))
(assert (fp.leq (fp #b0 #b000001 #b000)
                arg2
                (fp #b0 #b111110 #b001)))
; arg2 = 0.000000000931322574615478515625

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
