; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10111001 #b0)
                arg1
                (fp #b1 #b10000001 #b0)))
(assert (fp.leq (fp #b1 #b10000001 #b0)
                arg1
                (fp #b0 #b10011111 #b0)))
; arg1 = -4.0

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11100101 #b1)
                arg2
                (fp #b1 #b11100101 #b0)))
(assert (fp.leq (fp #b1 #b11100101 #b0)
                arg2
                (fp #b0 #b00111000 #b0)))
; arg2 = -5070602400912917605986812821504.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11110010 #b1)
                expect
                (fp #b1 #b11100101 #b0)))
(assert (fp.leq (fp #b1 #b11100101 #b0)
                expect
                (fp #b0 #b01010110 #b0)))
; expect = -5070602400912917605986812821504.0

(assert (= expect result))

(check-sat)
(exit)
