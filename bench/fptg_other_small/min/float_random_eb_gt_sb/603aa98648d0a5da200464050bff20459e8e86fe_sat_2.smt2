                (fp #b0 #b10010 #b00)))
(assert (fp.leq (fp #b0 #b10010 #b00)
                arg2
                (fp #b0 #b11000 #b01)))
; arg2 = 8.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00100 #b11)
                expect
                (fp #b0 #b10010 #b00)))
(assert (fp.leq (fp #b0 #b10010 #b00)
                expect
                (fp #b0 #b11100 #b01)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
