;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00011 #b01)
                arg1
                (fp #b0 #b10110 #b11)))
(assert (fp.leq (fp #b0 #b10110 #b11)
                arg1
                (fp #b0 #b11111 #b00)))
