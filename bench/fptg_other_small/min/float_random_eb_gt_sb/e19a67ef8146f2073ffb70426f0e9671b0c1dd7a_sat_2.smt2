; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110110 #b1)
                arg1
                (fp #b0 #b010110 #b0)))
(assert (fp.leq (fp #b0 #b010110 #b0)
                arg1
                (fp #b0 #b100110 #b1)))
; arg1 = 0.001953125

(declare-const arg2 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b101001 #b1)
                arg2
                (fp #b1 #b100000 #b1)))
(assert (fp.leq (fp #b1 #b100000 #b1)
                arg2
                (fp #b0 #b100101 #b1)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111101 #b0)
                expect
                (fp #b1 #b100000 #b1)))
(assert (fp.leq (fp #b1 #b100000 #b1)
                expect
                (fp #b0 #b100111 #b0)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
