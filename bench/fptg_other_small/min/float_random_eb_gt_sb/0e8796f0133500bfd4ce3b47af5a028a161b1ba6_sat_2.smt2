(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b101)
                arg2
                (fp #b1 #b10000 #b000)))
(assert (fp.leq (fp #b1 #b10000 #b000)
                arg2
                (fp #b0 #b11011 #b000)))
; arg2 = -2.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b011)
                expect
                (fp #b1 #b10000 #b000)))
(assert (fp.leq (fp #b1 #b10000 #b000)
                expect
                (fp #b1 #b00100 #b111)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
