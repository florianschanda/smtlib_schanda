(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111000 #b01)
                expect
                (fp #b1 #b11110110 #b00)))
(assert (fp.leq (fp #b1 #b11110110 #b00)
                expect
                (fp #b0 #b00000110 #b11)))
; expect = -664613997892457936451903530140172288.0

(assert (= expect result))

(check-sat)
(exit)
