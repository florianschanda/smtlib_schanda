(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00110111 #b0110)
                arg1
                (fp #b0 #b10000011 #b0110)))
(assert (fp.leq (fp #b0 #b10000011 #b0110)
                arg1
                (fp #b0 #b10101001 #b1111)))
; arg1 = 22.0

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00111111 #b0010)
                expect
                (fp #b0 #b10000011 #b0110)))
(assert (fp.leq (fp #b0 #b10000011 #b0110)
                expect
                (fp #b0 #b11111010 #b0100)))
; expect = 22.0

(assert (not (= expect result)))

(check-sat)
(exit)
