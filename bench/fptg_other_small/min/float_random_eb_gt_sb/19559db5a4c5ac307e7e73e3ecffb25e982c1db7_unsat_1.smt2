; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b01100011 #b1)
                arg1
                (fp #b0 #b01111111 #b1)))
(assert (fp.leq (fp #b0 #b01111111 #b1)
                arg1
                (fp #b0 #b11100010 #b0)))
; arg1 = 1.5

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001000 #b1)
                arg2
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg2
                (fp #b0 #b11000010 #b0)))
; arg2 = -3.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11000111 #b1)
                expect
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                expect
                (fp #b0 #b11110000 #b1)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
