; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b10)
                arg1
                (fp #b1 #b111101 #b00)))
(assert (fp.leq (fp #b1 #b111101 #b00)
                arg1
                (fp #b1 #b011011 #b00)))
; arg1 = -1073741824.0

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b01)
                arg2
                (fp #b0 #b011111 #b01)))
(assert (fp.leq (fp #b0 #b011111 #b01)
                arg2
                (fp #b0 #b110110 #b11)))
; arg2 = 1.25

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b10)
                expect
                (fp #b1 #b111101 #b00)))
(assert (fp.leq (fp #b1 #b111101 #b00)
                expect
                (fp #b1 #b011111 #b01)))
; expect = -1073741824.0

(assert (= expect result))

(check-sat)
(exit)
