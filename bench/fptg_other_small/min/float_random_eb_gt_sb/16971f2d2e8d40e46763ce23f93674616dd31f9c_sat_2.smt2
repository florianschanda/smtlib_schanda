(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10011101 #b1111)
                arg2
                (fp #b0 #b10001101 #b0011)))
(assert (fp.leq (fp #b0 #b10001101 #b0011)
                arg2
                (fp #b0 #b11101001 #b0100)))
; arg2 = 19456.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b00111100 #b0001)
                expect
                (fp #b0 #b10001101 #b0011)))
(assert (fp.leq (fp #b0 #b10001101 #b0011)
                expect
                (fp #b0 #b10001101 #b1000)))
; expect = 19456.0

(assert (= expect result))

(check-sat)
(exit)
