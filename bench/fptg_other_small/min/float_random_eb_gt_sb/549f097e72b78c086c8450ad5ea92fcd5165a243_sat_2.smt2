(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110011 #b100)
                arg1
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg1
                (fp #b0 #b11101111 #b111)))
; arg1 = 16.0

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111011 #b111)
                arg2
                (fp #b0 #b01111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111 #b101)
                arg2
                (fp #b0 #b11111100 #b001)))
; arg2 = 1.625

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00100001 #b010)
                expect
                (fp #b0 #b01111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111 #b101)
                expect
                (fp #b0 #b11110001 #b000)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
