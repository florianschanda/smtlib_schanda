(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0011 #b0)
                arg1
                (fp #b0 #b0110 #b0)))
(assert (fp.leq (fp #b0 #b0110 #b0)
                arg1
                (fp #b0 #b1110 #b1)))
; arg1 = 0.5

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1001 #b0)
                arg2
                (fp #b1 #b0111 #b0)))
(assert (fp.leq (fp #b1 #b0111 #b0)
                arg2
                (fp #b0 #b0111 #b1)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1111 #b0)
                expect
                (fp #b1 #b0111 #b0)))
(assert (fp.leq (fp #b1 #b0111 #b0)
                expect
                (fp #b1 #b0110 #b1)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
