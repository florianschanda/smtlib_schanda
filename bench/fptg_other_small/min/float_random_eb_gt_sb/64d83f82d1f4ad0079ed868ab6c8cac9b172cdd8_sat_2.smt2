                arg2
                (fp #b0 #b0100 #b10)))
; arg2 = 0.01171875

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b00)
                expect
                (fp #b1 #b0101 #b01)))
(assert (fp.leq (fp #b1 #b0101 #b01)
                expect
                (fp #b1 #b0010 #b10)))
; expect = -0.3125

(assert (= expect result))

(check-sat)
(exit)
