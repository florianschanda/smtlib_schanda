(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00100 #b1011111011)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b11110 #b0010110100)))
; arg1 = 1.3701171875

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01100 #b0011100000)
                expect
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                expect
                (fp #b0 #b10100 #b0110110011)))
; expect = 1.3701171875

(assert (= expect result))

(check-sat)
(exit)
