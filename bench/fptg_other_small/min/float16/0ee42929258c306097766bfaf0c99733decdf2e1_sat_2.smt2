                arg2
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg2
                (fp #b0 #b11011 #b0011100110)))
; arg2 = 255.875

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0000111010)
                expect
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                expect
                (fp #b1 #b00101 #b1100100010)))
; expect = -0.0024929046630859375

(assert (= expect result))

(check-sat)
(exit)
