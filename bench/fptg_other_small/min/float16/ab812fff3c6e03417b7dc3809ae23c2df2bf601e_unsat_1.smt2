(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00100 #b1100110010)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b01101 #b1011101010)))
; arg1 = -0.000039398670196533203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111000100)
                arg2
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg2
                (fp #b0 #b01000 #b0101110010)))
; arg2 = -1.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0101100100)
                expect
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                expect
                (fp #b1 #b01001 #b0111111001)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
