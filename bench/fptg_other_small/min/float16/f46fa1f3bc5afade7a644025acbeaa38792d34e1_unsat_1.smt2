(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1101000000)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b0 #b01000 #b1110000011)))
; arg1 = -1.203125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000011011)
                arg2
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                arg2
                (fp #b0 #b00010 #b1110011011)))
; arg2 = -646.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0000010111)
                expect
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                expect
                (fp #b0 #b11000 #b0111011101)))
; expect = -646.0

(assert (not (= expect result)))

(check-sat)
(exit)
