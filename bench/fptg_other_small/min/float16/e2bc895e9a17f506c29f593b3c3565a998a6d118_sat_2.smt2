(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100100000)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b1 #b00011 #b1110011010)))
; arg1 = -3788.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11011 #b1101110010)))
; arg2 = 2050.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100011)
                expect
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                expect
                (fp #b0 #b01100 #b0100000011)))
; expect = -3788.0

(assert (= expect result))

(check-sat)
(exit)
