                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                expect
                (fp #b0 #b10001 #b0001110110)))
; expect = 1.3701171875

(assert (not (= expect result)))

