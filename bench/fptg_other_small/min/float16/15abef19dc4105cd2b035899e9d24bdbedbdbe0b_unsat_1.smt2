                (fp #b1 #b00000 #b1101011101)))
; arg2 = -30.53125

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0001011010)
                expect
                (fp #b1 #b10011 #b1110100010)))
(assert (fp.leq (fp #b1 #b10011 #b1110100010)
                expect
                (fp #b1 #b00100 #b0110110111)))
; expect = -30.53125

(assert (not (= expect result)))

(check-sat)
