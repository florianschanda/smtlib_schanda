(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00100 #b1000010011)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b01111 #b0010010011)))
; arg1 = 0.0000045299530029296875

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0111101000)
                expect
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                expect
                (fp #b0 #b00110 #b1001111100)))
; expect = 0.0000045299530029296875

(assert (= expect result))

(check-sat)
(exit)
