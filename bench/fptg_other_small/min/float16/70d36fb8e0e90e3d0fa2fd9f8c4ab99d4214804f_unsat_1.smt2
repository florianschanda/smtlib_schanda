(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001100100)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b0 #b01101 #b0000010011)))
; arg1 = -16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00100 #b0100110101)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b0111001101)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0010111000)
                expect
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                expect
                (fp #b0 #b00100 #b0001101111)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
