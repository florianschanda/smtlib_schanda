(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1101001001)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b1 #b00000 #b0001000101)))
; arg1 = -0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1011010111)
                arg2
                (fp #b0 #b00000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000 #b1110100111)
                arg2
                (fp #b0 #b01001 #b0011110011)))
; arg2 = 0.000055730342864990234375

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01110 #b1110100001)
                expect
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                expect
                (fp #b0 #b11110 #b0000100001)))
; expect = -0.000244140625

(assert (= expect result))

(check-sat)
(exit)
