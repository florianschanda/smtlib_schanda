(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0010110000)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b00111 #b1011001000)))
; arg1 = 0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00010 #b1000101010)
                arg2
                (fp #b0 #b11110 #b0110110001)))
(assert (fp.leq (fp #b0 #b11110 #b0110110001)
                arg2
                (fp #b0 #b11110 #b1000000010)))
; arg2 = 46624.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0100111100)
                expect
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                expect
                (fp #b0 #b01011 #b1010011001)))
; expect = 0.000060975551605224609375

(assert (= expect result))

(check-sat)
(exit)
