(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1101000000)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b10001 #b1111001010)))
; arg1 = -0.001132965087890625

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0110010111)
                expect
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                expect
                (fp #b0 #b10011 #b0011011010)))
; expect = -0.001132965087890625

(assert (= expect result))

(check-sat)
(exit)
