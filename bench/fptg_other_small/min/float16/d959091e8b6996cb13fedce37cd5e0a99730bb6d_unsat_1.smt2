(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1000011011)
                arg1
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg1
                (fp #b0 #b01110 #b0111110111)))
; arg1 = -0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100010110)
                arg2
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                arg2
                (fp #b1 #b00111 #b0001000100)))
; arg2 = -646.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1011011111)
                expect
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                expect
                (fp #b0 #b01010 #b1001100011)))
; expect = -646.0

(assert (not (= expect result)))

(check-sat)
(exit)
