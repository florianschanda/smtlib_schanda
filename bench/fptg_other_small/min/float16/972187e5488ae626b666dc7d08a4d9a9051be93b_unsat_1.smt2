(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000001110)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11001 #b0010000101)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10001 #b1101000110)
                arg2
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg2
                (fp #b0 #b01111 #b1010010101)))
; arg2 = 0.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111100)
                expect
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                expect
                (fp #b0 #b00010 #b0000110101)))
; expect = -255.875

(assert (not (= expect result)))

(check-sat)
(exit)
