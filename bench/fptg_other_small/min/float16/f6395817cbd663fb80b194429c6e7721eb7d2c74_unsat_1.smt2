(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10011 #b1010110100)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11101 #b1101110010)))
; arg1 = 255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b0001101010)
                arg2
                (fp #b0 #b10111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10111 #b1011011100)
                arg2
                (fp #b0 #b11100 #b1110100010)))
; arg2 = 439.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0111000100)
                expect
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                expect
                (fp #b0 #b11000 #b1011101111)))
; expect = 255.875

(assert (not (= expect result)))

(check-sat)
(exit)
