(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1010001001)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0001101101)))
; arg1 = -0.000244140625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1010110010)
                arg2
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg2
                (fp #b0 #b10101 #b1100001101)))
; arg2 = -2048.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0001010000)
                expect
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                expect
                (fp #b1 #b10101 #b0100010011)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
