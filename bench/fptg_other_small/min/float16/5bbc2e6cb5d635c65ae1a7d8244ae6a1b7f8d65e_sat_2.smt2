(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0111000100)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10011 #b1111101101)))
; arg1 = -1809.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010110111)
                arg2
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                arg2
                (fp #b0 #b00010 #b0011100011)))
; arg2 = -32416.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111010111)
                expect
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                expect
                (fp #b0 #b11101 #b1110101101)))
; expect = -32416.0

(assert (= expect result))

(check-sat)
(exit)
