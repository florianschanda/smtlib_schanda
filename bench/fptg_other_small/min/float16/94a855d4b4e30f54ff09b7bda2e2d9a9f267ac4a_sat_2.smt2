(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0011010011)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b0 #b00000 #b1001010110)))
; arg1 = -16384.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1000100110)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b01111 #b0101110101)))
; arg2 = 0.000244140625

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0111010001)
                expect
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                expect
                (fp #b0 #b00101 #b0000001011)))
; expect = -16384.0

(assert (= expect result))

(check-sat)
(exit)
