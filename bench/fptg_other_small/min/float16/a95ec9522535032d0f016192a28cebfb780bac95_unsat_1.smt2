(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1000000001)
                arg1
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg1
                (fp #b0 #b11011 #b1111011010)))
; arg1 = 0.000000059604644775390625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b1010101100)
                arg2
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg2
                (fp #b0 #b11100 #b0111011100)))
; arg2 = -0.0000152587890625

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1010100010)
                expect
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                expect
                (fp #b0 #b01101 #b0010000111)))
; expect = -0.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
