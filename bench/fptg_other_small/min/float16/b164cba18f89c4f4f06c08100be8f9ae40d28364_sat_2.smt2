(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1101010111)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b1 #b01100 #b1000101000)))
; arg1 = -1.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111110011)
                arg2
                (fp #b1 #b11110 #b1111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111001110)
                arg2
                (fp #b1 #b11011 #b0110001100)))
; arg2 = -63936.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111011110)
                expect
                (fp #b1 #b11110 #b1111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111001110)
                expect
                (fp #b0 #b00111 #b1100110010)))
; expect = -63936.0

(assert (= expect result))

(check-sat)
(exit)
