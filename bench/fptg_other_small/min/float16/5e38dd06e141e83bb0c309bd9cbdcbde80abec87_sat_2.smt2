(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0010110010)
                arg2
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b0 #b11110 #b1000001000)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0011111010)
                expect
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                expect
                (fp #b1 #b01010 #b0101000101)))
; expect = -1.0380859375

(assert (= expect result))

(check-sat)
(exit)
