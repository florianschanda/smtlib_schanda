(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00011 #b1100110110)
                arg1
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg1
                (fp #b0 #b11101 #b1100001011)))
; arg1 = 0.0

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1111001110)
                arg2
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                arg2
                (fp #b1 #b01101 #b0110000001)))
; arg2 = -1.0380859375

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b0010000001)
                expect
                (fp #b1 #b01111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111 #b0000100111)
                expect
                (fp #b0 #b10110 #b0011100011)))
; expect = -1.0380859375

(assert (= expect result))

(check-sat)
(exit)
