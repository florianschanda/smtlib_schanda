(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110011110)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10001 #b1001010110)))
; arg1 = -1809.0

(declare-const arg2 Float16)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0111011111)
                expect
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                expect
                (fp #b0 #b01000 #b0111110011)))
; expect = -1809.0

(assert (not (= expect result)))

(check-sat)
(exit)
