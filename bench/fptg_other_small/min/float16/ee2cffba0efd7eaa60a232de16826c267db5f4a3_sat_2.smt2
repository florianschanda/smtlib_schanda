(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b0111001011)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b00011 #b0010000101)))
; arg1 = -0.00006103515625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01010 #b1001111101)
                arg2
                (fp #b0 #b10010 #b1000110000)))
(assert (fp.leq (fp #b0 #b10010 #b1000110000)
                arg2
                (fp #b0 #b10100 #b0001010010)))
; arg2 = 12.375

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1011101110)
                expect
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                expect
                (fp #b0 #b10101 #b0100101011)))
; expect = -0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
