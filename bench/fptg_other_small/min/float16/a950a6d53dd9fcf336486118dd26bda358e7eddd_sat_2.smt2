; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1011010100)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b10101 #b1111101001)))
; arg1 = -0.000055372714996337890625

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1111111100)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b11001 #b1010111010)))
; arg2 = 1.275390625

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0011010000)
                expect
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                expect
                (fp #b0 #b01011 #b1101111101)))
; expect = -0.000055372714996337890625

(assert (= expect result))

(check-sat)
(exit)
