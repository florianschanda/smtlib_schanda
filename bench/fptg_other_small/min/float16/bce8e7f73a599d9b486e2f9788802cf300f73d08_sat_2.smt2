(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0000110011)
                arg1
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg1
                (fp #b1 #b01011 #b1010010101)))
; arg1 = -1.98828125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000000011)
                arg2
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg2
                (fp #b0 #b11001 #b1101100110)))
; arg2 = -0.000244140625

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1111111110)
                expect
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                expect
                (fp #b0 #b01001 #b0101011110)))
; expect = -1.98828125

(assert (= expect result))

(check-sat)
(exit)
