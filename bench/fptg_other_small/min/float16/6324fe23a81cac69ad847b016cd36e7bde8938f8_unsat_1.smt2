(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1001010000)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b0101101010)))
; arg1 = -255.875

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0100000001)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b01111 #b1011010001)))
; arg2 = 0.0078125

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1010011011)
                expect
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                expect
                (fp #b0 #b00110 #b1001011111)))
; expect = -255.875

(assert (not (= expect result)))

(check-sat)
(exit)
