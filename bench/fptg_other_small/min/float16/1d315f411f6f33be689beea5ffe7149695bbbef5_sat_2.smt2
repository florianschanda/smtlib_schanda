(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1001101101)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b0 #b00110 #b1101010011)))
; arg1 = -0.000060975551605224609375

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1010110000)
                arg2
                (fp #b0 #b00000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000 #b0001110101)
                arg2
                (fp #b0 #b11001 #b0111101101)))
; arg2 = 0.000006973743438720703125

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010011110)
                expect
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                expect
                (fp #b0 #b00100 #b0110110101)))
; expect = -0.000060975551605224609375

(assert (= expect result))

(check-sat)
(exit)
