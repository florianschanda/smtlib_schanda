(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1110011001)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b01000 #b0000111001)))
; arg1 = 0.0078125

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0011111001)
                arg2
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                arg2
                (fp #b1 #b01011 #b0000100110)))
; arg2 = -32416.0

(declare-const result Float16)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0100111111)
                expect
                (fp #b1 #b11101 #b1111101010)))
(assert (fp.leq (fp #b1 #b11101 #b1111101010)
                expect
                (fp #b0 #b11000 #b1101010101)))
; expect = -32416.0

(assert (= expect result))

(check-sat)
(exit)
