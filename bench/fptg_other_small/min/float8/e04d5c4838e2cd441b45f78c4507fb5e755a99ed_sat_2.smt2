(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1001)
                arg1
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg1
                (fp #b0 #b011 #b0010)))
; arg1 = -9.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                expect
                (fp #b0 #b100 #b1100)))
; expect = -9.5

(assert (= expect result))

(check-sat)
(exit)
