; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                arg1
                (fp #b1 #b011 #b0111)))
(assert (fp.leq (fp #b1 #b011 #b0111)
                arg1
                (fp #b1 #b010 #b1100)))
; arg1 = -1.4375

(declare-const arg2 (_ FloatingPoint 3 5))
