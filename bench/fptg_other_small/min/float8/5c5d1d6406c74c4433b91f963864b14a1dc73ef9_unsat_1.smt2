                arg2
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                arg2
                (fp #b0 #b100 #b0111)))
; arg2 = -4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0110)
                expect
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                expect
                (fp #b0 #b011 #b0101)))
; expect = -4.0

(assert (not (= expect result)))

(check-sat)
(exit)
