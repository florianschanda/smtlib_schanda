(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0110)
                arg1
                (fp #b0 #b001 #b0110)))
(assert (fp.leq (fp #b0 #b001 #b0110)
                arg1
                (fp #b0 #b100 #b0111)))
; arg1 = 0.34375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg2
                (fp #b1 #b110 #b1000)))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg2
                (fp #b0 #b000 #b0010)))
; arg2 = -12.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1001)
                expect
                (fp #b1 #b110 #b1000)))
(assert (fp.leq (fp #b1 #b110 #b1000)
                expect
                (fp #b1 #b010 #b0011)))
; expect = -12.0

(assert (= expect result))

(check-sat)
(exit)
