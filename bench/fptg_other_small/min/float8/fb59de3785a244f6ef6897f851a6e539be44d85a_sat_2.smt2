; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg1
                (fp #b0 #b010 #b1111)))
; arg1 = -9.5

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b1110)
                arg2
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg2
                (fp #b0 #b111 #b0000)))
; arg2 = 15.5

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                expect
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                expect
                (fp #b1 #b001 #b1010)))
; expect = -9.5

(assert (= expect result))

(check-sat)
(exit)
