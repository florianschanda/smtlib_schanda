(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg2
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg2
                (fp #b0 #b101 #b0011)))
; arg2 = 1.375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1110)
                expect
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                expect
                (fp #b0 #b100 #b1000)))
; expect = 1.375

(assert (= expect result))

(check-sat)
(exit)
