(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001 #b1111)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b100 #b1101)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg2
                (fp #b1 #b000 #b1110)))
(assert (fp.leq (fp #b1 #b000 #b1110)
                arg2
                (fp #b0 #b011 #b0101)))
; arg2 = -0.21875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0000)
                expect
                (fp #b1 #b000 #b1110)))
(assert (fp.leq (fp #b1 #b000 #b1110)
                expect
                (fp #b0 #b100 #b0010)))
; expect = -0.21875

(assert (not (= expect result)))

(check-sat)
(exit)
