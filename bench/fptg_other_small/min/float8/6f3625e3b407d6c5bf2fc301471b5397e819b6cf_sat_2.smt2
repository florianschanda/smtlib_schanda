(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1101)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b010 #b0111)))
; arg1 = 0.125

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b0110)
                arg2
                (fp #b0 #b100 #b1000)))
(assert (fp.leq (fp #b0 #b100 #b1000)
                arg2
                (fp #b0 #b101 #b0111)))
; arg2 = 3.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                expect
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                expect
                (fp #b0 #b011 #b1110)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
