                arg2
                (fp #b0 #b100 #b0011)))
; arg2 = -1.375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0101)
                expect
                (fp #b1 #b011 #b0110)))
(assert (fp.leq (fp #b1 #b011 #b0110)
                expect
                (fp #b1 #b000 #b1101)))
; expect = -1.375

(assert (not (= expect result)))

(check-sat)
(exit)
