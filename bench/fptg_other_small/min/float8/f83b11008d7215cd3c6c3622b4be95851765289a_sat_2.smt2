(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +NAN
; Arg2: +ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b011 #b1001)
                arg2
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg2
                (fp #b0 #b100 #b0110)))
; arg2 = 0.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001 #b1001)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b100 #b1011)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
