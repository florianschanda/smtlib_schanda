(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1111)
                arg1
                (fp #b0 #b000 #b1111)))
(assert (fp.leq (fp #b0 #b000 #b1111)
                arg1
                (fp #b0 #b100 #b0110)))
; arg1 = 0.234375

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0101)
                expect
                (fp #b0 #b000 #b1111)))
(assert (fp.leq (fp #b0 #b000 #b1111)
                expect
                (fp #b0 #b001 #b0000)))
; expect = 0.234375

(assert (not (= expect result)))

(check-sat)
(exit)
