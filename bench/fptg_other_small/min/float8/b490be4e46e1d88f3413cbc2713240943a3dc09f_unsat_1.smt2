                arg2
                (fp #b1 #b100 #b1110)))
; arg2 = -15.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                expect
                (fp #b0 #b101 #b0111)))
; expect = -15.0

(assert (not (= expect result)))

(check-sat)
(exit)
