(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b101 #b1011)))
; arg1 = -0.046875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1000)
                expect
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                expect
                (fp #b0 #b110 #b1001)))
; expect = -0.046875

(assert (not (= expect result)))

(check-sat)
(exit)
