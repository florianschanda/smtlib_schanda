(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0101)
                arg1
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg1
                (fp #b0 #b101 #b0110)))
; arg1 = 3.875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0110)
                arg2
                (fp #b0 #b101 #b0011)))
(assert (fp.leq (fp #b0 #b101 #b0011)
                arg2
                (fp #b0 #b101 #b1000)))
; arg2 = 4.75

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0110)
                expect
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                expect
                (fp #b0 #b110 #b0110)))
; expect = 3.875

(assert (= expect result))

(check-sat)
(exit)
