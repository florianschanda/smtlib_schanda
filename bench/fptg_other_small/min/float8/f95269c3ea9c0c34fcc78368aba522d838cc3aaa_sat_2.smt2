(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg2
                (fp #b1 #b100 #b0010)))
(assert (fp.leq (fp #b1 #b100 #b0010)
                arg2
                (fp #b0 #b100 #b0110)))
; arg2 = -2.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                expect
                (fp #b1 #b100 #b0010)))
(assert (fp.leq (fp #b1 #b100 #b0010)
                expect
                (fp #b0 #b000 #b0100)))
; expect = -2.25

(assert (= expect result))

(check-sat)
(exit)
