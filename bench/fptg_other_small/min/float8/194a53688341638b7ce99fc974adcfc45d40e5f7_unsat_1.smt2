(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT8
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b1100)
                arg1
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg1
                (fp #b0 #b101 #b1100)))
; arg1 = 4.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1101)
                arg2
                (fp #b0 #b101 #b0011)))
(assert (fp.leq (fp #b0 #b101 #b0011)
                arg2
                (fp #b0 #b110 #b0010)))
; arg2 = 4.75

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1101)
                expect
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                expect
                (fp #b0 #b110 #b0000)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
