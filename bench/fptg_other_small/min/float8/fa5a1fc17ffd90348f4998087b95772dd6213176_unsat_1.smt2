(assert (fp.leq (fp #b1 #b000 #b0111)
                arg2
                (fp #b0 #b100 #b0111)))
; arg2 = -0.109375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                expect
                (fp #b1 #b000 #b0111)))
(assert (fp.leq (fp #b1 #b000 #b0111)
                expect
                (fp #b0 #b100 #b0100)))
; expect = -0.109375

(assert (not (= expect result)))

(check-sat)
(exit)
