(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1010)
                arg1
                (fp #b0 #b000 #b1110)))
(assert (fp.leq (fp #b0 #b000 #b1110)
                arg1
                (fp #b0 #b101 #b1101)))
; arg1 = 0.21875

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0101)
                arg2
                (fp #b0 #b000 #b0111)))
(assert (fp.leq (fp #b0 #b000 #b0111)
                arg2
                (fp #b0 #b101 #b0010)))
; arg2 = 0.109375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0101)
                expect
                (fp #b0 #b000 #b0111)))
(assert (fp.leq (fp #b0 #b000 #b0111)
                expect
                (fp #b0 #b010 #b0100)))
; expect = 0.109375

(assert (= expect result))

(check-sat)
(exit)
