; Format: FLOAT8
; Arg1: +ZERO
; Arg2: -ZERO

; Redundancy: False
; Validation for: MIN
;   * PYMPF: FULL

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b100 #b1101)
                arg2
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                arg2
                (fp #b0 #b001 #b0110)))
; arg2 = -0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011 #b1001)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b001 #b1111)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
