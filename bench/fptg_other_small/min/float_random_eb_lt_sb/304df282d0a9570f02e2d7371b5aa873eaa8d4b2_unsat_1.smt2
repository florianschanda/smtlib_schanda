(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 3))
(assert (fp.leq (fp #b1 #b10 #b11)
                arg1
                (fp #b1 #b10 #b10)))
(assert (fp.leq (fp #b1 #b10 #b10)
                arg1
                (fp #b0 #b10 #b01)))
; arg1 = -3.0

(declare-const arg2 (_ FloatingPoint 2 3))
(assert (fp.leq (fp #b1 #b10 #b01)
                arg2
                (fp #b1 #b01 #b00)))
(assert (fp.leq (fp #b1 #b01 #b00)
                arg2
                (fp #b1 #b00 #b01)))
; arg2 = -1.0

(declare-const result (_ FloatingPoint 2 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 3))
(assert (fp.leq (fp #b1 #b11 #b00)
                expect
                (fp #b1 #b10 #b10)))
(assert (fp.leq (fp #b1 #b10 #b10)
                expect
                (fp #b0 #b10 #b10)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
