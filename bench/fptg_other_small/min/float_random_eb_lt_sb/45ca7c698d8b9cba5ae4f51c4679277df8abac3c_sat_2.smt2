; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 2 16))
(assert (fp.leq (fp #b1 #b10 #b011110111011010)
                arg2
                (fp #b1 #b10 #b001100101101110)))
(assert (fp.leq (fp #b1 #b10 #b001100101101110)
                arg2
                (fp #b1 #b00 #b000110110001011)))
; arg2 = -2.3973388671875

(declare-const result (_ FloatingPoint 2 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 16))
(assert (fp.leq (fp #b1 #b10 #b100000110010011)
                expect
                (fp #b1 #b10 #b001100101101110)))
(assert (fp.leq (fp #b1 #b10 #b001100101101110)
                expect
                (fp #b0 #b10 #b110010001011000)))
; expect = -2.3973388671875

(assert (= expect result))

(check-sat)
(exit)
