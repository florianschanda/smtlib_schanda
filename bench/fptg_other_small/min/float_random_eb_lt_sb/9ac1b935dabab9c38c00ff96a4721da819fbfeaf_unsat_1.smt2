; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 3 10))
(assert (fp.leq (fp #b1 #b011 #b011000000)
                arg1
                (fp #b1 #b001 #b000000000)))
(assert (fp.leq (fp #b1 #b001 #b000000000)
                arg1
                (fp #b0 #b010 #b101110110)))
; arg1 = -0.25

(declare-const arg2 (_ FloatingPoint 3 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 3 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 10))
(assert (fp.leq (fp #b1 #b001 #b110010000)
                expect
                (fp #b1 #b001 #b000000000)))
(assert (fp.leq (fp #b1 #b001 #b000000000)
                expect
                (fp #b0 #b001 #b110111011)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
