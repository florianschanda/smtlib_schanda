                arg2
                (fp #b0 #b01101001 #b0110101)))
; arg2 = -2315255808.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1010111)
                expect
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                expect
                (fp #b1 #b10010111 #b1010111)))
; expect = -2315255808.0

(assert (not (= expect result)))

(check-sat)
