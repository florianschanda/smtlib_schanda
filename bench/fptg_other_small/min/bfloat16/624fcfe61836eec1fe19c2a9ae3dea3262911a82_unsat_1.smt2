; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010111 #b0101110)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b0 #b01011110 #b0000011)))
; arg1 = -134.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111011 #b0000011)
                expect
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                expect
                (fp #b0 #b01000110 #b0010111)))
; expect = -134.0

(assert (not (= expect result)))

(check-sat)
(exit)
