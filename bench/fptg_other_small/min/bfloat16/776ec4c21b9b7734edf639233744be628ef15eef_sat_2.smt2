(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111000 #b0110010)
                arg1
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                arg1
                (fp #b0 #b11111100 #b0101000)))
; arg1 = -312261302288384.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
