(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001111 #b0111100)
                expect
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                expect
                (fp #b0 #b11111011 #b0011100)))
; expect = 1.3359375

(assert (not (= expect result)))

(check-sat)
(exit)
