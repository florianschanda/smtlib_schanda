(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110110 #b0011100)
                expect
                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                expect
                (fp #b0 #b10101001 #b0000101)))
; expect = 3489792.0

(assert (= expect result))

(check-sat)
