; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b1111100)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b0 #b01001000 #b0001100)))
; arg1 = -177.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110100 #b0100100)
                arg2
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg2
                (fp #b0 #b10110000 #b1010011)))
; arg2 = 256.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110001 #b1100111)
                expect
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                expect
                (fp #b0 #b00101100 #b0001010)))
; expect = -177.0

(assert (not (= expect result)))

(check-sat)
(exit)
