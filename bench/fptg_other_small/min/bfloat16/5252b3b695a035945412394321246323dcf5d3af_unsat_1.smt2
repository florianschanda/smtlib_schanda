; Format: BFLOAT16
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01101011 #b1101111)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b00010101 #b1000111)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100110 #b0111000)
                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b11110011 #b0000110)))
; arg2 = 477184.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11010101 #b1011101)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b00001000 #b1011111)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
