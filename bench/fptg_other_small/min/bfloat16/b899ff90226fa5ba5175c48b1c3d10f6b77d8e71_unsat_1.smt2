(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +INFINITY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010111 #b0101000)
                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b10010101 #b0101110)))
; arg2 = 129.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010110 #b0101001)
                expect
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                expect
                (fp #b0 #b11110101 #b0111100)))
; expect = 129.0

(assert (not (= expect result)))

(check-sat)
(exit)
