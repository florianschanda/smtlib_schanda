                expect
                (fp #b0 #b01111111 #b1110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1110100)
                expect
                (fp #b0 #b11000101 #b0111100)))
; expect = 1.90625

(assert (= expect result))

(check-sat)
(exit)
