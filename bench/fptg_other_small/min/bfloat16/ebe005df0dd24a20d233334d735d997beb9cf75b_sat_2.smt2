; Format: BFLOAT16
; Arg1: -ZERO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10011001 #b1101101)
                arg1
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg1
                (fp #b0 #b10100010 #b0101001)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b1011010)
                arg2
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg2
                (fp #b0 #b11011010 #b1000000)))
; arg2 = -18374686479671623680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000011 #b0101010)
                expect
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                expect
                (fp #b1 #b01011100 #b0011101)))
; expect = -18374686479671623680.0

(assert (= expect result))

(check-sat)
(exit)
