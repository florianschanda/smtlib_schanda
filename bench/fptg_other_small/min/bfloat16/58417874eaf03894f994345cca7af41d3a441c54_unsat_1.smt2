; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0011000)
                arg1
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                arg1
                (fp #b0 #b00110110 #b1110110)))
; arg1 = -8510837770086989389931479040.0

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01100101 #b0001101)
                arg2
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg2
                (fp #b0 #b00000110 #b1011001)))
; arg2 = -0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011111 #b1010110)
                expect
                (fp #b1 #b11011011 #b1011100)))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                expect
                (fp #b0 #b10110110 #b0111001)))
; expect = -8510837770086989389931479040.0

(assert (not (= expect result)))

(check-sat)
(exit)
