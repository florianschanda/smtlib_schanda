                arg2
                (fp #b0 #b11110000 #b1101000)))
; arg2 = 66490920078804604608839680.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000000 #b0010110)
                expect
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                expect
                (fp #b0 #b11011011 #b1010111)))
; expect = 86.0

(assert (= expect result))

(check-sat)
