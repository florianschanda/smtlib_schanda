                expect
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                expect
                (fp #b0 #b10111101 #b0010001)))
; expect = -312261302288384.0

(assert (= expect result))

