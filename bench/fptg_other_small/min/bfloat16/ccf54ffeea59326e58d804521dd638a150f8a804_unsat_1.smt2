                (fp #b0 #b10010100 #b1010101)))
(assert (fp.leq (fp #b0 #b10010100 #b1010101)
                expect
                (fp #b0 #b10010111 #b1010010)))
; expect = 3489792.0

(assert (not (= expect result)))

