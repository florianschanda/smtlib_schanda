                expect
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                expect
                (fp #b1 #b00011100 #b0110100)))
; expect = -177.0

(assert (not (= expect result)))

