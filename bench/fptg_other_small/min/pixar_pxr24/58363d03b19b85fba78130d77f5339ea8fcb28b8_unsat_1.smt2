; Format: PIXAR_PXR24
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b000011010111001)
                arg2
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b1 #b00110110 #b010001001011111)))
; arg2 = -25543998105547307146954145792.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110111 #b011100000011110)
                expect
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                expect
                (fp #b0 #b01110111 #b011001111010100)))
; expect = -25543998105547307146954145792.0

(assert (not (= expect result)))

(check-sat)
(exit)
