; Format: PIXAR_PXR24
; Arg1: +NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100011 #b111101000010011)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b0 #b10111001 #b001100111110011)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001110 #b101001000010110)
                expect
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                expect
                (fp #b0 #b10101111 #b000100101011001)))
; expect = -52012.0

(assert (not (= expect result)))

(check-sat)
(exit)
