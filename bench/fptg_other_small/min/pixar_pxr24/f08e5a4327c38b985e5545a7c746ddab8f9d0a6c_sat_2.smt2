(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -NAN
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001101 #b110111001101011)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b00011111 #b001110011110011)))
; arg2 = -65536.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001110 #b100010011101010)
                expect
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b00010011 #b011110101110101)))
; expect = -65536.0

(assert (= expect result))

(check-sat)
(exit)
