(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10011101 #b000110000011011)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b01010110 #b001011010001011)))
; arg1 = -0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001110 #b001000101110010)
                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b1 #b10011001 #b011110100111111)))
; arg2 = -51220840448.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001100 #b100000000000010)
                expect
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                expect
                (fp #b0 #b10100001 #b010101100000001)))
; expect = -51220840448.0

(assert (= expect result))

(check-sat)
(exit)
