; Format: PIXAR_PXR24
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10100100 #b011100000110001)
                arg1
                (fp #b0 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                arg1
                (fp #b0 #b11001010 #b011000000000100)))
; arg1 = 18446462598732840960.0

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
