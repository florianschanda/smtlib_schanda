                expect
                (fp #b0 #b10001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b10001011 #b111110110011000)
                expect
                (fp #b0 #b11000101 #b100101101000011)))
; expect = 8115.0

(assert (not (= expect result)))

