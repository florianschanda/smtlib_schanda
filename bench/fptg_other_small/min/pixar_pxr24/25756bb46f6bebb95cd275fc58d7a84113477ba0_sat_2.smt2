(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110111 #b011111101110010)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b0 #b10011011 #b010110000100010)))
; arg2 = -52012.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110101 #b111000100010110)
                expect
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                expect
                (fp #b0 #b11100010 #b010000011111111)))
; expect = -52012.0

(assert (= expect result))

(check-sat)
(exit)
