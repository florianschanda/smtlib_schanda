; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10111010 #b0110101110)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b01110110 #b0111011011)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000100 #b1100110101)
                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b00011010 #b0101011100)))
; arg2 = -0.00000000000000000000000000000000000000638256698298038920342399916694891207878103564028594396444205028018359371344558894634246826171875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001110 #b1110000011)
                expect
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                expect
                (fp #b0 #b01001001 #b1000110101)))
; expect = -0.00000000000000000000000000000000000000638256698298038920342399916694891207878103564028594396444205028018359371344558894634246826171875

(assert (= expect result))

(check-sat)
(exit)
