                arg2
                (fp #b1 #b00110011 #b0000010001)))
; arg2 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100110 #b1010011010)
                expect
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                expect
                (fp #b0 #b01000111 #b1010110110)))
; expect = -2048.0

(assert (not (= expect result)))

(check-sat)
