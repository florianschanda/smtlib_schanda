(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +ZERO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11101100 #b1101100011)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b10101001 #b1000000110)))
; arg1 = 0.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110000 #b0101100010)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b10010100 #b0100001101)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
