(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000111 #b1000110000)
                expect
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                expect
                (fp #b0 #b10010100 #b0111010111)))
; expect = 1872.0

(assert (not (= expect result)))

