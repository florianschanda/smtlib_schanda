; Format: TENSORFLOAT32
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001000 #b1010011001)
                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b00011000 #b0010001010)))
; arg2 = -1.0380859375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110010 #b0011011011)
                expect
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                expect
                (fp #b0 #b10100110 #b0101010000)))
; expect = -1.0380859375

(assert (= expect result))

(check-sat)
(exit)
