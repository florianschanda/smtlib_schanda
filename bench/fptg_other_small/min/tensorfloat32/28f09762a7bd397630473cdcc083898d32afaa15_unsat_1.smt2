                arg2
                (fp #b1 #b10100111 #b1010010010)))
; arg2 = -165773953014656025581584384.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100000 #b0001110010)
                expect
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                expect
                (fp #b0 #b01100011 #b0100000101)))
; expect = -165773953014656025581584384.0

(assert (not (= expect result)))

(check-sat)
