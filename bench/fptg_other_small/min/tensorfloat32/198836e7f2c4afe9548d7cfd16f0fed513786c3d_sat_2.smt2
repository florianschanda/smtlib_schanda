; Format: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100010 #b1101000110)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b01011010 #b0100010111)))
; arg1 = -933.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111010 #b1101011100)
                expect
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                expect
                (fp #b0 #b00111111 #b1001101011)))
; expect = -933.0

(assert (= expect result))

(check-sat)
(exit)
