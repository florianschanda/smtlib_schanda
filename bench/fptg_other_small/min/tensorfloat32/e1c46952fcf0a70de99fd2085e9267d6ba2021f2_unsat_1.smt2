; Format: TENSORFLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111011 #b0000101111)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b10100100 #b1110101111)))
; arg1 = 2048.0

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011110 #b0110111000)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11001101 #b1111101101)))
; arg2 = 1336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111010 #b1100100101)
                expect
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                expect
                (fp #b0 #b10001110 #b1010000011)))
; expect = 1336.0

(assert (not (= expect result)))

(check-sat)
(exit)
