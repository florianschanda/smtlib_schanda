(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001111 #b0000111111)
                arg2
                (fp #b0 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b10111000 #b1011001000)))
; arg2 = 307090161664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
