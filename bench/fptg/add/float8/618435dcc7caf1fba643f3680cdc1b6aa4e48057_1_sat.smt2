(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b1 #b000 #b0000)))

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1010)
                arg2
                (fp #b0 #b000 #b0111)))
(assert (fp.leq (fp #b0 #b000 #b0111)
                arg2
                (fp #b0 #b001 #b1011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                expect
                (fp #b1 #b110 #b1101)))
(assert (fp.leq (fp #b1 #b110 #b1101)
                expect
                (fp #b1 #b001 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
