; Format: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b1110)
                arg1
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg1
                (fp #b0 #b110 #b0010)))

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0001)
                arg2
                (fp #b0 #b001 #b0000)))
(assert (fp.leq (fp #b0 #b001 #b0000)
                arg2
                (fp #b0 #b011 #b0110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b0010)
                expect
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                expect
                (fp #b0 #b101 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
