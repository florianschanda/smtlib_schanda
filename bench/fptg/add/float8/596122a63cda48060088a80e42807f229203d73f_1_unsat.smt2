(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0110)
                expect
                (fp #b1 #b000 #b0111)))
(assert (fp.leq (fp #b1 #b000 #b0111)
                expect
                (fp #b1 #b000 #b0001)))

(assert (not (= expect result)))

(check-sat)
(exit)
