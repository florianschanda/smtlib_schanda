(assert (fp.leq (fp #b0 #b011111111 #b00011)
                arg2
                (fp #b0 #b111001010 #b00000)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111000 #b01010)
                expect
                (fp #b0 #b100000000 #b01101)))
(assert (fp.leq (fp #b0 #b100000000 #b01101)
                expect
                (fp #b0 #b110000001 #b00011)))

(assert (not (= expect result)))

(check-sat)
(exit)
