(assert (fp.leq (fp #b1 #b10001100101100 #b010)
                arg2
                (fp #b0 #b00001101001001 #b011)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11000011001100 #b111)
                expect
                (fp #b1 #b10001100101100 #b001)))
(assert (fp.leq (fp #b1 #b10001100101100 #b001)
                expect
                (fp #b1 #b10001011000000 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
