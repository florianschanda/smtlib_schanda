                arg2
                (fp #b1 #b11111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000)
                arg2
                (fp #b1 #b11010011101110 #b0110100010)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11111111111110 #b1110000001)
                expect
                (fp #b1 #b11111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000)
                expect
                (fp #b1 #b00110011111011 #b0100000011)))

(assert (= expect result))

(check-sat)
(exit)
