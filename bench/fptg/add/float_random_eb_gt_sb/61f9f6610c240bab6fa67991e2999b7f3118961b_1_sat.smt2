; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11101010011010 #b11111)
                arg1
                (fp #b1 #b01011001101011 #b10001)))
(assert (fp.leq (fp #b1 #b01011001101011 #b10001)
                arg1
                (fp #b0 #b11001101110000 #b00000)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10100010001101 #b10110)
                arg2
                (fp #b0 #b00000000000001 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b00000)
                arg2
                (fp #b0 #b00110111100110 #b10110)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10000100110011 #b00111)
                expect
                (fp #b1 #b01011001101011 #b10000)))
(assert (fp.leq (fp #b1 #b01011001101011 #b10000)
                expect
                (fp #b0 #b00001110100001 #b10011)))

(assert (= expect result))

(check-sat)
(exit)
