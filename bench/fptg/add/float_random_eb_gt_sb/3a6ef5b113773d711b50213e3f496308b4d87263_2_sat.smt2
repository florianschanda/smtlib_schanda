(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100011 #b101)
                arg1
                (fp #b0 #b000001 #b000)))
(assert (fp.leq (fp #b0 #b000001 #b000)
                arg1
                (fp #b0 #b101000 #b000)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101101 #b101)
                arg2
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg2
                (fp #b0 #b001110 #b010)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111001 #b011)
                expect
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                expect
                (fp #b0 #b111011 #b100)))

(assert (= expect result))

(check-sat)
(exit)
