                arg2
                (fp #b1 #b100010011 #b0111011)))
(assert (fp.leq (fp #b1 #b100010011 #b0111011)
                arg2
                (fp #b0 #b000111010 #b0111101)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111101000 #b1111010)
                expect
                (fp #b1 #b111011000 #b0110010)))
(assert (fp.leq (fp #b1 #b111011000 #b0110010)
                expect
                (fp #b0 #b100111011 #b0110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
