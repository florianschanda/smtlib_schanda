;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111101010 #b1000110)
                arg1
                (fp #b1 #b111011000 #b0110010)))
(assert (fp.leq (fp #b1 #b111011000 #b0110010)
                arg1
                (fp #b0 #b110010011 #b0001111)))

(declare-const arg2 (_ FloatingPoint 9 8))
