(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011111110001 #b0000111010)
                expect
                (fp #b1 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000000)
                expect
                (fp #b0 #b100000000100 #b1111110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
