(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b011)
                arg1
                (fp #b1 #b10110 #b111)))
(assert (fp.leq (fp #b1 #b10110 #b111)
                arg1
                (fp #b0 #b11001 #b011)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10100 #b011)
                arg2
                (fp #b0 #b00000 #b111)))
(assert (fp.leq (fp #b0 #b00000 #b111)
                arg2
                (fp #b0 #b10010 #b000)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b100)
                expect
                (fp #b1 #b10110 #b110)))
(assert (fp.leq (fp #b1 #b10110 #b110)
                expect
                (fp #b1 #b10011 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
