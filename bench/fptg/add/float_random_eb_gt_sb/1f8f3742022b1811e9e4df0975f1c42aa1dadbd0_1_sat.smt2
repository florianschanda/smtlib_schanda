(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11101110110 #b0111101)
                arg1
                (fp #b1 #b00000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111010)
                arg1
                (fp #b0 #b01101010101 #b1101001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00101101001 #b0101000)
                expect
                (fp #b0 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000)
                expect
                (fp #b0 #b01110011010 #b1010111)))

(assert (= expect result))

(check-sat)
(exit)
