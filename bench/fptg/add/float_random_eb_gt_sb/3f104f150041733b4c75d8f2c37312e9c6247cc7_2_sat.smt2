(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111100 #b1011)
                arg1
                (fp #b1 #b01101011 #b0010)))
(assert (fp.leq (fp #b1 #b01101011 #b0010)
                arg1
                (fp #b0 #b01010100 #b1110)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11001000 #b0100)
                arg2
                (fp #b1 #b10111110 #b1111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111)
                arg2
                (fp #b0 #b11110000 #b0001)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11011100 #b0110)
                expect
                (fp #b1 #b10111111 #b0000)))
(assert (fp.leq (fp #b1 #b10111111 #b0000)
                expect
                (fp #b1 #b00111001 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
