(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101101010 #b110100)
                arg1
                (fp #b1 #b0010100010 #b001101)))
(assert (fp.leq (fp #b1 #b0010100010 #b001101)
                arg1
                (fp #b0 #b0001000111 #b111011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1110111111 #b110000)
                arg2
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg2
                (fp #b0 #b0111011010 #b101000)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010001000 #b111111)
                expect
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                expect
                (fp #b0 #b1010110101 #b110110)))

(assert (= expect result))

(check-sat)
(exit)
