(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11000110 #b110)
                arg1
                (fp #b1 #b00000001 #b000)))
(assert (fp.leq (fp #b1 #b00000001 #b000)
                arg1
                (fp #b0 #b10011111 #b101)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b01011110 #b011)
                arg2
                (fp #b0 #b11001101 #b011)))
(assert (fp.leq (fp #b0 #b11001101 #b011)
                arg2
                (fp #b0 #b11011010 #b110)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11001000 #b010)
                expect
                (fp #b0 #b11001101 #b010)))
(assert (fp.leq (fp #b0 #b11001101 #b010)
                expect
                (fp #b0 #b11100111 #b111)))

(assert (= expect result))

(check-sat)
(exit)
