(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100110110000 #b10100)
                expect
                (fp #b1 #b0111111111111 #b00101)))
(assert (fp.leq (fp #b1 #b0111111111111 #b00101)
                expect
                (fp #b1 #b0101100000001 #b11011)))

(assert (not (= expect result)))

