(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000010111 #b1)
                arg1
                (fp #b1 #b1000000000 #b1)))
(assert (fp.leq (fp #b1 #b1000000000 #b1)
                arg1
                (fp #b0 #b0000101000 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1110101100 #b1)
                arg2
                (fp #b1 #b1011111110 #b1)))
(assert (fp.leq (fp #b1 #b1011111110 #b1)
                arg2
                (fp #b0 #b1110000001 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101011100 #b1)
                expect
                (fp #b1 #b1011111111 #b0)))
(assert (fp.leq (fp #b1 #b1011111111 #b0)
                expect
                (fp #b1 #b1011000111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
