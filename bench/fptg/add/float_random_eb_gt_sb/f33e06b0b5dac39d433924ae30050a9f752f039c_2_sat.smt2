;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0101011011110111 #b0000111000110)
                arg1
                (fp #b0 #b1111111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111111111111)
                arg1
                (fp #b0 #b1111111111111111 #b0000000000000)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1011010111000010 #b1011110000010)
                arg2
                (fp #b1 #b0100000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000000000)
                arg2
                (fp #b0 #b0101010011100100 #b1000111111101)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b0 #b0111011110010100 #b0101111001110)
                expect
                (fp #b0 #b1111111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111111111111)
                expect
                (fp #b0 #b1111111111111111 #b0000000000000)))

(assert (= expect result))

(check-sat)
(exit)
