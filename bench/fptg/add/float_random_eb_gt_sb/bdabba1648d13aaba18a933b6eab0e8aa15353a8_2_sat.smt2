;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b00110111001100110 #b10)
                arg1
                (fp #b0 #b10000000000000010 #b00)))
(assert (fp.leq (fp #b0 #b10000000000000010 #b00)
                arg1
                (fp #b0 #b11111001110011000 #b00)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11000010110010010 #b11)
                arg2
                (fp #b1 #b11000001010010100 #b11)))
(assert (fp.leq (fp #b1 #b11000001010010100 #b11)
                arg2
                (fp #b0 #b00010000010110100 #b01)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11000111010111011 #b10)
                expect
                (fp #b1 #b11000001010010100 #b11)))
(assert (fp.leq (fp #b1 #b11000001010010100 #b11)
                expect
                (fp #b1 #b10001011100011011 #b10)))

(assert (= expect result))

(check-sat)
(exit)
