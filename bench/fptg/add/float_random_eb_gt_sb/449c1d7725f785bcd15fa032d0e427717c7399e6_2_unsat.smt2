(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11100001 #b111111)
                arg1
                (fp #b1 #b00111101 #b000000)))
(assert (fp.leq (fp #b1 #b00111101 #b000000)
                arg1
                (fp #b1 #b00011111 #b001000)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10110110 #b100100)
                arg2
                (fp #b0 #b00000000 #b000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000001)
                arg2
                (fp #b0 #b01111111 #b111010)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10001111 #b111010)
                expect
                (fp #b1 #b00111101 #b000000)))
(assert (fp.leq (fp #b1 #b00111101 #b000000)
                expect
                (fp #b1 #b00101100 #b110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
