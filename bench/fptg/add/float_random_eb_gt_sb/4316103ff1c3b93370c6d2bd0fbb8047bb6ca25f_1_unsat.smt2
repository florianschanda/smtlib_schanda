(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b001010 #b111)
                arg1
                (fp #b1 #b000000 #b110)))
(assert (fp.leq (fp #b1 #b000000 #b110)
                arg1
                (fp #b0 #b101001 #b011)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
