(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011010011 #b0111)
                arg1
                (fp #b0 #b011111111 #b0000)))
(assert (fp.leq (fp #b0 #b011111111 #b0000)
                arg1
                (fp #b0 #b111000010 #b0101)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100010100 #b1110)
                arg2
                (fp #b1 #b001111110 #b0000)))
(assert (fp.leq (fp #b1 #b001111110 #b0000)
                arg2
                (fp #b0 #b111101001 #b0000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111101001 #b0011)
                expect
                (fp #b0 #b011111110 #b1111)))
(assert (fp.leq (fp #b0 #b011111110 #b1111)
                expect
                (fp #b0 #b110010110 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
