(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0111010 #b1001)
                arg1
                (fp #b0 #b0000001 #b0000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000)
                arg1
                (fp #b0 #b1001000 #b1100)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000101 #b0010)
                arg2
                (fp #b0 #b0010001 #b0010)))
(assert (fp.leq (fp #b0 #b0010001 #b0010)
                arg2
                (fp #b0 #b1000011 #b1000)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0011000 #b1100)
                expect
                (fp #b0 #b0010001 #b0011)))
(assert (fp.leq (fp #b0 #b0010001 #b0011)
                expect
                (fp #b0 #b0111001 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
