(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0101111 #b01)
                arg1
                (fp #b0 #b1000001 #b10)))
(assert (fp.leq (fp #b0 #b1000001 #b10)
                arg1
                (fp #b0 #b1001000 #b01)))

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1000000 #b10)
                arg2
                (fp #b1 #b0101001 #b00)))
(assert (fp.leq (fp #b1 #b0101001 #b00)
                arg2
                (fp #b0 #b0101011 #b00)))

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0100101 #b01)
                expect
                (fp #b0 #b1000001 #b10)))
(assert (fp.leq (fp #b0 #b1000001 #b10)
                expect
                (fp #b0 #b1010111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
