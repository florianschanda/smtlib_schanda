;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10000100101000100 #b1110)
                arg1
                (fp #b0 #b00000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0100)
                arg1
                (fp #b0 #b10111101000100011 #b0110)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10110010011110110 #b0010)
                arg2
                (fp #b1 #b10000001110010010 #b1111)))
(assert (fp.leq (fp #b1 #b10000001110010010 #b1111)
                arg2
                (fp #b0 #b01110100011100110 #b0100)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10000111100011010 #b0100)
                expect
                (fp #b1 #b10000001110010010 #b1111)))
(assert (fp.leq (fp #b1 #b10000001110010010 #b1111)
                expect
                (fp #b0 #b01001101110001011 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
