(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110000 #b10010)
                arg1
                (fp #b0 #b0110000 #b01100)))
(assert (fp.leq (fp #b0 #b0110000 #b01100)
                arg1
                (fp #b0 #b1100101 #b10010)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0011010 #b01100)
                arg2
                (fp #b0 #b1010101 #b01011)))
(assert (fp.leq (fp #b0 #b1010101 #b01011)
                arg2
                (fp #b0 #b1010111 #b00011)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101100 #b11100)
                expect
                (fp #b0 #b1010101 #b01011)))
(assert (fp.leq (fp #b0 #b1010101 #b01011)
                expect
                (fp #b0 #b1101111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
