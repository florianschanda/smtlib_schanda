;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111010 #b1011)
                arg1
                (fp #b0 #b011111 #b0000)))
(assert (fp.leq (fp #b0 #b011111 #b0000)
                arg1
                (fp #b0 #b110101 #b1110)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001101 #b1100)
                arg2
                (fp #b1 #b000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000 #b0001)
                arg2
                (fp #b0 #b101111 #b0111)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001111 #b0011)
                expect
                (fp #b0 #b011111 #b0000)))
(assert (fp.leq (fp #b0 #b011111 #b0000)
                expect
                (fp #b0 #b110000 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
