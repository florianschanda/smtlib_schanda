(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00100100111 #b0000)
                arg1
                (fp #b0 #b01111111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111111 #b0110)
                arg1
                (fp #b0 #b11010110000 #b0000)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11000110011 #b0111)
                arg2
                (fp #b0 #b00000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001)
                arg2
                (fp #b0 #b10101010111 #b0111)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b00011110010 #b1100)
                expect
                (fp #b0 #b01111111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111111 #b0110)
                expect
                (fp #b0 #b11100100000 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
