(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10001111 #b01011)
                arg1
                (fp #b0 #b01101101 #b11001)))
(assert (fp.leq (fp #b0 #b01101101 #b11001)
                arg1
                (fp #b0 #b11110100 #b11010)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11101000 #b01111)
                arg2
                (fp #b1 #b00000000 #b01000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000)
                arg2
                (fp #b0 #b00011111 #b01101)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b00100010 #b10101)
                expect
                (fp #b0 #b01101101 #b11000)))
(assert (fp.leq (fp #b0 #b01101101 #b11000)
                expect
                (fp #b0 #b11000010 #b00100)))

(assert (= expect result))

(check-sat)
(exit)
