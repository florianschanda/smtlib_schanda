(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1101010100111000 #b111110)
                arg1
                (fp #b0 #b0000000000000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111111)
                arg1
                (fp #b0 #b1001110001011011 #b100111)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0101100111110011 #b001000)
                arg2
                (fp #b0 #b0111111111111111 #b111101)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b111101)
                arg2
                (fp #b0 #b1101000111100011 #b100011)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1101101110110110 #b001100)
                expect
                (fp #b0 #b0111111111111111 #b111101)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b111101)
                expect
                (fp #b0 #b1001110100011000 #b000111)))

(assert (= expect result))

(check-sat)
(exit)
