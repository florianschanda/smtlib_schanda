(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10000 #b10)
                arg1
                (fp #b0 #b10100 #b11)))
(assert (fp.leq (fp #b0 #b10100 #b11)
                arg1
                (fp #b0 #b11101 #b01)))

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11010 #b11)
                arg2
                (fp #b1 #b01111 #b11)))
(assert (fp.leq (fp #b1 #b01111 #b11)
                arg2
                (fp #b0 #b01100 #b10)))

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01000 #b11)
                expect
                (fp #b0 #b10100 #b10)))
(assert (fp.leq (fp #b0 #b10100 #b10)
                expect
                (fp #b0 #b11010 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
