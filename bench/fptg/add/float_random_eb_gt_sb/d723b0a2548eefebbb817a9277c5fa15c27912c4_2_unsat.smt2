(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b0000)
                arg1
                (fp #b1 #b000000 #b0011)))
(assert (fp.leq (fp #b1 #b000000 #b0011)
                arg1
                (fp #b0 #b001100 #b0110)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b101000 #b1011)
                arg2
                (fp #b0 #b101110 #b1111)))
(assert (fp.leq (fp #b0 #b101110 #b1111)
                arg2
                (fp #b0 #b110010 #b1000)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b010111 #b0111)
                expect
                (fp #b0 #b101110 #b1111)))
(assert (fp.leq (fp #b0 #b101110 #b1111)
                expect
                (fp #b0 #b110011 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
