(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg1
                (fp #b0 #b110 #b0)))
(assert (fp.leq (fp #b0 #b110 #b0)
                arg1
                (fp #b0 #b110 #b1)))

(declare-const arg2 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg2
                (fp #b1 #b010 #b0)))
(assert (fp.leq (fp #b1 #b010 #b0)
                arg2
                (fp #b1 #b000 #b1)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b010 #b0)
                expect
                (fp #b0 #b110 #b0)))
(assert (fp.leq (fp #b0 #b110 #b0)
                expect
                (fp #b0 #b111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
