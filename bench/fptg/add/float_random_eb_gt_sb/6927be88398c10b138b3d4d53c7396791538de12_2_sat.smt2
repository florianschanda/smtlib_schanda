                arg2
                (fp #b1 #b011111111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b0000000000)
                arg2
                (fp #b0 #b110110110000000 #b1010001000)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b0 #b011011010100000 #b1110101000)
                expect
                (fp #b0 #b111111111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111111)
                expect
                (fp #b0 #b111111111111111 #b0000000000)))

(assert (= expect result))

(check-sat)
(exit)
