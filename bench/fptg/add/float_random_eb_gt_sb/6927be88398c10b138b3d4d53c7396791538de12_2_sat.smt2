(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b001111011010010 #b1111101010)
                arg1
                (fp #b0 #b111111111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111111)
                arg1
                (fp #b0 #b111111111111111 #b0000000000)))

(declare-const arg2 (_ FloatingPoint 15 11))
