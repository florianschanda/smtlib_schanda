; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b000111010000101 #b11000010)
                arg1
                (fp #b0 #b111110100110111 #b10110000)))
(assert (fp.leq (fp #b0 #b111110100110111 #b10110000)
                arg1
                (fp #b0 #b111110110110001 #b10100110)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101100111010111 #b00101001)
                arg2
                (fp #b0 #b000000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01000000)
                arg2
                (fp #b0 #b101010110011010 #b01011101)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b101110000000100 #b11011110)
                expect
                (fp #b0 #b111110100110111 #b10110000)))
(assert (fp.leq (fp #b0 #b111110100110111 #b10110000)
                expect
                (fp #b0 #b111111000010000 #b10101110)))

(assert (= expect result))

(check-sat)
(exit)
