                arg2
                (fp #b0 #b1000111110 #b00001)))
(assert (fp.leq (fp #b0 #b1000111110 #b00001)
                arg2
                (fp #b0 #b1011001100 #b11010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b1011111110 #b01101)
                expect
                (fp #b0 #b1111111101 #b00001)))
(assert (fp.leq (fp #b0 #b1111111101 #b00001)
                expect
                (fp #b0 #b1111111110 #b11111)))

(assert (not (= expect result)))

(check-sat)
(exit)
