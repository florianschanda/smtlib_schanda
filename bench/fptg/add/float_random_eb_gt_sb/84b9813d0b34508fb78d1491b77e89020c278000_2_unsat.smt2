; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111011 #b1101)
                arg1
                (fp #b1 #b110100 #b0000)))
(assert (fp.leq (fp #b1 #b110100 #b0000)
                arg1
                (fp #b1 #b010001 #b0100)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000001 #b0010)
                arg2
                (fp #b1 #b000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000 #b0001)
                arg2
                (fp #b0 #b101010 #b0111)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111000 #b0000)
                expect
                (fp #b1 #b110100 #b0001)))
(assert (fp.leq (fp #b1 #b110100 #b0001)
                expect
                (fp #b0 #b101101 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
