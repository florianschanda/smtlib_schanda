(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b101001011001001 #b1111)
                arg1
                (fp #b1 #b000000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0100)
                arg1
                (fp #b0 #b011110000010001 #b0011)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b001001101010011 #b0011)
                arg2
                (fp #b0 #b000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0100)
                arg2
                (fp #b0 #b011110101110111 #b1110)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100111010100110 #b1101)
                expect
                (fp #b0 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000)
                expect
                (fp #b0 #b001010111011101 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
