(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100111111 #b011)
                arg1
                (fp #b1 #b0010100101 #b000)))
(assert (fp.leq (fp #b1 #b0010100101 #b000)
                arg1
                (fp #b0 #b1111111110 #b100)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010110001 #b100)
                arg2
                (fp #b1 #b1001100110 #b111)))
(assert (fp.leq (fp #b1 #b1001100110 #b111)
                arg2
                (fp #b0 #b1000011001 #b101)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1011001100 #b001)
                expect
                (fp #b1 #b1001100111 #b000)))
(assert (fp.leq (fp #b1 #b1001100111 #b000)
                expect
                (fp #b0 #b1010100000 #b000)))

(assert (= expect result))

(check-sat)
(exit)
