                expect
                (fp #b0 #b1101111001010100 #b11001101000)))
(assert (fp.leq (fp #b0 #b1101111001010100 #b11001101000)
                expect
                (fp #b0 #b1101111011110011 #b00010011111)))

(assert (= expect result))

