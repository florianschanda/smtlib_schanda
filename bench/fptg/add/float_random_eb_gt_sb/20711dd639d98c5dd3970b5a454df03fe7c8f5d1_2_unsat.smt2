; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1101011000001 #b01101)
                arg1
                (fp #b0 #b0000000000000 #b11111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b11111)
                arg1
                (fp #b0 #b0111001100111 #b00010)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1001110001100 #b01101)
                arg2
                (fp #b1 #b0111111111111 #b00110)))
(assert (fp.leq (fp #b1 #b0111111111111 #b00110)
                arg2
                (fp #b0 #b1010101101000 #b00111)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1010111100011 #b01011)
                expect
                (fp #b1 #b0111111111111 #b00110)))
(assert (fp.leq (fp #b1 #b0111111111111 #b00110)
                expect
                (fp #b1 #b0101111010001 #b00011)))

(assert (not (= expect result)))

(check-sat)
(exit)
