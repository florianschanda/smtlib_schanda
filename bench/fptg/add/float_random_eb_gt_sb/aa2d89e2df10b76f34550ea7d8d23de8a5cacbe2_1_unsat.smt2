(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b1 #b000111111 #b0101000)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110010110 #b1110100)
                expect
                (fp #b1 #b101111110 #b1111111)))
(assert (fp.leq (fp #b1 #b101111110 #b1111111)
                expect
                (fp #b1 #b100010000 #b1110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
