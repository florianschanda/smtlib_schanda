                arg2
                (fp #b0 #b00000000 #b111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111)
                arg2
                (fp #b0 #b10100111 #b111011)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10010110 #b111011)
                expect
                (fp #b0 #b00000000 #b101111)))
(assert (fp.leq (fp #b0 #b00000000 #b101111)
                expect
                (fp #b0 #b10010000 #b100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
