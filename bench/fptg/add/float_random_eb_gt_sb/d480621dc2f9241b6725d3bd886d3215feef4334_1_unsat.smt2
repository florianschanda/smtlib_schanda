(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b100110011 #b0)
                arg1
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                arg1
                (fp #b0 #b001000001 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111111110 #b1)
                arg2
                (fp #b1 #b010000000 #b0)))
(assert (fp.leq (fp #b1 #b010000000 #b0)
                arg2
                (fp #b0 #b011001010 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b011101110 #b1)
                expect
                (fp #b1 #b001111111 #b1)))
(assert (fp.leq (fp #b1 #b001111111 #b1)
                expect
                (fp #b0 #b000111100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
