(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00000011011011 #b011)
                arg1
                (fp #b0 #b01111111111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b000)
                arg1
                (fp #b0 #b11011001011101 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00010010100101 #b101)
                arg2
                (fp #b0 #b10000000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000000011 #b000)
                arg2
                (fp #b0 #b11000001111001 #b101)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00010010100100 #b011)
                expect
                (fp #b0 #b10000000000011 #b001)))
(assert (fp.leq (fp #b0 #b10000000000011 #b001)
                expect
                (fp #b0 #b11101101011000 #b101)))

(assert (= expect result))

(check-sat)
(exit)
