(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010010 #b000)
                arg1
                (fp #b1 #b000000 #b111)))
(assert (fp.leq (fp #b1 #b000000 #b111)
                arg1
                (fp #b0 #b010000 #b010)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110100 #b010)
                arg2
                (fp #b0 #b011111 #b110)))
(assert (fp.leq (fp #b0 #b011111 #b110)
                arg2
                (fp #b0 #b100110 #b011)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b011010 #b100)
                expect
                (fp #b0 #b011111 #b101)))
(assert (fp.leq (fp #b0 #b011111 #b101)
                expect
                (fp #b0 #b110001 #b111)))

(assert (= expect result))

(check-sat)
(exit)
