(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10101111 #b000)
                arg1
                (fp #b1 #b01111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111 #b000)
                arg1
                (fp #b0 #b11111011 #b100)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110100 #b011)
                arg2
                (fp #b1 #b00000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000 #b010)
                arg2
                (fp #b0 #b11011011 #b110)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10001100 #b100)
                expect
                (fp #b1 #b01111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111 #b000)
                expect
                (fp #b0 #b00101000 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
