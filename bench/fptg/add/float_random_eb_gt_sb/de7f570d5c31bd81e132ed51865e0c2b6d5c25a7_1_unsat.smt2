(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001101010 #b110)
                arg1
                (fp #b1 #b000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000 #b010)
                arg1
                (fp #b0 #b001101011 #b101)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011110100 #b100)
                arg2
                (fp #b1 #b010110110 #b011)))
(assert (fp.leq (fp #b1 #b010110110 #b011)
                arg2
                (fp #b0 #b100101000 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011110110 #b011)
                expect
                (fp #b1 #b010110110 #b011)))
(assert (fp.leq (fp #b1 #b010110110 #b011)
                expect
                (fp #b0 #b101000001 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
