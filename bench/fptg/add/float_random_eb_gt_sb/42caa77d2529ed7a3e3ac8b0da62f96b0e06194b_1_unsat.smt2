(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10101010100110101 #b011)
                arg1
                (fp #b1 #b00000000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b001)
                arg1
                (fp #b0 #b01110001001011101 #b010)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01100000100000010 #b001)
                arg2
                (fp #b0 #b01111111111111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b000)
                arg2
                (fp #b0 #b11111110101111000 #b110)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01100110110100011 #b010)
                expect
                (fp #b0 #b01111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b01111111111111110 #b111)
                expect
                (fp #b0 #b10110100001100101 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
