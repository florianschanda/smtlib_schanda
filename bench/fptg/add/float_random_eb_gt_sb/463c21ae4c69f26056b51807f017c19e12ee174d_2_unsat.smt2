; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011011 #b0100)
                arg1
                (fp #b1 #b0100000 #b0000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000)
                arg1
                (fp #b1 #b0010100 #b1111)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1010101 #b0110)
                arg2
                (fp #b0 #b1000001 #b1000)))
(assert (fp.leq (fp #b0 #b1000001 #b1000)
                arg2
                (fp #b0 #b1000010 #b1010)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000010 #b1011)
                expect
                (fp #b0 #b1000001 #b1000)))
(assert (fp.leq (fp #b0 #b1000001 #b1000)
                expect
                (fp #b0 #b1100100 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
