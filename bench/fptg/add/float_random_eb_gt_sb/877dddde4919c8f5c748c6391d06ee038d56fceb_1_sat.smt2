(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b100101100111 #b1)
                arg1
                (fp #b0 #b111111000110 #b0)))
(assert (fp.leq (fp #b0 #b111111000110 #b0)
                arg1
                (fp #b0 #b111111010001 #b1)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b110100110011 #b0)
                arg2
                (fp #b0 #b000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000 #b1)
                arg2
                (fp #b0 #b100001001011 #b1)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b000100101001 #b1)
                expect
                (fp #b0 #b111111000110 #b0)))
(assert (fp.leq (fp #b0 #b111111000110 #b0)
                expect
                (fp #b0 #b111111001101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
