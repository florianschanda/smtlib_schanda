                arg2
                (fp #b1 #b001110010011111 #b110)))
(assert (fp.leq (fp #b1 #b001110010011111 #b110)
                arg2
                (fp #b1 #b001100010101110 #b011)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111001010111111 #b010)
                expect
                (fp #b1 #b100000000000010 #b110)))
(assert (fp.leq (fp #b1 #b100000000000010 #b110)
                expect
                (fp #b1 #b011100010101100 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
