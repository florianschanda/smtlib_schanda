(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101000 #b00010)
                arg1
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg1
                (fp #b0 #b0110000 #b00110)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0100111 #b10110)
                arg2
                (fp #b0 #b0000001 #b00000)))
(assert (fp.leq (fp #b0 #b0000001 #b00000)
                arg2
                (fp #b0 #b0100101 #b00110)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111000 #b01101)
                expect
                (fp #b1 #b1000100 #b11111)))
(assert (fp.leq (fp #b1 #b1000100 #b11111)
                expect
                (fp #b0 #b0001101 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
