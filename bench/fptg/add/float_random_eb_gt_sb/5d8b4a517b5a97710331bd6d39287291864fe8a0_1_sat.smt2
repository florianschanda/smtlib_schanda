(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0101111 #b11100)
                arg1
                (fp #b0 #b1000001 #b00000)))
(assert (fp.leq (fp #b0 #b1000001 #b00000)
                arg1
                (fp #b0 #b1111101 #b10000)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0100011 #b10011)
                arg2
                (fp #b0 #b1111101 #b00010)))
(assert (fp.leq (fp #b0 #b1111101 #b00010)
                arg2
                (fp #b0 #b1111101 #b01111)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0111111 #b01110)
                expect
                (fp #b0 #b1111101 #b00010)))
(assert (fp.leq (fp #b0 #b1111101 #b00010)
                expect
                (fp #b0 #b1111101 #b11110)))

(assert (= expect result))

(check-sat)
(exit)
