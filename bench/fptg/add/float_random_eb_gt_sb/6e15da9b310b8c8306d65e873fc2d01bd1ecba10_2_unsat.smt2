(assert (fp.leq (fp #b0 #b1001110110010110 #b11011011000)
                arg2
                (fp #b0 #b1011101100111000 #b11101011100)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0100110101110101 #b10101101100)
                expect
                (fp #b0 #b1001110110010110 #b11011011000)))
(assert (fp.leq (fp #b0 #b1001110110010110 #b11011011000)
                expect
                (fp #b0 #b1011000000001100 #b01101100000)))

(assert (not (= expect result)))

(check-sat)
