(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111111000 #b101)
                arg1
                (fp #b1 #b11001110101 #b010)))
(assert (fp.leq (fp #b1 #b11001110101 #b010)
                arg1
                (fp #b1 #b00110110010 #b001)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b01110010001 #b000)
                arg2
                (fp #b0 #b01111111111 #b110)))
(assert (fp.leq (fp #b0 #b01111111111 #b110)
                arg2
                (fp #b0 #b11011110101 #b101)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11100100101 #b010)
                expect
                (fp #b1 #b11001110101 #b010)))
(assert (fp.leq (fp #b1 #b11001110101 #b010)
                expect
                (fp #b0 #b10101101100 #b001)))

(assert (= expect result))

(check-sat)
(exit)
