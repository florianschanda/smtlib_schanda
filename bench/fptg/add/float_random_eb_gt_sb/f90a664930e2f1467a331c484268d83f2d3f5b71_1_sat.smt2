(assert (fp.leq (fp #b0 #b1101101000000001 #b01011001011)
                arg2
                (fp #b0 #b1111100011010000 #b11010010100)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0111100000011110 #b01001101101)
                expect
                (fp #b0 #b1101101000000001 #b01011001010)))
(assert (fp.leq (fp #b0 #b1101101000000001 #b01011001010)
                expect
                (fp #b0 #b1111010000010101 #b00111111111)))

(assert (= expect result))

(check-sat)
(exit)
