(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111001 #b111000)
                arg1
                (fp #b1 #b11111000 #b001101)))
(assert (fp.leq (fp #b1 #b11111000 #b001101)
                arg1
                (fp #b1 #b00001100 #b000111)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00101100 #b101100)
                arg2
                (fp #b1 #b00000001 #b000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000)
                arg2
                (fp #b0 #b10111101 #b110101)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111011 #b111110)
                expect
                (fp #b1 #b11111000 #b001110)))
(assert (fp.leq (fp #b1 #b11111000 #b001110)
                expect
                (fp #b0 #b01010001 #b100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
