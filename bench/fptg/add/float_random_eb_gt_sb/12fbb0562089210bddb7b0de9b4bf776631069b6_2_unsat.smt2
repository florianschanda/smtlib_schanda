(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b010)
                arg1
                (fp #b0 #b010011 #b100)))
(assert (fp.leq (fp #b0 #b010011 #b100)
                arg1
                (fp #b0 #b111001 #b100)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010000 #b000)
                arg2
                (fp #b0 #b011111 #b000)))
(assert (fp.leq (fp #b0 #b011111 #b000)
                arg2
                (fp #b0 #b101110 #b001)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000010 #b100)
                expect
                (fp #b0 #b011111 #b001)))
(assert (fp.leq (fp #b0 #b011111 #b001)
                expect
                (fp #b0 #b111011 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
