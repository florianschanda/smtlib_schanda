(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b100000 #b00)
                arg1
                (fp #b1 #b000000 #b00)))
(assert (fp.leq (fp #b1 #b000000 #b00)
                arg1
                (fp #b0 #b010001 #b11)))

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b001110 #b11)
                arg2
                (fp #b0 #b001111 #b00)))
(assert (fp.leq (fp #b0 #b001111 #b00)
                arg2
                (fp #b0 #b011111 #b00)))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000011 #b10)
                expect
                (fp #b0 #b001111 #b00)))
(assert (fp.leq (fp #b0 #b001111 #b00)
                expect
                (fp #b0 #b101000 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
