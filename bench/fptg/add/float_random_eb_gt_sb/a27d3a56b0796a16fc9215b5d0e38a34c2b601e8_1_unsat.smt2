(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0011010101 #b11000)
                arg1
                (fp #b0 #b0100000000 #b00000)))
(assert (fp.leq (fp #b0 #b0100000000 #b00000)
                arg1
                (fp #b0 #b1101110111 #b10111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101011010 #b10111)
                arg2
                (fp #b0 #b1111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                arg2
                (fp #b0 #b1111111101 #b01010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110100110 #b01100)
                expect
                (fp #b0 #b1111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                expect
                (fp #b0 #b1111111110 #b11010)))

(assert (not (= expect result)))

(check-sat)
(exit)
