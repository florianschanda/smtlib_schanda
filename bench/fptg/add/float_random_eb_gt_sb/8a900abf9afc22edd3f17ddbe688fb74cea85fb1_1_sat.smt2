(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010011000111 #b11100)
                arg1
                (fp #b1 #b000000000001 #b00000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000)
                arg1
                (fp #b0 #b001111011011 #b01011)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100110000000 #b10010)
                arg2
                (fp #b1 #b011111111111 #b00000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000)
                arg2
                (fp #b1 #b010001011111 #b10010)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111101011 #b10000)
                expect
                (fp #b1 #b011111111111 #b00000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000)
                expect
                (fp #b0 #b011001110110 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
