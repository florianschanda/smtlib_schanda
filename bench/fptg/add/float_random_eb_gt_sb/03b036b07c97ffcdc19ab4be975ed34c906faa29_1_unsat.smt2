(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100011001 #b001)
                arg1
                (fp #b0 #b0000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000 #b010)
                arg1
                (fp #b0 #b0111100000 #b011)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0000010000 #b001)
                arg2
                (fp #b0 #b1111111100 #b101)))
(assert (fp.leq (fp #b0 #b1111111100 #b101)
                arg2
                (fp #b0 #b1111111110 #b100)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0110001001 #b111)
                expect
                (fp #b0 #b1111111100 #b101)))
(assert (fp.leq (fp #b0 #b1111111100 #b101)
                expect
                (fp #b0 #b1111111101 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
