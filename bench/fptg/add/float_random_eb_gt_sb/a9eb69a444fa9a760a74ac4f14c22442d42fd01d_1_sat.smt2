; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1001010000110011 #b00111001111)
                arg1
                (fp #b0 #b0101000010011101 #b00100110100)))
(assert (fp.leq (fp #b0 #b0101000010011101 #b00100110100)
                arg1
                (fp #b0 #b0110001001101010 #b01101101101)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1011111100001110 #b11101100110)
                arg2
                (fp #b0 #b0000000000000000 #b01000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000000000)
                arg2
                (fp #b0 #b1110101101000101 #b10111001001)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0011010010110011 #b01010010101)
                expect
                (fp #b0 #b0101000010011101 #b00100110100)))
(assert (fp.leq (fp #b0 #b0101000010011101 #b00100110100)
                expect
                (fp #b0 #b1101111000110011 #b11111001010)))

(assert (= expect result))

(check-sat)
(exit)
