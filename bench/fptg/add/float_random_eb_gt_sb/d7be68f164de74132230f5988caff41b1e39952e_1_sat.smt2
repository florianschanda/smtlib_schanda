(assert (fp.leq (fp #b0 #b0111111111111 #b00)
                arg2
                (fp #b0 #b1110011100011 #b01)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0011101111010 #b00)
                expect
                (fp #b0 #b1110011111010 #b00)))
(assert (fp.leq (fp #b0 #b1110011111010 #b00)
                expect
                (fp #b0 #b1111110001010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
