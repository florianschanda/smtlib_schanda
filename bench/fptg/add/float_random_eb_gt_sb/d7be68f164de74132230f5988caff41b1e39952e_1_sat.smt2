;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0110010100011 #b00)
