(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0110101 #b0010)
                arg1
                (fp #b0 #b0010001 #b0000)))
(assert (fp.leq (fp #b0 #b0010001 #b0000)
                arg1
                (fp #b0 #b0010100 #b0010)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0001010 #b0000)
                arg2
                (fp #b0 #b0011110 #b0000)))
(assert (fp.leq (fp #b0 #b0011110 #b0000)
                arg2
                (fp #b0 #b1100100 #b1011)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0010101 #b1000)
                expect
                (fp #b0 #b0011110 #b0001)))
(assert (fp.leq (fp #b0 #b0011110 #b0001)
                expect
                (fp #b0 #b1000101 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
