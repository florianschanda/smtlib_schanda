;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b01000011010111 #b0)
                arg1
                (fp #b0 #b00000000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1)
                arg1
                (fp #b0 #b10110010011011 #b1)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11110101011010 #b1)
                arg2
                (fp #b1 #b11100011100011 #b1)))
(assert (fp.leq (fp #b1 #b11100011100011 #b1)
                arg2
                (fp #b1 #b10100100001111 #b1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11100101000011 #b1)
                expect
                (fp #b1 #b11100011100011 #b1)))
(assert (fp.leq (fp #b1 #b11100011100011 #b1)
                expect
                (fp #b1 #b00010110000101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
