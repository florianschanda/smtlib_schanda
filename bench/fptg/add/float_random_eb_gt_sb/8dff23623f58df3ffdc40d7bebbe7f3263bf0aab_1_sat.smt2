(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000001 #b11)
                arg1
                (fp #b0 #b100011 #b10)))
(assert (fp.leq (fp #b0 #b100011 #b10)
                arg1
                (fp #b0 #b100011 #b11)))

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101001 #b11)
                expect
                (fp #b0 #b000000 #b00)))
(assert (fp.leq (fp #b0 #b000000 #b00)
                expect
                (fp #b0 #b010100 #b10)))

(assert (= expect result))

(check-sat)
(exit)
