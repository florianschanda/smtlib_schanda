(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1101101101111 #b1111000)
                arg1
                (fp #b1 #b0000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1111010)
                arg1
                (fp #b0 #b1111000001101 #b1101111)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1000000101101 #b1111011)
                expect
                (fp #b0 #b0000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0000000)
                expect
                (fp #b0 #b0001010101110 #b1101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
