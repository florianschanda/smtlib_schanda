(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00011110 #b0111)
                arg1
                (fp #b1 #b00000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000 #b0100)
                arg1
                (fp #b0 #b11000111 #b0001)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10110000 #b0010)
                arg2
                (fp #b0 #b00111110 #b0000)))
(assert (fp.leq (fp #b0 #b00111110 #b0000)
                arg2
                (fp #b0 #b10010011 #b1101)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00110111 #b0011)
                expect
                (fp #b0 #b00111110 #b0000)))
(assert (fp.leq (fp #b0 #b00111110 #b0000)
                expect
                (fp #b0 #b10010000 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
