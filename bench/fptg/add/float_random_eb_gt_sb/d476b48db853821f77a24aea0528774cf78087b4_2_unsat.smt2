                (fp #b0 #b11001011100010 #b111)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b01001111100011 #b111)
                arg2
                (fp #b0 #b10111111111110 #b111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b111)
                arg2
                (fp #b0 #b11000001010110 #b011)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00101111110101 #b111)
                expect
                (fp #b0 #b10111111111111 #b000)))
(assert (fp.leq (fp #b0 #b10111111111111 #b000)
                expect
                (fp #b0 #b11110110111110 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
