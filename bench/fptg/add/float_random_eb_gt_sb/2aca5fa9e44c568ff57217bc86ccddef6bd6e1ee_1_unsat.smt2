(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0001000000111111 #b01110110111)
                arg1
                (fp #b0 #b0111111111111111 #b10010001101)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b10010001101)
                arg1
                (fp #b0 #b1101110111110010 #b01100111001)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
