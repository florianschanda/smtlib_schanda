(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110110 #b0010)
                arg1
                (fp #b1 #b000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg1
                (fp #b0 #b011100 #b1001)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b0111)
                arg2
                (fp #b0 #b000000 #b1110)))
(assert (fp.leq (fp #b0 #b000000 #b1110)
                arg2
                (fp #b0 #b101100 #b1011)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100110 #b0011)
                expect
                (fp #b0 #b000000 #b1010)))
(assert (fp.leq (fp #b0 #b000000 #b1010)
                expect
                (fp #b0 #b101011 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
