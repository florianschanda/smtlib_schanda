(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0000101000 #b101)
                arg1
                (fp #b0 #b0111101000 #b011)))
(assert (fp.leq (fp #b0 #b0111101000 #b011)
                arg1
                (fp #b0 #b0111110011 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0100100100 #b001)
                arg2
                (fp #b0 #b1000000001 #b000)))
(assert (fp.leq (fp #b0 #b1000000001 #b000)
                arg2
                (fp #b0 #b1100010011 #b110)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0010111011 #b101)
                expect
                (fp #b0 #b1000000001 #b001)))
(assert (fp.leq (fp #b0 #b1000000001 #b001)
                expect
                (fp #b0 #b1010111110 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
