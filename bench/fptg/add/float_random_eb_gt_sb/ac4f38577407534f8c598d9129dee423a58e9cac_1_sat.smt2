(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00001001010 #b01101)
                arg1
                (fp #b0 #b10111111110 #b11111)))
(assert (fp.leq (fp #b0 #b10111111110 #b11111)
                arg1
                (fp #b0 #b11101000010 #b01101)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b10100011010 #b10000)
                arg2
                (fp #b0 #b11111100101 #b10100)))
(assert (fp.leq (fp #b0 #b11111100101 #b10100)
                arg2
                (fp #b0 #b11111100111 #b11000)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00011001011 #b10010)
                expect
                (fp #b0 #b11111100101 #b10100)))
(assert (fp.leq (fp #b0 #b11111100101 #b10100)
                expect
                (fp #b0 #b11111101011 #b01010)))

(assert (= expect result))

(check-sat)
(exit)
