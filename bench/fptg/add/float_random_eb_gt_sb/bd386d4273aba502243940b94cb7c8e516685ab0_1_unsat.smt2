(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110010110 #b00110)
                arg1
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                arg1
                (fp #b0 #b011010001 #b11010)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110010101 #b01010)
                arg2
                (fp #b1 #b010010000 #b00100)))
(assert (fp.leq (fp #b1 #b010010000 #b00100)
                arg2
                (fp #b0 #b000001000 #b00111)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011011101 #b01010)
                expect
                (fp #b1 #b010010000 #b00100)))
(assert (fp.leq (fp #b1 #b010010000 #b00100)
                expect
                (fp #b0 #b011101001 #b11011)))

(assert (not (= expect result)))

(check-sat)
(exit)
