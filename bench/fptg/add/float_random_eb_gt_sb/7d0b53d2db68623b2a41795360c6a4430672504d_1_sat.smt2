(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111010110 #b111)
                arg1
                (fp #b1 #b101111110 #b111)))
(assert (fp.leq (fp #b1 #b101111110 #b111)
                arg1
                (fp #b0 #b111111100 #b110)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                arg2
                (fp #b1 #b111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111101 #b000)
                arg2
                (fp #b0 #b111101110 #b100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111101 #b100)
                expect
                (fp #b1 #b111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111101 #b000)
                expect
                (fp #b1 #b000001101 #b111)))

(assert (= expect result))

(check-sat)
(exit)
