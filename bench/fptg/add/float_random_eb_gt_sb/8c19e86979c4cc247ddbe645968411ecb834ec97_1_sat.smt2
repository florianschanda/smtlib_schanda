(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111100010 #b110)
                arg1
                (fp #b1 #b011111111 #b100)))
(assert (fp.leq (fp #b1 #b011111111 #b100)
                arg1
                (fp #b0 #b010101111 #b010)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011100011 #b010)
                arg2
                (fp #b0 #b010000000 #b000)))
(assert (fp.leq (fp #b0 #b010000000 #b000)
                arg2
                (fp #b0 #b010010011 #b100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101101101 #b011)
                expect
                (fp #b1 #b011111111 #b011)))
(assert (fp.leq (fp #b1 #b011111111 #b011)
                expect
                (fp #b0 #b010001100 #b010)))

(assert (= expect result))

(check-sat)
(exit)
