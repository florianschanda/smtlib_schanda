; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111101010010000 #b11110100000)
                arg1
                (fp #b1 #b1111101000000111 #b11010011101)))
(assert (fp.leq (fp #b1 #b1111101000000111 #b11010011101)
                arg1
                (fp #b0 #b1110100101001110 #b10001110010)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0001011001100110 #b00110001011)
                expect
                (fp #b1 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000)
                expect
                (fp #b0 #b1111110000000000 #b01101100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
