(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10111 #b100)
                arg1
                (fp #b0 #b01000 #b000)))
(assert (fp.leq (fp #b0 #b01000 #b000)
                arg1
                (fp #b0 #b01011 #b110)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b010)
                arg2
                (fp #b1 #b00000 #b101)))
(assert (fp.leq (fp #b1 #b00000 #b101)
                arg2
                (fp #b0 #b10001 #b010)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01100 #b001)
                expect
                (fp #b0 #b01000 #b000)))
(assert (fp.leq (fp #b0 #b01000 #b000)
                expect
                (fp #b0 #b01101 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
