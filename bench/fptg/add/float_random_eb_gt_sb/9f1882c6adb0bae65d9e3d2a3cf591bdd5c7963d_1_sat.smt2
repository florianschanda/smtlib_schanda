(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10011111110 #b1110011)
                arg1
                (fp #b1 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000)
                arg1
                (fp #b0 #b10100100011 #b1010111)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111010111 #b1100101)
                arg2
                (fp #b1 #b11011010100 #b1000001)))
(assert (fp.leq (fp #b1 #b11011010100 #b1000001)
                arg2
                (fp #b0 #b11011110001 #b0101111)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11100110100 #b1110111)
                expect
                (fp #b1 #b11011010100 #b1000001)))
(assert (fp.leq (fp #b1 #b11011010100 #b1000001)
                expect
                (fp #b1 #b10010101000 #b1101001)))

(assert (= expect result))

(check-sat)
(exit)
