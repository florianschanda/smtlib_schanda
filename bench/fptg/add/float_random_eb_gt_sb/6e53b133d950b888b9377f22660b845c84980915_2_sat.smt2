(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10011010000011000 #b100)
                arg1
                (fp #b1 #b10000000000000010 #b110)))
(assert (fp.leq (fp #b1 #b10000000000000010 #b110)
                arg1
                (fp #b1 #b00101101101000010 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11010100001010111 #b110)
                arg2
                (fp #b1 #b01111111111111111 #b101)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b101)
                arg2
                (fp #b1 #b01010100110010100 #b011)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11001101001010101 #b101)
                expect
                (fp #b1 #b10000000000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000000000011 #b000)
                expect
                (fp #b1 #b00000101110111111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
