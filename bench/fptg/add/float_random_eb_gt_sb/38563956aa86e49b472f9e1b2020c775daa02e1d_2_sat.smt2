; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1001110000111 #b001110)
                arg1
                (fp #b1 #b0111111111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b000000)
                arg1
                (fp #b1 #b0101011010011 #b101110)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0010011100001 #b000010)
                arg2
                (fp #b0 #b0000000000001 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000001 #b000000)
                arg2
                (fp #b0 #b0011111011100 #b000001)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111100111001 #b101100)
                expect
                (fp #b1 #b0111111111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b000000)
                expect
                (fp #b0 #b0110001111001 #b100101)))

(assert (= expect result))

(check-sat)
(exit)
