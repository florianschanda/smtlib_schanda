(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11100001100 #b101)
                arg1
                (fp #b0 #b11010001010 #b111)))
(assert (fp.leq (fp #b0 #b11010001010 #b111)
                arg1
                (fp #b0 #b11111011111 #b111)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110011010 #b001)
                expect
                (fp #b0 #b11010001011 #b111)))
(assert (fp.leq (fp #b0 #b11010001011 #b111)
                expect
                (fp #b0 #b11110000101 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
