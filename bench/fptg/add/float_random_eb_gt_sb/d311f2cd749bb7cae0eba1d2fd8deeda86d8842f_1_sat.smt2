(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111101 #b101101)
                arg1
                (fp #b1 #b11111000 #b001101)))
(assert (fp.leq (fp #b1 #b11111000 #b001101)
                arg1
                (fp #b0 #b01100111 #b111110)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00011011 #b001010)
                arg2
                (fp #b0 #b10011101 #b010110)))
(assert (fp.leq (fp #b0 #b10011101 #b010110)
                arg2
                (fp #b0 #b11000100 #b101100)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111101 #b001110)
                expect
                (fp #b1 #b11111000 #b001100)))
(assert (fp.leq (fp #b1 #b11111000 #b001100)
                expect
                (fp #b1 #b00110011 #b010001)))

(assert (= expect result))

(check-sat)
(exit)
