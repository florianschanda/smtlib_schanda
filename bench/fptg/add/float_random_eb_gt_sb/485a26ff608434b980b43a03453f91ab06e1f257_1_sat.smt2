(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b000011011 #b101)
                arg1
                (fp #b0 #b111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111110 #b111)
                arg1
                (fp #b0 #b111111111 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111110000 #b101)
                arg2
                (fp #b1 #b100000010 #b100)))
(assert (fp.leq (fp #b1 #b100000010 #b100)
                arg2
                (fp #b0 #b001000010 #b000)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111100110 #b110)
                expect
                (fp #b0 #b111111110 #b110)))
(assert (fp.leq (fp #b0 #b111111110 #b110)
                expect
                (fp #b0 #b111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
