(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00101111010 #b11)
                arg1
                (fp #b0 #b10111111110 #b11)))
(assert (fp.leq (fp #b0 #b10111111110 #b11)
                arg1
                (fp #b0 #b11010100111 #b10)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00110101110 #b01)
                arg2
                (fp #b0 #b01000000000 #b00)))
(assert (fp.leq (fp #b0 #b01000000000 #b00)
                arg2
                (fp #b0 #b01001000000 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b10101001110 #b00)
                expect
                (fp #b0 #b10111111110 #b11)))
(assert (fp.leq (fp #b0 #b10111111110 #b11)
                expect
                (fp #b0 #b11010101001 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
