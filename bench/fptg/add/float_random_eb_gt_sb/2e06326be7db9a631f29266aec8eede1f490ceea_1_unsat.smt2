(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0111111111 #b01001)
                arg1
                (fp #b1 #b0010110100 #b00001)))
(assert (fp.leq (fp #b1 #b0010110100 #b00001)
                arg1
                (fp #b0 #b1000010111 #b00011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101001000 #b10001)
                arg2
                (fp #b1 #b1001111000 #b10111)))
(assert (fp.leq (fp #b1 #b1001111000 #b10111)
                arg2
                (fp #b0 #b0101100001 #b01100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100100111 #b10100)
                expect
                (fp #b1 #b1001111000 #b10111)))
(assert (fp.leq (fp #b1 #b1001111000 #b10111)
                expect
                (fp #b0 #b1101011011 #b00110)))

(assert (not (= expect result)))

(check-sat)
(exit)
