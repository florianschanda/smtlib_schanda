(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1100101 #b01)
                arg1
                (fp #b1 #b1001010 #b01)))
(assert (fp.leq (fp #b1 #b1001010 #b01)
                arg1
                (fp #b0 #b0111111 #b00)))

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1001001 #b00)
                arg2
                (fp #b0 #b1111110 #b10)))
(assert (fp.leq (fp #b0 #b1111110 #b10)
                arg2
                (fp #b0 #b1111110 #b11)))

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0101000 #b00)
                expect
                (fp #b0 #b1111110 #b10)))
(assert (fp.leq (fp #b0 #b1111110 #b10)
                expect
                (fp #b0 #b1111111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
