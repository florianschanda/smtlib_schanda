(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101011 #b100)
                arg1
                (fp #b0 #b11111101 #b000)))
(assert (fp.leq (fp #b0 #b11111101 #b000)
                arg1
                (fp #b0 #b11111110 #b010)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11010001 #b010)
                arg2
                (fp #b0 #b00000000 #b011)))
(assert (fp.leq (fp #b0 #b00000000 #b011)
                arg2
                (fp #b0 #b00011011 #b010)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b11110101 #b000)
                expect
                (fp #b0 #b11111101 #b001)))
(assert (fp.leq (fp #b0 #b11111101 #b001)
                expect
                (fp #b0 #b11111101 #b110)))

(assert (= expect result))

(check-sat)
(exit)
