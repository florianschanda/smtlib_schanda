(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00111101 #b10110)
                arg1
                (fp #b0 #b00000000 #b11111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111)
                arg1
                (fp #b0 #b10011111 #b01010)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10001110 #b01100)
                arg2
                (fp #b1 #b00010010 #b00000)))
(assert (fp.leq (fp #b1 #b00010010 #b00000)
                arg2
                (fp #b0 #b10110000 #b10001)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11010100 #b00110)
                expect
                (fp #b1 #b00010001 #b11111)))
(assert (fp.leq (fp #b1 #b00010001 #b11111)
                expect
                (fp #b0 #b10101000 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
