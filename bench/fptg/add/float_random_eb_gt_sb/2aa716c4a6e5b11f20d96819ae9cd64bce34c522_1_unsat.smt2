(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10010110 #b011)
                arg1
                (fp #b0 #b00000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000 #b111)
                arg1
                (fp #b0 #b11000101 #b111)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10100100 #b110)
                arg2
                (fp #b0 #b10100001 #b100)))
(assert (fp.leq (fp #b0 #b10100001 #b100)
                arg2
                (fp #b0 #b11000000 #b011)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b01111011 #b101)
                expect
                (fp #b0 #b10100001 #b100)))
(assert (fp.leq (fp #b0 #b10100001 #b100)
                expect
                (fp #b0 #b11001010 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
