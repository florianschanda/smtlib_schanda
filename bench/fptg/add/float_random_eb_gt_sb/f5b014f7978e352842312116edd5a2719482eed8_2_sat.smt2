(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b0 #b011011110000001001 #b0101110)
                arg1
                (fp #b0 #b111111111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0000000)
                arg1
                (fp #b0 #b111111111111111101 #b1000101)))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b111100100100010110 #b1010000)
                arg2
                (fp #b0 #b111111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b1111111)
                arg2
                (fp #b0 #b111111111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
