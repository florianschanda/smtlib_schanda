(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101111101111 #b000)
                arg1
                (fp #b0 #b011111111111 #b111)))
(assert (fp.leq (fp #b0 #b011111111111 #b111)
                arg1
                (fp #b0 #b100101110111 #b011)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011001100100 #b100)
                arg2
                (fp #b0 #b010000000000 #b000)))
(assert (fp.leq (fp #b0 #b010000000000 #b000)
                arg2
                (fp #b0 #b100100110011 #b100)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111010011001 #b010)
                expect
                (fp #b0 #b100000000000 #b000)))
(assert (fp.leq (fp #b0 #b100000000000 #b000)
                expect
                (fp #b0 #b111010011001 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
