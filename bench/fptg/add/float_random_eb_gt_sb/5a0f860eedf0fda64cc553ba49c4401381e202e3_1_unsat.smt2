; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01101010010111 #b10)
                arg1
                (fp #b0 #b01001110101001 #b01)))
(assert (fp.leq (fp #b0 #b01001110101001 #b01)
                arg1
                (fp #b0 #b01010001010110 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00001001001100 #b00)
                arg2
                (fp #b0 #b00000100100001 #b11)))
(assert (fp.leq (fp #b0 #b00000100100001 #b11)
                arg2
                (fp #b0 #b01111110101110 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01001111101101 #b01)
                expect
                (fp #b0 #b01001110101001 #b01)))
(assert (fp.leq (fp #b0 #b01001110101001 #b01)
                expect
                (fp #b0 #b11110010010100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
