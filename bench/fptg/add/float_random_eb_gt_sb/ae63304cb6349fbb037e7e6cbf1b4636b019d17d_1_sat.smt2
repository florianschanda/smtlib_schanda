; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111111111111 #b0000000)
                arg1
                (fp #b1 #b1111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111111)
                arg1
                (fp #b0 #b0101010100111 #b1110101)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0010000000000 #b1000000)
                arg2
                (fp #b1 #b0000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000011)
                arg2
                (fp #b0 #b0101101100011 #b1011011)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111111111111 #b0000000)
                expect
                (fp #b1 #b1111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111111)
                expect
                (fp #b1 #b0001011110111 #b0101010)))

(assert (= expect result))

(check-sat)
(exit)
