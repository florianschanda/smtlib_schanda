(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0010001110111011 #b01)
                arg1
                (fp #b0 #b0111111111111111 #b11)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b11)
                arg1
                (fp #b0 #b1100010011111000 #b00)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1110110111011011 #b11)
                arg2
                (fp #b1 #b1110101111001111 #b00)))
(assert (fp.leq (fp #b1 #b1110101111001111 #b00)
                arg2
                (fp #b1 #b0100000111110010 #b00)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111001101001011 #b11)
                expect
                (fp #b1 #b1110101111001111 #b00)))
(assert (fp.leq (fp #b1 #b1110101111001111 #b00)
                expect
                (fp #b1 #b1011100111010010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
