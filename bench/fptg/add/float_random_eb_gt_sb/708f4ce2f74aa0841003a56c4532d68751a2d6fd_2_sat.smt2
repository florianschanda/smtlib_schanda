(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110011000001 #b1010)
                arg1
                (fp #b1 #b010111000101 #b1001)))
(assert (fp.leq (fp #b1 #b010111000101 #b1001)
                arg1
                (fp #b0 #b000001010101 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111011001000 #b1111)
                arg2
                (fp #b1 #b011111111111 #b0000)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000)
                arg2
                (fp #b0 #b010001101111 #b1101)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100011110111 #b1111)
                expect
                (fp #b1 #b011111111111 #b0001)))
(assert (fp.leq (fp #b1 #b011111111111 #b0001)
                expect
                (fp #b1 #b011110110100 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
