(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0001110110100000 #b0010011001100)
                arg1
                (fp #b0 #b0000000000000000 #b1101100101001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b1101100101001)
                arg1
                (fp #b0 #b1110100101100000 #b0010100111010)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0001100011010101 #b0001111101111)
                expect
                (fp #b0 #b0000000000000001 #b1011001010010)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b1011001010010)
                expect
                (fp #b0 #b0110010111100010 #b0100011000101)))

(assert (= expect result))

(check-sat)
(exit)
