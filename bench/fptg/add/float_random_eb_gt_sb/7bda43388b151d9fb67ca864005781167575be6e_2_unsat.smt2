; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11100100011110 #b01)
                arg1
                (fp #b0 #b01111111111111 #b11)))
(assert (fp.leq (fp #b0 #b01111111111111 #b11)
                arg1
                (fp #b0 #b11111110110100 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11010010111010 #b00)
                arg2
                (fp #b1 #b01000000000000 #b00)))
(assert (fp.leq (fp #b1 #b01000000000000 #b00)
                arg2
                (fp #b0 #b00001100111001 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111001110110 #b10)
                expect
                (fp #b0 #b01111111111111 #b11)))
(assert (fp.leq (fp #b0 #b01111111111111 #b11)
                expect
                (fp #b0 #b11110001001001 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
