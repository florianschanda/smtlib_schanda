(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110101100100 #b11)
                arg1
                (fp #b1 #b101111111110 #b11)))
(assert (fp.leq (fp #b1 #b101111111110 #b11)
                arg1
                (fp #b1 #b011111011101 #b00)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b000001111110 #b00)
                arg2
                (fp #b0 #b111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111101 #b00)
                arg2
                (fp #b0 #b111111111110 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100100011000 #b01)
                expect
                (fp #b0 #b111111111100 #b11)))
(assert (fp.leq (fp #b0 #b111111111100 #b11)
                expect
                (fp #b0 #b111111111101 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
