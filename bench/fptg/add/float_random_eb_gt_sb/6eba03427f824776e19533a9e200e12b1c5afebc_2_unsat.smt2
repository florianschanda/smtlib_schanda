(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00100011 #b00111)
                arg1
                (fp #b0 #b01000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000)
                arg1
                (fp #b0 #b10100001 #b01000)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11011000 #b01000)
                arg2
                (fp #b1 #b01001000 #b01010)))
(assert (fp.leq (fp #b1 #b01001000 #b01010)
                arg2
                (fp #b0 #b01101111 #b11111)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10111111 #b01111)
                expect
                (fp #b1 #b01001000 #b01010)))
(assert (fp.leq (fp #b1 #b01001000 #b01010)
                expect
                (fp #b0 #b00011100 #b10101)))

(assert (not (= expect result)))

(check-sat)
(exit)
