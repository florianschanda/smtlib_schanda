                arg2
                (fp #b1 #b1110000110 #b101111)))
(assert (fp.leq (fp #b1 #b1110000110 #b101111)
                arg2
                (fp #b1 #b1011101111 #b001001)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1110110001 #b110100)
                expect
                (fp #b1 #b1110000110 #b101110)))
(assert (fp.leq (fp #b1 #b1110000110 #b101110)
                expect
                (fp #b0 #b0111110110 #b111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
