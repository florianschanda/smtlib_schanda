(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11000100 #b0000)
                arg1
                (fp #b0 #b01001001 #b0001)))
(assert (fp.leq (fp #b0 #b01001001 #b0001)
                arg1
                (fp #b0 #b01001101 #b1011)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00010111 #b0110)
                arg2
                (fp #b0 #b00000000 #b1110)))
(assert (fp.leq (fp #b0 #b00000000 #b1110)
                arg2
                (fp #b0 #b11011000 #b1111)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10111010 #b1100)
                expect
                (fp #b0 #b01001001 #b0010)))
(assert (fp.leq (fp #b0 #b01001001 #b0010)
                expect
                (fp #b0 #b10011001 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
