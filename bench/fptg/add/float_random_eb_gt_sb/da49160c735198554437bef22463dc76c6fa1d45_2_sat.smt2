(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100110011 #b0110110)
                arg1
                (fp #b1 #b000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b000000000 #b1111010)
                arg1
                (fp #b0 #b010001011 #b1101100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000100010 #b1001010)
                arg2
                (fp #b0 #b100000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000110 #b0000001)
                arg2
                (fp #b0 #b110100010 #b0010111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b001010000 #b1000000)
                expect
                (fp #b0 #b100000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000110 #b0000001)
                expect
                (fp #b0 #b101000100 #b0101111)))

(assert (= expect result))

(check-sat)
(exit)
