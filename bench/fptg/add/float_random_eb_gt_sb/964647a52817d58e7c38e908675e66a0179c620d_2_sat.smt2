;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0110001011001 #b11111)
                arg1
                (fp #b0 #b0111111111111 #b00111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b00111)
                arg1
                (fp #b0 #b1100100011011 #b11000)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101110000101 #b11001)
                arg2
                (fp #b0 #b1000000000100 #b00011)))
(assert (fp.leq (fp #b0 #b1000000000100 #b00011)
                arg2
                (fp #b0 #b1001101000011 #b00010)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b0001111000011 #b11111)
                expect
                (fp #b0 #b1000000000100 #b00101)))
(assert (fp.leq (fp #b0 #b1000000000100 #b00101)
                expect
                (fp #b0 #b1011101011101 #b01000)))

(assert (= expect result))

(check-sat)
(exit)
