(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10110000 #b010)
                arg1
                (fp #b0 #b00100011 #b000)))
(assert (fp.leq (fp #b0 #b00100011 #b000)
                arg1
                (fp #b0 #b01100000 #b011)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11100010 #b100)
                arg2
                (fp #b1 #b11011100 #b110)))
(assert (fp.leq (fp #b1 #b11011100 #b110)
                arg2
                (fp #b1 #b10000101 #b111)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11100010 #b101)
                expect
                (fp #b1 #b11011100 #b101)))
(assert (fp.leq (fp #b1 #b11011100 #b101)
                expect
                (fp #b0 #b11011100 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
