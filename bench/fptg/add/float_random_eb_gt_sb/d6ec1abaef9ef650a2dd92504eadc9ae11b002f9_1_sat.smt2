(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111111111110 #b0)
                arg1
                (fp #b1 #b1111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0)
                arg1
                (fp #b0 #b1100111111111110 #b1)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1010111101011011 #b1)
                arg2
                (fp #b1 #b0000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b1)
                arg2
                (fp #b0 #b0001101110000101 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111111111110 #b1)
                expect
                (fp #b1 #b1111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0)
                expect
                (fp #b1 #b1111101001000111 #b1)))

(assert (= expect result))

(check-sat)
(exit)
