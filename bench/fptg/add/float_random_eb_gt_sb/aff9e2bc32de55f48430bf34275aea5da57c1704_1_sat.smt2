;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00101110101 #b001110000)
                arg1
                (fp #b1 #b00000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b000000000)
                arg1
                (fp #b0 #b11101011110 #b001000010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11000011110 #b010000111)
                arg2
                (fp #b0 #b11101110101 #b001001000)))
(assert (fp.leq (fp #b0 #b11101110101 #b001001000)
                arg2
                (fp #b0 #b11110001000 #b000100100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11001001010 #b110011000)
                expect
                (fp #b0 #b11101110101 #b001000111)))
(assert (fp.leq (fp #b0 #b11101110101 #b001000111)
                expect
                (fp #b0 #b11110011001 #b111110011)))

(assert (= expect result))

(check-sat)
(exit)
