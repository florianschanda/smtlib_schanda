; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011001111 #b01010)
                arg1
                (fp #b1 #b0111111111111 #b10100)))
(assert (fp.leq (fp #b1 #b0111111111111 #b10100)
                arg1
                (fp #b0 #b1000100101111 #b00000)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101101111110 #b10001)
                arg2
                (fp #b0 #b1000000000011 #b00110)))
(assert (fp.leq (fp #b0 #b1000000000011 #b00110)
                arg2
                (fp #b0 #b1100111011000 #b00111)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1001011100111 #b01000)
                expect
                (fp #b0 #b1000000000011 #b00010)))
(assert (fp.leq (fp #b0 #b1000000000011 #b00010)
                expect
                (fp #b0 #b1101111111111 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
