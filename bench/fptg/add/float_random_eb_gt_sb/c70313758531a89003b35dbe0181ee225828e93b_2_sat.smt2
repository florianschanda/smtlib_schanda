(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b010110000 #b0)
                arg1
                (fp #b0 #b011111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111 #b1)
                arg1
                (fp #b0 #b100011111 #b1)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010100000 #b0)
                arg2
                (fp #b0 #b100000001 #b0)))
(assert (fp.leq (fp #b0 #b100000001 #b0)
                arg2
                (fp #b0 #b110100000 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b011111100 #b1)
                expect
                (fp #b0 #b100000001 #b1)))
(assert (fp.leq (fp #b0 #b100000001 #b1)
                expect
                (fp #b0 #b110001001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
