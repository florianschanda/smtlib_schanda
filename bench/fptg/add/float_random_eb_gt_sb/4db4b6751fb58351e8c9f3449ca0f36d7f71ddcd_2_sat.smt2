                arg2
                (fp #b0 #b10000000000000011 #b0001)))
(assert (fp.leq (fp #b0 #b10000000000000011 #b0001)
                arg2
                (fp #b0 #b10010111000010110 #b1000)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b00101001101000101 #b0101)
                expect
                (fp #b0 #b10100100010111011 #b1110)))
(assert (fp.leq (fp #b0 #b10100100010111011 #b1110)
                expect
                (fp #b0 #b10111011001001010 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
