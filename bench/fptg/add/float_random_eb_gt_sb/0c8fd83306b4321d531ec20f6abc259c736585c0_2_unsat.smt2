; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0010000 #b00101)
                arg1
                (fp #b1 #b0000000 #b00111)))
(assert (fp.leq (fp #b1 #b0000000 #b00111)
                arg1
                (fp #b0 #b0000110 #b00100)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0100100 #b10010)
                arg2
                (fp #b0 #b0100110 #b11010)))
(assert (fp.leq (fp #b0 #b0100110 #b11010)
                arg2
                (fp #b0 #b1011111 #b00101)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0100011 #b00111)
                expect
                (fp #b0 #b0100110 #b11010)))
(assert (fp.leq (fp #b0 #b0100110 #b11010)
                expect
                (fp #b0 #b1001110 #b01100)))

(assert (not (= expect result)))

(check-sat)
(exit)
