(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110110 #b10010)
                arg1
                (fp #b1 #b1100001 #b00001)))
(assert (fp.leq (fp #b1 #b1100001 #b00001)
                arg1
                (fp #b0 #b0111110 #b00001)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110010 #b10110)
                arg2
                (fp #b1 #b1000100 #b11110)))
(assert (fp.leq (fp #b1 #b1000100 #b11110)
                arg2
                (fp #b0 #b1011011 #b00010)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111010 #b00100)
                expect
                (fp #b1 #b1100001 #b00001)))
(assert (fp.leq (fp #b1 #b1100001 #b00001)
                expect
                (fp #b1 #b0001011 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
