(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110110101010 #b1110101011)
                arg1
                (fp #b0 #b000000000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b000000000000 #b0001001100)
                arg1
                (fp #b0 #b011000110010 #b0101110000)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b010101011110 #b0101100110)
                arg2
                (fp #b0 #b111101001111 #b1100011100)))
(assert (fp.leq (fp #b0 #b111101001111 #b1100011100)
                arg2
                (fp #b0 #b111111111100 #b0101000101)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101100100011 #b0100110000)
                expect
                (fp #b0 #b111101001111 #b1100011100)))
(assert (fp.leq (fp #b0 #b111101001111 #b1100011100)
                expect
                (fp #b0 #b111110000000 #b1010010000)))

(assert (= expect result))

(check-sat)
(exit)
