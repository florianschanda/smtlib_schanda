(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0101100 #b0110)
                arg1
                (fp #b0 #b1000010 #b0000)))
(assert (fp.leq (fp #b0 #b1000010 #b0000)
                arg1
                (fp #b0 #b1101101 #b0010)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b1110111 #b0110)
                arg2
                (fp #b0 #b1111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000)
                arg2
                (fp #b0 #b1111101 #b0011)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0011001 #b0100)
                expect
                (fp #b0 #b1111101 #b0001)))
(assert (fp.leq (fp #b0 #b1111101 #b0001)
                expect
                (fp #b0 #b1111110 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
