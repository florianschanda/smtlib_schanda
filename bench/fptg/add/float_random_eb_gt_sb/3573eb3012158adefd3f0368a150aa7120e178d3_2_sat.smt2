(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001100 #b11001)
                arg1
                (fp #b0 #b0111111 #b10111)))
(assert (fp.leq (fp #b0 #b0111111 #b10111)
                arg1
                (fp #b0 #b1111100 #b01111)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001101 #b01110)
                arg2
                (fp #b0 #b0000000 #b10101)))
(assert (fp.leq (fp #b0 #b0000000 #b10101)
                arg2
                (fp #b0 #b1010000 #b01111)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0101110 #b10010)
                expect
                (fp #b0 #b0111111 #b11000)))
(assert (fp.leq (fp #b0 #b0111111 #b11000)
                expect
                (fp #b0 #b1000000 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
