(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11011000 #b1000)
                arg1
                (fp #b1 #b10000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000100 #b0000)
                arg1
                (fp #b0 #b01101001 #b1111)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11110010 #b0011)
                arg2
                (fp #b0 #b10110101 #b1100)))
(assert (fp.leq (fp #b0 #b10110101 #b1100)
                arg2
                (fp #b0 #b11010100 #b0111)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00111010 #b1010)
                expect
                (fp #b0 #b10110101 #b1100)))
(assert (fp.leq (fp #b0 #b10110101 #b1100)
                expect
                (fp #b0 #b11010110 #b0101)))

(assert (not (= expect result)))

(check-sat)
(exit)
