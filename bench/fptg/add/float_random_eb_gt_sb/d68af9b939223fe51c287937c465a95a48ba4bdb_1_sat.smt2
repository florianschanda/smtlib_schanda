; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11001110111 #b000010)
                arg1
                (fp #b0 #b00000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000)
                arg1
                (fp #b0 #b00011001001 #b011101)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11101101101 #b110011)
                arg2
                (fp #b1 #b10000000101 #b010001)))
(assert (fp.leq (fp #b1 #b10000000101 #b010001)
                arg2
                (fp #b0 #b01010010001 #b000010)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11100101101 #b110000)
                expect
                (fp #b1 #b10000000101 #b010001)))
(assert (fp.leq (fp #b1 #b10000000101 #b010001)
                expect
                (fp #b0 #b11101110001 #b011011)))

(assert (= expect result))

(check-sat)
(exit)
