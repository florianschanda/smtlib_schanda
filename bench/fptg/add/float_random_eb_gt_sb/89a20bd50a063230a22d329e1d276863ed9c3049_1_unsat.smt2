; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111101110 #b01)
                arg1
                (fp #b1 #b110111011 #b10)))
(assert (fp.leq (fp #b1 #b110111011 #b10)
                arg1
                (fp #b1 #b010110100 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101001110 #b01)
                arg2
                (fp #b0 #b000000000 #b11)))
(assert (fp.leq (fp #b0 #b000000000 #b11)
                arg2
                (fp #b0 #b110001100 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110111110 #b00)
                expect
                (fp #b1 #b110111011 #b01)))
(assert (fp.leq (fp #b1 #b110111011 #b01)
                expect
                (fp #b0 #b010000100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
