(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011011110 #b11)
                arg1
                (fp #b0 #b000000000 #b11)))
(assert (fp.leq (fp #b0 #b000000000 #b11)
                arg1
                (fp #b0 #b111000001 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b010110001 #b00)
                arg2
                (fp #b0 #b011111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111 #b11)
                arg2
                (fp #b0 #b101111010 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010001 #b11)
                expect
                (fp #b0 #b100000000 #b00)))
(assert (fp.leq (fp #b0 #b100000000 #b00)
                expect
                (fp #b0 #b100011100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
