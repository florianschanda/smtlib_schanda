(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11011111101101 #b1000101)
                arg1
                (fp #b1 #b10111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111)
                arg1
                (fp #b1 #b01100010000001 #b0000100)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10110001010100 #b0010011)
                arg2
                (fp #b1 #b00000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000011)
                arg2
                (fp #b0 #b11110111011110 #b0001001)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11000110111010 #b0000010)
                expect
                (fp #b1 #b10111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111)
                expect
                (fp #b0 #b00000011100111 #b1000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
