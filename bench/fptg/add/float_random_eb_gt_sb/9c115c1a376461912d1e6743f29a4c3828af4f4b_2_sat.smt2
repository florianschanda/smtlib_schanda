(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11001001 #b001111)
                arg1
                (fp #b0 #b00000000 #b000110)))
(assert (fp.leq (fp #b0 #b00000000 #b000110)
                arg1
                (fp #b0 #b11110110 #b110111)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11101101 #b010110)
                arg2
                (fp #b0 #b00111101 #b000000)))
(assert (fp.leq (fp #b0 #b00111101 #b000000)
                arg2
                (fp #b0 #b11111010 #b001011)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00001110 #b111101)
                expect
                (fp #b0 #b00111101 #b000001)))
(assert (fp.leq (fp #b0 #b00111101 #b000001)
                expect
                (fp #b0 #b01010010 #b011101)))

(assert (= expect result))

(check-sat)
(exit)
