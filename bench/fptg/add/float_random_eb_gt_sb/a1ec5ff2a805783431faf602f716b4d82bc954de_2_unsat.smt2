(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101100 #b0001)
                arg1
                (fp #b1 #b000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg1
                (fp #b0 #b101110 #b0010)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010010 #b1000)
                arg2
                (fp #b0 #b111000 #b0100)))
(assert (fp.leq (fp #b0 #b111000 #b0100)
                arg2
                (fp #b0 #b111100 #b0110)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001001 #b0010)
                expect
                (fp #b0 #b111000 #b0100)))
(assert (fp.leq (fp #b0 #b111000 #b0100)
                expect
                (fp #b0 #b111110 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
