(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111010010100 #b1)
                arg1
                (fp #b1 #b1100101010100 #b0)))
(assert (fp.leq (fp #b1 #b1100101010100 #b0)
                arg1
                (fp #b1 #b1100011111111 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0010110110100 #b0)
                arg2
                (fp #b1 #b0010010101001 #b0)))
(assert (fp.leq (fp #b1 #b0010010101001 #b0)
                arg2
                (fp #b0 #b1111111110001 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111111010101 #b0)
                expect
                (fp #b1 #b1100101010100 #b1)))
(assert (fp.leq (fp #b1 #b1100101010100 #b1)
                expect
                (fp #b1 #b1011100010110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
