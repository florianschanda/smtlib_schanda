; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1100011100 #b000100)
                arg1
                (fp #b1 #b0111001110 #b000010)))
(assert (fp.leq (fp #b1 #b0111001110 #b000010)
                arg1
                (fp #b0 #b1110111010 #b100101)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0111110001 #b100000)
                arg2
                (fp #b0 #b1000000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000000101 #b101000)
                arg2
                (fp #b0 #b1101101100 #b101101)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0011001010 #b101010)
                expect
                (fp #b0 #b1000000101 #b100111)))
(assert (fp.leq (fp #b0 #b1000000101 #b100111)
                expect
                (fp #b0 #b1001111000 #b111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
