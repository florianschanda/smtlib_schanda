(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b100111100011110 #b11000)
                arg1
                (fp #b1 #b011111111111111 #b10100)))
(assert (fp.leq (fp #b1 #b011111111111111 #b10100)
                arg1
                (fp #b1 #b001111101001010 #b00000)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111111111111101 #b10000)
                arg2
                (fp #b1 #b111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000)
                arg2
                (fp #b0 #b100100000110000 #b00000)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111111111111110 #b10010)
                expect
                (fp #b1 #b111111111111101 #b00001)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00001)
                expect
                (fp #b1 #b111000111100110 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
