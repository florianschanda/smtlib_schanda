(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110001 #b100)
                arg1
                (fp #b1 #b0000000 #b110)))
(assert (fp.leq (fp #b1 #b0000000 #b110)
                arg1
                (fp #b0 #b1101100 #b100)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0010100 #b111)
                expect
                (fp #b1 #b0000001 #b100)))
(assert (fp.leq (fp #b1 #b0000001 #b100)
                expect
                (fp #b0 #b0001000 #b001)))

(assert (= expect result))

(check-sat)
(exit)
