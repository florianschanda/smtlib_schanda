; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00010 #b00)
                arg1
                (fp #b0 #b01111 #b00)))
(assert (fp.leq (fp #b0 #b01111 #b00)
                arg1
                (fp #b0 #b11101 #b00)))

(declare-const arg2 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b0 #b01011 #b10)
                arg2
                (fp #b0 #b01111 #b01)))
(assert (fp.leq (fp #b0 #b01111 #b01)
                arg2
                (fp #b0 #b10111 #b10)))

(declare-const result (_ FloatingPoint 5 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00011 #b00)
                expect
                (fp #b0 #b10000 #b01)))
(assert (fp.leq (fp #b0 #b10000 #b01)
                expect
                (fp #b0 #b11011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
