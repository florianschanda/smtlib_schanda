(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001101111 #b00001)
                arg1
                (fp #b1 #b0111111111 #b10100)))
(assert (fp.leq (fp #b1 #b0111111111 #b10100)
                arg1
                (fp #b1 #b0000001111 #b01110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110000111 #b01110)
                arg2
                (fp #b1 #b0000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000 #b10001)
                arg2
                (fp #b0 #b1010001010 #b00001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001110001 #b01011)
                expect
                (fp #b1 #b0111111111 #b10101)))
(assert (fp.leq (fp #b1 #b0111111111 #b10101)
                expect
                (fp #b1 #b0000101101 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
