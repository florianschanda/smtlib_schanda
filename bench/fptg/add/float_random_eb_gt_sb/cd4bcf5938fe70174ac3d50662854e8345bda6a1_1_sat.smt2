(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b0 #b001111011110010100 #b10)
                arg1
                (fp #b0 #b011100010101111011 #b01)))
(assert (fp.leq (fp #b0 #b011100010101111011 #b01)
                arg1
                (fp #b0 #b011111111011100111 #b11)))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b011101110110000101 #b01)
                arg2
                (fp #b0 #b011111111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b11)
                arg2
                (fp #b0 #b100110111111011101 #b00)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b001010001110010101 #b10)
                expect
                (fp #b0 #b011111111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b11)
                expect
                (fp #b0 #b100010000001111101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
