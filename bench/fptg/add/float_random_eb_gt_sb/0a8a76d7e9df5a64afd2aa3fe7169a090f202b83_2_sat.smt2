(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110111 #b111)
                arg1
                (fp #b0 #b01111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111 #b000)
                arg1
                (fp #b0 #b11011011 #b100)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10011101 #b101)
                arg2
                (fp #b0 #b00000000 #b011)))
(assert (fp.leq (fp #b0 #b00000000 #b011)
                arg2
                (fp #b0 #b10001010 #b100)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b01010110 #b110)
                expect
                (fp #b0 #b01111111 #b001)))
(assert (fp.leq (fp #b0 #b01111111 #b001)
                expect
                (fp #b0 #b11100100 #b111)))

(assert (= expect result))

(check-sat)
(exit)
