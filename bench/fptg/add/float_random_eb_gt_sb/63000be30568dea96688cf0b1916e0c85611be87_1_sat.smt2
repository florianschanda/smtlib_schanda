(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0101001010101101 #b110)
                arg1
                (fp #b1 #b0000000000000000 #b001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b001)
                arg1
                (fp #b0 #b0000011000100011 #b110)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111111000001101 #b101)
                arg2
                (fp #b1 #b0011111111111110 #b011)))
(assert (fp.leq (fp #b1 #b0011111111111110 #b011)
                arg2
                (fp #b1 #b0010010000001000 #b011)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1001110111010000 #b101)
                expect
                (fp #b1 #b0011111111111110 #b011)))
(assert (fp.leq (fp #b1 #b0011111111111110 #b011)
                expect
                (fp #b0 #b0101001010011111 #b100)))

(assert (= expect result))

(check-sat)
(exit)
