(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111110 #b1111)
                arg1
                (fp #b1 #b000101 #b1110)))
(assert (fp.leq (fp #b1 #b000101 #b1110)
                arg1
                (fp #b0 #b010001 #b0001)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101110 #b1101)
                arg2
                (fp #b1 #b000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000 #b1110)
                arg2
                (fp #b0 #b101010 #b0101)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100001 #b0100)
                expect
                (fp #b1 #b000101 #b1111)))
(assert (fp.leq (fp #b1 #b000101 #b1111)
                expect
                (fp #b0 #b111011 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
