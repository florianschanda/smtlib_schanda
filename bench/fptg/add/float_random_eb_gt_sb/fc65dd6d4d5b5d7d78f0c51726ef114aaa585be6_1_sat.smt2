(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001110110 #b001)
                arg1
                (fp #b0 #b011111111 #b000)))
(assert (fp.leq (fp #b0 #b011111111 #b000)
                arg1
                (fp #b0 #b100011011 #b110)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
