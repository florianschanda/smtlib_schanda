(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b010)
                arg1
                (fp #b1 #b110010 #b010)))
(assert (fp.leq (fp #b1 #b110010 #b010)
                arg1
                (fp #b1 #b010111 #b111)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b111)
                arg2
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg2
                (fp #b1 #b100000 #b010)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111110 #b001)
                expect
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                expect
                (fp #b1 #b111010 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
