                (fp #b1 #b000000000000000000 #b1111111)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b1111111)
                arg2
                (fp #b0 #b011101101011101000 #b1101101)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b010000100110100000 #b0000101)
                expect
                (fp #b0 #b100000000000000011 #b1110000)))
(assert (fp.leq (fp #b0 #b100000000000000011 #b1110000)
                expect
                (fp #b0 #b100011110011011110 #b0101010)))

(assert (= expect result))

(check-sat)
(exit)
