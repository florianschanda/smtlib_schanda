(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0110 #b01)
                arg1
                (fp #b0 #b1100 #b11)))
(assert (fp.leq (fp #b0 #b1100 #b11)
                arg1
                (fp #b0 #b1111 #b00)))

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b11)
                arg2
                (fp #b1 #b1000 #b10)))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg2
                (fp #b0 #b0111 #b10)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b10)
                expect
                (fp #b0 #b1100 #b10)))
(assert (fp.leq (fp #b0 #b1100 #b10)
                expect
                (fp #b0 #b1101 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
