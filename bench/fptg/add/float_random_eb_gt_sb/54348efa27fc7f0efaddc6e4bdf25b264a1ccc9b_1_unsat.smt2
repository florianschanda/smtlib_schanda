(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110111000 #b1011001)
                arg1
                (fp #b1 #b0000000000 #b1111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b1111111)
                arg1
                (fp #b0 #b1001010011 #b1000011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100100000 #b1101000)
                arg2
                (fp #b1 #b1000000110 #b1010010)))
(assert (fp.leq (fp #b1 #b1000000110 #b1010010)
                arg2
                (fp #b0 #b1010001110 #b1100111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110101011 #b1001001)
                expect
                (fp #b1 #b1000000110 #b1010010)))
(assert (fp.leq (fp #b1 #b1000000110 #b1010010)
                expect
                (fp #b1 #b0011100000 #b1100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
