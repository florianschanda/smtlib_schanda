(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001100 #b1000)
                arg1
                (fp #b1 #b000000 #b1000)))
(assert (fp.leq (fp #b1 #b000000 #b1000)
                arg1
                (fp #b0 #b010101 #b1111)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110100 #b1110)
                arg2
                (fp #b1 #b000001 #b0000)))
(assert (fp.leq (fp #b1 #b000001 #b0000)
                arg2
                (fp #b0 #b011010 #b1001)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110110 #b1011)
                expect
                (fp #b1 #b000001 #b1000)))
(assert (fp.leq (fp #b1 #b000001 #b1000)
                expect
                (fp #b0 #b011000 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
