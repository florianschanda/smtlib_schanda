; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11100000101011 #b00110)
                arg1
                (fp #b1 #b00111111111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111111111101 #b01101)
                arg1
                (fp #b0 #b10011101110111 #b10101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010111100101 #b00101)
                arg2
                (fp #b0 #b01111111111111 #b00000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b00000)
                arg2
                (fp #b0 #b10000101101100 #b00000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01111100010111 #b01100)
                expect
                (fp #b0 #b01111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b01111111111110 #b11111)
                expect
                (fp #b0 #b10111010101101 #b10001)))

(assert (not (= expect result)))

(check-sat)
(exit)
