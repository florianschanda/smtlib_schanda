;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b010110100110 #b110101000)
                arg1
                (fp #b0 #b100100101110 #b110100101)))
(assert (fp.leq (fp #b0 #b100100101110 #b110100101)
                arg1
                (fp #b0 #b110011011011 #b000001110)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b000111101001 #b100011100)
                expect
                (fp #b0 #b100100101111 #b110100101)))
(assert (fp.leq (fp #b0 #b100100101111 #b110100101)
                expect
                (fp #b0 #b101011100001 #b010100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
