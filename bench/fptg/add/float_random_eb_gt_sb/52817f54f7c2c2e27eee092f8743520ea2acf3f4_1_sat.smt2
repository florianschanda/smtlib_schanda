(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b01011010010 #b011101)
                arg2
                (fp #b0 #b10000000101 #b101000)))
(assert (fp.leq (fp #b0 #b10000000101 #b101000)
                arg2
                (fp #b0 #b10100011111 #b000000)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
