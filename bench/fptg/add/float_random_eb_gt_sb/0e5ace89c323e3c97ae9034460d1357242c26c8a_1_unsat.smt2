; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0001100000 #b110110)
                arg1
                (fp #b0 #b0101000100 #b100010)))
(assert (fp.leq (fp #b0 #b0101000100 #b100010)
                arg1
                (fp #b0 #b1100100111 #b011101)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111011101 #b011100)
                arg2
                (fp #b1 #b0111111111 #b001000)))
(assert (fp.leq (fp #b1 #b0111111111 #b001000)
                arg2
                (fp #b0 #b1011011000 #b101100)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010001100 #b011110)
                expect
                (fp #b1 #b0111111111 #b000111)))
(assert (fp.leq (fp #b1 #b0111111111 #b000111)
                expect
                (fp #b0 #b0111111110 #b010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
