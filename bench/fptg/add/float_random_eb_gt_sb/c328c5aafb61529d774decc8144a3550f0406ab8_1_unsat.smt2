(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111010 #b1011)
                arg1
                (fp #b0 #b001101 #b1101)))
(assert (fp.leq (fp #b0 #b001101 #b1101)
                arg1
                (fp #b0 #b011100 #b0001)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100100 #b0011)
                arg2
                (fp #b0 #b001011 #b0000)))
(assert (fp.leq (fp #b0 #b001011 #b0000)
                arg2
                (fp #b0 #b101101 #b1010)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111000 #b0110)
                expect
                (fp #b0 #b001110 #b0000)))
(assert (fp.leq (fp #b0 #b001110 #b0000)
                expect
                (fp #b0 #b101010 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
