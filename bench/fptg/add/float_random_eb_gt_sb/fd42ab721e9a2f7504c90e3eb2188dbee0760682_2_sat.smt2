(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b001010110000 #b1001001000)
                arg1
                (fp #b1 #b000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000001)
                arg1
                (fp #b0 #b100100111110 #b0011111100)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111110111110 #b1000110100)
                arg2
                (fp #b1 #b110011111001 #b1001011001)))
(assert (fp.leq (fp #b1 #b110011111001 #b1001011001)
                arg2
                (fp #b1 #b110000100000 #b0111000011)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111000111011 #b1011000110)
                expect
                (fp #b1 #b110011111001 #b1001011010)))
(assert (fp.leq (fp #b1 #b110011111001 #b1001011010)
                expect
                (fp #b0 #b111010011100 #b1100101100)))

(assert (= expect result))

(check-sat)
(exit)
