(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000110 #b1011)
                arg1
                (fp #b1 #b1000011 #b1110)))
(assert (fp.leq (fp #b1 #b1000011 #b1110)
                arg1
                (fp #b0 #b0010101 #b1111)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0000110 #b1000)
                arg2
                (fp #b0 #b0011110 #b0000)))
(assert (fp.leq (fp #b0 #b0011110 #b0000)
                arg2
                (fp #b0 #b1000100 #b0111)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1010011 #b1011)
                expect
                (fp #b1 #b1000011 #b1110)))
(assert (fp.leq (fp #b1 #b1000011 #b1110)
                expect
                (fp #b0 #b0111100 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
