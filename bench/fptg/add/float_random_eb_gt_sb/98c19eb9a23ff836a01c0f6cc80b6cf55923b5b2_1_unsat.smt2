(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0110011001110 #b1010)
                arg1
                (fp #b0 #b1101100111000 #b0110)))
(assert (fp.leq (fp #b0 #b1101100111000 #b0110)
                arg1
                (fp #b0 #b1110101111111 #b1101)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0100111010011 #b0100)
                arg2
                (fp #b0 #b1000000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000000100 #b0000)
                arg2
                (fp #b0 #b1010001011101 #b1111)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b1100101010001 #b0100)
                expect
                (fp #b0 #b1101100111000 #b0110)))
(assert (fp.leq (fp #b0 #b1101100111000 #b0110)
                expect
                (fp #b0 #b1110010001111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
