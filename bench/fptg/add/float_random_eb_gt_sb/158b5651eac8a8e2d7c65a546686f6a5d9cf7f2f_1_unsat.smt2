(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110101010 #b10010000)
                arg1
                (fp #b1 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000)
                arg1
                (fp #b0 #b0101010111 #b10011110)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1110011101 #b10101001)
                arg2
                (fp #b1 #b1110000101 #b11011111)))
(assert (fp.leq (fp #b1 #b1110000101 #b11011111)
                arg2
                (fp #b1 #b0000010010 #b11111111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111110110 #b01111010)
                expect
                (fp #b1 #b1110000101 #b11011111)))
(assert (fp.leq (fp #b1 #b1110000101 #b11011111)
                expect
                (fp #b0 #b1000011101 #b00110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
