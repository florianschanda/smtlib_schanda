(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0011101 #b1111)
                arg1
                (fp #b0 #b0000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000 #b0100)
                arg1
                (fp #b0 #b0010010 #b1110)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1001110 #b0111)
                arg2
                (fp #b1 #b1000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000011 #b0001)
                arg2
                (fp #b0 #b0010100 #b0100)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111011 #b1000)
                expect
                (fp #b1 #b1000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000011 #b0001)
                expect
                (fp #b0 #b0001011 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
