(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10001100000 #b0)
                arg1
                (fp #b0 #b01111111111 #b1)))
(assert (fp.leq (fp #b0 #b01111111111 #b1)
                arg1
                (fp #b0 #b11100001000 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11111001010 #b1)
                arg2
                (fp #b1 #b00000000001 #b0)))
(assert (fp.leq (fp #b1 #b00000000001 #b0)
                arg2
                (fp #b0 #b00011110010 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b00000001001 #b0)
                expect
                (fp #b0 #b01111111111 #b0)))
(assert (fp.leq (fp #b0 #b01111111111 #b0)
                expect
                (fp #b0 #b11111100110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
