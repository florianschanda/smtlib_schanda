(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10001001010000 #b110)
                arg1
                (fp #b1 #b01111111111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111111111 #b100)
                arg1
                (fp #b0 #b10100111111010 #b111)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111001001110 #b010)
                arg2
                (fp #b1 #b10000000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000000011 #b000)
                arg2
                (fp #b0 #b00010011000101 #b111)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10111001010000 #b111)
                expect
                (fp #b1 #b10000000000011 #b001)))
(assert (fp.leq (fp #b1 #b10000000000011 #b001)
                expect
                (fp #b0 #b01110100101010 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
