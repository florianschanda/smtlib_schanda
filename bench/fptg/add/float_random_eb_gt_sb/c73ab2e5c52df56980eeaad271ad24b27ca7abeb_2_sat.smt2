;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111100001010011000 #b110000100)
                arg1
                (fp #b1 #b100001101010110101 #b010110000)))
(assert (fp.leq (fp #b1 #b100001101010110101 #b010110000)
                arg1
                (fp #b0 #b110110000101010010 #b101101011)))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001110110110011010 #b110001110)
                expect
                (fp #b1 #b000000000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b000000000)
                expect
                (fp #b0 #b110111001101111100 #b011111110)))

(assert (= expect result))

(check-sat)
(exit)
