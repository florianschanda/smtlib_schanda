; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b00101110101 #b0100)
                arg1
                (fp #b0 #b10000000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000000100 #b0000)
                arg1
                (fp #b0 #b10110010100 #b0111)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01010000011 #b1101)
                arg2
                (fp #b0 #b00000000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100)
                arg2
                (fp #b0 #b00010110011 #b1100)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10111101100 #b1010)
                expect
                (fp #b0 #b10000000100 #b0001)))
(assert (fp.leq (fp #b0 #b10000000100 #b0001)
                expect
                (fp #b0 #b11011001110 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
