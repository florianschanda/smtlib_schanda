(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00010100 #b10101)
                arg1
                (fp #b0 #b11000001 #b11111)))
(assert (fp.leq (fp #b0 #b11000001 #b11111)
                arg1
                (fp #b0 #b11011010 #b00110)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00001010 #b10001)
                arg2
                (fp #b1 #b00000000 #b10110)))
(assert (fp.leq (fp #b1 #b00000000 #b10110)
                arg2
                (fp #b0 #b01110010 #b00010)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01101011 #b01111)
                expect
                (fp #b0 #b11000001 #b11111)))
(assert (fp.leq (fp #b0 #b11000001 #b11111)
                expect
                (fp #b0 #b11100110 #b00111)))

(assert (= expect result))

(check-sat)
(exit)
