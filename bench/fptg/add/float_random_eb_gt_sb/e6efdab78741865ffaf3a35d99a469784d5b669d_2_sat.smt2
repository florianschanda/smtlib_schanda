; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111100011001 #b0010001)
                arg1
                (fp #b0 #b000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b000000000000 #b1100101)
                arg1
                (fp #b0 #b100000011011 #b1011100)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100010000001 #b0101111)
                arg2
                (fp #b0 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111111)
                arg2
                (fp #b0 #b111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
