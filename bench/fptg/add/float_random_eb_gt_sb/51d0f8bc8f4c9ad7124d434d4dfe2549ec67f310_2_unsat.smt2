(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11010101 #b0111)
                arg1
                (fp #b1 #b01000000 #b0000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000)
                arg1
                (fp #b0 #b11111100 #b0001)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01001011 #b1101)
                arg2
                (fp #b0 #b00000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000 #b0100)
                arg2
                (fp #b0 #b11011010 #b0001)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10011111 #b1111)
                expect
                (fp #b1 #b01000000 #b0000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000)
                expect
                (fp #b0 #b11111100 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
