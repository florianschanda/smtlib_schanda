; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1000001001 #b010)
                arg1
                (fp #b0 #b1100000011 #b000)))
(assert (fp.leq (fp #b0 #b1100000011 #b000)
                arg1
                (fp #b0 #b1111001101 #b111)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000011000 #b100)
                arg2
                (fp #b0 #b0001111100 #b010)))
(assert (fp.leq (fp #b0 #b0001111100 #b010)
                arg2
                (fp #b0 #b1011101100 #b111)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010100000 #b110)
                expect
                (fp #b0 #b1100000011 #b001)))
(assert (fp.leq (fp #b0 #b1100000011 #b001)
                expect
                (fp #b0 #b1100010000 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
