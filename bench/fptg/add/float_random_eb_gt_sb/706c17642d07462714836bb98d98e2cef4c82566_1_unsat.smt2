; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b11101)
                arg1
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                arg1
                (fp #b1 #b1111110011 #b01110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100001111 #b10001)
                arg2
                (fp #b0 #b1000000100 #b00011)))
(assert (fp.leq (fp #b0 #b1000000100 #b00011)
                arg2
                (fp #b0 #b1110001111 #b01000)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b01000)
                expect
                (fp #b1 #b1111111100 #b11111)))
(assert (fp.leq (fp #b1 #b1111111100 #b11111)
                expect
                (fp #b1 #b1000001000 #b01111)))

(assert (not (= expect result)))

(check-sat)
(exit)
