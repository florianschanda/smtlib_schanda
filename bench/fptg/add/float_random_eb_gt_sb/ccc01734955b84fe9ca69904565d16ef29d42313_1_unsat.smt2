(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b1001110110111001 #b101000)
                arg2
                (fp #b0 #b1100000111000000 #b011001)))
(assert (fp.leq (fp #b0 #b1100000111000000 #b011001)
                arg2
                (fp #b0 #b1101001010110101 #b110011)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
