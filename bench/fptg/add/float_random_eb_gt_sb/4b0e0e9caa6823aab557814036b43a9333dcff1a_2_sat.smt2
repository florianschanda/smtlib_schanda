(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101000101 #b11011)
                arg1
                (fp #b1 #b1100001011 #b01010)))
(assert (fp.leq (fp #b1 #b1100001011 #b01010)
                arg1
                (fp #b1 #b0111001000 #b11101)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0110011011 #b11111)
                arg2
                (fp #b1 #b0000000000 #b00001)))
(assert (fp.leq (fp #b1 #b0000000000 #b00001)
                arg2
                (fp #b0 #b1100010111 #b01111)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101100010 #b00111)
                expect
                (fp #b1 #b1100001011 #b01011)))
(assert (fp.leq (fp #b1 #b1100001011 #b01011)
                expect
                (fp #b1 #b1011110100 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
