(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1011110000 #b010)
                arg1
                (fp #b1 #b0000000000 #b111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111)
                arg1
                (fp #b0 #b0111110111 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001111011 #b100)
                arg2
                (fp #b0 #b1111001111 #b110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110)
                arg2
                (fp #b0 #b1111011100 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0100010000 #b001)
                expect
                (fp #b0 #b1111001111 #b101)))
(assert (fp.leq (fp #b0 #b1111001111 #b101)
                expect
                (fp #b0 #b1111010100 #b010)))

(assert (= expect result))

(check-sat)
(exit)
