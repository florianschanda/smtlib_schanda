(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b1000000000 #b111101)
                arg1
                (fp #b0 #b1111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000)
                arg1
                (fp #b0 #b1111111101 #b111011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101000101 #b011110)
                arg2
                (fp #b0 #b0000000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111)
                arg2
                (fp #b0 #b0011001111 #b100111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0011111100 #b011001)
                expect
                (fp #b0 #b1111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000)
                expect
                (fp #b0 #b1111111110 #b010000)))

(assert (= expect result))

(check-sat)
(exit)
