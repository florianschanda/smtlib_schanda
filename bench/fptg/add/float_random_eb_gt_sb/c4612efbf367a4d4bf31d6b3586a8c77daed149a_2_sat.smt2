; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b100001110 #b111110)
                arg1
                (fp #b0 #b111011100 #b100101)))
(assert (fp.leq (fp #b0 #b111011100 #b100101)
                arg1
                (fp #b0 #b111011110 #b001101)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100011100 #b101011)
                arg2
                (fp #b0 #b010101111 #b111110)))
(assert (fp.leq (fp #b0 #b010101111 #b111110)
                arg2
                (fp #b0 #b010111011 #b110110)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b101101000 #b111000)
                expect
                (fp #b0 #b111011100 #b100110)))
(assert (fp.leq (fp #b0 #b111011100 #b100110)
                expect
                (fp #b0 #b111110011 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
