; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10100001111101 #b01)
                arg1
                (fp #b1 #b10000000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000000010 #b00)
                arg1
                (fp #b1 #b00000100111011 #b00)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11110010000001 #b01)
                arg2
                (fp #b1 #b11101001011111 #b00)))
(assert (fp.leq (fp #b1 #b11101001011111 #b00)
                arg2
                (fp #b0 #b10010110110011 #b00)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111001100100 #b10)
                expect
                (fp #b1 #b11101001011111 #b01)))
(assert (fp.leq (fp #b1 #b11101001011111 #b01)
                expect
                (fp #b1 #b10001001000101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
