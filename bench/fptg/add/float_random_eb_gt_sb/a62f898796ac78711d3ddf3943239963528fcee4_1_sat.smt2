(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100011111 #b111)
                arg1
                (fp #b1 #b100000010 #b110)))
(assert (fp.leq (fp #b1 #b100000010 #b110)
                arg1
                (fp #b0 #b000010000 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100000001 #b101)
                arg2
                (fp #b0 #b000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000 #b000)
                arg2
                (fp #b0 #b000010000 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100110101 #b110)
                expect
                (fp #b1 #b100000010 #b110)))
(assert (fp.leq (fp #b1 #b100000010 #b110)
                expect
                (fp #b0 #b000101011 #b001)))

(assert (= expect result))

(check-sat)
(exit)
