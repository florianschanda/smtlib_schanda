(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0000010 #b000)
                arg1
                (fp #b0 #b1001110 #b101)))
(assert (fp.leq (fp #b0 #b1001110 #b101)
                arg1
                (fp #b0 #b1111100 #b001)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1100110 #b111)
                arg2
                (fp #b1 #b0000000 #b111)))
(assert (fp.leq (fp #b1 #b0000000 #b111)
                arg2
                (fp #b0 #b0110010 #b100)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111000 #b111)
                expect
                (fp #b0 #b1001110 #b101)))
(assert (fp.leq (fp #b0 #b1001110 #b101)
                expect
                (fp #b0 #b1100011 #b000)))

(assert (= expect result))

(check-sat)
(exit)
