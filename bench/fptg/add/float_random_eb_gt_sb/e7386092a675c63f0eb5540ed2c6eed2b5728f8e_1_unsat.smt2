;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11011100011101 #b1011100011)
                arg2
                (fp #b1 #b10011000000011 #b0100011111)))
(assert (fp.leq (fp #b1 #b10011000000011 #b0100011111)
                arg2
                (fp #b1 #b00010110100001 #b0110100101)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
