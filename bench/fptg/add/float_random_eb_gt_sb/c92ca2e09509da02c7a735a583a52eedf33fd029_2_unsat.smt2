(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00111000 #b111)
                arg1
                (fp #b0 #b00000001 #b000)))
(assert (fp.leq (fp #b0 #b00000001 #b000)
                arg1
                (fp #b0 #b01110001 #b000)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00011000 #b101)
                arg2
                (fp #b0 #b11111101 #b000)))
(assert (fp.leq (fp #b0 #b11111101 #b000)
                arg2
                (fp #b0 #b11111101 #b011)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b10110000 #b101)
                expect
                (fp #b0 #b11111101 #b001)))
(assert (fp.leq (fp #b0 #b11111101 #b001)
                expect
                (fp #b0 #b11111101 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
