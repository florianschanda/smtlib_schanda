(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010001111010 #b010)
                arg1
                (fp #b0 #b010000000000 #b000)))
(assert (fp.leq (fp #b0 #b010000000000 #b000)
                arg1
                (fp #b0 #b100100101111 #b000)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011111100011 #b011)
                arg2
                (fp #b0 #b000000000000 #b011)))
(assert (fp.leq (fp #b0 #b000000000000 #b011)
                arg2
                (fp #b0 #b111111000110 #b100)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b000010110011 #b011)
                expect
                (fp #b0 #b010000000000 #b001)))
(assert (fp.leq (fp #b0 #b010000000000 #b001)
                expect
                (fp #b0 #b010100000110 #b011)))

(assert (= expect result))

(check-sat)
(exit)
