; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111001010001100 #b0111101)
                arg1
                (fp #b1 #b100000000000110 #b0000110)))
(assert (fp.leq (fp #b1 #b100000000000110 #b0000110)
                arg1
                (fp #b0 #b100111111110010 #b1110100)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101110000011101 #b1000101)
                arg2
                (fp #b1 #b000000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0100000)
                arg2
                (fp #b0 #b111001010101010 #b1111000)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b110100101000000 #b0011000)
                expect
                (fp #b1 #b100000000000110 #b0000110)))
(assert (fp.leq (fp #b1 #b100000000000110 #b0000110)
                expect
                (fp #b1 #b010010100001101 #b1110010)))

(assert (= expect result))

(check-sat)
(exit)
