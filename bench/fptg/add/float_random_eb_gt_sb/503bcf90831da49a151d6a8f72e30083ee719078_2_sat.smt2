; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110001111000101 #b1)
                arg1
                (fp #b1 #b000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1)
                arg1
                (fp #b0 #b011011110001011 #b0)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001111110101101 #b1)
                arg2
                (fp #b0 #b011111111111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111111111 #b1)
                arg2
                (fp #b0 #b111000000110110 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110100001001010 #b0)
                expect
                (fp #b0 #b011111111111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111111111 #b1)
                expect
                (fp #b0 #b101001100101001 #b1)))

(assert (= expect result))

(check-sat)
(exit)
