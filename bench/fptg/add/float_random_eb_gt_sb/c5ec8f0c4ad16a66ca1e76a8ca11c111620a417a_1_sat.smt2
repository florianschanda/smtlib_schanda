;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10100111 #b011111)
                arg1
                (fp #b1 #b00000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000 #b010000)
                arg1
                (fp #b0 #b10000010 #b110111)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111011 #b011101)
                arg2
                (fp #b1 #b00000000 #b111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111)
                arg2
                (fp #b0 #b10001001 #b000110)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b01001011 #b101111)
                expect
                (fp #b1 #b00000001 #b001111)))
(assert (fp.leq (fp #b1 #b00000001 #b001111)
                expect
                (fp #b0 #b01010000 #b010011)))

(assert (= expect result))

(check-sat)
(exit)
