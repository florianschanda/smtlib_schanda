(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10001101100110 #b00)
                arg1
                (fp #b0 #b01000000000000 #b00)))
(assert (fp.leq (fp #b0 #b01000000000000 #b00)
                arg1
                (fp #b0 #b11000100110011 #b01)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10101011101001 #b00)
                arg2
                (fp #b1 #b01111111111111 #b00)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00)
                arg2
                (fp #b0 #b01010001001010 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10011111000001 #b10)
                expect
                (fp #b1 #b01111111111111 #b00)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00)
                expect
                (fp #b0 #b10110101111010 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
