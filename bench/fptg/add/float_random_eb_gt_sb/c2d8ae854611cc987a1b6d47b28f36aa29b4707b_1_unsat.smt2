(assert (fp.leq (fp #b1 #b000000000000 #b00000001)
                arg2
                (fp #b0 #b101100111011 #b00000110)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001000001011 #b01111100)
                expect
                (fp #b0 #b001111111011 #b11111111)))
(assert (fp.leq (fp #b0 #b001111111011 #b11111111)
                expect
                (fp #b0 #b011100111111 #b10100011)))

(assert (not (= expect result)))

(check-sat)
