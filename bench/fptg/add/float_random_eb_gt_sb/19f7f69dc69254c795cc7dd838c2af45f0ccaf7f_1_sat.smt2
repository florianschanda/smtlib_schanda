(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10101001100 #b100100101)
                arg1
                (fp #b0 #b10000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b10000001000 #b110100101)
                arg1
                (fp #b0 #b10101101010 #b011101101)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00100100100 #b111111010)
                arg2
                (fp #b0 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000000)
                arg2
                (fp #b0 #b01010100000 #b110001000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b01010001000 #b000010001)
                expect
                (fp #b0 #b10000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b10000001000 #b110100101)
                expect
                (fp #b0 #b11101001111 #b100101010)))

(assert (= expect result))

(check-sat)
(exit)
