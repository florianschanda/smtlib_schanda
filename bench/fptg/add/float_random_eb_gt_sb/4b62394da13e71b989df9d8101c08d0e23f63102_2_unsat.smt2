(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b001101110100 #b0111010)
                arg1
                (fp #b0 #b000000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b000000000000 #b1011100)
                arg1
                (fp #b0 #b101111000111 #b0101110)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000011110111 #b1101100)
                expect
                (fp #b1 #b000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000)
                expect
                (fp #b0 #b111110011100 #b0010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
