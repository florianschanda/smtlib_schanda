;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11000101001001 #b11110)
                arg1
                (fp #b0 #b01000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b00000)
                arg1
                (fp #b0 #b10111000101011 #b01010)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11001100011100 #b00011)
                arg2
                (fp #b1 #b10001001000101 #b01100)))
(assert (fp.leq (fp #b1 #b10001001000101 #b01100)
                arg2
                (fp #b0 #b01010110101001 #b01001)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10100011100100 #b01101)
                expect
                (fp #b1 #b10001001000101 #b01011)))
(assert (fp.leq (fp #b1 #b10001001000101 #b01011)
                expect
                (fp #b0 #b00011100100101 #b10100)))

(assert (= expect result))

(check-sat)
(exit)
