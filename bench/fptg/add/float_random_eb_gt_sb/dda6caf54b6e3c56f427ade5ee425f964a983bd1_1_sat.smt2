(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10101000 #b1111)
                arg1
                (fp #b0 #b00000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111)
                arg1
                (fp #b0 #b10101011 #b0111)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00110010 #b1110)
                arg2
                (fp #b0 #b10111110 #b1111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111)
                arg2
                (fp #b0 #b11111011 #b0001)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01001000 #b0101)
                expect
                (fp #b0 #b10111110 #b1111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111)
                expect
                (fp #b0 #b11010111 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
