(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011101111 #b0110)
                arg1
                (fp #b0 #b1100100111 #b1000)))
(assert (fp.leq (fp #b0 #b1100100111 #b1000)
                arg1
                (fp #b0 #b1101111101 #b1010)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0101110101 #b0100)
                arg2
                (fp #b0 #b0100000000 #b0000)))
(assert (fp.leq (fp #b0 #b0100000000 #b0000)
                arg2
                (fp #b0 #b1110010000 #b1000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b1010011010 #b0100)
                expect
                (fp #b0 #b1100100111 #b1001)))
(assert (fp.leq (fp #b0 #b1100100111 #b1001)
                expect
                (fp #b0 #b1111110010 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
