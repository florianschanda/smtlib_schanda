(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1110001101011011 #b1010)
                arg1
                (fp #b1 #b1101111101101000 #b0101)))
(assert (fp.leq (fp #b1 #b1101111101101000 #b0101)
                arg1
                (fp #b0 #b0000110100100100 #b0110)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0111000100111010 #b1011)
                arg2
                (fp #b0 #b0011111111111110 #b0000)))
(assert (fp.leq (fp #b0 #b0011111111111110 #b0000)
                arg2
                (fp #b0 #b1100001001101001 #b0010)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1110001001001110 #b0000)
                expect
                (fp #b1 #b1101111101101000 #b0101)))
(assert (fp.leq (fp #b1 #b1101111101101000 #b0101)
                expect
                (fp #b0 #b1111010001001001 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
