(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b1110110 #b1010000100001101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111000 #b0010111000100010)
                expect
                (fp #b0 #b0100001 #b0110000110111010)))
(assert (fp.leq (fp #b0 #b0100001 #b0110000110111010)
                expect
                (fp #b0 #b1100110 #b0010000100110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
