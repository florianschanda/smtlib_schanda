                arg2
                (fp #b0 #b1101011 #b0010111100111010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0100000100100000)
                expect
                (fp #b1 #b0000001 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b0000001 #b1111111111111110)
                expect
                (fp #b0 #b0111111 #b1011111100000110)))

(assert (= expect result))

(check-sat)
