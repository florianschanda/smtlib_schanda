(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b1000011 #b0101000111000010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b1100000000000110)
                expect
                (fp #b0 #b0000000 #b1000100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b1000100111101010)
                expect
                (fp #b0 #b0101000 #b0001000101010101)))

(assert (= expect result))

(check-sat)
(exit)
