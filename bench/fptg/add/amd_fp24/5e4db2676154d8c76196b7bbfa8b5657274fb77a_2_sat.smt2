                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b0111001 #b0111100011011000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010011 #b1110100000011000)
                expect
                (fp #b0 #b0110101 #b1101010110011010)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011010)
                expect
                (fp #b0 #b1111110 #b1011000011111010)))

(assert (= expect result))

(check-sat)
(exit)
