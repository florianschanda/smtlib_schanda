(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b1011010110111011)
                arg1
                (fp #b1 #b0000000 #b1010101010101000)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101000)
                arg1
                (fp #b0 #b0001110 #b1100001111100101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100111 #b0101010010011000)
                arg2
                (fp #b0 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000000000000)
                arg2
                (fp #b0 #b1111101 #b0000100101110110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100111 #b0000100000011111)
                expect
                (fp #b0 #b1111100 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111100 #b1111111111111111)
                expect
                (fp #b0 #b1111101 #b1100101011111011)))

(assert (= expect result))

(check-sat)
(exit)
