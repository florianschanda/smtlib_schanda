(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1011000 #b0100110001011010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101010 #b1100011011110000)
                expect
                (fp #b1 #b0010111 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0010111 #b1111111111111111)
                expect
                (fp #b0 #b0011100 #b1001111000100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
