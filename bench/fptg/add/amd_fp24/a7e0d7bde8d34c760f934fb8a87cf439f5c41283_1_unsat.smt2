;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b0001110000100010)
                arg1
                (fp #b0 #b0000000 #b1010110011010011)))
(assert (fp.leq (fp #b0 #b0000000 #b1010110011010011)
                arg1
                (fp #b0 #b0000110 #b0111001100100100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b1110100000111110)
                arg2
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0000000 #b0011101100011100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b1001001011100000)
                expect
                (fp #b1 #b0000000 #b0101001100101100)))
(assert (fp.leq (fp #b1 #b0000000 #b0101001100101100)
                expect
                (fp #b0 #b1010000 #b1110111011110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
