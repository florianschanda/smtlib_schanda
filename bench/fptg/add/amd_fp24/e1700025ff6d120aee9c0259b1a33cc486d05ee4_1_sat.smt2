(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000100 #b0001001010110101)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b0110000 #b0100000010000111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111110 #b1000100101100011)
                arg2
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1101111 #b0011001100010000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0111111001100001)
                expect
                (fp #b0 #b0011111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0011111 #b1111111111111111)
                expect
                (fp #b0 #b1100100 #b0100010101011100)))

(assert (= expect result))

(check-sat)
(exit)
