; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1100001101000000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b1001001 #b1110110100010100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110011 #b0000111110101101)
                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1101111 #b0100101011011000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0100001000001010)
                expect
                (fp #b1 #b0111111 #b0110101011101001)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101001)
                expect
                (fp #b0 #b0001111 #b1111010000000110)))

(assert (= expect result))

(check-sat)
(exit)
