                arg2
                (fp #b0 #b1000010 #b0011101001100110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b1000100100111000)
                expect
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                expect
                (fp #b0 #b0101101 #b1011110010011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
