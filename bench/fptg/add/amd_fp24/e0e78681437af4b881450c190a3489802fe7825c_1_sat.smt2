(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b0000010 #b0001000001001110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b0111101000001001)
                expect
                (fp #b1 #b0000001 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0100000000000000)
                expect
                (fp #b0 #b0011011 #b0000010001101111)))

(assert (= expect result))

(check-sat)
(exit)
