                (fp #b0 #b1000001 #b0001010001101110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001101 #b1110100111001100)
                arg2
                (fp #b1 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b0010101 #b0111111011101101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0110011010010111)
                expect
                (fp #b0 #b0001001 #b1011100101100001)))
(assert (fp.leq (fp #b0 #b0001001 #b1011100101100001)
                expect
                (fp #b0 #b1110000 #b1111001111001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
