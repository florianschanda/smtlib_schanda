                arg2
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b1000000 #b1001110001100101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b0001101110101001)
                expect
                (fp #b1 #b0011000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000001)
                expect
                (fp #b0 #b0000111 #b0000110011101100)))

(assert (= expect result))

(check-sat)
(exit)
