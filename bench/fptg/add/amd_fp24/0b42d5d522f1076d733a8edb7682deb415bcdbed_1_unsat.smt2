; Format: AMD_FP24
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b1000001101101010)
                arg1
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg1
                (fp #b0 #b1111111 #b0000000000000000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101000 #b0110111110100000)
                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1101100 #b1101111101010110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100000 #b0111011001110101)
                expect
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                expect
                (fp #b0 #b1111111 #b0000000000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
