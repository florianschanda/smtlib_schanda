; Format: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0100101000101111)
                arg1
                (fp #b1 #b1111001 #b1011010110111001)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010110111001)
                arg1
                (fp #b0 #b0010011 #b0001000001111000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010100 #b1100001111010010)
                arg2
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg2
                (fp #b0 #b0011101 #b0001100001000101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b1010000100111000)
                expect
                (fp #b1 #b1111001 #b1011010110111000)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010110111000)
                expect
                (fp #b1 #b1101100 #b1101001110101101)))

(assert (= expect result))

(check-sat)
(exit)
