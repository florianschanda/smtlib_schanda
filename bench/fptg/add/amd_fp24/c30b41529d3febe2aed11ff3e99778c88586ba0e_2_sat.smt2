(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011101 #b0010110010000001)
                arg1
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                arg1
                (fp #b0 #b1001000 #b0111100000111101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010010 #b1000001111001001)
                arg2
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                arg2
                (fp #b0 #b1111000 #b0001111011001011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111100 #b0101011010110011)
                expect
                (fp #b0 #b1010110 #b0010110110100101)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100101)
                expect
                (fp #b0 #b1111100 #b1001000100011100)))

(assert (= expect result))

(check-sat)
(exit)
