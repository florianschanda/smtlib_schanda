(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1110001 #b1100001001001111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b0100100011101110)
                expect
                (fp #b1 #b0000000 #b1011111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1011111111111111)
                expect
                (fp #b0 #b0100100 #b1010101001010010)))

(assert (not (= expect result)))

(check-sat)
