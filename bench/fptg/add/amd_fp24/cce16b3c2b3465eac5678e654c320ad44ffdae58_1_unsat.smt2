                arg2
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1010110 #b1011011101010110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101010 #b0101110101100100)
                expect
                (fp #b0 #b0010111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0010111 #b1111111111111111)
                expect
                (fp #b0 #b0101011 #b1010000111101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
