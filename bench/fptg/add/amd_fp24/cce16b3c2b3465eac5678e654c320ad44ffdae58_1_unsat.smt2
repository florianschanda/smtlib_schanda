(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101110 #b1101001100010101)
                arg1
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg1
