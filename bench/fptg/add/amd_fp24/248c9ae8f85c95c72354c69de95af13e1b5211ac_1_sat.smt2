(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0101101110010000)
                arg1
                (fp #b0 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000000000000)
                arg1
                (fp #b0 #b1111101 #b1111100010110111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100010 #b0110101001110101)
                arg2
                (fp #b1 #b0001001 #b0010000001100101)))
(assert (fp.leq (fp #b1 #b0001001 #b0010000001100101)
                arg2
                (fp #b0 #b1100011 #b1011101001110010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000010 #b0111011000010101)
                expect
                (fp #b0 #b1111100 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111100 #b1111111111111111)
                expect
                (fp #b0 #b1111101 #b0010000101001011)))

(assert (= expect result))

(check-sat)
(exit)
