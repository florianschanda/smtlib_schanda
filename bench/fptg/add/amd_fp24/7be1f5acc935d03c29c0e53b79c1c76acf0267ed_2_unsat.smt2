                arg2
                (fp #b1 #b1010001 #b0110000100010100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b0001010110010011)
                expect
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                expect
                (fp #b1 #b1100100 #b1000010110111111)))

(assert (not (= expect result)))

(check-sat)
