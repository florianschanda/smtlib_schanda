;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110010 #b1011010011010110)
                arg1
                (fp #b0 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b0100110 #b0110100100011111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1001111 #b1011011100110100)
                arg2
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                arg2
                (fp #b0 #b1101010 #b1000011000010010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010000 #b0010100111110011)
                expect
                (fp #b0 #b1100010 #b0010111010111000)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010111000)
                expect
                (fp #b0 #b1111000 #b0101101111110111)))

(assert (= expect result))

(check-sat)
(exit)
