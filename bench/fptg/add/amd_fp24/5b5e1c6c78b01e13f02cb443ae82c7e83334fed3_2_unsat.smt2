;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0110001001010100)
                arg1
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b1111000 #b0001000101001110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010001 #b0000100101001110)
                arg2
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg2
                (fp #b0 #b1110001 #b0101100000101110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100110 #b0101110110101111)
                expect
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                expect
                (fp #b0 #b0101110 #b0000011110110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
