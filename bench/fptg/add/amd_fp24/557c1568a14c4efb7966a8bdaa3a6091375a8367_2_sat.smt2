; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110100 #b0001101010100010)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1111010 #b1010001101101111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b1101111110011011)
                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b0 #b0100001 #b0010011000001001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0111000011001101)
                expect
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                expect
                (fp #b0 #b0101011 #b1010101101110110)))

(assert (= expect result))

(check-sat)
(exit)
