(assert (fp.leq (fp #b1 #b0001001 #b0010000001100101)
                arg2
                (fp #b0 #b0011010 #b1011011101100001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100110 #b0101111111110010)
                expect
                (fp #b0 #b0111111 #b0000011100001011)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001011)
                expect
                (fp #b0 #b1011000 #b0100100001100001)))

(assert (= expect result))

(check-sat)
(exit)
