; Format: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b0101001111011000)
                arg1
                (fp #b1 #b0000000 #b1111110111101011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111110111101011)
                arg1
                (fp #b0 #b0101010 #b1011101011101010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b0010000110100001)
                arg2
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b1000101 #b1000011111011001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011011 #b0110010100100101)
                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1100111 #b0110101100010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
