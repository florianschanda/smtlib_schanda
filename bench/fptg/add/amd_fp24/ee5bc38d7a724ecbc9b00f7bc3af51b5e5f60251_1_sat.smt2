                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b1 #b0010100 #b0111010101100101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b1100010000110011)
                expect
                (fp #b1 #b0100000 #b0000010101001111)))
(assert (fp.leq (fp #b1 #b0100000 #b0000010101001111)
                expect
                (fp #b0 #b0011101 #b1001110100010001)))

(assert (= expect result))

(check-sat)
(exit)
