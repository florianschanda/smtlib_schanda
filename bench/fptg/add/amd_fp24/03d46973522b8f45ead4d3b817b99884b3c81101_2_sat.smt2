(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b1 #b0101101 #b1010110111110010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1100010100000111)
                expect
                (fp #b1 #b1111001 #b1011010111000111)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010111000111)
                expect
                (fp #b0 #b0001100 #b0000101010110100)))

(assert (= expect result))

(check-sat)
(exit)
