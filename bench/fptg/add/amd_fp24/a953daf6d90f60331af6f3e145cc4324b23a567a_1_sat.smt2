(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0011100 #b1111100101001010)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b0011100 #b1000110000110110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0000100011111011)
                arg2
                (fp #b1 #b0111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1011110111011110)
                arg2
                (fp #b0 #b1101000 #b0010100010010100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b0111011000000010)
                expect
                (fp #b1 #b0111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b0111111 #b1011110111011110)
                expect
                (fp #b0 #b0111011 #b0001000010110100)))

(assert (= expect result))

(check-sat)
(exit)
