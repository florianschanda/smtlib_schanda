(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +INT_BOUNDARY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b0001100100110010)
                arg1
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b1100111 #b1000110001011001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111101 #b1010001101000011)
                arg2
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b0100111 #b1000101110101101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b0000001001111111)
                expect
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                expect
                (fp #b0 #b1010101 #b0010101000101010)))

(assert (= expect result))

(check-sat)
(exit)
