; Format: AMD_FP24
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b1011010111010110)
                arg1
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b0100001 #b0000001001000110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010101 #b0011111110010000)
                arg2
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b0010101 #b1111011010011010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b0101100101101001)
                expect
                (fp #b1 #b0000000 #b1011111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1011111111111111)
                expect
                (fp #b0 #b0011001 #b0001110100010101)))

(assert (= expect result))

(check-sat)
(exit)
