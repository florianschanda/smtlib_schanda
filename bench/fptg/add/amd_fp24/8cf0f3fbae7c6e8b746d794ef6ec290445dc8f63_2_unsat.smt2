; Format: AMD_FP24
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100101 #b0011101100101111)
                arg1
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b1011110 #b0000010101001111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0000100001001110)
                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b0 #b0111110 #b1000011110100010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1111001001100001)
                expect
                (fp #b1 #b1011100 #b1111011010001111)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001111)
                expect
                (fp #b0 #b0000111 #b1111001100000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
