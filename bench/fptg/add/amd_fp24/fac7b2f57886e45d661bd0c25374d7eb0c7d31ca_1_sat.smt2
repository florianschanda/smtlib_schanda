(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110111 #b0001010010000001)
                expect
                (fp #b0 #b0000001 #b1010110011010010)))
(assert (fp.leq (fp #b0 #b0000001 #b1010110011010010)
                expect
                (fp #b0 #b1000110 #b0010000110111101)))

(assert (= expect result))

(check-sat)
