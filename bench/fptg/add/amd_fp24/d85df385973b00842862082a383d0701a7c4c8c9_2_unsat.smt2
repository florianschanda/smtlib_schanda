; Format: AMD_FP24
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
