(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1011011110010101)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b0 #b1000100 #b0001010110001111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0111000111001100)
                arg2
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b0100001 #b1001100110001110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011011 #b0101010100010000)
                expect
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                expect
                (fp #b0 #b0000110 #b1010111111011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
