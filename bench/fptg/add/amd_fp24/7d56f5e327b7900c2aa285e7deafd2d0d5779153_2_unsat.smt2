                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0001110 #b1000011010101010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010011 #b0110000001100110)
                expect
                (fp #b0 #b1001111 #b0010101011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110001)
                expect
                (fp #b0 #b1111001 #b1001000101100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
