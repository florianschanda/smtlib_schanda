                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1111011 #b1010111111111000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b1100101000101001)
                expect
                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                expect
                (fp #b0 #b1000110 #b0010011110000110)))

(assert (= expect result))

(check-sat)
(exit)
