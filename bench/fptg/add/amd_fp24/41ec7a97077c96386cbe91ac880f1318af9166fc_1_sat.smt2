;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1001011100010100)
                arg1
                (fp #b0 #b0000000 #b0011101110101100)))
(assert (fp.leq (fp #b0 #b0000000 #b0011101110101100)
