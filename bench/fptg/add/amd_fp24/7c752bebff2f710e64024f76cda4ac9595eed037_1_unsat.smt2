(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b1100111100001001)
                arg2
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b1101101 #b1001011111001011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101001 #b0010101101011110)
                expect
                (fp #b0 #b0000000 #b0011111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b0011111111111111)
                expect
                (fp #b0 #b1110111 #b0000101001101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
