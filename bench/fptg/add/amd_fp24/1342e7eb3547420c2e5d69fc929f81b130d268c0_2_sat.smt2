; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1011110111100001)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1110111 #b1111001011001010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010111 #b0111100000100000)
                arg2
                (fp #b1 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b0101001 #b1100010011111110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110010 #b1110011110010100)
                expect
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                expect
                (fp #b0 #b1111101 #b0110011110000110)))

(assert (= expect result))

(check-sat)
(exit)
