                (fp #b0 #b0000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b1111110 #b0101111101001110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b0110100000101101)
                expect
                (fp #b0 #b0001001 #b1011101010011101)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101010011101)
                expect
                (fp #b0 #b1111000 #b1101101100110110)))

(assert (= expect result))

(check-sat)
(exit)
