; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0011000010110011)
                arg1
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg1
                (fp #b0 #b0000011 #b1000000000101010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b0101111110110100)
                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b0 #b1000010 #b0011101100010000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b1011101101010011)
                expect
                (fp #b1 #b1001110 #b0100010010110011)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110011)
                expect
                (fp #b0 #b1001111 #b0000011010001010)))

(assert (= expect result))

(check-sat)
(exit)
