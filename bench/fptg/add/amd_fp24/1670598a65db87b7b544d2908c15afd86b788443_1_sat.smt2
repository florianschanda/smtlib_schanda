(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0011010101010000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b1 #b0010000 #b0011001111110100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b1011010101110101)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b1 #b0110010 #b1110110010011110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0100011110011110)
                expect
                (fp #b1 #b1001110 #b0001100011000000)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100011000000)
                expect
                (fp #b1 #b1000001 #b0111010011001000)))

(assert (= expect result))

(check-sat)
(exit)
