; Format: AMD_FP24
; Arg1: +ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b0000110011010110)
                arg1
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1100100 #b0111111000111110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b0111101101110010)
                arg2
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b1 #b0000101 #b0000100111011001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0000011111100101)
                expect
                (fp #b1 #b1101100 #b1011000110011000)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011000)
                expect
                (fp #b0 #b1110001 #b1001111010010001)))

(assert (= expect result))

(check-sat)
(exit)
