; Format: AMD_FP24
; Arg1: -LARGEST_NORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                arg1
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                arg1
                (fp #b0 #b0100110 #b0010100010001101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0101100 #b0011001100011000)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b1101001 #b1100011100100111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                expect
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                expect
                (fp #b0 #b0111110 #b0001011011101000)))

(assert (= expect result))

(check-sat)
(exit)
