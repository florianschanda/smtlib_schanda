                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1101001 #b0000011010001100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b0100101101100101)
                arg2
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b0001100 #b1111110110000110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b0011001000110111)
                expect
                (fp #b0 #b0100000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000001)
                expect
                (fp #b0 #b1010101 #b0111001001011110)))

(assert (= expect result))

(check-sat)
(exit)
