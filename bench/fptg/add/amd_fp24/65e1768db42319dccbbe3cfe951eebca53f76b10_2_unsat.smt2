; Format: AMD_FP24
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0111100111001000)
                arg1
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg1
                (fp #b1 #b0101010 #b1101110010011100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010001 #b0001001011111110)
                arg2
                (fp #b0 #b1100111 #b1010000011110001)))
(assert (fp.leq (fp #b0 #b1100111 #b1010000011110001)
                arg2
                (fp #b0 #b1101111 #b0000110100100111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0111001111000010)
                expect
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                expect
                (fp #b0 #b1101101 #b0010110100010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
