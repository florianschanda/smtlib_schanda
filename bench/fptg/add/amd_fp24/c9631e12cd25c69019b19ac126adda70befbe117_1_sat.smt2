(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b0010010 #b0110010001100000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1011011001111011)
                expect
                (fp #b1 #b0000000 #b1010101010101001)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101001)
                expect
                (fp #b0 #b0011111 #b0100110100111110)))

(assert (= expect result))

(check-sat)
