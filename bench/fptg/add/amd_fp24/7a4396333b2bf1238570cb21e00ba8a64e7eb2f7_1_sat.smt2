; Format: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0000101010111000)
                arg1
                (fp #b1 #b1111001 #b1011010110111001)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010110111001)
                arg1
                (fp #b0 #b0001100 #b1101010001110100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000100 #b1000010000011001)
                arg2
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b1101011 #b1100100010101111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1110000010011101)
                expect
                (fp #b1 #b1111001 #b1011010110111000)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010110111000)
                expect
                (fp #b1 #b0001101 #b0001010100100111)))

(assert (= expect result))

(check-sat)
(exit)
