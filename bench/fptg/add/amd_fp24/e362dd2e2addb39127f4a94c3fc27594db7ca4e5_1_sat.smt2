(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110010 #b0001001001010010)
                arg1
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                arg1
                (fp #b0 #b1110100 #b1011011110100100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010000 #b1000110000100011)
                arg2
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b0111110 #b0011000111100011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110001 #b0100111111101010)
                expect
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                expect
                (fp #b0 #b0001110 #b1011010111000110)))

(assert (= expect result))

(check-sat)
(exit)
