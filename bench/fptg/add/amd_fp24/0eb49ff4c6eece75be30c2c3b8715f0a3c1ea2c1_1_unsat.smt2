(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001101 #b0100111110010010)
                expect
                (fp #b1 #b0000000 #b0001011011010000)))
(assert (fp.leq (fp #b1 #b0000000 #b0001011011010000)
                expect
                (fp #b0 #b0001001 #b0001111101101001)))

(assert (not (= expect result)))

(check-sat)
