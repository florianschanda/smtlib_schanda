;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1100011100100000)
                arg1
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                arg1
                (fp #b0 #b1100000 #b0011110100101100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011110 #b0000000101100001)
                arg2
                (fp #b1 #b0111111 #b1110000000110000)))
(assert (fp.leq (fp #b1 #b0111111 #b1110000000110000)
                arg2
                (fp #b1 #b0100010 #b0010011010001101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1111100111110111)
                expect
                (fp #b1 #b1110111 #b1100101001010001)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010001)
                expect
                (fp #b0 #b1011111 #b0011110000001011)))

(assert (= expect result))

(check-sat)
(exit)
