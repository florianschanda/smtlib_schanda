(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0001101111001101)
                arg1
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b1110011 #b1011110011010101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0110010000011000)
                arg2
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg2
                (fp #b1 #b0110100 #b1111011100001110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b1000111110100110)
                expect
                (fp #b1 #b1001111 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1001111 #b1111111111111111)
                expect
                (fp #b1 #b0100000 #b1001001101111101)))

(assert (= expect result))

(check-sat)
(exit)
