(assert (fp.leq (fp #b0 #b0000010 #b1101101001101011)
                arg2
                (fp #b0 #b1010010 #b0001101001100100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1001010011100100)
                expect
                (fp #b0 #b0000011 #b0001100001101010)))
(assert (fp.leq (fp #b0 #b0000011 #b0001100001101010)
                expect
                (fp #b0 #b1110101 #b1011110011010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
