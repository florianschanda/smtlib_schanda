(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1011101000000010)
                arg1
                (fp #b1 #b0000000 #b1010101010101000)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101000)
                arg1
                (fp #b0 #b1100000 #b1100101111101111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101000 #b0101000000111101)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1101001 #b0100100010110010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b0001011101100001)
                expect
                (fp #b0 #b1001101 #b0110101110101011)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101011)
                expect
                (fp #b0 #b1010000 #b1111011001100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
