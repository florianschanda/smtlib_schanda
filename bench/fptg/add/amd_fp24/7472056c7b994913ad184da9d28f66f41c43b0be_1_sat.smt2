(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -ZERO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1011111 #b0100101001011001)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b0011101 #b0101100110111001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111001 #b0101010011101010)
                arg2
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg2
                (fp #b0 #b0100111 #b1111101110110010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0100100000000111)
                expect
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                expect
                (fp #b0 #b0110101 #b0110100010101011)))

(assert (= expect result))

(check-sat)
(exit)
