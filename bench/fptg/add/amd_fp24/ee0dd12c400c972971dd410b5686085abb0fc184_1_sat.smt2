(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110110 #b0001010111101101)
                arg1
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b0000100 #b0100010011011011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b1111000001111100)
                arg2
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg2
                (fp #b0 #b1110110 #b0001100011001001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100110 #b1011011100010100)
                expect
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                expect
                (fp #b0 #b0110100 #b0010001001000010)))

(assert (= expect result))

(check-sat)
(exit)
