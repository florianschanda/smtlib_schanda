(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100001 #b0101011111100000)
                arg1
                (fp #b0 #b0100001 #b0110000110111010)))
(assert (fp.leq (fp #b0 #b0100001 #b0110000110111010)
                arg1
                (fp #b0 #b1001000 #b1011111001110010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000001 #b1110100010101110)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1110100 #b0011000101100110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1001010 #b1011011111110000)
                expect
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                expect
                (fp #b0 #b1100000 #b0010100011011100)))

(assert (= expect result))

(check-sat)
(exit)
