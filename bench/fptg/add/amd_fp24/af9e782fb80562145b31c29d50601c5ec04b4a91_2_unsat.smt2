(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101001 #b1110010010111111)
                expect
                (fp #b0 #b0011000 #b0000000000000100)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000100)
                expect
                (fp #b0 #b0100010 #b0000110010100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
