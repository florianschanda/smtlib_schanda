(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b0010010101111111)
                arg1
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b0101001 #b1110011000101100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001001 #b0101110100111111)
                arg2
                (fp #b1 #b0001001 #b0010000001100101)))
(assert (fp.leq (fp #b1 #b0001001 #b0010000001100101)
                arg2
                (fp #b0 #b0010111 #b0001010001110100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001000 #b0100010001110000)
                expect
                (fp #b1 #b0001001 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b0001001 #b0001111101100110)
                expect
                (fp #b0 #b0001100 #b0110010101011100)))

(assert (= expect result))

(check-sat)
(exit)
