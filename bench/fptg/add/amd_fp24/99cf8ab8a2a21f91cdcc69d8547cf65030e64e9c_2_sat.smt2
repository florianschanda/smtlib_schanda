;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111100 #b0010000100001101)
                arg1
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b1011100 #b0110011110110111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0111101110000010)
                arg2
                (fp #b0 #b0000010 #b1101101001101011)))
(assert (fp.leq (fp #b0 #b0000010 #b1101101001101011)
                arg2
                (fp #b0 #b0111010 #b1111111011101010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1010100000101001)
                expect
                (fp #b0 #b0000011 #b0010110100110110)))
(assert (fp.leq (fp #b0 #b0000011 #b0010110100110110)
                expect
                (fp #b0 #b0010111 #b1000100000000001)))

(assert (= expect result))

(check-sat)
(exit)
