; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
