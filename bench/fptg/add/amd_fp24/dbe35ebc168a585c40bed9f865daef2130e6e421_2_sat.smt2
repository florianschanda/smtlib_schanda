;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1011110100000110)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1101001 #b1011011110001011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010111 #b1100110011010100)
                arg2
                (fp #b0 #b0000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b1110000 #b0001000010011101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1010001 #b1000101101000111)
                expect
                (fp #b0 #b1011011 #b0101010011100110)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100110)
                expect
                (fp #b0 #b1011100 #b0010111000001000)))

(assert (= expect result))

(check-sat)
(exit)
