(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0100110010100000)
                expect
                (fp #b1 #b1111100 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111100 #b1111111111111111)
                expect
                (fp #b1 #b1001101 #b0011010011011101)))

(assert (not (= expect result)))

(check-sat)
