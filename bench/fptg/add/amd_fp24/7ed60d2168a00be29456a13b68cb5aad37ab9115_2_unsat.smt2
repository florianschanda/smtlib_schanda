(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1100100 #b0110011000111100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b1101101101110101)
                expect
                (fp #b0 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1011111 #b0000000000000000)
                expect
                (fp #b0 #b1100110 #b1111110101001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
