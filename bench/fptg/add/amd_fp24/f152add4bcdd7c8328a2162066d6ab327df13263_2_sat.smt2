                arg2
                (fp #b0 #b1010110 #b0000000011011000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0111101010110010)
                expect
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                expect
                (fp #b0 #b1000100 #b1001111100100010)))

(assert (= expect result))

(check-sat)
