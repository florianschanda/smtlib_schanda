(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0011100110111001)
                arg1
                (fp #b1 #b0011010 #b0101001111100000)))
(assert (fp.leq (fp #b1 #b0011010 #b0101001111100000)
                arg1
                (fp #b0 #b0110011 #b0101110110000101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
