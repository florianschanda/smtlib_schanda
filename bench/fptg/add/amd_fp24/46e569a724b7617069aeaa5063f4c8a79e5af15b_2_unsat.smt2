                arg2
                (fp #b0 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b1101110 #b1110000100101000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b1111111100110100)
                expect
                (fp #b0 #b1101001 #b0010001000011001)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011001)
                expect
                (fp #b0 #b1111101 #b1011010000000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
