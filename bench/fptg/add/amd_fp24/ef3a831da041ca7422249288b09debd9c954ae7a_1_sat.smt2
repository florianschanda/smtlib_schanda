                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b1110111 #b1111001000011110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b1100010100101110)
                expect
                (fp #b0 #b0110101 #b1101010110011000)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011000)
                expect
                (fp #b0 #b1100001 #b1011110000010100)))

(assert (= expect result))

(check-sat)
(exit)
