;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001101 #b1110111010000110)
                arg1
                (fp #b1 #b0000000 #b1111110111101011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111110111101011)
                arg1
                (fp #b0 #b1110000 #b0110111001101000)))

