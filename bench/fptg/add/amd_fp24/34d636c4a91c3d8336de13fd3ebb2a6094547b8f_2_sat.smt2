(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b0 #b0000001 #b1101110111110000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b0110110100010111)
                expect
                (fp #b1 #b1101100 #b1011000110011010)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011010)
                expect
                (fp #b1 #b0010110 #b1011000100101001)))

(assert (= expect result))

(check-sat)
(exit)
