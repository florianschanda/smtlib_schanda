(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b1010111111010010)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b0 #b1111100 #b1111101111011101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110000 #b0010000000001011)
                arg2
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1101000 #b1011000011111001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b1011011101101111)
                expect
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                expect
                (fp #b1 #b1000001 #b1010101111000111)))

(assert (= expect result))

(check-sat)
(exit)
