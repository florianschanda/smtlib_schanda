                arg2
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg2
                (fp #b0 #b0111111 #b1111100010110011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0010000111011010)
                expect
                (fp #b1 #b1111101 #b0001101101011100)))
(assert (fp.leq (fp #b1 #b1111101 #b0001101101011100)
                expect
                (fp #b1 #b1100100 #b1011001011101010)))

(assert (= expect result))

(check-sat)
(exit)
