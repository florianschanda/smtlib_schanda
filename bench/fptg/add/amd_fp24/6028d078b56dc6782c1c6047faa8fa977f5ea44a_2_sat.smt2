                (fp #b0 #b0000000 #b0010100100110000)))
(assert (fp.leq (fp #b0 #b0000000 #b0010100100110000)
                arg2
                (fp #b0 #b0110110 #b1011010110100111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001110 #b1101001111111000)
                expect
                (fp #b0 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1011111 #b0000000000000000)
                expect
                (fp #b0 #b1101011 #b1110111001000001)))

(assert (= expect result))

(check-sat)
(exit)
