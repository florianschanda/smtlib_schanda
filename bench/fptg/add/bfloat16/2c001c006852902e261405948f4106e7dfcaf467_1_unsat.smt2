(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011111 #b1000100)
                arg1
                (fp #b0 #b11001001 #b0100010)))
(assert (fp.leq (fp #b0 #b11001001 #b0100010)
                arg1
                (fp #b0 #b11010011 #b1001001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100101 #b0111110)
                arg2
                (fp #b1 #b01001110 #b1100110)))
(assert (fp.leq (fp #b1 #b01001110 #b1100110)
                arg2
                (fp #b1 #b00010101 #b1010001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b1110010)
                expect
                (fp #b0 #b11001001 #b0100001)))
(assert (fp.leq (fp #b0 #b11001001 #b0100001)
                expect
                (fp #b0 #b11001101 #b1111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
