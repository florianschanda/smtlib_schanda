(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101010 #b1110110)
                arg1
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                arg1
                (fp #b0 #b11100110 #b0111110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b1100111)
                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b1 #b01111010 #b0010100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111000 #b1101100)
                expect
                (fp #b0 #b10101100 #b0000001)))
(assert (fp.leq (fp #b0 #b10101100 #b0000001)
                expect
                (fp #b0 #b11110010 #b0110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
