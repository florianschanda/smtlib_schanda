                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b0 #b00110000 #b1111011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110011 #b0011111)
                expect
                (fp #b1 #b11101011 #b1001111)))
(assert (fp.leq (fp #b1 #b11101011 #b1001111)
                expect
                (fp #b1 #b01111101 #b0110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
