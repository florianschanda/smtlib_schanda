; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000000 #b0010110)
                arg1
                (fp #b1 #b00000000 #b0111101)))
(assert (fp.leq (fp #b1 #b00000000 #b0111101)
                arg1
                (fp #b0 #b01001101 #b0101001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001110 #b1101100)
                arg2
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg2
                (fp #b0 #b10101110 #b0001100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000101 #b0011111)
                expect
                (fp #b1 #b00000000 #b1011101)))
(assert (fp.leq (fp #b1 #b00000000 #b1011101)
                expect
                (fp #b0 #b10110011 #b0011011)))

(assert (= expect result))

(check-sat)
(exit)
