(assert (fp.leq (fp #b0 #b00000001 #b0000000)
                arg2
                (fp #b0 #b00110101 #b0100100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101101 #b1101100)
                expect
                (fp #b0 #b00010000 #b0111101)))
(assert (fp.leq (fp #b0 #b00010000 #b0111101)
                expect
                (fp #b0 #b01110000 #b0111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
