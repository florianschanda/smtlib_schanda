;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01101101 #b0101011)
                arg1
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                arg1
                (fp #b0 #b11101000 #b0111111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010011 #b1011100)
                arg2
                (fp #b0 #b00111110 #b0111101)))
(assert (fp.leq (fp #b0 #b00111110 #b0111101)
                arg2
                (fp #b0 #b11100011 #b0111000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010100 #b1011110)
                expect
                (fp #b0 #b01111111 #b0101100)))
(assert (fp.leq (fp #b0 #b01111111 #b0101100)
                expect
                (fp #b0 #b10011010 #b0000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
