(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0011010)
                arg1
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg1
                (fp #b0 #b10010111 #b0110011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101110 #b0101101)
                arg2
                (fp #b1 #b11010010 #b1100000)))
(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b0 #b10000000 #b0101000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011001 #b1010010)
                expect
                (fp #b1 #b11010010 #b1011111)))
(assert (fp.leq (fp #b1 #b11010010 #b1011111)
                expect
                (fp #b0 #b00011111 #b1111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
