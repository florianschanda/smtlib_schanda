(assert (fp.leq (fp #b1 #b10011000 #b1011000)
                arg2
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg2
                (fp #b0 #b10000100 #b0011000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100110 #b1100011)
                expect
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                expect
                (fp #b0 #b01001100 #b1111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
