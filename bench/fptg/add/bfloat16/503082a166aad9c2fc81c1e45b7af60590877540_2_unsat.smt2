(assert (fp.leq (fp #b1 #b01001110 #b1100110)
                arg2
                (fp #b1 #b00010000 #b1011010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b0110001)
                expect
                (fp #b1 #b11101100 #b1110100)))
(assert (fp.leq (fp #b1 #b11101100 #b1110100)
                expect
                (fp #b1 #b10010111 #b0000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
