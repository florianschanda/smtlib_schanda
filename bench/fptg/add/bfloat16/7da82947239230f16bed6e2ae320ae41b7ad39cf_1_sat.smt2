(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010001 #b0010011)
                arg1
                (fp #b1 #b00000000 #b0111101)))
(assert (fp.leq (fp #b1 #b00000000 #b0111101)
                arg1
                (fp #b0 #b10101110 #b0011101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010111 #b1101010)
                arg2
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg2
                (fp #b0 #b00111110 #b0111110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001010 #b0000000)
                expect
                (fp #b0 #b00111100 #b0110100)))
(assert (fp.leq (fp #b0 #b00111100 #b0110100)
                expect
                (fp #b0 #b10011100 #b1101101)))

(assert (= expect result))

(check-sat)
(exit)
