; Format: BFLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011010 #b0100100)
                arg1
                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg1
                (fp #b0 #b01111110 #b1001011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11101001 #b1101000)
                arg2
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                arg2
                (fp #b0 #b11111111 #b0000000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11101010 #b0111000)
                expect
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                expect
                (fp #b0 #b11111111 #b0000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
