                arg2
                (fp #b0 #b11100111 #b1111100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100010 #b0010111)
                expect
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                expect
                (fp #b0 #b11001101 #b1000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
