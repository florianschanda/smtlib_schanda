(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001111 #b1101101)
                arg1
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg1
                (fp #b0 #b00001000 #b0000010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b1011110)
                arg2
                (fp #b1 #b01001110 #b1100110)))
(assert (fp.leq (fp #b1 #b01001110 #b1100110)
                arg2
                (fp #b1 #b00111011 #b0011111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110100 #b0101010)
                expect
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                expect
                (fp #b0 #b00011111 #b1101111)))

(assert (= expect result))

(check-sat)
(exit)
