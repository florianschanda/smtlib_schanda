(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100010 #b1111110)
                arg1
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                arg1
                (fp #b0 #b11111011 #b1101001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b0111101)
                arg2
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg2
                (fp #b0 #b01001011 #b1100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000110 #b1111101)
                expect
                (fp #b0 #b01111111 #b0101100)))
(assert (fp.leq (fp #b0 #b01111111 #b0101100)
                expect
                (fp #b0 #b10101001 #b1110110)))

(assert (= expect result))

(check-sat)
(exit)
