(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011100 #b0000101)
                arg1
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg1
                (fp #b0 #b10000111 #b0111000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000000 #b1101110)
                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11110110 #b1010010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000000 #b0101111)
                expect
                (fp #b0 #b11101011 #b0100110)))
(assert (fp.leq (fp #b0 #b11101011 #b0100110)
                expect
                (fp #b0 #b11111101 #b0111100)))

(assert (= expect result))

(check-sat)
(exit)
