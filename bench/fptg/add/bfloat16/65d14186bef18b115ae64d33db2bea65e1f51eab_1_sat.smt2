(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011001 #b1000011)
                arg1
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg1
                (fp #b0 #b00000101 #b1010100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0101101)
                arg2
                (fp #b0 #b00000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000)
                arg2
                (fp #b0 #b11100101 #b1111010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100101 #b0111011)
                expect
                (fp #b1 #b00111111 #b1111111)))
(assert (fp.leq (fp #b1 #b00111111 #b1111111)
                expect
                (fp #b1 #b00011100 #b0010110)))

(assert (= expect result))

(check-sat)
(exit)
