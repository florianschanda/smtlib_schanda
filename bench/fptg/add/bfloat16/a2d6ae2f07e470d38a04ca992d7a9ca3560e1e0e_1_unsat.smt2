(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00100000 #b1010100)
                arg1
                (fp #b0 #b01100011 #b1110000)))
(assert (fp.leq (fp #b0 #b01100011 #b1110000)
                arg1
                (fp #b0 #b11011011 #b0101111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b1111000)
                arg2
                (fp #b1 #b00000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000 #b0000011)
                arg2
                (fp #b0 #b00101000 #b0010001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011100 #b0111010)
                expect
                (fp #b0 #b01100011 #b1101111)))
(assert (fp.leq (fp #b0 #b01100011 #b1101111)
                expect
                (fp #b0 #b01111011 #b0101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
