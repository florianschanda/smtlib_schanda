(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111110 #b1010111)
                arg1
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg1
                (fp #b0 #b01101010 #b0011111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110100 #b0110111)
                arg2
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b11001011 #b0011010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b1100001)
                expect
                (fp #b1 #b01000000 #b0001011)))
(assert (fp.leq (fp #b1 #b01000000 #b0001011)
                expect
                (fp #b1 #b00101001 #b0111010)))

(assert (= expect result))

(check-sat)
(exit)
