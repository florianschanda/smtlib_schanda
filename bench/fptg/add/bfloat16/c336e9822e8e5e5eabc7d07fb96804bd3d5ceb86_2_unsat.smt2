(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01110100 #b0000100)
                expect
                (fp #b0 #b10000111 #b0100101)))
(assert (fp.leq (fp #b0 #b10000111 #b0100101)
                expect
                (fp #b0 #b10101110 #b0111100)))

(assert (not (= expect result)))

(check-sat)
