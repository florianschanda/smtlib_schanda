(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011100 #b0111111)
                arg1
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                arg1
                (fp #b0 #b11111111 #b0000000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100101 #b1010001)
                arg2
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg2
                (fp #b0 #b11101110 #b1111101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b1111001)
                expect
                (fp #b0 #b11111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111)
                expect
                (fp #b0 #b11111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
