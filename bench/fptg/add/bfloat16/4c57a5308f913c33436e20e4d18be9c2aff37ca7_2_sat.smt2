(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b1101101)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11100100 #b1111111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010101 #b1111110)
                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b0 #b10101011 #b0001010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b1010110)
                expect
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                expect
                (fp #b0 #b01100101 #b1110101)))

(assert (= expect result))

(check-sat)
(exit)
