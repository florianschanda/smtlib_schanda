                arg2
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg2
                (fp #b0 #b11010001 #b1001100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001000 #b1001001)
                expect
                (fp #b0 #b00000000 #b1011111)))
(assert (fp.leq (fp #b0 #b00000000 #b1011111)
                expect
                (fp #b0 #b11110001 #b0001111)))

(assert (= expect result))

(check-sat)
(exit)
