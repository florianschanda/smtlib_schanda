(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10001000 #b0010011)
                arg1
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg1
                (fp #b0 #b11001001 #b1011100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010010 #b0001001)
                arg2
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg2
                (fp #b0 #b01001000 #b0101100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b0001101)
                expect
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                expect
                (fp #b0 #b11101000 #b0001010)))

(assert (= expect result))

(check-sat)
(exit)
