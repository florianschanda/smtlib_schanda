(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001011 #b1000000)
                arg1
                (fp #b1 #b10101111 #b0001110)))
(assert (fp.leq (fp #b1 #b10101111 #b0001110)
                arg1
                (fp #b0 #b01110010 #b0100101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1000010)
                arg2
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg2
                (fp #b1 #b00101111 #b0011100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1000001)
                expect
                (fp #b1 #b11111101 #b0000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000001)
                expect
                (fp #b0 #b00001000 #b0001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
