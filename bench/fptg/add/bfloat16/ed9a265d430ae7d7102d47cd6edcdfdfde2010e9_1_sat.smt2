(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000101 #b1011101)
                expect
                (fp #b1 #b01100001 #b1110011)))
(assert (fp.leq (fp #b1 #b01100001 #b1110011)
                expect
                (fp #b0 #b01100010 #b0010001)))

(assert (= expect result))

(check-sat)
(exit)
