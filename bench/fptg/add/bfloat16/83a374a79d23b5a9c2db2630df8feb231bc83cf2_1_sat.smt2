(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100001 #b1011100)
                arg1
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg1
                (fp #b0 #b11010111 #b1010011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110000 #b0010110)
                arg2
                (fp #b0 #b00000000 #b1011101)))
(assert (fp.leq (fp #b0 #b00000000 #b1011101)
                arg2
                (fp #b0 #b00001111 #b0010011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110111 #b1110111)
                expect
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                expect
                (fp #b0 #b01110111 #b1100011)))

(assert (= expect result))

(check-sat)
(exit)
