(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001111 #b0011010)
                arg1
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg1
                (fp #b0 #b10011001 #b1100111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                arg2
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                arg2
                (fp #b1 #b01110101 #b1111101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                expect
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                expect
                (fp #b1 #b11001111 #b1010010)))

(assert (= expect result))

(check-sat)
(exit)
