(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011111 #b1100111)
                arg1
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                arg1
                (fp #b0 #b11101001 #b1100011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101000 #b0001000)
                arg2
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg2
                (fp #b0 #b00111010 #b1100010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110010 #b1000100)
                expect
                (fp #b0 #b01111111 #b0101010)))
(assert (fp.leq (fp #b0 #b01111111 #b0101010)
                expect
                (fp #b0 #b10010011 #b0011111)))

(assert (= expect result))

(check-sat)
(exit)
