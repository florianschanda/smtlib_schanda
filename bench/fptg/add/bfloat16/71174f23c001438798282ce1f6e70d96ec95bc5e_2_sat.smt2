(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110011 #b0001110)
                arg1
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                arg1
                (fp #b0 #b01100100 #b0101101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1111001)
                arg2
                (fp #b0 #b00000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000)
                arg2
                (fp #b0 #b11000010 #b1001001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111001 #b1000000)
                expect
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                expect
                (fp #b0 #b00111011 #b0110101)))

(assert (= expect result))

(check-sat)
(exit)
