; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100111 #b1010011)
                arg1
                (fp #b1 #b01111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111 #b0101111)
                arg1
                (fp #b0 #b01110101 #b0001101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000011 #b1100101)
                arg2
                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                arg2
                (fp #b0 #b11100010 #b1000010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011110 #b0010001)
                expect
                (fp #b1 #b01111111 #b0110000)))
(assert (fp.leq (fp #b1 #b01111111 #b0110000)
                expect
                (fp #b0 #b11100000 #b0100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
