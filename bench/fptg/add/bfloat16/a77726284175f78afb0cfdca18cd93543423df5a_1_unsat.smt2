; Format: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010011 #b0101100)
                arg1
                (fp #b0 #b00000000 #b1100101)))
(assert (fp.leq (fp #b0 #b00000000 #b1100101)
                arg1
                (fp #b0 #b11110111 #b1011010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b0000011)
                arg2
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg2
                (fp #b0 #b01001000 #b1111110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011001 #b0100111)
                expect
                (fp #b1 #b00111111 #b1111111)))
(assert (fp.leq (fp #b1 #b00111111 #b1111111)
                expect
                (fp #b1 #b00000011 #b1111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
