(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b0011100)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b1 #b00110110 #b1011100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111100 #b0110000)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b1 #b01100011 #b0100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011011 #b0110110)
                expect
                (fp #b1 #b10000110 #b1010100)))
(assert (fp.leq (fp #b1 #b10000110 #b1010100)
                expect
                (fp #b0 #b00010100 #b1111011)))

(assert (= expect result))

(check-sat)
(exit)
