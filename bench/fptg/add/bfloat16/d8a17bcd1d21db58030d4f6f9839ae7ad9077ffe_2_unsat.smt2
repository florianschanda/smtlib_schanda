(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b0111000)
                arg1
                (fp #b1 #b00000000 #b1111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111)
                arg1
                (fp #b0 #b10000001 #b0100101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010000 #b1100010)
                arg2
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg2
                (fp #b0 #b01001100 #b1000000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1111011)
                expect
                (fp #b1 #b01000000 #b0000001)))
(assert (fp.leq (fp #b1 #b01000000 #b0000001)
                expect
                (fp #b1 #b00101111 #b0000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
