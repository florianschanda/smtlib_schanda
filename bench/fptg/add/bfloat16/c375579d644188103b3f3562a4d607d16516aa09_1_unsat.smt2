                (fp #b1 #b11010010 #b1100000)))
(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b1 #b10001011 #b1010011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b1011010)
                expect
                (fp #b1 #b11010010 #b1011111)))
(assert (fp.leq (fp #b1 #b11010010 #b1011111)
                expect
                (fp #b0 #b10011101 #b0011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
