; Format: BFLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001110 #b1111011)
                arg1
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg1
                (fp #b0 #b11100101 #b0100001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110110 #b1111011)
                arg2
                (fp #b0 #b00111110 #b0111101)))
(assert (fp.leq (fp #b0 #b00111110 #b0111101)
                arg2
                (fp #b0 #b01111100 #b1000010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10110111 #b1001101)
                expect
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                expect
                (fp #b0 #b11010101 #b0001011)))

(assert (= expect result))

(check-sat)
(exit)
