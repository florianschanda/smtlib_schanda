;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111101 #b1000101)
                arg1
                (fp #b1 #b01100001 #b1110011)))
(assert (fp.leq (fp #b1 #b01100001 #b1110011)
                arg1
                (fp #b1 #b01010111 #b0001101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111001 #b0110100)
                expect
                (fp #b1 #b01100010 #b1110011)))
(assert (fp.leq (fp #b1 #b01100010 #b1110011)
                expect
                (fp #b0 #b01011001 #b1001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
