;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b1001001)
                arg1
                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg1
                (fp #b0 #b11001111 #b0111000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001001 #b1110011)
                arg2
                (fp #b0 #b00000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000)
                arg2
                (fp #b0 #b10100000 #b0000110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010001 #b0010010)
                expect
                (fp #b0 #b00000001 #b1111111)))
(assert (fp.leq (fp #b0 #b00000001 #b1111111)
                expect
                (fp #b0 #b01000001 #b0010000)))

(assert (= expect result))

(check-sat)
(exit)
