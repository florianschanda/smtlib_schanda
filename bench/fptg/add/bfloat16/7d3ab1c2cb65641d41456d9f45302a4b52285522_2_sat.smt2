(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010000 #b0101000)
                arg1
                (fp #b0 #b00000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000)
                arg1
                (fp #b0 #b01111100 #b1001011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000001 #b0010111)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b1 #b00000110 #b1001111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110010 #b1100110)
                expect
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                expect
                (fp #b1 #b01001000 #b0000001)))

(assert (= expect result))

(check-sat)
(exit)
