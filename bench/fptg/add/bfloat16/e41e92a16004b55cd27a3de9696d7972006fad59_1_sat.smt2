(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101011 #b1111000)
                arg1
                (fp #b0 #b00000000 #b1100101)))
(assert (fp.leq (fp #b0 #b00000000 #b1100101)
                arg1
                (fp #b0 #b11000111 #b1110001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110110 #b1100110)
                arg2
                (fp #b0 #b01011000 #b1111000)))
(assert (fp.leq (fp #b0 #b01011000 #b1111000)
                arg2
                (fp #b0 #b10011011 #b0100100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00001010 #b1110110)
                expect
                (fp #b0 #b01011000 #b1111000)))
(assert (fp.leq (fp #b0 #b01011000 #b1111000)
                expect
                (fp #b0 #b01101111 #b0110001)))

(assert (= expect result))

(check-sat)
(exit)
