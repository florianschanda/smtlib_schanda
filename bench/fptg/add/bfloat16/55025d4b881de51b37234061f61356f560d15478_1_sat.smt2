; Format: BFLOAT16
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001010 #b0011011)
                arg1
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg1
                (fp #b0 #b00010000 #b0010001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111111 #b0100010)
                arg2
                (fp #b0 #b00000000 #b1011101)))
(assert (fp.leq (fp #b0 #b00000000 #b1011101)
                arg2
                (fp #b0 #b11001001 #b0000100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001011 #b1010011)
                expect
                (fp #b0 #b00000000 #b0111101)))
(assert (fp.leq (fp #b0 #b00000000 #b0111101)
                expect
                (fp #b0 #b01101111 #b0011011)))

(assert (= expect result))

(check-sat)
(exit)
