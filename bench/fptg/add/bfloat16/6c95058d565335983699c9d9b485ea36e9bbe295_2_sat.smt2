(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111010 #b1001000)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b0 #b10111100 #b1010010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011111 #b0100111)
                arg2
                (fp #b1 #b10011110 #b0001010)))
(assert (fp.leq (fp #b1 #b10011110 #b0001010)
                arg2
                (fp #b0 #b10100000 #b0001101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b0110100)
                expect
                (fp #b1 #b10011110 #b0001011)))
(assert (fp.leq (fp #b1 #b10011110 #b0001011)
                expect
                (fp #b1 #b00100000 #b1011101)))

(assert (= expect result))

(check-sat)
(exit)
