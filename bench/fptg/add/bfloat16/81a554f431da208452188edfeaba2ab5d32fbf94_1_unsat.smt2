(assert (fp.leq (fp #b0 #b00111110 #b0111101)
                arg2
                (fp #b0 #b10001100 #b1001010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b0101010)
                expect
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                expect
                (fp #b0 #b11010010 #b1100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
