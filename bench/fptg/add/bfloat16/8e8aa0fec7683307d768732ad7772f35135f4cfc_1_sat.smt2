                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg2
                (fp #b0 #b00000100 #b0001101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111010 #b0011111)
                expect
                (fp #b0 #b00000000 #b1100110)))
(assert (fp.leq (fp #b0 #b00000000 #b1100110)
                expect
                (fp #b0 #b00001101 #b1010010)))

(assert (= expect result))

(check-sat)
(exit)
