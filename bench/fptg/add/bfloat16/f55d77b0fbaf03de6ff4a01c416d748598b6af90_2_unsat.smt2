; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10010100 #b0111111)
                arg1
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                arg1
                (fp #b0 #b11000101 #b1010010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001010 #b1100001)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b00001101 #b0111110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001010 #b0100011)
                expect
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                expect
                (fp #b0 #b11010011 #b1011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
