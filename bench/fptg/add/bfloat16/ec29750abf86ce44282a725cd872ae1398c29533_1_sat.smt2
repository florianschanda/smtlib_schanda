(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b1001000)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b10101111 #b0001110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b1001111)
                arg2
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b10000111 #b0000010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1101010)
                expect
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                expect
                (fp #b0 #b11010010 #b0001011)))

(assert (= expect result))

(check-sat)
(exit)
