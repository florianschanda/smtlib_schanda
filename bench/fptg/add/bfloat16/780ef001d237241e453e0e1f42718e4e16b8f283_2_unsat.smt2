(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010100 #b0100110)
                arg1
                (fp #b0 #b01100011 #b1110000)))
(assert (fp.leq (fp #b0 #b01100011 #b1110000)
                arg1
                (fp #b0 #b10111010 #b1110011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1010101)
                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b1 #b01010100 #b1101111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111011 #b0010101)
                expect
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                expect
                (fp #b0 #b10011111 #b1001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
