(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111101 #b1001101)
                arg1
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg1
                (fp #b0 #b01000001 #b1110011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b0101111)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b1 #b00001000 #b0000110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b1100000)
                expect
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                expect
                (fp #b1 #b01010001 #b0010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
