(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010010 #b0001101)
                expect
                (fp #b0 #b00000000 #b1100001)))
(assert (fp.leq (fp #b0 #b00000000 #b1100001)
                expect
                (fp #b0 #b11101011 #b1001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
