(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110000 #b1110111)
                arg1
                (fp #b0 #b00000000 #b1011100)))
(assert (fp.leq (fp #b0 #b00000000 #b1011100)
                arg1
                (fp #b0 #b00100000 #b0100100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101111 #b0110110)
                arg2
                (fp #b0 #b01011000 #b1111000)))
(assert (fp.leq (fp #b0 #b01011000 #b1111000)
                arg2
                (fp #b0 #b01100001 #b0000001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011101 #b1110110)
                expect
                (fp #b0 #b01011000 #b1111001)))
(assert (fp.leq (fp #b0 #b01011000 #b1111001)
                expect
                (fp #b0 #b11100000 #b1000001)))

(assert (= expect result))

(check-sat)
(exit)
