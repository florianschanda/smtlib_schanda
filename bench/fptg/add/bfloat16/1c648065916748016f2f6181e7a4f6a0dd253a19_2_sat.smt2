(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011001 #b1111001)
                arg1
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                arg1
                (fp #b0 #b00011111 #b1100010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00110000 #b0100111)
                arg2
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg2
                (fp #b0 #b01001000 #b1000010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110110 #b0011111)
                expect
                (fp #b1 #b10000110 #b0000110)))
(assert (fp.leq (fp #b1 #b10000110 #b0000110)
                expect
                (fp #b0 #b11100111 #b1001101)))

(assert (= expect result))

(check-sat)
(exit)
