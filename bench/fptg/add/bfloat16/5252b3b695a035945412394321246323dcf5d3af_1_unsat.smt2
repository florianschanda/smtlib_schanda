(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01101011 #b1101111)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b00010101 #b1000111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100110 #b0111000)
                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b11110011 #b0000110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000101 #b0010000)
                expect
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                expect
                (fp #b0 #b11011010 #b1110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
