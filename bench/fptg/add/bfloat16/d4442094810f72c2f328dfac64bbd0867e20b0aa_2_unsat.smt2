                arg2
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg2
                (fp #b0 #b10000010 #b0100011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010101 #b0011011)
                expect
                (fp #b0 #b00010000 #b0111101)))
(assert (fp.leq (fp #b0 #b00010000 #b0111101)
                expect
                (fp #b0 #b10001010 #b0010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
