                arg2
                (fp #b0 #b00000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000)
                arg2
                (fp #b0 #b10010100 #b1100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011110 #b0011110)
                expect
                (fp #b0 #b10000011 #b1110001)))
(assert (fp.leq (fp #b0 #b10000011 #b1110001)
                expect
                (fp #b0 #b11100001 #b0011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
