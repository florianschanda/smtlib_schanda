; Format: BFLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001101 #b0111101)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b0 #b00001011 #b0100011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110011 #b1000110)
                arg2
                (fp #b0 #b01011000 #b1111000)))
(assert (fp.leq (fp #b0 #b01011000 #b1111000)
                arg2
                (fp #b0 #b11100111 #b0100111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100000 #b0111001)
                expect
                (fp #b1 #b10000110 #b1111111)))
(assert (fp.leq (fp #b1 #b10000110 #b1111111)
                expect
                (fp #b0 #b11111010 #b0010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
