(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000010 #b1101000)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b10111101 #b1010100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111101 #b0011011)
                arg2
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg2
                (fp #b0 #b11010000 #b1011000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00011111 #b0110001)
                expect
                (fp #b0 #b10000101 #b0101101)))
(assert (fp.leq (fp #b0 #b10000101 #b0101101)
                expect
                (fp #b0 #b11111110 #b1110001)))

(assert (= expect result))

(check-sat)
(exit)
