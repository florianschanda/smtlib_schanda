(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                arg2
                (fp #b0 #b11110000 #b0001001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011000 #b1101000)
                expect
                (fp #b0 #b01111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000001)
                expect
                (fp #b0 #b10010111 #b0111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
