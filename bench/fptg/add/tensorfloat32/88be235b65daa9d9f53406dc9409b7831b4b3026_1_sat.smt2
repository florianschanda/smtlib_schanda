(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b0 #b01111011 #b0101011101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1011100111)
                expect
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                expect
                (fp #b0 #b01110101 #b0111101000)))

(assert (= expect result))

(check-sat)
(exit)
