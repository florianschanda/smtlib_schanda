                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111101 #b1111101110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b0101110100)
                expect
                (fp #b0 #b11111100 #b0110110111)))
(assert (fp.leq (fp #b0 #b11111100 #b0110110111)
                expect
                (fp #b0 #b11111100 #b1101111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
