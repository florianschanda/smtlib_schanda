;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100110 #b0100110011)
                arg1
                (fp #b1 #b00000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000 #b1110100001)
                arg1
                (fp #b0 #b00100111 #b0010110001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100101 #b0101111011)
                expect
                (fp #b1 #b00000001 #b1101000010)))
(assert (fp.leq (fp #b1 #b00000001 #b1101000010)
                expect
                (fp #b0 #b01100011 #b1000010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
