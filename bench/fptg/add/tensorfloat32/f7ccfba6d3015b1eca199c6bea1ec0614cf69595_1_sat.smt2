(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101010 #b0001010101)
                arg1
                (fp #b1 #b00010000 #b1001010100)))
(assert (fp.leq (fp #b1 #b00010000 #b1001010100)
                arg1
                (fp #b0 #b10010000 #b0000001101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000111 #b1110100110)
                expect
                (fp #b1 #b00010001 #b1001010100)))
(assert (fp.leq (fp #b1 #b00010001 #b1001010100)
                expect
                (fp #b0 #b11100011 #b0110011000)))

(assert (= expect result))

(check-sat)
(exit)
