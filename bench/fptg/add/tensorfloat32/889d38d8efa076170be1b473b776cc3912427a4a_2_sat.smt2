(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010000 #b0101001110)
                arg1
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b11100111 #b0100001100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100110 #b0101010011)
                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b0 #b10011100 #b1111010100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000110 #b0100100110)
                expect
                (fp #b1 #b01111111 #b0000101000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000101000)
                expect
                (fp #b1 #b01000011 #b1101010010)))

(assert (= expect result))

(check-sat)
(exit)
