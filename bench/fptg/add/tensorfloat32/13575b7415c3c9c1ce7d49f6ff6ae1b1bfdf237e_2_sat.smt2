;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011010 #b1000011111)
                arg1
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg1
                (fp #b0 #b10101110 #b1001110010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b11100110 #b0110100011)
                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111110 #b1011100011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111101 #b0100000110)
                expect
                (fp #b0 #b11111100 #b0110111001)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111001)
                expect
                (fp #b0 #b11111110 #b0011101101)))

(assert (= expect result))

(check-sat)
(exit)
