                arg2
                (fp #b1 #b00000101 #b1110001100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011100 #b0111101011)
                expect
                (fp #b0 #b01111111 #b1001100011)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100011)
                expect
                (fp #b0 #b10101011 #b1000101100)))

(assert (not (= expect result)))

(check-sat)
