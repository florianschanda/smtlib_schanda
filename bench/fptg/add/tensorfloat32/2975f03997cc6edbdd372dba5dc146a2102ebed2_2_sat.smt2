(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b1010001000)
                arg1
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg1
                (fp #b1 #b00101100 #b1100100110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010000 #b0001110000)
                arg2
                (fp #b1 #b00000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000 #b0101011111)
                arg2
                (fp #b0 #b01001110 #b0001011101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b0011111000)
                expect
                (fp #b1 #b00111011 #b0000000001)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000001)
                expect
                (fp #b1 #b00000011 #b1101101011)))

(assert (= expect result))

(check-sat)
(exit)
