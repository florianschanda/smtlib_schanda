                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b01001011 #b0101111111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1110101011)
                expect
                (fp #b0 #b10100111 #b1001010001)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010001)
                expect
                (fp #b0 #b10100111 #b1011110100)))

(assert (= expect result))

(check-sat)
(exit)
