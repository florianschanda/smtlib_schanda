                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b11100111 #b0001101101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100101 #b1101101010)
                expect
                (fp #b1 #b01111111 #b1111110011)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110011)
                expect
                (fp #b0 #b01001110 #b0101000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
