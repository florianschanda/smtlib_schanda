(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b1101111010)
                expect
                (fp #b0 #b00000001 #b1111110111)))
(assert (fp.leq (fp #b0 #b00000001 #b1111110111)
                expect
                (fp #b0 #b01100100 #b0010110000)))

(assert (= expect result))

(check-sat)
(exit)
