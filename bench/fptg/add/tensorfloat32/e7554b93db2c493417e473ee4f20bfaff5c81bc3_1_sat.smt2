(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b0 #b10001110 #b0100001011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b0101110001)
                expect
                (fp #b1 #b01111111 #b0000100110)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100110)
                expect
                (fp #b0 #b00000101 #b1011101001)))

(assert (= expect result))

(check-sat)
