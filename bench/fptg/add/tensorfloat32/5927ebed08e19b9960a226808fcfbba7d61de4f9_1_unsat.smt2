                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b10000111 #b1011110011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01000000 #b0000010101)
                expect
                (fp #b0 #b10100111 #b1001010001)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010001)
                expect
                (fp #b0 #b11010001 #b1100111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
