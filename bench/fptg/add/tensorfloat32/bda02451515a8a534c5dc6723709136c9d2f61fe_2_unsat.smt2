; Format: TENSORFLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011101 #b0001001001)
                arg1
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b11010010 #b0110001100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100111 #b1000001010)
                arg2
                (fp #b1 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001100)
                arg2
                (fp #b0 #b11010110 #b0011110011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010100 #b0001000100)
                expect
                (fp #b1 #b10001000 #b0100001101)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001101)
                expect
                (fp #b1 #b00101001 #b0011011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
