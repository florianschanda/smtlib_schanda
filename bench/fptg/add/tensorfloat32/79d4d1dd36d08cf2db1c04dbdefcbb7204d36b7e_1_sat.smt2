(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101101 #b1110001110)
                arg1
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b00101000 #b0010001000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001100 #b1111110101)
                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b11101101 #b1010110100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100000 #b0101001111)
                expect
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                expect
                (fp #b0 #b11110001 #b0111110111)))

(assert (= expect result))

(check-sat)
(exit)
