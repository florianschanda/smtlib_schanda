                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b11010111 #b0011010010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10100001 #b1010001011)
                expect
                (fp #b0 #b11100011 #b1000010101)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010101)
                expect
                (fp #b0 #b11111010 #b1101010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
