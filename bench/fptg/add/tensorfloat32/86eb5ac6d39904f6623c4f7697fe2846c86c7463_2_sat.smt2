; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101001 #b1001011110)
                arg1
                (fp #b1 #b00000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000 #b1110100001)
                arg1
                (fp #b0 #b11111101 #b1010000010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101100 #b1010000100)
                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b11010110 #b1111100101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b1110011101)
                expect
                (fp #b1 #b00010010 #b0011010011)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010011)
                expect
                (fp #b0 #b11011100 #b0010000111)))

(assert (= expect result))

(check-sat)
(exit)
