(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                arg1
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                arg1
                (fp #b0 #b11100000 #b1100001110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011011 #b0010001100)
                arg2
                (fp #b1 #b00111100 #b1100110010)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110010)
                arg2
                (fp #b0 #b10000110 #b1011111100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
