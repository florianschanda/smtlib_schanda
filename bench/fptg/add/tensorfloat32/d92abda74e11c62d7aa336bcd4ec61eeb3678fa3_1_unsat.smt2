                arg2
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b01001000 #b1101001011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001000 #b0101111010)
                expect
                (fp #b1 #b00111010 #b1111111111)))
(assert (fp.leq (fp #b1 #b00111010 #b1111111111)
                expect
                (fp #b0 #b11010101 #b0011101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
