; Format: TENSORFLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001011 #b1101111000)
                arg1
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg1
                (fp #b0 #b11010110 #b0001010111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101100 #b1101011000)
                arg2
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b01110000 #b1110101111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010001 #b0010001100)
                expect
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                expect
                (fp #b0 #b01001100 #b0101001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
