                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b00101110 #b1010100010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011101 #b1100100010)
                expect
                (fp #b0 #b10100111 #b1001010011)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010011)
                expect
                (fp #b0 #b11000111 #b1011101101)))

(assert (= expect result))

(check-sat)
(exit)
