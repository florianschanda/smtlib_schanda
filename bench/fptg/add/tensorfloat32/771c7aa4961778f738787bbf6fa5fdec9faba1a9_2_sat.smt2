                arg1
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                arg1
                (fp #b0 #b11000011 #b1101100010)))

(declare-const arg2 (_ FloatingPoint 8 11))
