                arg2
                (fp #b0 #b00000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b11100111 #b1010111011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011010 #b0110101101)
                expect
                (fp #b0 #b10001001 #b1101010001)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010001)
                expect
                (fp #b0 #b10011100 #b1110011000)))

(assert (= expect result))

(check-sat)
(exit)
