; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111000 #b0111010111)
                arg1
                (fp #b0 #b00100111 #b1011110101)))
(assert (fp.leq (fp #b0 #b00100111 #b1011110101)
                arg1
                (fp #b0 #b11000001 #b0011010000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001001 #b0011000110)
                arg2
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                arg2
                (fp #b0 #b11001001 #b0101011011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110000 #b1010001011)
                expect
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                expect
                (fp #b0 #b11001011 #b1001111001)))

(assert (= expect result))

(check-sat)
(exit)
