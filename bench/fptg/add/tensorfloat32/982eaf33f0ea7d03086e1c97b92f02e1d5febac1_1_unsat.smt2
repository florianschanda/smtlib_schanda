(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000001 #b1000111100)
                expect
                (fp #b0 #b00000001 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000001 #b1111111111)
                expect
                (fp #b0 #b11100010 #b0011001101)))

(assert (not (= expect result)))

(check-sat)
