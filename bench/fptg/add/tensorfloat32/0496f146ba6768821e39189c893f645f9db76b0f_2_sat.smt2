; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011010 #b0000101101)
                arg1
                (fp #b0 #b00100111 #b1011110101)))
(assert (fp.leq (fp #b0 #b00100111 #b1011110101)
                arg1
                (fp #b0 #b00111101 #b0010100100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10000010 #b1000111100)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10001010 #b0000010011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110110 #b1100000111)
                expect
                (fp #b0 #b10000111 #b1011011101)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011101)
                expect
                (fp #b0 #b10100111 #b1100110110)))

(assert (= expect result))

(check-sat)
(exit)
