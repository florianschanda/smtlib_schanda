(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b00101100 #b1100100010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111111 #b1011100101)
                expect
                (fp #b1 #b00000000 #b0100000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000001)
                expect
                (fp #b0 #b01100111 #b0111010000)))

(assert (= expect result))

(check-sat)
(exit)
