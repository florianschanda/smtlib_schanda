                arg2
                (fp #b0 #b11111011 #b1111000011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b1010100111)
                expect
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                expect
                (fp #b1 #b01111111 #b0100011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
