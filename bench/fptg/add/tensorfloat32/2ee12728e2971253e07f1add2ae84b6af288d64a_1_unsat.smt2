                (fp #b0 #b11110000 #b0100011110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100001 #b0000110011)
                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b11000000 #b1111000100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100111 #b1110000101)
                expect
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                expect
                (fp #b0 #b11010100 #b0110100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
