                arg2
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b11111101 #b0000011100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01101110 #b1001110000)
                expect
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                expect
                (fp #b0 #b10001011 #b0011110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
