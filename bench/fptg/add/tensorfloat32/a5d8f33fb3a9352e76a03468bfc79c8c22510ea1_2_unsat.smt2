(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110100 #b0111000111)
                expect
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                expect
                (fp #b0 #b01111001 #b1111011111)))

(assert (not (= expect result)))

(check-sat)
