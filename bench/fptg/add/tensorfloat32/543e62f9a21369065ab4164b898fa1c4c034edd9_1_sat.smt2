(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110101 #b1010111100)
                arg1
                (fp #b0 #b00000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111000)
                arg1
                (fp #b0 #b00100001 #b1111100101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011010 #b1101101000)
                arg2
                (fp #b1 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001100)
                arg2
                (fp #b1 #b00011111 #b1011111100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1100110110)
                expect
                (fp #b1 #b10001000 #b0100001011)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001011)
                expect
                (fp #b1 #b01010110 #b0000101101)))

(assert (= expect result))

(check-sat)
(exit)
