(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100001 #b1001110011)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10100011 #b0000101001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
