(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b1101000001)
                arg1
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                arg1
                (fp #b1 #b00110100 #b0001100111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b0111001100)
                arg2
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b00000111 #b1000101001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001011 #b0010000000)
                expect
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                expect
                (fp #b0 #b10101011 #b0111001001)))

(assert (= expect result))

(check-sat)
(exit)
