; Format: TENSORFLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100111 #b1100010001)
                arg1
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b10110010 #b1101101110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101000 #b0100011101)
                arg2
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b01010100 #b0010010010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001001 #b1110101101)
                expect
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                expect
                (fp #b0 #b10110000 #b1011001111)))

(assert (= expect result))

(check-sat)
(exit)
