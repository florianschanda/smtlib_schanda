(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1110000111)
                arg1
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                arg1
                (fp #b0 #b11000110 #b1001110101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001001 #b1111011010)
                arg2
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b10011001 #b0011011110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1000111011)
                expect
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                expect
                (fp #b1 #b10001000 #b0001110110)))

(assert (= expect result))

(check-sat)
(exit)
