(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b0 #b01100010 #b1000011001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101001 #b0010101101)
                expect
                (fp #b1 #b10000111 #b0011100011)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100011)
                expect
                (fp #b1 #b01001001 #b1010001011)))

(assert (= expect result))

(check-sat)
