(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                expect
                (fp #b1 #b11111110 #b1111111110)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111110)
                expect
                (fp #b1 #b01011010 #b0100100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
