(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011000 #b0011110100)
                expect
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                expect
                (fp #b1 #b01110111 #b1100001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
