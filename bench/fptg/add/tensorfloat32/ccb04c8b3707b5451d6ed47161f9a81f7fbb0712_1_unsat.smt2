(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100100 #b1001101011)
                expect
                (fp #b1 #b10001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b10001001 #b1111111111)
                expect
                (fp #b0 #b00011110 #b0100001100)))

(assert (not (= expect result)))

(check-sat)
