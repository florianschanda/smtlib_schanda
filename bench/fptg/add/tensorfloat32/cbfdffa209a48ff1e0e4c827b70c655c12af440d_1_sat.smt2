; Format: TENSORFLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00100110 #b1100011111)
                arg1
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                arg1
                (fp #b0 #b11000110 #b1111110011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01101011 #b1110111001)
                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111101 #b0010111010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b0111100101)
                expect
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                expect
                (fp #b0 #b11111110 #b0001101100)))

(assert (= expect result))

(check-sat)
(exit)
