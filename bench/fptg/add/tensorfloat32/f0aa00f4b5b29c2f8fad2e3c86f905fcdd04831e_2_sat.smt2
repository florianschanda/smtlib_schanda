                arg2
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b11011001 #b1101110111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110101 #b1000100001)
                expect
                (fp #b0 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000000)
                expect
                (fp #b0 #b11110000 #b0010110100)))

(assert (= expect result))

(check-sat)
(exit)
