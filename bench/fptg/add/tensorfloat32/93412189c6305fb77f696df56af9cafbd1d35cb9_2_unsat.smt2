;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011011 #b0110101010)
                arg1
                (fp #b1 #b00000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000 #b1110100001)
                arg1
                (fp #b0 #b01100110 #b0100101011)))

(declare-const arg2 (_ FloatingPoint 8 11))
