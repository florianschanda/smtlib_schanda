;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110010 #b1111011010)
                arg1
                (fp #b1 #b11100110 #b1110111011)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111011)
                arg1
                (fp #b0 #b00000010 #b1010101011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010110 #b1000011011)
                arg2
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b10000001 #b0000110010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101011 #b0001011101)
                expect
                (fp #b1 #b11100110 #b1110111011)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111011)
                expect
                (fp #b0 #b10101110 #b0000111100)))

(assert (= expect result))

(check-sat)
(exit)
