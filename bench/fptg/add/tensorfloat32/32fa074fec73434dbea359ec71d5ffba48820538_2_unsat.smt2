; Format: TENSORFLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011101 #b0110000100)
                arg1
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b01110001 #b1011010100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000011 #b1001000001)
                arg2
                (fp #b1 #b00111100 #b1100110010)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110010)
                arg2
                (fp #b0 #b10110110 #b1010001101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110100 #b0111110100)
                expect
                (fp #b1 #b00111100 #b1100110010)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110010)
                expect
                (fp #b1 #b00110111 #b1101111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
