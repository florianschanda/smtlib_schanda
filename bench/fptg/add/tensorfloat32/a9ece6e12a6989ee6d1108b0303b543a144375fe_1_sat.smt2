(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010101 #b1000001110)
                arg1
                (fp #b0 #b00000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111000)
                arg1
                (fp #b0 #b11011110 #b1011001001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001101 #b0110110010)
                arg2
                (fp #b1 #b11001010 #b0100100000)))
(assert (fp.leq (fp #b1 #b11001010 #b0100100000)
                arg2
                (fp #b0 #b00110000 #b0100111000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011011 #b1011001010)
                expect
                (fp #b1 #b11001010 #b0100011111)))
(assert (fp.leq (fp #b1 #b11001010 #b0100011111)
                expect
                (fp #b1 #b01000001 #b1100100111)))

(assert (= expect result))

(check-sat)
(exit)
