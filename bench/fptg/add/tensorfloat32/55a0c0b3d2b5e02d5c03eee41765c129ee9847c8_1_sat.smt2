(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01111111 #b0100011000)
                arg1
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                arg1
                (fp #b0 #b11110011 #b0111110101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001000 #b1100011001)
                arg2
                (fp #b0 #b00000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b10111100 #b1011111111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001001 #b0010111000)
                expect
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                expect
                (fp #b0 #b10110100 #b1010101111)))

(assert (= expect result))

(check-sat)
(exit)
