                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b10010101 #b0001010010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00100101 #b0011000111)
                expect
                (fp #b0 #b01111111 #b0000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000001)
                expect
                (fp #b0 #b10101011 #b0100010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
