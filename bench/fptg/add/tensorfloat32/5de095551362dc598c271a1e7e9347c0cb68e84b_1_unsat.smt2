(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001010 #b1000100110)
                expect
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                expect
                (fp #b0 #b11101101 #b1111110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
