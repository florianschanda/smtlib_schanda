(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0001101101)
                expect
                (fp #b1 #b00011010 #b1100101000)))
(assert (fp.leq (fp #b1 #b00011010 #b1100101000)
                expect
                (fp #b0 #b01101110 #b1110011100)))

(assert (= expect result))

(check-sat)
(exit)
