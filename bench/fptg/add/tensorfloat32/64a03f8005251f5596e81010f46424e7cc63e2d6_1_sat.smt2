                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b11101001 #b1110010001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1001101001)
                expect
                (fp #b1 #b11100110 #b1110111010)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111010)
                expect
                (fp #b0 #b11100111 #b1001111110)))

(assert (= expect result))

(check-sat)
(exit)
