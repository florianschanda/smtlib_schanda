(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101000 #b1110101101)
                expect
                (fp #b1 #b11010010 #b0101100111)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100111)
                expect
                (fp #b0 #b00011111 #b0100011000)))

(assert (not (= expect result)))

