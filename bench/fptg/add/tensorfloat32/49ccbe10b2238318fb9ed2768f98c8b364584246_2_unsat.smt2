(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100111 #b0110101011)
                arg1
                (fp #b0 #b00000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000 #b0001001100)
                arg1
                (fp #b0 #b11100110 #b1101111001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010100 #b1001011000)
                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b11010110 #b0110101100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010010 #b0011111000)
                expect
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                expect
                (fp #b0 #b01010001 #b1111011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
