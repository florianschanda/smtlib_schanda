(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011110 #b1101010000)
                arg1
                (fp #b1 #b00011010 #b1100101000)))
(assert (fp.leq (fp #b1 #b00011010 #b1100101000)
                arg1
                (fp #b0 #b01111010 #b0111110010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110001 #b1100011101)
                expect
                (fp #b1 #b00011011 #b1100101000)))
(assert (fp.leq (fp #b1 #b00011011 #b1100101000)
                expect
                (fp #b0 #b01001000 #b1111000100)))

(assert (= expect result))

(check-sat)
(exit)
