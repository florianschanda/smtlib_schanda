(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100110 #b1010001101)
                expect
                (fp #b0 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000001)
                expect
                (fp #b0 #b11111110 #b0111011111)))

(assert (= expect result))

(check-sat)
