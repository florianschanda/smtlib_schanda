                arg2
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b01100100 #b1010110100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111001 #b1111000110)
                expect
                (fp #b0 #b11000011 #b1111001010)))
(assert (fp.leq (fp #b0 #b11000011 #b1111001010)
                expect
                (fp #b0 #b11110001 #b0101110010)))

(assert (= expect result))

(check-sat)
(exit)
