; Format: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b1011010100)
                arg1
                (fp #b1 #b10011100 #b0001111011)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111011)
                arg1
                (fp #b1 #b00111011 #b1100101001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010001 #b1011011100)
                arg2
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b01111100 #b1001010100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100101 #b0000001100)
                expect
                (fp #b1 #b10011100 #b0001111100)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111100)
                expect
                (fp #b0 #b01010101 #b1111000101)))

(assert (= expect result))

(check-sat)
(exit)
