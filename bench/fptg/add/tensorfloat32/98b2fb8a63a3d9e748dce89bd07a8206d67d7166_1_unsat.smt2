; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b0010101101)
                arg1
                (fp #b0 #b11100011 #b1000010110)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010110)
                arg1
                (fp #b0 #b11111110 #b1101110010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011101 #b1110111101)
                arg2
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b10101101 #b1000110110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1001100000)
                expect
                (fp #b0 #b11100011 #b1000010101)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010101)
                expect
                (fp #b0 #b11101000 #b0001011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
