(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b11010000 #b1011000110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b1010101001)
                expect
                (fp #b0 #b10100101 #b0001110111)))
(assert (fp.leq (fp #b0 #b10100101 #b0001110111)
                expect
                (fp #b0 #b10111111 #b0111100010)))

(assert (not (= expect result)))

(check-sat)
