; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101001 #b0011010111)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b10100111 #b0011101011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b1111100100)
                arg2
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b11011111 #b0011101110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000010 #b0010010101)
                expect
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                expect
                (fp #b1 #b00110001 #b1011011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
