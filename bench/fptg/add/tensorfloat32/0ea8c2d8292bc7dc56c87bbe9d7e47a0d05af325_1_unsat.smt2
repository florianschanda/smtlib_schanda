(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000011 #b1111001010)
                expect
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                expect
                (fp #b0 #b11000111 #b0010010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
