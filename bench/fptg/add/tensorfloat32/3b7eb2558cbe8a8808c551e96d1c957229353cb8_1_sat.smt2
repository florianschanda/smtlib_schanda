                arg2
                (fp #b0 #b11011010 #b0111001101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011001 #b0110000110)
                expect
                (fp #b1 #b00000000 #b1110001011)))
(assert (fp.leq (fp #b1 #b00000000 #b1110001011)
                expect
                (fp #b0 #b11100101 #b1010111010)))

(assert (= expect result))

(check-sat)
(exit)
