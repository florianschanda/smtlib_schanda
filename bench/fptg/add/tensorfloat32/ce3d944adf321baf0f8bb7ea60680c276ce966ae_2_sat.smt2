(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b0001100101)
                arg1
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                arg1
                (fp #b0 #b10101001 #b0001001001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b1110100010)
                arg2
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b1 #b00110010 #b0000100101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100111 #b0110111101)
                expect
                (fp #b1 #b11100110 #b0100111101)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111101)
                expect
                (fp #b1 #b00101101 #b1101101101)))

(assert (= expect result))

(check-sat)
(exit)
