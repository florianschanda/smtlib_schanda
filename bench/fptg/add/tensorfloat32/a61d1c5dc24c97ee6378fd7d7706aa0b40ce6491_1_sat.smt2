(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b0000001010)
                arg1
                (fp #b0 #b11010101 #b1001011001)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011001)
                arg1
                (fp #b0 #b11011010 #b0110110110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b1011100101)
                arg2
                (fp #b1 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b00011100 #b1000100100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10000101 #b0001100101)
                expect
                (fp #b0 #b11010101 #b1001011000)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011000)
                expect
                (fp #b0 #b11111101 #b1001111000)))

(assert (= expect result))

(check-sat)
(exit)
