(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00100000 #b0011100111)
                arg1
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b10011101 #b0011100101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100101 #b0111001110)
                arg2
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b1 #b01100011 #b0101100110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1101000110)
                expect
                (fp #b1 #b11010110 #b0001001001)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                expect
                (fp #b0 #b11100011 #b0100111100)))

(assert (= expect result))

(check-sat)
(exit)
