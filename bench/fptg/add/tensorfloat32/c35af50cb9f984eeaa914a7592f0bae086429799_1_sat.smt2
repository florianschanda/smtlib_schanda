; Format: TENSORFLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001111 #b1000010111)
                arg1
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b00010000 #b0010100111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111000 #b1010110101)
                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b10111001 #b1010100100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110110 #b0011000010)
                expect
                (fp #b1 #b00000000 #b0100101100)))
(assert (fp.leq (fp #b1 #b00000000 #b0100101100)
                expect
                (fp #b0 #b01001111 #b0101001001)))

(assert (= expect result))

(check-sat)
(exit)
