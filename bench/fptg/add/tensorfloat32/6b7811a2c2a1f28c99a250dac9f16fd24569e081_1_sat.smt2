; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b1010101100)
                arg1
                (fp #b1 #b00000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000 #b1110100001)
                arg1
                (fp #b0 #b01100111 #b0001010011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100010 #b0000001111)
                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b11000011 #b0010110010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011000 #b0111000100)
                expect
                (fp #b0 #b00111111 #b1111111111)))
(assert (fp.leq (fp #b0 #b00111111 #b1111111111)
                expect
                (fp #b0 #b10111001 #b0011111101)))

(assert (= expect result))

(check-sat)
(exit)
