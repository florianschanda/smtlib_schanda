(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00100110 #b1111111110)
                arg1
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg1
                (fp #b0 #b01101100 #b0101100011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100100 #b0000100010)
                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b1 #b01010100 #b1011010100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b0100000010)
                expect
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                expect
                (fp #b0 #b10100100 #b1100100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
