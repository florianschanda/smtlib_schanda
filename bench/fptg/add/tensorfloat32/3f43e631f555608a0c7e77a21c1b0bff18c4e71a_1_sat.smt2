(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001111 #b0011000101)
                arg1
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                arg1
                (fp #b0 #b00110111 #b0011011111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101011 #b0111011000)
                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b11110001 #b0000000010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011011 #b0111010010)
                expect
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                expect
                (fp #b0 #b10110100 #b0100111001)))

(assert (= expect result))

(check-sat)
(exit)
