(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b10010001 #b1011001010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000001 #b1111101000)
                expect
                (fp #b1 #b10001000 #b0110010000)))
(assert (fp.leq (fp #b1 #b10001000 #b0110010000)
                expect
                (fp #b0 #b10100010 #b1111100011)))

(assert (= expect result))

(check-sat)
(exit)
