                expect
                (fp #b0 #b00101101 #b1010110100)))
(assert (fp.leq (fp #b0 #b00101101 #b1010110100)
                expect
                (fp #b0 #b11001000 #b1011110100)))

(assert (not (= expect result)))

(check-sat)
