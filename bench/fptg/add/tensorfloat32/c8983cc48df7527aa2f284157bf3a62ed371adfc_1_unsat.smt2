                (fp #b0 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b10110101 #b0001111111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b1100101001)
                expect
                (fp #b0 #b10100101 #b0001110111)))
(assert (fp.leq (fp #b0 #b10100101 #b0001110111)
                expect
                (fp #b0 #b11110101 #b1010001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
