(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                arg1
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                arg1
                (fp #b0 #b01001010 #b0010001101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b1000101111)
                arg2
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b10100010 #b1000110110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                expect
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                expect
                (fp #b0 #b11100001 #b1110111101)))

(assert (= expect result))

(check-sat)
(exit)
