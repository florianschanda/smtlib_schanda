                arg2
                (fp #b1 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b00011110 #b1100111111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111100 #b1101110111)
                expect
                (fp #b0 #b00000000 #b1100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000000)
                expect
                (fp #b0 #b11001110 #b0111010101)))

(assert (= expect result))

(check-sat)
(exit)
