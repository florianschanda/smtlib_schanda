; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1101101111)
                arg1
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                arg1
                (fp #b1 #b01100000 #b0100000011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01111011 #b0000001110)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11000010 #b1001000100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0111110011)
                expect
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                expect
                (fp #b1 #b10000010 #b0101011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
