(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000100 #b1011001111)
                expect
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                expect
                (fp #b0 #b11010010 #b0000110011)))

(assert (not (= expect result)))

(check-sat)
