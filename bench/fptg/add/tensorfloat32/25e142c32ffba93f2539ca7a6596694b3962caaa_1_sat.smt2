(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101000 #b0101011001)
                expect
                (fp #b0 #b00000000 #b0111010100)))
(assert (fp.leq (fp #b0 #b00000000 #b0111010100)
                expect
                (fp #b0 #b11111000 #b1101101111)))

(assert (= expect result))

(check-sat)
(exit)
