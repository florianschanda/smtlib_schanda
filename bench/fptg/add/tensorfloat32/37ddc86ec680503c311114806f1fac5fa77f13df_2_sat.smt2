(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110111 #b0100101001)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b01101000 #b1001101001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001000 #b0110111101)
                arg2
                (fp #b1 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b00111110 #b0010101110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b1101101010)
                expect
                (fp #b1 #b10001010 #b0000000001)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000001)
                expect
                (fp #b0 #b11101111 #b1101001101)))

(assert (= expect result))

(check-sat)
(exit)
