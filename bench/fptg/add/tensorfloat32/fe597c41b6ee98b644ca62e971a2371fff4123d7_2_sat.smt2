(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10011110 #b1110101000)
                arg1
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b11100010 #b0100110111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111000 #b1101010010)
                arg2
                (fp #b0 #b00010010 #b1011100000)))
(assert (fp.leq (fp #b0 #b00010010 #b1011100000)
                arg2
                (fp #b0 #b01101101 #b1110001111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111111 #b1000000101)
                expect
                (fp #b0 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000000)
                expect
                (fp #b0 #b11011001 #b0010000101)))

(assert (= expect result))

(check-sat)
(exit)
