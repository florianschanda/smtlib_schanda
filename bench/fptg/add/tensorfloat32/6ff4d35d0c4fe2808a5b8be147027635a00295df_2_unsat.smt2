(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01000101 #b0111010100)
                expect
                (fp #b0 #b01111111 #b0000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000001)
                expect
                (fp #b0 #b11110101 #b1111111001)))

(assert (not (= expect result)))

(check-sat)
