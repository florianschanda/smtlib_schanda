(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b00001111 #b0010001100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011110 #b0010010001)
                expect
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                expect
                (fp #b0 #b11011000 #b1110101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
