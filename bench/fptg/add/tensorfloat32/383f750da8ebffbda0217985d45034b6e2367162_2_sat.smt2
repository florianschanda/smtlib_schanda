                arg1
                (fp #b0 #b00000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111000)
                arg1
                (fp #b0 #b11111011 #b0100000100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001011 #b1000011000)
                arg2
                (fp #b0 #b01111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011010)
                arg2
                (fp #b0 #b10010110 #b0101100001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111011 #b0011000110)
                expect
                (fp #b0 #b01111111 #b0100011011)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011011)
                expect
                (fp #b0 #b11110111 #b1011111011)))

(assert (= expect result))

(check-sat)
(exit)
