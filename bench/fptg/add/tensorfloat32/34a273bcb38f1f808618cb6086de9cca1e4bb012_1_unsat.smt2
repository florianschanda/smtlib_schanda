(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001010 #b1110110010)
                arg1
                (fp #b0 #b00000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111000)
                arg1
                (fp #b0 #b00011110 #b1010101011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
