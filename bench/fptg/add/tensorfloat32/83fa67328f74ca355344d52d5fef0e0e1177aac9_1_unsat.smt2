(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10010110 #b1100000100)
                arg1
                (fp #b0 #b11010101 #b1001011001)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011001)
                arg1
                (fp #b0 #b11011101 #b1101001010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011101 #b1001001100)
                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b1 #b01110011 #b1000101100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011001 #b1100101110)
                expect
                (fp #b0 #b11010101 #b1001011000)))
(assert (fp.leq (fp #b0 #b11010101 #b1001011000)
                expect
                (fp #b0 #b11101011 #b1101110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
