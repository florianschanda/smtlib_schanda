;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010101 #b0011111010)
                arg1
                (fp #b0 #b00100111 #b1011110101)))
(assert (fp.leq (fp #b0 #b00100111 #b1011110101)
                arg1
                (fp #b0 #b10010110 #b1000001111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110101 #b0100000011)
                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b11001101 #b0001001110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100000 #b0011001000)
                expect
                (fp #b1 #b00111111 #b1111111111)))
(assert (fp.leq (fp #b1 #b00111111 #b1111111111)
                expect
                (fp #b0 #b00010000 #b0110110010)))

(assert (= expect result))

(check-sat)
(exit)
