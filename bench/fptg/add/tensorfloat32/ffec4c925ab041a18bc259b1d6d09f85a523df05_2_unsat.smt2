                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg2
                (fp #b0 #b01011010 #b0111111101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01010010 #b1011010101)
                expect
                (fp #b0 #b01111111 #b0101111100)))
(assert (fp.leq (fp #b0 #b01111111 #b0101111100)
                expect
                (fp #b0 #b11111001 #b1111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
