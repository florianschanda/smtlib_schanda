; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b0010111001)
                arg1
                (fp #b1 #b00000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000 #b1110100001)
                arg1
                (fp #b0 #b01100000 #b1101000111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                arg2
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                arg2
                (fp #b1 #b11101000 #b0110001110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111111 #b0000000000)
                expect
                (fp #b1 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111111)
                expect
                (fp #b1 #b10100100 #b1110101110)))

(assert (= expect result))

(check-sat)
(exit)
