;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110000 #b0011101111)
                arg1
                (fp #b0 #b00000001 #b0000000000)))
