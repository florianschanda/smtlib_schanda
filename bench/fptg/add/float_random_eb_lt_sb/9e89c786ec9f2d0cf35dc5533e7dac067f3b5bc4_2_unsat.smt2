(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 8))
(assert (fp.leq (fp #b1 #b1100100 #b0111001)
                arg1
                (fp #b1 #b1000110 #b0000110)))
(assert (fp.leq (fp #b1 #b1000110 #b0000110)
                arg1
                (fp #b0 #b1110100 #b0110101)))

(declare-const arg2 (_ FloatingPoint 7 8))
(assert (fp.leq (fp #b0 #b0011001 #b1111000)
                arg2
                (fp #b0 #b1111101 #b0000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000)
                arg2
                (fp #b0 #b1111101 #b0101110)))

(declare-const result (_ FloatingPoint 7 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 8))
(assert (fp.leq (fp #b0 #b0101011 #b0011000)
                expect
                (fp #b0 #b1111101 #b0000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000)
                expect
                (fp #b0 #b1111110 #b1101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
