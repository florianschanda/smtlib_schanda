; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 28))
(assert (fp.leq (fp #b1 #b100011 #b010100111001010100100100100)
                arg1
                (fp #b1 #b011111 #b111000010100110010110001001)))
(assert (fp.leq (fp #b1 #b011111 #b111000010100110010110001001)
                arg1
                (fp #b0 #b101111 #b011110010110000000111111111)))

(declare-const arg2 (_ FloatingPoint 6 28))
(assert (fp.leq (fp #b1 #b110100 #b111100111101010000000001101)
                arg2
                (fp #b0 #b111000 #b100101101100101100011111000)))
(assert (fp.leq (fp #b0 #b111000 #b100101101100101100011111000)
                arg2
                (fp #b0 #b111001 #b000101001000110111000100110)))

(declare-const result (_ FloatingPoint 6 28))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 28))
(assert (fp.leq (fp #b1 #b001010 #b111111110000011011010000101)
                expect
                (fp #b0 #b111000 #b100101101100101100011110000)))
(assert (fp.leq (fp #b0 #b111000 #b100101101100101100011110000)
                expect
                (fp #b0 #b111101 #b110100000110011010100011111)))

(assert (= expect result))

(check-sat)
(exit)
