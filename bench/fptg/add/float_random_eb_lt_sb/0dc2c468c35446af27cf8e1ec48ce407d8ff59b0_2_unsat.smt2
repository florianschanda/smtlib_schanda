(declare-const expect (_ FloatingPoint 2 15))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10 #b11011001101111)
                expect
                (fp #b1 #b00 #b00000000000000)))
(assert (fp.leq (fp #b1 #b00 #b00000000000000)
                expect
                (fp #b0 #b00 #b00000101010011)))

(assert (not (= expect result)))

