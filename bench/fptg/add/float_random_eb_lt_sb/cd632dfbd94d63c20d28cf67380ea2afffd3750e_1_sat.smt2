;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 27))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0001001110010 #b00010000000000001010110011)
                arg1
                (fp #b0 #b0000000000000 #b00000000000000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000000000000000000000000)
                arg1
                (fp #b0 #b0010111001001 #b01010111110010100101101101)))

