; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 40))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 40))
(assert (fp.leq (fp #b1 #b1111011000 #b111000100011101111111101110010110111010)
                arg2
                (fp #b1 #b0011101100 #b011010100000100111100110011001111111010)))
(assert (fp.leq (fp #b1 #b0011101100 #b011010100000100111100110011001111111010)
                arg2
                (fp #b0 #b1001001101 #b011011001111111001111010100010011101010)))

(declare-const result (_ FloatingPoint 10 40))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 40))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
