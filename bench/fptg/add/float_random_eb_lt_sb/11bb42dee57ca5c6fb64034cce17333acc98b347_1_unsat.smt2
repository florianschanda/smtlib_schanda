; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 36))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 6 36))
(assert (fp.leq (fp #b1 #b000001 #b01010010100011110100101011100010110)
                arg2
                (fp #b1 #b000000 #b01000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000000 #b01000000000000000000000000000000000)
                arg2
                (fp #b0 #b100110 #b01110011111001000111100000100100100)))

(declare-const result (_ FloatingPoint 6 36))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 36))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
