(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 2 16))
(assert (fp.leq (fp #b1 #b10 #b011110111011010)
                arg2
                (fp #b1 #b10 #b001100101101110)))
(assert (fp.leq (fp #b1 #b10 #b001100101101110)
                arg2
                (fp #b1 #b00 #b000110110001011)))

(declare-const result (_ FloatingPoint 2 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
