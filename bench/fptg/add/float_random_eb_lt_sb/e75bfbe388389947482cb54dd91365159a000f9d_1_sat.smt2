(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 11))
(assert (fp.leq (fp #b1 #b1001 #b0111011001)
                arg1
                (fp #b0 #b0001 #b0000000000)))
(assert (fp.leq (fp #b0 #b0001 #b0000000000)
                arg1
                (fp #b0 #b1000 #b1011101110)))

(declare-const arg2 (_ FloatingPoint 4 11))
(assert (fp.leq (fp #b1 #b1000 #b0100011101)
                arg2
                (fp #b1 #b0000 #b1000101100)))
(assert (fp.leq (fp #b1 #b0000 #b1000101100)
                arg2
                (fp #b0 #b0001 #b1000000000)))

(declare-const result (_ FloatingPoint 4 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 11))
(assert (fp.leq (fp #b1 #b1100 #b0001001011)
                expect
                (fp #b0 #b0000 #b0111010100)))
(assert (fp.leq (fp #b0 #b0000 #b0111010100)
                expect
                (fp #b0 #b1000 #b0001111101)))

(assert (= expect result))

(check-sat)
(exit)
