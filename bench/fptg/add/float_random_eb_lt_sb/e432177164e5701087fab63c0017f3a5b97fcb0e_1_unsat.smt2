; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: +NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 37))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10000 #b011111111010100110100011110001111110)
                arg1
                (fp #b1 #b00000 #b000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000 #b000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10000 #b110110111000000010100001110111011100)))

(declare-const arg2 (_ FloatingPoint 5 37))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 5 37))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 37))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
