; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b110 #b011000001010)
                arg1
                (fp #b1 #b100 #b111111111111)))
(assert (fp.leq (fp #b1 #b100 #b111111111111)
                arg1
                (fp #b0 #b011 #b110100110110)))

(declare-const arg2 (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b1 #b000 #b011111010010)
                arg2
                (fp #b0 #b110 #b010000000000)))
(assert (fp.leq (fp #b0 #b110 #b010000000000)
                arg2
                (fp #b0 #b110 #b010100110011)))

(declare-const result (_ FloatingPoint 3 13))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 13))
(assert (fp.leq (fp #b0 #b010 #b111001001111)
                expect
                (fp #b0 #b101 #b100000000000)))
(assert (fp.leq (fp #b0 #b101 #b100000000000)
                expect
                (fp #b0 #b110 #b001000101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
