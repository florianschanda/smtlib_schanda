(declare-const expect (_ FloatingPoint 8 20))
(assert (fp.leq (fp #b1 #b11010100 #b0110101001110111000)
                expect
                (fp #b1 #b01101101 #b0100001110101001110)))
(assert (fp.leq (fp #b1 #b01101101 #b0100001110101001110)
                expect
                (fp #b0 #b10010110 #b1001010011101010111)))

(assert (= expect result))

(check-sat)
