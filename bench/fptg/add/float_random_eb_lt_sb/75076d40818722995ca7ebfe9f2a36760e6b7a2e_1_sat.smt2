; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1001 #b01111100)
                arg1
                (fp #b0 #b1010 #b01100000)))
(assert (fp.leq (fp #b0 #b1010 #b01100000)
                arg1
                (fp #b0 #b1110 #b00111001)))

(declare-const arg2 (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b0000 #b01110001)
                arg2
                (fp #b0 #b1101 #b00001000)))
(assert (fp.leq (fp #b0 #b1101 #b00001000)
                arg2
                (fp #b0 #b1110 #b01010000)))

(declare-const result (_ FloatingPoint 4 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b0010 #b10110000)
                expect
                (fp #b0 #b1101 #b00110100)))
(assert (fp.leq (fp #b0 #b1101 #b00110100)
                expect
                (fp #b0 #b1101 #b01111100)))

(assert (= expect result))

(check-sat)
(exit)
