(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 9))
(assert (fp.leq (fp #b1 #b00011001 #b01001001)
                arg1
                (fp #b0 #b00000000 #b11111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111)
                arg1
                (fp #b0 #b11111100 #b00111011)))

(declare-const arg2 (_ FloatingPoint 8 9))
(assert (fp.leq (fp #b1 #b00111001 #b01001000)
                arg2
                (fp #b1 #b00000010 #b11111101)))
(assert (fp.leq (fp #b1 #b00000010 #b11111101)
                arg2
                (fp #b0 #b11010100 #b10011101)))

(declare-const result (_ FloatingPoint 8 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 9))
(assert (fp.leq (fp #b1 #b10011100 #b01111101)
                expect
                (fp #b1 #b00000010 #b01111101)))
(assert (fp.leq (fp #b1 #b00000010 #b01111101)
                expect
                (fp #b0 #b01110110 #b00110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
