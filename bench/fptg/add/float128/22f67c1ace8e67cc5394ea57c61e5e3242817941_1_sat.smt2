;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b001111001001111 #b0000110001101101100001000101100010100001010111011111100100000110000101011000101111001101111100111111101100001001)
                arg2
                (fp #b1 #b000000000000000 #b0110110101001110100110111011100110000010010000110100111011101000100010000001010001010110111110110110010000011111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0110110101001110100110111011100110000010010000110100111011101000100010000001010001010110111110110110010000011111)
                arg2
                (fp #b0 #b001000001101111 #b0111011100001110101000111110100011101110000111110011100000111011001000111000011010101011011100010100100111100001)))

(declare-const result Float128)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
