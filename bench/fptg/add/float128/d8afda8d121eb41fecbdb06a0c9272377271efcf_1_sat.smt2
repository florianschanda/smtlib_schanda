; Format: FLOAT128
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.leq (fp #b0 #b010000001110001 #b0010001010110110010100101010000001000111010000011110101100111011000110110101101101000000101011001010110111100100)
                arg1
                (fp #b0 #b011111111111111 #b0011010101001011010001000010111011100111010011111111010011011100101011011011100101000111111110000101111011000100)))
(assert (fp.leq (fp #b0 #b011111111111111 #b0011010101001011010001000010111011100111010011111111010011011100101011011011100101000111111110000101111011000100)
                arg1
                (fp #b0 #b101100110110011 #b1100011101011010100011010010100011010010000111111011100101111010100000000011011000000100110001011011011110000010)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
