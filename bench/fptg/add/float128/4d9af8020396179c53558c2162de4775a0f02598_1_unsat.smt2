(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b110100101001000 #b1011101001001101100011001100001110100000001111111000111001111000101110011100011111100011101101010000111111010011)
                arg2
                (fp #b0 #b100000001101010 #b1001011011001011000100011111100100010011110100100101111110000100010101100101111100001110010011111001001100100000)))
(assert (fp.leq (fp #b0 #b100000001101010 #b1001011011001011000100011111100100010011110100100101111110000100010101100101111100001110010011111001001100100000)
                arg2
                (fp #b0 #b110010101011100 #b0001001010100101100100000101110011010010010111010011010011010100011011101011111101001101100111101101110001101010)))

(declare-const result Float128)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

