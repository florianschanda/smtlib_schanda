(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1001000111)
                arg1
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg1
                (fp #b0 #b00100 #b0101010000)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0101001110)
                arg2
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg2
                (fp #b0 #b11101 #b0000110100)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00001 #b0000100011)
                expect
                (fp #b0 #b00100 #b0000000000)))
(assert (fp.leq (fp #b0 #b00100 #b0000000000)
                expect
                (fp #b0 #b01010 #b1011101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
