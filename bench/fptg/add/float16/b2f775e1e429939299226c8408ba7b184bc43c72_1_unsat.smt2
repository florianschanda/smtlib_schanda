(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0011000111)
                arg1
                (fp #b1 #b01111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111 #b1111110100)
                arg1
                (fp #b0 #b11010 #b0010010110)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101101000)
                arg2
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg2
                (fp #b0 #b11110 #b1010110010)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b0110000010)
                expect
                (fp #b0 #b11100 #b1111111111)))
(assert (fp.leq (fp #b0 #b11100 #b1111111111)
                expect
                (fp #b0 #b11101 #b1010100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
