; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011100100)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11000 #b1010110100)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01000 #b0001100011)
                arg2
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg2
                (fp #b0 #b11111 #b0000000000)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0101110010)
                expect
                (fp #b0 #b11110 #b1110111111)))
(assert (fp.leq (fp #b0 #b11110 #b1110111111)
                expect
                (fp #b0 #b11110 #b1111100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
