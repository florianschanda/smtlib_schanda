; Format: FLOAT16
; Arg1: +ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0011011011)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b11011 #b0000111110)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0001110000)
                arg2
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg2
                (fp #b1 #b01110 #b0110111011)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0100110001)
                expect
                (fp #b1 #b10110 #b1111110111)))
(assert (fp.leq (fp #b1 #b10110 #b1111110111)
                expect
                (fp #b0 #b00110 #b1011010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
