(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000011110)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00011 #b0101000111)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0010000011)
                arg2
                (fp #b1 #b00000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000 #b1000101100)
                arg2
                (fp #b0 #b01000 #b1100011011)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b1111100110)
                expect
                (fp #b1 #b00000 #b1100101100)))
(assert (fp.leq (fp #b1 #b00000 #b1100101100)
                expect
                (fp #b0 #b10001 #b0001011001)))

(assert (= expect result))

(check-sat)
(exit)
