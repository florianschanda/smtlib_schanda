(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111111010)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b01110 #b0000000101)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1011000010)
                arg2
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg2
                (fp #b0 #b01000 #b1110011100)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1100000000)
                expect
                (fp #b0 #b01011 #b1010110110)))
(assert (fp.leq (fp #b0 #b01011 #b1010110110)
                expect
                (fp #b0 #b10100 #b1001010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
