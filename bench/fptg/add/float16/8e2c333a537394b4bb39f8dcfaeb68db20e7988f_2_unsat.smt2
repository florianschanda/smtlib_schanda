(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0010011101)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b10111 #b0011010000)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00010 #b1011100000)
                arg2
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg2
                (fp #b0 #b10101 #b1000000001)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0100111000)
                expect
                (fp #b0 #b01111 #b1001100101)))
(assert (fp.leq (fp #b0 #b01111 #b1001100101)
                expect
                (fp #b0 #b11110 #b1010111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
