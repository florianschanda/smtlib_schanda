(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0101110111)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11110 #b1011110110)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01011 #b0001010100)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11101 #b0010011010)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0100000101)
                expect
                (fp #b0 #b11001 #b1101100000)))
(assert (fp.leq (fp #b0 #b11001 #b1101100000)
                expect
                (fp #b0 #b11100 #b0110101101)))

(assert (= expect result))

(check-sat)
(exit)
