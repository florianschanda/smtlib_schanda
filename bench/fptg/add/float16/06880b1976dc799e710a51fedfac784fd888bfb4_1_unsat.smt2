; Format: FLOAT16
; Arg1: +LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0100111110)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1010010110)
                arg2
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg2
                (fp #b0 #b01101 #b0001001010)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b1011110010)
                expect
                (fp #b0 #b11110 #b1110111111)))
(assert (fp.leq (fp #b0 #b11110 #b1110111111)
                expect
                (fp #b0 #b11110 #b1111101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
