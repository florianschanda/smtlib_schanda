(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100110101)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b1 #b01010 #b1101101001)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0111100010)
                arg2
                (fp #b0 #b01111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111 #b0100011010)
                arg2
                (fp #b0 #b10000 #b0011111110)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101001110)
                expect
                (fp #b1 #b11001 #b1111111111)))
(assert (fp.leq (fp #b1 #b11001 #b1111111111)
                expect
                (fp #b1 #b01010 #b1000111101)))

(assert (= expect result))

(check-sat)
(exit)
