(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10010 #b1010111010)
                arg1
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg1
                (fp #b0 #b11110 #b0101010100)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b0111011011)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11011 #b1101111110)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0110000100)
                expect
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                expect
                (fp #b0 #b11001 #b1011101011)))

(assert (= expect result))

(check-sat)
(exit)
