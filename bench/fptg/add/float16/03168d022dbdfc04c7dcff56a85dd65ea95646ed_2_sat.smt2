(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10010 #b1111100010)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0110111000)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1000110111)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b10111 #b0000100111)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00011 #b0001101100)
                expect
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                expect
                (fp #b0 #b11011 #b1101100011)))

(assert (= expect result))

(check-sat)
(exit)
