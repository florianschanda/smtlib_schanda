(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b1111111001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11010 #b1100000001)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1100101110)
                arg2
                (fp #b0 #b00001 #b0100111010)))
(assert (fp.leq (fp #b0 #b00001 #b0100111010)
                arg2
                (fp #b0 #b11011 #b1101110111)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00111 #b1000011110)
                expect
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                expect
                (fp #b0 #b11101 #b1010000001)))

(assert (= expect result))

(check-sat)
(exit)
