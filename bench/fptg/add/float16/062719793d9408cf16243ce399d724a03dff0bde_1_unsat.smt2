(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b0011110000)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b00000 #b1100001000)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11000 #b1101101101)
                arg2
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg2
                (fp #b0 #b11000 #b0010111001)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0001001101)
                expect
                (fp #b1 #b00000 #b1010010110)))
(assert (fp.leq (fp #b1 #b00000 #b1010010110)
                expect
                (fp #b1 #b00000 #b1000110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
