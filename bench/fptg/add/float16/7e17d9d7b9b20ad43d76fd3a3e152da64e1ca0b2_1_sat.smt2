(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000010111)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10111 #b1111110100)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01010 #b0001010010)
                arg2
                (fp #b0 #b11001 #b0100111000)))
(assert (fp.leq (fp #b0 #b11001 #b0100111000)
                arg2
                (fp #b0 #b11011 #b0000001011)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1100010111)
                expect
                (fp #b1 #b10111 #b1101100100)))
(assert (fp.leq (fp #b1 #b10111 #b1101100100)
                expect
                (fp #b0 #b00001 #b1101010110)))

(assert (= expect result))

(check-sat)
(exit)
