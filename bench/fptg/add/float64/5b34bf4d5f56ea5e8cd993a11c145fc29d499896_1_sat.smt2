(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101111101 #b1111000010101111111010100111101110011001010010001110)
                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b01000000011 #b1011011000100101111100110100101010010011010011000010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
