                (fp #b0 #b01000101101 #b1110011111011011001010011111010010111010101100110000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011011011 #b0110000111111000001010101010111001001101110101010110)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011100110 #b0111111101101110000000101101101010011101111001101111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01111000110 #b0101111101000101011011111110100000111010011111111111)
                expect
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01000000101 #b1011111011100000001100011000011000000011100101110000)))

(assert (= expect result))

(check-sat)
(exit)
