(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101110100 #b0101011111000000110010011011001010100000000101100011)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01100010010 #b0110111111101100010000011000110011110000001100110011)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
