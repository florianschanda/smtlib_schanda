                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11100010000 #b0001111010001111100101000011001111001000000000101111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010101011 #b0101011100100010011010010011011110000111001110101000)
                expect
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                expect
                (fp #b0 #b11111100101 #b1111001111000011001001111111001001001100001101010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
