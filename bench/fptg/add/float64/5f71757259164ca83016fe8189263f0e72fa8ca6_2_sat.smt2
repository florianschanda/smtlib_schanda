                arg2
                (fp #b0 #b11100101101 #b0000111000101100000010010101110001111101110011011111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000000 #b0000110001101000111010000000010001111101001000101110)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11010111101 #b1100011110010010010110110111001101101111011001110011)))

(assert (= expect result))

(check-sat)
(exit)
