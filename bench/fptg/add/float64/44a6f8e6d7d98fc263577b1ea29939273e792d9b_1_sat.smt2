                arg2
                (fp #b0 #b11101110101 #b1010000000000110111101111011110111100010100010010110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010010010 #b0101001010001101011101101111010011010101100000111100)
