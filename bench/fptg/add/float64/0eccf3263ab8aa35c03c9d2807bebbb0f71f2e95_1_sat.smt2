; Format: FLOAT64
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101110100 #b0001111010100000011010100100011001110100000111111101)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101000101 #b0101010101110000100100101000000011101001100111110101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010010101 #b0000110110010000010110110101101011101011110101101010)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11100010000 #b0110000101000000101110111010010101101011100110011110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000010 #b1000100100000100010110110011100100110110011111011001)
                expect
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10100100001 #b1101000110000110100000100010100111111101011011111001)))

(assert (= expect result))

(check-sat)
(exit)
