                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01111101011 #b1011011001111001011001101111111111101100011111010100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100011100 #b1011001011000111100110010101100000111100100000110100)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010011111 #b1010011011110011010001100011000010101110000001111011)))

(assert (= expect result))

(check-sat)
(exit)
