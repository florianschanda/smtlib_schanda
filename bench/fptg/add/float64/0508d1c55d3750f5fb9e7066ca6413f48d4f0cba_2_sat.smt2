; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001110010 #b0100001101001110011011111011001100110010000010011110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00111100011 #b0110011111001111100001010010110001100110100110011110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00011000101 #b0000001011010100001101111111111001111110111010010111)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b11001100111 #b0110010110100101111110101010101001010101001101001010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00011100100 #b1000001101000010000100111001100110001101000101001101)
                expect
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                expect
                (fp #b0 #b11011110000 #b1000100101100010001011100111110100010000110010010101)))

(assert (= expect result))

(check-sat)
(exit)
