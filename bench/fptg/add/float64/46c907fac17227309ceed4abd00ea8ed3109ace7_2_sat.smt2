(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000110110 #b1000101111101001111011000110111011001110100100000110)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b11100000101 #b0000001010001101101100111001001000100010100100011111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01101011100 #b1011110111000100100001000010001010110100111011110011)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                expect
                (fp #b0 #b11000100110 #b1111000100001101100001101101000111010000101110101111)))

(assert (= expect result))

(check-sat)
(exit)
