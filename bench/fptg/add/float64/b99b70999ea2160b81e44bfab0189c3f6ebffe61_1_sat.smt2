                arg2
                (fp #b0 #b11100111000 #b0001001100000010001010101000000101100101101110011110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100110 #b1110000000001010010001001100110111001111010101011101)
                expect
