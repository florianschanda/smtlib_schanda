; Format: FLOAT64
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101000010 #b0101111100000101000110100111110001001111010011010111)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111111101 #b0010011100111100011001100000101001110010111100011010)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01101000111 #b0110010001100110001011111101000100111111000100110110)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11110100100 #b1010001100100011010100000101011010100010110110100110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011010111 #b1100101000110001111000000000011110011101111001100101)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111110 #b0101110111101100011011010100111001010100001101000111)))

(assert (= expect result))

(check-sat)
(exit)
