                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b10010000000 #b1001100101111000110111101010101001001001101100001101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111100111 #b1111010101110111110010110101010010100100000111010011)
                expect
                (fp #b1 #b00111111111 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00111111111 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11110100001 #b1111011110010001100011111100101010001110001011001111)))

(assert (= expect result))

(check-sat)
(exit)
