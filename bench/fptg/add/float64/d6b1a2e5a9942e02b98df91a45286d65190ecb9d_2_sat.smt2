                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b1 #b01101001000 #b1001011010010010001101101110111101101111111000101010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101011001 #b1100010110101110001000111101111010111011101010001101)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
