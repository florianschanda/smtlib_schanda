                arg2
                (fp #b1 #b01101000010 #b1100100010111001010100010111011100010111111010101110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000011 #b1000000010111001010100010001010001010001011000101101)
                expect
