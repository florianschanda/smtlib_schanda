                arg2
                (fp #b0 #b00100110110 #b1111010101100010111111010101110110100001000110001000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010001111 #b0100001111100100001101111000010111100000010001010111)
                expect
