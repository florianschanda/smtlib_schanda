                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11100011010 #b0000010001100100010010010001101000000101001111001001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011010100 #b1001110000110100000101010011100010111100100011111110)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110110)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110110)
                expect
                (fp #b0 #b10101001001 #b1111110010111011010001100111111010001001000111100111)))

(assert (= expect result))

(check-sat)
(exit)
