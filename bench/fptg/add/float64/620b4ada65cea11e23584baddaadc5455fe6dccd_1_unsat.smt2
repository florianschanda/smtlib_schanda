; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010111000 #b1100110100000110011001001011001111111011110000101101)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b01110100001 #b1001110010000111011101111010001001110000001010101001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
