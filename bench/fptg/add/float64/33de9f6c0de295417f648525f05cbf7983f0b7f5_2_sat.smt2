; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111011000 #b1000011111011011001011101010101010011001010111010000)
                arg1
                (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)
                arg1
                (fp #b0 #b10000000100 #b0001000101110010101110101110111111011111010100011110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011011101 #b1111010100011000101000010010000111111101111111101111)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01000010010 #b1111101100110010101011010100010001100011111101101011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000001110 #b0001111011101110110011000100100011000100100000001010)
                expect
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                expect
                (fp #b0 #b11011100010 #b1011010011011000010111010110000101010101111100101001)))

(assert (= expect result))

(check-sat)
(exit)
