; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110100100 #b1000011110111100001001110101101100101010101000001110)
                arg1
                (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)))
(assert (fp.leq (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)
                arg1
                (fp #b0 #b11101111010 #b1100010000000111010000101000000100001111010010101001)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
