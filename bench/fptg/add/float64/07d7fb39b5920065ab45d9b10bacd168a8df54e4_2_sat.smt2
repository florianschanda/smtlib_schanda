(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101110101 #b1010010101010001100011110011111111110101001000011001)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b1 #b00001110101 #b1110101011011101011001010111001011000101110001111110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100101000 #b1110110101010110010001000010000100011101011001111111)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00000010000 #b1100101110000100010101011011001101100100100000001101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101001111 #b1001001011100000011001011100011100101000000101000110)
                expect
                (fp #b1 #b10000110100 #b0000000001110010011110000011110101101110101100100100)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000001110010011110000011110101101110101100100100)
                expect
                (fp #b0 #b01011100100 #b0000000110000110010011010001101010011001001111111100)))

(assert (= expect result))

(check-sat)
(exit)
