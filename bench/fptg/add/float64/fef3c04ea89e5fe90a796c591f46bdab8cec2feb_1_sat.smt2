; Format: FLOAT64
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010101101 #b0011000001000010111001010110100000110011011111101011)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b01110100011 #b0110000011010101001010000101011111100011011101101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001100101 #b0100000000111111011000101111111011101101010001110000)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b00100110001 #b1110001110000110100011101100110000010000110111010111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001100000 #b1110110011110011101011111100000100011000111000111101)
                expect
                (fp #b1 #b10000110100 #b0011011001110000111100110000001000000010101101000110)))
(assert (fp.leq (fp #b1 #b10000110100 #b0011011001110000111100110000001000000010101101000110)
                expect
                (fp #b0 #b01111110110 #b0101100111110101000010101011101000011000010110101001)))

(assert (= expect result))

(check-sat)
(exit)
