; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101100110 #b1110110011010010101100011111111000011011000101111110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b11111001000 #b0111011110011111000100110011101110101000010111000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101001010 #b0100001101101110111101101110011010001011111101001001)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b00001011111 #b1010110010101111110111110010110010010001100001010000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011110001 #b1101101101101000000100000001101100101101011111110100)
                expect
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001101)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001101)
                expect
                (fp #b0 #b00111101101 #b0111110010100111100111100001110101110101000010000100)))

(assert (= expect result))

(check-sat)
(exit)
