;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b001)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b0100 #b101)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0010 #b111)
                arg2
                (fp #b1 #b0000 #b101)))
(assert (fp.leq (fp #b1 #b0000 #b101)
                arg2
                (fp #b0 #b1000 #b100)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b110)
                expect
                (fp #b1 #b0000 #b111)))
(assert (fp.leq (fp #b1 #b0000 #b111)
                expect
                (fp #b0 #b1010 #b101)))

(assert (= expect result))

(check-sat)
(exit)
