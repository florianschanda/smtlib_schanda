(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b1 #b000111101 #b00001011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011000000 #b10110110)
                expect
                (fp #b0 #b100000111 #b11000010)))
(assert (fp.leq (fp #b0 #b100000111 #b11000010)
                expect
                (fp #b0 #b110100011 #b11110110)))

(assert (not (= expect result)))

(check-sat)
