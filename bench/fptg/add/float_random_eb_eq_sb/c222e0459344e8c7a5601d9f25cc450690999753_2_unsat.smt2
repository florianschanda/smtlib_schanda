; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010110011 #b000110101)
                arg1
                (fp #b1 #b0111111111 #b111000101)))
(assert (fp.leq (fp #b1 #b0111111111 #b111000101)
                arg1
                (fp #b1 #b0100000101 #b111010100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100100100 #b101001111)
                arg2
                (fp #b0 #b1010111000 #b000110101)))
(assert (fp.leq (fp #b0 #b1010111000 #b000110101)
                arg2
                (fp #b0 #b1110110001 #b011111100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111010101 #b100000001)
                expect
                (fp #b0 #b1010111000 #b000110101)))
(assert (fp.leq (fp #b0 #b1010111000 #b000110101)
                expect
                (fp #b0 #b1111101010 #b000010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
