                (fp #b1 #b000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b000000000000 #b10011011110)
                arg1
                (fp #b0 #b111010011000 #b00111101111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100010111 #b00111001010)
                arg2
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                arg2
                (fp #b0 #b100101111001 #b00100101011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010110111010 #b10010000000)
                expect
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                expect
                (fp #b0 #b100011000001 #b01010001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
