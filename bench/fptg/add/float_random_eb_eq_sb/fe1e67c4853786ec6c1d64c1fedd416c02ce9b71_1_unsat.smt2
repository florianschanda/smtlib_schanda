; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011111 #b010010)
                arg1
                (fp #b0 #b0000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000 #b010000)
                arg1
                (fp #b0 #b1101000 #b101000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                arg2
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                arg2
                (fp #b1 #b0001100 #b001011)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                expect
                (fp #b1 #b1111110 #b111110)))
(assert (fp.leq (fp #b1 #b1111110 #b111110)
                expect
                (fp #b1 #b0101110 #b011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
