(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110000100 #b0011011000)
                arg1
                (fp #b1 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                arg1
                (fp #b0 #b11011010110 #b0111010000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101010001 #b1010110100)
                arg2
                (fp #b1 #b10010100010 #b0000000111)))
(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                arg2
                (fp #b0 #b01011010000 #b0110100011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111100110 #b0111110110)
                expect
                (fp #b1 #b10010100010 #b0000000111)))
(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                expect
                (fp #b0 #b10011010011 #b0111000111)))

(assert (= expect result))

(check-sat)
(exit)
