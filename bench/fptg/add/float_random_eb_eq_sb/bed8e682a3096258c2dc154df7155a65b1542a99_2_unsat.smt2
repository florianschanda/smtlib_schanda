; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1101)
                arg1
                (fp #b1 #b10111 #b1001)))
(assert (fp.leq (fp #b1 #b10111 #b1001)
                arg1
                (fp #b1 #b00101 #b1011)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b1110)
                arg2
                (fp #b1 #b00000 #b0111)))
(assert (fp.leq (fp #b1 #b00000 #b0111)
                arg2
                (fp #b0 #b01011 #b0010)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b1101)
                expect
                (fp #b1 #b10111 #b1010)))
(assert (fp.leq (fp #b1 #b10111 #b1010)
                expect
                (fp #b1 #b00000 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
