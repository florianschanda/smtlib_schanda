; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000010 #b10001001)
                arg1
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg1
                (fp #b0 #b010110011 #b11011010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100001111 #b00110100)
                arg2
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                arg2
                (fp #b0 #b111111111 #b00000000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000000101 #b10011000)
                expect
                (fp #b0 #b111111110 #b11111110)))
(assert (fp.leq (fp #b0 #b111111110 #b11111110)
                expect
                (fp #b0 #b111111110 #b11111111)))

(assert (= expect result))

(check-sat)
(exit)
