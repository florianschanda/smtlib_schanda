; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010010 #b00110111)
                arg1
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg1
                (fp #b0 #b111101111 #b01100011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011010 #b11110100)
                arg2
                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b101101000 #b10100010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000111 #b00110110)
                expect
                (fp #b1 #b001111011 #b11111111)))
(assert (fp.leq (fp #b1 #b001111011 #b11111111)
                expect
                (fp #b1 #b000000001 #b01101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
