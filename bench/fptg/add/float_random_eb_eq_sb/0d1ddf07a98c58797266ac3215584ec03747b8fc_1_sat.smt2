(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000001 #b011000)
                arg1
                (fp #b1 #b0101001 #b011010)))
(assert (fp.leq (fp #b1 #b0101001 #b011010)
                arg1
                (fp #b1 #b0011100 #b110100)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1000010 #b011110)
                arg2
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                arg2
                (fp #b0 #b1001110 #b001010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101000 #b000001)
                expect
                (fp #b0 #b1000101 #b111111)))
(assert (fp.leq (fp #b0 #b1000101 #b111111)
                expect
                (fp #b0 #b1010001 #b010011)))

(assert (= expect result))

(check-sat)
(exit)
