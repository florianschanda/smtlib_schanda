(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b111000)
                arg1
                (fp #b1 #b1111101 #b101100)))
(assert (fp.leq (fp #b1 #b1111101 #b101100)
                arg1
                (fp #b0 #b1011010 #b001111)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0111111 #b011100)
                arg2
                (fp #b0 #b0000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000 #b111111)
                arg2
                (fp #b0 #b0100101 #b011000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b000100)
                expect
                (fp #b1 #b1111101 #b101100)))
(assert (fp.leq (fp #b1 #b1111101 #b101100)
                expect
                (fp #b0 #b0100001 #b001011)))

(assert (= expect result))

(check-sat)
(exit)
