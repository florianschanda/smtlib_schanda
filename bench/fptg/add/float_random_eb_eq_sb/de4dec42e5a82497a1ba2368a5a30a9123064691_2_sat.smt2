(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00101)
                arg1
                (fp #b1 #b010000 #b11111)))
(assert (fp.leq (fp #b1 #b010000 #b11111)
                arg1
                (fp #b1 #b001011 #b01010)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001010 #b10001)
                arg2
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                arg2
                (fp #b0 #b010000 #b01110)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010100 #b00010)
                expect
                (fp #b1 #b010001 #b00000)))
(assert (fp.leq (fp #b1 #b010001 #b00000)
                expect
                (fp #b0 #b010100 #b00100)))

(assert (= expect result))

(check-sat)
(exit)
