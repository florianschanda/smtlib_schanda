(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010100 #b00011010)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b1 #b001110010 #b01110001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111000 #b01011010)
                expect
                (fp #b1 #b010101011 #b00101111)))
(assert (fp.leq (fp #b1 #b010101011 #b00101111)
                expect
                (fp #b1 #b010010100 #b11110000)))

(assert (= expect result))

(check-sat)
(exit)
