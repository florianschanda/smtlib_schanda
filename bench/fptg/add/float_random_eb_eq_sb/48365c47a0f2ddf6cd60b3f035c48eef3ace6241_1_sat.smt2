(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001100010 #b01011000)
                arg1
                (fp #b0 #b000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b000000000 #b10100110)
                arg1
                (fp #b0 #b100010011 #b01101100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110011 #b10011111)
                arg2
                (fp #b0 #b110100001 #b11100010)))
(assert (fp.leq (fp #b0 #b110100001 #b11100010)
                arg2
                (fp #b0 #b111100111 #b01101000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010110110 #b00010011)
                expect
                (fp #b0 #b110100001 #b11100010)))
(assert (fp.leq (fp #b0 #b110100001 #b11100010)
                expect
                (fp #b0 #b111111101 #b10101010)))

(assert (= expect result))

(check-sat)
(exit)
