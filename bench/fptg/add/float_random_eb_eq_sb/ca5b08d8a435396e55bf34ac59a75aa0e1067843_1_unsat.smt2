(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1011011 #b010100)
                expect
                (fp #b0 #b1111000 #b100110)))
(assert (fp.leq (fp #b0 #b1111000 #b100110)
                expect
                (fp #b0 #b1111001 #b001010)))

(assert (not (= expect result)))

