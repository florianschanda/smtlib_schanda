; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111101010 #b000001011)
                arg1
                (fp #b0 #b1111001111 #b110100110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110100110)
                arg1
                (fp #b0 #b1111110011 #b101010011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001100010 #b101101100)
                expect
                (fp #b0 #b1111010000 #b110100110)))
(assert (fp.leq (fp #b0 #b1111010000 #b110100110)
                expect
                (fp #b0 #b1111011101 #b101011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
