; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011010 #b110010011)
                arg1
                (fp #b1 #b1000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000001000 #b011100001)
                arg1
                (fp #b1 #b0000010110 #b010011000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001001 #b010100001)
                arg2
                (fp #b1 #b1110100100 #b011110101)))
(assert (fp.leq (fp #b1 #b1110100100 #b011110101)
                arg2
                (fp #b1 #b0100110110 #b000111101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100111 #b011110100)
                expect
                (fp #b1 #b1110100100 #b011110101)))
(assert (fp.leq (fp #b1 #b1110100100 #b011110101)
                expect
                (fp #b1 #b1001100100 #b010000101)))

(assert (= expect result))

(check-sat)
(exit)
