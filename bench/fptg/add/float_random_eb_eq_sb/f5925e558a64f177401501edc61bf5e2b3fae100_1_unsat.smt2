(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110110 #b110001)
                arg1
                (fp #b0 #b0001000 #b100110)))
(assert (fp.leq (fp #b0 #b0001000 #b100110)
                arg1
                (fp #b0 #b1000110 #b010111)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101000 #b000000)
                arg2
                (fp #b1 #b0000001 #b000000)))
(assert (fp.leq (fp #b1 #b0000001 #b000000)
                arg2
                (fp #b0 #b0011110 #b011100)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101100 #b001101)
                expect
                (fp #b0 #b0001000 #b100101)))
(assert (fp.leq (fp #b0 #b0001000 #b100101)
                expect
                (fp #b0 #b1110010 #b000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
