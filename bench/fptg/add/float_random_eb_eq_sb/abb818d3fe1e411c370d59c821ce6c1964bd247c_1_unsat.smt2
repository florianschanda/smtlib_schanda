(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110010 #b111000)
                expect
                (fp #b1 #b1011110 #b111110)))
(assert (fp.leq (fp #b1 #b1011110 #b111110)
                expect
                (fp #b0 #b1100101 #b011011)))

(assert (not (= expect result)))

