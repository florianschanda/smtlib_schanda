;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0000101 #b111001)
                arg1
                (fp #b0 #b0000000 #b010111)))
(assert (fp.leq (fp #b0 #b0000000 #b010111)
                arg1
                (fp #b0 #b1111011 #b000001)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                arg2
                (fp #b1 #b1111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111110 #b111111)
                arg2
                (fp #b0 #b1101111 #b000001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111111 #b000000)
                expect
                (fp #b1 #b1111110 #b111110)))
(assert (fp.leq (fp #b1 #b1111110 #b111110)
                expect
                (fp #b0 #b0110110 #b111110)))

(assert (= expect result))

(check-sat)
(exit)
