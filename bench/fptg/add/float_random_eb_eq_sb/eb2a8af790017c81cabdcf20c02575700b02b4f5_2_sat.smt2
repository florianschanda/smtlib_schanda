(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b101)
                arg1
                (fp #b1 #b0000 #b110)))
(assert (fp.leq (fp #b1 #b0000 #b110)
                arg1
                (fp #b0 #b0000 #b100)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0100 #b011)
                expect
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                expect
                (fp #b0 #b1101 #b111)))

(assert (= expect result))

(check-sat)
(exit)
