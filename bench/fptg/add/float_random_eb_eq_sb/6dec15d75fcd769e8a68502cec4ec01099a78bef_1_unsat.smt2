; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110111 #b00000010)
                arg1
                (fp #b1 #b100000100 #b01111000)))
(assert (fp.leq (fp #b1 #b100000100 #b01111000)
                arg1
                (fp #b0 #b110111111 #b10011001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000111001 #b11101110)
                arg2
                (fp #b0 #b111011111 #b11011111)))
(assert (fp.leq (fp #b0 #b111011111 #b11011111)
                arg2
                (fp #b0 #b111111100 #b11101010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000110001 #b00000101)
                expect
                (fp #b0 #b111011111 #b11011110)))
(assert (fp.leq (fp #b0 #b111011111 #b11011110)
                expect
                (fp #b0 #b111101110 #b00011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
