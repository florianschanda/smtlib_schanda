(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0110011 #b101110)
                arg1
                (fp #b0 #b1100010 #b101011)))
(assert (fp.leq (fp #b0 #b1100010 #b101011)
                arg1
                (fp #b0 #b1111010 #b001101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101011 #b110010)
                arg2
                (fp #b1 #b1101010 #b001101)))
(assert (fp.leq (fp #b1 #b1101010 #b001101)
                arg2
                (fp #b0 #b0011101 #b100000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b101010)
                expect
                (fp #b1 #b1101010 #b001101)))
(assert (fp.leq (fp #b1 #b1101010 #b001101)
                expect
                (fp #b1 #b1011011 #b100011)))

(assert (= expect result))

(check-sat)
(exit)
