; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100101110 #b01111101000)
                arg1
                (fp #b0 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000001 #b00000000000)
                arg1
                (fp #b0 #b100000100111 #b00001111001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011001010 #b10110110111)
                arg2
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                arg2
                (fp #b0 #b101100011000 #b11101101111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101000100 #b01110111000)
                expect
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                expect
                (fp #b0 #b111011001010 #b00100001011)))

(assert (= expect result))

(check-sat)
(exit)
