; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110001111 #b010101011)
                arg1
                (fp #b0 #b1000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000111000)
                arg1
                (fp #b0 #b1101001100 #b100010110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0100110010 #b011000000)
                arg2
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg2
                (fp #b0 #b1010100010 #b000111111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001000101 #b001110000)
                expect
                (fp #b0 #b1000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000111000)
                expect
                (fp #b0 #b1110101001 #b100011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
