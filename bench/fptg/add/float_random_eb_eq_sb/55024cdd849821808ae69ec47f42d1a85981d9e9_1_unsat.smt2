(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101010010 #b011111100)
                arg1
                (fp #b0 #b0111111111 #b101000010)))
(assert (fp.leq (fp #b0 #b0111111111 #b101000010)
                arg1
                (fp #b0 #b1101011011 #b001110001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111101 #b101010101)
                arg2
                (fp #b1 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b000000000)
                arg2
                (fp #b0 #b0110101010 #b111001000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001011 #b100000110)
                expect
                (fp #b0 #b0111111111 #b101000001)))
(assert (fp.leq (fp #b0 #b0111111111 #b101000001)
                expect
                (fp #b0 #b1010010000 #b100110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
