                (fp #b0 #b0100000 #b000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000)
                arg2
                (fp #b0 #b0111011 #b000100)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101000 #b011001)
                expect
                (fp #b0 #b0111111 #b000001)))
(assert (fp.leq (fp #b0 #b0111111 #b000001)
                expect
                (fp #b0 #b1010110 #b001100)))

(assert (= expect result))

(check-sat)
