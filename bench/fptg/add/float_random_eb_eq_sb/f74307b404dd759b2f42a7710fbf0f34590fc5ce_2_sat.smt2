;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010111111 #b11111011101)
                arg1
                (fp #b1 #b011111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010001)
                arg1
                (fp #b1 #b000010010010 #b10100101110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001111110100 #b10000010110)
                arg2
                (fp #b1 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b000011100001 #b11010000110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011001110 #b11001100110)
                expect
                (fp #b1 #b011111111111 #b11001010010)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010010)
                expect
                (fp #b0 #b011110000100 #b11101110100)))

(assert (= expect result))

(check-sat)
(exit)
