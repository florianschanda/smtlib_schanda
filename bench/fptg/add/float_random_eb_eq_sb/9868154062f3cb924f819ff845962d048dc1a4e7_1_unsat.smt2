; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110101 #b11010101)
                arg1
                (fp #b0 #b000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000000)
                arg1
                (fp #b0 #b011100110 #b00001011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110000 #b10110011)
                arg2
                (fp #b0 #b010000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000000)
                arg2
                (fp #b0 #b011100110 #b10100100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011001001 #b10110100)
                expect
                (fp #b0 #b010000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000000)
                expect
                (fp #b0 #b111010001 #b00111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
