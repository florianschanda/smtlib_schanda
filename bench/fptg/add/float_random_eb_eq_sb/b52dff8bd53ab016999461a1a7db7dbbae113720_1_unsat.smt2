(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001100010101001 #b11100111101000)
                arg2
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b001111000100000 #b01000011001101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
