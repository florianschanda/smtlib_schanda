                (fp #b0 #b0000000000000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111110010011101)
                arg1
                (fp #b0 #b0010111100001000 #b101011011000001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110100010111101 #b011111111011010)
                arg2
                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                arg2
                (fp #b0 #b1001000111101110 #b110011110011110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100110000001011 #b101110001000110)
                expect
                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                expect
                (fp #b0 #b1000111010110111 #b010001000010111)))

(assert (= expect result))

(check-sat)
(exit)
