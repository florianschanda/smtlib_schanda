                arg2
                (fp #b1 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000)
                arg2
                (fp #b0 #b111010010100 #b01110000000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001010010111 #b10000000100)
                expect
                (fp #b0 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b00000000000)
                expect
                (fp #b0 #b010011111000 #b01111111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
