(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000011001110 #b01100111000)
                arg1
                (fp #b0 #b010000000000 #b00000000000)))
