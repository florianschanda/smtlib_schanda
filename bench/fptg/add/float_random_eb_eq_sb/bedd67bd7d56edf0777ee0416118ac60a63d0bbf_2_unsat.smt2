(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b1011110001 #b010110111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010010 #b000010100)
                expect
                (fp #b1 #b1000001001 #b000000001)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000001)
                expect
                (fp #b0 #b1000101010 #b000011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
