(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001000 #b00000)
                arg1
                (fp #b0 #b101010 #b11011)))
(assert (fp.leq (fp #b0 #b101010 #b11011)
                arg1
                (fp #b0 #b110000 #b10000)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b01011)
                arg2
                (fp #b1 #b100100 #b11110)))
(assert (fp.leq (fp #b1 #b100100 #b11110)
                arg2
                (fp #b1 #b100100 #b01110)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100001 #b01001)
                expect
                (fp #b0 #b101010 #b11011)))
(assert (fp.leq (fp #b0 #b101010 #b11011)
                expect
                (fp #b0 #b111110 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
