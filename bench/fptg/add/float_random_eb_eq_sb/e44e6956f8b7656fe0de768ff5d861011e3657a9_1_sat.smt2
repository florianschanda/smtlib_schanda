                arg2
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                arg2
                (fp #b0 #b010011100 #b11100110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010100 #b10111010)
                expect
                (fp #b1 #b011111110 #b11111111)))
(assert (fp.leq (fp #b1 #b011111110 #b11111111)
                expect
                (fp #b0 #b011110011 #b11001110)))

(assert (= expect result))

(check-sat)
(exit)
