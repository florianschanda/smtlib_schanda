                (fp #b1 #b100100 #b11110)))
(assert (fp.leq (fp #b1 #b100100 #b11110)
                arg2
                (fp #b0 #b111100 #b10110)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b11011)
                expect
                (fp #b1 #b111001 #b10101)))
(assert (fp.leq (fp #b1 #b111001 #b10101)
                expect
                (fp #b0 #b010110 #b11010)))

(assert (= expect result))

(check-sat)
