; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0111010 #b000100)
                arg1
                (fp #b1 #b0100000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000 #b000000)
                arg1
                (fp #b1 #b0011100 #b101101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010101 #b001101)
                arg2
                (fp #b0 #b1000001 #b100000)))
(assert (fp.leq (fp #b0 #b1000001 #b100000)
                arg2
                (fp #b0 #b1111000 #b100111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100011 #b000100)
                expect
                (fp #b0 #b1000001 #b011111)))
(assert (fp.leq (fp #b0 #b1000001 #b011111)
                expect
                (fp #b0 #b1101101 #b111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
