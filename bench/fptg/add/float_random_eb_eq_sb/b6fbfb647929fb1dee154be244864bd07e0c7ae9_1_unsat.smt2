; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b111000)
                arg1
                (fp #b1 #b0011101 #b000000)))
(assert (fp.leq (fp #b1 #b0011101 #b000000)
                arg1
                (fp #b0 #b1101000 #b011011)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0000010 #b100001)
                arg2
                (fp #b1 #b0000001 #b000000)))
(assert (fp.leq (fp #b1 #b0000001 #b000000)
                arg2
                (fp #b0 #b1010000 #b110110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000110 #b101000)
                expect
                (fp #b1 #b0011101 #b000000)))
(assert (fp.leq (fp #b1 #b0011101 #b000000)
                expect
                (fp #b1 #b0011011 #b110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
