(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111001 #b10010111)
                arg1
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg1
                (fp #b0 #b011110011 #b11110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110111 #b00010110)
                arg2
                (fp #b1 #b101010010 #b00100101)))
(assert (fp.leq (fp #b1 #b101010010 #b00100101)
                arg2
                (fp #b1 #b101000101 #b00011110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111001 #b00110011)
                expect
                (fp #b1 #b101010010 #b00100110)))
(assert (fp.leq (fp #b1 #b101010010 #b00100110)
                expect
                (fp #b0 #b101000100 #b01100110)))

(assert (= expect result))

(check-sat)
(exit)
