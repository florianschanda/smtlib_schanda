                arg2
                (fp #b0 #b1000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000101 #b101000)
                arg2
                (fp #b0 #b1010011 #b000001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101011 #b001111)
                expect
                (fp #b0 #b1000101 #b100111)))
(assert (fp.leq (fp #b0 #b1000101 #b100111)
                expect
                (fp #b0 #b1110001 #b110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
