(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100101 #b111110)
                arg1
                (fp #b1 #b0101001 #b011010)))
(assert (fp.leq (fp #b1 #b0101001 #b011010)
                arg1
                (fp #b1 #b0010001 #b111100)))

