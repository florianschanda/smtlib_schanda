; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101000001 #b111001111)
                arg1
                (fp #b0 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111111)
                arg1
                (fp #b0 #b1111111111 #b000000000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000110111 #b001100111)
                arg2
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b1111001011 #b110111001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100010100 #b111000010)
                expect
                (fp #b0 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111111)
                expect
                (fp #b0 #b1111111111 #b000000000)))

(assert (= expect result))

(check-sat)
(exit)
