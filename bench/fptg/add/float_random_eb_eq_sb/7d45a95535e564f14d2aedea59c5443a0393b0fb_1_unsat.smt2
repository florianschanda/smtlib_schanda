; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100011 #b100110)
                arg1
                (fp #b0 #b0111111 #b111111)))
(assert (fp.leq (fp #b0 #b0111111 #b111111)
                arg1
                (fp #b0 #b1000010 #b010100)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001101 #b000011)
                arg2
                (fp #b0 #b0000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000 #b111111)
                arg2
                (fp #b0 #b0110111 #b110111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0000011 #b010001)
                expect
                (fp #b0 #b0111111 #b111111)))
(assert (fp.leq (fp #b0 #b0111111 #b111111)
                expect
                (fp #b0 #b1000101 #b101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
