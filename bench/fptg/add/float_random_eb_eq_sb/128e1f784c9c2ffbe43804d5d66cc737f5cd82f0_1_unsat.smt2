; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101011100111011 #b01110001001000)
                arg2
                (fp #b1 #b100000000001011 #b11001101101000)))
(assert (fp.leq (fp #b1 #b100000000001011 #b11001101101000)
                arg2
                (fp #b0 #b101101110101000 #b00000101001001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
