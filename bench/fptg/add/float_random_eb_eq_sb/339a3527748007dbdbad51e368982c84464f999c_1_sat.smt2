(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0010101 #b011001)
                arg1
                (fp #b0 #b0100100 #b100111)))
(assert (fp.leq (fp #b0 #b0100100 #b100111)
                arg1
                (fp #b0 #b1111100 #b101101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100111 #b011010)
                arg2
                (fp #b1 #b0000001 #b000000)))
(assert (fp.leq (fp #b1 #b0000001 #b000000)
                arg2
                (fp #b0 #b1010100 #b010010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010111 #b010101)
                expect
                (fp #b0 #b0100100 #b100110)))
(assert (fp.leq (fp #b0 #b0100100 #b100110)
                expect
                (fp #b0 #b1001111 #b011100)))

(assert (= expect result))

(check-sat)
(exit)
