(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110011101 #b10011000001)
                expect
                (fp #b1 #b100000001010 #b01000101010)))
(assert (fp.leq (fp #b1 #b100000001010 #b01000101010)
                expect
                (fp #b0 #b100100110000 #b10001100100)))

(assert (not (= expect result)))

