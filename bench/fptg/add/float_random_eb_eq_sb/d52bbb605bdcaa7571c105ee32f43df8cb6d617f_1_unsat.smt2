(assert (fp.leq (fp #b1 #b101110111 #b01000111)
                expect
                (fp #b1 #b101000100 #b10111100)))
(assert (fp.leq (fp #b1 #b101000100 #b10111100)
                expect
                (fp #b1 #b011110010 #b00011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
