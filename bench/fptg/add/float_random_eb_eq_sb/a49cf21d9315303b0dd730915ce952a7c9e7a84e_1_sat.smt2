                arg2
                (fp #b1 #b000000000000000100 #b10001100000001000)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101100100010101101 #b10100010101010100)
                expect
                (fp #b1 #b100000000000001110 #b00011011110111000)))
(assert (fp.leq (fp #b1 #b100000000000001110 #b00011011110111000)
                expect
                (fp #b0 #b000001011111011000 #b01111011100001100)))

(assert (= expect result))

