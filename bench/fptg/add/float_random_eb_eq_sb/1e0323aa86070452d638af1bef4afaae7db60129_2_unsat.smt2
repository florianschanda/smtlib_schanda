; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001110 #b00011000)
                arg1
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                arg1
                (fp #b0 #b100010110 #b01001000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001011 #b10010000)
                arg2
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg2
                (fp #b0 #b100001110 #b01101110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010101101 #b01111001)
                expect
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                expect
                (fp #b0 #b111110000 #b01010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
