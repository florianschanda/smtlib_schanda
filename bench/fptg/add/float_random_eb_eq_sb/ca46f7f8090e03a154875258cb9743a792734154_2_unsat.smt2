; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011010 #b010101)
                arg1
                (fp #b0 #b0000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000 #b000001)
                arg1
                (fp #b0 #b0101101 #b100100)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101010 #b101010)
                arg2
                (fp #b0 #b1111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111101 #b000000)
                arg2
                (fp #b0 #b1111110 #b110101)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1100101 #b011111)
                expect
                (fp #b0 #b1111101 #b000001)))
(assert (fp.leq (fp #b0 #b1111101 #b000001)
                expect
                (fp #b0 #b1111101 #b001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
