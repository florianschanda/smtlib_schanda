; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001000000 #b11000101)
                arg1
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg1
                (fp #b0 #b010110110 #b00101111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001000001 #b10001110)
                arg2
                (fp #b0 #b011111111 #b01100111)))
(assert (fp.leq (fp #b0 #b011111111 #b01100111)
                arg2
                (fp #b0 #b100000111 #b01101000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010011101 #b01011110)
                expect
                (fp #b0 #b011111111 #b01100111)))
(assert (fp.leq (fp #b0 #b011111111 #b01100111)
                expect
                (fp #b0 #b100100111 #b00000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
