(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b01100101000111010 #b0000110111011001)
                arg1
                (fp #b0 #b10011111101000000 #b0100011001101000)))
(assert (fp.leq (fp #b0 #b10011111101000000 #b0100011001101000)
                arg1
                (fp #b0 #b10101111111101010 #b1111000011010110)))

