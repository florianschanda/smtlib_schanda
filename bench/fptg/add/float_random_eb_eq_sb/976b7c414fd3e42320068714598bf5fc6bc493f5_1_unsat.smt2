(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001101 #b01010)
                arg1
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                arg1
                (fp #b0 #b101101 #b01010)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110101 #b00101)
                arg2
                (fp #b0 #b010001 #b11001)))
(assert (fp.leq (fp #b0 #b010001 #b11001)
                arg2
                (fp #b0 #b100100 #b01000)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b10011)
                expect
                (fp #b0 #b010001 #b11000)))
(assert (fp.leq (fp #b0 #b010001 #b11000)
                expect
                (fp #b0 #b111101 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
