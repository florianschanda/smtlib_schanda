; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001100100110001 #b11111111111111)
                arg1
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                arg1
                (fp #b0 #b111111001111101 #b00000100100000)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000110101100001 #b01111110010110)
                arg2
                (fp #b0 #b001000111100010 #b01001111000000)))
(assert (fp.leq (fp #b0 #b001000111100010 #b01001111000000)
                arg2
                (fp #b0 #b110010011001000 #b00100100000100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011001011110100 #b11001110111101)
                expect
                (fp #b0 #b001000111100010 #b01001111000000)))
(assert (fp.leq (fp #b0 #b001000111100010 #b01001111000000)
                expect
                (fp #b0 #b010000010100111 #b10011110001111)))

(assert (= expect result))

(check-sat)
(exit)
