(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1110)
                arg1
                (fp #b1 #b00110 #b0000)))
(assert (fp.leq (fp #b1 #b00110 #b0000)
                arg1
                (fp #b0 #b10010 #b1010)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10110 #b1010)
                arg2
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                arg2
                (fp #b0 #b00000 #b1000)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0110)
                expect
                (fp #b1 #b00110 #b0000)))
(assert (fp.leq (fp #b1 #b00110 #b0000)
                expect
                (fp #b1 #b00001 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
