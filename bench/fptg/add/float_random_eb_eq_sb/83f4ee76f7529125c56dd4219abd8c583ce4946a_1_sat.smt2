(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0100110010 #b000011011)
                arg1
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg1
                (fp #b0 #b0101000101 #b101101100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101110 #b111111100)
                arg2
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b1 #b1000000101 #b111100001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101110 #b000101110)
                expect
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                expect
                (fp #b1 #b1100001101 #b001010000)))

(assert (= expect result))

(check-sat)
(exit)
