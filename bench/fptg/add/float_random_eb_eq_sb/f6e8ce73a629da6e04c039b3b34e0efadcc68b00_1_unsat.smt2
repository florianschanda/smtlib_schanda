(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100011 #b001100)
                arg1
                (fp #b1 #b0000000 #b111111)))
(assert (fp.leq (fp #b1 #b0000000 #b111111)
                arg1
                (fp #b0 #b0000001 #b011101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110011 #b000101)
                arg2
                (fp #b0 #b0000000 #b011111)))
(assert (fp.leq (fp #b0 #b0000000 #b011111)
                arg2
                (fp #b0 #b1101001 #b101011)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0001100 #b101100)
                expect
                (fp #b1 #b0000000 #b100000)))
(assert (fp.leq (fp #b1 #b0000000 #b100000)
                expect
                (fp #b0 #b0110111 #b100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
