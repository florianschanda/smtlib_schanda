(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011101 #b11000)
                arg1
                (fp #b1 #b000000 #b11011)))
(assert (fp.leq (fp #b1 #b000000 #b11011)
                arg1
                (fp #b0 #b000010 #b01110)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011010 #b11001)
                arg2
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                arg2
                (fp #b0 #b100111 #b01001)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010001 #b10111)
                expect
                (fp #b0 #b011111 #b00000)))
(assert (fp.leq (fp #b0 #b011111 #b00000)
                expect
                (fp #b0 #b101110 #b10101)))

(assert (= expect result))

(check-sat)
(exit)
