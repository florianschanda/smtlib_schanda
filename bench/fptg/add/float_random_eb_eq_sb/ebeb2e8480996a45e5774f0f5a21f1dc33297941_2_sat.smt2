(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b11011)
                arg1
                (fp #b1 #b010000 #b00000)))
(assert (fp.leq (fp #b1 #b010000 #b00000)
                arg1
                (fp #b0 #b010010 #b11001)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00101)
                arg2
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                arg2
                (fp #b0 #b001100 #b00000)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111011 #b11101)
                expect
                (fp #b1 #b011111 #b00001)))
(assert (fp.leq (fp #b1 #b011111 #b00001)
                expect
                (fp #b0 #b111001 #b11110)))

(assert (= expect result))

(check-sat)
(exit)
