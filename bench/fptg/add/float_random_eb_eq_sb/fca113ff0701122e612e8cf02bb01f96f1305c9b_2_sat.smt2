                (fp #b0 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000000000000)
                arg2
                (fp #b0 #b1110101111110110 #b100011010001001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101110011011100 #b111111010111110)
                expect
                (fp #b0 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000000000000)
                expect
                (fp #b0 #b1010111010010011 #b000011100000001)))

(assert (= expect result))

(check-sat)
(exit)
