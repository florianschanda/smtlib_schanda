(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b011001000101010001 #b01110100111000111)
                expect
                (fp #b0 #b110100000010101101 #b01001001000100100)))
(assert (fp.leq (fp #b0 #b110100000010101101 #b01001001000100100)
                expect
                (fp #b0 #b110110000000110111 #b00000111111000011)))

(assert (= expect result))

(check-sat)
