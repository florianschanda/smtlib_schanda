; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111111101 #b1010010011)
                arg1
                (fp #b0 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111)
                arg1
                (fp #b0 #b11011100000 #b1100111011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010001100 #b1100011100)
                arg2
                (fp #b0 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000)
                arg2
                (fp #b0 #b00110101101 #b1100001010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000111101 #b0011001001)
                expect
                (fp #b0 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111)
                expect
                (fp #b0 #b11000100100 #b1101111111)))

(assert (= expect result))

(check-sat)
(exit)
