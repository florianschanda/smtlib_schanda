; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101001101 #b01111000001)
                arg1
                (fp #b0 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b11111111111)
                arg1
                (fp #b0 #b011010001100 #b00111110000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011111110000 #b11100010101)
                arg2
                (fp #b0 #b100000000111 #b01010000000)))
(assert (fp.leq (fp #b0 #b100000000111 #b01010000000)
                arg2
                (fp #b0 #b100111010000 #b11110011011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000011000110 #b11101111111)
                expect
                (fp #b0 #b100000000111 #b01010000000)))
(assert (fp.leq (fp #b0 #b100000000111 #b01010000000)
                expect
                (fp #b0 #b100100100010 #b11001000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
