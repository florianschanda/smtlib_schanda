(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110100 #b00010000)
                arg1
                (fp #b0 #b100011101 #b01011000)))
(assert (fp.leq (fp #b0 #b100011101 #b01011000)
                arg1
                (fp #b0 #b111001100 #b10101110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100100 #b00101010)
                arg2
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg2
                (fp #b0 #b110110111 #b11000100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010101111 #b01010110)
                expect
                (fp #b0 #b100011101 #b01011001)))
(assert (fp.leq (fp #b0 #b100011101 #b01011001)
                expect
                (fp #b0 #b111000011 #b01001010)))

(assert (= expect result))

(check-sat)
(exit)
