                arg2
                (fp #b0 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000)
                arg2
                (fp #b0 #b10000110100 #b0011010010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110111100 #b1011000001)
                expect
                (fp #b0 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000)
                expect
                (fp #b0 #b11001010000 #b1101101001)))

(assert (= expect result))

(check-sat)
(exit)
