                arg2
                (fp #b0 #b010000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000000)
                arg2
                (fp #b0 #b101011010 #b00011011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000010111 #b10110101)
                expect
                (fp #b0 #b010000000 #b00000001)))
(assert (fp.leq (fp #b0 #b010000000 #b00000001)
                expect
                (fp #b0 #b100010001 #b00011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
