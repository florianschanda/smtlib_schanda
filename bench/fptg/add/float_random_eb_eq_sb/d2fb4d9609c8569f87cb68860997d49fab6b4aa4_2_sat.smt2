;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001110 #b01010100)
                arg1
                (fp #b1 #b011111111 #b00100101)))
(assert (fp.leq (fp #b1 #b011111111 #b00100101)
                arg1
                (fp #b0 #b000111011 #b01100000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101010 #b11111011)
                arg2
                (fp #b1 #b101101100 #b10101111)))
(assert (fp.leq (fp #b1 #b101101100 #b10101111)
                arg2
                (fp #b0 #b110000100 #b10101011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001101 #b11100100)
                expect
                (fp #b1 #b101101100 #b10110000)))
(assert (fp.leq (fp #b1 #b101101100 #b10110000)
                expect
                (fp #b0 #b001010000 #b01101001)))

(assert (= expect result))

(check-sat)
(exit)
