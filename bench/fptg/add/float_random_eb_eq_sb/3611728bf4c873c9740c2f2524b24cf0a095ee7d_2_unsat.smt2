(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01001)
                arg1
                (fp #b1 #b111101 #b00000)))
(assert (fp.leq (fp #b1 #b111101 #b00000)
                arg1
                (fp #b1 #b001000 #b00101)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b11100)
                arg2
                (fp #b1 #b110001 #b11001)))
(assert (fp.leq (fp #b1 #b110001 #b11001)
                arg2
                (fp #b0 #b110010 #b11011)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b10100)
                expect
                (fp #b1 #b111101 #b00001)))
(assert (fp.leq (fp #b1 #b111101 #b00001)
                expect
                (fp #b1 #b100100 #b10110)))

(assert (not (= expect result)))

(check-sat)
(exit)
