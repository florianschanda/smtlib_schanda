(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b010)
                arg1
                (fp #b1 #b0110 #b101)))
(assert (fp.leq (fp #b1 #b0110 #b101)
                arg1
                (fp #b1 #b0010 #b011)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b111)
                arg2
                (fp #b1 #b1010 #b100)))
(assert (fp.leq (fp #b1 #b1010 #b100)
                arg2
                (fp #b1 #b0001 #b100)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b011)
                expect
                (fp #b1 #b1010 #b101)))
(assert (fp.leq (fp #b1 #b1010 #b101)
                expect
                (fp #b1 #b1000 #b100)))

(assert (= expect result))

(check-sat)
(exit)
