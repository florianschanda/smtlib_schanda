; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100010 #b111100)
                arg1
                (fp #b0 #b0000001 #b000000)))
(assert (fp.leq (fp #b0 #b0000001 #b000000)
                arg1
                (fp #b0 #b1001110 #b101111)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101000 #b000110)
                arg2
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                arg2
                (fp #b0 #b1100010 #b101000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1000110 #b010001)
                expect
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                expect
                (fp #b0 #b1100000 #b101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
