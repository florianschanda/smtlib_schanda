; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111010110110001000 #b01001100010110011)
                arg2
                (fp #b0 #b100000000000010001 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b100000000000010001 #b00000000000000000)
                arg2
                (fp #b0 #b111000110111000001 #b10111100100101101)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
