(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110011100011010 #b011111101011011)
                arg1
                (fp #b0 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010000000000000)
                arg1
                (fp #b0 #b1010000000111110 #b100101101100010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
