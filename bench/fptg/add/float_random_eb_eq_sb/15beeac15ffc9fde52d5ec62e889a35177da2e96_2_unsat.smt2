; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010001 #b000000)
                arg1
                (fp #b1 #b0000000 #b100100)))
(assert (fp.leq (fp #b1 #b0000000 #b100100)
                arg1
                (fp #b0 #b1100010 #b110110)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111011 #b110110)
                arg2
                (fp #b1 #b0101000 #b111001)))
(assert (fp.leq (fp #b1 #b0101000 #b111001)
                arg2
                (fp #b0 #b1010010 #b110111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001111 #b010100)
                expect
                (fp #b1 #b0101000 #b111010)))
(assert (fp.leq (fp #b1 #b0101000 #b111010)
                expect
                (fp #b0 #b0110110 #b110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
