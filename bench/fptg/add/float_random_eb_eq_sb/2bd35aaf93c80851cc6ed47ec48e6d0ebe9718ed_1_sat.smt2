(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011100 #b111111)
                arg1
                (fp #b1 #b1000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000101 #b011101)
                arg1
                (fp #b0 #b1011001 #b001001)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001011 #b111000)
                arg2
                (fp #b1 #b0001001 #b000010)))
(assert (fp.leq (fp #b1 #b0001001 #b000010)
                arg2
                (fp #b0 #b1101111 #b110101)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011010 #b000010)
                expect
                (fp #b1 #b1000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000101 #b011101)
                expect
                (fp #b0 #b1000101 #b001000)))

(assert (= expect result))

(check-sat)
(exit)
