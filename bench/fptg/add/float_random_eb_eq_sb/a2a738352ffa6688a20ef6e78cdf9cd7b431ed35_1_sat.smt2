; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b001010)
                arg1
                (fp #b1 #b0000001 #b000000)))
(assert (fp.leq (fp #b1 #b0000001 #b000000)
                arg1
                (fp #b0 #b1000000 #b101010)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0011111 #b110100)
                arg2
                (fp #b0 #b0000000 #b011111)))
(assert (fp.leq (fp #b0 #b0000000 #b011111)
                arg2
                (fp #b0 #b0101101 #b110011)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b110010)
                expect
                (fp #b1 #b0000000 #b100001)))
(assert (fp.leq (fp #b1 #b0000000 #b100001)
                expect
                (fp #b0 #b0010110 #b110011)))

(assert (= expect result))

(check-sat)
(exit)
