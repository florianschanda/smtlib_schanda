(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101000010 #b01101100111)
                arg1
                (fp #b0 #b011001101100 #b01001001000)))
(assert (fp.leq (fp #b0 #b011001101100 #b01001001000)
                arg1
                (fp #b0 #b011100110000 #b10011001110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011111010 #b01101010010)
                arg2
                (fp #b1 #b010010100111 #b00001001011)))
(assert (fp.leq (fp #b1 #b010010100111 #b00001001011)
                arg2
                (fp #b0 #b000110101011 #b00000001000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000011100100 #b01010100110)
                expect
                (fp #b0 #b011001101100 #b01001001000)))
(assert (fp.leq (fp #b0 #b011001101100 #b01001001000)
                expect
                (fp #b0 #b110111101101 #b10101011001)))

(assert (= expect result))

(check-sat)
(exit)
