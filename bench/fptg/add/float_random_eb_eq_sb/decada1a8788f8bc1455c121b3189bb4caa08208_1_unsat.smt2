(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011110 #b10010000)
                arg1
                (fp #b1 #b100001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                arg1
                (fp #b0 #b000100110 #b11011111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000100 #b00000010)
                arg2
                (fp #b0 #b110100101 #b00101110)))
(assert (fp.leq (fp #b0 #b110100101 #b00101110)
                arg2
                (fp #b0 #b110110101 #b01000101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100101 #b00101001)
                expect
                (fp #b0 #b110100101 #b00101101)))
(assert (fp.leq (fp #b0 #b110100101 #b00101101)
                expect
                (fp #b0 #b110110100 #b01001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
