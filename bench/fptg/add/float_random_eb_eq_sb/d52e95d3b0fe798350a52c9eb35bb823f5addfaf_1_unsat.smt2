; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: +INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101001000110001111 #b01011110011110101)
                arg1
                (fp #b1 #b011111111111111111 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b00000000000000000)
                arg1
                (fp #b1 #b011110101100111111 #b11111111110101000)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
