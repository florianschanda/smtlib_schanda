;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110011101 #b0100010001)
                arg1
                (fp #b1 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                arg1
                (fp #b0 #b11111011001 #b0001110000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100101100 #b0101001101)
                arg2
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg2
                (fp #b0 #b00100100100 #b1110111001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011111001 #b0101101101)
                expect
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                expect
                (fp #b0 #b01010000111 #b1100000111)))

(assert (= expect result))

(check-sat)
(exit)
