(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111011000 #b01000110111)
                arg1
                (fp #b1 #b010011011101 #b01111010101)))
(assert (fp.leq (fp #b1 #b010011011101 #b01111010101)
                arg1
                (fp #b0 #b011011001001 #b10010100000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100110110 #b01110101010)
                expect
                (fp #b1 #b010011011110 #b01111010101)))
(assert (fp.leq (fp #b1 #b010011011110 #b01111010101)
                expect
                (fp #b0 #b110000100101 #b11111011010)))

(assert (= expect result))

(check-sat)
(exit)
