; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000010101 #b00010110)
                arg1
                (fp #b0 #b010010111 #b01000011)))
(assert (fp.leq (fp #b0 #b010010111 #b01000011)
                arg1
                (fp #b0 #b101000001 #b00101101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111010 #b00101010)
                arg2
                (fp #b0 #b010000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000000)
                arg2
                (fp #b0 #b101101010 #b11011110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001001100 #b11010100)
                expect
                (fp #b0 #b010010111 #b01000100)))
(assert (fp.leq (fp #b0 #b010010111 #b01000100)
                expect
                (fp #b0 #b111110111 #b00100100)))

(assert (= expect result))

(check-sat)
(exit)
