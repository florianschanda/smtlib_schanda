(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b00110)
                arg1
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                arg1
                (fp #b1 #b001000 #b11111)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b01110)
                arg2
                (fp #b1 #b101111 #b01111)))
(assert (fp.leq (fp #b1 #b101111 #b01111)
                arg2
                (fp #b1 #b101101 #b10010)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b00111)
                expect
                (fp #b1 #b101111 #b01111)))
(assert (fp.leq (fp #b1 #b101111 #b01111)
                expect
                (fp #b1 #b000100 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
