(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b0 #b0100 #b101)))
(assert (fp.leq (fp #b0 #b0100 #b101)
                arg1
                (fp #b0 #b0111 #b101)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b110)
                arg2
                (fp #b0 #b0101 #b000)))
(assert (fp.leq (fp #b0 #b0101 #b000)
                arg2
                (fp #b0 #b1110 #b010)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b000)
                expect
                (fp #b0 #b0101 #b110)))
(assert (fp.leq (fp #b0 #b0101 #b110)
                expect
                (fp #b0 #b1010 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
