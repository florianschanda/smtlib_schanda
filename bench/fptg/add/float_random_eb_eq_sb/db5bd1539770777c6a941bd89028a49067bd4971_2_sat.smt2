(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0110100 #b000110)
                arg1
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                arg1
                (fp #b0 #b1111100 #b100010)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b000101)
                arg2
                (fp #b1 #b1111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111101 #b000000)
                arg2
                (fp #b0 #b1010100 #b011111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b111101)
                expect
                (fp #b1 #b1111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111101 #b000000)
                expect
                (fp #b0 #b0100000 #b000101)))

(assert (= expect result))

(check-sat)
(exit)
