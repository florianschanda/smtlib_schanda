(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011011100 #b10010011)
                arg1
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                arg1
                (fp #b0 #b011101001 #b00100001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010110 #b00010110)
                arg2
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg2
                (fp #b0 #b001011000 #b00000011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011011011 #b00010001)
                expect
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                expect
                (fp #b0 #b011001110 #b01010111)))

(assert (= expect result))

(check-sat)
(exit)
