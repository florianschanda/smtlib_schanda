; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0010000 #b100111)
                arg1
                (fp #b0 #b0111111 #b111111)))
(assert (fp.leq (fp #b0 #b0111111 #b111111)
                arg1
                (fp #b0 #b1001110 #b100000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101100 #b011101)
                arg2
                (fp #b0 #b0001100 #b101111)))
(assert (fp.leq (fp #b0 #b0001100 #b101111)
                arg2
                (fp #b0 #b1111101 #b011011)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0011111 #b010000)
                expect
                (fp #b0 #b1000000 #b000000)))
(assert (fp.leq (fp #b0 #b1000000 #b000000)
                expect
                (fp #b0 #b1001111 #b110101)))

(assert (= expect result))

(check-sat)
(exit)
