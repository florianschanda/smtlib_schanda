(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110101 #b10110)
                arg1
                (fp #b0 #b110110 #b10000)))
(assert (fp.leq (fp #b0 #b110110 #b10000)
                arg1
                (fp #b0 #b111101 #b10100)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011010 #b10000)
                arg2
                (fp #b1 #b000000 #b10110)))
(assert (fp.leq (fp #b1 #b000000 #b10110)
                arg2
                (fp #b0 #b011101 #b11011)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010010 #b11111)
                expect
                (fp #b0 #b110110 #b10000)))
(assert (fp.leq (fp #b0 #b110110 #b10000)
                expect
                (fp #b0 #b111010 #b00011)))

(assert (not (= expect result)))

(check-sat)
(exit)
