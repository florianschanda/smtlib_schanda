;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011001 #b01111001)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b0 #b101111100 #b11110010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111100 #b11010010)
                arg2
                (fp #b1 #b001010110 #b00101000)))
(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b1 #b001001100 #b00111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110011 #b10101011)
                expect
                (fp #b1 #b010101010 #b00110000)))
(assert (fp.leq (fp #b1 #b010101010 #b00110000)
                expect
                (fp #b0 #b110001001 #b11010100)))

(assert (= expect result))

(check-sat)
(exit)
