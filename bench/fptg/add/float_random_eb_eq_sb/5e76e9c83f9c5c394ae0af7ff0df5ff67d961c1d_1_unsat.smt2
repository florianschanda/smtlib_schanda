(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b0010011000 #b000110001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100100111 #b001111001)
                expect
                (fp #b1 #b0000000000 #b000000100)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000100)
                expect
                (fp #b0 #b1100110000 #b100000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
