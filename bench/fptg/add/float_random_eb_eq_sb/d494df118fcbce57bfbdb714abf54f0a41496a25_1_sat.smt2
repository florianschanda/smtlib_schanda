; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010011110 #b11001000)
                arg1
                (fp #b0 #b011111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111 #b11001001)
                arg1
                (fp #b0 #b100010010 #b01000000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100101110 #b11100101)
                arg2
                (fp #b1 #b100000111 #b11010011)))
(assert (fp.leq (fp #b1 #b100000111 #b11010011)
                arg2
                (fp #b0 #b001101010 #b01111011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101110001 #b01111010)
                expect
                (fp #b1 #b100000111 #b11010001)))
(assert (fp.leq (fp #b1 #b100000111 #b11010001)
                expect
                (fp #b0 #b011100111 #b11111101)))

(assert (= expect result))

(check-sat)
(exit)
