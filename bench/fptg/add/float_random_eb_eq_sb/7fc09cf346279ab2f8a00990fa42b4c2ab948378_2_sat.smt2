(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000100010 #b011110011)
                arg1
                (fp #b0 #b0011011111 #b110111010)))
(assert (fp.leq (fp #b0 #b0011011111 #b110111010)
                arg1
                (fp #b0 #b0011101101 #b001100001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000000111 #b101001010)
                arg2
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                arg2
                (fp #b0 #b0001111111 #b011111011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000110111 #b011101110)
                expect
                (fp #b0 #b0011011111 #b110111010)))
(assert (fp.leq (fp #b0 #b0011011111 #b110111010)
                expect
                (fp #b0 #b1000001110 #b110100110)))

(assert (= expect result))

(check-sat)
(exit)
