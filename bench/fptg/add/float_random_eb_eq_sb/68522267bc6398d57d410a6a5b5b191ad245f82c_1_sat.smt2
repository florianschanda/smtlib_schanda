(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b010011010110 #b10000110011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110001110 #b00011100101)
                expect
                (fp #b1 #b110100100011 #b00110111000)))
(assert (fp.leq (fp #b1 #b110100100011 #b00110111000)
                expect
                (fp #b1 #b101100000010 #b11000000111)))

(assert (= expect result))

(check-sat)
