(assert (fp.leq (fp #b1 #b11011001110 #b1100110001)
                expect
                (fp #b1 #b01111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111)
                expect
                (fp #b0 #b01111000111 #b1111100111)))

(assert (= expect result))

(check-sat)
