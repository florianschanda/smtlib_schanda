(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100101 #b000010)
                arg1
                (fp #b1 #b0000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000 #b010000)
                arg1
                (fp #b0 #b0010111 #b110110)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101011 #b111000)
                arg2
                (fp #b1 #b0100000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000 #b000000)
                arg2
                (fp #b1 #b0011101 #b001010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000100 #b001110)
                expect
                (fp #b1 #b0100000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000 #b000000)
                expect
                (fp #b1 #b0010010 #b101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
