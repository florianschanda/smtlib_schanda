                arg2
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                arg2
                (fp #b0 #b111001001011 #b01111101101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111110 #b00100011000)
                expect
                (fp #b1 #b111111111100 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111100 #b11111111111)
                expect
                (fp #b1 #b001000000111 #b00100111101)))

(assert (= expect result))

(check-sat)
(exit)
