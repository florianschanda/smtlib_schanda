; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000100111 #b001011000)
                arg1
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0101001011 #b101100011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100101 #b101010100)
                arg2
                (fp #b1 #b1101111100 #b101100010)))
(assert (fp.leq (fp #b1 #b1101111100 #b101100010)
                arg2
                (fp #b1 #b0111100111 #b101000100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101101 #b001000000)
                expect
                (fp #b1 #b1101111100 #b101100001)))
(assert (fp.leq (fp #b1 #b1101111100 #b101100001)
                expect
                (fp #b0 #b0110110000 #b001101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
