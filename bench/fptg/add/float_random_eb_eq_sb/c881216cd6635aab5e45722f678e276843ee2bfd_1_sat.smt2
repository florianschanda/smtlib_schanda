(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0110011 #b110000)
                arg1
                (fp #b0 #b1101100 #b000000)))
(assert (fp.leq (fp #b0 #b1101100 #b000000)
                arg1
                (fp #b0 #b1111110 #b011111)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001000 #b001101)
                arg2
                (fp #b1 #b0111111 #b100001)))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg2
                (fp #b0 #b0111000 #b100110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101110 #b000001)
                expect
                (fp #b0 #b1101011 #b111111)))
(assert (fp.leq (fp #b0 #b1101011 #b111111)
                expect
                (fp #b0 #b1111100 #b101110)))

(assert (= expect result))

(check-sat)
(exit)
