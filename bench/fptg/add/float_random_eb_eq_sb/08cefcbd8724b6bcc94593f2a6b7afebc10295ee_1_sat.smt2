(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001111 #b100001)
                arg1
                (fp #b0 #b1000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000011 #b011000)
                arg1
                (fp #b0 #b1101001 #b000011)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100100 #b100000)
                arg2
                (fp #b1 #b0100000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000 #b000000)
                arg2
                (fp #b0 #b1000101 #b001111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000000 #b001001)
                expect
                (fp #b0 #b1000011 #b010111)))
(assert (fp.leq (fp #b0 #b1000011 #b010111)
                expect
                (fp #b0 #b1111100 #b010111)))

(assert (= expect result))

(check-sat)
(exit)
