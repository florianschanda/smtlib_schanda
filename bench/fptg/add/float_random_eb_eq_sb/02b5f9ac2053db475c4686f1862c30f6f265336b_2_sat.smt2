; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011011101000 #b0100101010001)
                arg1
                (fp #b0 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000000000)
                arg1
                (fp #b0 #b11111111111110 #b0100110000001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111111110 #b1010001111011)
                arg2
                (fp #b1 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000000)
                arg2
                (fp #b1 #b00001101101011 #b0010111101001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11100010011001 #b1010111111110)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b11110001111110 #b1100101110110)))

(assert (= expect result))

(check-sat)
(exit)
