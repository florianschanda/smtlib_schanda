                arg2
                (fp #b0 #b11001001 #b011111011011011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110000 #b110100011111110)
                expect
                (fp #b1 #b01011111 #b010000001010111)))
(assert (fp.leq (fp #b1 #b01011111 #b010000001010111)
                expect
                (fp #b1 #b00010011 #b000100110101110)))

(assert (not (= expect result)))

(check-sat)
