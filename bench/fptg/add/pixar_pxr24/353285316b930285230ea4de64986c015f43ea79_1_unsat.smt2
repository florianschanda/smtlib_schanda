                arg2
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                arg2
                (fp #b1 #b11011101 #b011101010010001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111111 #b000000000000000)
                expect
                (fp #b1 #b11111110 #b111111111111110)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111110)
                expect
                (fp #b1 #b10000101 #b100000101110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
