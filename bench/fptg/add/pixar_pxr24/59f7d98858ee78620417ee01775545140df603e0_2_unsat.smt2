                arg2
                (fp #b0 #b11010110 #b110000110001101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101010 #b100000010110100)
                expect
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                expect
                (fp #b0 #b11110100 #b000101010001101)))

(assert (not (= expect result)))

(check-sat)
