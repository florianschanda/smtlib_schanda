; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010101 #b001111000011001)
                arg1
                (fp #b0 #b00000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b00000000 #b101011011111011)
                arg1
                (fp #b0 #b11100010 #b001101110000001)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00010110 #b100001111001010)
                arg2
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                arg2
                (fp #b0 #b11001010 #b010000000000101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011010 #b100000001100101)
                expect
                (fp #b0 #b01100010 #b101101001011101)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011101)
                expect
                (fp #b0 #b01111111 #b111110110010100)))

(assert (= expect result))

(check-sat)
(exit)
