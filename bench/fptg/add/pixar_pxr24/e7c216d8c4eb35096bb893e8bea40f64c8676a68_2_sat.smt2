                arg2
                (fp #b1 #b01101101 #b010011010001001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110110 #b111001000010001)
                expect
                (fp #b1 #b01111111 #b110011000011100)))
(assert (fp.leq (fp #b1 #b01111111 #b110011000011100)
                expect
                (fp #b1 #b00000111 #b011101000000010)))

(assert (= expect result))

(check-sat)
(exit)
