; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001101 #b111100110110100)
                arg1
                (fp #b0 #b00000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b00000000 #b101011011111011)
                arg1
                (fp #b0 #b10011100 #b000010000111111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110000 #b110111001010010)
                arg2
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg2
                (fp #b0 #b11100100 #b010101011010010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b001100100000100)
                expect
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b10010110 #b010000111111110)))

(assert (= expect result))

(check-sat)
(exit)
