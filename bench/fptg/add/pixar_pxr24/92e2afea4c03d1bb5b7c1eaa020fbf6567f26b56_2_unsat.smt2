; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101100 #b111111110010101)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b01000001 #b011011000000011)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101100 #b010001011001101)
                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b00001110 #b101101111110110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011001 #b110111000100001)
                expect
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                expect
                (fp #b0 #b11001001 #b011100110000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
