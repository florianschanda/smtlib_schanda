(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110111 #b000100001101000)
                arg1
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b10111111 #b101000111100111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100101 #b100010101010110)
                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b0 #b10110100 #b111001010011100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110110 #b111111110000011)
                expect
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                expect
                (fp #b1 #b01110100 #b000111010011101)))

(assert (= expect result))

(check-sat)
(exit)
