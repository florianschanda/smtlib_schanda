; Format: PIXAR_PXR24
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110000 #b111000000100011)
                arg1
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                arg1
                (fp #b0 #b11110011 #b100101111110110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b000001000101011)
                arg2
                (fp #b1 #b11000110 #b011000101111010)))
(assert (fp.leq (fp #b1 #b11000110 #b011000101111010)
                arg2
                (fp #b1 #b00001111 #b101000100001010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111100 #b001111100101011)
                expect
                (fp #b1 #b11000110 #b011000101111010)))
(assert (fp.leq (fp #b1 #b11000110 #b011000101111010)
                expect
                (fp #b1 #b00110100 #b110101010100111)))

(assert (= expect result))

(check-sat)
(exit)
