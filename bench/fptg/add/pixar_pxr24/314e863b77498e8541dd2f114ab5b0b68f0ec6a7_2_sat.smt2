;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110100 #b111110110010100)
                arg1
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11010010 #b101000110001110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000010 #b000010101000100)
                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b01000001 #b010000011001100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011001 #b100110011000000)
                expect
                (fp #b1 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b10001000 #b100010101001000)))

(assert (= expect result))

(check-sat)
(exit)
