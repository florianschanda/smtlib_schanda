(assert (fp.leq (fp #b0 #b00000000 #b100100100100110)
                arg2
                (fp #b0 #b10110111 #b110010010000111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101000 #b101110100001010)
                expect
                (fp #b1 #b01111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b01111111 #b110100000111010)
                expect
                (fp #b0 #b11110000 #b100100101101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
