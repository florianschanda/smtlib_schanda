                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                arg2
                (fp #b0 #b10110111 #b000110101011010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110011 #b000110001000101)
                expect
                (fp #b1 #b10111010 #b111010111000111)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111000111)
                expect
                (fp #b1 #b01010010 #b010010011110001)))

(assert (= expect result))

(check-sat)
(exit)
