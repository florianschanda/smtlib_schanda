(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000100 #b000101100101000)
                arg1
                (fp #b1 #b00111000 #b011000001000011)))
(assert (fp.leq (fp #b1 #b00111000 #b011000001000011)
                arg1
                (fp #b0 #b11011000 #b100001101101000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b001010100010101)
                arg2
                (fp #b0 #b10001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100100)
                arg2
                (fp #b0 #b10101011 #b011110101101100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b011111110111011)
                expect
                (fp #b0 #b10001100 #b010011110100011)))
(assert (fp.leq (fp #b0 #b10001100 #b010011110100011)
                expect
                (fp #b0 #b11011101 #b001011010101000)))

(assert (= expect result))

(check-sat)
(exit)
