; Format: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101100 #b111110010101000)
                arg1
                (fp #b1 #b11010110 #b100101000001010)))
(assert (fp.leq (fp #b1 #b11010110 #b100101000001010)
                arg1
                (fp #b0 #b00011000 #b101111000111010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110100 #b110100100001010)
                arg2
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11111110 #b111100001011110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000010 #b111110001010101)
                expect
                (fp #b0 #b11111100 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b111111111111111)
                expect
                (fp #b0 #b11111101 #b011010011011110)))

(assert (= expect result))

(check-sat)
(exit)
