; Format: PIXAR_PXR24
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110110 #b010101010010101)
                arg1
                (fp #b0 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b000000000000000)
                arg1
                (fp #b0 #b11000000 #b000100001000110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b001101000000100)
                arg2
                (fp #b1 #b01000000 #b101111110101110)))
(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                arg2
                (fp #b1 #b00100011 #b010101101111011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01100001 #b001110011010000)
                expect
                (fp #b1 #b01000000 #b101111110101110)))
(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                expect
                (fp #b0 #b01111011 #b100001100110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
