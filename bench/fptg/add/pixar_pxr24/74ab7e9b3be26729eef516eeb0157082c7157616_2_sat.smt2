; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010110 #b111010001111100)
                arg1
                (fp #b0 #b00000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b00000000 #b101011011111011)
                arg1
                (fp #b0 #b11001110 #b010010100101111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100110 #b100011001000110)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b00110101 #b110101011011101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100011 #b101011011000100)
                expect
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b00010011 #b110011101101100)))

(assert (= expect result))

(check-sat)
(exit)
