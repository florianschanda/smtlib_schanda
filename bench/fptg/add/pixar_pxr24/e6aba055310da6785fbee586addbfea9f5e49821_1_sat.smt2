                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b01101100 #b001000010111100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010100 #b001011101101011)
                expect
                (fp #b0 #b10100010 #b010100010011111)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011111)
                expect
                (fp #b0 #b11110001 #b000001010000101)))

(assert (= expect result))

(check-sat)
(exit)
