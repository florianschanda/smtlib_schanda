; Format: PIXAR_PXR24
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10000100 #b000011001000101)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11100101 #b110110100000110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101101 #b011111111100000)
                arg2
                (fp #b1 #b01011111 #b010000001010111)))
(assert (fp.leq (fp #b1 #b01011111 #b010000001010111)
                arg2
                (fp #b1 #b00100111 #b111000010011010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100000 #b001010011010001)
                expect
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b10101010 #b010010111010101)))

(assert (= expect result))

(check-sat)
(exit)
