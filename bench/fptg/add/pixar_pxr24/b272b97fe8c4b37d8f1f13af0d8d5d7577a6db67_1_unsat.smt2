; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10100001 #b100000011101101)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b00001111 #b000100111011100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b010010111101111)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b01010101 #b011111111010100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000011 #b000010010101110)
                expect
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                expect
                (fp #b0 #b10010111 #b110000111111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
