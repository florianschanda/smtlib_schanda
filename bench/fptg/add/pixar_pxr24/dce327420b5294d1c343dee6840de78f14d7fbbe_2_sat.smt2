                arg2
                (fp #b0 #b10101101 #b101011010101011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101111 #b001100101000101)
                expect
                (fp #b1 #b00111000 #b011010100000110)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000110)
                expect
                (fp #b1 #b00100001 #b100011001110101)))

(assert (= expect result))

(check-sat)
(exit)
