; Format: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b111010110010000)
                arg1
                (fp #b1 #b11110110 #b011010110000111)))
(assert (fp.leq (fp #b1 #b11110110 #b011010110000111)
                arg1
                (fp #b1 #b10011101 #b110010001111111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111100 #b011101100111011)
                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b11101111 #b111101011110011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b100000110011101)
                expect
                (fp #b1 #b11110110 #b011010110000111)))
(assert (fp.leq (fp #b1 #b11110110 #b011010110000111)
                expect
                (fp #b1 #b01101001 #b010011111111001)))

(assert (= expect result))

(check-sat)
(exit)
