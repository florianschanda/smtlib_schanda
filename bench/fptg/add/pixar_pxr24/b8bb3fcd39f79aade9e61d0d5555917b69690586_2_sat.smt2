                arg2
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b11010101 #b001101101011111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111111 #b000000000000000)
                expect
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                expect
                (fp #b1 #b00010010 #b100010001111000)))

(assert (= expect result))

(check-sat)
(exit)
