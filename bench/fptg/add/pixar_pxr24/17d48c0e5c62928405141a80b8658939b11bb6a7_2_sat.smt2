(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                arg2
                (fp #b0 #b11000010 #b110010011011100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101110 #b110011011100111)
                expect
                (fp #b0 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                expect
                (fp #b0 #b11101011 #b111100110100010)))

(assert (= expect result))

(check-sat)
(exit)
