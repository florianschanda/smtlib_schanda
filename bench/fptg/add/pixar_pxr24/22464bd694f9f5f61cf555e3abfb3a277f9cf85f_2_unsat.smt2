;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001101 #b000110000110000)
                arg1
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b11001011 #b100001110110111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b000000001011000)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b01100111 #b001000111011010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100000 #b001111010010010)
                expect
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                expect
                (fp #b0 #b00111000 #b011111000011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
