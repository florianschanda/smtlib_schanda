;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b001110101010011)
                arg1
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                arg1
                (fp #b0 #b10000011 #b100010100110000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110111 #b100111000000000)
                arg2
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b01111110 #b010000101001000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001000 #b011010011111111)
                expect
                (fp #b1 #b10111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b000000000000000)
                expect
                (fp #b1 #b00001111 #b110100001111010)))

(assert (= expect result))

(check-sat)
(exit)
