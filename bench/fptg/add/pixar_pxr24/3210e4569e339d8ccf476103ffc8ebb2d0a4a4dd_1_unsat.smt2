                arg2
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11111110 #b110000000100001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001011 #b001110110110110)
                expect
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                expect
                (fp #b0 #b11111101 #b001100101100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
