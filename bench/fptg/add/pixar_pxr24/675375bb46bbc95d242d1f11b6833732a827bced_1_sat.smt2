; Format: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b010100111010101)
                arg1
                (fp #b1 #b11010110 #b100101000001010)))
(assert (fp.leq (fp #b1 #b11010110 #b100101000001010)
                arg1
                (fp #b0 #b01100101 #b100011110000100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101100 #b010001001000001)
                expect
                (fp #b1 #b11010111 #b100101000001010)))
(assert (fp.leq (fp #b1 #b11010111 #b100101000001010)
                expect
                (fp #b1 #b10111111 #b001011110111011)))

(assert (= expect result))

(check-sat)
(exit)
