; Format: PIXAR_PXR24
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00011100 #b011100001101101)
                arg1
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                arg1
                (fp #b0 #b10111001 #b101001101100001)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b111111101110001)
                arg2
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                arg2
                (fp #b1 #b00001100 #b110011010100011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b100100101100111)
                expect
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                expect
                (fp #b1 #b01001000 #b100000001101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
