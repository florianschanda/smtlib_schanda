                (fp #b1 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b010000000000000)
                arg2
                (fp #b0 #b00100110 #b000011010000101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000111 #b010110001001001)
                expect
                (fp #b1 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b010000000000000)
                expect
                (fp #b0 #b01011110 #b000101011000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
