                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b11011101 #b010101010001100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001010 #b110011010011010)
                expect
                (fp #b0 #b10111110 #b111111111111110)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111110)
                expect
                (fp #b0 #b11011011 #b110100001100110)))

(assert (= expect result))

(check-sat)
