(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111001 #b000011100101111)
                arg1
                (fp #b1 #b00000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b00000000 #b100101111110110)
                arg1
                (fp #b0 #b10011100 #b100110110001110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10100111 #b000110101011111)
                arg2
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11111101 #b110011010000000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111001 #b011011011010100)
                expect
                (fp #b0 #b11111100 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b111111111111111)
                expect
                (fp #b0 #b11111101 #b001011100001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
