                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b1 #b00101011 #b101010010101000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100111 #b100010011100001)
                expect
                (fp #b1 #b00111000 #b011010100000110)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000110)
                expect
                (fp #b0 #b00111011 #b100001010000001)))

(assert (= expect result))

(check-sat)
(exit)
