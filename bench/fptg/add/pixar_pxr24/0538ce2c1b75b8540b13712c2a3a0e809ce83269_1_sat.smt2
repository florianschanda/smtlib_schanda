(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10000100 #b010000111100110)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b00111000 #b010001111011010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000100 #b001110010010111)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b11110111 #b110000110100001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111011 #b000001000011000)
                expect
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                expect
                (fp #b0 #b10010110 #b001000101100001)))

(assert (= expect result))

(check-sat)
(exit)
