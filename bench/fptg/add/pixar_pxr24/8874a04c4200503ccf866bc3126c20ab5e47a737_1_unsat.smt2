(assert (fp.leq (fp #b1 #b01000000 #b000000000000000)
                arg2
                (fp #b0 #b10110001 #b000011010111101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110000 #b110001010000001)
                expect
                (fp #b1 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b000000000000000)
                expect
                (fp #b1 #b00011000 #b111111010010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
