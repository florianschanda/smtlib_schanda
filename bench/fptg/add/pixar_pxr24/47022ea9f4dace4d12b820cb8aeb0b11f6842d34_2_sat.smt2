(assert (fp.leq (fp #b0 #b00101111 #b010101100110110)
                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b11010011 #b001001110100000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100000 #b110001100101011)
                expect
                (fp #b0 #b01111111 #b000010100111001)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111001)
                expect
                (fp #b0 #b10000011 #b010010001010101)))

(assert (= expect result))

(check-sat)
(exit)
