(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01110110 #b001011100100100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110011 #b111111000010101)
                expect
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                expect
                (fp #b1 #b00111010 #b101010101010010)))

(assert (not (= expect result)))

(check-sat)
