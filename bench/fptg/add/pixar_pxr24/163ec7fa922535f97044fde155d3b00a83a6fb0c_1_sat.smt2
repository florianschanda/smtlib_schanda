(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11011111 #b000000101111000)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b01000001 #b100111001101101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00010010 #b111101100100011)
                arg2
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                arg2
                (fp #b0 #b10100110 #b101001000111001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110111 #b110011100010111)
                expect
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                expect
                (fp #b0 #b11010100 #b111101110100000)))

(assert (= expect result))

(check-sat)
(exit)
