                arg2
                (fp #b0 #b11000101 #b000110110011111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00001100 #b010100010111000)
                expect
                (fp #b0 #b10010101 #b010110101001111)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101001111)
                expect
                (fp #b0 #b11001011 #b010000100100111)))

(assert (not (= expect result)))

