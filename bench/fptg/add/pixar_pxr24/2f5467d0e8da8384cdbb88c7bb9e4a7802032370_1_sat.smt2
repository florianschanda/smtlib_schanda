                expect
                (fp #b0 #b10001110 #b000110010000100)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000100)
                expect
                (fp #b0 #b10100001 #b000101011100000)))

(assert (= expect result))

(check-sat)
