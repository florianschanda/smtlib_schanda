; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111100 #b000011101000100)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11010111 #b000011010111100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b101001111001011)
                arg2
                (fp #b0 #b00000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b00000000 #b100100100100110)
                arg2
                (fp #b0 #b10010111 #b010110111101000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100111 #b101100000001101)
                expect
                (fp #b0 #b00000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b00000000 #b100100100100110)
                expect
                (fp #b0 #b00010000 #b000110100001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
