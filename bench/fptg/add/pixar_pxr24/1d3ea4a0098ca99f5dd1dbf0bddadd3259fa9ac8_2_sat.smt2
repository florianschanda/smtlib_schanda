                arg2
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01010100 #b110101011011110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01000001 #b110111001011000)
                expect
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                expect
                (fp #b0 #b10011101 #b110000100011110)))

(assert (= expect result))

(check-sat)
(exit)
