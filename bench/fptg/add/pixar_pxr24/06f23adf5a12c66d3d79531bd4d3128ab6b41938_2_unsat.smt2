(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001110 #b101110101011000)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b10011010 #b011100011111111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111000 #b111100110011100)
                arg2
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                arg2
                (fp #b0 #b11111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
