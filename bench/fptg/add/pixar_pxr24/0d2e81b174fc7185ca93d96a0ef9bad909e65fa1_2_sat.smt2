                arg2
                (fp #b0 #b01001011 #b011011000000001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001110 #b101111110001111)
                expect
                (fp #b1 #b01111111 #b110011000011011)))
(assert (fp.leq (fp #b1 #b01111111 #b110011000011011)
                expect
                (fp #b1 #b01010000 #b110011110010100)))

(assert (= expect result))

(check-sat)
