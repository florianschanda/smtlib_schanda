(assert (fp.leq (fp #b1 #b11101010 #b100110001101001)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b11000111 #b111110010111000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001010 #b110100110110001)
                expect
                (fp #b0 #b10010101 #b010111001101001)))
(assert (fp.leq (fp #b0 #b10010101 #b010111001101001)
                expect
                (fp #b0 #b11110111 #b101011000001001)))

(assert (= expect result))

(check-sat)
(exit)
