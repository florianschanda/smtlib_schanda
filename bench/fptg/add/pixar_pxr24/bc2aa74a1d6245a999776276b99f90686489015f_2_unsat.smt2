;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b100000101111111)
                arg1
                (fp #b1 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b01001101 #b011110110100100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100000 #b100101011001001)
                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b10100110 #b011100001001111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101000 #b101101010110010)
                expect
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                expect
                (fp #b0 #b11101101 #b110110100101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
