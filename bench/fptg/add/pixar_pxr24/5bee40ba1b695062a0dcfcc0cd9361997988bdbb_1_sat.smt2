;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100100 #b010000100010100)
                arg1
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg1
                (fp #b1 #b00010010 #b110011000011110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111101 #b011000101111111)
                arg2
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b11001111 #b010011010011110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100101 #b110000000011011)
                expect
                (fp #b1 #b00111000 #b011010100000100)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000100)
                expect
                (fp #b0 #b01011101 #b011100100001111)))

(assert (= expect result))

(check-sat)
(exit)
