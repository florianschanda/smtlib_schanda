(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                arg2
                (fp #b0 #b00001001 #b010110001111011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00011011 #b001010011000100)
                expect
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                expect
                (fp #b0 #b11010111 #b111010010111101)))

(assert (= expect result))

(check-sat)
(exit)
