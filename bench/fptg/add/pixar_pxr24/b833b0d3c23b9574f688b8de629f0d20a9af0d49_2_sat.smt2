(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100110 #b011010000101010)
                arg1
                (fp #b1 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b000000000000000)
                arg1
                (fp #b0 #b10011100 #b110100111010100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010001 #b110111101101011)
                arg2
                (fp #b0 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b00100100 #b101001011001111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001111 #b001011011001001)
                expect
                (fp #b1 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b000000000000000)
                expect
                (fp #b1 #b00011001 #b111101110010010)))

(assert (= expect result))

(check-sat)
(exit)
