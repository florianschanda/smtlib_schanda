                arg2
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01110001 #b111111000101010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001011 #b001010110000011)
                expect
                (fp #b0 #b10100010 #b010100010011110)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011110)
                expect
                (fp #b0 #b11001100 #b100010111001111)))

(assert (= expect result))

(check-sat)
(exit)
