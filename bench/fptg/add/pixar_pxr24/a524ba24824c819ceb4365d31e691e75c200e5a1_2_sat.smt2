                arg2
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                arg2
                (fp #b0 #b10001001 #b010111110110011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011110 #b110100011101111)
                expect
                (fp #b0 #b10100010 #b010100010100000)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010100000)
                expect
                (fp #b0 #b11111011 #b001111110101111)))

(assert (= expect result))

(check-sat)
(exit)
