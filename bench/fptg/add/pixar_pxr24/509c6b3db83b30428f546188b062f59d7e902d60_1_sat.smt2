;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000000 #b101100111011100)
                arg1
                (fp #b1 #b01011111 #b101001111011010)))
(assert (fp.leq (fp #b1 #b01011111 #b101001111011010)
                arg1
                (fp #b0 #b10001011 #b100010011010001)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110111 #b011100010011001)
                arg2
                (fp #b0 #b10001111 #b010000011101101)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101101)
                arg2
                (fp #b0 #b11000001 #b100101001011000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100001 #b110101000001100)
                expect
                (fp #b0 #b10001111 #b010000011101100)))
(assert (fp.leq (fp #b0 #b10001111 #b010000011101100)
                expect
                (fp #b0 #b11111000 #b001010110001001)))

(assert (= expect result))

(check-sat)
(exit)
