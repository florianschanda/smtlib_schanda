(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01100001 #b111000010100110)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b01011001 #b111110100111100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
