(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000101 #b001101101110100)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11001011 #b001100111100010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001111 #b000101000100011)
                arg2
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b10010000 #b000011001100000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111000 #b001100101111000)
                expect
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                expect
                (fp #b0 #b11000110 #b001101101000110)))

(assert (= expect result))

(check-sat)
(exit)
