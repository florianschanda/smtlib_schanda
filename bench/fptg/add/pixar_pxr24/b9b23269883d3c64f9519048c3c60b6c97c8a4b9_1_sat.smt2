(assert (fp.leq (fp #b1 #b11000110 #b011000101111010)
                arg2
                (fp #b0 #b00111100 #b100110111100111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010101 #b110110001100001)
                expect
                (fp #b1 #b11000110 #b011000101111010)))
(assert (fp.leq (fp #b1 #b11000110 #b011000101111010)
                expect
                (fp #b0 #b00010001 #b011110110110001)))

(assert (= expect result))

(check-sat)
(exit)
