(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b10011111 #b011000010001011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111000 #b000100111101111)
                expect
                (fp #b1 #b11110010 #b010000110111110)))
(assert (fp.leq (fp #b1 #b11110010 #b010000110111110)
                expect
                (fp #b0 #b00110100 #b010011011000010)))

(assert (= expect result))

(check-sat)
(exit)
