(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010000 #b010010101010000)
                expect
                (fp #b0 #b10111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b000000000000000)
                expect
                (fp #b0 #b11110101 #b001100010111000)))

(assert (= expect result))

(check-sat)
(exit)
