; Format: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011001 #b001011010101010)
                arg1
                (fp #b1 #b11010110 #b100101000001010)))
(assert (fp.leq (fp #b1 #b11010110 #b100101000001010)
                arg1
                (fp #b0 #b10001010 #b100110000101111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001011 #b001011101000110)
                arg2
                (fp #b0 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b11111110 #b010110001011111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011101 #b001000110100101)
                expect
                (fp #b1 #b11010110 #b100101000001001)))
(assert (fp.leq (fp #b1 #b11010110 #b100101000001001)
                expect
                (fp #b0 #b10100110 #b000101000110001)))

(assert (= expect result))

(check-sat)
(exit)
