(assert (fp.leq (fp #b1 #b01111111 #b110011000011011)
                arg2
                (fp #b0 #b01100001 #b000000000101010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b000111110001000)
                expect
                (fp #b1 #b01111111 #b110011000011010)))
(assert (fp.leq (fp #b1 #b01111111 #b110011000011010)
                expect
                (fp #b0 #b10100001 #b010001010110101)))

(assert (= expect result))

(check-sat)
(exit)
