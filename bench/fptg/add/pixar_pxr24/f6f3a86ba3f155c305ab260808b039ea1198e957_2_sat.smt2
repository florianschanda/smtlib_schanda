; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011010 #b001101010101010)
                arg1
                (fp #b1 #b00111000 #b011000001000011)))
(assert (fp.leq (fp #b1 #b00111000 #b011000001000011)
                arg1
                (fp #b0 #b10100011 #b100110111010111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b110011110011101)
                arg2
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01000110 #b100111111000001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111101 #b010110010000010)
                expect
                (fp #b1 #b00111000 #b011000001000011)))
(assert (fp.leq (fp #b1 #b00111000 #b011000001000011)
                expect
                (fp #b0 #b01111110 #b101100100001111)))

(assert (= expect result))

(check-sat)
(exit)
