                arg2
                (fp #b0 #b01111100 #b000110010001110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000111 #b000000100110001)
                expect
                (fp #b1 #b10001110 #b100101100101011)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101011)
                expect
                (fp #b0 #b11000101 #b100110110101110)))

(assert (= expect result))

(check-sat)
