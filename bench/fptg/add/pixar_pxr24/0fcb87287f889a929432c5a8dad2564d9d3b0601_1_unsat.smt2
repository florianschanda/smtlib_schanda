(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b10110101 #b101110000000000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000111 #b111110111101101)
                expect
                (fp #b0 #b10010101 #b010110101001111)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101001111)
                expect
                (fp #b0 #b10011100 #b000101101101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
