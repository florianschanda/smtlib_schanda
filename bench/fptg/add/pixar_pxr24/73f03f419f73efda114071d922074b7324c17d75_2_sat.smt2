(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b11100011 #b100100101101110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10001110 #b111011100010000)
                expect
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                expect
                (fp #b0 #b11010110 #b011110100111111)))

(assert (= expect result))

(check-sat)
(exit)
