; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010101 #b001010110100011)
                arg1
                (fp #b0 #b01111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b01111111 #b010001110000010)
                arg1
                (fp #b0 #b11101111 #b000100011000110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101110 #b000100100000010)
                arg2
                (fp #b1 #b00000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b10100001 #b001101001111110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011000 #b101011010001110)
                expect
                (fp #b0 #b01111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b01111111 #b010001110000010)
                expect
                (fp #b0 #b10011110 #b111010011110011)))

(assert (= expect result))

(check-sat)
(exit)
