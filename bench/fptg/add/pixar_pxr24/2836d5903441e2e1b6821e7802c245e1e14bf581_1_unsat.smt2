(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111100 #b010001111010110)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b11001000 #b010010101011100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010011 #b011000100000011)
                arg2
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b10100100 #b000011100001000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b000001111000100)
                expect
                (fp #b0 #b10001110 #b100100011101011)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101011)
                expect
                (fp #b0 #b11110011 #b110010011111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
