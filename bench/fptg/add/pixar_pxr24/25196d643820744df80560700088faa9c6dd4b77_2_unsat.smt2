;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b101001001101011)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b1 #b00110110 #b011101100101111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101111 #b100001000100001)
                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b11011100 #b001011001101101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011110 #b111011011101011)
                expect
                (fp #b1 #b10001110 #b011110011001110)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001110)
                expect
                (fp #b1 #b00001011 #b001110110011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
