(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001011 #b110001111101111)
                arg1
                (fp #b1 #b10001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b10001110 #b011110011001111)
                arg1
                (fp #b1 #b00101001 #b011010110001001)))

