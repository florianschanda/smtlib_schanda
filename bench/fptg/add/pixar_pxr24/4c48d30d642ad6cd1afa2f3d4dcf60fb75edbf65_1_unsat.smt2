; Format: PIXAR_PXR24
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b101100001010000)
                arg1
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b00110111 #b101101010101100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01100011 #b011100011100111)
                arg2
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b10110110 #b000010001111010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000100 #b000001001110101)
                expect
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                expect
                (fp #b0 #b01011011 #b000111000110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
