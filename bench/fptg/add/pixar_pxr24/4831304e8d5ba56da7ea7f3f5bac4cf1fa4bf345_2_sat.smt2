                arg2
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11101111 #b110011100110011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b100001100110000)
                expect
                (fp #b1 #b11111101 #b000000101101100)))
(assert (fp.leq (fp #b1 #b11111101 #b000000101101100)
                expect
                (fp #b0 #b11011110 #b001110100011100)))

(assert (= expect result))

(check-sat)
(exit)
