(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11110011 #b100111101110101)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b00001100 #b001001001101000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b000011110100000)
                arg2
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b0 #b00011111 #b001100100011100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011011 #b011011001100001)
                expect
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                expect
                (fp #b0 #b11011100 #b001000110100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
