                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b11010101 #b100111111110111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000011 #b100101011011000)
                expect
                (fp #b0 #b11010001 #b100110011001001)))
(assert (fp.leq (fp #b0 #b11010001 #b100110011001001)
                expect
                (fp #b0 #b11100100 #b111110001000001)))

(assert (= expect result))

(check-sat)
(exit)
