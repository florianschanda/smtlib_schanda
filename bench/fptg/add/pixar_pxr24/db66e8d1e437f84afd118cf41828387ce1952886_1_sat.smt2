; Format: PIXAR_PXR24
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101110 #b000111000000010)
                arg1
                (fp #b0 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000000000000)
                arg1
                (fp #b0 #b01101011 #b011101101110000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00111001 #b011010110000000)
                arg2
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b11011111 #b001110000101010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000101 #b111010111011000)
                expect
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                expect
                (fp #b0 #b10010001 #b011010110001011)))

(assert (= expect result))

(check-sat)
(exit)
