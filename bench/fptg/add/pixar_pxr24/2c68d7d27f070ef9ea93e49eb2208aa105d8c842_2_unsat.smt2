                arg2
                (fp #b1 #b00101110 #b110111011000110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100001 #b011000100001011)
                expect
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                expect
                (fp #b0 #b01111110 #b010101110100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
