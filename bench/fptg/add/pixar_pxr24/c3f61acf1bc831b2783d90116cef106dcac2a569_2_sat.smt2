(assert (fp.leq (fp #b1 #b11001011 #b000001100100101)
                arg2
                (fp #b1 #b01011111 #b010000001010111)))
(assert (fp.leq (fp #b1 #b01011111 #b010000001010111)
                arg2
                (fp #b0 #b00101000 #b010011001101000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b010000110110111)
                expect
                (fp #b1 #b11110010 #b010000110111111)))
(assert (fp.leq (fp #b1 #b11110010 #b010000110111111)
                expect
                (fp #b1 #b10101101 #b000001000101001)))

(assert (= expect result))

(check-sat)
(exit)
