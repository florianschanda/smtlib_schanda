;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b011110101101011)
                arg1
                (fp #b1 #b11110010 #b010000110111110)))
(assert (fp.leq (fp #b1 #b11110010 #b010000110111110)
                arg1
                (fp #b0 #b00011001 #b110000110101000)))

