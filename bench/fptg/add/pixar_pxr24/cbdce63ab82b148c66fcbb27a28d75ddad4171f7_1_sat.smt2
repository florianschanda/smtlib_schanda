                arg2
                (fp #b0 #b11000010 #b100100101010101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110101 #b011111101001101)
                expect
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                expect
                (fp #b0 #b10100011 #b011110101000110)))

(assert (= expect result))

(check-sat)
(exit)
