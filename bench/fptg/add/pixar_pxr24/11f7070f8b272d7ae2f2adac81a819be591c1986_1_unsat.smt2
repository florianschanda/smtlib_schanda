(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111100 #b110111001000010)
                expect
                (fp #b1 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b000000000000000)
                expect
                (fp #b0 #b11011101 #b110101111111101)))

(assert (not (= expect result)))

(check-sat)
