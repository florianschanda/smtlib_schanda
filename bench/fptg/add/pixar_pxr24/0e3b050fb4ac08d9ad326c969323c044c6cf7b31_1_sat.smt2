; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101011 #b110010101101110)
                arg1
                (fp #b1 #b00000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b00000000 #b010010100000101)
                arg1
                (fp #b0 #b10001010 #b110101101010111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00011110 #b001000011101000)
                arg2
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b10010010 #b010010110011001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011000 #b100000010101000)
                expect
                (fp #b0 #b10001100 #b101110000100010)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100010)
                expect
                (fp #b0 #b10001101 #b101111100001011)))

(assert (= expect result))

(check-sat)
(exit)
