                arg1
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                arg1
                (fp #b1 #b10011110 #b101100111100101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b010001000010011)
                arg2
                (fp #b1 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b1 #b00011001 #b110010001111001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
