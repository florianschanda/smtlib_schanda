(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b11000000111110001100010)
                arg1
                (fp #b1 #b00101111 #b10100010101001001111101)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111101)
                arg1
                (fp #b0 #b10111100 #b10001000101111100101001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100100 #b00010110000110001110110)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b00111101 #b00011000101111110001000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00100100101101011110100)
                expect
                (fp #b1 #b00101111 #b10100010101001001111101)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111101)
                expect
                (fp #b0 #b00001001 #b10101010100101111101101)))

(assert (= expect result))

(check-sat)
(exit)
