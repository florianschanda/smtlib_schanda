(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00101101 #b10010000001100011100010)
                arg1
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg1
                (fp #b0 #b11101000 #b10000111001110110110010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b11010111011011001100110)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b10000011 #b01101000000001101101000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011001 #b11001111100011111111101)
                expect
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                expect
                (fp #b0 #b11101011 #b00111111110111110001111)))

(assert (= expect result))

(check-sat)
(exit)
