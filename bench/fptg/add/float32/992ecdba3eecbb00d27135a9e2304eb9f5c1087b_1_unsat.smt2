; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100000 #b11101100001010001001001)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b00001100 #b01110000010010110000100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010101 #b01100001010001010111100)
                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11101010 #b00010000101001011100101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b01101100000111000100100)
                expect
                (fp #b1 #b01111111 #b10011010110111110010101)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010101)
                expect
                (fp #b0 #b10111010 #b10010001000100010101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
