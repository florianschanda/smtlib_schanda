; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010110 #b10010111111101110111001)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011010 #b10101101110111011100001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111001 #b01110101101011111001011)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b00110111 #b01011000111101110111010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100001 #b11100100111011111001100)
                expect
                (fp #b0 #b10010110 #b10111101101000110010011)))
(assert (fp.leq (fp #b0 #b10010110 #b10111101101000110010011)
                expect
                (fp #b0 #b11010111 #b10000111101100001110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
