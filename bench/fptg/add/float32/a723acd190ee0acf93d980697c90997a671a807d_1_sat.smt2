(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001111 #b01001010100011100001010)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b01000100 #b01100111000011101010000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b00100111111001110110000)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b10111100 #b10101101000101111111101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011100 #b01100010110111001101000)
                expect
                (fp #b1 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111110)
                expect
                (fp #b0 #b00110010 #b01101011011001010011010)))

(assert (= expect result))

(check-sat)
(exit)
