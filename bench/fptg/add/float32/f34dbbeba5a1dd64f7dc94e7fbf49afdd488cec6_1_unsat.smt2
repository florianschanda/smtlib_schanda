; Format: FLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01100001011011111011100)
                arg1
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b00111011 #b00001011011001110101000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110110 #b00100100001000111011011)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b00110011 #b00100010000010001000101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111001 #b01110101001110110001100)
                expect
                (fp #b1 #b00100011 #b00110101101110101101010)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101010)
                expect
                (fp #b0 #b10101010 #b00000010011010100100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
