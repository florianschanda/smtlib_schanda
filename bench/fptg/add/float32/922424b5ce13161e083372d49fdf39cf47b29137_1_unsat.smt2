; Format: FLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011001 #b11001101010111110101100)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b00010001 #b00111110110100101000110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011111 #b01100111100101001010010)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b00011100 #b10011100111001011000100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010111 #b00111100011001111101000)
                expect
                (fp #b0 #b00000000 #b10110001011000011011011)))
(assert (fp.leq (fp #b0 #b00000000 #b10110001011000011011011)
                expect
                (fp #b0 #b01111100 #b10100000110010100111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
