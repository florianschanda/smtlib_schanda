; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010001 #b10100100011110110001100)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b10111110 #b10100111101110010001001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11101001100100010010001)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b11010001 #b01101100101001001010010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001100 #b00110101000111011111001)
                expect
                (fp #b0 #b10110010 #b00100011010010110011010)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011010)
                expect
                (fp #b0 #b10110011 #b10000110110101111110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
