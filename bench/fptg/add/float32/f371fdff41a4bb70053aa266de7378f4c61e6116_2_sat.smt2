(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100011 #b00110100011001000100111)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b10110000 #b01010111111010101010001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000100 #b10110000011101010110011)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10110110 #b11100000011010101001011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010111 #b11001101001011011000000)
                expect
                (fp #b0 #b10010101 #b00101010111110011011111)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011111)
                expect
                (fp #b0 #b11011001 #b10110011001111111001101)))

(assert (= expect result))

(check-sat)
(exit)
