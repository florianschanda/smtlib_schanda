; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101110 #b11010100010000101000000)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00010100 #b10000010110011001100100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010111 #b00100001000110100010001)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b00101111 #b11110111001011111011100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011010 #b11100110011101101101010)
                expect
                (fp #b1 #b10011000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10011000 #b00000000000000000000000)
                expect
                (fp #b0 #b01100001 #b00101101100000010000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
