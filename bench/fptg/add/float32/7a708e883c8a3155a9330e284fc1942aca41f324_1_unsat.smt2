(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010000 #b10111101111101000011101)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b01010001 #b00110101011110011010010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b01101100 #b11000100011100110000110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b1 #b01110110 #b00101011001110101110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
