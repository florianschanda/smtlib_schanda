(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00001101 #b01100100110010000001001)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b10110111 #b10001100110111011001000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01111111 #b00111000000000111110011)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10101100 #b01010111111010001110111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011010 #b01100100111101011100111)
                expect
                (fp #b0 #b00000000 #b11010100101111110110000)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110110000)
                expect
                (fp #b0 #b01001110 #b10010010111001100000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
