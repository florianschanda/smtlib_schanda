(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00101110 #b00110011101001010111111)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b01001000 #b00000100110000101111110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01001001 #b10011111000010110010011)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b00010110 #b01100000101011100010110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101101 #b11000111111011010110111)
                expect
                (fp #b0 #b01000110 #b00001000110000100101011)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101011)
                expect
                (fp #b0 #b11101010 #b10100010011010111111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
