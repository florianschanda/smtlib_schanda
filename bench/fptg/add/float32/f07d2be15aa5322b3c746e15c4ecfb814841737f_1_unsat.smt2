; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110110 #b01011110010011110010001)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b00010011 #b00110001000010000010111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101101 #b00100110111100001010011)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10000001 #b00011001001100101011101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100010 #b01010110010011000001010)
                expect
                (fp #b0 #b00000000 #b10101001110111001000111)))
(assert (fp.leq (fp #b0 #b00000000 #b10101001110111001000111)
                expect
                (fp #b0 #b10010110 #b00100100110101011000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
