(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b01101100001110001111010)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b11000111 #b00001100010100101000001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b11100100 #b01000100001011100101111)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110011 #b10011001000111111111100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010011 #b10101100010100001001100)
                expect
                (fp #b0 #b11101111 #b00010110010101110011011)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011011)
                expect
                (fp #b0 #b11110011 #b11100010101110100010010)))

(assert (= expect result))

(check-sat)
(exit)
