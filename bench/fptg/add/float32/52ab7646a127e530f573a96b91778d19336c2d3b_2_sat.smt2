(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01110010000000001101100)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b01010001 #b11101100010111010000001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b00111001001001101110001)
                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b00111000 #b11000110101010111001011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01111001001010010001001)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b10111010 #b00100011011100101101111)))

(assert (= expect result))

(check-sat)
(exit)
