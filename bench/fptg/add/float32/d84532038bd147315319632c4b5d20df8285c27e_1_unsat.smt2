; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101110 #b11100101001011001000000)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000110 #b01011010011001001100101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00010011 #b01100000101010111000100)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b11010101 #b11110001000011010100101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010010 #b00001010110000000001101)
                expect
                (fp #b1 #b00000000 #b11011101011001101001110)))
(assert (fp.leq (fp #b1 #b00000000 #b11011101011001101001110)
                expect
                (fp #b0 #b11100111 #b00100011101101000100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
