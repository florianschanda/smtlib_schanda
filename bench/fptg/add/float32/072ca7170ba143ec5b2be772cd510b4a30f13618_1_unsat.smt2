(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110101 #b01000111110010100000001)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110101 #b00100010110011011001001)
                expect
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                expect
                (fp #b0 #b11111001 #b00000001001110001001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
