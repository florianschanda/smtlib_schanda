(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b11100111011101111001110)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11010100 #b00101100010101110101101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110010 #b10110010000101000110000)
                arg2
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b01001100 #b10110101111110001110011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010000 #b10000100100000000100000)
                expect
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                expect
                (fp #b0 #b11100001 #b11000011111000111011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
