                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b10000011 #b10101101100110111100111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b01111010001111001101000)
                expect
                (fp #b1 #b00100101 #b01110010110010101010110)))
(assert (fp.leq (fp #b1 #b00100101 #b01110010110010101010110)
                expect
                (fp #b0 #b00100111 #b10100010100001111000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
