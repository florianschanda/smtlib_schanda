(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b01100010001011110011001)
                arg1
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b11011000 #b11101111111111101010010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101101 #b11100000011001100000101)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10001011 #b00110110010001100111011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100000 #b11001001111000101101000)
                expect
                (fp #b0 #b01111111 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000001)
                expect
                (fp #b0 #b10011101 #b00110011001101011010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
