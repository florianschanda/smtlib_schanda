(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011001 #b01111000000000001101101)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b10110100 #b01000000110110011000011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00101000 #b10110010000011010000111)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11110110 #b11110111010011011001111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000011 #b00001101000011110101100)
                expect
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                expect
                (fp #b0 #b11000001 #b01101110101111100010010)))

(assert (= expect result))

(check-sat)
(exit)
