(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111000 #b10000101001010010000100)
                arg1
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b01000001 #b01011110111110001001000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110011 #b01000101100101111001001)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10000110 #b00100110111011010011000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110110 #b11001000011011100101100)
                expect
                (fp #b0 #b01101011 #b11101001101001110111001)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111001)
                expect
                (fp #b0 #b01101110 #b00100111001100100101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
