(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10010010 #b10111100000101100000110)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01111101 #b11001001001001010010100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101100 #b00100110110110010001110)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b00001101 #b01101111101011101100010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b00011111011100110110101)
                expect
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                expect
                (fp #b1 #b10000100 #b01001110010110000110100)))

(assert (= expect result))

(check-sat)
(exit)
