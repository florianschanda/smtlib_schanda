; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110001 #b00110011001000100001100)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111110 #b00101010110100000100000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b10111101110011101100011)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11101100 #b11011100010101100110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011000 #b10000000011011110000100)
                expect
                (fp #b1 #b10010110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10010110 #b11111111111111111111110)
                expect
                (fp #b1 #b10000111 #b10111101000100101101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
