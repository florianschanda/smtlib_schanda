; Format: FLOAT32
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000000 #b10010000100000011110111)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00101101 #b01110001110001110111001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00010101 #b00110110101110011001011)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10011110 #b11111001011110100111111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110001 #b00011110010000101110010)
                expect
                (fp #b1 #b01111110 #b11111111111111111100001)))
(assert (fp.leq (fp #b1 #b01111110 #b11111111111111111100001)
                expect
                (fp #b1 #b01001011 #b11101101110111101010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
