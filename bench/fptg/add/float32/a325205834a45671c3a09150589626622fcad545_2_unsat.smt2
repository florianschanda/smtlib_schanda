(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00001100 #b00001100001110111011111)
                arg1
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b01101011 #b00111001111001001010100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10000101010100000010000)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10100000 #b00101011111011011011010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001101 #b11000101101011110001101)
                expect
                (fp #b0 #b00110100 #b01101010000010011110100)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110100)
                expect
                (fp #b0 #b11111001 #b01010001100011110011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
