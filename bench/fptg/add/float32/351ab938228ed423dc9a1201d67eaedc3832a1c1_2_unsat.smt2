; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b11001011110110110000000)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011111 #b10111000000000111110001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01010010 #b11111101100000001101001)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11011100 #b11110110010100011000110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101001 #b11111000100100011001011)
                expect
                (fp #b0 #b10010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000001)
                expect
                (fp #b0 #b11011101 #b11110010011010010101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
