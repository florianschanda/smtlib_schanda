(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101101 #b10010111010001110001100)
                arg1
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b10101010 #b11100111010010011000101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110010 #b11111000100010010000011)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b11101100 #b10010011111000010001010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101110 #b00111000010001111011011)
                expect
                (fp #b1 #b00000000 #b01000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000110110010010010)
                expect
                (fp #b0 #b11001110 #b01111010001111011110010)))

(assert (= expect result))

(check-sat)
(exit)
