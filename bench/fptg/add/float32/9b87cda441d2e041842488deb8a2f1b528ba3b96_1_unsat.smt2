; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b10001100111111000110010)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b10101100 #b10111010011111111110100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01000101 #b10101101100101110001111)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b1 #b00010011 #b11101000010011000000010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01111001111010011011100)
                expect
                (fp #b1 #b00100011 #b00110101101110101101010)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101010)
                expect
                (fp #b0 #b11110000 #b00110101001010010001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
