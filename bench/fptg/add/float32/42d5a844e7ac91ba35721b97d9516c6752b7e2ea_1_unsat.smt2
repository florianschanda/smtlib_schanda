; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001011 #b00000100111100011000100)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b00100101 #b00101101001000111000011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01000111 #b01001101101011111000101)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10001100 #b00001000010111110110110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10010111000001000001111)
                expect
                (fp #b1 #b10010011 #b01000001011100000111111)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100000111111)
                expect
                (fp #b0 #b00001100 #b11001010010110000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
