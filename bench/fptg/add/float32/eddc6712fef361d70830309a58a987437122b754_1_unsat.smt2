(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010101 #b01100101100010011011101)
                arg1
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b10011110 #b00000110010000100110101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b10100101100001111000011)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10100010 #b11011100010101011011100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101011 #b10110100001000110010100)
                expect
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11000000 #b00110110001000100000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
