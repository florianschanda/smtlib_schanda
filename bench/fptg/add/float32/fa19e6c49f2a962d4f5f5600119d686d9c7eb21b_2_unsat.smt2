(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010101 #b10110000011000110001101)
                arg1
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b00010011 #b01010111011011010110011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000011 #b10111010001101001110101)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b01010110 #b10010000000011011101010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b00010000011010111101110)
                expect
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                expect
                (fp #b0 #b11110000 #b01101110100111011011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
