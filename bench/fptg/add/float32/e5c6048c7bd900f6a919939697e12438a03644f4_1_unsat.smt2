(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10011110010010100110001)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b11101011 #b11000101100010111011011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100001 #b11110011000101010111110)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11100110 #b10000001110100001110110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01110001 #b10000110111101111001111)
                expect
                (fp #b0 #b10010110 #b10001101100001001011111)))
(assert (fp.leq (fp #b0 #b10010110 #b10001101100001001011111)
                expect
                (fp #b0 #b10100111 #b00000100010101010110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
