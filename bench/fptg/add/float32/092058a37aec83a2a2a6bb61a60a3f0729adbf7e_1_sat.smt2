(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00100111 #b10100110000100111011110)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b01011011 #b11110001001100110110100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000001 #b00100011101111100101110)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b11001000 #b01101100110101100110111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100011 #b01010101100100010110000)
                expect
                (fp #b0 #b00101000 #b00111101011100011111110)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111110)
                expect
                (fp #b0 #b10010101 #b01100001100001011111100)))

(assert (= expect result))

(check-sat)
(exit)
