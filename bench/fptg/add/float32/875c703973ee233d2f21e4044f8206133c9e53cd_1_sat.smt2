(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b00010111110100001000000)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b10001011 #b00011011100110011010011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111011 #b10011111010010001001100)
                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b00101011 #b11000100110000111010000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10101011110000111011011)
                expect
                (fp #b1 #b10010100 #b11001001111011010000011)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000011)
                expect
                (fp #b1 #b10000011 #b10001000001111100001111)))

(assert (= expect result))

(check-sat)
(exit)
