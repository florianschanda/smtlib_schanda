(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000000 #b11111110010011001010000)
                arg1
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b01101010 #b00110010001101110011000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01101010000010000010111)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b01111111 #b00100001010100001101110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10101100101000111111100)
                expect
                (fp #b1 #b11111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000001)
                expect
                (fp #b0 #b10110001 #b10100110110010011000100)))

(assert (= expect result))

(check-sat)
(exit)
