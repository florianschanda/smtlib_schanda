; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110111 #b00011101001100010000001)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b00111010 #b10001100101110011011101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10010000 #b11011001001100001101000)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111000 #b00110001100010101110010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10111011 #b00110101101110111000100)
                expect
                (fp #b0 #b11101111 #b00010110010101110011001)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011001)
                expect
                (fp #b0 #b11110001 #b01101010001111101111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
