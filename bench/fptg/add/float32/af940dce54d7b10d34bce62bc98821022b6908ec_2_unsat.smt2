(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101111 #b01010010110100000000011)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b1 #b01011100 #b10111100010000000011111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001001 #b00110001000000000000010)
                arg2
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b00000100 #b00110110100111101001010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b01001110110000010101100)
                expect
                (fp #b1 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b00000000000000000000000)
                expect
                (fp #b1 #b01101011 #b10011111101101100110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
