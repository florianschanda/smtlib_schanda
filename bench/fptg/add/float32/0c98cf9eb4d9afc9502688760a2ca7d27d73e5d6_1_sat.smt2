(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001100 #b10011111001011111010101)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b00110010 #b11111101001001110010011)))

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00100111 #b10111111101001100000100)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011011 #b11000101010111011100001)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000011 #b10010001110000010001111)
                expect
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                expect
                (fp #b0 #b00011010 #b00100000001111011011110)))

(assert (= expect result))

(check-sat)
(exit)
