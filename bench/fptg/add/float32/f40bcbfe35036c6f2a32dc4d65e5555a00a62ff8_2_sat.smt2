(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01110110 #b01110100010000110010001)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b01100010 #b11100111100010111001111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100101 #b00110011001010111010110)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b10001111 #b11001110011011100000011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b01101011111100000000011)
                expect
                (fp #b1 #b11100001 #b01011110011101100010000)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100010000)
                expect
                (fp #b1 #b01010110 #b01110000000101111101010)))

(assert (= expect result))

(check-sat)
(exit)
