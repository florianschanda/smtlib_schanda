(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001110 #b00111110111111101100011)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b10010010 #b00111011101000111111011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b01100110100101011101000)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b01101100 #b11110000000101100011011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b00101110011101010010101)
                expect
                (fp #b1 #b00000001 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b01000000000000000000000)
                expect
                (fp #b0 #b01001101 #b10110011000010101100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
