(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11000000 #b11001101011100001001001)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b11000000 #b01010100011110001000000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000101 #b11100100010001101011111)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11000110 #b10111111100010101111100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010011 #b10010001111011010000111)
                expect
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                expect
                (fp #b0 #b11011000 #b11010111010001100000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
