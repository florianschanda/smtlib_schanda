(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110001 #b10111111000001110101001)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00100001 #b10100111100110011001001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b10001101111100111011001)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b1 #b01010101 #b11011001110101001000110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110100 #b00101111110011101110101)
                expect
                (fp #b1 #b10010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000001)
                expect
                (fp #b0 #b01100010 #b01011011000010101010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
