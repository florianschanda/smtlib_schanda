; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011101 #b00010010001010011001111)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b11110000 #b01011000000000100000101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000011 #b01100011010111001110000)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b01001001 #b10011111110101111001100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b01110001000111100101101)
                expect
                (fp #b1 #b00000000 #b01111000101101111001101)))
(assert (fp.leq (fp #b1 #b00000000 #b01111000101101111001101)
                expect
                (fp #b0 #b01100101 #b11001001010010000010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
