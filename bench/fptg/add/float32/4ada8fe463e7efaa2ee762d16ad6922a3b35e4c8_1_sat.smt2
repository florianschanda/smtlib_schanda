(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110100 #b10100111000100000001010)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b01101101 #b00111010010100111010101)))

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
