; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00001101 #b01111010001000000101100)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b10111111 #b11111000000001110010011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110001 #b00110000110001100001011)
                arg2
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b10100100 #b10001110111011001010101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011001 #b11010100001111100101100)
                expect
                (fp #b0 #b01111111 #b11101000110101111001110)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001110)
                expect
                (fp #b0 #b11010000 #b00111000010011001001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
