(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010111 #b00100010111111011000011)
                arg1
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b11000110 #b10111001010000110111010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b11101111 #b11111111011010100110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
