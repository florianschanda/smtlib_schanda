; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b11111111111011000101111)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b10001100 #b11011010101101101100000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01011100 #b01110000010110100010001)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b00001111 #b10011101110010010100011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111010 #b11011101101000101011110)
                expect
                (fp #b0 #b00000000 #b00000110011010100000011)))
(assert (fp.leq (fp #b0 #b00000000 #b00000110011010100000011)
                expect
                (fp #b0 #b00000101 #b11111010000101000111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
