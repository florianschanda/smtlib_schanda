(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b01000011 #b10000110110011100100100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000011 #b10001010101101010011011)
                expect
                (fp #b0 #b00110100 #b01101010000010011101110)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011101110)
                expect
                (fp #b0 #b11000010 #b10110010001000000011001)))

(assert (not (= expect result)))

(check-sat)
